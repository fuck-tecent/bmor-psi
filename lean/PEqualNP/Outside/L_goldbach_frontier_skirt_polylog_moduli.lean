    apply card_pos.mpr
    refine ⟨x,?_⟩
    simp [V5p]
  unfold V8
  calc
    _ = ∑ _x : Fin s → Fin N, 1 := by simp
    _ ≤ _ := sum_le_sum (fun x _ => hx x)
end V2
