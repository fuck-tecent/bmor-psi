    (h4 : ((S.filter (fun i => level i≤1.58)).card:ℝ)≤12)
    (h5 : ((S.filter (fun i => level i≤1.90)).card:ℝ)≤18)
    (h6 : ((S.filter (fun i => level i≤2.42)).card:ℝ)≤37)
    (h7 : ((S.filter (fun i => level i≤3.38)).card:ℝ)≤159)
    (hTail : (∑ i∈S.filter (fun i => 3.38<level i),Real.exp (-4.93*max (level i) 0.99))≤0.0006) :
    (∑ i∈S,Real.exp (-4.93*max (level i) 0.99)) ≤ 0.067 := by
  have hB : (∑ i∈S.filter (fun i => level i≤3.38), Real.exp (-4.93*max (level i) 0.99)) ≤
      6*(Real.exp (-4.8807)-Real.exp (-4.8807))+
      6*(Real.exp (-4.8807)-Real.exp (-5.2258))+
      7*(Real.exp (-5.2258)-Real.exp (-5.8174))+
      9*(Real.exp (-5.8174)-Real.exp (-6.7048))+
      12*(Real.exp (-6.7048)-Real.exp (-7.7894))+
      18*(Real.exp (-7.7894)-Real.exp (-9.367))+
      37*(Real.exp (-9.367)-Real.exp (-11.9306))+
      159*(Real.exp (-11.9306)) := by
    rw [sum_filter]
    calc
      _ ≤ ∑ i∈S, (
        (if level i≤0.99 then Real.exp (-4.8807)-Real.exp (-4.8807) else 0)+
        (if level i≤1.06 then Real.exp (-4.8807)-Real.exp (-5.2258) else 0)+
        (if level i≤1.18 then Real.exp (-5.2258)-Real.exp (-5.8174) else 0)+
        (if level i≤1.36 then Real.exp (-5.8174)-Real.exp (-6.7048) else 0)+
        (if level i≤1.58 then Real.exp (-6.7048)-Real.exp (-7.7894) else 0)+
        (if level i≤1.90 then Real.exp (-7.7894)-Real.exp (-9.367) else 0)+
        (if level i≤2.42 then Real.exp (-9.367)-Real.exp (-11.9306) else 0)+
        (if level i≤3.38 then Real.exp (-11.9306) else 0)) :=
