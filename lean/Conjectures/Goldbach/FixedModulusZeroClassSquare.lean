namespace GoldbachPintzWeightedFormula

open Complex Filter Finset Goldbach GoldbachSmoothing GoldbachTwistedMellin GoldbachPintzNumerics LSeries
open scoped Topology Classical

noncomputable section

private theorem exponential_term_shift (f : ℕ→ℂ) (b L : ℝ) (s : ℂ) (n : ℕ) :
    term f (s+(b/L:ℝ)) n=
      term f s n*(Real.exp (-b*(Real.log (n:ℝ)/L)):ℂ) := by
  by_cases hn : n=0
  · subst n
    simp
  have hn₀ : (n:ℂ)≠0 := by exact_mod_cast hn
  have hn' : (0:ℝ)≤ n := by positivity
  rw [term_of_ne_zero hn,term_of_ne_zero hn,Complex.cpow_add _ _ hn₀,
    Complex.cpow_def_of_ne_zero hn₀ ((b/L:ℝ):ℂ),←div_div]
  rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn',←Complex.ofReal_mul,←Complex.ofReal_exp]
  rw [div_eq_mul_inv,←Complex.ofReal_inv,←Real.exp_neg]
  congr 3
  ring

private theorem weighted_exponential_terms {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (L : ℝ) (s : ℂ)
    (hs : ∀ i∈S,1<s.re+b i/L) :
    HasSum (fun n : ℕ => term (twistedCoefficient χ) s n*
      (exponentialAutoWeight S a b (Real.log (n:ℝ)/L):ℂ)) (exponentialPrimeTest S a b χ L s) := by
  let c := exponentialAutoCoeff S a b
  let g (i : ι) (n : ℕ) := (c i:ℂ)*term (twistedCoefficient χ) (s+(b i/L:ℝ)) n
  have hSum (i : ι) (hi : i∈S) : Summable (g i) := by
    have hg := χ.LSeriesSummable_twist_vonMangoldt
      (s:=s+(b i/L:ℝ)) (by simpa [Complex.add_re] using hs i hi)
    exact hg.mul_left _
  have hEq (n : ℕ) :
      term (twistedCoefficient χ) s n*(exponentialAutoWeight S a b (Real.log (n:ℝ)/L):ℂ)=
        ∑ i∈S,g i n := by
    unfold exponentialAutoWeight exponentialPulse
    rw [Complex.ofReal_sum,Finset.mul_sum]
    refine Finset.sum_congr rfl fun i hi => ?_
    unfold g c
    rw [exponential_term_shift,Complex.ofReal_mul]
    ring
  have hT := (summable_sum (s:=S) hSum).congr (fun n=> (hEq n).symm)
  have hEqSum : (∑' n : ℕ,term (twistedCoefficient χ) s n*
      (exponentialAutoWeight S a b (Real.log (n:ℝ)/L):ℂ)) = exponentialPrimeTest S a b χ L s := by
    rw [show (∑' n : ℕ,term (twistedCoefficient χ) s n*
         (exponentialAutoWeight S a b (Real.log (n:ℝ)/L):ℂ)) =
         ∑' n : ℕ,∑ i∈S,g i n by exact tsum_congr hEq, Summable.tsum_finsetSum hSum]
    unfold exponentialPrimeTest
    refine Finset.sum_congr rfl fun i hi=> ?_
    unfold g c
    rw [tsum_mul_left,←LSeries,LSeries_twistedCoefficient_eq χ (by simpa [Complex.add_re] using hs i hi)]
  exact hEqSum ▸ hT.hasSum

private theorem tendsto_exponential_primeSum {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (L σ t : ℝ)
    (hs : ∀ i∈S,1<σ+b i/L) :
    Tendsto (fun N : ℕ => primeSum (Finset.range N)
      (fun n=>exponentialAutoWeight S a b (Real.log (n:ℝ)/L)) χ σ t) atTop
      (𝓝 ((exponentialPrimeTest S a b χ L (line σ t)).re)) := by
  have h := (weighted_exponential_terms S a b χ L (line σ t) (by simpa [line] using hs)).tendsto_sum_nat
  have hr := Complex.continuous_re.continuousAt.tendsto.comp h
  refine hr.congr (fun N => ?_)
  change Complex.reAddGroupHom (∑ n∈Finset.range N, term (twistedCoefficient χ) (line σ t) n*
      (exponentialAutoWeight S a b (Real.log (n:ℝ)/L):ℂ)) = _
  rw [map_sum]
  unfold primeSum
  apply Finset.sum_congr rfl
  intro n _
  by_cases hn : n=0
  · subst n
    simp
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn
  have he : -(line σ t)=((-σ:ℝ):ℂ)+(-(t:ℂ)*I) := by push_cast; unfold line; ring
  change (term (twistedCoefficient χ) (line σ t) n*(exponentialAutoWeight S a b (Real.log (n:ℝ)/L):ℂ)).re=_
  rw [term_of_ne_zero hn,div_eq_mul_inv,←Complex.cpow_neg,he,Complex.cpow_add _ _ hn0,
    ←Complex.ofReal_natCast,←Complex.ofReal_cpow (Nat.cast_nonneg n)]
  simp only [twistedCoefficient,Pi.mul_apply]
  let W := exponentialAutoWeight S a b (Real.log (n:ℝ)/L)
  change (χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)*
      (↑((n:ℝ)^(-σ))*((n:ℝ):ℂ)^(-(t:ℂ)*I))*(W:ℂ)).re=_
  have hMul : χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)*
      (↑((n:ℝ)^(-σ))*((n:ℝ):ℂ)^(-(t:ℂ)*I))*(W:ℂ)=
      ((W*ArithmeticFunction.vonMangoldt n*(n:ℝ)^(-σ):ℝ):ℂ)*
        (χ (n:ZMod q)*((n:ℝ):ℂ)^(-(t:ℂ)*I)) := by push_cast; ring
  rw [hMul,Complex.re_ofReal_mul]

set_option maxHeartbeats 1000000 in
/-- The actual weighted prime combination is nonnegative because its
exponential autocorrelation gives nonnegative von Mangoldt weights. -/
theorem quadratic_four_exponential_primeTest_nonneg {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    {q : ℕ} [NeZero q] (ξ χ : DirichletCharacter ℂ q) (hξ : ξ^2=1) {L σ t : ℝ}
    (hL : 0<L) (hb : ∀ i∈S,0<b i) (hG : ∀ u≥0,0≤exponentialPulse S a b u)
    (hs : ∀ i∈S,1<σ+b i/L) :
    0≤(exponentialPrimeTest S a b (1:DirichletCharacter ℂ q) L (line σ 0)).re+
      (exponentialPrimeTest S a b ξ L (line σ 0)).re+
      (exponentialPrimeTest S a b χ L (line σ t)).re+
      (exponentialPrimeTest S a b (ξ*χ) L (line σ t)).re := by
  have h0 := tendsto_exponential_primeSum S a b (1:DirichletCharacter ℂ q) L σ 0 hs
  have hξ' := tendsto_exponential_primeSum S a b ξ L σ 0 hs
  have h1 := tendsto_exponential_primeSum S a b χ L σ t hs
  have hξ1 := tendsto_exponential_primeSum S a b (ξ*χ) L σ t hs
  exact ge_of_tendsto' (((h0.add hξ').add h1).add hξ1) fun N=>
    quadratic_four_primeSum_nonneg ξ χ hξ (Finset.range N) _
      (fun n _=>exponentialAutoWeight_nonneg S a b hb hG
        (div_nonneg (Real.log_natCast_nonneg n) hL.le)) σ t

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Finset Goldbach GoldbachTwistedMellin GoldbachPintzNumerics MeasureTheory Set
