noncomputable section

private theorem geom_fin_of_pow_eq_one {w : ℂ} {n : ℕ} (hw : w^n=1) :
    (∑ j : Fin n,w^(j:ℕ)) = if w=1 then (n:ℂ) else 0 := by
  classical
  by_cases h : w=1
  · simp [h]
  · rw [ite_eq_right h,Fin.sum_univ_eq_sum_range]
    have he := geom_sum_mul w n
    rw [hw,sub_self] at he
    exact (mul_eq_zero.mp he).resolve_right (sub_ne_zero.mpr h)

/-- Square-zero block evaluation, retaining exact phase and primary residue.
This is the first stationary-phase identity in Burgess 1962, §2. -/
theorem sum_rationalValue_prime_power_digits {p a b : ℕ} (hp : p.Prime)
    (hb : 0<b) (hab : b≤a) (χ : DirichletCharacter ℂ (p^(a+b))) (hχ : χ.IsPrimitive)
    (f g : (ZMod (p^(a+b)))[X]) :
    let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    (∑ x : ZMod (p^(a+b)), rationalValue χ f g x) =
      ((p^b:ℕ):ℂ) * ∑ u : Fin (p^a),
        if IsUnit (f.eval ((u:ℕ):ZMod (p^(a+b)))) ∧
          IsUnit (g.eval ((u:ℕ):ZMod (p^(a+b)))) ∧
          p^b∣(logarithmicSlope f g ((u:ℕ):ZMod (p^(a+b)))).val
        then rationalValue χ f g ((u:ℕ):ZMod (p^(a+b))) else 0 := by
  classical
  let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  let R := ZMod (p^(a+b))
  let t : R := ((p^a:ℕ):R)
  have ht : t^2=0 := by
    dsimp only [t,R]
    rw [←Nat.cast_pow,←pow_mul,ZMod.natCast_eq_zero_iff]
    exact Nat.pow_dvd_pow p (by omega)
  have htMul : t*((p^b:ℕ):R)=0 := by
    dsimp only [t,R]
    rw [←Nat.cast_mul,←pow_add,ZMod.natCast_self]
  have hq : p^(a+b) = (p^b)*(p^a) := by rw [pow_add,mul_comm]
  rw [sum_zmod_digits_of_eq hq,mul_sum]
  apply sum_congr rfl
  intro u _
  let x : R := ((u:ℕ):R)
  let S := logarithmicSlope f g x
  let w := χ (1+t*S)
  have hOne : w^(p^b)=1 := by
    dsimp only [w]
    rw [←map_pow χ,linear_pow_of_square_zero _ (by rw [mul_pow,ht,zero_mul]),
      mul_right_comm t,htMul,zero_mul,add_zero,map_one]
  have hPhase : w=1 ↔ p^b∣S.val := primitive_sqzero_phase_eq_one_iff hp hb hab χ hχ S
  change (∑ v : Fin (p^b), rationalValue χ f g (x+t*((v:ℕ):R))) =
    ((p^b:ℕ):ℂ)*(if IsUnit (f.eval x) ∧ IsUnit (g.eval x) ∧ p^b∣S.val
      then rationalValue χ f g x else 0)
  by_cases h : IsUnit (f.eval x) ∧ IsUnit (g.eval x)
  · have hShift (v : Fin (p^b)) : rationalValue χ f g (x+t*((v:ℕ):R)) =
        w^(v:ℕ)*rationalValue χ f g x := by
      have hy : (t*((v:ℕ):R))^2=0 := by rw [mul_pow,ht,zero_mul]
      rw [rationalValue_sqzero_shift χ f g hy h.1 h.2,show (t*((v:ℕ):R))*logarithmicSlope f g x=
        (t*S)*((v:ℕ):R) by dsimp only [S]; ring]
      rw [←linear_pow_of_square_zero _ (by rw [mul_pow,ht,zero_mul]),map_pow]
    simp_rw [hShift,←sum_mul,geom_fin_of_pow_eq_one hOne,hPhase]
    by_cases hs : p^b∣S.val <;> simp [h.1,h.2,hs]
  · have h0 (v : Fin (p^b)) : rationalValue χ f g (x+t*((v:ℕ):R))=0 := by
      have hNu (F : R[X]) (hF : ¬IsUnit (F.eval x)) :
          ¬IsUnit (F.eval (x+t*((v:ℕ):R))) := by
        have hy : (t*((v:ℕ):R))^2=0 := by rw [mul_pow,ht,zero_mul]
        rw [Polynomial.eval_add_of_sq_eq_zero _ _ _ hy,
          zmod_isUnit_add_square_zero _ _ (by rw [mul_pow,hy,mul_zero])]
        exact hF
      by_cases hf : IsUnit (f.eval x)
      · have hg := hNu g (fun hg => h ⟨hf,hg⟩)
        simp [rationalValue,MulChar.map_nonunit _ hg]
      · simp [rationalValue,MulChar.map_nonunit _ (hNu f hf)]
    have hn : ¬ (IsUnit (f.eval x) ∧ IsUnit (g.eval x) ∧ p^b∣S.val) :=
      fun hh => h ⟨hh.1,hh.2.1⟩
    simp [h0,hn]

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Polynomial

noncomputable section

section CommRing

variable {R : Type*} [CommRing R]

def splitQuadratic (a b : R) : R[X] := (X-C a)*(X-C b)

def criticalLeading (a b c d : R) : R := a+b-c-d

def criticalMiddle (a b c d : R) : R := c*d-a*b

def criticalConstant (a b c d : R) : R := a*b*(c+d) - c*d*(a+b)

def criticalWronskian (f g : R[X]) : R[X] := f.derivative*g - g.derivative*f

theorem splitQuadratic_wronskian (a b c d : R) :
    criticalWronskian (splitQuadratic a b) (splitQuadratic c d) =
      C (criticalLeading a b c d)*X^2 + C (2*criticalMiddle a b c d)*X + C (criticalConstant a b c d) := by
  simp only [criticalWronskian,splitQuadratic,derivative_mul,derivative_X,derivative_C,
    sub_zero,one_mul,mul_one,criticalLeading,criticalMiddle,criticalConstant,map_add,map_sub,map_mul,map_ofNat]
  ring

theorem splitQuadratic_wronskian_eval (x a b c d : R) :
    (criticalWronskian (splitQuadratic a b) (splitQuadratic c d)).eval x =
      criticalLeading a b c d*x^2 + 2*criticalMiddle a b c d*x + criticalConstant a b c d := by
  rw [splitQuadratic_wronskian]
  simp

theorem criticalConstant_eq (a b c d : R) :
    criticalConstant a b c d =
      -criticalLeading a b c d*(a*b)-criticalMiddle a b c d*(a+b) := by
  unfold criticalConstant criticalLeading criticalMiddle
  ring

theorem critical_discriminant_eq (a b c d : R) :
    (criticalMiddle a b c d)^2-criticalLeading a b c d*criticalConstant a b c d =
      (a-c)*(a-d)*(b-c)*(b-d) := by
  unfold criticalMiddle criticalLeading criticalConstant
  ring


end CommRing
end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

/-- A congruence to precision strictly above the valuation preserves that
valuation. The nonzero condition is forced for the other representative. -/
theorem valuation_eq_of_pow_dvd_sub {p n : ℕ} [Fact p.Prime] {x y : ℤ}
    (hy : y≠0) (hyn : padicValInt p y<n) (hxy : (p:ℤ)^n∣x-y) :
    x≠0 ∧ padicValInt p x=padicValInt p y := by
  let d := padicValInt p y
  have hx : x≠0 := by
    intro hz
    rw [hz,zero_sub,dvd_neg,padicValInt_dvd_iff] at hxy
    rcases hxy with h|h
    · exact hy h
    · omega
  have hPow (r : ℕ) (hr : r≤n) : (p:ℤ)^r∣x-y :=
    (pow_dvd_pow _ hr).trans hxy
  have hLow : d≤padicValInt p x := by
    have he := dvd_add (hPow d hyn.le) (padicValInt_dvd (p:=p) y)
    rw [sub_add_cancel,padicValInt_dvd_iff] at he
    exact he.resolve_left hx
  have hHigh : padicValInt p x≤d := by
    by_contra! h
    have hD : (p:ℤ)^(d+1)∣y := by
      have hx' : (p:ℤ)^(d+1)∣x := (padicValInt_dvd_iff _ _).mpr (Or.inr h)
      simpa only [sub_sub_cancel] using dvd_sub hx' (hPow (d+1) (by omega))
    rw [padicValInt_dvd_iff] at hD
    exact (Nat.not_succ_le_self d) (hD.resolve_left hy)
  exact ⟨hx,le_antisymm hHigh hLow⟩

private theorem pow_dvd_of_sq_congruence_zero {p n : ℕ} [Fact p.Prime] {x : ℤ}
    (h : (p:ℤ)^n∣x^2) : (p:ℤ)^((n+1)/2)∣x := by
  by_cases hx : x=0
  · simp [hx]
  · rw [pow_two,padicValInt_dvd_iff,padicValInt.mul hx hx] at h
    have hn := h.resolve_left (mul_ne_zero hx hx)
    exact (padicValInt_dvd_iff _ _).mpr (Or.inr (by omega))

/-- Two square roots modulo a prime power have the same or opposite sign
up to the exact loss allowed by the valuation of their nonzero target. -/
theorem sqroot_two_classes {p n : ℕ} [Fact p.Prime] {D x y : ℤ} (hD : D≠0)
    (hx : (p:ℤ)^n∣x^2-D) (hy : (p:ℤ)^n∣y^2-D) :
    let loss := (padicValInt p D)/2+padicValInt p (2:ℤ)
    (p:ℤ)^(n-loss)∣x-y ∨ (p:ℤ)^(n-loss)∣x+y := by
  dsimp only
  let d := padicValInt p D
  let e := padicValInt p (2:ℤ)
  by_cases hdn : n≤d
  · have hD' : (p:ℤ)^n∣D := (padicValInt_dvd_iff _ _).mpr (Or.inr hdn)
    have hSq (z : ℤ) (hz : (p:ℤ)^n∣z^2-D) : (p:ℤ)^((n+1)/2)∣z := by
      apply pow_dvd_of_sq_congruence_zero
      simpa only [sub_add_cancel] using dvd_add hz hD'
    exact Or.inl ((pow_dvd_pow _ (by omega : n-(d/2+e)≤(n+1)/2)).trans
      (dvd_sub (hSq x hx) (hSq y hy)))
  · have hd : d<n := lt_of_not_ge hdn
    obtain ⟨hy2,hyv⟩ := valuation_eq_of_pow_dvd_sub hD hd hy
    have hy0 : y≠0 := fun h => hy2 (by simp [h])
    rw [pow_two,padicValInt.mul hy0 hy0] at hyv
    have hY : padicValInt p (2*y) = d/2+e := by
      rw [padicValInt.mul (by decide : (2:ℤ)≠0) hy0]
      omega
    by_cases hA : x-y=0
    · simp [hA]
    by_cases hB : x+y=0
    · simp [hB]
    have hProd : (p:ℤ)^n∣(x-y)*(x+y) := by
      convert dvd_sub hx hy using 1
      ring
    have hProd' : n≤padicValInt p (x-y)+padicValInt p (x+y) := by
      rw [padicValInt_dvd_iff,padicValInt.mul hA hB] at hProd
      exact hProd.resolve_left (mul_ne_zero hA hB)
    have hs : padicValInt p (x-y)≤d/2+e ∨ padicValInt p (x+y)≤d/2+e := by
      by_contra! h
      have ha : (p:ℤ)^(d/2+e+1)∣x-y := (padicValInt_dvd_iff _ _).mpr (Or.inr h.1)
      have hb : (p:ℤ)^(d/2+e+1)∣x+y := (padicValInt_dvd_iff _ _).mpr (Or.inr h.2)
      have hc : (p:ℤ)^(d/2+e+1)∣2*y := by
        convert dvd_sub hb ha using 1
        ring
      rw [padicValInt_dvd_iff,hY] at hc
      exact (Nat.not_succ_le_self _) (hc.resolve_left (mul_ne_zero (by decide) hy0))
    rcases hs with ha|hb
    · exact Or.inr ((padicValInt_dvd_iff _ _).mpr (Or.inr (by omega)))
    · exact Or.inl ((padicValInt_dvd_iff _ _).mpr (Or.inr (by omega)))

end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset
open scoped Classical

/-- Cancel the nonzero coefficient in a prime-power divisibility bound. -/
theorem pow_dvd_cancel_left_valuation {p n : ℕ} [Fact p.Prime] {x y : ℤ} (hx : x≠0)
    (h : (p:ℤ)^n∣x*y) : (p:ℤ)^(n-padicValInt p x)∣y := by
  by_cases hy : y=0
  · simp [hy]
  · rw [padicValInt_dvd_iff,padicValInt.mul hx hy] at h
    have hi := h.resolve_left (mul_ne_zero hx hy)
    exact (padicValInt_dvd_iff _ _).mpr (Or.inr (by omega))

private theorem card_residue_class_subset_le {p k loss : ℕ} (hp : 0<p) (S : Finset ℕ)
    (hS : S⊆range (p^k))
    (hcongr : ∀ x∈S,∀ y∈S,(p:ℤ)^(k-loss)∣(y:ℤ)-x) :
    S.card≤p^(min k loss) := by
  classical
  let m := p^(k-loss)
  let n := p^(min k loss)
  have hm : 0 < m := pow_pos hp _
  have he : n*m=p^k := by
    dsimp only [n,m]
    rw [←pow_add,show min k loss+(k-loss)=k by omega]
  have hm' : (m:ℤ)=(p:ℤ)^(k-loss) := by simp [m]
  have hMaps : (S:Set ℕ).MapsTo (fun x=>x/m) (range n : Finset ℕ) := by
    intro x hx
    have hx' : x<n*m := by rw [he]; exact mem_range.mp (hS hx)
    exact mem_range.mpr ((Nat.div_lt_iff_lt_mul hm).mpr hx')
  have hInj : (S:Set ℕ).InjOn (fun x=>x/m) := by
    intro x hx y hy h
    have hh := hcongr x hx y hy
    rw [←hm',←Int.modEq_iff_dvd] at hh
    have hmod : x % m=y % m := by
      change ((x:ℤ) % (m:ℤ))=((y:ℤ) % (m:ℤ)) at hh
      exact_mod_cast hh
    have hx' := Nat.mod_add_div x m
    have hy' := Nat.mod_add_div y m
    change x/m=y/m at h
    rw [hmod,h] at hx'
    exact hx'.symm.trans hy'
  simpa only [card_range,n] using card_le_card_of_injOn _ hMaps hInj

private theorem root_linear_case_charge {p k : ℕ} [Fact p.Prime] {L M N s u x : ℤ}
    (hN : N = -L*u-M*s) (hD : M^2-L*N≠0)
    (hL : (p:ℤ)^k∣L) (hr : (p:ℤ)^k∣L*x^2+2*M*x+N) :
    (p:ℤ)^(k-padicValInt p (M^2-L*N)/2)∣2*x-s := by
  let z := 2*x-s
  have hm : (p:ℤ)^k∣M*z := by
    have h := dvd_sub hr (dvd_mul_of_dvd_left hL (x^2-u))
    convert h using 1
    dsimp only [z]
    linear_combination -hN
  have hn : (p:ℤ)^k∣N*z := by
    have h := dvd_sub (dvd_neg.mpr (dvd_mul_of_dvd_left hL (u*z)))
      (dvd_mul_of_dvd_right hm s)
    convert h using 1
    linear_combination z*hN
  have hp₁ : (p:ℤ)^(k+k)∣(M*z)^2 := by
    rw [pow_add,pow_two]
    exact mul_dvd_mul hm hm
  have hp₂ : (p:ℤ)^(k+k)∣L*(N*z)*z := by
    rw [pow_add]
    exact dvd_mul_of_dvd_left (mul_dvd_mul hL hn) z
  have h : (p:ℤ)^(k+k)∣(M^2-L*N)*z^2 := by
    convert dvd_sub hp₁ hp₂ using 1
    ring
  by_cases hz : z=0
  · simp [show 2*x-s=0 from hz]
  · have h' : (p:ℤ)^(k+k)∣(M^2-L*N)*(z*z) := by simpa only [pow_two] using h
    rw [padicValInt_dvd_iff,padicValInt.mul hD (mul_ne_zero hz hz),padicValInt.mul hz hz] at h'
    have h2 := h'.resolve_left (mul_ne_zero hD (mul_ne_zero hz hz))
    change (p:ℤ)^(k-padicValInt p (M^2-L*N)/2)∣z
    exact (padicValInt_dvd_iff _ _).mpr (Or.inr (by omega))

/-- The critical congruence for a balanced split quartic has at most two
root classes after the loss from its quadratic discriminant. This is the
finite count in Burgess 1962, Lemma 5, with the two-adic cost explicit. -/
theorem quadratic_critical_roots_card_le {p k : ℕ} [Fact p.Prime] {L M N s u : ℤ}
    (hN : N = -L*u-M*s) (hD : M^2-L*N≠0) :
    let loss := padicValInt p (M^2-L*N)/2+padicValInt p (2:ℤ)
    (((range (p^k)).filter (fun x : ℕ => (p:ℤ)^k∣L*(x:ℤ)^2+2*M*x+N)).card) ≤
      2*p^(min k loss) := by
  classical
  let S := (range (p^k)).filter (fun x : ℕ => (p:ℤ)^k∣L*(x:ℤ)^2+2*M*x+N)
  let D := M^2-L*N
  let v := padicValInt p D/2
  let loss := v+padicValInt p (2:ℤ)
  change S.card ≤ 2*p^(min k loss)
  have hp := (Fact.out : p.Prime).pos
  by_cases hL : (p:ℤ)^k∣L
  · have hcongr (x : ℕ) (hx : x∈S) : (p:ℤ)^(k-v)∣2*(x:ℤ)-s :=
      root_linear_case_charge hN hD hL (mem_filter.mp hx).2
    have h (x : ℕ) (hx : x∈S) (y : ℕ) (hy : y∈S) : (p:ℤ)^(k-loss)∣(y:ℤ)-x := by
      have he : (p:ℤ)^(k-v)∣2*((y:ℤ)-x) := by
        convert dvd_sub (hcongr y hy) (hcongr x hx) using 1
        ring
      have h := pow_dvd_cancel_left_valuation (by decide : (2:ℤ)≠0) he
      simpa only [loss,Nat.sub_sub] using h
    have hle := card_residue_class_subset_le hp S (filter_subset ..) h
    omega
  · by_cases hS : S.Nonempty
    · obtain ⟨x₀,hx₀⟩ := hS
      let ℓ := padicValInt p L
      have hL0 : L≠0 := fun h => hL (h ▸ dvd_zero _)
      let Y (x : ℕ) := L*(x:ℤ)+M
      have hsq (x : ℕ) (hx : x∈S) : (p:ℤ)^(k+ℓ)∣(Y x)^2-D := by
        have hd := mul_dvd_mul (mem_filter.mp hx).2 (padicValInt_dvd (p:=p) L)
        rw [←pow_add] at hd
        convert hd using 1
        dsimp only [Y,D]
        ring
      let A := S.filter (fun x => (p:ℤ)^(k+ℓ-loss)∣Y x-Y x₀)
      let B := S.filter (fun x => (p:ℤ)^(k+ℓ-loss)∣Y x+Y x₀)
      have hSub : S⊆A∪B := by
        intro x hx
        have hC := sqroot_two_classes hD (hsq x hx) (hsq x₀ hx₀)
        rcases hC with h|h
        · exact mem_union_left _ (mem_filter.mpr ⟨hx,h⟩)
        · exact mem_union_right _ (mem_filter.mpr ⟨hx,h⟩)
      have hDiff (x y : ℕ) (hh : (p:ℤ)^(k+ℓ-loss)∣Y y-Y x) : (p:ℤ)^(k-loss)∣(y:ℤ)-x := by
        have he : Y y-Y x=L*((y:ℤ)-x) := by dsimp only [Y]; ring
        rw [he] at hh
        have h := pow_dvd_cancel_left_valuation hL0 hh
        have hh : k+ℓ-loss-padicValInt p L=k-loss := by dsimp only [ℓ]; omega
        rwa [hh] at h
      have hA := card_residue_class_subset_le hp A ((filter_subset ..).trans (filter_subset ..))
        (fun x hx y hy => hDiff x y (by
          convert dvd_sub (mem_filter.mp hy).2 (mem_filter.mp hx).2 using 1
          ring))
      have hB := card_residue_class_subset_le hp B ((filter_subset ..).trans (filter_subset ..))
        (fun x hx y hy => hDiff x y (by
          convert dvd_sub (mem_filter.mp hy).2 (mem_filter.mp hx).2 using 1
          ring))
      have hc := card_union_le A B
      have hle := card_le_card hSub
      omega
    · rw [not_nonempty_iff_eq_empty.mp hS,card_empty]
      exact Nat.zero_le _

end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset Polynomial GoldbachBurgess
open scoped Classical ComplexConjugate

noncomputable section

theorem completeBalancedCorrelation_eq_sum_rationalValue {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (a : Fin 4 → ℤ) :
    completeBalancedCorrelation χ a = ∑ x : ZMod q, rationalValue χ
      (splitQuadratic (a 0:ZMod q) (a 1:ZMod q))
      (splitQuadratic (a 2:ZMod q) (a 3:ZMod q)) x := by
  unfold completeBalancedCorrelation
  apply sum_congr rfl
  intro x _
  have hs (z : ZMod q) : starRingEnd ℂ (χ z) = (χ⁻¹) z := MulChar.star_apply' χ z
  simp [Fin.prod_univ_succ,balancedTerm,rationalValue,splitQuadratic,hs,mul_assoc]

theorem slope_mul_eval_eq_critical {q : ℕ} (f g : (ZMod q)[X]) {x : ZMod q}
    (hf : IsUnit (f.eval x)) (hg : IsUnit (g.eval x)) :
    logarithmicSlope f g x*f.eval x*g.eval x = (criticalWronskian f g).eval x := by
  have hf' := ZMod.mul_inv_of_unit _ hf
  have hg' := ZMod.mul_inv_of_unit _ hg
  simp only [logarithmicSlope,criticalWronskian,Polynomial.eval_sub,Polynomial.eval_mul]
  linear_combination f.derivative.eval x*g.eval x*hf' - g.derivative.eval x*f.eval x*hg'

def criticalIntEval (c : Fin 4 → ℤ) (x : ℤ) : ℤ :=
  criticalLeading (c 0) (c 1) (c 2) (c 3)*x^2+
    2*criticalMiddle (c 0) (c 1) (c 2) (c 3)*x+
      criticalConstant (c 0) (c 1) (c 2) (c 3)

def criticalCount (p a b : ℕ) (c : Fin 4 → ℤ) : ℕ :=
  ((range (p^a)).filter (fun n : ℕ => (p:ℤ)^b∣criticalIntEval c n)).card

theorem criticalDvd_iff_phase_support {p q b : ℕ} [NeZero q] (hdiv : p^b∣q)
    (c : Fin 4 → ℤ) (n : ℕ) :
    let R := ZMod q; let x : R := (n:R)
    let f := splitQuadratic (c 0:R) (c 1:R)
    let g := splitQuadratic (c 2:R) (c 3:R)
    IsUnit (f.eval x) → IsUnit (g.eval x) →
    (((p:ℤ)^b∣criticalIntEval c n) ↔ p^b∣(logarithmicSlope f g x).val) := by
  dsimp only
  intro hF hG
  let E := ZMod.castHom hdiv (ZMod (p^b))
  let F := splitQuadratic (c 0:ZMod q) (c 1:ZMod q)
  let G := splitQuadratic (c 2:ZMod q) (c 3:ZMod q)
  let x : ZMod q := (n:ZMod q)
  let S := logarithmicSlope F G x
  have hw := congrArg E (slope_mul_eval_eq_critical F G hF hG)
  change E (S*F.eval x*G.eval x)=E ((criticalWronskian F G).eval x) at hw
  rw [map_mul,map_mul] at hw
  have hc : E ((criticalWronskian F G).eval x) = (criticalIntEval c n : ZMod (p^b)) := by
    simp [F,G,x,criticalIntEval,splitQuadratic_wronskian_eval,criticalLeading,criticalMiddle,criticalConstant,
      map_add,map_mul,map_sub,map_pow,map_ofNat]
  rw [hc] at hw
  change (p:ℤ)^b∣criticalIntEval c n ↔ p^b∣S.val
  rw [←Int.natCast_pow,←ZMod.intCast_zmod_eq_zero_iff_dvd,←hw,
    ←(zmod_castHom_eq_zero_iff_dvd_val hdiv S),mul_assoc]
  change E S*(E (F.eval x)*E (G.eval x))=0 ↔ E S=0
  constructor
  · intro hz
    apply (hF.map E |>.mul (hG.map E)).mul_left_inj.mp
    simpa only [zero_mul] using hz
  · intro hz
    rw [hz,zero_mul]
/-- Retain the explicit critical-residue count after the first stationary
phase. For `a=b` this is the complete even-power estimate. -/
theorem norm_balanced_prime_power_le_criticalCount {p a b : ℕ} (hp : p.Prime)
    (hb : 0<b) (hab : b≤a) (χ : DirichletCharacter ℂ (p^(a+b))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) :
    let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    ‖completeBalancedCorrelation χ c‖≤((p^b:ℕ):ℝ)*criticalCount p a b c := by
  classical
  let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  rw [completeBalancedCorrelation_eq_sum_rationalValue,
    sum_rationalValue_prime_power_digits hp hb hab χ hχ,norm_mul,Complex.norm_natCast]
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ u : Fin (p^a), (if (p:ℤ)^b∣criticalIntEval c (u:ℕ) then (1:ℝ) else 0) := by
      apply sum_le_sum
      intro u _
      split
      · rename_i h
        rw [ite_eq_left ((criticalDvd_iff_phase_support (Nat.pow_dvd_pow p (by omega : b≤a+b)) c u h.1 h.2.1).mpr h.2.2),rationalValue,norm_mul]
        exact (mul_le_mul_of_nonneg_right (χ.norm_le_one _) (norm_nonneg _)).trans
          (by simpa only [one_mul] using (χ⁻¹).norm_le_one _)
      · split <;> simp
    _ = _ := by
      calc
        _ = ∑ u ∈ range (p^a), if (p:ℤ)^b∣criticalIntEval c u then (1:ℝ) else 0 :=
          Fin.sum_univ_eq_sum_range (fun u : ℕ => if (p:ℤ)^b∣criticalIntEval c u then (1:ℝ) else 0) _
        _ = _ := by rw [←sum_filter]; simp [criticalCount]

/-- Burgess's even prime-power complete bound using the discriminant budget. -/
theorem norm_balanced_even_prime_power_discriminant {p k : ℕ} [Fact p.Prime]
    (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ)
    (hD : (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)≠0) :
    let _ : NeZero (p^(k+k)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let loss := padicValInt p ((c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3))/2+padicValInt p (2:ℤ)
    ‖completeBalancedCorrelation χ c‖≤2*(p:ℝ)^k*(p:ℝ)^(min k loss) := by
  let hp : p.Prime := Fact.out
  let _ : NeZero (p^(k+k)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  have h := quadratic_critical_roots_card_le (p:=p) (k:=k)
    (criticalConstant_eq (c 0) (c 1) (c 2) (c 3))
    (by rwa [critical_discriminant_eq])
  dsimp only at h
  rw [critical_discriminant_eq] at h
  have hr := norm_balanced_prime_power_le_criticalCount hp hk le_rfl χ hχ c
  refine hr.trans ?_
  have h' := mul_le_mul_of_nonneg_left
    (show (criticalCount p k k c:ℝ) ≤ 2*(p:ℝ)^
      (min k (padicValInt p ((c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3))/2+padicValInt p (2:ℤ))) by
      exact_mod_cast h) (by positivity : 0≤(p:ℝ)^k)
  push_cast at *
  nlinarith only [h']

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset
open scoped Classical

theorem sum_fin_digits_of_eq {q s t : ℕ} {M : Type*} [AddCommMonoid M]
    (h : q=s*t) (F : ℕ → M) :
    (∑ u : Fin q, F u.val) =
      ∑ u : Fin t, ∑ v : Fin s, F (u.val+t*v.val) := by
  let e : Fin s × Fin t ≃ Fin q := finProdFinEquiv.trans (finCongr h.symm)
  calc
    _ = ∑ z : Fin s × Fin t, F (e z).val := (Equiv.sum_comp e (fun j => F (j:ℕ))).symm
    _ = _ := by
      rw [Fintype.sum_prod_type,sum_comm]
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      simp [e,finProdFinEquiv_apply_val]

theorem card_filter_range_eq_sum_fin {q : ℕ} (P : ℕ→Prop) :
    (((range q).filter P).card:ℝ)=∑ u : Fin q, if P u.val then (1:ℝ) else 0 := by
  calc
    _ = ∑ u ∈ range q, if P u then (1:ℝ) else 0 := by rw [←sum_filter]; simp
    _ = _ := (Fin.sum_univ_eq_sum_range (fun u : ℕ => if P u then (1:ℝ) else 0) q).symm

theorem quadratic_integer_lift {L M N x t v : ℤ} :
    L*(x+t*v)^2+2*M*(x+t*v)+N =
      (L*x^2+2*M*x+N)+(t*v)*(2*L*x+2*M)+L*(t*v)^2 := by ring

theorem quadratic_critical_lift_iff (p k j u v : ℕ) (hj : j≤k) (L M N : ℤ) :
    let P := fun x : ℤ => L*x^2+2*M*x+N
    (p:ℤ)^j∣P (u+p^k*v) ↔ (p:ℤ)^j∣P u := by
  dsimp only
  have h : ((p:ℤ)^j)∣(p:ℤ)^k*(v:ℤ) :=
    dvd_mul_of_dvd_left (pow_dvd_pow _ hj) _
  rw [quadratic_integer_lift]
  rw [dvd_add_left (show ((p:ℤ)^j)∣L*((p:ℤ)^k*(v:ℤ))^2 from
    dvd_mul_of_dvd_right (h.trans (dvd_pow_self _ (by decide : 2≠0))) L),
    dvd_add_left (dvd_mul_of_dvd_left h (2*L*(u:ℤ)+2*M))]

theorem quadratic_critical_singular_lift (p k u v : ℕ) (hk : 0<k) (L M N : ℤ)
    (h₀ : (p:ℤ)^(k+1)∣L*(u:ℤ)^2+2*M*(u:ℤ)+N)
    (h₁ : (p:ℤ)∣2*L*(u:ℤ)+2*M) :
    (p:ℤ)^(k+1)∣L*((u:ℤ)+(p:ℤ)^k*(v:ℤ))^2+2*M*((u:ℤ)+(p:ℤ)^k*(v:ℤ))+N := by
  rw [quadratic_integer_lift]
  have hA : (p:ℤ)^(k+1)∣((p:ℤ)^k*(v:ℤ))*(2*L*(u:ℤ)+2*M) := by
    rw [pow_succ]
    exact mul_dvd_mul (dvd_mul_right _ _) h₁
  have hB : (p:ℤ)^(k+1)∣L*((p:ℤ)^k*(v:ℤ))^2 := by
    rw [mul_pow,←pow_mul]
    exact dvd_mul_of_dvd_right (dvd_mul_of_dvd_left (pow_dvd_pow _ (by omega)) _) _
  exact dvd_add (dvd_add h₀ hA) hB


end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset Polynomial GoldbachBurgess
open scoped Classical

noncomputable section

def balancedF (q : ℕ) (c : Fin 4 → ℤ) : (ZMod q)[X] :=
  splitQuadratic (c 0:ZMod q) (c 1:ZMod q)

def balancedG (q : ℕ) (c : Fin 4 → ℤ) : (ZMod q)[X] :=
  splitQuadratic (c 2:ZMod q) (c 3:ZMod q)

def balancedUnitSupport (q : ℕ) (c : Fin 4 → ℤ) (n : ℕ) : Prop :=
  IsUnit ((balancedF q c).eval (n:ZMod q)) ∧ IsUnit ((balancedG q c).eval (n:ZMod q))

def supportedCritical (p q b : ℕ) (c : Fin 4 → ℤ) (n : ℕ) : Prop :=
  balancedUnitSupport q c n ∧ (p:ℤ)^b∣criticalIntEval c n

def supportedCriticalCount (p q a b : ℕ) (c : Fin 4 → ℤ) : ℕ :=
  ((range (p^a)).filter (supportedCritical p q b c)).card

def supportedRationalValue {p q : ℕ} (χ : DirichletCharacter ℂ q) (c : Fin 4 → ℤ)
    (b n : ℕ) : ℂ :=
  if supportedCritical p q b c n then
    rationalValue χ (balancedF q c) (balancedG q c) (n:ZMod q) else 0

theorem sum_balanced_eq_supported_stationary {p a b : ℕ} (hp : p.Prime)
    (hb : 0<b) (hab : b≤a) (χ : DirichletCharacter ℂ (p^(a+b))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) :
    let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    completeBalancedCorrelation χ c =
      ((p^b:ℕ):ℂ)*∑ u : Fin (p^a), supportedRationalValue (p:=p) χ c b u.val := by
  classical
  let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  rw [completeBalancedCorrelation_eq_sum_rationalValue,sum_rationalValue_prime_power_digits hp hb hab χ hχ]
  congr 1
  apply sum_congr rfl
  intro u _
  let q := p^(a+b)
  let n := u.val
  have he : (IsUnit ((balancedF q c).eval (n:ZMod q)) ∧
      IsUnit ((balancedG q c).eval (n:ZMod q)) ∧
      p^b∣(logarithmicSlope (balancedF q c) (balancedG q c) (n:ZMod q)).val) ↔
        supportedCritical p q b c n := by
    change _ ↔ balancedUnitSupport q c n ∧ _
    constructor
    · intro ⟨hF,hG,h⟩
      exact ⟨⟨hF,hG⟩,(criticalDvd_iff_phase_support (Nat.pow_dvd_pow p (by omega : b≤a+b)) c n hF hG).mpr h⟩
    · intro ⟨⟨hF,hG⟩,h⟩
      exact ⟨hF,hG,(criticalDvd_iff_phase_support (Nat.pow_dvd_pow p (by omega : b≤a+b)) c n hF hG).mp h⟩
  unfold supportedRationalValue
  exact if_congr he rfl rfl

theorem norm_rationalValue_le_one {q : ℕ} (χ : DirichletCharacter ℂ q)
    (f g : (ZMod q)[X]) (x : ZMod q) : ‖rationalValue χ f g x‖≤1 := by
  rw [rationalValue,norm_mul]
  exact (mul_le_mul_of_nonneg_right (χ.norm_le_one _) (norm_nonneg _)).trans
    (by simpa only [one_mul] using (χ⁻¹).norm_le_one _)

theorem norm_balanced_prime_power_le_supportedCriticalCount {p a b : ℕ} (hp : p.Prime)
    (hb : 0<b) (hab : b≤a) (χ : DirichletCharacter ℂ (p^(a+b))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) :
    let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    ‖completeBalancedCorrelation χ c‖≤((p^b:ℕ):ℝ)*supportedCriticalCount p (p^(a+b)) a b c := by
  classical
  let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  rw [sum_balanced_eq_supported_stationary hp hb hab χ hχ c,norm_mul,Complex.norm_natCast]
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  apply (norm_sum_le _ _).trans
  rw [supportedCriticalCount,card_filter_range_eq_sum_fin]
  apply sum_le_sum
  intro u _
  unfold supportedRationalValue
  split
  · exact norm_rationalValue_le_one _ _ _ _
  · simp

theorem supportedCriticalCount_le_criticalCount (p q a b : ℕ) (c : Fin 4 → ℤ) :
    supportedCriticalCount p q a b c ≤ criticalCount p a b c := by
  classical
  apply card_le_card
  intro u hu
  have h := mem_filter.mp hu
  exact mem_filter.mpr ⟨h.1,h.2.2⟩

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Polynomial

noncomputable section

theorem splitQuadratic_eval_two {R : Type*} [CommRing R] (a b x y : R) :
    (splitQuadratic a b).eval (x+y) =
      (splitQuadratic a b).eval x + y*(splitQuadratic a b).derivative.eval x+y^2 := by
  simp only [splitQuadratic,eval_mul,eval_sub,eval_X,eval_C,derivative_mul,derivative_sub,
    derivative_X,derivative_C,sub_zero,one_mul,mul_one,eval_add]
  ring

theorem isUnit_splitQuadratic_eval_add_iff {R : Type*} [CommRing R] (a b x : R)
    {y : R} (h : IsNilpotent y) :
    IsUnit ((splitQuadratic a b).eval (x+y)) ↔ IsUnit ((splitQuadratic a b).eval x) := by
  have he (u : R) : IsUnit (u+y) ↔ IsUnit u := by
    constructor
    · intro hu
      simpa only [add_neg_cancel_right] using
        h.neg.isUnit_add_left_of_commute hu (Commute.all _ _)
    · exact fun hu => h.isUnit_add_left_of_commute hu (Commute.all _ _)
  have hm (u v : R) : IsUnit (u*v) ↔ IsUnit u ∧ IsUnit v := (Commute.all u v).isUnit_mul_iff
  simp only [splitQuadratic,eval_mul,eval_sub,eval_X,eval_C,hm]
  rw [show x+y-a=(x-a)+y by ring,show x+y-b=(x-b)+y by ring,he,he]

def quadraticSlopeCoeff {q : ℕ} (f g : (ZMod q)[X]) (x : ZMod q) : ZMod q :=
  (f.eval x)⁻¹ - (g.eval x)⁻¹ -
    (g.derivative.eval x*(g.eval x)⁻¹)*logarithmicSlope f g x

/-- Third-order truncation of the balanced rational phase for split quadratics. -/
theorem rationalValue_cubic_shift {q : ℕ} (χ : DirichletCharacter ℂ q)
    (a b c d : ZMod q) {x y : ZMod q} (hy : y^3=0)
    (hF : IsUnit ((splitQuadratic a b).eval x))
    (hG : IsUnit ((splitQuadratic c d).eval x)) :
    let f := splitQuadratic a b
    let g := splitQuadratic c d
    rationalValue χ f g (x+y) =
      χ (1+y*logarithmicSlope f g x+y^2*quadraticSlopeCoeff f g x)*rationalValue χ f g x := by
  dsimp only
  let f := splitQuadratic a b
  let g := splitQuadratic c d
  let u := f.derivative.eval x*(f.eval x)⁻¹
  let v := (f.eval x)⁻¹
  let s := g.derivative.eval x*(g.eval x)⁻¹
  let t := (g.eval x)⁻¹
  have hX (a b : ZMod q) (hu : IsUnit ((splitQuadratic a b).eval x)) :
      let F := splitQuadratic a b
      F.eval (x+y)=F.eval x*(1+y*(F.derivative.eval x*(F.eval x)⁻¹)+y^2*(F.eval x)⁻¹) := by
    dsimp only
    rw [splitQuadratic_eval_two]
    have h' := ZMod.mul_inv_of_unit _ hu
    linear_combination -(y*(splitQuadratic a b).derivative.eval x+y^2)*h'
  have hY : (1+y*s+y^2*t)*(1-y*s+y^2*(s^2-t))=1 := by
    linear_combination (s^3-2*s*t+y*(s^2*t-t^2))*hy
  have hInv : (χ⁻¹) (1+y*s+y^2*t)=χ (1-y*s+y^2*(s^2-t)) := by
    rw [MulChar.inv_apply_eq_inv']
    apply inv_eq_of_mul_eq_one_right
    rw [←map_mul,hY,map_one]
  have hMain : (1+y*u+y^2*v)*(1-y*s+y^2*(s^2-t)) =
      1+y*(u-s)+y^2*(v-t-s*(u-s)) := by
    linear_combination (u*(s^2-t)-v*s+y*v*(s^2-t))*hy
  change rationalValue χ f g (x+y) =
    χ (1+y*(u-s)+y^2*(v-t-s*(u-s)))*rationalValue χ f g x
  unfold rationalValue
  rw [hX a b hF,hX c d hG]
  change χ (f.eval x*(1+y*u+y^2*v))*(χ⁻¹) (g.eval x*(1+y*s+y^2*t))=_
  rw [map_mul,map_mul,hInv,←hMain,map_mul]
  ring

theorem quadraticSlopeCoeff_mul_eval_eq {q : ℕ} (f g : (ZMod q)[X]) {x : ZMod q}
    (hf : IsUnit (f.eval x)) (hg : IsUnit (g.eval x)) :
    quadraticSlopeCoeff f g x*f.eval x*g.eval x =
      g.eval x-f.eval x-g.derivative.eval x*f.eval x*logarithmicSlope f g x := by
  have hf' := ZMod.mul_inv_of_unit _ hf
  have hg' := ZMod.mul_inv_of_unit _ hg
  unfold quadraticSlopeCoeff
  linear_combination g.eval x*hf' -
    (f.eval x+g.derivative.eval x*f.eval x*logarithmicSlope f g x)*hg'

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset
open scoped ComplexConjugate

noncomputable section

/-- Quadratic Gauss norm for any primitive additive character.
Adapted from the standard-character proof in FareyHyperbolaRectangles. -/
theorem quadratic_gauss_norm (p : ℕ) [Fact p.Prime]
    (ψ : AddChar (ZMod p) ℂ) (hψ : ψ.IsPrimitive) (hp2 : p ≠ 2) (A B : ZMod p) (hA : A ≠ 0) :
    ‖∑ x : ZMod p, ψ (A * x ^ 2 + B * x)‖ = Real.sqrt (p : ℝ) := by
  classical
  let S := ∑ x : ZMod p, ψ (A * x ^ 2 + B * x)
  have htwo : (2 : ZMod p) ≠ 0 := by
    intro h
    have hd : p ∣ 2 := (ZMod.natCast_eq_zero_iff 2 p).mp h
    exact ((Nat.dvd_prime Nat.prime_two).mp hd).elim (Fact.out : p.Prime).ne_one hp2
  have hs : S * starRingEnd ℂ S = (p : ℂ) := by
    calc
      _ = ∑ x : ZMod p, ∑ y : ZMod p,
          ψ (A * x ^ 2 + B * x - (A * y ^ 2 + B * y)) := by
        simp only [S, map_sum, sum_mul, mul_sum, sub_eq_add_neg,
          AddChar.map_add_eq_mul, AddChar.map_neg_eq_conj]
        exact sum_comm
      _ = ∑ y : ZMod p, ∑ x : ZMod p,
          ψ (A * (x + y) ^ 2 + B * (x + y) - (A * y ^ 2 + B * y)) := by
        rw [sum_comm]
        apply sum_congr rfl
        intro y _
        exact (Equiv.sum_comp (Equiv.addRight y)
          (fun x ↦ ψ (A * x ^ 2 + B * x - (A * y ^ 2 + B * y)))).symm
      _ = ∑ x : ZMod p, ψ (A * x ^ 2 + B * x) *
          ∑ y : ZMod p, ψ ((2 * A * x) * y) := by
        rw [sum_comm]
        apply sum_congr rfl
        intro x _
        rw [mul_sum]
        apply sum_congr rfl
        intro y _
        rw [← AddChar.map_add_eq_mul]
        congr 1
        ring
      _ = (p : ℂ) := by
        rw [sum_eq_single 0]
        · simp only [mul_zero, zero_mul, zero_pow (by decide : 2 ≠ 0), add_zero,
            AddChar.map_zero_eq_one, sum_const, card_univ, ZMod.card, nsmul_eq_mul,
            mul_one, one_mul]
        · intro x _ hx
          have hzero : ∑ y : ZMod p, ψ ((2 * A * x) * y) = 0 :=
            AddChar.sum_eq_zero_of_ne_one
              (hψ (mul_ne_zero (mul_ne_zero htwo hA) hx))
          rw [hzero, mul_zero]
        · simp
  have hsq : ‖S‖ ^ 2 = (p : ℝ) := by
    have he := (Complex.mul_conj S).symm.trans hs
    rw [Complex.normSq_eq_norm_sq] at he
    exact_mod_cast he
  apply (sq_eq_sq₀ (norm_nonneg _) (Real.sqrt_nonneg _)).mp
  rw [Real.sq_sqrt (Nat.cast_nonneg p)]
  exact hsq


theorem linear_gauss_sum (p : ℕ) [Fact p.Prime] (ψ : AddChar (ZMod p) ℂ)
    (hψ : ψ.IsPrimitive) (A : ZMod p) :
    (∑ x : ZMod p, ψ (A*x)) = if A=0 then (p:ℂ) else 0 := by
  classical
  by_cases h : A=0
  · simp [h, ZMod.card, nsmul_eq_mul]
  · rw [ite_eq_right h]
    exact AddChar.sum_eq_zero_of_ne_one (hψ h)

theorem lastLayerScale_natCast {p s : ℕ} (hp : p.Prime) (n : ℕ) :
    let R := ZMod (p^(s+1))
    let t : R := ((p^s:ℕ):R)
    t * (((n:ZMod p).val:ℕ):R) = t * (n:R) := by
  let _ : NeZero p := ⟨hp.ne_zero⟩
  dsimp only
  rw [ZMod.val_natCast]
  have ht : (((p^s:ℕ):ZMod (p^(s+1))))*(p:ZMod (p^(s+1)))=0 := by
    rw [←Nat.cast_mul,←pow_succ,ZMod.natCast_self]
  have hn := congrArg (fun v : ℕ => (v:ZMod (p^(s+1)))) (Nat.mod_add_div n p)
  push_cast at hn
  calc
    _ = (((p^s:ℕ):ZMod (p^(s+1)))) * ((n % p:ℕ) + (p:ZMod (p^(s+1)))*((n/p:ℕ):ZMod (p^(s+1)))) := by
      rw [mul_add,←mul_assoc,ht,zero_mul,add_zero]
    _ = _ := by rw [←hn]

/-- The top principal-unit layer viewed as an additive character. -/
def lastLayerChar {p s : ℕ} (hp : p.Prime) (hs : 0<s)
    (χ : DirichletCharacter ℂ (p^(s+1))) : AddChar (ZMod p) ℂ where
  toFun z := χ (1+((p^s:ℕ):ZMod (p^(s+1)))*((z.val:ℕ):ZMod (p^(s+1))))
  map_zero_eq_one' := by simp
  map_add_eq_mul' x y := by
    let _ : NeZero p := ⟨hp.ne_zero⟩
    let R := ZMod (p^(s+1))
    let t : R := ((p^s:ℕ):R)
    have ht : t^2=0 := by
      dsimp only [t,R]
      rw [←Nat.cast_pow,←pow_mul,ZMod.natCast_eq_zero_iff]
      exact Nat.pow_dvd_pow p (by omega)
    have hxy : (((x.val+y.val:ℕ):ZMod p))=x+y := by
      simp only [Nat.cast_add,ZMod.natCast_zmod_val]
    change χ (1+t*((((x+y).val:ℕ):R))) = χ (1+t*(x.val:R))*χ (1+t*(y.val:R))
    rw [←hxy,lastLayerScale_natCast hp,Nat.cast_add,←map_mul]
    congr 1
    linear_combination - (x.val:R)*(y.val:R)*ht

theorem lastLayerChar_isPrimitive {p s : ℕ} (hp : p.Prime) (hs : 0<s)
    (χ : DirichletCharacter ℂ (p^(s+1))) (hχ : χ.IsPrimitive) :
    let _ : Fact p.Prime := ⟨hp⟩
    (lastLayerChar hp hs χ).IsPrimitive := by
  let _ : Fact p.Prime := ⟨hp⟩
  dsimp only
  apply AddChar.IsPrimitive.of_ne_one
  intro he
  have h := congrArg (fun ψ : AddChar (ZMod p) ℂ => ψ 1) he
  change χ (1+((p^s:ℕ):ZMod (p^(s+1)))*(((1:ZMod p).val:ℕ):ZMod (p^(s+1))))=1 at h
  rw [ZMod.val_one'' hp.ne_one,Nat.cast_one,mul_one] at h
  exact primitive_last_layer_ne_one hp hs χ hχ h

/-- Reduction to the prime field naming the last principal-unit layer. -/
def lastLayerReduction (p s : ℕ) : ZMod (p^(s+1)) →+* ZMod p :=
  ZMod.castHom (dvd_pow_self p (Nat.succ_ne_zero s)) (ZMod p)

theorem lastLayerChar_apply_reduction {p s : ℕ} (hp : p.Prime) (hs : 0<s)
    (χ : DirichletCharacter ℂ (p^(s+1))) (z : ZMod (p^(s+1))) :
    lastLayerChar hp hs χ (lastLayerReduction p s z) =
      χ (1+((p^s:ℕ):ZMod (p^(s+1)))*z) := by
  let _ : NeZero (p^(s+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  change χ (1+((p^s:ℕ):ZMod (p^(s+1)))*
      ((((lastLayerReduction p s z).val:ℕ):ZMod (p^(s+1)))))=_
  conv_lhs => rw [←ZMod.natCast_zmod_val z, map_natCast]
  rw [lastLayerScale_natCast hp,ZMod.natCast_zmod_val]

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset Polynomial
open scoped Classical

noncomputable section

private theorem finSum_eq_zmodSum {p : ℕ} [NeZero p] (F : ZMod p → ℂ) :
    (∑ j : Fin p, F ((j.val:ℕ):ZMod p)) = ∑ j : ZMod p, F j := by
  let e : Fin p ≃ ZMod p := (ZMod.finEquiv p).toEquiv
  have he (j : Fin p) : e j=((j.val:ℕ):ZMod p) := by
    change ZMod.finEquiv p j=((j.val:ℕ):ZMod p)
    apply ZMod.val_injective p
    rw [ZMod.val_natCast_of_lt j.isLt]
    cases p with
    | zero => exact (NeZero.ne 0 rfl).elim
    | succ p => rfl
  simpa only [he] using Equiv.sum_comp e F

theorem odd_phase_lift_exists {p k : ℕ} (hp : p.Prime) (z : ZMod (p^(k+k+1)))
    (hz : p^k∣z.val) : ∃ A : ZMod (p^(k+k+1)), z=((p^k:ℕ):ZMod (p^(k+k+1)))*A := by
  let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  obtain ⟨u,hu⟩ := hz
  exact ⟨(u:ZMod (p^(k+k+1))), by rw [←ZMod.natCast_zmod_val z,hu,Nat.cast_mul]⟩

/-- Exact Gaussian sum in a critical block of odd prime-power modulus. -/
theorem sum_rationalValue_odd_prime_power_block {p k : ℕ} (hp : p.Prime) (hk : 0<k)
    (χ : DirichletCharacter ℂ (p^(k+k+1))) :
    let _ : NeZero p := ⟨hp.ne_zero⟩
    let R := ZMod (p^(k+k+1)); let t : R := ((p^k:ℕ):R)
    let E := lastLayerReduction p (k+k)
    let ψ := lastLayerChar hp (by omega : 0<k+k) χ
    ∀ a b c d x A : R,
      let f := splitQuadratic a b; let g := splitQuadratic c d
      IsUnit (f.eval x) → IsUnit (g.eval x) →
      logarithmicSlope f g x=t*A →
      (∑ v : Fin p, rationalValue χ f g (x+t*((v:ℕ):R))) =
        rationalValue χ f g x *
          ∑ v : ZMod p, ψ (E A*v + E (quadraticSlopeCoeff f g x)*v^2) := by
  classical
  let _ : NeZero p := ⟨hp.ne_zero⟩
  dsimp only
  intro a b c d x A hF hG hA
  let R := ZMod (p^(k+k+1))
  let t : R := ((p^k:ℕ):R)
  let f := splitQuadratic a b
  let g := splitQuadratic c d
  let E := lastLayerReduction p (k+k)
  let ψ := lastLayerChar hp (by omega : 0<k+k) χ
  let B := quadraticSlopeCoeff f g x
  change (∑ v : Fin p,rationalValue χ f g (x+t*((v:ℕ):R))) =
    rationalValue χ f g x * ∑ v : ZMod p, ψ (E A*v+E B*v^2)
  rw [←finSum_eq_zmodSum,mul_sum]
  apply sum_congr rfl
  intro v _
  let w : R := ((v:ℕ):R)
  have ht : t^3=0 := by
    dsimp only [t,R]
    rw [←Nat.cast_pow,←pow_mul,ZMod.natCast_eq_zero_iff]
    exact Nat.pow_dvd_pow p (by omega)
  have hw : (t*w)^3=0 := by rw [mul_pow,ht,zero_mul]
  rw [rationalValue_cubic_shift χ a b c d hw hF hG,hA]
  have hq : t^2=((p^(k+k):ℕ):R) := by
    calc
      _ = (((p^k*p^k:ℕ):R)) := by simp only [t,pow_two,Nat.cast_mul]
      _ = _ := congrArg (fun n : ℕ => (n:R)) (pow_add p k k).symm
  have hD : (t*w)*(t*A)+(t*w)^2*B=t^2*(A*w+B*w^2) := by ring
  change χ (1+(t*w)*(t*A)+(t*w)^2*B)*rationalValue χ f g x =
    rationalValue χ f g x*ψ (E A*((v:ℕ):ZMod p)+E B*((v:ℕ):ZMod p)^2)
  rw [show 1+(t*w)*(t*A)+(t*w)^2*B=1+((t*w)*(t*A)+(t*w)^2*B) by ring,
    hD,hq]
  have he : E (A*w+B*w^2)=E A*((v:ℕ):ZMod p)+E B*((v:ℕ):ZMod p)^2 := by
    simp [w]
  rw [←he,lastLayerChar_apply_reduction hp _ χ,mul_comm]

theorem norm_odd_block_gauss_le (p : ℕ) [Fact p.Prime] (hp2 : p≠2)
    (ψ : AddChar (ZMod p) ℂ) (hψ : ψ.IsPrimitive) (A B : ZMod p) :
    ‖∑ v : ZMod p, ψ (A*v+B*v^2)‖ ≤
      (if B=0 then (if A=0 then (p:ℝ) else 0) else Real.sqrt p) := by
  classical
  by_cases hB : B=0
  · simp only [hB,zero_mul,add_zero,ite_true]
    rw [linear_gauss_sum p ψ hψ A]
    split <;> simp
  · simp only [hB,ite_false,add_comm (A*_)]
    exact le_of_eq (quadratic_gauss_norm p ψ hψ hp2 B A hB)

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset Polynomial
open scoped Classical

noncomputable section

theorem castHom_odd_phase_eq_zero_of_small_reduction {p k : ℕ} (hp : p.Prime)
    (A : ZMod (p^(k+k+1))) (hA : lastLayerReduction p (k+k) A=0) :
    let E := ZMod.castHom (Nat.pow_dvd_pow p (by omega : k+1≤k+k+1)) (ZMod (p^(k+1)))
    E (((p^k:ℕ):ZMod (p^(k+k+1)))*A)=0 := by
  let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  let _ : NeZero p := ⟨hp.ne_zero⟩
  dsimp only
  let E := ZMod.castHom (Nat.pow_dvd_pow p (by omega : k+1≤k+k+1)) (ZMod (p^(k+1)))
  change E (((p^k:ℕ):ZMod (p^(k+k+1)))*A)=0
  obtain ⟨u,hu⟩ := (zmod_castHom_eq_zero_iff_dvd_val (dvd_pow_self p (Nat.succ_ne_zero (k+k))) A).mp hA
  conv_lhs => rw [←ZMod.natCast_zmod_val A,hu,←Nat.cast_mul,←mul_assoc,←pow_succ,Nat.cast_mul]
  rw [map_mul,map_natCast,ZMod.natCast_self,zero_mul]

theorem criticalDvd_of_singular_block {p k : ℕ} (hp : p.Prime) (c : Fin 4 → ℤ) (n : ℕ) :
    let R := ZMod (p^(k+k+1)); let x : R := (n:R)
    let f := splitQuadratic (c 0:R) (c 1:R)
    let g := splitQuadratic (c 2:R) (c 3:R)
    let E := lastLayerReduction p (k+k)
    ∀ A : R, IsUnit (f.eval x) → IsUnit (g.eval x) →
      logarithmicSlope f g x=((p^k:ℕ):R)*A →
      E A=0 → E (quadraticSlopeCoeff f g x)=0 →
      (p:ℤ)^(k+1)∣criticalIntEval c n ∧
        (p:ℤ)∣2*criticalLeading (c 0) (c 1) (c 2) (c 3)*(n:ℤ)+
          2*criticalMiddle (c 0) (c 1) (c 2) (c 3) := by
  let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  let _ : NeZero p := ⟨hp.ne_zero⟩
  dsimp only
  intro A hF hG hS hA hB
  let R := ZMod (p^(k+k+1))
  let f := splitQuadratic (c 0:R) (c 1:R)
  let g := splitQuadratic (c 2:R) (c 3:R)
  let x : R := (n:R)
  let E := lastLayerReduction p (k+k)
  let L := criticalLeading (c 0) (c 1) (c 2) (c 3)
  let M := criticalMiddle (c 0) (c 1) (c 2) (c 3)
  change logarithmicSlope f g x=((p^k:ℕ):R)*A at hS
  change E A=0 at hA
  change E (quadraticSlopeCoeff f g x)=0 at hB
  constructor
  · apply (criticalDvd_iff_phase_support (Nat.pow_dvd_pow p (by omega : k+1≤k+k+1)) c n hF hG).mpr
    rw [←zmod_castHom_eq_zero_iff_dvd_val (Nat.pow_dvd_pow p (by omega : k+1≤k+k+1)),hS]
    exact castHom_odd_phase_eq_zero_of_small_reduction hp A hA
  · have hs : E (logarithmicSlope f g x)=0 := by rw [hS,map_mul,hA,mul_zero]
    have hb := congrArg E (quadraticSlopeCoeff_mul_eval_eq f g hF hG)
    change E (quadraticSlopeCoeff f g x*f.eval x*g.eval x) =
      E (g.eval x-f.eval x-g.derivative.eval x*f.eval x*logarithmicSlope f g x) at hb
    rw [map_mul,map_mul,hB,zero_mul,zero_mul,map_sub,map_sub,map_mul,map_mul,hs,mul_zero,sub_zero] at hb
    have hij : E (g.eval x)-E (f.eval x)=((L*(n:ℤ)+M:ℤ):ZMod p) := by
      simp only [f,g,x,splitQuadratic,eval_mul,eval_sub,eval_X,eval_C]
      simp only [L,M,criticalLeading,criticalMiddle,map_mul,map_sub,map_natCast,map_intCast,
        Int.cast_mul,Int.cast_add,Int.cast_sub,Int.cast_natCast]
      ring
    rw [hij] at hb
    have hj : (p:ℤ)∣L*(n:ℤ)+M := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hb.symm
    convert (dvd_mul_of_dvd_right hj (2:ℤ)) using 1
    ring

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset Polynomial GoldbachBurgess
open scoped Classical

noncomputable section

private theorem odd_increment_cube {p k : ℕ} (hk : 0<k) (v : ℕ) :
    ((((p^k:ℕ):ZMod (p^(k+k+1))))*(v:ZMod (p^(k+k+1))))^3=0 := by
  rw [←Nat.cast_mul,←Nat.cast_pow,ZMod.natCast_eq_zero_iff,mul_pow,←pow_mul]
  exact dvd_mul_of_dvd_left (Nat.pow_dvd_pow p (by omega)) _

private theorem odd_unitSupport_lift (p k : ℕ) (hk : 0<k) (c : Fin 4 → ℤ) (u v : ℕ) :
    balancedUnitSupport (p^(k+k+1)) c (u+p^k*v) ↔ balancedUnitSupport (p^(k+k+1)) c u := by
  unfold balancedUnitSupport balancedF balancedG
  simp only [Nat.cast_add,Nat.cast_mul]
  exact and_congr
    (isUnit_splitQuadratic_eval_add_iff _ _ _ ⟨3,odd_increment_cube hk v⟩)
    (isUnit_splitQuadratic_eval_add_iff _ _ _ ⟨3,odd_increment_cube hk v⟩)

private theorem odd_supportedCritical_lift {p k : ℕ} (hk : 0<k) (c : Fin 4 → ℤ) (u v : ℕ) :
    supportedCritical p (p^(k+k+1)) k c (u+p^k*v) ↔ supportedCritical p (p^(k+k+1)) k c u := by
  unfold supportedCritical
  apply and_congr (odd_unitSupport_lift p k hk c u v)
  simpa only [criticalIntEval,Nat.cast_add,Nat.cast_mul,Nat.cast_pow] using
    quadratic_critical_lift_iff p k k u v le_rfl
      (criticalLeading (c 0) (c 1) (c 2) (c 3))
      (criticalMiddle (c 0) (c 1) (c 2) (c 3))
      (criticalConstant (c 0) (c 1) (c 2) (c 3))

private theorem odd_supportedCritical_singular_lift {p k : ℕ} (hk : 0<k)
    (c : Fin 4 → ℤ) (u v : ℕ)
    (hU : balancedUnitSupport (p^(k+k+1)) c u)
    (h₀ : (p:ℤ)^(k+1)∣criticalIntEval c u)
    (h₁ : (p:ℤ)∣2*criticalLeading (c 0) (c 1) (c 2) (c 3)*(u:ℤ)+
      2*criticalMiddle (c 0) (c 1) (c 2) (c 3)) :
    supportedCritical p (p^(k+k+1)) (k+1) c (u+p^k*v) := by
  refine ⟨(odd_unitSupport_lift p k hk c u v).mpr hU,?_⟩
  simpa only [criticalIntEval,Nat.cast_add,Nat.cast_mul,Nat.cast_pow] using
    quadratic_critical_singular_lift p k u v hk
      (criticalLeading (c 0) (c 1) (c 2) (c 3))
      (criticalMiddle (c 0) (c 1) (c 2) (c 3))
      (criticalConstant (c 0) (c 1) (c 2) (c 3)) h₀ h₁

/-- The second stationary-phase inequality, retaining both critical residue
counts from Burgess 1962, §2, Lemma 4. -/
theorem norm_balanced_odd_prime_power_le_supportedCounts {p k : ℕ} [Fact p.Prime]
    (hp2 : p≠2) (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k+1))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) :
    let q := p^(k+k+1)
    let _ : NeZero q := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    ‖completeBalancedCorrelation χ c‖≤(p:ℝ)^k*
      (Real.sqrt p*supportedCriticalCount p q k k c+
        supportedCriticalCount p q (k+1) (k+1) c) := by
  classical
  let hp : p.Prime := Fact.out
  let q := p^(k+k+1)
  let _ : NeZero q := ⟨pow_ne_zero _ hp.ne_zero⟩
  let R := ZMod q
  let f := balancedF q c
  let g := balancedG q c
  let W := supportedRationalValue (p:=p) χ c k
  let I (j n : ℕ) : ℝ := if supportedCritical p q j c n then 1 else 0
  let ψ := lastLayerChar hp (by omega : 0<k+k) χ
  let E := lastLayerReduction p (k+k)
  have hψ : ψ.IsPrimitive := lastLayerChar_isPrimitive hp _ χ hχ
  have hI (j n : ℕ) : 0≤I j n := by unfold I; split <;> norm_num
  have he' := @sum_balanced_eq_supported_stationary p (k+1) k
  rw [show k+1+k=k+k+1 by omega] at he'
  have hCorr := he' hp hk (by omega : k≤k+1) χ hχ c
  change completeBalancedCorrelation χ c = ((p^k:ℕ):ℂ)*∑ u : Fin (p^(k+1)), W u.val at hCorr
  have hrad : p^(k+1) = p*p^k := by rw [pow_succ,mul_comm]
  rw [sum_fin_digits_of_eq hrad W] at hCorr
  change ‖completeBalancedCorrelation χ c‖ ≤ (p:ℝ)^k*_
  rw [hCorr,norm_mul,Complex.norm_natCast,Nat.cast_pow]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ u : Fin (p^k),
        (Real.sqrt p * I k u.val + ∑ v : Fin p, I (k+1) (u.val+p^k*v.val)) := by
      apply sum_le_sum
      intro u _
      let x : R := (u.val:R)
      let Y (v : Fin p) : ℕ := u.val+p^k*v.val
      by_cases hC : supportedCritical p q k c u.val
      · have hS : p^k∣(logarithmicSlope f g x).val :=
          (criticalDvd_iff_phase_support (Nat.pow_dvd_pow p (by omega : k≤k+k+1)) c u.val hC.1.1 hC.1.2).mp hC.2
        obtain ⟨A,hA⟩ := odd_phase_lift_exists hp _ hS
        let B := quadraticSlopeCoeff f g x
        have hVal (v : Fin p) : W (Y v)=
            rationalValue χ f g (x+((p^k:ℕ):R)*(v.val:R)) := by
          have hv := (odd_supportedCritical_lift hk c u.val v.val).mpr hC
          simp [W,supportedRationalValue,Y,x,f,g,q,hv]
        have hSum : (∑ v : Fin p,W (Y v)) =
            rationalValue χ f g x * ∑ v : ZMod p, ψ (E A*v+E B*v^2) := by
          simp_rw [hVal]
          exact sum_rationalValue_odd_prime_power_block hp hk χ
            (c 0:R) (c 1:R) (c 2:R) (c 3:R) x A hC.1.1 hC.1.2 hA
        change ‖∑ v : Fin p,W (Y v)‖ ≤ _
        rw [hSum,norm_mul]
        refine (mul_le_mul_of_nonneg_right (norm_rationalValue_le_one _ _ _ _) (norm_nonneg _)).trans ?_
        rw [one_mul]
        refine (norm_odd_block_gauss_le p hp2 ψ hψ (E A) (E B)).trans ?_
        have hs : I k u.val=1 := ite_eq_left hC
        rw [hs,mul_one]
        have hNon : 0≤∑ v : Fin p,I (k+1) (Y v) := sum_nonneg (fun v _=>hI _ _)
        change (if E B=0 then (if E A=0 then (p:ℝ) else 0) else Real.sqrt p) ≤
          Real.sqrt p+∑ v : Fin p, I (k+1) (Y v)
        split
        · rename_i hB
          split
          · rename_i h₁
            obtain ⟨hNext,hDeriv⟩ := criticalDvd_of_singular_block hp c u.val A hC.1.1 hC.1.2 hA h₁ hB
            have hAll (v : Fin p) : I (k+1) (Y v)=1 :=
              ite_eq_left (odd_supportedCritical_singular_lift hk c u.val v.val hC.1 hNext hDeriv)
            simp_rw [hAll,sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,mul_one]
            exact le_add_of_nonneg_left (Real.sqrt_nonneg _)
          · exact add_nonneg (Real.sqrt_nonneg _) hNon
        · exact le_add_of_nonneg_right hNon
      · have hVal (v : Fin p) : W (Y v)=0 := by
          have hv := mt (odd_supportedCritical_lift hk c u.val v.val).mp hC
          exact ite_eq_right hv
        change ‖∑ v : Fin p,W (Y v)‖ ≤ _
        simp_rw [hVal,sum_const_zero,norm_zero]
        apply add_nonneg
        · exact mul_nonneg (Real.sqrt_nonneg _) (hI _ _)
        · exact sum_nonneg (fun v _=>hI _ _)
    _ = _ := by
      rw [sum_add_distrib,←mul_sum]
      have hSum₁ := card_filter_range_eq_sum_fin (q:=p^k) (supportedCritical p q k c)
      have hSum₂ := card_filter_range_eq_sum_fin (q:=p^(k+1)) (supportedCritical p q (k+1) c)
      change _ = ∑ u : Fin (p^(k+1)), I (k+1) u.val at hSum₂
      rw [sum_fin_digits_of_eq hrad (I (k+1))] at hSum₂
      exact congrArg₂ (fun u v : ℝ=>Real.sqrt p*u+v) hSum₁.symm hSum₂.symm

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

/-- A prime-power root multiplicity costs no more than the square root
of the discriminant gcd, with an extra allowance of j layers. -/
theorem primePower_pow_le_sqrt_gcd_mul {p ν m j : ℕ} [Fact p.Prime] {D : ℤ}
    (hq : 2*m≤ν+j) (hD : 2*m≤padicValInt p D+j) :
    (p:ℝ)^m≤Real.sqrt ((p:ℝ)^j)*Real.sqrt (Nat.gcd (p^ν) D.natAbs) := by
  let e := 2*m-j
  have ep : e≤ν := by dsimp only [e]; omega
  have ed : e≤padicValInt p D := by dsimp only [e]; omega
  have hp := (Fact.out : p.Prime)
  have hg : p^e∣Nat.gcd (p^ν) D.natAbs := by
    apply Nat.dvd_gcd (Nat.pow_dvd_pow _ ep)
    apply Int.natCast_dvd.mp
    rw [Nat.cast_pow]
    exact (padicValInt_dvd_iff _ _).mpr (Or.inr ed)
  have hG := Nat.le_of_dvd (Nat.gcd_pos_of_pos_left _ (pow_pos hp.pos _)) hg
  have hpR : (1:ℝ)≤p := by exact_mod_cast hp.one_lt.le
  rw [←Real.sqrt_mul (by positivity),←Real.sqrt_sq (by positivity : 0≤(p:ℝ)^m)]
  apply Real.sqrt_le_sqrt
  rw [←pow_mul]
  calc
    _ ≤ (p:ℝ)^(j+e) := pow_le_pow_right₀ hpR (by dsimp only [e]; omega)
    _ = (p:ℝ)^j*(p:ℝ)^e := by rw [pow_add]
    _ ≤ _ := mul_le_mul_of_nonneg_left (by exact_mod_cast hG) (by positivity)

theorem primePower_pow_min_loss_le {p ν k j : ℕ} [Fact p.Prime] {D : ℤ}
    (hν : 2*k≤ν+j) :
    (p:ℝ)^(min k (padicValInt p D/2+padicValInt p (2:ℤ)))≤
      2*Real.sqrt ((p:ℝ)^j)*Real.sqrt (Nat.gcd (p^ν) D.natAbs) := by
  let v := padicValInt p D/2
  let b := padicValInt p (2:ℤ)
  let m := min k v
  have hp := (Fact.out : p.Prime)
  have hpR : (1:ℝ)≤p := by exact_mod_cast hp.one_lt.le
  have hb : (p:ℝ)^b≤2 := by
    have hb : p^b∣2 := by
      have hh := padicValInt_dvd (p:=p) (2:ℤ)
      change (p:ℤ)^b∣(2:ℤ) at hh
      exact_mod_cast hh
    exact_mod_cast Nat.le_of_dvd (by decide : 0<2) hb
  have hm := primePower_pow_le_sqrt_gcd_mul (p:=p) (ν:=ν) (m:=m) (j:=j) (D:=D)
    (by dsimp only [m]; omega) (by dsimp only [m,v]; omega)
  change (p:ℝ)^(min k (v+b))≤_
  calc
    _ ≤ (p:ℝ)^(b+m) := pow_le_pow_right₀ hpR (by dsimp only [m]; omega)
    _ = (p:ℝ)^b*(p:ℝ)^m := by rw [pow_add]
    _ ≤ 2*(p:ℝ)^m := mul_le_mul_of_nonneg_right hb (by positivity)
    _ ≤ _ := by simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hm (by norm_num : (0:ℝ)≤2)

end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset Polynomial GoldbachBurgess
open scoped Classical

noncomputable section

private theorem card_filter_range_eq_sum_fin_dec {q : ℕ} (P : ℕ→Prop) [DecidablePred P] :
    (((range q).filter P).card:ℝ)=∑ u : Fin q, if P u.val then (1:ℝ) else 0 := by
  calc
    _ = ∑ u ∈ range q, if P u then (1:ℝ) else 0 := by rw [←sum_filter]; simp
    _ = _ := (Fin.sum_univ_eq_sum_range (fun u : ℕ => if P u then (1:ℝ) else 0) q).symm

theorem criticalCount_more_digits (p k : ℕ) (c : Fin 4 → ℤ) :
    (criticalCount p (k+1) k c:ℝ)=p*(criticalCount p k k c:ℝ) := by
  unfold criticalCount
  rw [card_filter_range_eq_sum_fin_dec (q:=p^(k+1)) (fun n : ℕ => (p:ℤ)^k∣criticalIntEval c n),
    card_filter_range_eq_sum_fin_dec (q:=p^k) (fun n : ℕ => (p:ℤ)^k∣criticalIntEval c n)]
  have hrad : p^(k+1)=p*p^k := by rw [pow_succ,mul_comm]
  rw [sum_fin_digits_of_eq hrad (fun n : ℕ => if (p:ℤ)^k∣criticalIntEval c n then (1:ℝ) else 0)]
  have hI (u v : ℕ) : (p:ℤ)^k∣criticalIntEval c (u+p^k*v) ↔
      (p:ℤ)^k∣criticalIntEval c u := by
    simpa only [criticalIntEval,Nat.cast_add,Nat.cast_mul,Nat.cast_pow] using
      quadratic_critical_lift_iff p k k u v le_rfl
        (criticalLeading (c 0) (c 1) (c 2) (c 3))
        (criticalMiddle (c 0) (c 1) (c 2) (c 3))
        (criticalConstant (c 0) (c 1) (c 2) (c 3))
  rw [mul_sum]
  apply sum_congr rfl
  intro u _
  calc
    _ = ∑ _ : Fin p, (if (p:ℤ)^k∣criticalIntEval c u.val then (1:ℝ) else 0) := by
      apply sum_congr rfl
      intro v _
      exact if_congr (hI u.val v.val) rfl rfl
    _ = _ := by simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul]

theorem norm_completeBalancedCorrelation_le_modulus {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (c : Fin 4 → ℤ) :
    ‖completeBalancedCorrelation χ c‖≤q := by
  classical
  rw [completeBalancedCorrelation_eq_sum_rationalValue]
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ x : ZMod q, (1:ℝ) := sum_le_sum (fun x _ => norm_rationalValue_le_one χ _ _ x)
    _ = _ := by simp [ZMod.card]

theorem criticalCount_le_discriminant {p k : ℕ} [Fact p.Prime]
    (c : Fin 4 → ℤ)
    (hD : (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)≠0) :
    let D := (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)
    (criticalCount p k k c:ℝ) ≤ 2*(p:ℝ)^(min k (padicValInt p D/2+padicValInt p (2:ℤ))) := by
  dsimp only
  have hr := quadratic_critical_roots_card_le (p:=p) (k:=k)
    (criticalConstant_eq (c 0) (c 1) (c 2) (c 3)) (by rwa [critical_discriminant_eq])
  dsimp only at hr
  rw [critical_discriminant_eq] at hr
  exact_mod_cast hr

theorem criticalIntEval_shared {c : Fin 4 → ℤ} (h : c 2=c 1 ∨ c 3=c 1) (x : ℤ) :
    criticalIntEval c x = (c 0-(c 2+c 3-c 1))*(x-c 1)^2 := by
  rcases h with h|h
  · simp only [criticalIntEval,criticalLeading,criticalMiddle,criticalConstant,h]
    ring
  · simp only [criticalIntEval,criticalLeading,criticalMiddle,criticalConstant,h]
    ring

theorem criticalDvd_iff_of_shared {p q b : ℕ} (hdiv : p^b∣q) {c : Fin 4 → ℤ}
    (h : c 2=c 1 ∨ c 3=c 1) (n : ℕ) (hU : balancedUnitSupport q c n) :
    (p:ℤ)^b∣criticalIntEval c n ↔ (p:ℤ)^b∣c 0-(c 2+c 3-c 1) := by
  let E := ZMod.castHom hdiv (ZMod (p^b))
  have hF : IsUnit ((n:ZMod q)-(c 1:ZMod q)) := by
    have hF := hU.1
    simp only [balancedF,splitQuadratic,eval_mul,eval_sub,eval_X,eval_C] at hF
    exact (Commute.all _ _).isUnit_mul_iff.mp hF |>.2
  have hu : IsUnit (((n:ℤ)-c 1:ℤ):ZMod (p^b)) := by
    have hL := hF.map E
    simpa only [map_sub,map_natCast,map_intCast,Int.cast_sub,Int.cast_natCast] using hL
  rw [criticalIntEval_shared h,←Int.natCast_pow,
    ←ZMod.intCast_zmod_eq_zero_iff_dvd,←ZMod.intCast_zmod_eq_zero_iff_dvd,
    Int.cast_mul,Int.cast_pow]
  constructor
  · intro hD
    apply (hu.pow 2).mul_left_inj.mp
    simpa only [zero_mul] using hD
  · intro hD
    rw [hD,zero_mul]

theorem supportedCriticalCount_le_of_shared {p q a b : ℕ} (hdiv : p^b∣q) {c : Fin 4 → ℤ}
    (h : c 2=c 1 ∨ c 3=c 1) :
    supportedCriticalCount p q a b c ≤ if (p:ℤ)^b∣c 0-(c 2+c 3-c 1) then p^a else 0 := by
  classical
  split
  · simpa only [supportedCriticalCount,card_range] using
      (card_filter_le (s:=range (p^a)) (supportedCritical p q b c))
  · rename_i hd
    have hEmpty : ((range (p^a)).filter (supportedCritical p q b c))=∅ := by
      rw [eq_empty_iff_forall_notMem]
      intro n hn
      have hS := (mem_filter.mp hn).2
      exact hd ((criticalDvd_iff_of_shared hdiv h n hS.1).mp hS.2)
    simp [supportedCriticalCount,hEmpty]

theorem sqrt_primePower_even (p k : ℕ) :
    Real.sqrt ((p:ℝ)^(k+k)) = (p:ℝ)^k := by
  rw [pow_add,←pow_two,Real.sqrt_sq (by positivity)]

theorem sqrt_primePower_odd (p k : ℕ) :
    Real.sqrt ((p:ℝ)^(k+k+1)) = (p:ℝ)^k*Real.sqrt p := by
  rw [pow_succ,Real.sqrt_mul (by positivity),sqrt_primePower_even]

theorem primePower_le_gcd_of_int_dvd {p ν j : ℕ} (hp : p.Prime) {d : ℤ}
    (hj : j≤ν) (hD : (p:ℤ)^j∣d) :
    (p:ℝ)^j ≤ (Nat.gcd (p^ν) d.natAbs:ℝ) := by
  have hd : p^j∣d.natAbs := Int.natCast_dvd.mp (by simpa only [Nat.cast_pow] using hD)
  have h := Nat.le_of_dvd (Nat.gcd_pos_of_pos_left _ (pow_pos hp.pos _))
    (Nat.dvd_gcd (Nat.pow_dvd_pow p hj) hd)
  exact_mod_cast h

end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open GoldbachBurgess
open scoped Classical

theorem norm_balanced_even_prime_power_shared {p k : ℕ} [Fact p.Prime]
    (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) (h : c 2=c 1 ∨ c 3=c 1) :
    let _ : NeZero (p^(k+k)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let d := c 0-(c 2+c 3-c 1)
    ‖completeBalancedCorrelation χ c‖≤Real.sqrt ((p:ℝ)^(k+k))*(Nat.gcd (p^(k+k)) d.natAbs:ℝ) := by
  let hp : p.Prime := Fact.out
  let q := p^(k+k)
  let _ : NeZero q := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  let d := c 0-(c 2+c 3-c 1)
  have hdiv : p^k∣q := Nat.pow_dvd_pow p (by omega)
  have hB := norm_balanced_prime_power_le_supportedCriticalCount hp hk le_rfl χ hχ c
  have hC := supportedCriticalCount_le_of_shared (a:=k) hdiv h
  change supportedCriticalCount p q k k c≤ if (p:ℤ)^k∣d then p^k else 0 at hC
  rw [sqrt_primePower_even]
  refine hB.trans ?_
  rw [Nat.cast_pow]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  by_cases hd : (p:ℤ)^k∣d
  · rw [ite_eq_left hd] at hC
    exact (show (supportedCriticalCount p q k k c:ℝ)≤(p:ℝ)^k by exact_mod_cast hC).trans
      (primePower_le_gcd_of_int_dvd hp (by omega : k≤k+k) hd)
  · rw [ite_eq_right hd] at hC
    rw [Nat.le_zero.mp hC,Nat.cast_zero]
    positivity

theorem norm_balanced_odd_prime_power_shared {p k : ℕ} [Fact p.Prime]
    (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k+1))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) (h : c 2=c 1 ∨ c 3=c 1) :
    let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let d := c 0-(c 2+c 3-c 1)
    ‖completeBalancedCorrelation χ c‖≤2*Real.sqrt ((p:ℝ)^(k+k+1))*(Nat.gcd (p^(k+k+1)) d.natAbs:ℝ) := by
  let hp : p.Prime := Fact.out
  let q := p^(k+k+1)
  let _ : NeZero q := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  let d := c 0-(c 2+c 3-c 1)
  let G : ℝ := Nat.gcd q d.natAbs
  have hdiv : p^k∣q := Nat.pow_dvd_pow p (by omega)
  have hdiv' : p^(k+1)∣q := Nat.pow_dvd_pow p (by omega)
  have hC := supportedCriticalCount_le_of_shared (a:=k) hdiv h
  have hC' := supportedCriticalCount_le_of_shared (a:=k+1) hdiv' h
  have hWide := supportedCriticalCount_le_of_shared (a:=k+1) hdiv h
  change supportedCriticalCount p q k k c≤ if (p:ℤ)^k∣d then p^k else 0 at hC
  change supportedCriticalCount p q (k+1) (k+1) c≤ if (p:ℤ)^(k+1)∣d then p^(k+1) else 0 at hC'
  change supportedCriticalCount p q (k+1) k c≤ if (p:ℤ)^k∣d then p^(k+1) else 0 at hWide
  have hpR : (1:ℝ)≤p := by exact_mod_cast hp.one_lt.le
  by_cases hBig : (p:ℤ)^(k+1)∣d
  · have hG : (p:ℝ)^(k+1)≤G := primePower_le_gcd_of_int_dvd hp (by omega : k+1≤k+k+1) hBig
    have hS : Real.sqrt ((p:ℝ)^(k+k+1))≤(p:ℝ)^(k+1) := by
      rw [sqrt_primePower_odd,pow_succ]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      calc
        Real.sqrt (p:ℝ) ≤ Real.sqrt ((p:ℝ)^2) := by
          apply Real.sqrt_le_sqrt
          simpa only [pow_two,mul_one] using mul_le_mul_of_nonneg_left hpR (Nat.cast_nonneg (α:=ℝ) p)
        _ = _ := Real.sqrt_sq (by positivity)
    refine (norm_completeBalancedCorrelation_le_modulus χ c).trans ?_
    simp only [Nat.cast_pow]
    change (p:ℝ)^(k+k+1)≤2*Real.sqrt ((p:ℝ)^(k+k+1))*G
    have ht := mul_le_mul_of_nonneg_left (hS.trans hG) (Real.sqrt_nonneg ((p:ℝ)^(k+k+1)))
    rw [←pow_two,Real.sq_sqrt (by positivity)] at ht
    nlinarith only [ht,show 0≤Real.sqrt ((p:ℝ)^(k+k+1))*G by positivity]
  · have hz : supportedCriticalCount p q (k+1) (k+1) c=0 := by
      rw [ite_eq_right hBig] at hC'
      exact Nat.le_zero.mp hC'
    rw [sqrt_primePower_odd]
    change ‖completeBalancedCorrelation χ c‖≤2*((p:ℝ)^k*Real.sqrt p)*G
    by_cases hSmall : (p:ℤ)^k∣d
    · have hG : (p:ℝ)^k≤G := primePower_le_gcd_of_int_dvd hp (by omega : k≤k+k+1) hSmall
      by_cases hp2 : p=2
      · have hB := @norm_balanced_prime_power_le_supportedCriticalCount p (k+1) k hp hk (by omega)
        rw [show k+1+k=k+k+1 by omega] at hB
        specialize hB χ hχ c
        rw [ite_eq_left hSmall] at hWide
        refine hB.trans ?_
        rw [Nat.cast_pow]
        have hP : (p:ℝ)≤2*Real.sqrt p := by
          have hs := Real.sqrt_le_sqrt hpR
          simp only [Real.sqrt_one,hp2,Nat.cast_ofNat] at hs ⊢
          linarith only [hs]
        calc
          _ ≤ (p:ℝ)^k*(p:ℝ)^(k+1) :=
            mul_le_mul_of_nonneg_left (by exact_mod_cast hWide) (by positivity)
          _ = ((p:ℝ)^k*(p:ℝ)^k)*p := by rw [pow_succ]; ring
          _ ≤ ((p:ℝ)^k*(p:ℝ)^k)*(2*Real.sqrt p) :=
            mul_le_mul_of_nonneg_left hP (by positivity)
          _ = (2*((p:ℝ)^k*Real.sqrt p))*(p:ℝ)^k := by ring
          _ ≤ _ := mul_le_mul_of_nonneg_left hG (by positivity)
      · rw [ite_eq_left hSmall] at hC
        refine (norm_balanced_odd_prime_power_le_supportedCounts hp2 hk χ hχ c).trans ?_
        rw [hz,Nat.cast_zero,add_zero]
        have hOne : (supportedCriticalCount p q k k c:ℝ)≤G :=
          (show (supportedCriticalCount p q k k c:ℝ)≤(p:ℝ)^k by exact_mod_cast hC).trans hG
        calc
          _ ≤ (p:ℝ)^k*(Real.sqrt p*G) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hOne (Real.sqrt_nonneg _)) (by positivity)
          _ ≤ _ := by nlinarith only [show 0≤(p:ℝ)^k*(Real.sqrt p*G) by positivity]
    · rw [ite_eq_right hSmall] at hC hWide
      have hB := @norm_balanced_prime_power_le_supportedCriticalCount p (k+1) k hp hk (by omega)
      rw [show k+1+k=k+k+1 by omega] at hB
      specialize hB χ hχ c
      refine hB.trans ?_
      rw [Nat.le_zero.mp hWide,Nat.cast_zero,mul_zero]
      positivity

theorem norm_balanced_prime_power_shared {p ν : ℕ} [Fact p.Prime]
    (hν : 2≤ν) (χ : DirichletCharacter ℂ (p^ν)) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) (h : c 2=c 1 ∨ c 3=c 1) :
    let _ : NeZero (p^ν) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let d := c 0-(c 2+c 3-c 1)
    ‖completeBalancedCorrelation χ c‖≤2*Real.sqrt ((p:ℝ)^ν)*(Nat.gcd (p^ν) d.natAbs:ℝ) := by
  let _ : NeZero (p^ν) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  dsimp only
  rcases Nat.even_or_odd ν with ⟨k,hk⟩ | ⟨k,hk⟩
  · have hk' : 0<k := by omega
    have he : ν=k+k := by omega
    clear hk
    subst ν
    refine (norm_balanced_even_prime_power_shared hk' χ hχ c h).trans ?_
    nlinarith only [show 0≤Real.sqrt ((p:ℝ)^(k+k))*(Nat.gcd (p^(k+k)) (c 0-(c 2+c 3-c 1)).natAbs:ℝ) by positivity]
  · have hk' : 0<k := by omega
    have he : ν=k+k+1 := by omega
    clear hk
    subst ν
    exact norm_balanced_odd_prime_power_shared hk' χ hχ c h

end GoldbachBurgessPrimePower
end

