      _ = X^(-1/6 : ℝ)*(Real.log X)^(B+4) := by rw [pow_add]; ring
      _ ≤ X^(-1/6 : ℝ)*X^(1/6 : ℝ) := mul_le_mul_of_nonneg_left hsmall (by positivity)
      _ = 1 := by rw [← Real.rpow_add hXp]; norm_num
  apply hp.trans
  calc
    _ = (D^2*X*(Real.log X)^4)*((Q : ℝ)^2*X^(1/2 : ℝ))^2 := by ring
