namespace GoldbachZeroFree

open Complex Filter Goldbach GoldbachConductorZeros
open scoped Topology Classical

noncomputable section


/-- At order three the character's conductor divides the conductor of its square. -/
theorem order_three_conductor_le_square {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (h : χ^3=1) :
    χ.conductor≤(χ^2).conductor := by
  have he : (χ^2)^2=χ := by
    rw [←pow_mul,show (2:ℕ)*2=3+1 by decide,pow_succ,h,one_mul]
  have hv : ((χ^2)^2).conductor=χ.conductor := congrArg DirichletCharacter.conductor he
  have hd : χ.conductor ∣ (χ^2).conductor := hv ▸ (χ^2).conductor_pow_dvd 2
  exact Nat.le_of_dvd (Nat.pos_of_ne_zero (χ^2).conductor_ne_zero) hd

end

end GoldbachZeroFree
