    exact modulus_moderate_class_square_uniform hp (le_of_lt (lt_of_not_ge h3)) hSimple hG W.global4
      (fun T hT hC=>W.classMid.of_minimum (hT.trans hE) hC (all_rivals hT hG))
      (by norm_num) hN4
  have hG : ∀ r∈modulusRivals K false H R p,0.87< modulusGap q r.2 :=
    hTests 4 hB
  exact modulus_moderate_class_square_uniform hp (le_of_lt (lt_of_not_ge h4)) hSimple hG W.global5
    (fun T hT hC=>W.class5 (hT.trans hE) hC (all_rivals hT hG))
    (by norm_num) hN5

theorem modulus_class_square_tiny {q K : ℕ} [NeZero q] {H R δ : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R)
    (hSimple : modulusOrder p=1) (hδ : 0<δ) (hA : δ≤ modulusGap q p.2)
    (hB : modulusGap q p.2≤0.005)
    (hRiv : ∀ r∈modulusRivals K false H R p,
      (1/2:ℝ)*Real.log (0.6/modulusGap q p.2) < modulusGap q r.2)
    (hC : ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
      (∀ t∈T,(1/2:ℝ)*Real.log (0.6/modulusGap q p.2)≤ modulusGap q t.1.2) →
      (∑ t∈T,gapWeight (modulusGap q t.1.2))≤0.12)
    (hD : ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
      OneConductorClass K T →
      (∀ t∈T,(1/2:ℝ)*Real.log (0.6/modulusGap q p.2)≤ modulusGap q t.1.2) →
      (∑ t∈T,gapWeight (modulusGap q t.1.2))≤4*modulusGap q p.2) :
    modulusClassMassSquare q K H R≤1-0.9*δ := by
  rw [modulusClassMassSquare_of_repeatTags]
  let S : Finset (ModulusTag q) := repeatTags (modulusZeros q H R) modulusOrder
  let lead : ModulusTag q := ⟨p,0⟩
  let key (t : ModulusTag q) := conductorClass K t.1.1
  let gap (t : ModulusTag q) := modulusGap q t.1.2
  have hLead : lead∈S := repeatTags_mem_zero hp (modulusOrder_pos_of_mem hp)
  have hE : S.erase lead⊆S := erase_subset _ _
  have hMin : ∀ t∈S.erase lead,(1/2:ℝ)*Real.log (0.6/gap lead)≤gap t := fun t ht =>
    (hRiv t.1 (erased_tag_mem_modulusRivals hSimple ht (by simp))).le
  refine tiny_real_class_square_of_rival_bounds S key gap hLead hδ hA hB
    (hC _ hE hMin) ?_
  intro c _
  exact hD _ ((filter_subset _ _).trans hE) (class_filter_is_one_class c)
    (fun t ht=>hMin t (mem_filter.mp ht).1)

end
