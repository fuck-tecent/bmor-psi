      ←Real.rpow_mul_natCast (by norm_num : 0≤ (3/5:ℝ))]
    norm_num [show (3/20:ℝ)*(20:ℕ)=(3:ℕ) by norm_num,
      show (17/20:ℝ)*(20:ℕ)=(17:ℕ) by norm_num,Real.rpow_natCast]
  exact lt_of_pow_lt_pow_left₀ 20 (by norm_num) h

/-- A rational bound for the first-moment factor in the tiny-leading-zero
branch of the real-zero test. -/
theorem tiny_gap_exponential_factor_le {a μ : ℝ} (ha : 0<a) (ha' : a≤ 3/250)
    (hμ : μ≤ (1/2:ℝ)*Real.log ((3/5)/a)) :
    a*Real.exp ((17/10:ℝ)*μ)≤1669/5000 := by
  have hBase : 0<(3/5:ℝ)/a := div_pos (by norm_num) ha
  have hE : Real.exp ((17/10:ℝ)*μ)≤((3/5:ℝ)/a)^(17/20:ℝ) := by
    rw [Real.rpow_def_of_pos hBase]
    exact Real.exp_le_exp.mpr (by linarith only [hμ])
  have hEq : a*((3/5:ℝ)/a)^(17/20:ℝ)=a^(3/20:ℝ)*((3/5:ℝ)^(17/20:ℝ)) := by
    rw [Real.div_rpow (by norm_num : 0≤ (3/5:ℝ)) ha.le]
    have hA : a/a^(17/20:ℝ)=a^(3/20:ℝ) := by
      have h := Real.rpow_sub ha (1:ℝ) (17/20:ℝ)
      rw [Real.rpow_one,show (1:ℝ)-17/20=3/20 by ring] at h
      exact h.symm
    rw [←hA]
    ring
  calc
    _ ≤ a*((3/5:ℝ)/a)^(17/20:ℝ) := mul_le_mul_of_nonneg_left hE ha.le
    _ = _ := hEq
    _ ≤ (3/250:ℝ)^(3/20:ℝ)*(3/5:ℝ)^(17/20:ℝ) :=
      mul_le_mul_of_nonneg_right (Real.rpow_le_rpow ha.le ha' (by norm_num)) (by positivity)
    _ ≤ _ := tiny_gap_numeric_power.le

