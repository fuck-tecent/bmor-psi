/-- The rational Gram estimate for actual finite zero sets at a common level.
A separate strip exponent for distinct-character quotients gives either the
global H/J cost or the class I cost. -/
theorem rational_zero_gram_eventually_of_strip {b anchor high p φrow φpair Drow Dpair δ : ℝ}
    (hb : 0<b) (hAnchor : 0≤anchor) (hba : anchor<b) (hp : 0≤p) (hδ : 0<δ)
    (hφrow : 0≤φrow) (hφpair : 0≤φpair) (hDrow : 0≤Drow) (hDpair : 0≤Dpair)
    (hGap : φrow/(2*realRationalZeroKernel b (-anchor))+δ≤rationalPsi b anchor high) :
    ∃ r : ℝ, 0<r ∧ r≤1/32 ∧
      ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
      ∀ R : ℝ, 0≤R → R≤L^p →
      ∀ S : Finset (DirichletCharacter ℂ q × ℂ),
      (∀ i∈S, i.1≠1) →
      (∀ i∈S, regularizedL i.1 i.2=0) →
      (∀ i∈S, anchor≤zeroLossAt L i.2 ∧ zeroLossAt L i.2≤high) →
      (∀ i∈S, |i.2.im|≤R) →
      (∀ χ : DirichletCharacter ℂ q, χ≠1 → ∀ ρ : ℂ, regularizedL χ ρ=0 →
        |ρ.im| ≤ 2*R+1 → ρ.re ≤ 1-anchor/L) →
      (∀ i∈S, ∀ z : ℂ, 3/4 ≤ z.re → z.re ≤ 3/2 → |z.im| ≤ L^(p+1)+1 →
        ‖i.1.LFunction z‖≤L^Drow*(q:ℝ)^(φrow*max 0 (1-z.re))) →
      (∀ i∈S, ∀ j∈S, i.1≠j.1 →
        ∀ z : ℂ, 3/4 ≤ z.re → z.re ≤ 3/2 → |z.im| ≤ L^(p+1)+1 →
        ‖(j.1*i.1⁻¹).LFunction z‖≤L^Dpair*(q:ℝ)^(φpair*max 0 (1-z.re))) →
      let F := realRationalZeroKernel b (-anchor)
      let ξrow := φrow/(2*F)+δ
      let ξpair := φpair/(2*F)
      let m := zeroGramMultiplicity (q:=q)
      let a := rationalSameZeroWeight (q:=q) b anchor L r
      let ψ (i : DirichletCharacter ℂ q × ℂ) := rationalPsi b anchor (zeroLossAt L i.2)
      let H := weightedCount S m a
      let N := ordinaryCount S m
      let D := excess S m ψ (rationalPsi b anchor high)
      N≤H ∧ 0≤D ∧
        (H*(rationalPsi b anchor high-ξrow)+D)^2≤
          H+ξpair*(H^2-H)+δ*(2+ξpair+δ)*H^2 := by
  let F := realRationalZeroKernel b (-anchor)
  let ξrow := φrow/(2*F)+δ
  let ξpair := φpair/(2*F)
  have hF : 0<F := realRationalZeroKernel_pos hb (by linarith only [hba])
  have η : 0<δ*F := mul_pos hδ hF
  have hξrow : 0≤ξrow := by unfold ξrow; positivity
  have hξpair : 0≤ξpair := by unfold ξpair; positivity
  obtain ⟨r,hr,hr32,hRows⟩ := rational_nonprincipal_test_eventually_at_gram_anchor η hb hba hp hφrow hDrow
  obtain ⟨r',hr',hr32',hPairs⟩ := rational_nonprincipal_test_eventually_at_gram_anchor η hb hba hp hφpair hDpair
  let V := max 1 (max high ((1+b+2*b^2/3)/((δ/2)*F)))
  refine ⟨r,hr,hr32,?_⟩
  filter_upwards [hRows,hPairs,
    rational_principal_test_eventually_at_gram_anchor (p:=p) (show 0<δ/2 by positivity) hb hba hAnchor hp,
    eventually_ge_atTop (max 1 (V/r))] with L hR hG hP hL q _ hq R hRnonneg hRle S hNon hZero hRange hTime hNoRight hStripR hStripG
  have hL₁ : 1≤L := (le_max_left _ _).trans hL
  have hL₀ := zero_lt_one.trans_le hL₁
  have hQ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hV : V≤L*r := (div_le_iff₀ hr).mp ((le_max_right _ _).trans hL)
  have hR₁ : 1≤L*r := (le_max_left _ _).trans hV
  have hHigh : high≤L*r := (le_max_left _ _).trans ((le_max_right _ _).trans hV)
  have hFar : 1+b+2*b^2/3≤(δ/2)*F*(L*r) := by
    have h := (le_max_right _ _).trans ((le_max_right _ _).trans hV)
    exact (div_le_iff₀ (mul_pos (by positivity : 0<δ/2) hF)).mp h |>.trans_eq (mul_comm _ _)
  have hCostRow : φrow*Real.log (q:ℝ)/2+δ*F*L≤L*F*ξrow := by
    have h := mul_le_mul_of_nonneg_left hq (by positivity : 0≤φrow/2)
    have he : L*F*ξrow=L*(φrow/2)+δ*F*L := by unfold ξrow; field_simp [hF.ne']
    rw [he]
    linarith only [h]
  have hCostPair : φpair*Real.log (q:ℝ)/2+δ*F*L≤L*F*(ξpair+δ) := by
    have h := mul_le_mul_of_nonneg_left hq (by positivity : 0≤φpair/2)
    have he : L*F*(ξpair+δ)=L*(φpair/2)+δ*F*L := by unfold ξpair; field_simp [hF.ne']
    rw [he]
    linarith only [h]
  have hDiffR (i : DirichletCharacter ℂ q × ℂ) (hi : i∈S)
      (j : DirichletCharacter ℂ q × ℂ) (hj : j∈S) : |j.2.im-i.2.im|≤2*R := by
    have h := abs_add_le j.2.im (-i.2.im)
    rw [←sub_eq_add_neg,abs_neg] at h
    linarith only [h,hTime i hi,hTime j hj]
  have hTwoR : 2*R≤2*L^p := mul_le_mul_of_nonneg_left hRle (by norm_num)
  have hDiff (i : DirichletCharacter ℂ q × ℂ) (hi : i∈S)
      (j : DirichletCharacter ℂ q × ℂ) (hj : j∈S) : |j.2.im-i.2.im|≤2*L^p :=
    (hDiffR i hi j hj).trans hTwoR
  have hLocalRight (χ : DirichletCharacter ℂ q) (hχ : χ≠1) (t : ℝ) (ht : |t|≤2*R)
      (ρ : ℂ) (hρ : regularizedL χ ρ=0) (hSep : |ρ.im-t|≤1) : ρ.re≤1-anchor/L := by
    apply hNoRight χ hχ ρ hρ
    have h := abs_add_le (ρ.im-t) t
    rw [sub_add_cancel] at h
    linarith only [h,hSep,ht]
  apply rational_zero_gram_of_tests S hb hAnchor hba hL₀ hr.le hR₁ hδ.le hξrow hξpair hHigh hGap hFar hZero hRange
  · intro j hj
    have ht : |j.2.im|≤2*R := by linarith only [hTime j hj,hRnonneg]
    obtain ⟨W,hW,hTest⟩ :=
      hR q hq j.1 (hNon j hj) (ht.trans hTwoR)
        hQ (hStripR j hj) (hLocalRight j.1 (hNon j hj) j.2.im ht)
    exact ⟨W,hW,fun U hU=>(hTest U hU).trans (sub_le_sub_right hCostRow _)⟩
  · have h := hP 1 (by simpa only [Nat.cast_one,Real.log_one] using hL₀.le) 0
        (by rw [abs_zero]; positivity)
    rw [mul_zero,principalRationalPair_zero hb hba] at h
    unfold rationalGramTest
    rw [←line_real_add_imag]
    exact h.trans (mul_le_mul_of_nonneg_left (by linarith only [hδ]) (mul_nonneg hL₀.le hF.le))
  · intro i hi j hj _
    unfold rationalGramTest
    rw [←line_real_add_imag]
    exact hP q hq _ (hDiff i hi j hj)
  · intro i hi j hj hne
    let χ := j.1*i.1⁻¹
    have hχ : χ≠1 := fun h=>hne (mul_inv_eq_one.mp h).symm
    obtain ⟨W,_,hTest⟩ := hG q hq χ hχ (hDiff i hi j hj)
      hQ (hStripG i hi j hj hne) (hLocalRight χ hχ (j.2.im-i.2.im) (hDiffR i hi j hj))
    have h := hTest ∅ (empty_subset _)
    unfold rationalGramTest
    rw [←line_real_add_imag]
    have h' : (rationalPrimeTest χ b L (line (1-anchor/L) (j.2.im-i.2.im))).re ≤
      φpair*Real.log (q:ℝ)/2+δ*F*L := by
      simpa only [sum_empty,mul_zero,sub_zero] using h
    exact h'.trans hCostPair

end
end GoldbachPintzWeightedGram
end

section
namespace GoldbachPintzWeightedGram

open Complex Filter Finset Goldbach GoldbachPintzNumerics
open scoped Topology Classical

noncomputable section

def unscaledZeroExcess {q : ℕ} [NeZero q]
    (S : Finset (DirichletCharacter ℂ q × ℂ)) (b anchor high L : ℝ) : ℝ :=
  ∑ i∈S,(zeroGramMultiplicity i:ℝ)*
    (realRationalZeroKernel b (zeroLossAt L i.2-anchor)-realRationalZeroKernel b (high-anchor))

theorem realKernel_mul_excess_eq_unscaled {q : ℕ} [NeZero q]
    (S : Finset (DirichletCharacter ℂ q × ℂ)) {b anchor high L : ℝ}
    (hb : 0<b) (hba : anchor<b) :
    realRationalZeroKernel b (-anchor)*
      excess S zeroGramMultiplicity (fun i=>rationalPsi b anchor (zeroLossAt L i.2))
        (rationalPsi b anchor high)=unscaledZeroExcess S b anchor high L := by
  let F := realRationalZeroKernel b (-anchor)
  have hF : F≠0 := (realRationalZeroKernel_pos hb (by linarith only [hba])).ne'
  unfold excess unscaledZeroExcess
  rw [mul_sum]
  apply sum_congr rfl
  intro i _
  unfold rationalPsi
  let A := realRationalZeroKernel b (zeroLossAt L i.2-anchor)
  let B := realRationalZeroKernel b (high-anchor)
  change F*((zeroGramMultiplicity i:ℝ)*(A/F-B/F))=(zeroGramMultiplicity i:ℝ)*(A-B)
  field_simp [hF]

/-- Eventual multiplicity and unscaled J bounds with any strict margin above
the ideal rational Gram numbers. The selected positive δ is the increment of
the pair strip exponent and can be used directly for bounded-conductor classes. -/
theorem rational_zero_count_excess_eventually_of_strip
    {b anchor high p φrow pairBase Drow Dpair count J : ℝ}
    (hb : 0<b) (hAnchor : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hp : 0≤p) (hφrow : 0≤φrow) (hφpair : 0≤pairBase) (hDrow : 0≤Drow) (hDpair : 0≤Dpair) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φrow/(2*F)
    let ξ := pairBase/(2*F)
    0<Δ → ξ<Δ^2 → (1-ξ)/(Δ^2-ξ)<count → F*(1-ξ)/(2*Δ)<J →
    ∃ δ : ℝ, 0<δ ∧
      ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
      ∀ R : ℝ, 0≤R → R≤L^p →
      ∀ S : Finset (DirichletCharacter ℂ q × ℂ),
      (∀ i∈S, i.1≠1) →
      (∀ i∈S, regularizedL i.1 i.2=0) →
      (∀ i∈S, anchor≤zeroLossAt L i.2 ∧ zeroLossAt L i.2≤high) →
      (∀ i∈S, |i.2.im|≤R) →
      (∀ χ : DirichletCharacter ℂ q, χ≠1 → ∀ ρ : ℂ, regularizedL χ ρ=0 →
        |ρ.im| ≤ 2*R+1 → ρ.re ≤ 1-anchor/L) →
      (∀ i∈S, ∀ z : ℂ, 3/4 ≤ z.re → z.re ≤ 3/2 → |z.im| ≤ L^(p+1)+1 →
        ‖i.1.LFunction z‖≤L^Drow*(q:ℝ)^(φrow*max 0 (1-z.re))) →
      (∀ i∈S, ∀ j∈S, i.1≠j.1 →
        ∀ z : ℂ, 3/4 ≤ z.re → z.re ≤ 3/2 → |z.im| ≤ L^(p+1)+1 →
        ‖(j.1*i.1⁻¹).LFunction z‖≤L^Dpair*(q:ℝ)^((pairBase+δ)*max 0 (1-z.re))) →
      ordinaryCount S zeroGramMultiplicity<count ∧ unscaledZeroExcess S b anchor high L<J := by
  dsimp only
  intro hΔ hGap hCount hJ
  let F := realRationalZeroKernel b (-anchor)
  let Δ := rationalPsi b anchor high-φrow/(2*F)
  let ξ := pairBase/(2*F)
  have hF : 0<F := realRationalZeroKernel_pos hb (by linarith only [hba])
  have hΔ₀ : 0<Δ := hΔ
  have hξ₀ : 0≤ξ := by unfold ξ; positivity
  have hΨ : rationalPsi b anchor high≤1 := by
    unfold rationalPsi
    apply (div_le_iff₀ hF).mpr
    rw [one_mul]
    exact realRationalZeroKernel_antitone hb.le (by linarith only [hba])
      (by linarith only [hHigh,hAnchor])
  have hΔ₁ : Δ≤1 := by
    unfold Δ
    exact (sub_le_self _ (by positivity)).trans hΨ
  obtain ⟨δ,hδ,hSlack⟩ := exists_gram_slack hF hΔ₀ hΔ₁ hξ₀ hGap hCount hJ
  change let ξ' := ξ+δ/(2*F)
    let e := δ*(2+ξ'+δ)
    let d := Δ-δ
    0<d ∧ ξ'≤1 ∧ ξ'+e<d^2 ∧
      (1-ξ')/(d^2-ξ'-e)<count ∧ F*(1-ξ')/(2*d)<J at hSlack
  dsimp only at hSlack
  obtain ⟨hΔδ,hξδ,hError,hCountδ,hJδ⟩ := hSlack
  have hGapδ : φrow/(2*realRationalZeroKernel b (-anchor))+δ≤rationalPsi b anchor high := by
    unfold Δ F at hΔδ
    linarith only [hΔδ]
  obtain ⟨r,_,_,hGram⟩ := rational_zero_gram_eventually_of_strip (p:=p) hb hAnchor hba hp hδ
    hφrow (add_nonneg hφpair hδ.le) hDrow hDpair hGapδ
  refine ⟨δ,hδ,?_⟩
  filter_upwards [hGram] with L hG q _ hq R hR₀ hR₁ S hNon hZero hRange hTime hNoRight hStripR hStripG
  let m := zeroGramMultiplicity (q:=q)
  let a := rationalSameZeroWeight (q:=q) b anchor L r
  let ψ (i : DirichletCharacter ℂ q × ℂ) := rationalPsi b anchor (zeroLossAt L i.2)
  let H := weightedCount S m a
  let N := ordinaryCount S m
  let D := excess S m ψ (rationalPsi b anchor high)
  let ξ' := ξ+δ/(2*F)
  have hξEq : (pairBase+δ)/(2*F)=ξ' := add_div _ _ _
  have hΔEq : rationalPsi b anchor high-(φrow/(2*F)+δ)=Δ-δ := by unfold Δ; ring
  obtain ⟨hNH,hD,hActual⟩ :=
    hG q hq R hR₀ hR₁ S hNon hZero hRange hTime hNoRight hStripR hStripG
  have hN : 0≤N := sum_nonneg (fun _ _=>Nat.cast_nonneg _)
  change (H*(rationalPsi b anchor high-(φrow/(2*F)+δ))+D)^2≤
    H+((pairBase+δ)/(2*F))*(H^2-H)+δ*(2+((pairBase+δ)/(2*F))+δ)*H^2 at hActual
  rw [hΔEq,hξEq] at hActual
  obtain ⟨hC,hJBound⟩ := gram_count_and_unscaled_excess hF hN hNH hD hΔδ hξδ hError hActual
  refine ⟨hC.trans_lt hCountδ,?_⟩
  rw [←realKernel_mul_excess_eq_unscaled S hb hba]
  exact hJBound.trans_lt hJδ

end
end GoldbachPintzWeightedGram
end

section
namespace GoldbachHybridGrowth

open Complex Filter Finset DirichletCharacter
open scoped Topology Classical

noncomputable section

set_option maxHeartbeats 850000 in
/-- A nonprincipal character of bounded primitive conductor has arbitrarily
small strip exponent even after induction to an unbounded common level. -/
theorem bounded_conductor_strip_polynomial_log {e p : ℝ} (he : 0<e) (hp : 0≤p)
    (Q₀ : ℕ) (hQ₀ : 1≤Q₀) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
      ∀ (χ : DirichletCharacter ℂ q), χ≠1 → χ.conductor≤Q₀ →
      ∀ s : ℂ, 3/4≤ s.re → s.re≤3/2 → |s.im|≤L^p+1 →
      ‖χ.LFunction s‖≤L^(2*p+2:ℝ)*(q:ℝ)^(e*max 0 (1-s.re)) := by
  obtain ⟨C,hC,hE⟩ := uniform_euler_deletion_bound he
  let G : ℝ := 768*(1+Real.log (Q₀:ℝ))^2*(Q₀:ℝ)^(1/8:ℝ)
  let A := 9*G*C
  filter_upwards [eventually_ge_atTop (max 1 A)] with L hL q _ hq χ hχ hQ s hs hs' ht
  have hL1 : 1≤L := (le_max_left _ _).trans hL
  have hL0 : 0<L := zero_lt_one.trans_le hL1
  have hAL : A≤L := (le_max_right _ _).trans hL
  have hLp : 1≤L^p := Real.one_le_rpow hL1 hp
  have hQ₀R : (1:ℝ)≤Q₀ := by exact_mod_cast hQ₀
  let T : ℝ := L^p+1
  let S : ℝ := 16*(1+T)
  let δ := max 0 (1-s.re)
  have hT : 0≤T := by dsimp [T]; positivity
  have hS : 1≤S := by dsimp [S]; linarith only [hT]
  have hT' : 1+T≤3*L^p := by dsimp [T]; linarith only [hLp]
  have hδ : 0≤δ := le_max_left _ _
  have hδ' : δ≤1/4 := max_le (by norm_num) (by linarith only [hs])
  let ψ := χ.primitiveCharacter
  have : NeZero χ.conductor := ⟨χ.conductor_ne_zero⟩
  have hψ : ψ≠1 := by
    intro h
    apply hχ
    rw [←χ.changeLevel_primitiveCharacter]
    change DirichletCharacter.changeLevel χ.conductor_dvd_level ψ=1
    rw [h,map_one]
  have hΨ1 : (1:ℝ)≤χ.conductor := by exact_mod_cast NeZero.pos χ.conductor
  have hΨQ : (χ.conductor:ℝ)≤Q₀ := by exact_mod_cast hQ
  have hPV := nonprincipal_LFunction_uniform_strip ψ hψ (T:=T) hT
    (s:=s) (by linarith only [hs]) hs' ht
  change ‖ψ.LFunction s‖≤S*(2+Real.log S)*(1+Real.log (χ.conductor:ℝ))^2*
    (χ.conductor:ℝ)^(δ/2) at hPV
  have hLPS : S*(2+Real.log S)≤768*(1+T)^2 := by
    have hLog := Real.log_le_sub_one_of_pos (zero_lt_one.trans_le hS)
    have hh : 2+Real.log S≤3*S := by linarith only [hS,hLog]
    calc
      _ ≤ S*(3*S) := mul_le_mul_of_nonneg_left hh (zero_le_one.trans hS)
      _ = _ := by unfold S; ring
  have hLogCond := Real.log_le_log (zero_lt_one.trans_le hΨ1) hΨQ
  have hLogCond' : (1+Real.log (χ.conductor:ℝ))^2≤(1+Real.log (Q₀:ℝ))^2 :=
    pow_le_pow_left₀ (by positivity) (by linarith only [hLogCond]) 2
  have hPowCond : (χ.conductor:ℝ)^(δ/2)≤(Q₀:ℝ)^(1/8:ℝ) :=
    (Real.rpow_le_rpow (by positivity) hΨQ (by positivity)).trans
      (Real.rpow_le_rpow_of_exponent_le hQ₀R (by linarith only [hδ']))
  have hP : ‖ψ.LFunction s‖≤G*(1+T)^2 := calc
    _ ≤ _ := hPV
    _ ≤ (768*(1+T)^2)*(1+Real.log (Q₀:ℝ))^2*(Q₀:ℝ)^(1/8:ℝ) :=
      mul_le_mul (mul_le_mul hLPS hLogCond' (by positivity) (by positivity))
        hPowCond (by positivity) (by positivity)
    _ = _ := by unfold G; ring
  have hEq : χ.LFunction s=ψ.LFunction s*
      ∏ f∈q.primeFactors, (1-ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s)) := by
    exact (congrArg (fun η : DirichletCharacter ℂ q=>η.LFunction s)
      χ.changeLevel_primitiveCharacter.symm).trans
        (LFunction_changeLevel χ.conductor_dvd_level ψ (Or.inl hψ))
  have hProd : ‖∏ f∈q.primeFactors, (1-ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s))‖≤
      C*L*(q:ℝ)^(e*δ) := by
    refine (Finset.norm_prod_le _ _).trans ((Finset.prod_le_prod₀ (fun f _=>by positivity) ?_).trans
      (hE q (NeZero.ne q) hL1 hq hδ hδ'))
    intro f hf
    have hfP := Nat.prime_of_mem_primeFactors hf
    have hf1 : (1:ℝ)≤f := by exact_mod_cast hfP.one_lt.le
    calc
      _ ≤ 1+‖ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s)‖ := by
        have hh := norm_sub_le (1:ℂ) (ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s))
        simpa only [norm_one] using hh
      _ ≤ 1+(f:ℝ)^(-s.re) := by
        rw [norm_mul,Complex.norm_natCast_cpow_of_pos hfP.pos,Complex.neg_re]
        exact add_le_add_right (mul_le_of_le_one_left (by positivity) (ψ.norm_le_one _)) 1
      _ ≤ 1+(f:ℝ)^(-1+δ:ℝ) := by
        have hd : -s.re≤ -1+δ := by
          unfold δ
          linarith only [le_max_right 0 (1-s.re)]
        exact add_le_add_right (Real.rpow_le_rpow_of_exponent_le hf1 hd) 1
  have hGL : G*(1+T)^2≤(9*G)*L^(2*p:ℝ) := calc
    _ ≤ G*(3*L^p)^2 := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (by positivity) hT' 2) (by positivity)
    _ = _ := by rw [mul_pow,←Real.rpow_mul_natCast hL0.le]; norm_num only [Nat.cast_ofNat]
                rw [show p*2=2*p by ring]; ring
  rw [hEq,norm_mul]
  calc
    _ ≤ ((9*G)*L^(2*p:ℝ))*(C*L*(q:ℝ)^(e*δ)) :=
      mul_le_mul (hP.trans hGL) hProd (by positivity) (by positivity)
    _ = (A*L^(2*p:ℝ)*L)*(q:ℝ)^(e*δ) := by unfold A; ring
    _ ≤ (L*L^(2*p:ℝ)*L)*(q:ℝ)^(e*δ) := by gcongr
    _ = _ := by
      have hh : L*L^(2*p:ℝ)*L=L^(2*p+2:ℝ) := calc
        _ = L^(2*p:ℝ)*L^((2:ℕ):ℝ) := by rw [Real.rpow_natCast]; ring
        _ = _ := by rw [←Real.rpow_add hL0]; norm_num
      rw [hh]

end

end GoldbachHybridGrowth
end

section
namespace GoldbachPintzWeightedGram

open Complex Filter Finset Goldbach GoldbachHybridGrowth GoldbachPintzNumerics
open scoped Topology Classical

noncomputable section

/-- Global H/J bounds for actual nonprincipal zero sets at a common modulus. -/
theorem rational_global_zero_count_excess_eventually {b anchor high p φ count J : ℝ}
    (hb : 0<b) (hAnchor : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hp : 0≤p) (hφ : 3/8 < φ) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φ/(2*F)
    let ξ := φ/(2*F)
    0<Δ → ξ<Δ^2 → (1-ξ)/(Δ^2-ξ)<count → F*(1-ξ)/(2*Δ)<J →
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
      ∀ R : ℝ, 0≤R → R≤L^p →
      ∀ S : Finset (DirichletCharacter ℂ q × ℂ),
      (∀ i∈S, i.1≠1) →
      (∀ i∈S, regularizedL i.1 i.2=0) →
      (∀ i∈S, anchor≤zeroLossAt L i.2 ∧ zeroLossAt L i.2≤high) →
      (∀ i∈S, |i.2.im|≤R) →
      (∀ χ : DirichletCharacter ℂ q, χ≠1 → ∀ ρ : ℂ, regularizedL χ ρ=0 →
        |ρ.im| ≤ 2*R+1 → ρ.re ≤ 1-anchor/L) →
      ordinaryCount S zeroGramMultiplicity<count ∧ unscaledZeroExcess S b anchor high L<J := by
  dsimp only
  intro hΔ hGap hCount hJ
  let D := 3*(p+1)+2
  have hD : 0≤D := by unfold D; positivity
  have hφ₀ : 0≤φ := by linarith only [hφ]
  obtain ⟨δ,hδ,hMain⟩ :=
    rational_zero_count_excess_eventually_of_strip (p:=p) (φrow:=φ) (pairBase:=φ)
      (Drow:=D) (Dpair:=D) hb hAnchor hba hHigh hp hφ₀ hφ₀ hD hD hΔ hGap hCount hJ
  filter_upwards [hMain,burgess_strip_polynomial_in_log (p:=p+1) (by positivity) hφ]
    with L hM hB q _ hq R hR₀ hR₁ S hNon hZero hRange hTime hNoRight
  refine hM q hq R hR₀ hR₁ S hNon hZero hRange hTime hNoRight
    (fun i hi z hlo hhi ht=>hB q hq i.1 (hNon i hi) z hlo hhi ht) ?_
  intro i hi j hj hne z hlo hhi ht
  let χ := j.1*i.1⁻¹
  have hn : χ≠1 := fun h=>hne (mul_inv_eq_one.mp h).symm
  have hL : 0≤L := (Real.log_natCast_nonneg q).trans hq
  have hq₁ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  refine (hB q hq χ hn z hlo hhi ht).trans ?_
  apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hL _)
  exact Real.rpow_le_rpow_of_exponent_le hq₁
    (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hδ.le) (le_max_left _ _))

/-- Class I/J bounds when all different-character quotients in the selected
class have primitive conductor bounded by Q₀. -/
theorem rational_class_zero_count_excess_eventually {b anchor high p φ count J : ℝ}
    (Q₀ : ℕ) (hQ₀ : 1≤Q₀)
    (hb : 0<b) (hAnchor : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hp : 0≤p) (hφ : 3/8 < φ) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φ/(2*F)
    0<Δ → 1/Δ^2<count → F/(2*Δ)<J →
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
      ∀ R : ℝ, 0≤R → R≤L^p →
      ∀ S : Finset (DirichletCharacter ℂ q × ℂ),
      (∀ i∈S, i.1≠1) →
      (∀ i∈S, regularizedL i.1 i.2=0) →
      (∀ i∈S, anchor≤zeroLossAt L i.2 ∧ zeroLossAt L i.2≤high) →
      (∀ i∈S, |i.2.im|≤R) →
      (∀ χ : DirichletCharacter ℂ q, χ≠1 → ∀ ρ : ℂ, regularizedL χ ρ=0 →
        |ρ.im| ≤ 2*R+1 → ρ.re ≤ 1-anchor/L) →
      (∀ i∈S, ∀ j∈S, i.1≠j.1 → (j.1*i.1⁻¹).conductor≤Q₀) →
      ordinaryCount S zeroGramMultiplicity<count ∧ unscaledZeroExcess S b anchor high L<J := by
  dsimp only
  intro hΔ hCount hJ
  let DR := 3*(p+1)+2
  let DG := 2*(p+1)+2
  have hDR : 0≤DR := by unfold DR; positivity
  have hDG : 0≤DG := by unfold DG; positivity
  have hφ₀ : 0≤φ := by linarith only [hφ]
  obtain ⟨δ,hδ,hMain⟩ :=
    rational_zero_count_excess_eventually_of_strip (p:=p) (φrow:=φ) (pairBase:=0)
      (Drow:=DR) (Dpair:=DG) hb hAnchor hba hHigh hp hφ₀ (by norm_num) hDR hDG hΔ
      (by simpa only [zero_div] using sq_pos_of_pos hΔ)
      (by simpa only [zero_div,sub_zero] using hCount)
      (by simpa only [zero_div,sub_zero,mul_one] using hJ)
  filter_upwards [hMain,burgess_strip_polynomial_in_log (p:=p+1) (by positivity) hφ,
    bounded_conductor_strip_polynomial_log (p:=p+1) hδ (by positivity) Q₀ hQ₀]
    with L hM hB hSmall q _ hq R hR₀ hR₁ S hNon hZero hRange hTime hNoRight hRatio
  refine hM q hq R hR₀ hR₁ S hNon hZero hRange hTime hNoRight
    (fun i hi z hlo hhi ht=>hB q hq i.1 (hNon i hi) z hlo hhi ht) ?_
  intro i hi j hj hne z hlo hhi ht
  let χ := j.1*i.1⁻¹
  have hn : χ≠1 := fun h=>hne (mul_inv_eq_one.mp h).symm
  simpa only [zero_add] using hSmall q hq χ hn (hRatio i hi j hj hne) z hlo hhi ht

end
end GoldbachPintzWeightedGram
end

