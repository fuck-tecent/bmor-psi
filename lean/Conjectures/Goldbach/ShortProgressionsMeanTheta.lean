open Finset Filter ShortAPDyadicPartition ShortAPBoxedHB ShortAPSmoothedFactor
open scoped BigOperators

namespace ShortAPAllSmoothBlocks

/-- The second cap of (4.8) on any active box containing a long smooth factor,
uniformly over the full paper frequency range. -/
theorem active_smooth_cap {ε : ℝ} (hε : 0 < ε) (P Uexp : ℕ) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H j q : ℕ} (χ : DirichletCharacter ℂ q),
    1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice j),
    j < 4 → H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → z ≤ 4*x → b ∈ activeChoices X H j a z →
    (q : ℝ) ≤ 2 * (Real.log x)^Uexp → |t| ≤ x →
    (∃ k : {i // i ∈ blockIndices j}, k.val < j+1 ∧ x^ε ≤ scale (b k.val k.property)) →
    ∀ U : {i // i ∈ blockIndices j} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H j k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices j).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [ShortAPSmallConductorProduct.active_box_cap P,
    ShortAPSmallConductorHighFrequency.box_active_cap_eventually ε hε Uexp (P+17),
    eventually_ge_atTop (1:ℝ)] with x hc hs hx
  intro X H j q χ hq hp t a z b hj hH hHX hX hz hb hqsmall ht ⟨k, hki, hkN⟩ U hu
  let _ : NeZero q := ⟨by omega⟩
  have hNup : scale (b k.val k.property) ≤ 4*x :=
    (choice_scale_bounds hH hHX (Finset.mem_filter.mp hb).1 k.property).2.1.trans hX
  apply hc χ t a z b hj hH hHX hX hz hb U hu
  exact ⟨k, (mul_le_mul_of_nonneg_right (hu k).2 (pow_nonneg (Real.log_nonneg hx) _)).trans
    (hs χ hq hp hqsmall t H j k.val (b k.val k.property) hki hkN hNup ht)⟩

/-- In the first three blocks the long smooth factor is forced, yielding the
same product cap for the full paper frequency range. -/
theorem first_three_cap (P Uexp : ℕ) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H j q : ℕ}
    (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice j),
    j < 3 → H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → (H : ℝ) ≤ (4*x)^((1:ℝ)/4) →
    x ≤ a → z ≤ 4*x → b ∈ activeChoices X H j a z →
    (q : ℝ) ≤ 2 * (Real.log x)^Uexp → |t| ≤ x →
    ∀ U : {i // i ∈ blockIndices j} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H j k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices j).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [ShortAPSmallConductorProduct.first_three_long_smooth,
    active_smooth_cap (ε := 1/32) (by norm_num) P Uexp] with x hlong hcap
  intro X H j q χ hq hp t a z b hj hH hHX hX hHr ha hz hb hqsmall ht
  obtain ⟨k, hki, hkN⟩ := hlong hb hH hHX hj hHr ha
  exact hcap χ hq hp t a z b (by omega) hH hHX hX hz hb hqsmall ht ⟨k, hki, hkN.le⟩

private theorem fourth_weight_prod (Y Z : ℝ) (k : ℕ) (hk₁ : 4 ≤ k) (hk₂ : k < 8) :
    (∏ i ∈ blockIndices 3, if i < 4 ∨ i = k then Y else Z) = Y^5 * Z^3 := by
  let f (i : ℕ) : ℝ := if i < 4 ∨ i = k then Y else Z
  let r := k - 4
  have hr₀ : 4 + r = k := by dsimp only [r]; omega
  have hr : r ∈ Finset.range 4 := Finset.mem_range.mpr (by dsimp only [r]; omega)
  change (∏ i ∈ Finset.range (4 + 4), f i) = _
  rw [prod_range_add]
  have hfirst : (∏ i ∈ Finset.range 4, f i) = Y^4 := by
    calc
      _ = ∏ _i ∈ Finset.range 4, Y := prod_congr rfl fun i hi => ite_eq_left (Or.inl (mem_range.mp hi))
      _ = _ := by simp
  have hf : f (4 + r) = Y := ite_eq_left (Or.inr hr₀)
  have hrest : (∏ i ∈ (Finset.range 4).erase r, f (4 + i)) = Z^3 := by
    calc
      _ = ∏ _i ∈ (Finset.range 4).erase r, Z := by
        apply prod_congr rfl
        intro i hi
        apply ite_eq_right
        rintro (hh | hh)
        · omega
        · exact (mem_erase.mp hi).1 (by omega)
      _ = _ := by rw [prod_const, card_erase_of_mem hr, card_range]
  have hlast : (∏ i ∈ Finset.range 4, f (4 + i)) = Y * Z^3 := by
    rw [← mul_prod_erase (Finset.range 4) (fun i => f (4 + i)) hr, hf, hrest]
  rw [hfirst, hlast]
  ring

/-- In the fourth block, if none of the smooth slots is long at the
`x^(1/32)` cutoff, all four sharp Möbius slots are long at that same cutoff. -/
theorem fourth_all_sharp_long :
    ∀ᶠ x : ℝ in atTop, ∀ {X H : ℕ} {a z : ℝ} {b : Choice 3},
    b ∈ activeChoices X H 3 a z → H ≠ 0 → H ≤ X →
    (H : ℝ) ≤ (4*x)^((1:ℝ)/4) → x ≤ a →
    (∀ k : {i // i ∈ blockIndices 3}, k.val < 4 →
      scale (b k.val k.property) ≤ x^((1:ℝ)/32)) →
    ∀ k : {i // i ∈ blockIndices 3}, 4 ≤ k.val →
      x^((1:ℝ)/32) < scale (b k.val k.property) := by
  have ht := (tendsto_rpow_atTop (by norm_num : (0:ℝ)<1/64)).eventually
    (eventually_gt_atTop ((4:ℝ)^8))
  filter_upwards [ht, eventually_ge_atTop (1:ℝ)] with x hx hx₁
  intro X H a z b hb hH hHX hHr ha hshort k hk
  let Y := x^((1:ℝ)/32)
  have hx₀ : 0 < x := zero_lt_one.trans_le hx₁
  have hk₈ : k.val < 8 := by simpa only [blockIndices, Nat.reduceAdd, Nat.reduceMul, mem_range] using k.property
  by_contra! hkshort
  let f (i : ℕ) : ℝ := if i < 4 ∨ i = k.val then Y else (H:ℝ)
  have hprod : scales 3 b ≤ ∏ i ∈ (blockIndices 3).attach, f i.val := by
    apply prod_le_prod₀ (fun i _ => (scale_pos _).le)
    intro i _
    by_cases hi : i.val < 4 ∨ i.val = k.val
    · rw [show f i.val = Y from ite_eq_left hi]
      rcases hi with hi | hi
      · exact hshort i hi
      · have he : i = k := Subtype.ext hi
        subst i
        exact hkshort
    · rw [show f i.val = (H:ℝ) from ite_eq_right hi]
      apply (choice_scale_bounds hH hHX (Finset.mem_filter.mp hb).1 i.property).2.2
      have hge : 4 ≤ i.val := by omega
      simpa [isSharp] using hge
  rw [Finset.prod_attach, fourth_weight_prod Y (H:ℝ) k.val hk hk₈] at hprod
  have h4 : 4 ≤ x^((1:ℝ)/16) := by
    refine (show (4:ℝ) ≤ 4^8 by norm_num).trans (hx.le.trans ?_)
    exact Real.rpow_le_rpow_of_exponent_le hx₁ (by norm_num)
  have hHcap : (H:ℝ) ≤ x^((17:ℝ)/64) := by
    refine hHr.trans ?_
    have h4x : 4*x ≤ x^((17:ℝ)/16) := by
      rw [show (17:ℝ)/16 = 1/16+1 by norm_num, Real.rpow_add hx₀, Real.rpow_one]
      exact mul_le_mul_of_nonneg_right h4 hx₀.le
    have hh := Real.rpow_le_rpow (by positivity : 0≤4*x) h4x (by norm_num : (0:ℝ)≤1/4)
    simpa only [← Real.rpow_mul hx₀.le, show ((17:ℝ)/16)*(1/4)=17/64 by norm_num] using hh
  have he : Y^5 * (x^((17:ℝ)/64))^3 = x^((61:ℝ)/64) := by
    dsimp only [Y]
    rw [← Real.rpow_natCast, ← Real.rpow_natCast, ← Real.rpow_mul hx₀.le,
      ← Real.rpow_mul hx₀.le, ← Real.rpow_add hx₀]
    norm_num
  have hupper : scales 3 b ≤ x^((61:ℝ)/64) :=
    hprod.trans ((mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (Nat.cast_nonneg _) hHcap 3)
      (by dsimp only [Y]; positivity)).trans_eq he)
  have hgap : x^((61:ℝ)/64) < x / (4:ℝ)^8 := by
    apply (lt_div_iff₀ (by positivity)).mpr
    calc
      _ < x^((61:ℝ)/64) * x^((3:ℝ)/64) := mul_lt_mul_of_pos_left
        (hx.trans_le (Real.rpow_le_rpow_of_exponent_le hx₁ (by norm_num))) (by positivity)
      _ = _ := by rw [← Real.rpow_add hx₀]; norm_num
  have hlower : x / (4:ℝ)^8 ≤ scales 3 b :=
    (div_le_div_of_nonneg_right ha (by positivity)).trans (active_box_scales hb).1
  exact (not_lt_of_ge (hlower.trans hupper)) hgap

/-- The fourth block either offers a long smooth slot, or every sharp
slot is long; this avoids a new combinatorial premise in the Möbius case. -/
theorem fourth_long_slot_dichotomy :
    ∀ᶠ x : ℝ in atTop, ∀ {X H : ℕ} {a z : ℝ} {b : Choice 3},
    b ∈ activeChoices X H 3 a z → H ≠ 0 → H ≤ X →
    (H : ℝ) ≤ (4*x)^((1:ℝ)/4) → x ≤ a →
    (∃ k : {i // i ∈ blockIndices 3}, k.val < 4 ∧ x^((1:ℝ)/32) < scale (b k.val k.property)) ∨
    (∀ k : {i // i ∈ blockIndices 3}, 4 ≤ k.val → x^((1:ℝ)/32) < scale (b k.val k.property)) := by
  filter_upwards [fourth_all_sharp_long] with x hx
  intro X H a z b hb hH hHX hHr ha
  by_cases h : ∃ k : {i // i ∈ blockIndices 3}, k.val < 4 ∧ x^((1:ℝ)/32) < scale (b k.val k.property)
  · exact Or.inl h
  · refine Or.inr (hx hb hH hHX hHr ha (fun k hk => ?_))
    exact le_of_not_gt (fun hlong => h ⟨k, hk, hlong⟩)

end ShortAPAllSmoothBlocks

end

