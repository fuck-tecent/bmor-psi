      have h := hE q hq (χ^j) (hNP j hj) hEven z hz₁ hz₂ hzt
      rw [show φ j=e by simp [φ,hs]]
      exact h.trans (mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _)) (by positivity))
    · have h := hOdd j hj hs z hz₁ hz₂ hzt
      rw [show φ j=47/125 by simp [φ,hs]]
      exact h.trans (mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow_of_exponent_le hL (le_max_left _ _)) (by positivity))

