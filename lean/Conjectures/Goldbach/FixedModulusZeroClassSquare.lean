open scoped Interval

namespace GradedNear

namespace Parabolic

/-- `P(u) = (1 - u)³(1 + 3u + u²) = 1 - 5u² + 5u³ - u⁵`. -/
def P (u : ℝ) : ℝ := 1 - 5 * u ^ 2 + 5 * u ^ 3 - u ^ 5


/-! ## Condition 2 -/


end Parabolic
end GradedNear

open Complex MeasureTheory Set
