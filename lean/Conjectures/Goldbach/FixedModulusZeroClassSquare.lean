/-- The weighted square sum of near-right zeros is uniformly below one.
The sole outside input is the community real-quadratic zero-free window. -/
theorem fixedModulusClassBound_of_no_siegel
    (hNS : ∃ c : ℝ, 0<c ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (β : ℝ),
      χ^2=1 → 1-c/Real.log ((q:ℝ)+2)<β → β<1 → χ.LFunction (β:ℂ)≠0) :
    ∃ θ : ℝ, 0≤θ ∧ θ<1 ∧ FixedModulusClassBound θ := by
  obtain ⟨δ,hδ,_,hLower⟩ := eventual_real_lower_gap_for_census hNS
  let θ := max (0.994:ℝ) (1-0.9*δ)
  have hθ : 0.994≤θ := le_max_left _ _
  refine ⟨θ,(by norm_num : (0:ℝ)≤0.994).trans hθ,
    max_lt (by norm_num) (by linarith only [hδ]),?_⟩
  apply fixedModulusClassBound_of_clean
  intro K H U hH hU
  have hU₀ : 0≤U := (by norm_num : (0:ℝ)≤2).trans hU
  have hLowH : (0.226:ℝ)≤H := (by norm_num : (0.226:ℝ)≤4).trans hH
  have hMidH : (0.30:ℝ)≤H := (by norm_num : (0.30:ℝ)≤4).trans hH
  have hHighH : (0.38:ℝ)≤H := (by norm_num : (0.38:ℝ)≤4).trans hH
  filter_upwards [eventually_modulus_window_growth K.factorial (Nat.factorial_pos K) hU₀,
    eventually_census_weights K hH hU₀,
    eventually_leading_gap_or_real (Q:=K.factorial) hU₀,
    eventually_modulus_leading_simple (Q:=K.factorial) (H:=H) (U:=U),
    eventually_modulus_early_complex_orbit (Q:=K.factorial) (H:=H) (U:=U),
    eventually_modulus_conjugate_separate_class K (H:=H) (U:=U),
    eventually_modulus_moderate_rivals K (U:=U) hH,
    eventually_modulus_mid_real_rivals K (H:=H) (U:=U),
    eventually_modulus_tiny_real_rivals_of_growth K (H:=H) (U:=U) hδ,
    hLower,
    census_376_low_class_square_eventually (U:=U) K hLowH,
    census_376_mid_class_square_eventually (U:=U) K hMidH,
    census_376_high_class_square_eventually (U:=U) K hHighH]
    with q hG hWeights hLeadCase hSimple hOrbit hSeparate hM hMR hTiny hLower hLC hMC hHC
  intro _ R hR hRU hClean
  have hR₀ : 0≤R := (by norm_num : (0:ℝ)≤2).trans hR
  have G : ModulusWindowGrowth q K.factorial U := hG
  have W := hWeights R hR₀ hRU hClean
  let S := modulusZeros q H R
  let T := repeatTags S modulusOrder
  let g (t : ModulusTag q) := modulusGap q t.1.2
  let key (t : ModulusTag q) := conductorClass K t.1.1
  have hGaps (h : ℝ) (b : ℝ) (D : CensusDensityBound q K H R true h b 0) :
      ∀ c∈T.image key, (∑ t∈(T.filter (fun t=>key t=c)).filter (fun t=>h<g t),
        gapWeight (g t))≤b := by
    intro c _
    let V := T.filter (fun t=>key t=c)
    let V' := V.filter (fun t=>h<g t)
    have hV : V'⊆V := filter_subset _ _
    exact D.plain_tail (hV.trans (filter_subset _ _))
      (fun i hi j hj=>oneConductorClass_of_filter T c i (hV hi) j (hV hj))
      (fun _ ht=>(mem_filter.mp ht).2.le)
  have hLClip := (W.low T (Subset.refl _) (by simp)).1
  have hMClip := (W.mid T (Subset.refl _) (by simp)).1
  have hLTail := hGaps _ _ W.farLow
  have hMTail := hGaps _ _ W.farMid
  by_cases hS : S.Nonempty
  · have hqpos : (1:ℝ)<q := by
      have hq₀ : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
      have hh := Real.log_le_sub_one_of_pos hq₀
      linarith only [hh,G.log_one]
    obtain ⟨p,hp,hP,hMin⟩ := exists_fixed_modulus_leading hqpos hS
    let a := modulusGap q p.2
    by_cases hHigh : 0.38≤a
    · exact (hHC R hR₀ hRU hClean (fun r hr=>hHigh.trans (hMin r hr)) hMClip hLTail).trans
        ((by norm_num : (0.922:ℝ)≤0.994).trans hθ)
    have ha38 : a≤0.38 := (lt_of_not_ge hHigh).le
    have hs := hSimple R hR₀ hRU G hClean p hp hP ha38
    have hRS := hLeadCase H R hR₀ hRU G hClean p hp hP
    have hComplexRank {d : ℝ} (hNon : ¬(p.1^2=1 ∧ p.2.im=0))
        (hTest : ∀ r∈S,modulusGap q r.2<d →
          (a≤0.38 ∧ modulusGap q r.2≤0.53 ∨
            p.1^2≠1 ∧ a≤0.30 ∧ modulusGap q r.2≤0.60)) :=
      modulus_rank_of_conjugate_pair (K:=K) hs
        (hSimple R hR₀ hRU G hClean _ (mem_modulus_conjugate hp)
          (fun r hr=>by simpa [line] using hP r hr)
          (by simpa [modulusGap,line,a] using ha38))
        (fun r hr hd=>hOrbit R hR₀ hRU G hClean p hp hP hNon r hr (hTest r hr hd))
    by_cases hMid : 0.30≤a
    · have hRank : ((T.filter (fun t=>g t<0.53)).card:ℝ)≤2 := by
        by_cases hRQ : p.1^2=1 ∧ p.2.im=0
        · have hRiv := hMR R hR₀ hRU G hClean p hp hP hRQ.1 hRQ.2 hs
            (by simpa only [show (19/50:ℝ)=0.38 by norm_num] using ha38)
          have hRiv' : ∀ r∈modulusRivals K false H R p,(0.53:ℝ)< modulusGap q r.2 := by
            simpa only [show (53/100:ℝ)=0.53 by norm_num] using hRiv
          exact (modulus_rank_of_single_leader hs hRiv').1
        · exact (hComplexRank (d:=0.53) hRQ (fun _ _ h=>Or.inl ⟨ha38,h.le⟩)).1
      exact (hMC R hR₀ hRU hClean (fun r hr=>hMid.trans (hMin r hr))
        (by exact_mod_cast hRank) hMClip hMTail).trans
        ((by norm_num : (0.983:ℝ)≤0.994).trans hθ)
    have ha30 : a≤0.30 := (lt_of_not_ge hMid).le
    by_cases hLo : (0.226:ℝ)≤a
    · have hRank : ((T.filter (fun t=>g t<0.60)).card:ℝ)≤2 ∧
          ∀ c, (((T.filter (fun t=>key t=c)).filter (fun t=>g t<0.60)).card:ℝ)≤1 := by
        rcases hRS with hRQ|⟨_,hqGap⟩
        · have hTests := hM R hR₀ hRU G hClean p hp hP hRQ.1 hRQ.2 hs
          have hRiv : ∀ r∈modulusRivals K false H R p,(0.60:ℝ)< modulusGap q r.2 := hTests 5 ha30
          exact modulus_rank_of_single_leader hs hRiv
        · have hQ : p.1^2≠1 := fun h=> (hqGap h).not_ge (ha30.trans (by norm_num))
          obtain ⟨hCard,hByClass⟩ :=
            hComplexRank (d:=0.60) (fun h=>hQ h.1) (fun _ _ h=>Or.inr ⟨hQ,ha30,h.le⟩)
          exact ⟨hCard,hByClass (hSeparate R hR₀ hRU G hClean p hp hP hQ ha30)⟩
      exact (hLC R hR₀ hRU hClean (fun r hr=>hLo.trans (hMin r hr))
        (by exact_mod_cast hRank.1) (fun c hc=>by exact_mod_cast hRank.2 c) hLClip hLTail).trans
        ((by norm_num : (0.973:ℝ)≤0.994).trans hθ)
    have hRQ := hRS.resolve_right (fun h=>hLo h.1.le)
    by_cases hTinyA : a≤0.005
    · have haδ := hLower H R p hp hRQ.1 hRQ.2
      have hRiv := hTiny R hR₀ hRU G hClean p hp hP hRQ.1 hRQ.2 haδ hTinyA
      obtain ⟨hCut,hBC,hBD⟩ := tiny_cutoff_budget (hδ.trans_le haδ) hTinyA
      exact (modulus_class_square_tiny hp hs hδ haδ hTinyA hRiv
        (fun V hV hVmin=>((W.tinyGlobal V hV (by simp)).2 _ hCut hVmin).trans hBC)
        (fun V hV hVC hVmin=>((W.tinyClass V hV (fun _=>hVC)).2 _ hCut hVmin).trans hBD)).trans
        (le_max_right _ _)
    exact (modulus_class_square_moderate W.moderate hp hs
      (hM R hR₀ hRU G hClean p hp hP hRQ.1 hRQ.2 hs)
      (lt_of_not_ge hTinyA).le (lt_of_not_ge hLo).le).trans hθ
  · have hS' : modulusZeros q H R=∅ := not_nonempty_iff_eq_empty.mp hS
    rw [modulusClassMassSquare,hS']
    simp only [classMassSq,image_empty,sum_empty]
    exact (by norm_num : (0:ℝ)≤0.994).trans hθ

end
end GoldbachSignedPairs
