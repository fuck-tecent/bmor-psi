private theorem cd_resolvent_point_add (b L γ : ℝ) (ρ : ℂ) :
    cdResolventPoint b L γ ρ=cdResolventPoint 0 L γ ρ+(b:ℂ) := by
  apply Complex.ext <;> simp [cdResolventPoint,add_comm]

private theorem cd_resolvent_real_le {b L γ : ℝ} (hb : 0 < b) (hL : 0 ≤ L)
    {ρ : ℂ} (hρ : ρ.re ≤ 1) (u : ℝ) :
    ((scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u)⁻¹).re≤b⁻¹ := by
  have hh : b ≤ (scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u).re := by
    rw [scaledSpectrumDenominator_re]
    exact le_add_of_nonneg_right (mul_nonneg (sub_nonneg.mpr hρ) hL)
  have hz := hh.trans (Complex.re_le_norm _)
  calc
    _ ≤ ‖(scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u)⁻¹‖ := Complex.re_le_norm _
    _ ≤ _ := by rw [norm_inv]; exact inv_anti₀ hb hz

set_option maxHeartbeats 1250000 in
/-- The actual compact Laplace sum on a nearby finite zero set, with all
errors made explicit before choosing the radius and right displacement. -/
theorem cd_sinh_laplace_near_eventually {φ ω T H J : ℝ} (hφ : 3/8 < φ)
    (hω : 0 < ω) (hT : 0 ≤ T) (hH : 0 ≤ H) (hJ : 0 ≤ J) :
    ∃ C D : ℝ, 0 < C ∧ 0 < D ∧ ∀ (r b ε : ℝ), 0 < r → r ≤ 1/32 → 0 < b → 0 < ε →
      ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ χ : DirichletCharacter ℂ q, χ≠1 →
      ∀ γ ell : ℝ, |γ| ≤ T → 0 < ell → ell ≤ H →
      ∀ V : Finset ℂ,
        (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re ≤ 1 ∧ (1-ρ.re)*L ≤ H ∧ |ρ.im-γ| ≤ r/2) →
        (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)) ≤ J →
        (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
          (laplace (sinhTest ω ell) (cdResolventPoint 0 L γ ρ)).re) ≤
          (φ/2+C*r+ε)*sinhTest ω ell 0+(laplace (sinhTest ω ell) 0).re+
          (((Real.log 4+4)*ω*Real.cosh (H*ω))+
            (J/b+D+2/b)*(32*Real.pi*Real.exp (H*ω)/r))*ell/L+
          J*((b*ell)*ω^3*Real.cosh (H*ω)) := by
  obtain ⟨C,hC,hLoc⟩ := cd_near_resolvent_eventually hφ hT hH
  obtain ⟨D,hD,hAbs⟩ := cd_rightLog_bounds
  refine ⟨C,D,hC,hD,?_⟩
  intro r b ε hr hrsmall hb hε
  filter_upwards [hLoc r b ε hr hrsmall hb hε,eventually_ge_atTop (max 1 b)] with L hLoc' hL
  intro q _ hq χ hχ γ ell hγ hell hEll V hV hCount
  have hL₁ : 1≤L := (le_max_left _ _).trans hL
  have hLB : b≤L := (le_max_right _ _).trans hL
  have hL₀ := zero_lt_one.trans_le hL₁
  let K := sinhSpectrumWeight ω ell
  let G (u : ℝ) := (logDeriv χ.LFunction (cdRightLine b L γ u)).re/L
  let R := r*L/(4*Real.pi)
  let E := φ/2+C*r+ε
  let B := J/b+D+2/b
  let m (ρ : ℂ) := analyticOrderNatAt (regularizedL χ) ρ
  let z (ρ : ℂ) := cdResolventPoint b L γ ρ
  have hE : 0≤E := by dsimp only [E]; positivity [show 0≤φ by linarith only [hφ]]
  have hB : 0≤B := by dsimp only [B]; positivity
  have hR : 0<R := by dsimp only [R]; positivity
  have hz₀ (ρ : ℂ) (hρ : ρ∈V) : 0≤(cdResolventPoint 0 L γ ρ).re :=
    (add_nonneg) le_rfl (mul_nonneg (sub_nonneg.mpr (hV ρ hρ).2.1) hL₀.le)
  have hz (ρ : ℂ) (hρ : ρ∈V) : 0<(z ρ).re :=
    (add_pos_of_pos_of_nonneg) hb (mul_nonneg (sub_nonneg.mpr (hV ρ hρ).2.1) hL₀.le)
  obtain ⟨hInt,hPrime⟩ := cd_prime_average_le χ hχ hb hL₁ hLB hω hell hEll (γ:=γ)
  change Integrable (fun u=>K u*G u) at hInt
  have hLocal (u : ℝ) (hu : u∈Set.Icc (-R) R) :
      (∑ ρ∈V,(m ρ:ℝ)*((scaledSpectrumDenominator (z ρ) u)⁻¹).re) ≤E+G u :=
    hLoc' q hq χ hχ γ hγ V hV u (abs_le.2 ⟨hu.1,hu.2⟩)
  have hGlob (u : ℝ) (_ : u∉Set.Icc (-R) R) :
      (∑ ρ∈V,(m ρ:ℝ)*((scaledSpectrumDenominator (z ρ) u)⁻¹).re) ≤B+G u := by
    have hS : (∑ ρ∈V,(m ρ:ℝ)*((scaledSpectrumDenominator (z ρ) u)⁻¹).re)≤J/b := by
      calc
        _≤∑ ρ∈V,(m ρ:ℝ)*b⁻¹ := sum_le_sum fun ρ hρ =>
          mul_le_mul_of_nonneg_left (cd_resolvent_real_le hb hL₀.le (hV ρ hρ).2.1 u)
            (Nat.cast_nonneg _)
        _ ≤ _ := by
          rw [←sum_mul,div_eq_mul_inv]
          exact mul_le_mul_of_nonneg_right hCount (inv_nonneg.mpr hb.le)
    have hNorm := hAbs q χ hχ hb hL₁ hLB (γ:=γ) u
    have hLog : -G u≤D+2/b := by
      dsimp only [G]
      rw [←neg_div]
      exact (div_le_div_of_nonneg_right ((neg_le_abs _).trans (Complex.abs_re_le_norm _)) hL₀.le).trans hNorm
    dsimp only [B]
    linarith only [hS,hLog]
  have hAvg := sinh_laplace_sum_le_of_spectral_bounds V m z hω hell hEll hR hE hB hz G
    hInt hPrime hLocal hGlob
  have hShift := sinh_laplace_sum_shift_le V m (cdResolventPoint 0 L γ) hω hell hEll hb.le hz₀ hCount
  have hEq (ρ : ℂ) : cdResolventPoint 0 L γ ρ+(b:ℂ)=z ρ := (cd_resolvent_point_add b L γ ρ).symm
  simp_rw [hEq] at hShift
  refine hShift.trans ?_
  have hTail : B*(2*(4*ell*Real.exp (H*ω))/R) =
      (J/b+D+2/b)*(32*Real.pi*Real.exp (H*ω)/r)*ell/L := by
    dsimp only [R,B]
    field_simp [hr.ne',hL₀.ne',Real.pi_ne_zero]
    ring
  rw [hTail] at hAvg
  dsimp only [E] at hAvg
  convert add_le_add_right hAvg (J*((b*ell)*ω^3*Real.cosh (H*ω))) using 1 <;> ring

end
end GoldbachPintzWeightedFormula
end

