set_option maxHeartbeats 900000 in
/-- Finite Abel truncation under a initial segment bound of real order a. The
exponent and the denominator retain their full dependence on Re s. -/
theorem nonprincipal_truncation_of_power_partial_sum {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hχ : χ ≠ 1) {B a : ℝ} (hB0 : 0≤B) (ha : 0≤a)
    (hB : ∀ M : ℕ, ‖charPartialSum χ M‖ ≤ B*(M:ℝ)^a)
    {s : ℂ} (hs : a<s.re) {N : ℕ} (hN : 1 ≤ N) :
    ‖DirichletCharacter.LFunction χ s - Lpartial χ N s‖ ≤
      B*(1+‖s‖/(s.re-a))*(N:ℝ)^(a-s.re) := by
  have hs' := ha.trans_lt hs
  let c : ℕ → ℂ := fun n => if n = 0 then 0 else χ (n : ZMod q)
  let f : ℝ → ℂ := fun x => (x : ℂ) ^ (-s)
  let F : ℝ → ℂ := fun x => (x : ℂ) ^ (-s - 1) * charPartialSum χ ⌊x⌋₊
  have hn : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hn0 : (0 : ℝ) < N := zero_lt_one.trans_le hn
  have hs0 : s ≠ 0 := by
    intro he
    simp [he] at hs'
  have hdiff {x : ℝ} (hx : 0 < x) :
      HasDerivAt f (-s * (x : ℂ) ^ (-s - 1)) x :=
    hasDerivAt_ofReal_cpow_const hx.ne' (neg_ne_zero.mpr hs0)
  have hcont (p : ℂ) : ContinuousOn (fun x : ℝ => (x : ℂ) ^ p) (Set.Ici 1) := by
    intro x hx
    exact (continuousAt_ofReal_cpow_const x p
      (Or.inr (zero_lt_one.trans_le hx).ne')).continuousWithinAt
  have hder : IntegrableOn (deriv f) (Set.Icc (1 : ℝ) N) := by
    have hcd : ContinuousOn (fun x : ℝ => -s * (x : ℂ) ^ (-s - 1))
        (Set.Icc (1 : ℝ) N) :=
      continuousOn_const.mul ((hcont _).mono Set.Icc_subset_Ici_self)
    exact (hcd.integrableOn_compact isCompact_Icc).congr_fun
      (fun x hx => (hdiff (zero_lt_one.trans_le hx.1)).deriv.symm) measurableSet_Icc
  have hc (M : ℕ) : (∑ k ∈ Finset.Icc 0 M, c k) = charPartialSum χ M := by
    rw [← Nat.range_succ_eq_Icc_zero, Finset.sum_range_succ']
    simp [c, charPartialSum]
  have habel := sum_mul_eq_sub_integral_mul₀' (c := c) (f := f) (m := N)
    (hc := by simp [c]) (hf_diff := fun x hx => (hdiff (zero_lt_one.trans_le hx.1)).differentiableAt)
    (hf_int := hder)
  have htrunc : (∑ k ∈ Finset.Icc 0 N, f k * c k) = Lpartial χ N s := by
    rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le N), Finset.sum_cons]
    simp only [c, ite_true, mul_zero, zero_add, Lpartial]
    rw [← Finset.Icc_add_one_left_eq_Ioc]
    apply Finset.sum_congr rfl
    intro k hk
    have hpos := (Finset.mem_Icc.mp hk).1
    simp only [ite_eq_right (by omega : k ≠ 0), f, ofReal_natCast, mul_comm]
  have hint₁ : (∫ x in Set.Ioc (1 : ℝ) N,
      deriv f x * ∑ k ∈ Finset.Icc 0 ⌊x⌋₊, c k) = -s * ∫ x in Set.Ioc (1 : ℝ) N, F x := by
    rw [← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Ioc
    intro x hx
    change deriv f x * (∑ k ∈ Finset.Icc 0 ⌊x⌋₊, c k) = -s * F x
    rw [hc, (hdiff (zero_lt_one.trans hx.1)).deriv]
    dsimp only [F]
    ring
  have hrem (x : ℝ) (hx : 0 < x) : ‖F x‖ ≤ B * x ^ (a-s.re-1) := by
    dsimp only [F]
    rw [norm_mul, norm_cpow_eq_rpow_re_of_pos hx, sub_re, neg_re, one_re]
    have hh := (hB ⌊x⌋₊).trans (mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow (Nat.cast_nonneg _) (Nat.floor_le hx.le) ha) hB0)
    calc
      _ ≤ x^(-s.re-1)*(B*x^a) := mul_le_mul_of_nonneg_left hh (by positivity)
      _ = B*(x^a*x^(-s.re-1)) := by ring
      _ = _ := by rw [←Real.rpow_add hx]; ring_nf
  have hp : a-s.re-1 < -1 := by linarith only [hs]
  have hInt {a : ℝ} (ha : 0 < a) : IntegrableOn F (Set.Ioi a) := by
    have hMajor := (integrableOn_Ioi_rpow_of_lt hp ha).const_mul B
    refine Integrable.mono' hMajor ?_ ?_
    · have hF : Measurable F := ((measurable_ofReal.pow_const _).mul
        ((measurable_of_countable (charPartialSum χ)).comp measurable_id.nat_floor))
      exact hF.aestronglyMeasurable
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      exact hrem x (ha.trans hx)
  have hBase := hInt one_pos
  have hR := hInt hn0
  have hspl : (∫ x in Set.Ioi (1 : ℝ), F x) =
      (∫ x in Set.Ioc (1 : ℝ) N, F x) + ∫ x in Set.Ioi (N : ℝ), F x := by
    rw [← Set.Ioc_union_Ioi_eq_Ioi hn, setIntegral_union
      Set.Ioc_disjoint_Ioi_same measurableSet_Ioi
      (hBase.mono_set Set.Ioc_subset_Ioi_self) hR]
  have hmain : DirichletCharacter.LFunction χ s - Lpartial χ N s =
      s * (∫ x in Set.Ioi (N : ℝ), F x) - f N * charPartialSum χ N := by
    rw [LFunction_eq_remainderMellin χ hχ hs', remainderMellin_eq_integral]
    simp only [charMean_eq, ite_eq_right hχ, mul_zero, sub_zero]
    change s * (∫ x in Set.Ioi (1 : ℝ), F x) - Lpartial χ N s = _
    rw [hspl, ← htrunc, habel, hc, hint₁]
    ring
  have htail : ‖∫ x in Set.Ioi (N : ℝ), F x‖ ≤
      B * (N : ℝ) ^ (a-s.re) / (s.re-a) := by
    refine (norm_integral_le_of_norm_le
      ((integrableOn_Ioi_rpow_of_lt hp hn0).const_mul B) ?_).trans_eq ?_
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      exact hrem x (hn0.trans hx)
    · rw [integral_const_mul, integral_Ioi_rpow_of_lt hp hn0,
        show a-s.re-1+1=a-s.re by ring]
      rw [show a-s.re = -(s.re-a) by ring]
      simp only [div_neg, neg_div, neg_neg, ← mul_div_assoc]
  rw [hmain]
  have hnorm : ‖f N‖ = (N : ℝ) ^ (-s.re) := by
    dsimp only [f]
    rw [norm_cpow_eq_rpow_re_of_pos hn0, neg_re]
  calc
    _ ≤ ‖s‖ * ‖∫ x in Set.Ioi (N : ℝ), F x‖ + ‖f N‖ * ‖charPartialSum χ N‖ := by
      simpa only [norm_mul] using norm_sub_le
        (s * ∫ x in Set.Ioi (N : ℝ), F x) (f N * charPartialSum χ N)
    _ ≤ ‖s‖*(B*(N:ℝ)^(a-s.re)/(s.re-a)) +
        (N:ℝ)^(-s.re)*(B*(N:ℝ)^a) := by
      rw [hnorm]
      exact add_le_add (mul_le_mul_of_nonneg_left htail (norm_nonneg _))
        (mul_le_mul_of_nonneg_left (hB N) (by positivity))
    _ = _ := by
      have he : -(s.re)+a=a-s.re := by ring
      rw [show (N:ℝ)^(-s.re)*(B*(N:ℝ)^a) = B*(N:ℝ)^(a-s.re) by
        rw [←he,Real.rpow_add hn0]; ring]
      ring


end GoldbachHybridGrowth
