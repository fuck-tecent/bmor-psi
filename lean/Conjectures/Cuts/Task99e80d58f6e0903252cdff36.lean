      x * (if n % 2 = N % 2 then suzukiLayer 1 2 n x else 0) =
        (if n = 1 then 3 - x else 0) +
          3 * (if n % 2 = N % 2 then suzukiLayer 1 2 n 3 else 0) := by
    intro n hn
    by_cases hn1 : n = 1
