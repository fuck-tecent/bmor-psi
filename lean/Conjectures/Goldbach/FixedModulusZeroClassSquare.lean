noncomputable section


/-- The scale incurred when a 2/3-power Burgess initial segment is balanced with
the trivial initial segment bound. -/
def prefixGrowthScale (A T : ℝ) : ℝ := 2*(24*(1+T)*A)^3

set_option maxHeartbeats 1100000 in
/-- Conditional transfer from the r=3 Burgess initial segment bound to the sharp
near-one strip required by the cosine argument. -/
theorem nonprincipal_LFunction_uniform_strip_of_two_thirds_prefix
    {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (hχ : χ≠1)
    {A Q φ T : ℝ} (hA : 1≤A) (hQ : 1≤Q) (hφ : 0≤φ) (hT : 0≤T)
    (hprefix : ∀ n : ℕ, ‖charPartialSum χ n‖≤(A*Q^(φ/3))*(n:ℝ)^(2/3:ℝ))
    {s : ℂ} (hlo : (3/4:ℝ) ≤ s.re) (hhi : s.re≤3/2) (him : |s.im|≤T) :
    let C := prefixGrowthScale A T
    ‖χ.LFunction s‖≤(C*(2+Real.log C+φ*Real.log Q))*Q^(φ*max 0 (1-s.re)) := by
  intro C
  let D : ℝ := 24*(1+T)*A
  let Y : ℝ := D^3*Q^φ
  let N := ⌈Y⌉₊
  let p : ℝ := max 0 (1-s.re)
  have hD : 1≤D := by
    have h' : 1≤1+T := by linarith only [hT]
    have hT' := one_le_mul_of_one_le_of_one_le h' hA
    dsimp [D]
    nlinarith only [hT']
  have hD0 := zero_lt_one.trans_le hD
  have hC : 1≤C := by
    change (1:ℝ)≤2*D^3
    nlinarith only [one_le_pow₀ hD (n:=3)]
  have hC0 := zero_lt_one.trans_le hC
  have hQ0 := zero_lt_one.trans_le hQ
  have hp : 0≤p := le_max_left _ _
  have hp1 : p≤1 := max_le zero_le_one (by linarith)
  have hY : 1≤Y := one_le_mul_of_one_le_of_one_le (one_le_pow₀ hD) (Real.one_le_rpow hQ hφ)
  have hN : 1≤N := by exact_mod_cast hY.trans (Nat.le_ceil Y)
  have hN1 : (1:ℝ)≤N := by exact_mod_cast hN
  have hN0 := zero_lt_one.trans_le hN1
  have hNBound : (N:ℝ)≤C*Q^φ := calc
    _ ≤ Y+1 := (Nat.ceil_lt_add_one (zero_le_one.trans hY)).le
    _ ≤ 2*Y := by linarith only [hY]
    _ = _ := by change 2*(D^3*Q^φ)=(2*D^3)*Q^φ; ring
  have hs : (2/3:ℝ)<s.re := by linarith only [hlo]
  have hs0 : 0<s.re := by linarith only [hlo]
  have hsNorm : ‖s‖≤3/2+T := by
    calc
      _ = ‖(s.re:ℂ)+(s.im:ℂ)*I‖ := congrArg norm (Complex.re_add_im s).symm
      _ ≤ ‖(s.re:ℂ)‖+‖(s.im:ℂ)*I‖ := norm_add_le _ _
      _ ≤ _ := by
        rw [norm_mul,norm_I,mul_one,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,
          Real.norm_eq_abs,abs_of_pos hs0]
        linarith only [hhi,him]
  have hsCoef : 1+‖s‖/(s.re-2/3)≤24*(1+T) := by
    have hden : (1/12:ℝ) ≤ s.re-2/3 := by linarith only [hlo]
    have hd := (div_le_iff₀ (sub_pos.mpr hs)).mpr (
      hsNorm.trans (show 3/2+T ≤ (18+12*T)*(s.re-2/3) by
        have hh := mul_le_mul_of_nonneg_left hden (by positivity : 0≤18+12*T)
        nlinarith only [hh]))
    linarith only [hd,hT]
  have hEqScale : Y^(1/3:ℝ)=D*Q^(φ/3) := by
    unfold Y
    rw [Real.mul_rpow (pow_nonneg hD0.le _) (Real.rpow_nonneg hQ0.le _),
      ←Real.rpow_mul hQ0.le,←Real.rpow_natCast_mul hD0.le]
    norm_num only [Nat.cast_ofNat]
    rw [Real.rpow_one,show φ*(1/3)=φ/3 by ring]
  have hTailCoef : (A*Q^(φ/3))*(1+‖s‖/(s.re-2/3))≤(N:ℝ)^(1/3:ℝ) := calc
    _ ≤ (A*Q^(φ/3))*(24*(1+T)) :=
      mul_le_mul_of_nonneg_left hsCoef (by positivity)
    _ = Y^(1/3:ℝ) := by rw [hEqScale]; unfold D; ring
    _ ≤ _ := Real.rpow_le_rpow (zero_le_one.trans hY) (Nat.le_ceil Y) (by norm_num)
  have hTail := nonprincipal_truncation_of_power_partial_sum χ hχ
    (B:=A*Q^(φ/3)) (a:=(2/3:ℝ)) (by positivity) (by norm_num) hprefix hs hN
  have hTail' : ‖χ.LFunction s-Lpartial χ N s‖≤(N:ℝ)^p := calc
    _ ≤ (A*Q^(φ/3))*(1+‖s‖/(s.re-2/3))*(N:ℝ)^(2/3-s.re) := hTail
    _ ≤ (N:ℝ)^(1/3:ℝ)*(N:ℝ)^(2/3-s.re) :=
      mul_le_mul_of_nonneg_right hTailCoef (by positivity)
    _ = (N:ℝ)^(1-s.re) := by
      rw [←Real.rpow_add hN0]
      congr 1
      ring
    _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hN1 (le_max_right _ _)
  have hPart := Lpartial_harmonic_power_le χ s hN
  have hTotal : ‖χ.LFunction s‖≤(N:ℝ)^p*(2+Real.log (N:ℝ)) := by
    have hh := (norm_add_le (χ.LFunction s-Lpartial χ N s) (Lpartial χ N s)).trans
      (add_le_add hTail' hPart)
    rw [sub_add_cancel] at hh
    exact hh.trans_eq (by ring)
  have hExp : (N:ℝ)^p≤C*Q^(φ*p) := calc
    _ ≤ (C*Q^φ)^p := Real.rpow_le_rpow hN0.le hNBound hp
    _ = C^p*Q^(φ*p) := by
      rw [Real.mul_rpow hC0.le (Real.rpow_nonneg hQ0.le _),←Real.rpow_mul hQ0.le]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (by simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hC hp1) (by positivity)
  have hLogN := Real.log_le_log hN0 hNBound
  rw [Real.log_mul hC0.ne' (Real.rpow_pos_of_pos hQ0 φ).ne',Real.log_rpow hQ0] at hLogN
  refine hTotal.trans ((mul_le_mul hExp (by linarith only [hLogN] :
    2+Real.log (N:ℝ)≤2+Real.log C+φ*Real.log Q)
    (by linarith only [Real.log_nonneg hN1]) (by positivity)).trans_eq ?_)
  change (C*Q^(φ*p))*(2+Real.log C+φ*Real.log Q)=(C*(2+Real.log C+φ*Real.log Q))*Q^(φ*p)
  ring

end

end GoldbachHybridGrowth
end

section
namespace GoldbachHybridGrowth

open Complex

/-- Interpolate the trivial count and a three-fifths-in-length Burgess
initial segment estimate to the two-thirds form of the strip transfer. -/
theorem prefix_bound_of_three_fifths_prefix {A Q δ : ℝ} (hA : 1≤A) (hQ : 1≤Q)
    {u : ℕ→ℂ} (htriv : ∀ n, ‖u n‖≤(n:ℝ))
    (hhalf : ∀ n, ‖u n‖≤A*Q^(2*δ/5)*(n:ℝ)^(3/5:ℝ)) (n : ℕ) :
    ‖u n‖≤A^(5/6:ℝ)*Q^(δ/3)*(n:ℝ)^(2/3:ℝ) := by
  have hA0 : 0<A := zero_lt_one.trans_le hA
  have hQ0 : 0<Q := zero_lt_one.trans_le hQ
  have hN : (0:ℝ)≤n := Nat.cast_nonneg n
  have hN' : 0≤(n:ℝ)^(3/5:ℝ) := Real.rpow_nonneg hN _
  have hP : 0≤A*Q^(2*δ/5) := by positivity
  by_cases he : ‖u n‖=0
  · rw [he]
    positivity
  have he' : 0<‖u n‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm he)
  have hn' : 0<(n:ℝ) := he'.trans_le (htriv n)
  calc
    ‖u n‖=‖u n‖^(1/6:ℝ)*‖u n‖^(5/6:ℝ) := by
      rw [←Real.rpow_add he',show (1/6:ℝ)+5/6=1 by norm_num,Real.rpow_one]
    _ ≤ (n:ℝ)^(1/6:ℝ)*(A*Q^(2*δ/5)*(n:ℝ)^(3/5:ℝ))^(5/6:ℝ) :=
      mul_le_mul (Real.rpow_le_rpow he'.le (htriv n) (by norm_num))
        (Real.rpow_le_rpow he'.le (hhalf n) (by norm_num))
        (Real.rpow_nonneg he'.le _) (Real.rpow_nonneg hN _)
    _ = _ := by
      rw [Real.mul_rpow hP hN',Real.mul_rpow hA0.le (Real.rpow_nonneg hQ0.le _),
        ←Real.rpow_mul hQ0.le,←Real.rpow_mul hN,
        show (2*δ/5)*(5/6)=δ/3 by ring,
        show (3/5:ℝ)*(5/6)=1/2 by norm_num]
      calc
        _ = A^(5/6:ℝ)*Q^(δ/3)*((n:ℝ)^(1/6:ℝ)*(n:ℝ)^(1/2:ℝ)) := by ring
        _ = _ := by rw [←Real.rpow_add hn',show (1/6:ℝ)+1/2=2/3 by norm_num]

end GoldbachHybridGrowth
end

section
/-!
The exact Möbius transfer is adapted from Eric Naslund, `GradedNear/BurgessReduction.lean`
(https://github.com/enaslund/linniks-constant-3.99/blob/ecdbe3e3e08ad499d2c749ff417cc461f57334c5/GradedNear/BurgessReduction.lean).
-/

namespace GoldbachBurgessPrefix

open Finset Complex GoldbachGrhGrowth ArithmeticFunction
open scoped ArithmeticFunction.Moebius Classical

noncomputable section

/-- A character agrees with its primitive character on integers prime to the level and vanishes
on the others. -/
private lemma apply_eq_ite_primitive {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) :
    χ n = if n.Coprime q then χ.primitiveCharacter n else 0 := by
  split_ifs with h
  · have h' : IsCoprime (n : ℤ) (q : ℤ) := Nat.isCoprime_iff_coprime.mpr h
    have := χ.primitiveCharacter_apply_of_isCoprime h'
    simpa using this.symm
  · exact χ.map_nonunit (by rwa [ZMod.isUnit_iff_coprime])

/-- `Σ_{d ∣ m} μ(d) = [m = 1]`. -/
private lemma sum_moebius_divisors (m : ℕ) :
    ∑ d ∈ m.divisors, (μ d : ℂ) = if m = 1 then 1 else 0 := by
  have h := congrArg (fun f : ArithmeticFunction ℤ => f m) ArithmeticFunction.moebius_mul_coe_zeta
  simp only [ArithmeticFunction.coe_mul_zeta_apply, ArithmeticFunction.one_apply] at h
  have h2 : ∑ d ∈ m.divisors, (μ d : ℂ) = ((∑ d ∈ m.divisors, μ d : ℤ) : ℂ) := by push_cast; rfl
  rw [h2, h]
  split_ifs <;> simp

/-- Möbius inversion over the divisors of the level:
`Σ_{n ∈ s} χ(n) = Σ_{d ∣ q} μ(d) Σ_{n ∈ s, d ∣ n} χ*(n)`. -/
private lemma sum_eq_sum_divisors {q : ℕ} (hq : q ≠ 0) (χ : DirichletCharacter ℂ q)
    (s : Finset ℕ) :
    ∑ n ∈ s, χ n =
      ∑ d ∈ q.divisors, (μ d : ℂ) * ∑ n ∈ s.filter (d ∣ ·), χ.primitiveCharacter n := by
  have key : ∀ n : ℕ, χ n =
      ∑ d ∈ q.divisors, if d ∣ n then (μ d : ℂ) * χ.primitiveCharacter n else 0 := by
    intro n
    rw [← Finset.sum_filter]
    have hfilt : q.divisors.filter (· ∣ n) = (Nat.gcd n q).divisors := by
      ext d
      simp only [Finset.mem_filter, Nat.mem_divisors, Nat.dvd_gcd_iff, ne_eq,
        Nat.gcd_eq_zero_iff, hq, and_false, not_false_eq_true, and_true]
      tauto
    rw [hfilt, ← Finset.sum_mul, sum_moebius_divisors, apply_eq_ite_primitive]
    by_cases h : n.Coprime q
    · rw [ite_eq_left h, ite_eq_left (Nat.coprime_iff_gcd_eq_one.mp h), one_mul]
    · rw [ite_eq_right h, ite_eq_right (fun h' => h (Nat.coprime_iff_gcd_eq_one.mpr h')),
        zero_mul]
  rw [Finset.sum_congr rfl (fun n _ => key n), Finset.sum_comm]
  refine Finset.sum_congr rfl fun d _ => ?_
  rw [Finset.sum_filter, Finset.mul_sum]
  simp only [mul_ite, mul_zero]

/-- The multiples of `d` in `(N, N + H]` are the `d m` with `⌊N/d⌋ < m ≤ ⌊(N + H)/d⌋`. -/
private lemma filter_dvd_Ioc {d : ℕ} (hd : 0 < d) (N H : ℕ) :
    (Ioc N (N + H)).filter (d ∣ ·) = (Ioc (N / d) ((N + H) / d)).image (d * ·) := by
  ext n
  simp only [mem_filter, mem_Ioc, mem_image]
  constructor
  · rintro ⟨⟨h1, h2⟩, ⟨m, rfl⟩⟩
    refine ⟨m, ⟨?_, ?_⟩, rfl⟩
    · rw [Nat.div_lt_iff_lt_mul hd]
      linarith [mul_comm d m]
    · rw [Nat.le_div_iff_mul_le hd]
      linarith [mul_comm d m]
  · rintro ⟨m, ⟨h1, h2⟩, rfl⟩
    refine ⟨⟨?_, ?_⟩, dvd_mul_right d m⟩
    · rw [Nat.div_lt_iff_lt_mul hd] at h1
      linarith [mul_comm d m]
    · rw [Nat.le_div_iff_mul_le hd] at h2
      linarith [mul_comm d m]

/-- `Σ_{N < n ≤ N + H, d ∣ n} ψ(n) = ψ(d) Σ_{⌊N/d⌋ < m ≤ ⌊(N + H)/d⌋} ψ(m)`. -/
private lemma sum_filter_dvd_Ioc {q : ℕ} (ψ : DirichletCharacter ℂ q) {d : ℕ} (hd : 0 < d)
    (N H : ℕ) :
    ∑ n ∈ (Ioc N (N + H)).filter (d ∣ ·), ψ n =
      ψ d * ∑ m ∈ Ioc (N / d) ((N + H) / d), ψ m := by
  rw [filter_dvd_Ioc hd, Finset.sum_image (fun a _ b _ h => Nat.eq_of_mul_eq_mul_left hd h),
    Finset.mul_sum]
  refine Finset.sum_congr rfl fun m _ => ?_
  push_cast
  exact map_mul ψ _ _

private theorem charPartialSum_eq_sum_Ioc {q : ℕ} (χ : DirichletCharacter ℂ q) (N : ℕ) :
    charPartialSum χ N = ∑ n ∈ Ioc 0 N, χ (n:ZMod q) := by
  calc
    _ = ∑ n ∈ Ico 0 N, χ ((1+n:ℕ):ZMod q) := by
      rw [charPartialSum,Nat.Ico_zero_eq_range]
      apply sum_congr rfl
      intro n _
      rw [Nat.add_comm n 1]
    _ = _ := by
      rw [Finset.sum_Ico_add (fun n : ℕ => χ (n:ZMod q)) 0 N 1]
      rw [Finset.Ico_add_one_add_one_eq_Ioc]


set_option maxHeartbeats 1050000 in
/-- The primitive initial segment estimate transfers to arbitrary common levels
for any family closed under passage to the inducing primitive character. -/
theorem nonprincipal_prefix_of_primitive_family
    (family : ∀ q : ℕ, DirichletCharacter ℂ q → Prop)
    (hFamily : ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      family q χ → family χ.conductor χ.primitiveCharacter)
    (hPrimitive : ∀ δ : ℝ, 0<δ → ∃ A : ℝ, 1≤A ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → χ.IsPrimitive → family q χ → ∀ N : ℕ,
      ‖charPartialSum χ N‖≤A*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ))
    {δ : ℝ} (hδ : 0<δ) :
    ∃ A : ℝ, 1≤A ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ≠1 → family q χ →
      ∀ N : ℕ, ‖charPartialSum χ N‖≤A*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) := by
  obtain ⟨A,hA,hP⟩ := hPrimitive (δ/2) (by positivity)
  obtain ⟨D,hD,hτ⟩ := card_divisors_le_rpow (show 0<δ/2 by positivity)
  let E := max 1 (D*A)
  refine ⟨E,le_max_left _ _,?_⟩
  intro q _ χ hχ hF N
  let ψ := χ.primitiveCharacter
  have : NeZero χ.conductor := ⟨χ.conductor_ne_zero⟩
  have hψ : ψ≠1 := by
    intro h
    apply hχ
    rw [←χ.changeLevel_primitiveCharacter]
    change DirichletCharacter.changeLevel χ.conductor_dvd_level ψ=1
    rw [h,map_one]
  have hψN : ψ.IsPrimitive := χ.primitiveCharacter_isPrimitive
  have hψF : family χ.conductor ψ := hFamily q χ hF
  have hq0 : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  have hcond : (χ.conductor:ℝ)≤q := by
    exact_mod_cast Nat.le_of_dvd (NeZero.pos q) χ.conductor_dvd_level
  let B := A*(q:ℝ)^(3/20+δ/2:ℝ)*(N:ℝ)^(3/5:ℝ)
  have hTerm (d : ℕ) (hd : d∈q.divisors) :
      ‖(moebius d:ℂ)*∑ n∈(Ioc 0 N).filter (d∣·), ψ n‖≤B := by
    have hd0 : 0<d := Nat.pos_of_mem_divisors hd
    have hμ : ‖(moebius d:ℂ)‖≤1 := by
      rw [Complex.norm_intCast]
      exact_mod_cast (abs_moebius_le_one (n:=d))
    have hψd : ‖ψ d‖≤1 := ψ.norm_le_one _
    have hP' := hP χ.conductor ψ hψ hψN hψF (N/d)
    have hFilter := sum_filter_dvd_Ioc ψ hd0 0 N
    simp only [zero_add,Nat.zero_div] at hFilter
    rw [hFilter,←charPartialSum_eq_sum_Ioc]
    calc
      _ = ‖(moebius d:ℂ)‖*(‖ψ d‖*‖charPartialSum ψ (N/d)‖) := by rw [norm_mul,norm_mul]
      _ ≤ 1*(1*‖charPartialSum ψ (N/d)‖) := by gcongr
      _ = ‖charPartialSum ψ (N/d)‖ := by simp
      _ ≤ _ := hP'.trans (by unfold B; gcongr; exact_mod_cast Nat.div_le_self N d)
  calc
    ‖charPartialSum χ N‖ =
        ‖∑ d∈q.divisors,(moebius d:ℂ)*∑ n∈(Ioc 0 N).filter (d∣·),ψ n‖ := by
      rw [charPartialSum_eq_sum_Ioc,sum_eq_sum_divisors (NeZero.ne q)]
    _ ≤ ∑ d∈q.divisors, ‖(moebius d:ℂ)*∑ n∈(Ioc 0 N).filter (d∣·),ψ n‖ := norm_sum_le _ _
    _ ≤ ∑ _∈q.divisors,B := Finset.sum_le_sum hTerm
    _ = (q.divisors.card:ℝ)*B := by simp [nsmul_eq_mul]
    _ ≤ (D*(q:ℝ)^(δ/2))*B :=
      mul_le_mul_of_nonneg_right (hτ q (NeZero.ne q)) (by unfold B; positivity)
    _ = (D*A)*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) := by
      unfold B
      have he : (q:ℝ)^(δ/2)*(q:ℝ)^(3/20+δ/2:ℝ)=(q:ℝ)^(3/20+δ:ℝ) := by
        rw [←Real.rpow_add hq0,show δ/2+(3/20+δ/2)=3/20+δ by ring]
      rw [←he]
      ring
    _ ≤ _ := by
      unfold E
      gcongr
      exact le_max_right _ _

theorem nonprincipal_prefix_of_primitive
    (hPrimitive : ∀ δ : ℝ, 0<δ → ∃ A : ℝ, 1≤A ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → χ.IsPrimitive → ∀ N : ℕ,
      ‖charPartialSum χ N‖≤A*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ))
    {δ : ℝ} (hδ : 0<δ) :
    ∃ A : ℝ, 1≤A ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ≠1 →
      ∀ N : ℕ, ‖charPartialSum χ N‖≤A*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) := by
  obtain ⟨A,hA,h⟩ :=
    nonprincipal_prefix_of_primitive_family (fun _ _=>True) (fun _ _ _ _=>trivial)
      (by
        intro e he
        obtain ⟨B,hB,h⟩ := hPrimitive e he
        exact ⟨B,hB,fun q _ χ hχ hPrim _ N=>h q χ hχ hPrim N⟩) hδ
  exact ⟨A,hA,fun q _ χ hχ N=>h q χ hχ trivial N⟩


end

end GoldbachBurgessPrefix


namespace GoldbachHybridGrowth

open Complex GoldbachGrhGrowth GoldbachBurgessPrefix

/-- Fourth moment for primitive Dirichlet characters at all positive levels. -/
def HasPrimitiveBurgessFourthMoment : Prop :=
  ∀ e : ℝ, 0<e → ∃ C : ℝ, 0<C ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ.IsPrimitive →
    ∀ B : ℕ, (∑ x : ZMod q,‖shortSum χ B x‖^4)≤
      C*(q:ℝ)^e*((q:ℝ)*(B:ℝ)^2+Real.sqrt q*(B:ℝ)^4)

/-- The direct Burgess initial segment bound at arbitrary levels, including
imprimitive common-level characters. -/
theorem nonprincipal_prefix_burgess_of_fourth_moment
    (hMoment : HasPrimitiveBurgessFourthMoment) {δ : ℝ} (hδ : 0<δ) :
    ∃ A : ℝ, 1≤A ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ≠1 →
      ∀ N : ℕ, ‖charPartialSum χ N‖≤A*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) := by
  apply nonprincipal_prefix_of_primitive _ hδ
  intro e he
  exact nonprincipal_prefix_of_fourth_moment (fun _ χ=>χ.IsPrimitive) hMoment he

/-- Near-one growth for arbitrary nonprincipal characters, with any
fixed conductor exponent above three eighths. -/
theorem nonprincipal_LFunction_uniform_strip_of_primitive_fourth_moment
    (hMoment : HasPrimitiveBurgessFourthMoment) {φ : ℝ} (hφ : 3/8 < φ) :
    ∃ A : ℝ, 1≤A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → ∀ {T : ℝ}, 0≤T → ∀ s : ℂ,
      3/4 ≤ s.re → s.re ≤ 3/2 → |s.im| ≤ T →
      ‖χ.LFunction s‖≤(prefixGrowthScale A T*(2+Real.log (prefixGrowthScale A T)+φ*Real.log (q:ℝ)))*
        (q:ℝ)^(φ*max 0 (1-s.re)) := by
  let δ := 2*φ/5-3/20
  have hδ : 0<δ := by unfold δ; linarith only [hφ]
  have hp : 0≤φ := by linarith only [hφ]
  obtain ⟨A,hA,hP⟩ := nonprincipal_prefix_burgess_of_fourth_moment hMoment hδ
  let B := A^(5/6:ℝ)
  have hB : 1≤B := Real.one_le_rpow hA (by norm_num)
  refine ⟨B,hB,?_⟩
  intro q _ χ hχ T hT
  have hQ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hPrefix : ∀ n : ℕ, ‖charPartialSum χ n‖≤B*(q:ℝ)^(φ/3)*(n:ℝ)^(2/3:ℝ) := by
    apply prefix_bound_of_three_fifths_prefix hA hQ (norm_charPartialSum_le χ)
    intro n
    have h := hP q χ hχ n
    rwa [show 3/20+δ=2*φ/5 by unfold δ; ring] at h
  intro s
  exact nonprincipal_LFunction_uniform_strip_of_two_thirds_prefix χ hχ hB hQ hp hT hPrefix (s:=s)

end GoldbachHybridGrowth


namespace GoldbachHybridGrowth

open Complex Filter
open scoped Topology

set_option maxHeartbeats 750000 in
/-- At polylogarithmic heights the prefactor in the uniform Burgess
strip bound is absorbed into a fixed power of the conductor logarithm. -/
theorem burgess_strip_polynomial_in_log_of_primitive_fourth_moment
    (hMoment : HasPrimitiveBurgessFourthMoment) {p φ : ℝ} (hp : 0≤p) (hφ : 3/8 < φ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ (χ : DirichletCharacter ℂ q), χ≠1 →
      ∀ s : ℂ, 3/4 ≤ s.re → s.re ≤ 3/2 → |s.im| ≤ L^p+1 →
      ‖χ.LFunction s‖≤L^(3*p+2:ℝ)*(q:ℝ)^(φ*max 0 (1-s.re)) := by
  have hφ₀ : 0≤φ := by linarith only [hφ]
  obtain ⟨A,hA,hStrip⟩ := nonprincipal_LFunction_uniform_strip_of_primitive_fourth_moment hMoment hφ
  let G : ℝ := 2*(72*A)^3
  let K : ℝ := 2+Real.log G+3*p+φ
  let M : ℝ := max 1 (G*K)
  have hG₁ : 1≤G := by
    unfold G
    have h : 1≤72*A := by linarith only [hA]
    linarith only [one_le_pow₀ (n:=3) h]
  have hG : 0<G := zero_lt_one.trans_le hG₁
  have hLK : 0≤2+Real.log G := by linarith only [Real.log_nonneg hG₁]
  filter_upwards [eventually_ge_atTop M] with L hL q _ hq χ hχ s hslo hshi hsT
  have hL₁ : 1≤L := (le_max_left _ _).trans hL
  have hL₀ : 0<L := zero_lt_one.trans_le hL₁
  have hLp : 1≤L^p := Real.one_le_rpow hL₁ hp
  let T := L^p+1
  let C := prefixGrowthScale A T
  have hT : 0≤T := by unfold T; positivity
  have hT' : 1+T≤3*L^p := by unfold T; linarith only [hLp]
  have hC₁ : 1≤C := by
    unfold C prefixGrowthScale
    have ht₁ : 1≤1+T := le_add_of_nonneg_right hT
    have hbase := one_le_mul_of_one_le_of_one_le ht₁ hA
    have hK : 1≤24*(1+T)*A := by linarith only [hbase]
    linarith only [one_le_pow₀ (n:=3) hK]
  have hC : 0<C := zero_lt_one.trans_le hC₁
  have hCPow : C≤G*L^(3*p:ℝ) := calc
    _ = 2*(24*(1+T)*A)^3 := rfl
    _ ≤ 2*(72*A*L^p)^3 := by
      have hh := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hT' (show 0≤A by positivity))
        (show (0:ℝ)≤24 by norm_num)
      have hbase : 24*(1+T)*A≤72*A*L^p := by nlinarith only [hh]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hbase 3) (by norm_num)
    _ = _ := by
      unfold G
      rw [mul_pow,←Real.rpow_mul_natCast hL₀.le]
      norm_num only [Nat.cast_ofNat]
      rw [show p*3=3*p by ring]
      ring
  have hLogC := Real.log_le_log hC hCPow
  rw [Real.log_mul hG.ne' (Real.rpow_pos_of_pos hL₀ _).ne',Real.log_rpow hL₀] at hLogC
  have hLogL : Real.log L≤L := (Real.log_le_sub_one_of_pos hL₀).trans (by linarith)
  have hB : 2+Real.log C+φ*Real.log (q:ℝ)≤K*L := by
    have hb₀ := le_mul_of_one_le_right hLK hL₁
    have hb₁ := mul_le_mul_of_nonneg_left hLogL (by positivity : 0≤3*p)
    have hb₂ := mul_le_mul_of_nonneg_left hq hφ₀
    unfold K
    linarith only [hLogC,hb₀,hb₁,hb₂]
  have hq₁ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hNon : 0≤2+Real.log C+φ*Real.log (q:ℝ) :=
    (add_nonneg) (add_nonneg (by norm_num) (Real.log_nonneg hC₁))
      (mul_nonneg hφ₀ (Real.log_nonneg hq₁))
  have hKL : G*K≤L := (le_max_right _ _).trans hL
  have hGrowth : C*(2+Real.log C+φ*Real.log (q:ℝ))≤L^(3*p+2:ℝ) := calc
    _ ≤ (G*L^(3*p:ℝ))*(K*L) := mul_le_mul hCPow hB hNon (by positivity)
    _ = (G*K)*(L^(3*p:ℝ)*L) := by ring
    _ ≤ L*(L^(3*p:ℝ)*L) := mul_le_mul_of_nonneg_right hKL (by positivity)
    _ = L^(3*p:ℝ)*L^(2:ℝ) := by rw [Real.rpow_ofNat]; ring
    _ = _ := by rw [←Real.rpow_add hL₀]
  have ht := hStrip q χ hχ hT s hslo hshi hsT
  exact ht.trans (mul_le_mul_of_nonneg_right hGrowth (by positivity))

end GoldbachHybridGrowth
end

