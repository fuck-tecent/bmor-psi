      · exact hlog
      · exact hl0
      · positivity
    _ = (2 * K * (Real.log Q + 5)) * Real.exp ((3 / 2) * s) := by
      rw [show (3 / 2 : ℝ) * s = s + s / 2 by ring, Real.exp_add]
      ring
set_option maxHeartbeats 1000000 in
