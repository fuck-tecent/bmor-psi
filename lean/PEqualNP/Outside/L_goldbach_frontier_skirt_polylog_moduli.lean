theorem V1jw (Q : ℕ) (hQ : 1≤Q)
    (X y h T : ℝ) (hX : 1≤X) (hy : X≤y) (hy2 : y≤2*X)
    (hh : 0≤h) (hhX : h≤X) (hT : 2≤T)
    (F : Finset PrimitiveComplexCharacter) (hF : ∀ χ∈F, χ.modulus≤Q)
