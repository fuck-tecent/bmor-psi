namespace GoldbachSieveSeries

open Finset Complex

noncomputable section

def lcmPolynomial {q : ℕ} (χ : DirichletCharacter ℂ q) (D E : Finset ℕ)
    (u v : ℕ → ℂ) (s : ℂ) : ℂ :=
  ∑ d ∈ D, ∑ e ∈ E, (u d * v e) * LSeries.term (fun n : ℕ => χ n) s (d.lcm e)

theorem lcmPolynomial_eq {q : ℕ} (χ : DirichletCharacter ℂ q) (D E : Finset ℕ)
    (u v : ℕ → ℂ) (s : ℂ) :
    lcmPolynomial χ D E u v s =
      ∑ r ∈ lcmSupport D E, LSeries.term ((fun n : ℕ => χ n) * lcmWeight D E u v) s r := by
  have ht (r : ℕ) :
      LSeries.term ((fun n : ℕ => χ n) * lcmWeight D E u v) s r =
        lcmWeight D E u v r * LSeries.term (fun n : ℕ => χ n) s r := by
    by_cases hr : r = 0
    · simp [hr]
    · simp only [LSeries.term_of_ne_zero hr, Pi.mul_apply]
      ring
  simp only [ht, lcmWeight, sum_mul]
  unfold lcmPolynomial
  symm
  rw [sum_comm]
  apply sum_congr rfl
  intro d hd
  rw [sum_comm]
  apply sum_congr rfl
  intro e he
  have hmem : d.lcm e ∈ lcmSupport D E :=
    mem_image.mpr ⟨(d,e),mem_product.mpr ⟨hd,he⟩,rfl⟩
  simp only [ite_mul, zero_mul, sum_ite_eq, hmem, ite_true]

theorem differentiable_lcmPolynomial {q : ℕ} (χ : DirichletCharacter ℂ q) (D E : Finset ℕ)
    (u v : ℕ → ℂ) : Differentiable ℂ (lcmPolynomial χ D E u v) := by
  unfold lcmPolynomial
  apply Differentiable.fun_sum
  intro d _
  apply Differentiable.fun_sum
  intro e _
  by_cases h : d.lcm e = 0
  · simp [h]
  · simp only [LSeries.term_of_ne_zero h, div_eq_mul_inv]
    have hC : Differentiable ℂ (fun s : ℂ => ((d.lcm e : ℕ) : ℂ)^s) :=
      differentiable_id.const_cpow (Or.inl (Nat.cast_ne_zero.mpr h))
    exact (hC.inv (fun _ => cpow_ne_zero_iff.mpr (Or.inl (Nat.cast_ne_zero.mpr h)))).const_mul _ |>.const_mul _

theorem norm_term_dirichlet_le_inv_sqrt {q : ℕ} (χ : DirichletCharacter ℂ q) {s : ℂ}
    (hs : 1/2 ≤ s.re) (n : ℕ) :
    ‖LSeries.term (fun n : ℕ => χ n) s n‖ ≤ 1/Real.sqrt (n:ℝ) := by
  by_cases hn : n = 0
  · simp [hn]
  have hn1 : (1:ℝ) ≤ n := by exact_mod_cast Nat.pos_of_ne_zero hn
  rw [LSeries.norm_term_eq, ite_eq_right hn, Real.sqrt_eq_rpow]
  exact div_le_div₀ (by norm_num) (χ.norm_le_one n) (by positivity)
    (Real.rpow_le_rpow_of_exponent_le hn1 hs)

theorem norm_lcmPolynomial_le {q : ℕ} (χ : DirichletCharacter ℂ q) (D E : ℕ)
    (u v : ℕ → ℂ) {s : ℂ} (hs : 1/2 ≤ s.re)
    (hu : ∀ d ∈ Icc 1 D, ‖u d‖ ≤ 1) (hv : ∀ e ∈ Icc 1 E, ‖v e‖ ≤ 1) :
    ‖lcmPolynomial χ (Icc 1 D) (Icc 1 E) u v s‖ ≤ 12*Real.sqrt (D:ℝ)*Real.sqrt (E:ℝ) := by
  unfold lcmPolynomial
  refine (norm_sum_le _ _).trans ((sum_le_sum ?_).trans (lcm_inverse_sqrt_mass D E))
  intro d hd
  refine (norm_sum_le _ _).trans (sum_le_sum (fun e he => ?_))
  rw [norm_mul, norm_mul]
  have hprod : ‖u d‖ * ‖v e‖ ≤ 1 := by
    simpa only [mul_one] using mul_le_mul (hu d hd) (hv e he) (norm_nonneg _) (zero_le_one : (0:ℝ) ≤ 1)
  exact (mul_le_of_le_one_left (norm_nonneg _) hprod).trans (norm_term_dirichlet_le_inv_sqrt χ hs _)

end
end GoldbachSieveSeries

