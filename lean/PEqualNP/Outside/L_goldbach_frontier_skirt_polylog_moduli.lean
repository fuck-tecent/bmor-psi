    filter_upwards [heB,heQ,heL,eventually_ge_atTop (2:ℝ)] with X hB hPoly hL hX
    intro Q h hQ hQupper hh hscale
    have hX1 : 1≤X := by linarith
    have hXp : 0<X := by linarith
    have hδ1 : 1≤X^(1/12:ℝ) := Real.one_le_rpow hX1 (by norm_num)
    have hδX : X^(1/12:ℝ)≤X := by
      simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hX1
