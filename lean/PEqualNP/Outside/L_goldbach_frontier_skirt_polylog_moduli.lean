  rw [← V94 s hd, one_div] at hb
  have hc : ‖s‖ / s.re ≤ 4 * ‖s‖ := by
    apply (div_le_iff₀ (show 0 < s.re by linarith)).mpr
    nlinarith [norm_nonneg s]
  linarith
end OAI.Ostmann
