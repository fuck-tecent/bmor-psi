section
namespace GoldbachBurgessPrimePower

open Finset Polynomial
open MathlibNt.AnalyticNumberTheory.LargeSieve.LiLiuPrereqFouvry
open scoped Classical

noncomputable section

variable {q : ℕ}

def rationalValue (χ : DirichletCharacter ℂ q) (f g : (ZMod q)[X]) (x : ZMod q) : ℂ :=
  χ (f.eval x)*(χ⁻¹) (g.eval x)

def logarithmicSlope (f g : (ZMod q)[X]) (x : ZMod q) : ZMod q :=
  f.derivative.eval x*(f.eval x)⁻¹ - g.derivative.eval x*(g.eval x)⁻¹


private theorem mul_sq_eq_zero (a t : ZMod q) (ht : t^2=0) : (a*t)^2=0 := by
  rw [mul_pow,ht,mul_zero]


private theorem eval_add_eq_eval_mul (F : (ZMod q)[X]) {x t : ZMod q} (ht : t^2=0)
    (hu : IsUnit (F.eval x)) :
    F.eval (x+t) = F.eval x * (1+t*(F.derivative.eval x*(F.eval x)⁻¹)) := by
  rw [Polynomial.eval_add_of_sq_eq_zero _ _ _ ht]
  have hi := ZMod.mul_inv_of_unit _ hu
  linear_combination (-t*F.derivative.eval x)*hi

private theorem invChar_one_add (χ : DirichletCharacter ℂ q) {s : ZMod q} (hs : s^2=0) :
    χ⁻¹ (1+s) = χ (1-s) := by
  rw [MulChar.inv_apply_eq_inv']
  apply inv_eq_of_mul_eq_one_right
  rw [← map_mul]
  have h : (1+s)*(1-s)=1 := by linear_combination -hs
  rw [h,map_one]

theorem rationalValue_sqzero_shift (χ : DirichletCharacter ℂ q) (f g : (ZMod q)[X])
    {x t : ZMod q} (ht : t^2=0) (hf : IsUnit (f.eval x)) (hg : IsUnit (g.eval x)) :
    rationalValue χ f g (x+t) = χ (1+t*logarithmicSlope f g x)*rationalValue χ f g x := by
  rw [rationalValue, eval_add_eq_eval_mul f ht hf, eval_add_eq_eval_mul g ht hg, map_mul, map_mul]
  have hs : (t*(g.derivative.eval x*(g.eval x)⁻¹))^2=0 := by
    rw [mul_comm t]
    exact mul_sq_eq_zero _ _ ht
  rw [invChar_one_add χ hs]
  have he : (1+t*(f.derivative.eval x*(f.eval x)⁻¹))*
      (1-t*(g.derivative.eval x*(g.eval x)⁻¹)) = 1+t*logarithmicSlope f g x := by
    unfold logarithmicSlope
    linear_combination -(f.derivative.eval x*(f.eval x)⁻¹)*(g.derivative.eval x*(g.eval x)⁻¹)*ht
  rw [←he,map_mul,rationalValue]
  ring


end
end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open DirichletCharacter

theorem linear_pow_of_square_zero {R : Type*} [CommRing R] (t : R) (ht : t^2=0) (m : ℕ) :
    (1+t)^m = 1+t*(m:R) := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ,ih,Nat.cast_succ]
    linear_combination (m:R)*ht

private theorem pow_natCast_eq_zero_of_le {p r s : ℕ} (h : s≤r) :
    (((p^r:ℕ):ZMod (p^s)))=0 := by
  rw [← Nat.cast_zero,ZMod.natCast_eq_natCast_iff,Nat.modEq_zero_iff_dvd]
  exact Nat.pow_dvd_pow p h

private theorem top_layer_sqzero (p k : ℕ) (hk : 0<k) :
    ((((p^k:ℕ):ZMod (p^(k+1))))^2)=0 := by
  rw [←Nat.cast_pow,←pow_mul]
  exact pow_natCast_eq_zero_of_le (by omega : k+1≤k*2)

/-- A primitive character must be nontrivial on the generator of the
last square-zero principal-unit layer. -/
theorem primitive_last_layer_ne_one {p k : ℕ} (hp : p.Prime) (hk : 0<k)
    (χ : DirichletCharacter ℂ (p^(k+1))) (hχ : χ.IsPrimitive) :
    χ (1+((p^k:ℕ):ZMod (p^(k+1)))) ≠ 1 := by
  classical
  let _ : NeZero (p^k) := ⟨pow_ne_zero _ hp.ne_zero⟩
  let _ : NeZero (p^(k+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  intro h
  have hd : p^k∣p^(k+1) := Nat.pow_dvd_pow p (by omega)
  have H : χ.FactorsThrough (p^k) := by
    apply (factorsThrough_iff_ker_unitsMap hd).mpr
    intro u hu
    have huc : (ZMod.unitsMap hd u : ZMod (p^k))=1 := by
      rw [MonoidHom.mem_ker] at hu
      rw [hu,Units.val_one]
    let n := (u:ZMod (p^(k+1))).val
    have hn : (n:ZMod (p^k))=1 := by
      rw [ZMod.unitsMap_val,←ZMod.natCast_zmod_val (u:ZMod (p^(k+1))),ZMod.cast_natCast hd] at huc
      exact huc
    have hpk : 1<p^k := Nat.one_lt_pow (Nat.ne_of_gt hk) hp.one_lt
    have hm := (ZMod.natCast_eq_natCast_iff' n 1 (p^k)).mp (by simpa only [Nat.cast_one] using hn)
    rw [Nat.mod_eq_of_lt hpk] at hm
    have he : n=1+p^k*(n/p^k) := by
      rw [←hm]
      exact (Nat.mod_add_div n (p^k)).symm
    have huv : (u:ZMod (p^(k+1))) = 1+(((p^k:ℕ):ZMod (p^(k+1))))*((n/p^k:ℕ):ZMod (p^(k+1))) := by
      calc
        _ = (n:ZMod (p^(k+1))) := (ZMod.natCast_zmod_val _).symm
        _ = _ := by
          simpa only [Nat.cast_add,Nat.cast_one,Nat.cast_mul] using
            congrArg (fun v : ℕ => (v:ZMod (p^(k+1)))) he
    change χ.toUnitHom u=1
    apply Units.val_injective
    rw [MulChar.coe_toUnitHom,Units.val_one,huv,←linear_pow_of_square_zero _ (top_layer_sqzero p k hk),map_pow,h,one_pow]
  have hdiv := conductor_dvd_of_mem_conductorSet χ H
  rw [hχ] at hdiv
  exact (not_le_of_gt (Nat.pow_lt_pow_right hp.one_lt (by omega : k<k+1)))
    (Nat.le_of_dvd (pow_pos hp.pos _) hdiv)

/-- On a square-zero principal-unit layer of prime-power modulus, the
primitive character detects exactly whether the reduced slope is zero. -/
theorem primitive_sqzero_phase_eq_one_iff {p a b : ℕ} (hp : p.Prime) (hb : 0<b) (hab : b≤a)
    (χ : DirichletCharacter ℂ (p^(a+b))) (hχ : χ.IsPrimitive) (z : ZMod (p^(a+b))) :
    χ (1+(((p^a:ℕ):ZMod (p^(a+b))))*z)=1 ↔ p^b∣z.val := by
  classical
  let _ : NeZero (p^(a+b)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  let R := ZMod (p^(a+b))
  let t : R := ((p^a:ℕ):R)
  have ht : t^2=0 := by
    dsimp only [R,t]
    rw [←Nat.cast_pow,←pow_mul]
    exact pow_natCast_eq_zero_of_le (by omega : a+b≤a*2)
  have hv : IsUnit ((1:R)+t) := (IsNilpotent.isUnit_one_add ⟨2,ht⟩)
  let u := hv.unit
  let e : ℂˣ := χ.toUnitHom u
  have hE (n : ℕ) : (↑(e^n):ℂ)=χ (1+t*(n:R)) := by
    rw [Units.val_pow_eq_pow_val,show (e:ℂ)=χ (1+t) by
      dsimp only [e,u]; rw [MulChar.coe_toUnitHom,hv.unit_spec],←map_pow,
      linear_pow_of_square_zero _ ht]
  have hPow : e^(p^b)=1 := by
    apply Units.val_injective
    rw [hE,Units.val_one]
    have hzero : t*((p^b:ℕ):R)=0 := by
      dsimp only [t,R]
      rw [←Nat.cast_mul,←pow_add,ZMod.natCast_self]
    rw [hzero,add_zero,map_one]
  have hNe : e^(p^(b-1))≠1 := by
    intro h
    let k := a+(b-1)
    have he : k+1=a+b := by dsimp only [k]; omega
    have hk : 0<k := by dsimp only [k]; omega
    have hh := primitive_last_layer_ne_one hp hk
    rw [he] at hh
    have hLast : χ (1+((p^k:ℕ):R))≠1 := hh χ hχ
    have hx := congrArg (fun z : ℂˣ => (z:ℂ)) h
    rw [hE,Units.val_one] at hx
    have ht' : t*((p^(b-1):ℕ):R)=((p^k:ℕ):R) := by
      dsimp only [t,k]
      rw [←Nat.cast_mul,←pow_add]
    rw [ht'] at hx
    exact hLast hx
  have hOrd : orderOf e = p^b := by
    obtain ⟨j,hj,hej⟩ := (Nat.dvd_prime_pow hp).mp (orderOf_dvd_of_pow_eq_one hPow)
    by_cases h : j=b
    · simpa only [h] using hej
    · exact (hNe (orderOf_dvd_iff_pow_eq_one.mp (hej ▸ Nat.pow_dvd_pow p (by omega : j≤b-1)))).elim
  change χ (1+t*z)=1 ↔ p^b∣z.val
  conv_lhs => rw [←ZMod.natCast_zmod_val z,←hE]
  constructor
  · intro h
    rw [←hOrd]
    exact orderOf_dvd_of_pow_eq_one (Units.val_injective (by simpa only [Units.val_one] using h))
  · intro h
    have hpow := orderOf_dvd_iff_pow_eq_one.mp (show orderOf e∣z.val from hOrd.symm ▸ h)
    simpa only [Units.val_one] using congrArg (fun w : ℂˣ => (w:ℂ)) hpow

end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgessPrimePower

open Finset

private theorem zmod_finEquiv_natCast (n : ℕ) [NeZero n] (i : Fin n) :
    ZMod.finEquiv n i = ((i:ℕ):ZMod n) := by
  apply ZMod.val_injective n
  rw [ZMod.val_natCast_of_lt i.isLt]
  cases n with
  | zero => exact (NeZero.ne 0 rfl).elim
  | succ n => rfl

/-- Mixed-radix expansion of a finite sum. `u` is the least residue and
`v` is the independent second digit, even when the moduli are not coprime. -/
theorem sum_zmod_digits {s t : ℕ} [NeZero (s*t)] {M : Type*} [AddCommMonoid M]
    (F : ZMod (s*t) → M) :
    (∑ x : ZMod (s*t), F x) =
      ∑ u : Fin t, ∑ v : Fin s, F (((u:ℕ):ZMod (s*t))+((t:ℕ):ZMod (s*t))*((v:ℕ):ZMod (s*t))) := by
  let e : Fin s × Fin t ≃ ZMod (s*t) :=
    finProdFinEquiv.trans (ZMod.finEquiv (s*t)).toEquiv
  calc
    _ = ∑ z : Fin s × Fin t, F (e z) := (Equiv.sum_comp e F).symm
    _ = _ := by
      rw [Fintype.sum_prod_type,Finset.sum_comm]
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      change F (ZMod.finEquiv (s*t) (finProdFinEquiv (v,u))) = _
      rw [zmod_finEquiv_natCast,finProdFinEquiv_apply_val,Nat.cast_add,Nat.cast_mul]

theorem sum_zmod_digits_of_eq {q s t : ℕ} [NeZero q] {M : Type*} [AddCommMonoid M]
    (h : q=s*t) (F : ZMod q → M) :
    (∑ x : ZMod q, F x) =
      ∑ u : Fin t, ∑ v : Fin s, F (((u:ℕ):ZMod q)+((t:ℕ):ZMod q)*((v:ℕ):ZMod q)) := by
  subst q
  exact sum_zmod_digits F

theorem zmod_castHom_eq_zero_iff_dvd_val {m n : ℕ} [NeZero n] (h : m∣n) (z : ZMod n) :
    ZMod.castHom h (ZMod m) z=0 ↔ m∣z.val := by
  conv_lhs => rw [←ZMod.natCast_zmod_val z,map_natCast]
  exact ZMod.natCast_eq_zero_iff _ _

end GoldbachBurgessPrimePower
end

