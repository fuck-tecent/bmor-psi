theorem differenceWeight_one_le {Y U : ℝ} (hU : 1≤U) (hUY : U≤Y) :
    differenceWeight Y U 1≤2/U := by
  have hU₀ := zero_lt_one.trans_le hU
  have hY := hU.trans hUY
  have hY₀ := zero_lt_one.trans_le hY
  have hu : 0≤1-(1:ℝ)/U := sub_nonneg.mpr ((div_le_one hU₀).mpr hU)
  have hy : 0≤1-(1:ℝ)/Y := sub_nonneg.mpr ((div_le_one hY₀).mpr hY)
  change (max (1-(1:ℝ)/Y) 0)^2-(max (1-(1:ℝ)/U) 0)^2≤2/U
  rw [max_eq_left hu,max_eq_left hy]
  have hy₁ : 1-(1:ℝ)/Y≤1 := sub_le_self _ (by positivity)
  have hy₂ := pow_le_pow_left₀ hy hy₁ 2
  rw [show (2:ℝ)/U=2*(1/U) by ring]
  nlinarith only [hy₂,sq_nonneg ((1:ℝ)/U)]


end
