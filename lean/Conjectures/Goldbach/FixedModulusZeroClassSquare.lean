set_option maxHeartbeats 1300000 in
/-- Principal finite exponential test with uniform error at polylogarithmic
heights and the actual exact pole. -/
theorem exponential_prime_principal_upper_eventually {ι : Type*}
    (S : Finset ι) (a b : ι→ℝ) {ε K p b₀ C₀ : ℝ}
    (hε : 0<ε) (hb₀ : 0<b₀) (hC₀ : 0≤ C₀) (hK : 0≤ K) (hp : 0≤ p)
    (hb : ∀ i∈S,b₀≤ b i ∧ b i≤b₀+C₀) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (s : ℂ),
      Real.log (q:ℝ)≤ L → 1-K/L≤ s.re → s.re≤1 → |s.im|≤ L^p →
      1<s.re+b₀/L →
      (exponentialPrimeTest S a b (1:DirichletCharacter ℂ q) L s).re≤
        L*(exponentialAutoTransform S a b ((L:ℂ)*(s-1))).re+ε*L := by
  obtain ⟨A,hA,hP⟩ := exponential_prime_principal_upper_with_left_zeros S a b
    (fun i hi=>hb₀.trans_le (hb i hi).1)
  let J : ℝ := ∑ i∈S,|exponentialAutoCoeff S a b i|
  let C := max 1 J
  have hJ : 0≤ J := Finset.sum_nonneg (fun _ _=>abs_nonneg _)
  have hC : 0<C := zero_lt_one.trans_le (le_max_left _ _)
  have hCJ : J≤ C := le_max_right _ _
  have hdec : Tendsto (fun n : ℕ=>(n:ℝ)^(-(1/2):ℝ)) atTop (𝓝 0) :=
    (tendsto_rpow_neg_atTop (show (0:ℝ)<1/2 by norm_num)).comp
      tendsto_natCast_atTop_atTop
  obtain ⟨L₀,hL₀,hD⟩ := decaying_bad_prime_log_mass_small
    (fun n=>Real.rpow_nonneg (Nat.cast_nonneg n) _) hdec (show 0<ε/(8*C) by positivity)
  have hzeta := Real.tendsto_exp_atTop.eventually
    (GoldbachPrincipalPintz.zeta_near_zero_height_eventually
      (show (0:ℝ)<1 by norm_num) (show 0≤p+2 by positivity))
  have hlog := Real.isLittleO_log_id_atTop.def (show 0<ε/(4*C*A*(p+1)) by positivity)
  have hlarge := eventually_ge_atTop (max (max 2 L₀) (max (4*(b₀+C₀)) (4*C*A*Real.log 6/ε)))
  have hloglarge := Real.tendsto_log_atTop.eventually_ge_atTop (max 1 K)
  filter_upwards [hzeta,hlog,hlarge,hloglarge] with L hZ hLo hL' hLL q _ s hq hsLo hsHi ht hs
  rw [Real.log_exp] at hZ
  have hL2 : 2≤L := (le_max_left _ _).trans ((le_max_left _ _).trans hL')
  have hL1 : 1≤L := (by norm_num : (1:ℝ)≤2).trans hL2
  have hL : 0<L := zero_lt_one.trans_le hL1
  have hL₀' : L₀≤L := (le_max_right _ _).trans ((le_max_left _ _).trans hL')
  have hW : 4*(b₀+C₀)≤L := (le_max_left _ _).trans ((le_max_right _ _).trans hL')
  have hE : 4*C*A*Real.log 6/ε≤L := (le_max_right _ _).trans ((le_max_right _ _).trans hL')
  have hℓ₁ : 1≤Real.log L := (le_max_left _ _).trans hLL
  have hℓK : K≤Real.log L := (le_max_right _ _).trans hLL
  have hℓ : 0≤Real.log L := zero_le_one.trans hℓ₁
  have hPow : 1≤L^p := Real.one_le_rpow hL1 hp
  have hShift (i : ι) (hi : i∈S) : 1<s.re+b i/L ∧ s.re+b i/L≤1+1/4 := by
    constructor
    · exact hs.trans_le (add_le_add_right (div_le_div_of_nonneg_right (hb i hi).1 hL.le) _)
    · have hh : b i/L≤1/4 := (div_le_iff₀ hL).mpr (by linarith only [hW,(hb i hi).2])
      linarith only [hsHi,hh]
  have hZero (ρ : ℂ) (hρ : regularizedL (1:DirichletCharacter ℂ 1) ρ=0)
      (hρI : |ρ.im-s.im|≤2) : ρ.re≤ s.re := by
    by_contra! hρR
    have hgap : 1-ρ.re < 1*Real.log L/L := by
      rw [one_mul]
      have h := div_le_div_of_nonneg_right hℓK hL.le
      linarith only [hρR,hsLo,h]
    have hAbs : |ρ.im|≤L^p+2 := by
      have hh := abs_add_le (ρ.im-s.im) s.im
      rw [sub_add_cancel] at hh
      linarith only [hh,hρI,ht]
    have hPow2 : L^p+2≤L^(p+2) := by
      rw [Real.rpow_add hL,Real.rpow_ofNat]
      have hh := pow_le_pow_left₀ (by norm_num : (0:ℝ)≤2) hL2 2
      have hh' := mul_le_mul_of_nonneg_left hh (Real.rpow_nonneg hL.le p)
      nlinarith only [hh',hPow]
    exact (not_lt_of_ge (hAbs.trans hPow2)) (hZ ρ hρ hgap)
  have hLogHeight : logHeight 1 s.im ≤ Real.log 6 + p*Real.log L := by
    change Real.log ((2:ℝ)*(1:ℕ)*(2+|s.im|))≤_
    calc
      _ ≤ Real.log (6*L^p) := by
        apply Real.log_le_log (by positivity)
        norm_num
        nlinarith only [ht,hPow]
      _ = _ := by rw [Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hL p).ne',
        Real.log_rpow hL]
  have hLo' : Real.log L ≤ (ε/(4*C*A*(p+1)))*L := by
    simpa [id,Real.norm_eq_abs,abs_of_nonneg hℓ,abs_of_pos hL] using hLo
  have hPrim := hP q hL hShift hZero
  have hLogError : C*A*logHeight 1 s.im≤ε*L/2 := by
    have he := (div_le_iff₀ hε).mp hE
    have hP' : C*A*p*Real.log L≤ε*L/4 := calc
      _ ≤ C*A*(p+1)*Real.log L := by
        have h1 := mul_nonneg (mul_nonneg hC.le hA.le) hℓ
        nlinarith only [h1]
      _ ≤ C*A*(p+1)*((ε/(4*C*A*(p+1)))*L) :=
        mul_le_mul_of_nonneg_left hLo' (by positivity)
      _ = _ := by field_simp [hC.ne',hA.ne',show p+1≠0 by positivity]
    have hH' := mul_le_mul_of_nonneg_left hLogHeight (mul_nonneg hC.le hA.le)
    nlinarith only [he,hP',hH']
  have hMass := hD q L (NeZero.ne q) hL₀' hq
  have hMass' := mul_le_mul_of_nonneg_left hMass (show 0≤C*4 by positivity)
  have hMass'' : C*4*((ε/(8*C))*L)=ε*L/2 := by field_simp [hC.ne']; ring
  rw [hMass''] at hMass'
  have hErr :
      J*(A*logHeight 1 s.im+4*∑ p∈q.primeFactors,Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ))≤ε*L := by
    calc
      _ ≤ C*(A*logHeight 1 s.im+4*∑ p∈q.primeFactors,Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ)) :=
        mul_le_mul_of_nonneg_right hCJ (add_nonneg
          (mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one 1 s.im)))
          (by
            apply mul_nonneg (by norm_num)
            exact Finset.sum_nonneg (fun p _=>mul_nonneg (Real.log_natCast_nonneg p) (by positivity))))
      _ ≤ _ := by nlinarith only [hMass',hLogError]
  linarith only [hPrim,hErr]

end

end GoldbachPintzWeightedFormula
end

