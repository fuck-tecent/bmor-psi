      (by simpa only [mul_comm] using (div_lt_iff₀ (by positivity : 0<(count:ℝ)+1)).1 hN)
  filter_upwards [census_class_tag_bounds_eventually (φ:=47/125) (U:=U) K
    hb ha hba hHigh hCap (by norm_num) hΔ hm hJ] with q hM
  intro _ R hR hRU hClean hLead T hT hClass
  have h := (hM R hR hRU hClean hLead _ ((filter_subset _ T).trans hT)
    (fun _ ht=>(mem_filter.mp ht).2)
    (fun t ht u hu=>hClass t (mem_filter.mp ht).1 u (mem_filter.mp hu).1)).1
  apply Nat.lt_succ_iff.mp
  exact_mod_cast h

theorem census_376_low_class_counts_eventually {H U : ℝ} (K : ℕ) (hH : (0.226:ℝ)≤H) :
