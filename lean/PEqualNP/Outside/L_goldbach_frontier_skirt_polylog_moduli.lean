variable {q : ℕ} [NeZero q]
noncomputable def V1a (r t : ℝ) (z : ℂ) : ℂ :=
  ((1 + 2 * r : ℝ) : ℂ) + Complex.I * (t : ℂ) + ((3 * r : ℝ) : ℂ) * z
