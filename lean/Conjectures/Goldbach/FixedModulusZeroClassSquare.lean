set_option maxHeartbeats 1100000 in
/-- The analytic remainder on a fixed disk centered on the line one, with
an exact resolvent expansion and a conductor-height bound on its norm. -/
theorem local_analytic_remainder_with_principal_pole :
    ∃ A : ℝ, 0<A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      ∀ t : ℝ, ∃ Z : Finset ℂ, ∃ G : ℂ→ℂ,
      (∀ ρ∈Z, regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ |ρ.im-t|≤2) ∧
      (∑ ρ∈Z,(analyticOrderNatAt (regularizedL χ) ρ:ℝ))≤A*logHeight q t ∧
      AnalyticOnNhd ℂ G (closedBall (line 1 t) (1/4)) ∧
      (∀ w∈closedBall (line 1 t) (1/4), ‖G w‖≤A*logHeight q t) ∧
      (∀ w∈closedBall (line 1 t) (1/4), 1<w.re →
        -logDeriv χ.LFunction w=G w+principalFlag χ/(w-1)-
          ∑ ρ∈Z,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)/(w-ρ)) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 t‖≤1/2 → regularizedL χ ρ=0 → ρ∈Z) := by
  let R : ℝ := 15/8
  let A : ℝ := 130200/R
  let D : ℝ := (Real.log (12/11 : ℝ))⁻¹
  have hR : 0<R := by norm_num [R]
  have hA : 0<A := by dsimp [A]; positivity
  have hD : 0<D := inv_pos.mpr (Real.log_pos (by norm_num))
  refine ⟨13*(A+D),by positivity,?_⟩
  intro q _ χ t
  let f := regularizedL χ
  let c := line 2 t
  let K : ℝ := 2+|t|
  let B : ℝ := 900*(q:ℝ)*K^2
  have hq1 : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hq0 : (0:ℝ)<q := zero_lt_one.trans_le hq1
  have hK2 : 2≤K := le_add_of_nonneg_right (abs_nonneg t)
  have hK1 : 1≤K := by linarith only [hK2]
  have hK0 : 0<K := zero_lt_one.trans_le hK1
  have hB0 : 0<B := by dsimp [B]; positivity
  have hB2 : 2≤B := by
    calc
      (2:ℝ) ≤ 900*1*1 := by norm_num
      _ ≤ B := mul_le_mul (mul_le_mul_of_nonneg_left hq1 (by norm_num))
        (one_le_pow₀ hK1) zero_le_one (by positivity)
  have hReLower (w : ℂ) (hw : w∈closedBall c R) : (1/8:ℝ)≤w.re := by
    have hd := mem_closedBall_iff_norm.mp hw
    have hre := Complex.abs_re_le_norm (w-c)
    rw [Complex.sub_re,show c.re=2 by simp [c,line,Complex.mul_re]] at hre
    dsimp only [R] at hd
    linarith only [hre,hd,neg_le_abs (w.re-2)]
  have hcform : c=(2:ℂ)+(t:ℂ)*I := by apply Complex.ext <;> simp [c,line,Complex.mul_re,Complex.mul_im]
  have hcnorm : ‖c‖≤K := by
    rw [hcform]
    exact (norm_add_le _ _).trans_eq (by simp [K,Complex.norm_real,Real.norm_eq_abs])
  have hcEuclidean : c=(⟨2,t⟩:ℂ) := by
    apply Complex.ext <;> simp [c,line,Complex.mul_re,Complex.mul_im]
  have hAnchor : (1/4:ℝ)≤‖f c‖ := by
    rw [hcEuclidean]
    exact norm_regularizedL_anchor χ t
  have hf0 : f c≠0 := norm_pos_iff.mp ((by norm_num : (0:ℝ)<1/4).trans_le hAnchor)
  have hf : AnalyticOnNhd ℂ f (closedBall c R) := (analytic_regularizedL χ).mono (subset_univ _)
  have hfB (w : ℂ) (hw : w∈closedBall c (24/25*R)) : ‖f w‖≤B*‖f c‖ := by
    have hwBig := closedBall_subset_closedBall (show (24/25:ℝ)*R≤R by norm_num [R]) hw
    have hd := mem_closedBall_iff_norm.mp hwBig
    have hn : 1+‖w‖≤3*K := by
      dsimp only [R] at hd
      linarith only [norm_le_norm_sub_add w c,hd,hcnorm,hK2]
    have hh : ‖f w‖≤25*(q:ℝ)*(1+‖w‖)^2 := by
      have hg := GoldbachGrhGrowth.norm_regularizedLFunction_le χ (hReLower w hwBig)
      by_cases hχ : χ=1 <;> simpa only [f,regularizedL,hχ,ite_true,ite_false] using hg
    calc
      _ ≤ 25*(q:ℝ)*(1+‖w‖)^2 := hh
      _ ≤ 25*(q:ℝ)*(3*K)^2 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hn 2) (by positivity)
      _ = B*(1/4:ℝ) := by dsimp [B]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hAnchor hB0.le
  obtain ⟨Z,hZ,hCount,hApprox⟩ := GoldbachGrhLogDerivative.logDeriv_partial_fraction_disk hR hf hf0 hB2 hfB
  let U := closedBall c (22/25*R)
  have hZU (ρ : ℂ) : ρ∈Z ↔ ρ∈U ∧ f ρ=0 := by
    change ρ∈(↑Z:Set ℂ) ↔ _
    rw [hZ]
    rfl
  have hcU : c∈U := mem_closedBall_self (by positivity)
  have hUc : IsConnected U := Metric.isConnected_closedBall (by positivity)
  have hfU : AnalyticOnNhd ℂ f U :=
    hf.mono (closedBall_subset_closedBall (by norm_num [R]))
  have hm : MeromorphicOn f U := hfU.meromorphicOn
  have hOrd0 := (hfU c hcU).meromorphicNFAt.meromorphicOrderAt_eq_zero_iff.mpr hf0
  have ho (p : ℂ) (hp : p∈Z) : analyticOrderAt f p≠⊤ := by
    have hpU := ((hZU p).mp hp).1
    have hgen := (hm.exists_meromorphicOrderAt_ne_top_iff_forall hUc).mp ⟨⟨c,hcU⟩,by simp [hOrd0]⟩ ⟨p,hpU⟩
    intro hh
    apply hgen
    rw [(hfU p hpU).meromorphicOrderAt_eq,hh,ENat.map_top]
  obtain ⟨G,hGa,hGe⟩ := Goldbach.logDeriv_mul_exists_analytic_remainder
    (F:=f) (K:=fun _ : ℂ => 1) Z (fun p hp=>((hZU p).mp hp).1)
      hfU analyticOnNhd_const (fun p hp hfp=>(hZU p).mpr ⟨hp,hfp⟩) ho
  have hGe' (w : ℂ) (hw : w∈U) (hwZ : w∉Z) :
      logDeriv f w = G w+∑ p∈Z,(analyticOrderNatAt f p:ℂ)/(w-p) := by
    simpa only [mul_one] using hGe (x:=w) ⟨hw,hwZ⟩
  have hc1 : ‖line 1 t-c‖=1 := by
    have he : line 1 t-c=(-1:ℂ) := by
      apply Complex.ext <;> norm_num [c,line,Complex.sub_re,Complex.sub_im,Complex.mul_re,Complex.mul_im]
    rw [he,norm_neg,norm_one]
  have hInside (w : ℂ) (hw : w∈closedBall (line 1 t) (1/4)) :
      w∈ball c (83/100*R) := by
    rw [mem_ball_iff_norm]
    have hh := norm_add_le (w-line 1 t) (line 1 t-c)
    rw [sub_add_sub_cancel,hc1] at hh
    have h := mem_closedBall_iff_norm.mp hw
    dsimp [R]
    linarith only [hh,h]
  have hsubset : ball c (83/100*R) ⊆ U :=
    ball_subset_closedBall.trans (closedBall_subset_closedBall (by norm_num [R]))
  have hNorm (w : ℂ) (hw : w∈closedBall (line 1 t) (1/4)) : ‖G w‖≤A*Real.log B := by
    have hinner := hInside w hw
    have hwU := hsubset hinner
    have hv : ∀ᶠ z in 𝓝[≠] w, ‖G z‖≤A*Real.log B := by
      have hk : ∀ᶠ z in 𝓝[≠] w, z∈ball c (83/100*R) :=
        nhdsWithin_le_nhds (isOpen_ball.mem_nhds hinner)
      have hd : ∀ᶠ z in 𝓝[≠] w, z∉Z.erase w :=
        nhdsWithin_le_nhds ((Z.erase w).finite_toSet.isClosed.isOpen_compl.mem_nhds (by simp))
      have hn : ∀ᶠ z in 𝓝[≠] w, z≠w := by simpa using (eventually_mem_nhdsWithin (a:=w) (s:={w}ᶜ))
      filter_upwards [hk,hd,hn] with z hz hz' hne
      have hzZ : z∉Z := fun hzZ => hz' (Finset.mem_erase.mpr ⟨hne,hzZ⟩)
      have hzf : f z≠0 := fun he => hzZ ((hZU z).mpr ⟨hsubset hz,he⟩)
      have ha := hApprox z (ball_subset_closedBall hz) hzf
      rw [hGe' z (hsubset hz) hzZ,add_sub_cancel_right] at ha
      exact ha
    exact le_of_tendsto ((hGa w hwU).continuousAt.norm.continuousWithinAt) hv
  have hlog900 : Real.log 900≤10*Real.log 2 := by
    calc
      _ ≤ Real.log ((2:ℝ)^(10:ℕ)) := Real.log_le_log (by norm_num) (by norm_num)
      _ = _ := by rw [Real.log_pow]; norm_num
  have hBL : Real.log B≤13*logHeight q t := by
    change Real.log (900*(q:ℝ)*K^2) ≤ 13*Real.log (2*(q:ℝ)*K)
    rw [Real.log_mul (by positivity) (pow_ne_zero _ hK0.ne'),
      Real.log_mul (by norm_num) hq0.ne',Real.log_pow,
      Real.log_mul (by positivity) hK0.ne',Real.log_mul (by norm_num) hq0.ne']
    norm_num
    linarith only [hlog900,Real.log_nonneg hq1,Real.log_nonneg hK1,
      Real.log_nonneg (by norm_num : (1:ℝ)≤2)]
  have hL : 0≤logHeight q t := zero_le_one.trans (logHeight_ge_one q t)
  refine ⟨Z,-G,?_,?_,(hGa.mono (fun w hw=>hsubset (hInside w hw))).neg,?_,?_,?_⟩
  · intro ρ hρ
    obtain ⟨hρU,hρ⟩ := (hZU ρ).mp hρ
    refine ⟨hρ,le_of_not_gt (fun h=>regularizedL_ne_zero_right χ h hρ),?_⟩
    have h1 : |ρ.im-t|≤‖ρ-c‖ := by simpa [c,line,Complex.sub_im] using Complex.abs_im_le_norm (ρ-c)
    exact h1.trans ((mem_closedBall_iff_norm.mp hρU).trans (by norm_num [R]))
  · have hc : (∑ p∈Z,(analyticOrderNatAt f p:ℝ))≤D*Real.log B := by
      simpa only [D,div_eq_inv_mul] using hCount
    have hle := hc.trans (mul_le_mul_of_nonneg_left hBL hD.le)
    change (∑ p∈Z,(analyticOrderNatAt f p:ℝ)) ≤ _
    nlinarith only [hle,mul_nonneg hA.le hL]
  · intro w hw
    have hh := mul_le_mul_of_nonneg_left hBL hA.le
    have hb : A*Real.log B≤13*(A+D)*logHeight q t := by
      nlinarith only [hh,mul_nonneg hD.le hL]
    simpa [norm_neg] using (hNorm w hw).trans hb
  · intro w hw hwre
    have hwZ : w∉Z := fun hz => regularizedL_ne_zero_right χ hwre ((hZU w).mp hz).2
    have h := hGe' w (hsubset (hInside w hw)) hwZ
    have hw1 : w≠1 := by intro he; norm_num [he] at hwre
    have hL := χ.LFunction_ne_zero_of_one_le_re (Or.inr hw1) hwre.le
    have hreg := logDeriv_regularizedL_eq χ hw1 hL
    change logDeriv (regularizedL χ) w = _ at h
    rw [hreg] at h
    change -logDeriv χ.LFunction w = -G w + principalFlag χ/(w-1) - _
    linear_combination -h

  · intro ρ hρ hρz
    apply (hZU ρ).mpr
    refine ⟨?_,hρz⟩
    apply mem_closedBall_iff_norm.mpr
    have h := norm_add_le (ρ-line 1 t) (line 1 t-c)
    rw [sub_add_sub_cancel,hc1] at h
    norm_num [R]
    linarith only [h,hρ]

end

