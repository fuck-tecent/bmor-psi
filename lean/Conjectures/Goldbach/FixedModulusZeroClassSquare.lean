open Finset Filter
open scoped Topology

theorem sum_log_primeFactors_le {q : ℕ} (hq : q≠0) :
    (∑ p∈q.primeFactors, Real.log (p:ℝ))≤Real.log (q:ℝ) := by
  have hp (p : ℕ) (h : p∈q.primeFactors) : (0:ℝ)<p :=
    by exact_mod_cast (Nat.prime_of_mem_primeFactors h).pos
  rw [←Real.log_prod (s:=q.primeFactors) (f:=fun p=>(p:ℝ)) (fun p h=> (hp p h).ne'),←Nat.cast_prod]
  have hle : (∏ p∈q.primeFactors,p)≤q :=
    Nat.le_of_dvd (Nat.pos_of_ne_zero hq) q.prod_primeFactors_dvd
  have hpos : (0:ℝ)<(∏ p∈q.primeFactors,p : ℕ) := by
    rw [Nat.cast_prod]
    exact Finset.prod_pos hp
  exact Real.log_le_log hpos (by exact_mod_cast hle)

/-- A decaying loss on each conductor prime has total logarithmic weight
o(L), uniformly whenever the conductor logarithm is at most L. -/
theorem decaying_bad_prime_log_mass_small {f : ℕ→ℝ}
    (hf : ∀ p, 0≤f p) (hdecay : Tendsto f atTop (𝓝 0)) {ε : ℝ} (hε : 0<ε) :
    ∃ L₀ : ℝ, 0<L₀ ∧ ∀ (q : ℕ) (L : ℝ), q≠0 → L₀≤L →
      Real.log (q:ℝ)≤L →
      (∑ p∈q.primeFactors, Real.log (p:ℝ)*f p) ≤ ε*L := by
  classical
  obtain ⟨K,hK⟩ := eventually_atTop.mp (hdecay.eventually_le_const (show 0<ε/2 by positivity))
  let C := ∑ p∈Finset.range K, Real.log (p:ℝ)*f p
  have hC : 0≤C := Finset.sum_nonneg fun p _=>mul_nonneg (Real.log_natCast_nonneg p) (hf p)
  refine ⟨1+2*C/ε,by positivity,?_⟩
  intro q L hq hL hlog
  let S := q.primeFactors
  let w := fun p : ℕ=>Real.log (p:ℝ)*f p
  have hSmall : (∑ p∈S.filter (fun p=>p<K), w p)≤C := by
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro p hp
      exact Finset.mem_range.mpr (Finset.mem_filter.mp hp).2
    · intro p _ _
      exact mul_nonneg (Real.log_natCast_nonneg p) (hf p)
  have hLarge : (∑ p∈S.filter (fun p=>¬p<K), w p)≤(ε/2)*L := calc
    _ ≤ ∑ p∈S.filter (fun p=>¬p<K), (ε/2)*Real.log (p:ℝ) := by
      apply Finset.sum_le_sum
      intro p hp
      rw [mul_comm (ε/2)]
      exact mul_le_mul_of_nonneg_left (hK p (le_of_not_gt (Finset.mem_filter.mp hp).2))
        (Real.log_natCast_nonneg p)
    _ = (ε/2)*∑ p∈S.filter (fun p=>¬p<K), Real.log (p:ℝ) := (Finset.mul_sum _ _ _).symm
    _ ≤ (ε/2)*L := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact ((Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        (fun p _ _=>Real.log_natCast_nonneg p)).trans (sum_log_primeFactors_le hq)).trans hlog
  have hC' : C≤(ε/2)*L := by
    have h := (div_le_iff₀ hε).mp ((le_add_of_nonneg_left (by norm_num : (0:ℝ)≤1)).trans hL)
    linarith only [h]
  change (∑ p∈S, w p)≤_
  rw [←Finset.sum_filter_add_sum_filter_not S (fun p=>p<K) w]
  linarith only [hSmall,hLarge,hC']

end GoldbachPintzWeightedFormula
end

