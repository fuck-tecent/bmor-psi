/-- A scale above the short-factor cap cannot be a sharp Möbius factor.
It also exceeds the threshold needed for the functional-equation shortening. -/
theorem scale_split : ∀ᶠ x : ℝ in atTop, ∀ {X H j : ℕ} {a z : ℝ} {b : Choice j}
    (θ β D T : ℝ), H ≠ 0 → H ≤ X → (H:ℝ) ≤ (4*x)^((1:ℝ)/4) →
    b ∈ activeChoices X H j a z → 5/8 ≤ θ → (1-θ)/3+1/32 ≤ β → 0 < D → 0 ≤ T →
    D^2*x^β*(Real.log x)^19 = x^θ → D^2*T*x^β ≤ x*(Real.log x)^120 →
    let M := fun k : {i // i ∈ blockIndices j} => scale (b k.val k.property)
    (∀ k, M k ≤ x^((1:ℝ)/3-1/256)) ∨
      ∃ k, k.val < j+1 ∧ (D*T)^((33:ℝ)/64)*(Real.log x)^256 ≤ M k := by
  filter_upwards [ShortAPFourthSection.short_length_cutoff, ShortAPFourthSection.mobius_length_cutoff,
    eventually_ge_atTop (1:ℝ)] with x hshort hmob hx
  intro X H j a z b θ β D T hH hHX hHr hb hθ hβ hD hT hid hHeight M
  by_cases hs : ∀ k, M k ≤ x^((1:ℝ)/3-1/256)
  · exact Or.inl hs
  · push Not at hs
    obtain ⟨k, hk⟩ := hs
    refine Or.inr ⟨k, ?_, ?_⟩
    · by_contra! hsharp
      have hHle : M k ≤ H :=
        (choice_scale_bounds hH hHX (mem_filter.mp hb).1 k.property).2.2 (by simp [isSharp, hsharp])
      have h₄ : (4:ℝ)^((1:ℝ)/4) ≤ 4 := by
        simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le
          (by norm_num : (1:ℝ) ≤ 4) (by norm_num : (1:ℝ)/4 ≤ 1)
      have hB : (4*x)^((1:ℝ)/4) ≤ 4*x^((1:ℝ)/4) := by
        rw [Real.mul_rpow (by norm_num : (0:ℝ) ≤ 4) (zero_le_one.trans hx)]
        exact mul_le_mul_of_nonneg_right h₄ (Real.rpow_nonneg (zero_le_one.trans hx) _)
      exact (not_le.mpr hk) (hmob _ (hHle.trans (hHr.trans hB)))
    · by_contra! hle
      have hs' := hshort θ β D T (M k) hθ hβ hD hT hid hHeight hle.le
      exact (not_le.mpr hk) hs'

