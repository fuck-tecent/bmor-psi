noncomputable def V81 (χ : PrimitiveComplexCharacter) (X : ℝ) : ℂ :=
  ∑' n : ℕ, Vl χ n * V4t (n / X)
set_option maxHeartbeats 1000000 in
set_option maxRecDepth 4096 in
noncomputable def V3j (χ : PrimitiveComplexCharacter)
    (X σ : ℝ) (n : ℕ) (t : ℝ) : ℂ :=
  LSeries.term (Vl χ) (V1y σ t) n *
    V32 X σ t
set_option maxHeartbeats 1000000 in
set_option maxRecDepth 4096 in
theorem Vkc (χ : PrimitiveComplexCharacter)
    (X σ : ℝ) (n : ℕ) (t : ℝ) :
    ‖V3j χ X σ n t‖ =
      ‖LSeries.term (Vl χ) (σ : ℂ) n‖ *
        ‖V32 X σ t‖ := by
  rw [V3j, norm_mul, V10q]
set_option maxHeartbeats 1000000 in
set_option maxRecDepth 4096 in
theorem Vsy (χ : PrimitiveComplexCharacter)
    (X σ : ℝ) (hX : 0 < X) (hσ : 1 ≤ σ) (n : ℕ) :
    Integrable (V3j χ X σ n) := by
  apply ((Vb9 X σ hX hσ).norm.const_mul
    ‖LSeries.term (Vl χ) (σ : ℂ) n‖).mono'
  · exact ((Vq2 χ σ n).mul
      (V8l X σ hX (by linarith))).aestronglyMeasurable
  · exact Filter.Eventually.of_forall (fun t => (Vkc χ X σ n t).le)
set_option maxHeartbeats 1000000 in
set_option maxRecDepth 4096 in
theorem Vp3 (χ : PrimitiveComplexCharacter)
    (X σ : ℝ) (hσ : 1 < σ) :
    Summable (fun n => ∫ t : ℝ, ‖V3j χ X σ n t‖) := by
  have hsum : LSeriesSummable (Vl χ) (σ : ℂ) :=
    DirichletCharacter.LSeriesSummable_twist_vonMangoldt χ.character (by simpa using hσ)
  have hs := hsum.norm.mul_right (∫ t : ℝ, ‖V32 X σ t‖)
  apply hs.congr
  intro n
  simp only [Vkc, integral_const_mul]
set_option maxHeartbeats 1000000 in
set_option maxRecDepth 4096 in
theorem Vrk (χ : PrimitiveComplexCharacter)
    (X σ : ℝ) (hX : 0 < X) (hσ : 1 ≤ σ) (n : ℕ) :
    ((1 / (2 * Real.pi) : ℝ) : ℂ) *
      (∫ t : ℝ, V3j χ X σ n t) =
      Vl χ n * V4t (n / X) := by
  by_cases hn : n = 0
  · subst n
    simp [V3j, Vl]
  have hnR : 0 < (n : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hkernel (t : ℝ) : V3j χ X σ n t =
      Vl χ n *
        (((n : ℝ) / X : ℝ) : ℂ) ^ (-V1y σ t) *
          V2a (V1y σ t) := by
    rw [V3j, LSeries.term_of_ne_zero hn, V32,
      Complex.cpow_neg, Complex.ofReal_div,
      Complex.div_cpow_ofReal_nonneg hnR.le hX.le, inv_div]
    push_cast
    ring
  simp_rw [hkernel, mul_assoc]
  rw [integral_const_mul]
  have hinv := Vk0 σ ((n : ℝ) / X) hσ (div_pos hnR hX)
  change ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ,
    (((n : ℝ) / X : ℝ) : ℂ) ^ (-V1y σ t) *
      V2a (V1y σ t)) = _ at hinv
  rw [← hinv]
  ring
set_option maxHeartbeats 1000000 in
set_option maxRecDepth 4096 in
theorem Vkw (χ : PrimitiveComplexCharacter)
    (X σ : ℝ) (hX : 0 < X) (hσ : 1 < σ) :
    V81 χ X =
      ((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ,
        (-logDeriv χ.L (V1y σ t)) * V32 X σ t := by
  unfold V81
  calc
    _ = ∑' n : ℕ, ((1 / (2 * Real.pi) : ℝ) : ℂ) *
        ∫ t : ℝ, V3j χ X σ n t :=
      tsum_congr (fun n => (Vrk χ X σ hX hσ.le n).symm)
    _ = ((1 / (2 * Real.pi) : ℝ) : ℂ) *
        ∑' n : ℕ, ∫ t : ℝ, V3j χ X σ n t := tsum_mul_left
    _ = ((1 / (2 * Real.pi) : ℝ) : ℂ) *
        ∫ t : ℝ, ∑' n : ℕ, V3j χ X σ n t := by
      rw [integral_tsum_of_summable_integral_norm
        (Vsy χ X σ hX hσ.le)
        (Vp3 χ X σ hσ)]
    _ = _ := by
      congr 1
      apply integral_congr_ae
      filter_upwards with t
      rw [show (∑' n : ℕ, V3j χ X σ n t) =
        LSeries (Vl χ) (V1y σ t) * V32 X σ t from tsum_mul_right]
      rw [χ.Vhk _ (by simpa using hσ)]
      simp only [logDeriv_apply, neg_div]
