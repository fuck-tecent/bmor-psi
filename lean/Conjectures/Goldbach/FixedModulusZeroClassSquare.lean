namespace GoldbachPintzScales

noncomputable def thetaScale (Q T : ℝ) : ℝ := Real.exp (thetaLog (Real.log Q) (Real.log (T+1)))
noncomputable def lowerScale (Q T : ℝ) : ℝ := Real.exp (lowerLog (Real.log Q) (Real.log (T+1)))
noncomputable def upperScale (Q T : ℝ) : ℝ := Real.exp (upperLog (Real.log Q) (Real.log (T+1)))

theorem thetaScale_pos (Q T : ℝ) : 0 < thetaScale Q T := Real.exp_pos _
theorem lowerScale_pos (Q T : ℝ) : 0 < lowerScale Q T := Real.exp_pos _
theorem upperScale_pos (Q T : ℝ) : 0 < upperScale Q T := Real.exp_pos _

theorem scale_relations {Q T : ℝ} (hQ : 1 ≤ Q) (hT : 1 ≤ T) :
    let H := Q*(T+1)
    let W := thetaScale Q T
    let U := lowerScale Q T
    let V := U*W
    let Y := upperScale Q T
    2 ≤ U ∧ 1 < W ∧ U < V ∧ V ≤ Y ∧
      Real.log U + Real.log V ≤ 2 * Real.log Y ∧
      (loss/3)*Real.log Y ≤ Real.log (V/U) ∧
      Real.log Y ≤ 3 * Real.log H := by
  dsimp only
  let x := Real.log Q
  let y := Real.log (T+1)
  have hQ0 := zero_lt_one.trans_le hQ
  have hT1 : 1 < T+1 := by linarith
  have hT0 := zero_lt_one.trans hT1
  have hx : 0 ≤ x := Real.log_nonneg hQ
  have hy : 0 < y := Real.log_pos hT1
  have hlog : Real.log (Q*(T+1)) = x+y := Real.log_mul hQ0.ne' hT0.ne'
  obtain ⟨hUV, hsum, hdiv⟩ := cutoff_log_comparison hx hy.le
  have hU : 2 ≤ lowerScale Q T := by
    unfold lowerScale
    have hyy : Real.log 2 ≤ y := Real.log_le_log (by norm_num) (by linarith)
    rw [← Real.exp_log (show 0 < (2:ℝ) by norm_num)]
    apply Real.exp_le_exp.mpr
    change Real.log 2 ≤ lowerLog x y
    unfold lowerLog loss
    linarith only [hyy,hx,hy]
  have hW : 1 < thetaScale Q T := by
    unfold thetaScale
    exact Real.one_lt_exp_iff.mpr (by change 0 < thetaLog x y; unfold thetaLog loss; positivity)
  have hvu : lowerScale Q T < lowerScale Q T * thetaScale Q T :=
    lt_mul_of_one_lt_right (lowerScale_pos Q T) hW
  have hvy : lowerScale Q T * thetaScale Q T ≤ upperScale Q T := by
    unfold lowerScale thetaScale upperScale
    rw [← Real.exp_add]
    exact Real.exp_le_exp.mpr hUV
  have hu0 := lowerScale_pos Q T
  have hW0 := thetaScale_pos Q T
  refine ⟨hU,hW,hvu,hvy,?_,?_,?_⟩
  · rw [Real.log_mul hu0.ne' hW0.ne']
    simpa only [lowerScale,thetaScale,upperScale,Real.log_exp] using (by linarith only [hsum] :
      lowerLog x y + (lowerLog x y + thetaLog x y) ≤ 2*upperLog x y)
  · rw [mul_div_cancel_left₀ _ hu0.ne']
    simpa only [upperScale,thetaScale,Real.log_exp] using hdiv
  · rw [hlog]
    simp only [upperScale,Real.log_exp]
    change upperLog x y ≤ 3*(x+y)
    unfold upperLog loss
    linarith only [hx,hy]

theorem detector_error_scale {Q T δ : ℝ} (hQ : 1 ≤ Q) (hT : 1 ≤ T) (hδ : δ ≤ loss) :
    let W := thetaScale Q T
    let U := lowerScale Q T
    let Y := upperScale Q T
    Real.sqrt (U*W)*Real.sqrt W*Y^(-1/2+δ)*
        Q^(1/4+loss/2)*(T+1)^(1/2:ℝ) ≤ (Q*(T+1))^(-4*loss) := by
  dsimp only
  have hp : 0 < Q := zero_lt_one.trans_le hQ
  have ht : (0:ℝ) < T+1 := by linarith
  let x := Real.log Q
  let y := Real.log (T+1)
  have hlog : Real.log (Q*(T+1)) = x+y := Real.log_mul hp.ne' ht.ne'
  have h := detector_exponent_le (x:=x) (y:=y) (Real.log_nonneg hQ)
    (Real.log_nonneg (show 1≤T+1 by linarith)) hδ
  rw [Real.sqrt_eq_rpow,Real.sqrt_eq_rpow,
    Real.rpow_def_of_pos (upperScale_pos Q T), Real.rpow_def_of_pos hp,
    Real.rpow_def_of_pos ht, Real.rpow_def_of_pos (mul_pos hp ht)]
  rw [Real.rpow_def_of_pos (thetaScale_pos Q T),
    Real.rpow_def_of_pos (mul_pos (lowerScale_pos Q T) (thetaScale_pos Q T))]
  rw [Real.log_mul (lowerScale_pos Q T).ne' (thetaScale_pos Q T).ne',hlog]
  simp only [thetaScale,lowerScale,upperScale,Real.log_exp,← Real.exp_add]
  apply Real.exp_le_exp.mpr
  linarith only [h]

theorem comparison_error_scale {Q T δ : ℝ} (hQ : 1 ≤ Q) (hT : 1 ≤ T) (hδ : δ ≤ loss) :
    let W := thetaScale Q T
    let U := lowerScale Q T
    W*U^(-1/2+2*δ)*Q^(1/2+loss)*(T+1)^(1/2:ℝ) ≤ (Q*(T+1))^(-3*loss) := by
  dsimp only
  have hp : 0 < Q := zero_lt_one.trans_le hQ
  have ht : (0:ℝ) < T+1 := by linarith
  let x := Real.log Q
  let y := Real.log (T+1)
  have hlog : Real.log (Q*(T+1)) = x+y := Real.log_mul hp.ne' ht.ne'
  have h := off_diagonal_exponent_le (x:=x) (y:=y) (Real.log_nonneg hQ)
    (Real.log_nonneg (show 1≤T+1 by linarith)) hδ
  rw [Real.rpow_def_of_pos (lowerScale_pos Q T), Real.rpow_def_of_pos hp,
    Real.rpow_def_of_pos ht, Real.rpow_def_of_pos (mul_pos hp ht),hlog]
  simp only [thetaScale,lowerScale,Real.log_exp,← Real.exp_add]
  apply Real.exp_le_exp.mpr
  linarith only [h]

end GoldbachPintzScales

