namespace OAI.Ostmann
theorem V1p4 (s : ℂ) (hs : 1/4 ≤ s.re) (hne : s ≠ 1) :
    ‖riemannZeta s‖ ≤ 1 + ‖(s-1)⁻¹‖ + 4*‖s‖ := by
  have hd : s ∈ V2q := ⟨hne, by
    change (1/10 : ℝ) < s.re
    linarith⟩
