lemma Vog (χ : DirichletCharacter ℂ q)
    {r t : ℝ} (hr : 0 < r) (ht : 3 * r < |t|)
    {z : ℂ} (hz : ‖z‖ ≤ 1)
    (hn : DirichletCharacter.LFunction χ (V1a r t z) ≠ 0) :
