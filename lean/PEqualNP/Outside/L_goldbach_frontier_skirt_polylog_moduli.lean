    (hscale : (q:ℝ)^2*(n:ℝ)^(7/12:ℝ)≤(h:ℝ))
    (hmean : ∀ X : ℕ, X₀≤X → 2≤X → h≤X →
      (q:ℝ)^2*(X:ℝ)^(7/12:ℝ)≤(h:ℝ) →
      (∫ y in (X:ℝ)..((2*X:ℕ):ℝ), V4z q h y) ≤
        C*(h:ℝ)*(X:ℝ)/(Real.log (X:ℝ))^12) :
    (∑ r∈Ico Y (n+1), V4z q h (r:ℝ)) ≤
      8192*C*(h:ℝ)*(n:ℝ)/(Real.log (n:ℝ))^12 := by
  let L := Real.log (n:ℝ)
  let K := 4096*C*(h:ℝ)/L^12
  have hK : 0≤K := by dsimp [K]; positivity
  have hblock : ∀ X : ℕ, Y≤X → X≤n →
      (∑ r∈Ico X (2*X), V4z q h (r:ℝ))≤K*(X:ℝ) := by
    intro X hYX hXn
    have hX2 : 2≤X := hY.trans hYX
    have hXpos : 0<(X:ℝ) := by exact_mod_cast (show 0<X by omega)
    have hYpos : 0<(Y:ℝ) := by exact_mod_cast (show 0<Y by omega)
    have hLX : L/2≤Real.log (X:ℝ) := hlog.trans
      (Real.log_le_log hYpos (by exact_mod_cast hYX))
    have hLXpos : 0<Real.log (X:ℝ) := (by dsimp [L]; positivity : 0<L/2).trans_le hLX
    have hXscale : (q:ℝ)^2*(X:ℝ)^(7/12:ℝ)≤(h:ℝ) := by
      apply le_trans _ hscale
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
      exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hXn) (by norm_num)
    rw [Vh1 q h (show X≤2*X by omega)]
    calc
      _ ≤ C*(h:ℝ)*(X:ℝ)/(Real.log (X:ℝ))^12 :=
        hmean X (hXY.trans hYX) hX2 (hhY.trans hYX) hXscale
      _ ≤ C*(h:ℝ)*(X:ℝ)/(L/2)^12 := by
        apply div_le_div_of_nonneg_left (by positivity) (by dsimp [L]; positivity)
        exact pow_le_pow_left₀ (by dsimp [L]; positivity) hLX 12
      _ = K*(X:ℝ) := by
        dsimp [K]
        field_simp
        ring
  have h := V1ua.V1up
    (fun r => V4z q h (r:ℝ)) (by omega) hYn hK
    (fun r => Vj2 q h _) hblock
  apply h.trans_eq
  dsimp [K,L]
  ring
end Vbi
end

section
open Filter Finset MeasureTheory
open scoped Topology Interval BigOperators Classical
namespace V5d
open ArithmeticFunction
open V31 (Vb2 Vo2)
open V54 (V76)
open V7d (V6t)
open V3z (V6v)
open V2h (V9a V4z)
noncomputable def V7j (k : ℕ) : ℝ := vonMangoldt k - Vb2 k
theorem Vkh (k : ℕ) : 0 ≤ V7j k := by
  unfold V7j Vb2
  by_cases hk : Nat.Prime k
  · simp [hk, vonMangoldt_apply_prime hk]
  · simp [hk]
theorem V1cp (n : ℕ) (hn : 1 ≤ n) (I : Finset ℕ)
    (hI : I ⊆ range (n+1)) :
    (∑ k ∈ I, V7j k) ≤ 2 * Real.sqrt (n : ℝ) * Real.log (n : ℝ) := by
  have hp : Chebyshev.psi (n:ℝ) = ∑ k ∈ range (n+1), vonMangoldt k := by
    rw [Chebyshev.psi_eq_sum_Icc, Nat.floor_natCast, Nat.range_succ_eq_Icc_zero]
  have ht : Chebyshev.theta (n:ℝ) = ∑ k ∈ range (n+1), Vb2 k :=
    Vo2 n
  calc
    _ ≤ ∑ k ∈ range (n+1), V7j k :=
      sum_le_sum_of_subset_of_nonneg hI (fun k _ _ => Vkh k)
    _ = Chebyshev.psi (n:ℝ) - Chebyshev.theta (n:ℝ) := by
      simp only [hp, ht, V7j, Finset.sum_sub_distrib]
    _ ≤ _ := Chebyshev.psi_sub_theta_le (by exact_mod_cast hn)
theorem V1wa (g : ℕ → ℝ) (hg : ∀ k, 0 ≤ g k)
    (X h : ℕ) (hh : h ≤ X) :
    (∑ r ∈ Ico X (2*X), ∑ k ∈ Ioc r (r+h), g k) ≤
      (h : ℝ) * ∑ k ∈ range (3*X+1), g k := by
  have hreindex (r : ℕ) (hr : r ∈ Ico X (2*X)) :
      (∑ k ∈ Ioc r (r+h), g k) =
        ∑ k ∈ range (3*X+1), if r < k ∧ k ≤ r+h then g k else 0 := by
    rw [← sum_filter]
    congr 1
    ext k
    simp only [mem_Ioc, mem_filter, mem_range]
    have hr' := mem_Ico.mp hr
    omega
  calc
    _ = ∑ r ∈ Ico X (2*X), ∑ k ∈ range (3*X+1),
        if r < k ∧ k ≤ r+h then g k else 0 := sum_congr rfl hreindex
    _ = ∑ k ∈ range (3*X+1), ∑ r ∈ Ico X (2*X),
        if r < k ∧ k ≤ r+h then g k else 0 := sum_comm
    _ ≤ ∑ k ∈ range (3*X+1), (h : ℝ) * g k := by
      apply sum_le_sum
      intro k _
      rw [← sum_filter, sum_const, nsmul_eq_mul]
      apply mul_le_mul_of_nonneg_right _ (hg k)
      have hs : ((Ico X (2*X)).filter (fun r => r < k ∧ k ≤ r+h)) ⊆ Ico (k-h) k := by
        intro r hr
        have hr' := (mem_filter.mp hr).2
        simp only [mem_Ico]
        omega
      have hc := card_le_card hs
      rw [Nat.card_Ico] at hc
      exact_mod_cast (show ((Ico X (2*X)).filter
        (fun r => r < k ∧ k ≤ r+h)).card ≤ h by omega)
    _ = _ := (mul_sum _ _ _).symm
noncomputable def V6w (q : ℕ) [NeZero q]
    (I : Finset ℕ) (r : ZMod q) : ℝ :=
  ‖(∑ k ∈ I.filter (fun k : ℕ => (k : ZMod q) = r), (vonMangoldt k : ℂ)) -
    (I.card : ℂ) / (q.totient : ℂ)‖
noncomputable def V8m (q : ℕ) [NeZero q] (I : Finset ℕ) : ℝ :=
  ((univ : Finset (ZMod q)).filter IsUnit).sup' ⟨1, by simp⟩
    (V6w q I)
noncomputable def Vaw (q : ℕ) [NeZero q] (h : ℕ) (y : ℝ) : ℝ :=
  V8m q (V9a h y)
theorem V1c6 (q : ℕ) [NeZero q] (I : Finset ℕ) (r : ZMod q) :
    V6t q I r ≤ V6w q I r + ∑ k ∈ I, V7j k := by
  let J := I.filter (fun k : ℕ => (k : ZMod q) = r)
  have hdiff :
      (∑ k ∈ J, V76 k) - (I.card : ℂ) / (q.totient : ℂ) =
      ((∑ k ∈ J, (vonMangoldt k : ℂ)) - (I.card : ℂ) / (q.totient : ℂ)) -
        ((∑ k ∈ J, V7j k : ℝ) : ℂ) := by
    simp only [V7j, sum_sub_distrib, Complex.ofReal_sub, Complex.ofReal_sum]
    change _ = (_ - _) - (_ - ∑ k ∈ J, V76 k)
    ring
  change ‖(∑ k ∈ J, V76 k) - (I.card : ℂ) / (q.totient : ℂ)‖ ≤ _
  rw [hdiff]
  calc
    _ ≤ V6w q I r + ‖((∑ k ∈ J, V7j k : ℝ) : ℂ)‖ :=
      norm_sub_le _ _
    _ = V6w q I r + ∑ k ∈ J, V7j k := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sum_nonneg (fun k _ => Vkh k))]
    _ ≤ _ := add_le_add_right
      (sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun k _ _ => Vkh k)) _
theorem V1r7 (q : ℕ) [NeZero q] (I : Finset ℕ) :
    V6v q I ≤ V8m q I + ∑ k ∈ I, V7j k := by
  apply sup'_le
  intro r hr
  apply (V1c6 q I r).trans
  exact add_le_add_left (le_sup' (V6w q I) hr) _
theorem V1p9 (q : ℕ) [NeZero q] (X h : ℕ)
    (hX : 1 ≤ X) (hh : h ≤ X) :
    (∑ r ∈ Ico X (2*X), V6v q (Ioc r (r+h))) ≤
      (∑ r ∈ Ico X (2*X), V8m q (Ioc r (r+h))) +
        2*(h : ℝ)*Real.sqrt ((3*X : ℕ) : ℝ)*Real.log ((3*X : ℕ) : ℝ) := by
  calc
    _ ≤ ∑ r ∈ Ico X (2*X),
        (V8m q (Ioc r (r+h)) + ∑ k ∈ Ioc r (r+h), V7j k) :=
      sum_le_sum fun r _ => V1r7 q _
    _ = (∑ r ∈ Ico X (2*X), V8m q (Ioc r (r+h))) +
        (∑ r ∈ Ico X (2*X), ∑ k ∈ Ioc r (r+h), V7j k) := sum_add_distrib
    _ ≤ (∑ r ∈ Ico X (2*X), V8m q (Ioc r (r+h))) +
        (h : ℝ)*∑ k ∈ range (3*X+1), V7j k :=
      (add_le_add_right) (V1wa V7j Vkh X h hh) _
    _ ≤ _ := by
      apply add_le_add_right
      have hb := mul_le_mul_of_nonneg_left
        (V1cp (3*X) (by omega) (range (3*X+1)) (Subset.refl _))
        (Nat.cast_nonneg (α:=ℝ) h)
      nlinarith only [hb]
theorem V1cz (q : ℕ) [NeZero q] (X h : ℕ)
    (hX : 1 ≤ X) (hh : h ≤ X) :
    (∫ y in (X : ℝ)..((2*X : ℕ) : ℝ), V4z q h y) ≤
      (∫ y in (X : ℝ)..((2*X : ℕ) : ℝ), Vaw q h y) +
        2*(h : ℝ)*Real.sqrt ((3*X : ℕ) : ℝ)*Real.log ((3*X : ℕ) : ℝ) := by
  rw [← V2h.Vdb q h (show X ≤ 2*X by omega)]
  have he := V2h.V8z
    (fun r => V8m q (Ioc r (r+h))) (show X ≤ 2*X by omega)
  change _ = ∫ y in (X : ℝ)..((2*X : ℕ) : ℝ), Vaw q h y at he
  rw [← he]
  exact V1p9 q X h hX hh
end V5d
end

section
open Finset
open scoped BigOperators Classical
namespace Vel
open ArithmeticFunction
open V5d (V6w V8m V7j)
open V31 (Vb2)
open V54 (V76)
noncomputable def Vco {q : ℕ} (I : Finset ℕ) (w : ℕ → ℂ)
    (χ : DirichletCharacter ℂ q) : ℂ := ∑ k ∈ I, w k * χ (k : ZMod q)
noncomputable def V3n {q : ℕ} (I : Finset ℕ) (w : ℕ → ℂ)
    (χ : DirichletCharacter ℂ q) : ℂ :=
  Vco I w χ - if χ=1 then (I.card : ℂ) else 0
theorem V1bz {q : ℕ} [NeZero q] (I : Finset ℕ)
    (w : ℕ → ℂ) (a : ZMod q) (ha : IsUnit a) :
    (q.totient : ℂ) *
        ((∑ k ∈ I.filter (fun k : ℕ => (k : ZMod q)=a), w k) -
          (I.card : ℂ)/(q.totient : ℂ)) =
      ∑ χ : DirichletCharacter ℂ q, χ a⁻¹ * V3n I w χ := by
  have haInv : IsUnit a⁻¹ := by
    obtain ⟨u,rfl⟩ := ha
    rw [ZMod.inv_coe_unit]
    exact Units.isUnit _
  have hfirst : (∑ χ : DirichletCharacter ℂ q, χ a⁻¹ * Vco I w χ) =
      (q.totient : ℂ) * ∑ k ∈ I.filter (fun k : ℕ => (k : ZMod q)=a), w k := by
    simp only [Vco, mul_sum]
    rw [sum_comm, sum_filter]
    apply sum_congr rfl
    intro k _
    calc
      _ = w k * ∑ χ : DirichletCharacter ℂ q, χ a⁻¹ * χ (k : ZMod q) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro χ _
        ring
      _ = _ := by
        rw [DirichletCharacter.sum_char_inv_mul_char_eq ℂ ha]
        by_cases hk : (k : ZMod q)=a
        · simp [hk]; ring
        · simp [hk, Ne.symm hk]
  have hmain : (∑ χ : DirichletCharacter ℂ q,
      χ a⁻¹ * (if χ=1 then (I.card : ℂ) else 0)) = (I.card : ℂ) := by
    simp [mul_ite, MulChar.one_apply haInv]
  have hφ : (q.totient : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr (NeZero.pos q)).ne'
  simp only [V3n, mul_sub, sum_sub_distrib, hfirst, hmain]
  rw [mul_div_cancel₀ _ hφ]
theorem Vr5 {q : ℕ} [NeZero q]
    (I : Finset ℕ) (a : ZMod q) (ha : IsUnit a) :
    V6w q I a ≤
      (∑ χ : DirichletCharacter ℂ q,
        ‖V3n I (fun k => (vonMangoldt k : ℂ)) χ‖)/(q.totient : ℝ) := by
  have hφ : 0 < (q.totient : ℝ) := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  apply (le_div_iff₀ hφ).2
  have he := congrArg norm (V1bz I
    (fun k => (vonMangoldt k : ℂ)) a ha)
  simp only [norm_mul, norm_natCast] at he
  change (q.totient : ℝ)*V6w q I a = _ at he
  rw [mul_comm, he]
  calc
    _ ≤ ∑ χ : DirichletCharacter ℂ q,
        ‖χ a⁻¹ * V3n I (fun k => (vonMangoldt k : ℂ)) χ‖ := norm_sum_le _ _
    _ ≤ _ := by
      apply sum_le_sum
      intro χ _
      rw [norm_mul]
      exact mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)
theorem V176 {q : ℕ} [NeZero q] (I : Finset ℕ) :
    V8m q I ≤
      (∑ χ : DirichletCharacter ℂ q,
        ‖V3n I (fun k => (vonMangoldt k : ℂ)) χ‖)/(q.totient : ℝ) := by
  apply sup'_le
  intro a ha
  exact Vr5 I a (mem_filter.mp ha).2
theorem V1oj {d q : ℕ} [NeZero q] (hd : d ∣ q)
    (ψ : DirichletCharacter ℂ d) (I : Finset ℕ) (w : ℕ → ℂ) :
    Vco I w (ψ.changeLevel hd) = Vco I w ψ -
      ∑ k ∈ I.filter (fun k => ¬k.Coprime q), w k * ψ (k : ZMod d) := by
  simp only [Vco, sum_filter, ← sum_sub_distrib]
  apply sum_congr rfl
  intro k _
  by_cases hk : k.Coprime q
  · have hu : IsUnit (k : ZMod q) := (ZMod.isUnit_iff_coprime k q).2 hk
    have he : (ψ.changeLevel hd) (k : ZMod q) = ψ (k : ZMod d) := by
      calc
        _ = (ψ.changeLevel hd) (hu.unit : ZMod q) := by rw [hu.unit_spec]
        _ = ψ (ZMod.cast (hu.unit : ZMod q)) := ψ.changeLevel_eq_cast_of_dvd hd hu.unit
        _ = _ := by rw [hu.unit_spec, ZMod.cast_natCast hd]
    simp [hk, he]
  · rw [MulChar.map_nonunit _ (by simpa only [ZMod.isUnit_iff_coprime] using hk)]
    simp [hk]
theorem Vue {d q : ℕ} [NeZero q] (hd : d ∣ q)
    (ψ : DirichletCharacter ℂ d) (I : Finset ℕ) (w : ℕ → ℝ) (hw : ∀ k, 0≤w k) :
    ‖Vco I (fun k => (w k : ℂ)) (ψ.changeLevel hd) -
      Vco I (fun k => (w k : ℂ)) ψ‖ ≤
        ∑ k ∈ I.filter (fun k => ¬k.Coprime q), w k := by
  rw [V1oj]
  rw [sub_sub_cancel_left, norm_neg]
  calc
    _ ≤ ∑ k ∈ I.filter (fun k => ¬k.Coprime q), ‖(w k : ℂ) * ψ (k : ZMod d)‖ :=
      norm_sum_le _ _
    _ ≤ _ := by
      apply sum_le_sum
      intro k _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw k)]
      exact mul_le_of_le_one_right (hw k) (ψ.norm_le_one _)
theorem V1ne {q : ℕ} [NeZero q] (n : ℕ) (hn : 1≤n)
    (I : Finset ℕ) (hI : I ⊆ range (n+1)) :
    (∑ k ∈ I.filter (fun k => ¬k.Coprime q), vonMangoldt k) ≤
      Real.log (q : ℝ) + 2*Real.sqrt (n : ℝ)*Real.log (n : ℝ) := by
  have hnorm (k : ℕ) : ‖V76 k‖ = Vb2 k := by
    change ‖(Vb2 k : ℂ)‖ = _
    rw [Complex.norm_real, Real.norm_eq_abs]
    apply abs_of_nonneg
    unfold Vb2
    split_ifs with hp
    · exact Real.log_nonneg (by exact_mod_cast hp.one_lt.le)
    · exact le_rfl
  have hprime := V54.Vx9 (q:=q) I
  simp only [ZMod.isUnit_iff_coprime, hnorm] at hprime
  have hgap := V5d.V1cp n hn
    (I.filter (fun k => ¬k.Coprime q)) ((filter_subset _ _).trans hI)
  have he : (∑ k ∈ I.filter (fun k => ¬k.Coprime q), vonMangoldt k) =
      (∑ k ∈ I.filter (fun k => ¬k.Coprime q), Vb2 k) +
        ∑ k ∈ I.filter (fun k => ¬k.Coprime q), V7j k := by
    simp only [V7j, sum_sub_distrib]
    ring
  rw [he]
  exact add_le_add hprime hgap
end Vel
end

section
open Filter Finset
open scoped Topology Classical
namespace V9i
open V54 (V76)
open V20 (narrow)
open V73 (window)
open V7d (V6t V1mn)
open V8i (V15)
open V3z (V6v Vi1 Vfb)
def bulk (n h Y : ℕ) : Finset ℕ :=
  (range (n+1+h)).filter (fun m => Y+h ≤ m ∧ m ≤ n)
def boundary (n h Y : ℕ) : Finset ℕ :=
  range (n+1+h) \ bulk n h Y
theorem V1zn (n h Y m : ℕ) :
    m ∈ bulk n h Y ↔ Y+h ≤ m ∧ m ≤ n := by
  simp only [bulk, mem_filter, mem_range]
  omega
theorem V20q (n h Y : ℕ) : bulk n h Y = Icc (Y+h) n := by
  ext m
  rw [V1zn, mem_Icc]
theorem V235 (n h Y : ℕ) : bulk n h Y ⊆ range (n+1+h) :=
  filter_subset _ _
theorem V20m (n h Y : ℕ) :
    boundary n h Y ⊆ range (Y+h) ∪ Icc (n+1) (n+h) := by
  intro m hm
  obtain ⟨hmrange, hmnot⟩ := mem_sdiff.mp hm
  have hmr := mem_range.mp hmrange
  by_cases hstart : m < Y+h
  · exact mem_union_left _ (mem_range.mpr hstart)
  · have hend : n < m := by
      by_contra hn
      exact hmnot ((V1zn n h Y m).mpr (by omega))
    exact mem_union_right _ (mem_Icc.mpr (by omega))
theorem V1zv (n h Y : ℕ) : (boundary n h Y).card ≤ Y+2*h := by
  calc
    _ ≤ (range (Y+h) ∪ Icc (n+1) (n+h)).card := card_le_card (V20m n h Y)
    _ ≤ (range (Y+h)).card + (Icc (n+1) (n+h)).card := card_union_le _ _
    _ ≤ Y+2*h := by simp only [card_range, Nat.card_Icc]; omega
theorem V1sw (n h Y : ℕ) (f : ℕ → ℝ) :
    (∑ m ∈ range (n+1+h), f m) =
      (∑ m ∈ bulk n h Y, f m) + ∑ m ∈ boundary n h Y, f m := by
  simpa only [boundary, add_comm] using
    (Finset.sum_sdiff (f:=f) (V235 n h Y)).symm
private theorem Vod (n k : ℕ) (hn : 1 ≤ n) (hk : k ≤ n) :
    ‖V76 k‖ ≤ Real.log (n : ℝ) := by
  unfold V76
  by_cases hp : k.Prime
  · have hk1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hp.one_lt.le
    have hk0 : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hp.pos
    have hkn : (k : ℝ) ≤ (n : ℝ) := by exact_mod_cast hk
    simp only [hp, ite_true, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.log_nonneg hk1)]
    exact Real.log_le_log hk0 hkn
  · simp only [hp, ite_false, Complex.ofReal_zero, norm_zero]
    exact Real.log_nonneg (by exact_mod_cast hn)
theorem V1n4 (n q : ℕ) [NeZero q] (hn : 1 ≤ n)
    (I : Finset ℕ) (hI : I ⊆ range (n+1)) (r : ZMod q) :
    V6t q I r ≤ (I.card : ℝ) * (1+Real.log (n : ℝ)) := by
  have hlog : 0 ≤ Real.log (n : ℝ) := Real.log_nonneg (by exact_mod_cast hn)
  have hφ : 0 < (q.totient : ℝ) := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  have hφ1 : (1 : ℝ) ≤ q.totient := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  have hmass : ‖∑ k ∈ I.filter (fun k : ℕ => (k : ZMod q) = r), V76 k‖ ≤
      (I.card : ℝ) * Real.log (n : ℝ) := by
    calc
      _ ≤ ∑ k ∈ I.filter (fun k : ℕ => (k : ZMod q) = r), ‖V76 k‖ :=
        norm_sum_le _ _
      _ ≤ ∑ _k ∈ I.filter (fun k : ℕ => (k : ZMod q) = r), Real.log (n : ℝ) := by
        apply sum_le_sum
        intro k hk
        have hkI := (mem_filter.mp hk).1
        exact Vod n k hn (by have := mem_range.mp (hI hkI); omega)
      _ = ((I.filter (fun k : ℕ => (k : ZMod q) = r)).card : ℝ) *
          Real.log (n : ℝ) := by rw [sum_const, nsmul_eq_mul]
      _ ≤ (I.card : ℝ) * Real.log (n : ℝ) := by
        apply mul_le_mul_of_nonneg_right _ hlog
        exact_mod_cast card_filter_le I _
  have hmain : ‖(I.card : ℂ) / (q.totient : ℂ)‖ ≤ (I.card : ℝ) := by
    rw [norm_div, Complex.norm_natCast, Complex.norm_natCast]
    apply (div_le_iff₀ hφ).mpr
    nlinarith [Nat.cast_nonneg (α:=ℝ) I.card]
  change ‖(∑ k ∈ I.filter (fun k : ℕ => (k : ZMod q) = r), V76 k) -
