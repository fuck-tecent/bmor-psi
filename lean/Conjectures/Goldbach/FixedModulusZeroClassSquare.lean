        simp only [sum_add_distrib,indicator_balance]
        have k0 := mul_le_mul_of_nonneg_right h0 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-4.8807)-Real.exp (-4.8807))
        have k1 := mul_le_mul_of_nonneg_right h1 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-4.8807)-Real.exp (-5.2258))
        have k2 := mul_le_mul_of_nonneg_right h2 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-5.2258)-Real.exp (-5.8174))
        have k3 := mul_le_mul_of_nonneg_right h3 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-5.8174)-Real.exp (-6.7048))
        have k4 := mul_le_mul_of_nonneg_right h4 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-6.7048)-Real.exp (-7.7894))
        have k5 := mul_le_mul_of_nonneg_right h5 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-7.7894)-Real.exp (-9.367))
        have k6 := mul_le_mul_of_nonneg_right h6 (sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num)) : 0≤Real.exp (-9.367)-Real.exp (-11.9306))
        have k7 := mul_le_mul_of_nonneg_right h7 (Real.exp_nonneg _ : 0≤Real.exp (-11.9306))
        linarith only [k0, k1, k2, k3, k4, k5, k6, k7]

  have hSplit : (∑ i∈S,Real.exp (-4.93*max (level i) 0.99)) =
      (∑ i∈S.filter (fun i => level i≤3.38),Real.exp (-4.93*max (level i) 0.99)) +
      (∑ i∈S.filter (fun i => 3.38<level i),Real.exp (-4.93*max (level i) 0.99)) := by
    simpa only [not_le] using (sum_filter_add_sum_filter_not S (fun i => level i≤3.38)
