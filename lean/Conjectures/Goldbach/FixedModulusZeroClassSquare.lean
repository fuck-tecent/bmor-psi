  have hGe' (w : ℂ) (hw : w∈U) (hwZ : w∉Z) :
      logDeriv f w = G w+∑ p∈Z,(analyticOrderNatAt f p:ℂ)/(w-p) := by
    simpa only [mul_one] using hGe (x:=w) ⟨hw,hwZ⟩
  have hc1 : ‖line 1 t-c‖=1 := by
