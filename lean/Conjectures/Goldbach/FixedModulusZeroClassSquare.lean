namespace GoldbachMoebiusLog

open Finset ArithmeticFunction
open scoped ArithmeticFunction.Moebius

noncomputable section

/-- Regroup the divisor sum of the Möbius function along the product of a pair. -/
private theorem sum_moebius_pairs (N : ℕ) (hN : 1 ≤ N) (f : ℕ → ℝ) :
    (∑ d ∈ Icc 1 N, ∑ m ∈ Icc 1 (N/d), (moebius d : ℝ)*f (d*m)) = f 1 := by
  classical
  let A := (Icc 1 N).sigma (fun d => Icc 1 (N/d))
  let B := (Icc 1 N).sigma Nat.divisorsAntidiagonal
  have hPair : (∑ a ∈ A, (moebius a.1 : ℝ)*f (a.1*a.2)) =
      ∑ b ∈ B, (moebius b.2.1 : ℝ)*f b.1 := by
    refine sum_bij (fun a _ => ⟨a.1*a.2, (a.1,a.2)⟩) ?_ ?_ ?_ ?_
    · intro a ha
      obtain ⟨hd,hm⟩ := mem_sigma.mp ha
      obtain ⟨hd₀,_⟩ := mem_Icc.mp hd
      obtain ⟨hm₀,hm₁⟩ := mem_Icc.mp hm
      have hdm : a.1*a.2 ≤ N := by
        simpa only [Nat.mul_comm] using (Nat.le_div_iff_mul_le (Nat.zero_lt_one.trans_le hd₀)).mp hm₁
      have hp : 0 < a.1*a.2 := Nat.mul_pos (Nat.zero_lt_one.trans_le hd₀) (Nat.zero_lt_one.trans_le hm₀)
      exact mem_sigma.mpr ⟨mem_Icc.mpr ⟨hp,hdm⟩,Nat.mem_divisorsAntidiagonal.mpr ⟨rfl,hp.ne'⟩⟩
    · rintro ⟨d,m⟩ _ ⟨d',m'⟩ _ h
      have hp := congrArg (fun b : Σ _ : ℕ, ℕ × ℕ => b.2) h
      change (d,m) = (d',m') at hp
      cases hp
      rfl
    · rintro ⟨n,⟨d,m⟩⟩ hb
      obtain ⟨hn,hdm⟩ := mem_sigma.mp hb
      obtain ⟨he,_⟩ := Nat.mem_divisorsAntidiagonal.mp hdm
      have hd := Nat.pos_of_ne_zero (Nat.left_ne_zero_of_mem_divisorsAntidiagonal hdm)
      have hm := Nat.pos_of_ne_zero (Nat.right_ne_zero_of_mem_divisorsAntidiagonal hdm)
      have hn₁ := (mem_Icc.mp hn).2
      have hdN : d ≤ N := (Nat.le_mul_of_pos_right _ hm).trans (he.trans_le hn₁)
      have hmN : m ≤ N/d := (Nat.le_div_iff_mul_le hd).mpr (by rwa [mul_comm,he])
      refine ⟨⟨d,m⟩,mem_sigma.mpr ⟨mem_Icc.mpr ⟨hd,hdN⟩,mem_Icc.mpr ⟨hm,hmN⟩⟩,?_⟩
      change (⟨d*m,(d,m)⟩ : Σ _ : ℕ, ℕ × ℕ) = ⟨n,(d,m)⟩
      rw [he]
    · intro a _
      rfl
  have hInner (n : ℕ) : (∑ a ∈ n.divisorsAntidiagonal, (moebius a.1 : ℝ)) =
      (1 : ArithmeticFunction ℝ) n := by
    rw [← coe_moebius_mul_coe_zeta,ArithmeticFunction.mul_apply]
    apply sum_congr rfl
    intro a ha
    rw [natCoe_apply,zeta_apply_ne (Nat.right_ne_zero_of_mem_divisorsAntidiagonal ha),Nat.cast_one,mul_one]
    rfl
  have hB : (∑ b ∈ B, (moebius b.2.1 : ℝ)*f b.1) = f 1 := by
    dsimp only [B]
    rw [sum_sigma]
    simp_rw [← sum_mul,hInner,ArithmeticFunction.one_apply,ite_mul,one_mul,zero_mul]
    simp [mem_Icc,hN]
  exact (sum_sigma' _ _ _).trans (hPair.trans hB)

private theorem sum_moebius_floor (x : ℝ) (hx : 1 ≤ x) :
    (∑ d ∈ Icc 1 ⌊x⌋₊, (moebius d : ℝ)*(⌊x/(d:ℝ)⌋₊:ℝ)) = 1 := by
  have hN : 1 ≤ ⌊x⌋₊ := (Nat.one_le_floor_iff x).mpr hx
  have h := sum_moebius_pairs ⌊x⌋₊ hN (fun _ => 1)
  simpa [Nat.floor_div_natCast,mul_comm] using h

private theorem sum_moebius_harmonic (x : ℝ) (hx : 1 ≤ x) :
    (∑ d ∈ Icc 1 ⌊x⌋₊,
      ((moebius d : ℝ)/(d:ℝ))*(harmonic ⌊x/(d:ℝ)⌋₊ : ℝ)) = 1 := by
  have hN : 1 ≤ ⌊x⌋₊ := (Nat.one_le_floor_iff x).mpr hx
  calc
    _ = ∑ d ∈ Icc 1 ⌊x⌋₊, ∑ m ∈ Icc 1 (⌊x⌋₊/d),
        (moebius d : ℝ) * ((d*m:ℕ):ℝ)⁻¹ := by
      apply sum_congr rfl
      intro d _
      rw [Nat.floor_div_natCast,harmonic_eq_sum_Icc,Rat.cast_sum,mul_sum]
      apply sum_congr rfl
      intro m _
      push_cast
      rw [mul_inv_rev,div_eq_mul_inv]
      ring
    _ = _ := by simpa using sum_moebius_pairs ⌊x⌋₊ hN (fun k => (k:ℝ)⁻¹)

private theorem abs_moebius_real_le_one (n : ℕ) : |(moebius n : ℝ)| ≤ 1 := by
  exact_mod_cast (abs_moebius_le_one (n:=n))

private theorem floor_card_le (x : ℝ) (hx : 0 ≤ x) : ((Icc 1 ⌊x⌋₊).card : ℝ) ≤ x := by
  simpa only [Nat.card_Icc,Nat.add_sub_cancel] using Nat.floor_le hx

/-- The unweighted harmonic Möbius sum is uniformly bounded. -/
theorem abs_sum_moebius_div_le {x : ℝ} (hx : 1 ≤ x) :
    |∑ d ∈ Icc 1 ⌊x⌋₊, (moebius d : ℝ)/(d:ℝ)| ≤ 2 := by
  let S := Icc 1 ⌊x⌋₊
  let M := ∑ d ∈ S, (moebius d : ℝ)/(d:ℝ)
  let e (d : ℕ) := x/(d:ℝ)-(⌊x/(d:ℝ)⌋₊:ℝ)
  have hx₀ := zero_lt_one.trans_le hx
  have he (d : ℕ) : 0 ≤ e d ∧ e d ≤ 1 := by
    constructor
    · exact sub_nonneg.mpr (Nat.floor_le (div_nonneg hx₀.le (Nat.cast_nonneg _)))
    · have h := Nat.lt_floor_add_one (x/(d:ℝ))
      dsimp only [e]
      linarith only [h]
  have hE : |∑ d ∈ S, (moebius d : ℝ)*e d| ≤ x := calc
    _ ≤ ∑ d ∈ S, |(moebius d : ℝ)*e d| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ _d ∈ S, (1:ℝ) := by
      apply sum_le_sum
      intro d _
      rw [abs_mul,abs_of_nonneg (he d).1]
      simpa only [one_mul] using mul_le_mul (abs_moebius_real_le_one d) (he d).2 (he d).1 zero_le_one
    _ ≤ _ := by
      simp only [sum_const,nsmul_eq_mul,mul_one]
      exact floor_card_le x hx₀.le
  have hf : x*M-1 = ∑ d ∈ S, (moebius d : ℝ)*e d := by
    rw [← sum_moebius_floor x hx]
    change x*(∑ d ∈ S,(moebius d : ℝ)/(d:ℝ)) -
      (∑ d ∈ S, (moebius d : ℝ)*(⌊x/(d:ℝ)⌋₊:ℝ)) = _
    rw [mul_sum,← sum_sub_distrib]
    apply sum_congr rfl
    intro d _
    dsimp only [e]
    ring
  have hb : |x*M| ≤ x+1 := calc
    _ = |(x*M-1)+1| := by rw [sub_add_cancel]
    _ ≤ |x*M-1|+|1| := abs_add_le _ _
    _ ≤ _ := by rw [hf,abs_one]; exact add_le_add hE le_rfl
  rw [abs_mul,abs_of_pos hx₀] at hb
  have hmul : x*|M| ≤ x*2 := by linarith only [hb,hx]
  exact (mul_le_mul_iff_left₀ hx₀).mp (by simpa only [mul_comm] using hmul)

private theorem harmonic_floor_log_error {y : ℝ} (hy : 1 ≤ y) :
    |(harmonic ⌊y⌋₊ : ℝ)-Real.log y-Real.eulerMascheroniConstant| ≤ 2/y := by
  let N := ⌊y⌋₊
  have hN : 1 ≤ N := (Nat.one_le_floor_iff y).mpr hy
  have hN₀ : (0:ℝ) < N := by exact_mod_cast Nat.pos_of_ne_zero (by omega : N ≠ 0)
  have hy₀ := zero_lt_one.trans_le hy
  have hlo : (N:ℝ) ≤ y := Nat.floor_le hy₀.le
  have hhi : y < (N:ℝ)+1 := Nat.lt_floor_add_one y
  have h1 : Real.log (N:ℝ) ≤ Real.log y := Real.log_le_log hN₀ hlo
  have h2 : Real.log y ≤ Real.log ((N:ℝ)+1) := Real.log_le_log hy₀ hhi.le
  have h3 : Real.log (N:ℝ) < (harmonic N : ℝ)-Real.eulerMascheroniConstant := by
    have h := Real.eulerMascheroniConstant_lt_eulerMascheroniSeq' N
    simp only [Real.eulerMascheroniSeq',show N ≠ 0 by omega,ite_false] at h
    linarith only [h]
  have h4 : (harmonic N : ℝ)-Real.eulerMascheroniConstant < Real.log ((N:ℝ)+1) := by
    have h := Real.eulerMascheroniSeq_lt_eulerMascheroniConstant N
    dsimp only [Real.eulerMascheroniSeq] at h
    linarith only [h]
  have hb : Real.log ((N:ℝ)+1)-Real.log (N:ℝ) ≤ (N:ℝ)⁻¹ := by
    have h := Real.log_le_sub_one_of_pos (div_pos (by positivity : 0 < (N:ℝ)+1) hN₀)
    rw [Real.log_div (by positivity : (N:ℝ)+1 ≠ 0) hN₀.ne',add_div,div_self hN₀.ne',add_sub_cancel_left] at h
    exact h.trans_eq (one_div _)
  have hNy : (N:ℝ)⁻¹ ≤ 2/y := by
    rw [← one_div (N:ℝ)]
    apply (div_le_div_iff₀ hN₀ hy₀).mpr
    have hN' : (1:ℝ) ≤ N := by exact_mod_cast hN
    linarith only [hhi,hN']
  apply le_trans _ (hb.trans hNy)
  apply abs_le.mpr
  change _ ≤ (harmonic N : ℝ)-Real.log y-Real.eulerMascheroniConstant ∧ _
  constructor <;> linarith only [h1,h2,h3,h4]

/-- A logarithmic Möbius sum has a constant bound, with no prime number theorem. -/
theorem abs_sum_moebius_log_le {x : ℝ} (hx : 1 ≤ x) :
    |∑ d ∈ Icc 1 ⌊x⌋₊, ((moebius d : ℝ)/(d:ℝ))*Real.log (x/(d:ℝ))| ≤ 5 := by
  let S := Icc 1 ⌊x⌋₊
  let μd (d : ℕ) := (moebius d : ℝ)/(d:ℝ)
  let g (d : ℕ) := Real.log (x/(d:ℝ))
  let e (d : ℕ) := (harmonic ⌊x/(d:ℝ)⌋₊ : ℝ)-g d-Real.eulerMascheroniConstant
  let M := ∑ d ∈ S, μd d
  let F := ∑ d ∈ S, μd d*g d
  let E := ∑ d ∈ S, μd d*e d
  let γ := Real.eulerMascheroniConstant
  have hx₀ := zero_lt_one.trans_le hx
  have hE : |E| ≤ 2 := calc
    _ ≤ ∑ d ∈ S, |μd d*e d| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ _d ∈ S, (2:ℝ)/x := by
      apply sum_le_sum
      intro d hd
      have hd₀ : (0:ℝ) < d := by exact_mod_cast Nat.zero_lt_one.trans_le (mem_Icc.mp hd).1
      have hdx : (d:ℝ) ≤ x :=
        (Nat.cast_le.mpr (mem_Icc.mp hd).2).trans (Nat.floor_le hx₀.le)
      have hy : 1 ≤ x/(d:ℝ) := (le_div_iff₀ hd₀).mpr (by simpa only [one_mul])
      have hde : |e d| ≤ 2/(x/(d:ℝ)) := harmonic_floor_log_error hy
      have hμ : |μd d| ≤ 1/(d:ℝ) := by
        dsimp only [μd]
        rw [abs_div,abs_of_pos hd₀]
        exact div_le_div_of_nonneg_right (abs_moebius_real_le_one d) hd₀.le
      calc
        _ = |μd d| * |e d| := abs_mul _ _
        _ ≤ (1/(d:ℝ))*(2/(x/(d:ℝ))) := mul_le_mul hμ hde (abs_nonneg _) (by positivity)
        _ = _ := by field_simp
    _ ≤ _ := by
      simp only [sum_const,nsmul_eq_mul]
      have h := mul_le_mul_of_nonneg_right (floor_card_le x hx₀.le) (by positivity : 0 ≤ (2:ℝ)/x)
      exact h.trans_eq (by field_simp)
  have heq : F+γ*M+E = 1 := by
    rw [← sum_moebius_harmonic x hx]
    simp only [F,M,E,mul_sum,← sum_add_distrib,μd, g,e,γ]
    apply sum_congr rfl
    intro d _
    ring
  have hγ : |γ| ≤ 1 := by
    rw [abs_of_nonneg (by have := Real.one_half_lt_eulerMascheroniConstant; dsimp only [γ]; linarith)]
    have := Real.eulerMascheroniConstant_lt_two_thirds
    dsimp only [γ]
    linarith
  have hM : |M| ≤ 2 := abs_sum_moebius_div_le hx
  have hγM : |γ*M| ≤ 2 := by
    rw [abs_mul]
    simpa only [one_mul] using mul_le_mul hγ hM (abs_nonneg _) zero_le_one
  change |F| ≤ 5
  calc
    _ = |1-(γ*M+E)| := by rw [← heq]; congr 1; ring
    _ ≤ |1|+|γ*M+E| := abs_sub _ _
    _ ≤ |1|+(|γ*M|+|E|) := add_le_add le_rfl (abs_add_le _ _)
    _ ≤ _ := by rw [abs_one]; linarith only [hγM,hE]

end
end GoldbachMoebiusLog


namespace GoldbachMoebiusLog

open Finset ArithmeticFunction
open scoped Classical

noncomputable section

private def avoidPrimes (S : Finset ℕ) (d : ℕ) : Prop := ∀ p ∈ S, ¬p ∣ d

private def logCoefficient (x ε : ℝ) (d : ℕ) : ℝ :=
  ((moebius d : ℝ)/(d:ℝ)^(1+ε))*Real.log (x/(d:ℝ))

private def avoidLog (S : Finset ℕ) (x ε : ℝ) : ℝ :=
  ∑ d ∈ (Icc 1 ⌊x⌋₊).filter (avoidPrimes S), logCoefficient x ε d

private theorem avoidLog_of_lt_one (S : Finset ℕ) {x ε : ℝ} (hx : x < 1) :
    avoidLog S x ε = 0 := by
  simp [avoidLog,Nat.floor_eq_zero.mpr hx]

private theorem avoid_insert {S : Finset ℕ} {p d : ℕ} :
    avoidPrimes (insert p S) d ↔ avoidPrimes S d ∧ ¬p ∣ d := by
  simp [avoidPrimes,and_comm]

private theorem avoid_mul_prime {S : Finset ℕ} {p d : ℕ} (hp : p.Prime) (hpS : p ∉ S)
    (hS : ∀ l ∈ S, l.Prime) : avoidPrimes S (p*d) ↔ avoidPrimes S d := by
  constructor
  · intro h l hl hd
    exact h l hl (dvd_mul_of_dvd_right hd p)
  · intro h l hl hpd
    rcases (hS l hl).dvd_mul.mp hpd with h₁ | h₂
    · exact hpS ((Nat.prime_dvd_prime_iff_eq (hS l hl) hp).mp h₁ ▸ hl)
    · exact h l hl h₂

private theorem moebius_prime_mul {p d : ℕ} (hp : p.Prime) :
    moebius (p*d) = if p ∣ d then 0 else -moebius d := by
  classical
  by_cases hd : p ∣ d
  · rw [ite_eq_left hd]
    apply moebius_eq_zero_of_not_squarefree
    intro h
    have hu := h p (mul_dvd_mul (dvd_refl p) hd)
    exact hp.ne_one (Nat.isUnit_iff.mp hu)
  · rw [ite_eq_right hd,isMultiplicative_moebius.map_mul_of_coprime (hp.coprime_iff_not_dvd.mpr hd),
      moebius_apply_prime hp,neg_one_mul]

set_option maxHeartbeats 800000 in
private theorem remove_prime {S : Finset ℕ} {p : ℕ} (hp : p.Prime) (hpS : p ∉ S)
    (hS : ∀ l ∈ S, l.Prime) (x ε : ℝ) :
    avoidLog (insert p S) x ε =
      avoidLog S x ε + ((p:ℝ)^(1+ε))⁻¹*avoidLog (insert p S) (x/(p:ℝ)) ε := by
  let U := (Icc 1 ⌊x⌋₊).filter (avoidPrimes S)
  let V := (Icc 1 ⌊x/(p:ℝ)⌋₊).filter (avoidPrimes S)
  have hins : U.filter (fun d => ¬p ∣ d) = (Icc 1 ⌊x⌋₊).filter (avoidPrimes (insert p S)) := by
    ext d
    simp only [U,mem_filter,avoid_insert]
    tauto
  have hins' : V.filter (fun d => ¬p ∣ d) = (Icc 1 ⌊x/(p:ℝ)⌋₊).filter (avoidPrimes (insert p S)) := by
    ext d
    simp only [V,mem_filter,avoid_insert]
    tauto
  have hU : (∑ d ∈ V, logCoefficient x ε (p*d)) =
      ∑ d ∈ U.filter (fun d => p ∣ d), logCoefficient x ε d := by
    refine sum_bij (fun d _ => p*d) ?_ ?_ ?_ ?_
    · intro d hd
      obtain ⟨hI,hAvoid⟩ := mem_filter.mp hd
      obtain ⟨hd₁,hd₂⟩ := mem_Icc.mp hI
      have hN : p*d ≤ ⌊x⌋₊ := by
        rw [Nat.floor_div_natCast] at hd₂
        simpa only [Nat.mul_comm] using (Nat.le_div_iff_mul_le hp.pos).mp hd₂
      have hd₀ : 0 < d := Nat.zero_lt_one.trans_le hd₁
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.mul_pos hp.pos hd₀,hN⟩,
        (avoid_mul_prime hp hpS hS).2 hAvoid⟩,⟨d,rfl⟩⟩
    · intro d _ d' _ he
      exact Nat.eq_of_mul_eq_mul_left hp.pos he
    · intro d hd
      obtain ⟨hdU,hdD⟩ := mem_filter.mp hd
      obtain ⟨hdI,hdA⟩ := mem_filter.mp hdU
      obtain ⟨hd₁,hd₂⟩ := mem_Icc.mp hdI
      obtain ⟨m,rfl⟩ := hdD
      have hm₀ : 0 < m := Nat.pos_of_ne_zero (fun h => by simp [h] at hd₁)
      have hm₁ : m ≤ ⌊x/(p:ℝ)⌋₊ := by
        rw [Nat.floor_div_natCast]
        exact (Nat.le_div_iff_mul_le hp.pos).mpr (by simpa only [Nat.mul_comm] using hd₂)
      exact ⟨m,mem_filter.mpr ⟨mem_Icc.mpr ⟨hm₀,hm₁⟩,(avoid_mul_prime hp hpS hS).1 hdA⟩,rfl⟩
    · intro _ _
      rfl
  have hterm (d : ℕ) : logCoefficient x ε (p*d) =
      if p ∣ d then 0 else -(((p:ℝ)^(1+ε))⁻¹*logCoefficient (x/(p:ℝ)) ε d) := by
    unfold logCoefficient
    rw [moebius_prime_mul hp]
    by_cases hd : p ∣ d
    · simp [hd]
    · simp only [hd,ite_false,Int.cast_neg,Nat.cast_mul,Real.mul_rpow (Nat.cast_nonneg _)
        (Nat.cast_nonneg _),div_div]
      simp only [div_eq_mul_inv,mul_inv_rev]
      ring
  have hpick := sum_filter_add_sum_filter_not U (fun d => p ∣ d) (logCoefficient x ε)
  rw [hins,← hU] at hpick
  have hpull : (∑ d ∈ V, logCoefficient x ε (p*d)) =
        -(((p:ℝ)^(1+ε))⁻¹*avoidLog (insert p S) (x/(p:ℝ)) ε) := by
    unfold avoidLog
    rw [← hins',mul_sum,← sum_neg_distrib]
    symm
    rw [sum_filter]
    apply sum_congr rfl
    intro d _
    rw [hterm]
    by_cases hd : p ∣ d <;> simp [hd]
  rw [hpull] at hpick
  have he : -(((p:ℝ)^(1+ε))⁻¹*avoidLog (insert p S) (x/(p:ℝ)) ε) +
      avoidLog (insert p S) x ε = avoidLog S x ε := hpick
  linarith only [he]


end
end GoldbachMoebiusLog

end

section

/-!
The theta coefficient substitutes a finite common-period estimate in
J. Pintz, arXiv:1804.05552, (3.36)–(3.38). The Barban–Vehov coefficient
uses D. Berkane, NNTDM 20(2), 35–43, Sections 3–4, with the finite
Selberg identity and a squarefree reciprocal-totient bound.
-/


namespace GoldbachPintzTheta

open Finset

noncomputable section

private theorem coprime_period_count (q k : ℕ) :
    ((Finset.range (q * k)).filter (fun n => q.Coprime n)).card = k * q.totient := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [Nat.mul_succ, Finset.range_eq_Ico, ← Finset.Ico_union_Ico_eq_Ico
        (Nat.zero_le (q * k)) (Nat.le_add_right (q * k) q), Finset.filter_union]
      have hdisj : Disjoint ((Finset.Ico 0 (q * k)).filter (fun n => q.Coprime n))
          ((Finset.Ico (q * k) (q * k + q)).filter (fun n => q.Coprime n)) := by
        apply Finset.disjoint_left.mpr
        intro n hn hn'
        exact (not_lt_of_ge (Finset.mem_Ico.mp (Finset.mem_filter.mp hn').1).1)
          (Finset.mem_Ico.mp (Finset.mem_filter.mp hn).1).2
      rw [Finset.card_union_of_disjoint hdisj, ← Finset.range_eq_Ico, ih,
        Nat.filter_coprime_Ico_eq_totient, Nat.succ_mul]

private theorem card_coprime_multiples {P q d : ℕ} (hP : 0 < P) (hd : d ∣ P) :
    ((Finset.range (q * P)).filter (fun n => q.Coprime n ∧ d ∣ n)).card =
      if q.Coprime d then (P / d) * q.totient else 0 := by
  have hdpos : 0 < d := Nat.pos_of_ne_zero (ne_zero_of_dvd_ne_zero hP.ne' hd)
  by_cases hq : q.Coprime d
  · rw [ite_eq_left hq, ← coprime_period_count]
    symm
    apply Finset.card_bij (fun n _ => d * n)
    · intro n hn
      obtain ⟨hn, hnc⟩ := Finset.mem_filter.mp hn
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_range.mpr ?_, (Nat.coprime_mul_iff_right.mpr ⟨hq, hnc⟩), dvd_mul_right _ _⟩
      have hh := Nat.mul_lt_mul_of_pos_left (Finset.mem_range.mp hn) hdpos
      rwa [Nat.mul_left_comm d q (P / d), Nat.mul_div_cancel' hd] at hh
    · intro n _ m _ hn
      exact Nat.eq_of_mul_eq_mul_left hdpos hn
    · intro n hn
      obtain ⟨hn, hnc, hdn⟩ := Finset.mem_filter.mp hn
      obtain ⟨k, rfl⟩ := hdn
      refine ⟨k, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr ?_, (Nat.coprime_mul_iff_right.mp hnc).2⟩, rfl⟩
      apply (Nat.mul_lt_mul_left hdpos).mp
      rw [Nat.mul_left_comm d q (P / d), Nat.mul_div_cancel' hd]
      exact Finset.mem_range.mp hn
  · rw [ite_eq_right hq, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro n _ h
    exact hq (h.1.coprime_dvd_right h.2)

/-- The finite Dirichlet polynomial at one with both divisors coprime to the modulus. -/
def quadratic (S : Finset ℕ) (θ : ℕ → ℝ) (q : ℕ) : ℝ :=
  ∑ d ∈ S.filter (fun d => q.Coprime d), ∑ e ∈ S.filter (fun e => q.Coprime e),
    θ d * θ e / (d.lcm e : ℝ)

private theorem period_square_eq {P q : ℕ} (hP : 0 < P)
    (S : Finset ℕ) (hS : ∀ d ∈ S, d ∣ P) (θ : ℕ → ℝ) :
    (∑ n ∈ (Finset.range (q * P)).filter (fun n => q.Coprime n),
      (∑ d ∈ S, if d ∣ n then θ d else 0) ^ 2) =
        ((P : ℝ) * (q.totient : ℝ)) * quadratic S θ q := by
  classical
  have hcount (d : ℕ) (hd : d ∣ P) :
      (((Finset.range (q * P)).filter (fun n => q.Coprime n ∧ d ∣ n)).card : ℝ) =
        if q.Coprime d then (P : ℝ) * (q.totient : ℝ) / (d : ℝ) else 0 := by
    rw [card_coprime_multiples hP hd]
    split_ifs
    · have hc : (d : ℝ) ≠ 0 := by
        exact_mod_cast ne_zero_of_dvd_ne_zero hP.ne' hd
      rw [Nat.cast_mul, Nat.cast_div hd hc]
      ring
    · simp
  have expand (n : ℕ) : (∑ d ∈ S, if d ∣ n then θ d else 0) ^ 2 =
      ∑ d ∈ S, ∑ e ∈ S, if d.lcm e ∣ n then θ d * θ e else 0 := by
    simp only [sq, sum_mul_sum]
    apply sum_congr rfl
    intro d _
    apply sum_congr rfl
    intro e _
    by_cases hd : d ∣ n <;> by_cases he : e ∣ n <;> simp [Nat.lcm_dvd_iff, hd, he]
  calc
    _ = ∑ d ∈ S, ∑ e ∈ S,
        ∑ n ∈ (Finset.range (q * P)).filter (fun n => q.Coprime n),
          if d.lcm e ∣ n then θ d * θ e else 0 := by
      simp only [expand]
      rw [sum_comm]
      apply sum_congr rfl
      intro d _
      rw [sum_comm]
    _ = ∑ d ∈ S, ∑ e ∈ S,
        if q.Coprime d ∧ q.Coprime e then (P : ℝ) * (q.totient : ℝ) * (θ d * θ e / (d.lcm e : ℝ))
          else 0 := by
      apply sum_congr rfl
      intro d hd
      apply sum_congr rfl
      intro e he
      have hc : q.Coprime (d.lcm e) ↔ q.Coprime d ∧ q.Coprime e :=
        ⟨fun h => ⟨h.coprime_dvd_right (Nat.dvd_lcm_left d e),
          h.coprime_dvd_right (Nat.dvd_lcm_right d e)⟩,
          fun h => (Nat.coprime_mul_iff_right.mpr h).coprime_dvd_right (Nat.lcm_dvd_mul d e)⟩
      rw [← sum_filter, filter_filter, sum_const, nsmul_eq_mul, hcount _ (Nat.lcm_dvd (hS d hd) (hS e he))]
      simp only [hc]
      split_ifs <;> ring
    _ = _ := by
      simp_rw [quadratic, mul_sum, sum_filter, ite_sum_zero, ← ite_and]

/-- Restricting the nonnegative divisor-square to units only decreases its spatial
mean. This is the principal residue inequality, proved by a common period. -/
theorem principal_residue_le {P q : ℕ} (hP : 0 < P) (hq : 0 < q)
    (S : Finset ℕ) (hS : ∀ d ∈ S, d ∣ P) (θ : ℕ → ℝ) :
    ((q.totient : ℝ) / (q : ℝ)) * quadratic S θ q ≤ quadratic S θ 1 := by
  classical
  have hM : 0 < q * P := Nat.mul_pos hq hP
  have hS' (d : ℕ) (hd : d ∈ S) : d ∣ q * P := (hS d hd).trans (dvd_mul_left _ _)
  have he := period_square_eq (q := 1) hM S hS' θ
  simp at he
  have hcomp : (∑ n ∈ (Finset.range (q * P)).filter (fun n => q.Coprime n),
      (∑ d ∈ S, if d ∣ n then θ d else 0) ^ 2) ≤
      ∑ n ∈ Finset.range (q * P), (∑ d ∈ S, if d ∣ n then θ d else 0) ^ 2 :=
    sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun _ _ _ => sq_nonneg _)
  rw [period_square_eq (q := q) hP S hS θ, he] at hcomp
  have hqR : 0 < (q : ℝ) := by exact_mod_cast hq
  have hPR : 0 < (P : ℝ) := by exact_mod_cast hP
  have hd : (((q.totient : ℝ) / (q : ℝ)) * quadratic S θ q) * ((q : ℝ) * (P : ℝ)) =
      ((P : ℝ) * (q.totient : ℝ)) * quadratic S θ q := by
    field_simp
  exact le_of_mul_le_mul_right (show _ * ((q : ℝ) * (P : ℝ)) ≤ _ * ((q : ℝ) * (P : ℝ)) from
    by rw [hd, mul_comm (quadratic S θ 1)]; exact hcomp) (mul_pos hqR hPR)

end
end GoldbachPintzTheta

namespace GoldbachPintzTheta

open Finset
open Conjectures.Goldbach.ShiftPairSieve.Foundation
open Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337
open Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337.SelbergOptimal

noncomputable section

private def ordinarySieve (y : ℕ) : BoundingSieve where
  support := ∅
  prodPrimes := primorial y
  prodPrimes_squarefree := squarefree_primorial y
  weights := fun _ => 0
  weights_nonneg := fun _ => le_rfl
  totalMass := 0
  nu := ⟨fun d => ((d : ℝ)⁻¹), by simp⟩
  nu_mult := ⟨by change ((1 : ℕ) : ℝ)⁻¹ = 1; norm_num, fun {d e} _ => by
    change ((↑(d * e) : ℝ)⁻¹) = (d : ℝ)⁻¹ * (e : ℝ)⁻¹
    simp only [Nat.cast_mul, mul_inv]⟩
  nu_pos_of_prime := fun p hp _ => by
    change 0 < (p : ℝ)⁻¹
    exact inv_pos.mpr (by exact_mod_cast hp.pos)
  nu_lt_one_of_prime := fun p hp _ => by
    change (p : ℝ)⁻¹ < 1
    exact inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt)

private def g (p : ℕ) : ℝ := (p : ℝ)⁻¹ * (1 - (p : ℝ)⁻¹)⁻¹
private def index (s : Finset ℕ) : ℕ := ∏ p ∈ s, p
private def weight (s : Finset ℕ) : ℝ := ∏ p ∈ s, g p
private def mass (y : ℕ) : ℝ := ∏ p ∈ y.primesLE, (1 + g p)


private theorem normalizer_as_sum (y z : ℕ) : normalizer (ordinarySieve y) z =
    ∑ t ∈ y.primesLE.powerset, if index t ≤ z then weight t else 0 := by
  let P := primorial y
  let B := ordinarySieve y
  have prime (t : Finset ℕ) (ht : t ∈ y.primesLE.powerset) : ∀ p ∈ t, p.Prime :=
    fun p hp => Nat.prime_of_mem_primesLE ((Finset.mem_powerset.mp ht) hp)
  have hfac (t : Finset ℕ) (ht : t ∈ y.primesLE.powerset) :
      (index t).primeFactors = t := Nat.primeFactors_prod (prime t ht)
  have hmap : P.divisors = y.primesLE.powerset.image index := by
    ext d
    constructor
    · intro hd
      have hsq := (squarefree_primorial y).squarefree_of_dvd (Nat.dvd_of_mem_divisors hd)
      have hmono := Nat.primeFactors_mono (Nat.dvd_of_mem_divisors hd) (primorial_ne_zero y)
      rw [primeFactors_primorial] at hmono
      exact Finset.mem_image.mpr ⟨d.primeFactors, Finset.mem_powerset.mpr hmono, Nat.prod_primeFactors_of_squarefree hsq⟩
    · rintro hd
      obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hd
      exact Nat.mem_divisors.mpr ⟨Finset.prod_dvd_prod_of_subset _ _ _ (Finset.mem_powerset.mp ht), primorial_ne_zero y⟩
  unfold normalizer
  change (∑ d ∈ P.divisors, if d ≤ z then B.selbergTerms d else 0) = _
  rw [hmap, Finset.sum_image (fun a ha b hb hh => (hfac a ha).symm.trans ((congrArg Nat.primeFactors hh).trans (hfac b hb)))]
  refine Finset.sum_congr rfl fun t ht => ?_
  split_ifs
  · rw [BoundingSieve.selbergTerms_apply, hfac t ht, index, B.nu_mult.map_prod_of_prime t (prime t ht)]
    exact (Finset.prod_mul_distrib).symm
  · rfl


private theorem optimal_abs (s : BoundingSieve) {z : ℕ} (hz : 1 ≤ z) (d : ℕ) :
    |optimalWeight s z d| ≤ 1 := by
  by_cases hd : d ∣ s.prodPrimes
  · rw [optimalWeight_formula s z d hd]
    convert abs_normalized_complement_le_one s hz hd using 1
    unfold complementNormalizer
    congr 1
    ring
  · simp [optimalWeight, hd]

private theorem quadratic_subset {S T : Finset ℕ} (h : S ⊆ T) (θ : ℕ → ℝ) (q : ℕ)
    (hθ : ∀ d ∈ T, d ∉ S → θ d = 0) : quadratic S θ q = quadratic T θ q := by
  classical
  unfold quadratic
  have hs : S.filter (fun d => q.Coprime d) ⊆ T.filter (fun d => q.Coprime d) :=
    fun x hx => Finset.mem_filter.mpr ⟨h (Finset.mem_filter.mp hx).1, (Finset.mem_filter.mp hx).2⟩
  have hz (d : ℕ) (hd : d ∈ T.filter (fun d => q.Coprime d))
      (hd' : d ∉ S.filter (fun d => q.Coprime d)) : θ d = 0 := by
    obtain ⟨he,hq⟩ := Finset.mem_filter.mp hd
    exact hθ d he (fun hh => hd' (Finset.mem_filter.mpr ⟨hh,hq⟩))
  calc
    _ = ∑ d ∈ S.filter (fun d => q.Coprime d), ∑ e ∈ T.filter (fun e => q.Coprime e),
        θ d * θ e / (d.lcm e : ℝ) := by
      apply Finset.sum_congr rfl
      intro d _
      exact Finset.sum_subset hs (fun e he he' => by rw [hz e he he']; simp)
    _ = _ := Finset.sum_subset hs (fun d hd hd' => by rw [hz d hd hd']; simp)


end
end GoldbachPintzTheta


namespace GoldbachPintzTheta

open Finset ArithmeticFunction
open Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337

noncomputable section

/-- The unnormalized truncated Möbius logarithm. -/
def mobiusLogWeight (y : ℝ) (d : ℕ) : ℝ :=
  if d ≤ ⌊y⌋₊ then (moebius d : ℝ) * Real.log (y / d) else 0

private def rpowSieve (Y : ℕ) (s : ℝ) (hs : 0 < s) : BoundingSieve where
  support := ∅
  prodPrimes := primorial Y
  prodPrimes_squarefree := squarefree_primorial Y
  weights := fun _ => 0
  weights_nonneg := fun _ => le_rfl
  totalMass := 0
  nu := ⟨fun d => ((d : ℝ) ^ s)⁻¹, by simp [hs.ne']⟩
  nu_mult := ⟨by change (((1 : ℕ) : ℝ) ^ s)⁻¹ = 1; simp, fun {d e} _ => by
    change (((↑(d * e) : ℝ) ^ s)⁻¹) = ((d : ℝ) ^ s)⁻¹ * ((e : ℝ) ^ s)⁻¹
    simp only [Nat.cast_mul, Real.mul_rpow (Nat.cast_nonneg d) (Nat.cast_nonneg e), mul_inv]⟩
  nu_pos_of_prime := fun p hp _ => by
    change 0 < ((p : ℝ) ^ s)⁻¹
    exact inv_pos.mpr (Real.rpow_pos_of_pos (by exact_mod_cast hp.pos) s)
  nu_lt_one_of_prime := fun p hp _ => by
    change ((p : ℝ) ^ s)⁻¹ < 1
    have hpr : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
    exact inv_lt_one_of_one_lt₀ (by simpa using Real.rpow_lt_rpow_of_exponent_lt hpr hs)

private theorem squarefree_dvd_primorial_of_le {d Y : ℕ} (hd : Squarefree d)
    (hY : d ≤ Y) : d ∣ primorial Y := by
  rw [← Nat.prod_primeFactors_of_squarefree hd, primorial_eq_prod_primesLE]
  exact Finset.prod_dvd_prod_of_subset _ _ _ fun p hp =>
    Nat.mem_primesLE.mpr ⟨(Nat.le_of_dvd (Nat.pos_of_ne_zero hd.ne_zero)
      (Nat.dvd_of_mem_primeFactors hp)).trans hY, Nat.prime_of_mem_primeFactors hp⟩


private theorem rpow_coordinate (y : ℝ) {r : ℕ} {s : ℝ} (hs : 0 < s)
    (hr : r ∣ primorial ⌊y⌋₊) :
    (∑ d ∈ (primorial ⌊y⌋₊).divisors, if r ∣ d then
        (rpowSieve ⌊y⌋₊ s hs).nu d * mobiusLogWeight y d else 0) =
      (rpowSieve ⌊y⌋₊ s hs).nu r * (moebius r : ℝ) *
        (∑ k ∈ (Icc 1 ⌊y / (r : ℝ)⌋₊).filter (fun k => r.Coprime k),
          ((moebius k : ℝ) / (k : ℝ)^s) * Real.log ((y / (r : ℝ)) / k)) := by
  classical
  let Y := ⌊y⌋₊
  let P := primorial Y
  let B := rpowSieve Y s hs
  let D := (P.divisors.filter (fun d => r ∣ d)).filter (fun d => d ≤ Y)
  let K := (Icc 1 (Y / r)).filter (fun k => r.Coprime k)
  let L := K.filter Squarefree
  have hrp : 0 < r := Nat.pos_of_ne_zero (ne_zero_of_dvd_ne_zero (primorial_ne_zero Y) hr)
  have hrs := (squarefree_primorial Y).squarefree_of_dvd hr
  have hbij :
      (∑ d ∈ D, B.nu d * ((moebius d : ℝ) * Real.log (y / d))) =
        ∑ k ∈ L, B.nu (r*k) * ((moebius (r*k) : ℝ) * Real.log (y / ((r*k : ℕ) : ℝ))) := by
    symm
    refine Finset.sum_bij (fun k _ => r*k) ?_ ?_ ?_ ?_
    · intro k hk
      obtain ⟨hk, hksq⟩ := mem_filter.mp hk
      obtain ⟨hki, hcop⟩ := mem_filter.mp hk
      have hle : r*k ≤ Y := by
        rw [Nat.mul_comm]
        exact (Nat.le_div_iff_mul_le hrp).mp (mem_Icc.mp hki).2
      have hsq := (Nat.squarefree_mul hcop).mpr ⟨hrs, hksq⟩
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨Nat.mem_divisors.mpr
        ⟨squarefree_dvd_primorial_of_le hsq hle, primorial_ne_zero _⟩, dvd_mul_right _ _⟩, hle⟩
    · intro k _ j _ he
      exact Nat.eq_of_mul_eq_mul_left hrp he
    · intro d hd
      obtain ⟨hd, hdY⟩ := mem_filter.mp hd
      obtain ⟨hdP, hrd⟩ := mem_filter.mp hd
      obtain ⟨k, rfl⟩ := hrd
      have hsq := (squarefree_primorial Y).squarefree_of_dvd (Nat.dvd_of_mem_divisors hdP)
      obtain ⟨hcop, _, hksq⟩ := Nat.squarefree_mul_iff.mp hsq
      have hl : k ≤ Y / r := (Nat.le_div_iff_mul_le hrp).mpr (by rwa [Nat.mul_comm])
      exact ⟨k, mem_filter.mpr ⟨mem_filter.mpr
        ⟨mem_Icc.mpr ⟨Nat.pos_of_ne_zero hksq.ne_zero, hl⟩, hcop⟩, hksq⟩, rfl⟩
    · intro k _
      rfl
  have hdrop :
      (∑ k ∈ L, ((moebius k : ℝ) / (k : ℝ)^s) * Real.log ((y / (r : ℝ)) / k)) =
      ∑ k ∈ K, ((moebius k : ℝ) / (k : ℝ)^s) * Real.log ((y / (r : ℝ)) / k) := by
    refine Finset.sum_subset (Finset.filter_subset _ _) fun k hk hkn => ?_
    have hn : ¬Squarefree k := fun h => hkn (mem_filter.mpr ⟨hk,h⟩)
    simp [moebius_eq_zero_of_not_squarefree hn]
  rw [Nat.floor_div_natCast]
  change (∑ d ∈ P.divisors, if r ∣ d then B.nu d * mobiusLogWeight y d else 0) =
    B.nu r * (moebius r : ℝ) * ∑ k ∈ K, ((moebius k : ℝ) / (k : ℝ)^s) * Real.log ((y / (r : ℝ)) / k)
  calc
    _ = ∑ d ∈ D, B.nu d * ((moebius d : ℝ) * Real.log (y / d)) := by
      simp only [D, Finset.sum_filter, mobiusLogWeight, mul_ite, mul_zero, Y]
    _ = _ := hbij
    _ = B.nu r * (moebius r : ℝ) *
        (∑ k ∈ L, ((moebius k : ℝ) / (k : ℝ)^s) * Real.log ((y / (r : ℝ)) / k)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      have hcop := (mem_filter.mp (mem_filter.mp hk).1).2
      rw [B.nu_mult.map_mul_of_coprime hcop, isMultiplicative_moebius.map_mul_of_coprime hcop,
        Int.cast_mul, Nat.cast_mul, div_div]
      change B.nu r * ((k : ℝ)^s)⁻¹ * ((moebius r : ℝ) * (moebius k : ℝ) * _) = _
      ring
    _ = _ := by rw [hdrop]

/-- Finite rpow quadratic form for a truncated divisor coefficient. -/
def rpowForm (S : Finset ℕ) (a : ℕ → ℝ) (s : ℝ) : ℝ :=
  ∑ d ∈ S, ∑ e ∈ S, a d * a e / ((d.lcm e : ℕ) : ℝ)^s

private theorem rpow_form_subset {S T : Finset ℕ} (h : S ⊆ T) (a : ℕ → ℝ) (s : ℝ)
    (hz : ∀ d ∈ T, d ∉ S → a d = 0) : rpowForm S a s = rpowForm T a s := by
  unfold rpowForm
  calc
    _ = ∑ d ∈ S, ∑ e ∈ T, a d * a e / ((d.lcm e : ℕ) : ℝ)^s := by
      apply Finset.sum_congr rfl
      intro d _
      exact Finset.sum_subset h (fun e he hen => by rw [hz e he hen]; simp)
    _ = _ := Finset.sum_subset h (fun d hd hdn => by rw [hz d hd hdn]; simp)

private theorem rpow_main_of_support {Y : ℕ} {s : ℝ} (hs : 0 < s) (a : ℕ → ℝ)
    (ha : ∀ d, Y < d ∨ ¬Squarefree d → a d = 0) :
    rpowForm (Icc 1 Y) a s =
      (rpowSieve Y s hs).mainSum (BoundingSieve.lambdaSquared a) := by
  classical
  let P := primorial Y
  let T := (Icc 1 Y).filter Squarefree
  have hT : T ⊆ P.divisors := by
    intro d hd
    obtain ⟨hi,hq⟩ := mem_filter.mp hd
    exact Nat.mem_divisors.mpr ⟨squarefree_dvd_primorial_of_le hq (mem_Icc.mp hi).2,
      primorial_ne_zero Y⟩
  have hT₁ : rpowForm T a s = rpowForm (Icc 1 Y) a s := by
    refine rpow_form_subset (Finset.filter_subset _ _) a s fun d hd hdt => ha d (.inr ?_)
    exact fun hn => hdt (mem_filter.mpr ⟨hd,hn⟩)
  have hT₂ : rpowForm T a s = rpowForm P.divisors a s := by
    refine rpow_form_subset hT a s fun d hd hdt => ha d (.inl (lt_of_not_ge ?_))
    exact fun hle => hdt (mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hd,hle⟩,
      (squarefree_primorial Y).squarefree_of_dvd (Nat.dvd_of_mem_divisors hd)⟩)
  rw [← hT₁, hT₂]
  unfold BoundingSieve.mainSum
  change rpowForm P.divisors a s =
    ∑ d ∈ P.divisors, BoundingSieve.lambdaSquared a d * (rpowSieve Y s hs).nu d
  rw [Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337.SelbergError.sum_lambdaSquared_mul
    P (primorial_ne_zero Y)]
  simp only [rpowForm, div_eq_mul_inv]
  rfl


end
end GoldbachPintzTheta

namespace GoldbachPintzTheta

open Finset ArithmeticFunction

noncomputable section

/-- Pintz's `ψ` coefficient, expressed as the difference of two truncated
Möbius logarithms. -/
def barbanVehov (U V : ℝ) (d : ℕ) : ℝ :=
  (mobiusLogWeight V d - mobiusLogWeight U d) / Real.log (V/U)

theorem barbanVehov_eq_moebius {U V : ℝ} {d : ℕ} (hU : 0 < U) (hUV : U < V)
    (hd : 0 < d) (hdU : (d : ℝ) ≤ U) : barbanVehov U V d = (moebius d : ℝ) := by
  have hV : 0 < V := hU.trans hUV
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hl : 0 < Real.log (V / U) := Real.log_pos ((one_lt_div hU).mpr hUV)
  rw [barbanVehov, mobiusLogWeight, mobiusLogWeight,
    ite_eq_left (Nat.le_floor (hdU.trans hUV.le)), ite_eq_left (Nat.le_floor hdU),
    Real.log_div hV.ne' hdR.ne', Real.log_div hU.ne' hdR.ne']
  have hden := (Real.log_div hV.ne' hU.ne')
  rw [div_eq_iff hl.ne', hden]
  ring

theorem barbanVehov_zero {U V : ℝ} (hU : 0 ≤ U) (hUV : U ≤ V)
    {d : ℕ} (hd : V < (d : ℝ)) : barbanVehov U V d = 0 := by
  have hnot (x : ℝ) (hx : 0 ≤ x) (h : x < (d : ℝ)) : ¬d ≤ ⌊x⌋₊ := by
    intro hc
    exact h.not_ge ((show (d : ℝ) ≤ (⌊x⌋₊ : ℝ) by exact_mod_cast hc).trans (Nat.floor_le hx))
  simp [barbanVehov, mobiusLogWeight, hnot V (hU.trans hUV) hd, hnot U hU (hUV.trans_lt hd)]


end
end GoldbachPintzTheta

namespace GoldbachPintzTheta

open Finset ArithmeticFunction

noncomputable section

/-- Pintz's lower (U) cutoff yields exact cancellation after convolution with 1. -/
theorem barbanVehov_divisor_sum_zero {U V : ℝ} (hU : 0 < U) (hUV : U < V)
    {n : ℕ} (hn : 1 < n) (hnU : (n : ℝ) ≤ U) :
    (∑ d ∈ n.divisors, barbanVehov U V d) = 0 := by
  calc
    _ = ∑ d ∈ n.divisors, (moebius d : ℝ) := by
      apply sum_congr rfl
      intro d hd
      have hdn : d ≤ n := Nat.le_of_dvd (by omega) (Nat.dvd_of_mem_divisors hd)
      have hdnR : (d : ℝ) ≤ n := by exact_mod_cast hdn
      exact barbanVehov_eq_moebius hU hUV (Nat.pos_of_mem_divisors hd) (hdnR.trans hnU)
    _ = ((moebius : ArithmeticFunction ℝ) * (zeta : ArithmeticFunction ℝ)) n := by
      simpa only [intCoe_apply] using
        (coe_mul_zeta_apply (f := (moebius : ArithmeticFunction ℝ)) (x := n)).symm
    _ = 0 := by
      rw [coe_moebius_mul_coe_zeta, ArithmeticFunction.one_apply, ite_eq_right hn.ne']

theorem abs_barbanVehov_le_one {U V : ℝ} (hU : 0 < U) (hUV : U < V) (d : ℕ) :
    |barbanVehov U V d| ≤ 1 := by
  by_cases hd : d = 0
  · subst d
    simp [barbanVehov, mobiusLogWeight]
  have hdp : 0 < d := Nat.pos_of_ne_zero hd
  have hdR : (0 : ℝ) < d := by exact_mod_cast hdp
  by_cases hdu : (d : ℝ) ≤ U
  · rw [barbanVehov_eq_moebius hU hUV hdp hdu]
    exact_mod_cast (abs_moebius_le_one (n := d))
  by_cases hdv : (d : ℝ) ≤ V
  · have hdn : ¬ d ≤ ⌊U⌋₊ := fun hn => hdu
      ((show (d : ℝ) ≤ (⌊U⌋₊ : ℝ) by exact_mod_cast hn).trans (Nat.floor_le hU.le))
    have hlog : 0 < Real.log (V / U) := Real.log_pos ((one_lt_div hU).mpr hUV)
    have hV := hU.trans hUV
    have hq : 1 ≤ V / (d : ℝ) := (one_le_div hdR).mpr hdv
    have hlogn : 0 ≤ Real.log (V / (d : ℝ)) := Real.log_nonneg hq
    have hp : V / (d : ℝ) ≤ V / U :=
      div_le_div_of_nonneg_left hV.le hU (le_of_not_ge hdu)
    have hM : |(moebius d : ℝ)| ≤ 1 := by exact_mod_cast (abs_moebius_le_one (n := d))
    rw [barbanVehov, mobiusLogWeight, ite_eq_left (Nat.le_floor hdv),
      mobiusLogWeight, ite_eq_right hdn, sub_zero, abs_div, abs_of_pos hlog, abs_mul,
      abs_of_nonneg hlogn, div_le_one hlog]
    exact (mul_le_of_le_one_left hlogn hM).trans (Real.log_le_log (by linarith) hp)
  · rw [barbanVehov_zero hU.le hUV.le (lt_of_not_ge hdv), abs_zero]
    norm_num

theorem barbanVehov_one {U V : ℝ} (hU : 1 ≤ U) (hUV : U < V) :
    barbanVehov U V 1 = 1 := by
  rw [barbanVehov_eq_moebius (by linarith) hUV (by decide) (by simpa using hU)]
  simp

end
end GoldbachPintzTheta


namespace GoldbachPintzTheta

open Finset

/-- The restricted LCM form is a common-period mean of real squares. -/
theorem quadratic_nonneg (S : Finset ℕ) (θ : ℕ → ℝ) {q : ℕ} (hq : 0 < q)
    (hS : ∀ d ∈ S, 0 < d) : 0 ≤ quadratic S θ q := by
  classical
  let P := ∏ d ∈ S, d
  have hP : 0 < P := Finset.prod_pos hS
  have hdiv (d : ℕ) (hd : d ∈ S) : d ∣ P := Finset.dvd_prod_of_mem id hd
  have hsum : 0 ≤ ∑ n ∈ (Finset.range (q*P)).filter (fun n => q.Coprime n),
      (∑ d ∈ S, if d ∣ n then θ d else 0)^2 :=
    Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  rw [period_square_eq hP S hdiv θ] at hsum
  have hPR : (0 : ℝ) < P := by exact_mod_cast hP
  have hφ : (0 : ℝ) < q.totient := by exact_mod_cast Nat.totient_pos.mpr hq
  exact nonneg_of_mul_nonneg_right hsum (mul_pos hPR hφ)

end GoldbachPintzTheta

