section

namespace GoldbachPintzFamily

open Finset Complex Goldbach GoldbachTwistedMellin GoldbachTypeII GoldbachPintzHalasz
  GoldbachPintzScales GoldbachPintzDetector GoldbachPintzTheta GoldbachCubicRiesz GoldbachSpectralGeometry
open scoped Classical ComplexConjugate

noncomputable section

/-- The detector with all three canonical lengths and the short normalization at `U`. -/
def canonicalDetector {Q : ℕ} (T : ℝ) (θ : ℕ → ℝ) (r : TaggedZero Q) : ℂ :=
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let V := U*W
  let Y := upperScale (Q:ℝ) T
  primitiveDetector (support Y) (support V) (support W) (differenceWeight Y U) (barbanVehov U V) θ r

/-- The Gram entry at the canonical lengths, using the common product level. -/
def canonicalGram {Q : ℕ} (T : ℝ) (θ : ℕ → ℝ) (r s : TaggedZero Q) : ℂ :=
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let Y := upperScale (Q:ℝ) T
  primitiveGram (support Y) (support W) (differenceWeight Y U) θ r s

def canonicalHarmonic (Q : ℕ) (T : ℝ) : ℝ :=
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let V := U*W
  let Y := upperScale (Q:ℝ) T
  ∑ n ∈ support Y, (realDivisorWeight (support V) (barbanVehov U V) n)^2*differenceWeight Y U n/(n:ℝ)

private theorem detector_vertical_factor_bound : ∃ C : ℝ, 0 < C ∧
    ∀ {q Q : ℕ} {t T : ℝ}, 1 ≤ q → q ≤ Q → |t| ≤ T →
      (5*Real.sqrt (4*Real.sqrt (q:ℝ)*(1+Real.log (q:ℝ))))*Real.sqrt (1+|t|)*Real.pi ≤
        C*(Q:ℝ)^(1/4+loss/2)*(T+1)^(1/2:ℝ) := by
  obtain ⟨K,hK,hlog⟩ := log_power_le_small_power 1 (δ:=loss) (by unfold loss; norm_num)
  refine ⟨10*Real.pi*Real.sqrt K,by positivity,?_⟩
  intro q Q t T hq hqQ ht
  have hq₁ : (1:ℝ) ≤ q := by exact_mod_cast hq
  have hqQ' : (q:ℝ) ≤ Q := by exact_mod_cast hqQ
  have hQ₁ := hq₁.trans hqQ'
  have hq₀ := zero_lt_one.trans_le hq₁
  have hQ₀ := zero_lt_one.trans_le hQ₁
  have hlogQ : 1+Real.log (Q:ℝ) ≤ K*(Q:ℝ)^loss := by simpa only [pow_one] using hlog Q hQ₁
  have hLq : 0 ≤ 1+Real.log (q:ℝ) := by linarith only [Real.log_nonneg hq₁]
  have hqterm : 4*Real.sqrt (q:ℝ)*(1+Real.log (q:ℝ)) ≤ (4*K)*(Q:ℝ)^(1/2+loss) := calc
    _ ≤ 4*Real.sqrt (Q:ℝ)*(1+Real.log (Q:ℝ)) :=
      mul_le_mul (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hqQ') (by norm_num))
        (add_le_add le_rfl (Real.log_le_log hq₀ hqQ')) hLq (by positivity)
    _ ≤ 4*Real.sqrt (Q:ℝ)*(K*(Q:ℝ)^loss) :=
      mul_le_mul_of_nonneg_left hlogQ (by positivity)
    _ = _ := by rw [Real.sqrt_eq_rpow,Real.rpow_add hQ₀]; ring
  have hsqrt : Real.sqrt (4*Real.sqrt (q:ℝ)*(1+Real.log (q:ℝ))) ≤
      (2*Real.sqrt K)*(Q:ℝ)^(1/4+loss/2) := by
    apply (Real.sqrt_le_sqrt hqterm).trans_eq
    rw [Real.sqrt_mul (by positivity : 0 ≤ 4*K), Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 4)]
    rw [show Real.sqrt 4 = (2:ℝ) by rw [show (4:ℝ)=2^2 by norm_num, Real.sqrt_sq (by norm_num)]]
    rw [Real.sqrt_eq_rpow ((Q:ℝ)^(1/2+loss)),← Real.rpow_mul hQ₀.le]
    congr 2
    ring
  have ht' : Real.sqrt (1+|t|) ≤ (T+1)^(1/2:ℝ) := by
    rw [← Real.sqrt_eq_rpow]
    exact Real.sqrt_le_sqrt (by linarith only [ht])
  calc
    _ ≤ (5*((2*Real.sqrt K)*(Q:ℝ)^(1/4+loss/2)))*(T+1)^(1/2:ℝ)*Real.pi := by
      gcongr
    _ = _ := by ring

/-- The actual detector failure at canonical lengths costs `H^(-4η)`. -/
theorem canonical_detector_lower : ∃ C : ℝ, 0 < C ∧
    ∀ (Q : ℕ) (hQ : 1 ≤ Q) {δ T : ℝ}, δ ≤ loss → 1 ≤ T →
      ∀ (θ : ℕ → ℝ), θ 1 = 1 → (∀ d, |θ d| ≤ 1) →
      ∀ r ∈ familyZeroTags Q (1-δ) T,
      (1/4:ℝ) ≤ ‖canonicalDetector T θ r‖ + C*((Q:ℝ)*(T+1))^(-4*loss) := by
  obtain ⟨C,hC,hfactor⟩ := detector_vertical_factor_bound
  refine ⟨3000*C,by positivity,?_⟩
  intro Q hQ δ T hδ hT θ hθ₁ hθ r hr
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let V := U*W
  let Y := upperScale (Q:ℝ) T
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  obtain ⟨hU,hW,hUV,hVY,_,_,_⟩ := scale_relations hQ₁ hT
  have hUY : U ≤ Y := hUV.le.trans hVY
  have hY : 1 ≤ Y := (show (1:ℝ) ≤ 2 by norm_num).trans (hU.trans hUY)
  obtain ⟨hp,hn,hβ,hβ',him,_,hz⟩ := family_mem_geometry hr
  have hlo : 3/4 ≤ r.2.re := by unfold loss at hδ; linarith only [hβ,hδ]
  have hD := compact_detector_lower_primitive hp hn hz hlo hβ' (U:=U) (V:=V) (W:=W) (Y:=Y) (Z:=U)
      hU le_rfl hUV hW.le hθ₁ hθ hUY
  have hf := hfactor (q:=level r) (Q:=Q) (Nat.succ_le_succ (Nat.zero_le _)) (level_le r) him
  have hpow : Y^(1/2-r.2.re) ≤ Y^(-1/2+δ) := Real.rpow_le_rpow_of_exponent_le hY (by linarith only [hβ])
  have hff := detector_error_scale hQ₁ hT hδ
  change (1/4:ℝ) ≤ ‖canonicalDetector T θ r‖ + _ at hD
  apply hD.trans
  apply add_le_add le_rfl
  calc
    _ ≤ (250*(12*Real.sqrt V*Real.sqrt W)*Y^(-1/2+δ)) *
        (C*(Q:ℝ)^(1/4+loss/2)*(T+1)^(1/2:ℝ)) := by gcongr
    _ = (3000*C)*(Real.sqrt V*Real.sqrt W*Y^(-1/2+δ)*
        (Q:ℝ)^(1/4+loss/2)*(T+1)^(1/2:ℝ)) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hff (by positivity)

/-- At the canonical lengths every pair of different columns has error `O(H^(-3η))`. -/
theorem canonical_off_column_error : ∃ C : ℝ, 0 < C ∧
    ∀ (Q : ℕ) (hQ : 1 ≤ Q) {δ T : ℝ}, δ ≤ loss → 1 ≤ T →
      ∀ (θ : ℕ → ℝ), (∀ d, |θ d| ≤ 1) →
      ∀ r ∈ familyZeroTags Q (1-δ) T, ∀ s ∈ familyZeroTags Q (1-δ) T,
      column r ≠ column s → ‖canonicalGram T θ r s‖ ≤ C*((Q:ℝ)*(T+1))^(-3*loss) := by
  obtain ⟨C,hC,hgram⟩ := nonprincipal_gram_norm_le (ε:=loss) (by unfold loss; norm_num)
  refine ⟨2*C,by positivity,?_⟩
  intro Q hQ δ T hδ hT θ hθ r hr s hs hcol
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let V := U*W
  let Y := upperScale (Q:ℝ) T
  let q := level r*level s
  let z := conj r.2 + s.2 - 1
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  have hQ₀ := zero_lt_one.trans_le hQ₁
  let _ : NeZero q := ⟨(Nat.mul_pos (Nat.zero_lt_succ _) (Nat.zero_lt_succ _)).ne'⟩
  obtain ⟨hU,hW,hUV,hVY,_,_,_⟩ := scale_relations hQ₁ hT
  have hUY : U ≤ Y := hUV.le.trans hVY
  have hU₁ : 1 ≤ U := (show (1:ℝ) ≤ 2 by norm_num).trans hU
  obtain ⟨_,_,hrβ,hrβ',hrT,_,_⟩ := family_mem_geometry hr
  obtain ⟨_,_,hsβ,hsβ',hsT,_,_⟩ := family_mem_geometry hs
  have hzre : z.re = r.2.re+s.2.re-1 := by simp [z,Complex.sub_re,Complex.add_re]
  have hzim : z.im = -r.2.im+s.2.im := by simp [z,Complex.sub_im,Complex.add_im]
  have hzlo : 1-2*δ ≤ z.re := by linarith only [hzre,hrβ,hsβ]
  have hzh : z.re ≤ 1 := by linarith only [hzre,hrβ',hsβ']
  have hz₀ : 3/4 ≤ z.re := by unfold loss at hδ; linarith only [hzlo,hδ]
  have hT' : |z.im| ≤ 2*T := by
    rw [hzim]
    have h := abs_add_le (-r.2.im) s.2.im
    rw [abs_neg] at h
    linarith only [h,hrT,hsT]
  have hGram := hgram q (taggedPair r s) (taggedPair_ne_one hr hs hcol) hz₀ hzh
    (T:=2*T) (W:=W) (Y:=Y) (U:=U) hT' (thetaScale_pos (Q:ℝ) T).le hU₁ hUY θ hθ
  rw [cutoff_sub_eq_difference _ (zero_lt_one.trans_le hU₁) hUY] at hGram
  change ‖canonicalGram T θ r s‖ ≤ _ at hGram
  have hpow : U^(1/2-z.re) ≤ U^(-1/2+2*δ) := Real.rpow_le_rpow_of_exponent_le hU₁
    (by linarith only [hzlo])
  have hQpow : (q:ℝ)^(1/4+loss/2) ≤ (Q:ℝ)^(1/2+loss) := calc
    _ ≤ ((Q:ℝ)^2)^(1/4+loss/2) := Real.rpow_le_rpow (Nat.cast_nonneg _)
      (by exact_mod_cast pair_level_le r s) (by unfold loss; norm_num)
    _ = _ := by rw [← Real.rpow_natCast_mul hQ₀.le]; norm_num; ring
  have hTpow : (1+2*T)^(1/2:ℝ) ≤ 2*(T+1)^(1/2:ℝ) := by
    simp only [← Real.sqrt_eq_rpow]
    apply (Real.sqrt_le_sqrt (by linarith only [hT] : 1+2*T ≤ 4*(T+1))).trans_eq
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 4)]
    rw [show Real.sqrt 4 = (2:ℝ) by rw [show (4:ℝ)=2^2 by norm_num, Real.sqrt_sq (by norm_num)]]
  refine hGram.trans ?_
  calc
    _ ≤ C*W*U^(-1/2+2*δ)*(Q:ℝ)^(1/2+loss)*(2*(T+1)^(1/2:ℝ)) := by gcongr
    _ = (2*C)*(W*U^(-1/2+2*δ)*(Q:ℝ)^(1/2+loss)*(T+1)^(1/2:ℝ)) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (comparison_error_scale hQ₁ hT hδ) (by positivity)

end
end GoldbachPintzFamily

