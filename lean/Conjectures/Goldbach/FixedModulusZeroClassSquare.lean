  have hε1 : ε≤ 1 := hεδ.trans (by norm_num [δ])
  obtain ⟨S,a,b,hb,ha,hF⟩ := exists_exponential_box_envelope hB hc hδ hε hε1
  have hb' (i : ℕ) (hi : i∈S) : 0<b i := hB.trans_le (hb i hi)
  have hErr : ε*(2*Real.exp (B*c)+ε)/(2*B)≤ δ := by
    have hE := (le_div_iff₀ (by positivity : 0<2*Real.exp (B*c)+1)).mp
      (min_le_right δ (δ/(2*Real.exp (B*c)+1)))
    refine (div_le_iff₀ (by positivity : 0<2*B)).mpr ?_
    change ε*(2*Real.exp (B*c)+1)≤δ at hE
    have h := mul_le_mul_of_nonneg_left (add_le_add_right hε1 (2*Real.exp (B*c))) hε.le
    have h' := mul_le_mul_of_nonneg_left (show (1:ℝ)≤2*B by linarith only [hb₁]) hδ.le
    nlinarith only [hE,h,h']
