section
namespace GoldbachPintzWeightedFormula

open Filter Finset Goldbach GoldbachPintzNumerics GoldbachPintzHalasz GoldbachTwistedMellin
open scoped Topology Classical

/-- The raw fixed-modulus weighted zero moment above any higher deficit
cutoff, with the exact exponential saving relative to its base cutoff. -/
theorem eventually_cd_raw_moment
    (Allowed : (q : ℕ) → DirichletCharacter ℂ q → Prop)
    {φ φoff u w c r κ H T J h B M σ : ℝ}
    (hφ : 3/8 < φ) (hφoff : 0 ≤ φoff) (hw : 0 < w) (hc : 0 < c) (hκ : 0 < κ)
    (hD : φ+c+w < r) (hG : φoff+2*w < u) (hH : 0 ≤ H) (hT : 0 ≤ T)
    (hJ : 0 ≤ J) (hh : 0 < h) (hB : 0 ≤ B) (hσ : 0 ≤ σ)
    (hGrowth : ∀ (q : ℕ) [NeZero q], ∀ L : ℝ, 1 ≤ L → Real.log (q:ℝ) ≤ L →
      ∀ χ : DirichletCharacter ℂ q, χ≠1 → Allowed q χ →
      ∀ s : ℂ, s.re=7/8 →
      ‖χ.LFunction s‖ ≤ B*(1+|s.im|)*(1+L)*(q:ℝ)^(φoff*(1/8:ℝ)))
    (hM : ((2*r-c)/(2*c))*(1/(w*κ))*
          Real.sqrt (densityMomentScalar φ κ h)*Real.sqrt (densityMomentScalar φ r h) < M) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ {ι : Type} (I : Finset ι) (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ),
      (∀ i∈I,χ i≠1 ∧ regularizedL (χ i) (ρ i)=0 ∧ (ρ i).re < 1 ∧
        (1-(ρ i).re)*L ≤ H ∧ |(ρ i).im| ≤ T) →
      (∀ i∈I,∀ j∈I,χ i≠χ j → Allowed q (cdQuotient (χ i) (χ j))) →
      (∀ i∈I,∀ z∈cdColumnZeros I χ ρ i,
        (((I.filter fun j=>χ i=χ j).filter fun j=>ρ j=z).card)≤
          analyticOrderNatAt (regularizedL (χ i)) z) →
      (∀ i∈I,(∑ z∈cdColumnZeros I χ ρ i,(analyticOrderNatAt (regularizedL (χ i)) z:ℝ)) ≤ J) →
      ((∑ i∈I,Real.exp (-(2*(u+r+κ)+σ)*max h ((1-(ρ i).re)*L))) ≤
        Real.exp (-σ*h)*M) ∧
      (∀ h' : ℝ, h ≤ h' → (∀ i∈I,h' ≤ (1-(ρ i).re)*L) →
        (∑ i∈I,Real.exp (-(2*(u+r+κ)+σ)*((1-(ρ i).re)*L))) ≤
          Real.exp (-σ*(h'-h))*(Real.exp (-σ*h)*M)) := by
  let A := (2/w)*Real.exp ((u+r+κ)*(2*H))*κ
  have hC : 0 ≤ (2*r-c)/(2*c) := by
    apply div_nonneg _ (by positivity)
    linarith only [hD,hφ,hw,hc]
  obtain ⟨e,N,he,he₁,hN,hAbsorb,hBound⟩ :=
    exists_cd_moment_precision hC hw hκ (show 0 ≤ A by dsimp only [A]; positivity) hM
  have hEvent := eventually_cd_weighted_moment Allowed hφ hφoff hw hc hκ hD hG
    hH hT hJ hh hB he he₁ he he he hN hGrowth hAbsorb
  filter_upwards [hEvent] with L hWeighted
  intro q _ hq ι I χ ρ hI hAllowed hMultiplicity hCount
  have hMoment := (hWeighted q hq I χ ρ hI hAllowed hMultiplicity hCount).trans hBound.le
  have hClip : (r+κ)/2 ≤ 2*(u+r+κ) := by
    linarith only [hD,hG,hφ,hφoff,hw,hc,hκ]
  constructor
  · simpa only [one_mul] using cd_clipped_sum_le_of_moment I (fun i=>(1-(ρ i).re)*L)
      (fun _=>1) hσ hClip (fun _ _=>zero_le_one) (by simpa only [one_mul] using hMoment)
  · intro h' hh' hMin
    simpa only [one_mul] using cd_raw_sum_le_of_moment I (fun i=>(1-(ρ i).re)*L) (fun _=>1)
      hσ hh' (fun _ _=>zero_le_one) hMin (by simpa only [one_mul] using hMoment)

end GoldbachPintzWeightedFormula
end

