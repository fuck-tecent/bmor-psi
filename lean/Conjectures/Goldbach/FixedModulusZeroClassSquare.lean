    calc
      _ ≤ 25*(q:ℝ)*(1+‖w‖)^2 := hh
      _ ≤ 25*(q:ℝ)*(3*K)^2 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hn 2) (by positivity)
