theorem V1t8 (n : ℕ) : n ≤ 2*n.totient^2 := by
  have hall : ∀ n : ℕ,
      n ≤ 2*n.totient^2 ∧ (¬ 2 ∣ n → n ≤ n.totient^2) := by
    refine Nat.recOnPrimePow ?_ ?_ ?_
    · simp
    · simp
    · intro a p k hp hpa hk ha
      obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk.ne'
      have hc : (p^(j+1)).Coprime a :=
        (hp.coprime_iff_not_dvd.mpr hpa).pow_left (j+1)
      rw [Nat.totient_mul hc]
      have hp1 : p-1+1=p := Nat.sub_add_cancel hp.one_lt.le
      by_cases hp2 : p=2
      · subst p
        have hpp : 2^(j+1) ≤ 2*(2^(j+1)).totient^2 :=
          Vmt 2 j 2 Nat.prime_two (by norm_num)
        have haodd := ha.2 hpa
        constructor
        · calc
            2^(j+1)*a ≤ (2*(2^(j+1)).totient^2)*a := Nat.mul_le_mul_right _ hpp
            _ ≤ (2*(2^(j+1)).totient^2)*a.totient^2 := Nat.mul_le_mul_left _ haodd
            _ = _ := by ring
        · intro hodd
          exfalso
          apply hodd
          exact dvd_mul_of_dvd_left (dvd_pow_self 2 (by omega : j+1≠0)) a
      · have hp3 : 3 ≤ p := by have := hp.two_le; omega
        have hbase : p ≤ (p-1)^2 := by nlinarith only [hp3,hp1]
        have hpp : p^(j+1) ≤ (p^(j+1)).totient^2 := by
          simpa using Vmt p j 1 hp (by simpa using hbase)
        constructor
        · calc
            p^(j+1)*a ≤ (p^(j+1)).totient^2*a := Nat.mul_le_mul_right _ hpp
            _ ≤ (p^(j+1)).totient^2*(2*a.totient^2) := Nat.mul_le_mul_left _ ha.1
            _ = _ := by ring
        · intro hodd
          have haodd : ¬ 2 ∣ a := fun h => hodd (dvd_mul_of_dvd_right h _)
          calc
            p^(j+1)*a ≤ (p^(j+1)).totient^2*a := Nat.mul_le_mul_right _ hpp
            _ ≤ (p^(j+1)).totient^2*a.totient^2 := Nat.mul_le_mul_left _ (ha.2 haodd)
