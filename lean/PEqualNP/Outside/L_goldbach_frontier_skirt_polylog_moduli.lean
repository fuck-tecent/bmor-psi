theorem V11w (t : ℝ) (S : Finset ℂ)
    (hS : ∀ z∈S, 1/2≤z.re ∧ z.re≤1 ∧ |z.im-t|≤4) :
    ∑ z∈S,(V9t z:ℝ) ≤
      11*(Real.log (192*(|t|+8)^2)/Real.log (14/13)) := by
