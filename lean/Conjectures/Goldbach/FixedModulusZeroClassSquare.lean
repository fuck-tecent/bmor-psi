section
namespace GoldbachSignedPairs

open Complex Filter Goldbach GoldbachTwistedMellin GoldbachHybridGrowth GoldbachPintzWeightedFormula
open scoped Topology

structure ModulusWindowGrowth (q Q : ℕ) [NeZero q] (U : ℝ) : Prop where
  large_log : 8*U+4≤Real.log (q:ℝ)
  log_one : 1≤Real.log (q:ℝ)
  log_height : ∀ t : ℝ, |t|≤4*U → logHeight q t≤2*Real.log (q:ℝ)
  general : ∀ (χ : DirichletCharacter ℂ q), χ≠1 → ∀ z : ℂ,
    3/4≤z.re → z.re≤3/2 → |z.im|≤(Real.log (q:ℝ))^(2:ℝ)+1 →
      ‖χ.LFunction z‖≤(Real.log (q:ℝ))^(8:ℝ)*(q:ℝ)^((47/125:ℝ)*max 0 (1-z.re))
  bounded : ∀ (χ : DirichletCharacter ℂ q), χ≠1 → χ.conductor≤Q → ∀ z : ℂ,
    3/4≤z.re → z.re≤3/2 → |z.im|≤(Real.log (q:ℝ))^(2:ℝ)+1 →
      ‖χ.LFunction z‖≤(Real.log (q:ℝ))^(8:ℝ)*(q:ℝ)^((1/1000:ℝ)*max 0 (1-z.re))

/-- All the fixed-height windows sit inside a common polylogarithmic strip. -/
theorem eventually_modulus_window_growth (Q : ℕ) (hQ : 1≤Q) {U : ℝ} (hU : 0≤U) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q], ModulusWindowGrowth q Q U := by
  have hLog : Tendsto (fun q : ℕ => Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R:=ℝ))
  have hg := hLog.eventually (burgess_strip_polynomial_in_log (p:=2) (φ:=47/125)
    (by norm_num) (by norm_num))
  have hb := hLog.eventually (bounded_conductor_strip_polynomial_log
    (e:=1/1000) (p:=2) (by norm_num) (by norm_num) Q hQ)
  filter_upwards [hg,hb,hLog.eventually_ge_atTop (max 1 (8*U+4))] with q hg hb hq
  intro inst
  let L := Real.log (q:ℝ)
  have hl : 1≤L := (le_max_left _ _).trans hq
  have hLarge : 8*U+4≤L := (le_max_right _ _).trans hq
  have hqR : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  have hLq : L<(q:ℝ) := by linarith only [Real.log_le_sub_one_of_pos hqR]
  refine ⟨hLarge,hl,?_,?_,?_⟩
  · intro t ht
    have ht' : 2*(2+|t|)≤(q:ℝ) := by linarith only [hLarge,hLq,ht]
    unfold logHeight
    calc
      _ ≤ Real.log ((q:ℝ)^2) := by
        apply Real.log_le_log (by positivity)
        convert mul_le_mul_of_nonneg_left ht' hqR.le using 1 <;> ring
      _ = _ := by rw [Real.log_pow]; norm_num
  · intro χ hc z hz hz' ht
    have h := hg q le_rfl χ hc z hz hz' ht
    simpa only [show (3:ℝ)*2+2=(8:ℝ) by norm_num] using h
  · intro χ hc hcQ z hz hz' ht
    have h := hb q le_rfl χ hc hcQ z hz hz' ht
    refine h.trans ?_
    have hE : (2:ℝ)*2+2≤8 := by norm_num
    apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hqR.le _)
    exact Real.rpow_le_rpow_of_exponent_le hl hE

theorem ModulusWindowGrowth.primeTestWindow {q Q : ℕ} [NeZero q] {U σ t : ℝ}
    (hG : ModulusWindowGrowth q Q U) {χ : DirichletCharacter ℂ q} (hχ : χ≠1)
    (ht : |t|≤4*U)
    (hNoRight : ∀ z : ℂ, regularizedL χ z=0 → |z.im-t|≤1 → z.re≤σ) :
    PrimeTestWindow χ t σ ((Real.log (q:ℝ))^(2:ℝ)+1) ((Real.log (q:ℝ))^(8:ℝ))
      (Real.log (q:ℝ)) 2 (47/125) := by
  have hs : (Real.log (q:ℝ))≤(Real.log (q:ℝ))^(2:ℝ) := by
    have h := Real.rpow_le_rpow_of_exponent_le hG.log_one (by norm_num : (1:ℝ)≤2)
    simpa only [Real.rpow_one] using h
  have hU : 0≤U := by linarith only [abs_nonneg t,ht]
  refine ⟨hχ,by linarith only [hG.large_log,hU,hs,ht],hG.log_height t ht,?_,hNoRight⟩
  exact hG.general χ hχ

end GoldbachSignedPairs
end

section
namespace GoldbachPintzNumerics

open Complex

/-- The normalized comparator turns a real-axis coefficient inequality
into domination at every height. -/
theorem rational_principal_resolvent_dominated {b lam t c d : ℝ}
    (hb : 0<b) (hlam : 0≤lam) (hblam : lam<b) (hc : 0≤c)
    (hCoef : c*realRationalZeroKernel b (-lam)≤d*realRationalZeroKernel b 0) :
    c*(rationalZeroKernel b (((-lam:ℝ):ℂ)+(t:ℂ)*I)).re≤
      d*(rationalZeroKernel b ((t:ℂ)*I)).re := by
  have hF := realRationalZeroKernel_pos hb (show 0<b + -lam by linarith only [hblam])
  have hF0 := realRationalZeroKernel_pos hb (show 0<b+0 by simpa using hb)
  have hR := rationalZeroKernel_normalized_comparison (t:=t) (x:=-lam) (a:=0) hb
    (le_refl 0) (neg_nonpos.mpr hlam) (by linarith only [hblam])
  have hP := rationalZeroKernel_re_nonneg (b:=b) (t:=t) (x:=0) hb (le_refl 0)
  simp only [Complex.ofReal_zero,zero_add] at hR hP
  calc
    _ ≤ c*((rationalZeroKernel b ((t:ℂ)*I)).re/realRationalZeroKernel b 0*
        realRationalZeroKernel b (-lam)) :=
      mul_le_mul_of_nonneg_left ((div_le_iff₀ hF).mp hR) hc
    _ = ((rationalZeroKernel b ((t:ℂ)*I)).re/realRationalZeroKernel b 0)*
        (c*realRationalZeroKernel b (-lam)) := by ring
    _ ≤ ((rationalZeroKernel b ((t:ℂ)*I)).re/realRationalZeroKernel b 0)*
        (d*realRationalZeroKernel b 0) :=
      mul_le_mul_of_nonneg_left hCoef (by positivity)
    _ = _ := by field_simp [hF0.ne']

end GoldbachPintzNumerics
end

