namespace GoldbachPintzWeightedGram

open Complex Finset LSeries GoldbachSmoothing GoldbachPintzWeightedFormula
open scoped ComplexConjugate

noncomputable section

private theorem rationalPrime_summand_shift {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (b L : ℝ) (s : ℂ) (n : ℕ) :
    term (twistedCoefficient χ) s n*(rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)=
      term (twistedCoefficient χ) (s+((b/L:ℝ):ℂ)) n *
       (1+((b/L:ℝ):ℂ)*Complex.log (n:ℂ)+(((b/L:ℝ):ℂ)*Complex.log (n:ℂ))^2/3) := by
  by_cases hn : n=0
  · subst n
    simp
  have hn' : (0:ℝ)<n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn
  simp only [term_of_ne_zero hn]
  have h0 : (n:ℂ)^(s+((b/L:ℝ):ℂ))=((n:ℂ)^s)*cexp ((Real.log (n:ℝ)*(b/L):ℝ):ℂ) := by
    rw [Complex.cpow_add _ _ hn0,Complex.cpow_def_of_ne_zero hn0 ((_ : ℝ):ℂ)]
    congr 2
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn'.le,Complex.ofReal_mul]
  rw [h0,div_mul_eq_div_div]
  have hlog : Complex.log (n:ℂ)=((Real.log (n:ℝ)):ℂ) := by
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn'.le]
  simp only [hlog,div_eq_mul_inv,←Complex.exp_neg]
  unfold rationalPrimeWeight
  rw [Complex.ofReal_mul,Complex.ofReal_exp]
  push_cast
  have hm : (b:ℂ)*(Complex.log (n:ℂ)*(L:ℂ)⁻¹) =
      Complex.log (n:ℂ)*((b:ℂ)*(L:ℂ)⁻¹) := by ring
  rw [hm]
  ring

theorem rationalPrimeTest_summable {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {b L : ℝ} {s : ℂ} (hs : 1<s.re+b/L) :
    Summable (fun n : ℕ=>term (twistedCoefficient χ) s n *
      (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)) := by
  let w := s+((b/L:ℝ):ℂ)
  let a := twistedCoefficient χ
  let a₁ := logMul a
  let a₂ := logMul a₁
  let c := ((b/L:ℝ):ℂ)
  have hw : 1<w.re := by simpa [w] using hs
  have hAbs : abscissaOfAbsConv a ≤ ((1:ℝ):EReal) :=
    abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun z hz=>
      χ.LSeriesSummable_twist_vonMangoldt hz)
  have hσ : abscissaOfAbsConv a < (w.re:EReal) := hAbs.trans_lt (by exact_mod_cast hw)
  have hSa : Summable (term a w) := χ.LSeriesSummable_twist_vonMangoldt hw
  have hS₁ : Summable (term a₁ w) := LSeriesSummable_logMul_of_lt_re hσ
  have hS₂ : Summable (term a₂ w) := LSeriesSummable_logMul_of_lt_re
    (by simpa [a₁] using hσ : abscissaOfAbsConv a₁ < (w.re:EReal))
  refine ((hSa.add (hS₁.mul_left c)).add (hS₂.mul_left (c^2/3))).congr ?_
  intro n
  rw [rationalPrime_summand_shift]
  by_cases hn : n=0
  · subst n
    simp
  · simp only [term_of_ne_zero hn,a₂,a₁,logMul]
    dsimp only [a,w,c]
    ring

def rationalGramWeight (b L σ : ℝ) (n : ℕ) : ℝ :=
  ArithmeticFunction.vonMangoldt n/(n:ℝ)^σ*rationalPrimeWeight b (Real.log (n:ℝ)/L)

def rationalGramPhase (γ : ℝ) (n : ℕ) : ℂ :=
  cexp (((-γ*Real.log (n:ℝ):ℝ):ℂ)*I)

def rationalGramSample {q : ℕ} (χ : DirichletCharacter ℂ q) (γ : ℝ) (n : ℕ) : ℂ :=
  χ (n:ZMod q)*rationalGramPhase γ n

theorem rationalGramWeight_nonneg {b L σ : ℝ} (hb : 0≤b) (hL : 0≤L) (n : ℕ) :
    0≤rationalGramWeight b L σ n := by
  unfold rationalGramWeight
  refine mul_nonneg (div_nonneg (ArithmeticFunction.vonMangoldt_nonneg) (by positivity)) ?_
  apply rationalPrimeWeight_nonneg hb
  refine div_nonneg ?_ hL
  cases n with
  | zero => simp
  | succ n => exact Real.log_nonneg (by exact_mod_cast Nat.succ_pos n)

theorem rationalGramSample_norm_le_one {q : ℕ} (χ : DirichletCharacter ℂ q)
    (γ : ℝ) (n : ℕ) :
    ‖rationalGramSample χ γ n‖≤1 := by
  rw [rationalGramSample,norm_mul,rationalGramPhase,Complex.norm_exp_ofReal_mul_I,mul_one]
  exact χ.norm_le_one _

private theorem rationalGramPhase_add (γ τ : ℝ) (n : ℕ) :
    rationalGramPhase γ n*rationalGramPhase τ n=rationalGramPhase (γ+τ) n := by
  unfold rationalGramPhase
  rw [←Complex.exp_add]
  congr 1
  push_cast
  ring

private theorem rationalGramPhase_conj (γ : ℝ) (n : ℕ) :
    conj (rationalGramPhase γ n)=rationalGramPhase (-γ) n := by
  unfold rationalGramPhase
  rw [←Complex.exp_conj]
  congr 1
  simp only [map_mul,Complex.conj_ofReal,Complex.conj_I]
  push_cast
  ring

theorem rationalGramSample_mul_conj {q : ℕ} (χ ψ : DirichletCharacter ℂ q)
    (γ τ : ℝ) (n : ℕ) :
    rationalGramSample χ γ n*conj (rationalGramSample ψ τ n)=
      rationalGramSample (χ*ψ⁻¹) (γ-τ) n := by
  have hv : conj (ψ (n:ZMod q)) = (ψ⁻¹) (n:ZMod q) := MulChar.star_apply' ψ _
  unfold rationalGramSample
  rw [map_mul,hv,rationalGramPhase_conj,MulChar.mul_apply,sub_eq_add_neg,
    ←rationalGramPhase_add]
  ring

theorem rationalPrime_summand_eq_gramSample {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L σ γ : ℝ) (n : ℕ) :
    term (twistedCoefficient χ) ((σ:ℂ)+(γ:ℂ)*I) n *
      (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ) =
      (rationalGramWeight b L σ n:ℂ)*rationalGramSample χ γ n := by
  by_cases hn : n=0
  · subst n
    simp [rationalGramWeight]
  have hnR : (0:ℝ)<n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hnC : (n:ℂ)≠0 := by exact_mod_cast hn
  have hA : (n:ℂ)^(σ:ℂ)=(((n:ℝ)^σ:ℝ):ℂ) := by
    simpa only [Complex.ofReal_natCast] using (Complex.ofReal_cpow hnR.le σ).symm
  have hB : Complex.log (n:ℂ)=((Real.log (n:ℝ)):ℂ) := by
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hnR.le]
  have hPow : (n:ℂ)^((σ:ℂ)+(γ:ℂ)*I) =
      (((n:ℝ)^σ:ℝ):ℂ)*cexp ((((γ*Real.log (n:ℝ)):ℝ):ℂ)*I) := by
    rw [Complex.cpow_add _ _ hnC,hA,Complex.cpow_def_of_ne_zero hnC,hB]
    congr 2
    push_cast
    ring
  have hPhase : rationalGramPhase γ n=(cexp ((((γ*Real.log (n:ℝ)):ℝ):ℂ)*I))⁻¹ := by
    unfold rationalGramPhase
    rw [←Complex.exp_neg]
    congr 1
    push_cast
    ring
  simp only [term_of_ne_zero hn,twistedCoefficient,Pi.mul_apply,rationalGramWeight,rationalGramSample,hPow,hPhase]
  push_cast
  simp only [div_eq_mul_inv,mul_inv_rev]
  ring

private theorem rationalGramSample_principal_levelOne (n : ℕ) :
    rationalGramSample (1:DirichletCharacter ℂ 1) 0 n=1 := by
  unfold rationalGramSample
  rw [Subsingleton.elim (n:ZMod 1) 1,map_one]
  simp [rationalGramPhase]

theorem rationalGramWeight_summable {b L σ : ℝ} (hs : 1<σ+b/L) :
    Summable (rationalGramWeight b L σ) := by
  have hs' : 1<(((σ:ℂ)+(0:ℂ)*I)).re+b/L := by simpa using hs
  have h := rationalPrimeTest_summable (1:DirichletCharacter ℂ 1) hs'
  have he (n : ℕ) : (term (twistedCoefficient (1:DirichletCharacter ℂ 1)) ((σ:ℂ)+(0:ℂ)*I) n *
      (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)).re=rationalGramWeight b L σ n := by
    have hStep := rationalPrime_summand_eq_gramSample (1:DirichletCharacter ℂ 1) b L σ 0 n
    simp only [Complex.ofReal_zero] at hStep
    rw [hStep,rationalGramSample_principal_levelOne,mul_one,Complex.ofReal_re]
  exact (Complex.hasSum_re h.hasSum).summable.congr he

theorem rationalPrimeTest_re_eq_tsum_gramSample {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {b L σ : ℝ} (γ : ℝ) (hs : 1<σ+b/L) :
    (rationalPrimeTest χ b L ((σ:ℂ)+(γ:ℂ)*I)).re =
      ∑' n : ℕ,rationalGramWeight b L σ n*(rationalGramSample χ γ n).re := by
  have hs' : 1<(((σ:ℂ)+(γ:ℂ)*I)).re+b/L := by simpa using hs
  have hh := (Complex.hasSum_re (rationalPrimeTest_summable χ hs').hasSum).tsum_eq
  unfold rationalPrimeTest
  rw [←hh]
  apply tsum_congr
  intro n
  rw [rationalPrime_summand_eq_gramSample]
  simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]

theorem rationalPrimeTest_principal_levelOne_re_eq_tsum {b L σ : ℝ} (hs : 1<σ+b/L) :
    (rationalPrimeTest (1:DirichletCharacter ℂ 1) b L (σ:ℂ)).re=∑' n,rationalGramWeight b L σ n := by
  have h := rationalPrimeTest_re_eq_tsum_gramSample (1:DirichletCharacter ℂ 1) 0 hs
  simpa only [Complex.ofReal_zero,zero_mul,add_zero,rationalGramSample_principal_levelOne,
    Complex.one_re,mul_one] using h

end
end GoldbachPintzWeightedGram
end

section
namespace GoldbachPintzWeightedGram

open Finset Filter Complex
open scoped Topology

/-- Cauchy–Schwarz for a nonnegative summable weight and a bounded complex
sequence, in the form used by the rational prime Gram series. -/
theorem weighted_series_cauchy {w : ℕ→ℝ} (hw : ∀ n, 0≤w n)
    (hSum : Summable w) (z : ℕ→ℂ) {M : ℝ} (_hM : 0≤M) (hz : ∀ n,‖z n‖≤M) :
    (∑' n,w n*(z n).re)^2≤(∑' n,w n)*(∑' n,w n*‖z n‖^2) := by
  let f (n : ℕ) := w n*(z n).re
  let g (n : ℕ) := w n*‖z n‖^2
  have hf : Summable f := (hSum.mul_right M).of_norm_bounded fun n=>by
    unfold f
    rw [norm_mul,Real.norm_of_nonneg (hw n),Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left ((Complex.abs_re_le_norm (z n)).trans (hz n)) (hw n)
  have hg : Summable g := (hSum.mul_right (M^2)).of_norm_bounded fun n=>by
    unfold g
    rw [norm_mul,Real.norm_of_nonneg (hw n),Real.norm_of_nonneg (sq_nonneg _)]
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hz n) 2) (hw n)
  have h (N : ℕ) : (∑ n∈range N,f n)^2≤(∑ n∈range N,w n)*(∑ n∈range N,g n) := by
    let a (n : ℕ) := Real.sqrt (w n)
    let b (n : ℕ) := Real.sqrt (w n)*(z n).re
    have hF (n : ℕ) : a n*b n=f n := by
      dsimp only [a,b,f]
      rw [←mul_assoc,←pow_two,Real.sq_sqrt (hw n)]
    have hA (n : ℕ) : (a n)^2=w n := Real.sq_sqrt (hw n)
    have hB (n : ℕ) : (b n)^2≤g n := by
      dsimp only [b,g]
      rw [mul_pow,Real.sq_sqrt (hw n),←sq_abs ((z n).re)]
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (abs_nonneg _) (Complex.abs_re_le_norm _) 2) (hw n)
    have hCS := sum_mul_sq_le_sq_mul_sq (range N) a b
    simp only [hF,hA] at hCS
    exact hCS.trans (mul_le_mul_of_nonneg_left (sum_le_sum fun n _=>hB n)
      (sum_nonneg fun n _=>hw n))
  exact le_of_tendsto_of_tendsto' (hf.hasSum.tendsto_sum_nat.pow 2)
    (hSum.hasSum.tendsto_sum_nat.mul hg.hasSum.tendsto_sum_nat) h

end GoldbachPintzWeightedGram
end

section
namespace GoldbachPintzWeightedGram

open Complex Finset GoldbachPintzWeightedFormula
open scoped Classical ComplexConjugate

noncomputable section

def rationalGramTest {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (b L σ γ : ℝ) : ℝ :=
  (rationalPrimeTest χ b L ((σ:ℂ)+(γ:ℂ)*I)).re

private theorem weighted_sample_summable {q : ℕ} (χ : DirichletCharacter ℂ q)
    (γ : ℝ) {w : ℕ→ℝ} (hw : ∀ n,0≤w n) (hSum : Summable w) :
    Summable (fun n=>w n*(rationalGramSample χ γ n).re) := by
  refine hSum.of_norm_bounded (fun n=>?_ )
  rw [norm_mul,Real.norm_of_nonneg (hw n),Real.norm_eq_abs]
  apply mul_le_of_le_one_right (hw n)
  exact (Complex.abs_re_le_norm _).trans (rationalGramSample_norm_le_one χ γ n)

private theorem sum_re_test_eq_tsum {ι : Type*} {q : ℕ} [NeZero q]
    (S : Finset ι) (c : ι→ℝ) (χ : ι→DirichletCharacter ℂ q) (γ : ι→ℝ)
    {b L σ : ℝ} (hb : 0≤b) (hL : 0≤L) (hs : 1<σ+b/L) :
    (∑ i∈S,c i*rationalGramTest (χ i) b L σ (γ i)) =
      ∑' n : ℕ,rationalGramWeight b L σ n*∑ i∈S,c i*(rationalGramSample (χ i) (γ i) n).re := by
  let w := rationalGramWeight b L σ
  let z (i : ι) (n : ℕ) := (rationalGramSample (χ i) (γ i) n).re
  have hS (i : ι) : Summable (fun n=>c i*(w n*z i n)) :=
    (weighted_sample_summable (χ i) (γ i) (rationalGramWeight_nonneg hb hL)
      (rationalGramWeight_summable hs)).mul_left _
  simp only [rationalGramTest,rationalPrimeTest_re_eq_tsum_gramSample _ _ hs]
  calc
    _ = ∑ i∈S,∑' n : ℕ,c i*(w n*z i n) := by
      apply sum_congr rfl
      intro i _
      exact tsum_mul_left.symm
    _ = ∑' n : ℕ,∑ i∈S,c i*(w n*z i n) := (Summable.tsum_finsetSum (fun i _=>hS i)).symm
    _ = _ := by
      apply tsum_congr
      intro n
      rw [mul_sum]
      exact sum_congr rfl (fun _ _=>by ring)

private theorem sample_combo_norm_sq {ι : Type*} {q : ℕ}
    (S : Finset ι) (m : ι→ℕ) (χ : ι→DirichletCharacter ℂ q) (γ : ι→ℝ) (n : ℕ) :
    ‖∑ i∈S,(m i:ℂ)*rationalGramSample (χ i) (γ i) n‖^2=
      ∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*
        (rationalGramSample (χ j*(χ i)⁻¹) (γ j-γ i) n).re := by
  let a (i : ι) := rationalGramSample (χ i) (γ i) n
  let F := ∑ i∈S,(m i:ℂ)*a i
  have hF : (F*conj F).re=‖F‖^2 := by
    rw [Complex.mul_conj',←Complex.ofReal_pow,Complex.ofReal_re]
  change ‖F‖^2=_
  rw [←hF]
  calc
    _ = ∑ j∈S,∑ i∈S,(((m i:ℂ)*a i)*(((m j:ℂ)*conj (a j)))).re := by
      simp only [F,map_sum,map_mul,Complex.conj_natCast,sum_mul,mul_sum,Complex.re_sum]
    _ = _ := by
      apply sum_congr rfl
      intro i _
      apply sum_congr rfl
      intro j _
      rw [show ((m j:ℂ)*a j)*((m i:ℂ)*conj (a i))=
        (((m i:ℝ)*(m j:ℝ):ℝ):ℂ)*(a j*conj (a i)) by push_cast; ring]
      simp only [a,rationalGramSample_mul_conj,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]

/-- The exact rational weighted prime Cauchy inequality, with a free
positive normalization and all zero multiplicities carried as weights. -/
theorem rational_prime_series_gram_cauchy {ι : Type*} {q : ℕ} [NeZero q]
    (S : Finset ι) (m : ι→ℕ) (χ : ι→DirichletCharacter ℂ q) (γ : ι→ℝ)
    {b L σ scale : ℝ} (hb : 0≤b) (hL : 0≤L) (hs : 1<σ+b/L) (hScale : 0<scale) :
    let P := rationalGramTest (1:DirichletCharacter ℂ 1) b L σ 0 / scale
    let U (i : ι) := -(rationalGramTest (χ i) b L σ (γ i))/scale
    let G (i j : ι) := rationalGramTest (χ j*(χ i)⁻¹) b L σ (γ j-γ i)/scale
    0≤P ∧ 0≤(∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*G i j) ∧
      (∑ i∈S,(m i:ℝ)*U i)^2≤P*(∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*G i j) := by
  dsimp only
  let w := rationalGramWeight b L σ
  let F (n : ℕ) := ∑ i∈S,(m i:ℂ)*rationalGramSample (χ i) (γ i) n
  let z (i : ι) := rationalGramTest (χ i) b L σ (γ i)
  let Z (i j : ι) := rationalGramTest (χ j*(χ i)⁻¹) b L σ (γ j-γ i)
  let P₀ := rationalGramTest (1:DirichletCharacter ℂ 1) b L σ 0
  let R := ∑ i∈S,(m i:ℝ)*z i
  let G₀ := ∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*Z i j
  have hw := rationalGramWeight_nonneg (σ:=σ) hb hL
  have hSum := rationalGramWeight_summable hs
  have hF (n : ℕ) : ‖F n‖≤∑ i∈S,(m i:ℝ) := by
    unfold F
    refine (norm_sum_le _ _).trans (sum_le_sum (fun i _=>?_))
    rw [norm_mul,Complex.norm_natCast]
    exact mul_le_of_le_one_right (Nat.cast_nonneg _) (rationalGramSample_norm_le_one ..)
  have hR : R=∑' n : ℕ,w n*(F n).re := by
    unfold R z
    rw [sum_re_test_eq_tsum S (fun i=>(m i:ℝ)) χ γ hb hL hs]
    apply tsum_congr
    intro n
    simp only [F,w,Complex.re_sum,Complex.mul_re,Complex.natCast_re,Complex.natCast_im,zero_mul,sub_zero]
  have hPermProd := sum_re_test_eq_tsum (S×ˢS) (fun ij : ι×ι=>(m ij.1:ℝ)*(m ij.2:ℝ))
    (fun ij=>χ ij.2*(χ ij.1)⁻¹) (fun ij=>γ ij.2-γ ij.1) hb hL hs
  have hGG : G₀=∑' n : ℕ,w n*‖F n‖^2 := by
    simp only [sum_product] at hPermProd
    unfold G₀ Z
    rw [hPermProd]
    apply tsum_congr
    intro n
    rw [sample_combo_norm_sq]
  have hP : P₀=∑' n : ℕ,w n := by
    simpa only [P₀,rationalGramTest,Complex.ofReal_zero,zero_mul,add_zero] using
      rationalPrimeTest_principal_levelOne_re_eq_tsum hs
  have hPnonneg : 0≤P₀ := hP ▸ tsum_nonneg hw
  have hGnonneg : 0≤G₀ := hGG ▸ tsum_nonneg (fun n=>mul_nonneg (hw n) (sq_nonneg _))
  have hC : R^2≤P₀*G₀ := by
    rw [hR,hP,hGG]
    exact weighted_series_cauchy hw hSum F (sum_nonneg (fun _ _=>Nat.cast_nonneg _)) hF
  have hRdiv : (∑ i∈S,(m i:ℝ)*(-z i/scale))=-R/scale := by
    unfold R
    rw [←sum_neg_distrib,sum_div]
    exact sum_congr rfl (fun _ _=>by ring)
  have hGdiv : (∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*(Z i j/scale))=G₀/scale := by
    unfold G₀
    rw [sum_div]
    apply sum_congr rfl
    intro i _
    rw [sum_div]
    exact sum_congr rfl (fun _ _=>by ring)
  change 0≤P₀/scale ∧ 0≤(∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*(Z i j/scale)) ∧
    (∑ i∈S,(m i:ℝ)*(-z i/scale))^2≤(P₀/scale)*(∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*(Z i j/scale))
  rw [hRdiv,hGdiv,div_pow,neg_sq,div_mul_div_comm,←pow_two]
  exact ⟨div_nonneg hPnonneg hScale.le,div_nonneg hGnonneg hScale.le,
    div_le_div_of_nonneg_right hC (sq_nonneg scale)⟩

end
end GoldbachPintzWeightedGram
end

