/-!
Finite Möbius cancellation and the Wiener–Ikehara argument for coefficients
1 + μ, from goldbach-proofs, `PEqualNP/Outside/L_twin_primes_unconditional_short.lean`,
Git blob f04bea6b8c5c06b9fe28dc698cdaf5a55e2a6f85, Apache-2.0.
That source credits `L_twin_primes_hard_cutoff.lean`, Git blob
efec7cd55880f73ecf34c278b4ab18c646a9fb0c.
-/

namespace GoldbachGrahamMoebius

open Finset Filter

theorem hc_moebius_aux_mu_littleO_aux_lim :
    Tendsto (fun s : ℂ => (riemannZeta s - 1 / (s - 1)) + (riemannZeta s)⁻¹)
      (nhdsWithin (1 : ℂ) {(1 : ℂ)}ᶜ) (nhds (Real.eulerMascheroniConstant : ℂ)) := by
  have h1 := tendsto_riemannZeta_sub_one_div
  have h2 : Tendsto (fun s : ℂ => (riemannZeta s)⁻¹)
      (nhdsWithin (1 : ℂ) {(1 : ℂ)}ᶜ) (nhds 0) := by
    have ha : Tendsto (fun s : ℂ => ((s - 1) * riemannZeta s)⁻¹)
        (nhdsWithin (1 : ℂ) {(1 : ℂ)}ᶜ) (nhds 1) := by
      simpa using riemannZeta_residue_one.inv₀ one_ne_zero
    have hb : Tendsto (fun s : ℂ => s - 1)
        (nhdsWithin (1 : ℂ) {(1 : ℂ)}ᶜ) (nhds 0) := by
      have h0 : Tendsto (fun s : ℂ => s - 1) (nhds (1 : ℂ)) (nhds ((1 : ℂ) - 1)) :=
        (continuousAt_id.sub continuousAt_const).tendsto
      simpa using h0.mono_left nhdsWithin_le_nhds
    have hab : Tendsto (fun s : ℂ => (s - 1) * ((s - 1) * riemannZeta s)⁻¹)
        (nhdsWithin (1 : ℂ) {(1 : ℂ)}ᶜ) (nhds 0) := by
      simpa using hb.mul ha
    refine hab.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with s hs
    have hs' : s ≠ 1 := hs
    have hs1 : (s - 1 : ℂ) ≠ 0 := sub_ne_zero.mpr hs'
    by_cases h0 : riemannZeta s = 0
    · simp [h0]
    · field_simp
  simpa using h1.add h2

theorem hc_moebius_aux_mu_littleO_aux_cont :
    ContinuousOn (Function.update
      (fun s : ℂ => (riemannZeta s - 1 / (s - 1)) + (riemannZeta s)⁻¹) 1
      (Real.eulerMascheroniConstant : ℂ)) {s : ℂ | 1 ≤ s.re} := by
  intro s hs
  have hsre : 1 ≤ s.re := hs
  by_cases hs1 : s = 1
  · subst hs1
    have h : ContinuousAt (Function.update
        (fun t : ℂ => (riemannZeta t - 1 / (t - 1)) + (riemannZeta t)⁻¹) 1
        (Real.eulerMascheroniConstant : ℂ)) 1 := by
      rw [continuousAt_update_same]
      exact hc_moebius_aux_mu_littleO_aux_lim
    exact h.continuousWithinAt
  · have hζ : ContinuousAt riemannZeta s := (differentiableAt_riemannZeta hs1).continuousAt
    have hne : riemannZeta s ≠ 0 := riemannZeta_ne_zero_of_one_le_re hsre
    have hsub : ContinuousAt (fun t : ℂ => t - 1) s := by fun_prop
    have hdiv : ContinuousAt (fun t : ℂ => (1 : ℂ) / (t - 1)) s := by
      have h : ContinuousAt (fun t : ℂ => (t - 1)⁻¹) s := hsub.inv₀ (sub_ne_zero.mpr hs1)
      simpa [div_eq_mul_inv] using h
    have hcont : ContinuousAt
        (fun t : ℂ => (riemannZeta t - 1 / (t - 1)) + (riemannZeta t)⁻¹) s :=
      (hζ.sub hdiv).add (hζ.inv₀ hne)
    have hG : ContinuousAt (Function.update
        (fun t : ℂ => (riemannZeta t - 1 / (t - 1)) + (riemannZeta t)⁻¹) 1
        (Real.eulerMascheroniConstant : ℂ)) s := by
      refine hcont.congr ?_
      filter_upwards [eventually_ne_nhds hs1] with t ht
      exact (Function.update_of_ne ht (Real.eulerMascheroniConstant : ℂ)
        (fun t : ℂ => (riemannZeta t - 1 / (t - 1)) + (riemannZeta t)⁻¹)).symm
    exact hG.continuousWithinAt

theorem hc_moebius_aux_mu_littleO_aux_LSeries {s : ℂ} (hs : 1 < s.re) :
    LSeries (fun n : ℕ => ((1 + (ArithmeticFunction.moebius n : ℝ) : ℝ) : ℂ)) s
      = riemannZeta s + (riemannZeta s)⁻¹ := by
  have hf' : (fun n : ℕ => ((1 + (ArithmeticFunction.moebius n : ℝ) : ℝ) : ℂ))
      = (1 : ℕ → ℂ) + (fun n : ℕ => ((ArithmeticFunction.moebius n : ℤ) : ℂ)) := by
    funext n
    simp only [Pi.add_apply, Pi.one_apply]
    push_cast
    ring
  rw [hf', LSeries_add (LSeriesSummable_one_iff.mpr hs)
    (ArithmeticFunction.LSeriesSummable_moebius_iff.mpr hs), LSeries_one_eq_riemannZeta hs]
  congr 1
  have hmul := LSeries_one_mul_Lseries_moebius hs
  rw [LSeries_one_eq_riemannZeta hs] at hmul
  exact (inv_eq_of_mul_eq_one_right hmul).symm

theorem hc_moebius_aux_mu_littleO_aux_eqOn :
    Set.EqOn (Function.update
      (fun s : ℂ => (riemannZeta s - 1 / (s - 1)) + (riemannZeta s)⁻¹) 1
      (Real.eulerMascheroniConstant : ℂ))
      (fun s : ℂ => LSeries (fun n : ℕ => ((1 + (ArithmeticFunction.moebius n : ℝ) : ℝ) : ℂ)) s
        - (1 : ℝ) / (s - 1))
      {s : ℂ | 1 < s.re} := by
  intro s hs
  have hsre : 1 < s.re := hs
  have hs1 : s ≠ 1 := by
    intro h
    rw [h] at hsre
    simp at hsre
  dsimp only
  rw [Function.update_of_ne hs1, hc_moebius_aux_mu_littleO_aux_LSeries hsre]
  push_cast
  ring

theorem hc_moebius_aux_mu_littleO_aux_nonneg (n : ℕ) : (0 : ℝ) ≤ 1 + (ArithmeticFunction.moebius n : ℝ) := by
  have h := ArithmeticFunction.abs_moebius_le_one (n := n)
  have h' : ((|ArithmeticFunction.moebius n| : ℤ) : ℝ) ≤ 1 := by exact_mod_cast h
  have h'' : |(ArithmeticFunction.moebius n : ℝ)| ≤ 1 := by simpa [Int.cast_abs] using h'
  linarith [(abs_le.mp h'').1]

theorem hc_moebius_aux_mu_littleO_aux_bound (n : ℕ) :
    ∑ i ∈ Finset.range n, (1 + (ArithmeticFunction.moebius i : ℝ)) ≤ 2 * (n : ℝ) := by
  have hle : ∀ i ∈ Finset.range n, (1 + (ArithmeticFunction.moebius i : ℝ)) ≤ 2 := by
    intro i _
    have h := ArithmeticFunction.abs_moebius_le_one (n := i)
    have h' : ((|ArithmeticFunction.moebius i| : ℤ) : ℝ) ≤ 1 := by exact_mod_cast h
    have h'' : |(ArithmeticFunction.moebius i : ℝ)| ≤ 1 := by simpa [Int.cast_abs] using h'
    linarith [(abs_le.mp h'').2]
  calc ∑ i ∈ Finset.range n, (1 + (ArithmeticFunction.moebius i : ℝ))
      ≤ ∑ i ∈ Finset.range n, (2 : ℝ) := Finset.sum_le_sum hle
    _ = 2 * (n : ℝ) := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        ring

theorem hc_moebius_aux_mu_littleO_aux_sum (N : ℕ) :
    (∑ i ∈ Finset.range (N + 1), (1 + (ArithmeticFunction.moebius i : ℝ)))
      = ((N : ℝ) + 1) + ∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ) := by
  rw [Finset.sum_add_distrib]
  have h2 : (∑ i ∈ Finset.range (N + 1), (1 : ℝ)) = ((N : ℝ) + 1) := by
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    push_cast
    ring
  have h3 : (∑ i ∈ Finset.range (N + 1), (ArithmeticFunction.moebius i : ℝ))
      = ∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ) := by
    rw [Nat.range_succ_eq_Icc_zero]
    have hins : Finset.Icc 0 N = insert 0 (Finset.Icc 1 N) := by
      ext i
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    rw [hins, Finset.sum_insert (by simp)]
    simp
  rw [h2, h3]

theorem hc_moebius_aux_mu_littleO :
    Tendsto (fun N : ℕ => (∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ)) / N)
      atTop (nhds 0) := by
  have hWI : Tendsto (fun N : ℕ =>
      (∑ i ∈ Finset.range N, (1 + (ArithmeticFunction.moebius i : ℝ))) / (N : ℝ))
      atTop (nhds 1) :=
    WienerIkehara.tendsto_sum_range_div (f := fun n : ℕ => 1 + (ArithmeticFunction.moebius n : ℝ))
      (C := 2) (A := 1)
      (G := Function.update
        (fun s : ℂ => (riemannZeta s - 1 / (s - 1)) + (riemannZeta s)⁻¹) 1
        (Real.eulerMascheroniConstant : ℂ))
      hc_moebius_aux_mu_littleO_aux_bound hc_moebius_aux_mu_littleO_aux_cont hc_moebius_aux_mu_littleO_aux_eqOn (fun n => hc_moebius_aux_mu_littleO_aux_nonneg n)
  have hcomp : Tendsto (fun N : ℕ =>
      (∑ i ∈ Finset.range (N + 1), (1 + (ArithmeticFunction.moebius i : ℝ))) / ((N : ℝ) + 1))
      atTop (nhds 1) := by
    have h := hWI.comp (tendsto_add_atTop_nat 1)
    refine h.congr' ?_
    filter_upwards with N
    simp only [Function.comp_apply, Nat.cast_add, Nat.cast_one]
  have hz : Tendsto (fun N : ℕ =>
      (∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ)) / ((N : ℝ) + 1))
      atTop (nhds 0) := by
    have h3 : Tendsto (fun N : ℕ =>
        (∑ i ∈ Finset.range (N + 1), (1 + (ArithmeticFunction.moebius i : ℝ))) / ((N : ℝ) + 1) - 1)
        atTop (nhds 0) := by
      simpa using hcomp.sub (tendsto_const_nhds (x := (1 : ℝ)))
    refine h3.congr' ?_
    filter_upwards with N
    rw [hc_moebius_aux_mu_littleO_aux_sum]
    have hne : ((N : ℝ) + 1) ≠ 0 := by positivity
    field_simp
    ring
  have hratio : Tendsto (fun N : ℕ => ((N : ℝ) + 1) / (N : ℝ)) atTop (nhds 1) := by
    have h : Tendsto (fun N : ℕ => (1 : ℝ) + 1 / (N : ℝ)) atTop (nhds 1) := by
      simpa using (tendsto_const_nhds (x := (1 : ℝ))).add
        (tendsto_const_div_atTop_nhds_zero_nat (𝕜 := ℝ) 1)
    refine h.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with N hN
    have hne : (N : ℝ) ≠ 0 := by exact_mod_cast hN.ne'
    field_simp
  have hfin : Tendsto (fun N : ℕ =>
      (∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ)) / ((N : ℝ) + 1)
        * (((N : ℝ) + 1) / (N : ℝ))) atTop (nhds 0) := by
    simpa using hz.mul hratio
  refine hfin.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with N hN
  have hne : (N : ℝ) ≠ 0 := by exact_mod_cast hN.ne'
  field_simp

lemma hc_moebius_aux_axer_aux_block_fiber_eq (N j : ℕ) (hj : 1 ≤ j) :
    (Finset.Icc 1 N).filter (fun n => N / n = j) =
      Finset.Ioc (N / (j + 1)) (N / j) := by
  ext n
  simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_Ioc]
  constructor
  · rintro ⟨⟨hn1, hnN⟩, hdiv⟩
    have hnpos : 0 < n := by omega
    have hspec := (Nat.div_eq_iff hnpos).mp hdiv
    constructor
    · apply (Nat.div_lt_iff_lt_mul (Nat.succ_pos j)).2
      have heq : n * (j + 1) = j * n + n := by ring
      rw [heq]
      omega
    · apply (Nat.le_div_iff_mul_le hj).2
      simpa [Nat.mul_comm] using hspec.1
  · rintro ⟨hlo, hhi⟩
    have hnpos : 0 < n := (Nat.zero_le (N / (j + 1))).trans_lt hlo
    have hnN : n ≤ N := hhi.trans (Nat.div_le_self N j)
    have hmulhi : n * j ≤ N := (Nat.le_div_iff_mul_le hj).mp hhi
    have hmullo : N < n * (j + 1) :=
      (Nat.div_lt_iff_lt_mul (Nat.succ_pos j)).mp hlo
    refine ⟨⟨by omega, hnN⟩, (Nat.div_eq_iff hnpos).2 ?_⟩
    constructor
    · simpa [Nat.mul_comm] using hmulhi
    · have heq : n * (j + 1) = j * n + n := by ring
      omega

lemma hc_moebius_aux_axer_aux_high_sum_eq_fibers (N K : ℕ) (hK : 2 ≤ K) (f : ℕ → ℝ) :
    (∑ n ∈ Finset.Icc 1 N with N / K < n, f n) =
      ∑ j ∈ Finset.Icc 1 (K - 1),
        ∑ n ∈ Finset.Icc 1 N with N / n = j, f n := by
  symm
  rw [Finset.sum_fiberwise_eq_sum_filter]
  congr 1
  apply Finset.filter_congr
  intro n hn
  have hnIcc := Finset.mem_Icc.mp hn
  have hnpos : 0 < n := by omega
  have hqlo : 1 ≤ N / n := by
    apply (Nat.le_div_iff_mul_le hnpos).2
    simpa using hnIcc.2
  constructor
  · intro hq
    have hq' := Finset.mem_Icc.mp hq
    have hqlt : N / n < K := by omega
    have hmul : N < K * n := (Nat.div_lt_iff_lt_mul hnpos).mp hqlt
    exact (Nat.div_lt_iff_lt_mul (by omega : 0 < K)).2
      (by simpa [Nat.mul_comm] using hmul)
  · intro hnhigh
    have hmul : N < n * K :=
      (Nat.div_lt_iff_lt_mul (by omega : 0 < K)).mp hnhigh
    have hqlt : N / n < K := (Nat.div_lt_iff_lt_mul hnpos).2
      (by simpa [Nat.mul_comm] using hmul)
    exact Finset.mem_Icc.mpr ⟨hqlo, by omega⟩

lemma hc_moebius_aux_axer_aux_block_prefix (L k : ℕ) :
    (∑ i ∈ Finset.range k, (ArithmeticFunction.moebius (L + 1 + i) : ℝ)) =
      (∑ n ∈ Finset.Icc 1 (L + k), (ArithmeticFunction.moebius n : ℝ)) -
        ∑ n ∈ Finset.Icc 1 L, (ArithmeticFunction.moebius n : ℝ) := by
  have hr := Finset.sum_Ico_eq_sum_range
    (fun n => (ArithmeticFunction.moebius n : ℝ)) (L + 1) (L + 1 + k)
  rw [show L + 1 + k - (L + 1) = k by omega] at hr
  rw [← hr]
  rw [show L + 1 + k = L + k + 1 by omega]
  rw [Finset.Ico_add_one_add_one_eq_Ioc]
  have hIcc : ∀ x : ℕ, Finset.Icc 1 x = Finset.Ioc 0 x := by
    intro x
    simpa using (Finset.Icc_succ_left_eq_Ioc (0 : ℕ) x)
  rw [hIcc (L + k), hIcc L]
  have h := Finset.sum_Ioc_consecutive
    (fun n => (ArithmeticFunction.moebius n : ℝ)) (m := 0) (n := L) (k := L + k)
    (Nat.zero_le L) (Nat.le_add_right L k)
  linarith

lemma hc_moebius_aux_axer_aux_abel_block
    (L U : ℕ) (w : ℕ → ℝ) (A : ℝ)
    (hLU : L < U)
    (hM : ∀ x, L ≤ x → x ≤ U →
      |∑ n ∈ Finset.Icc 1 x, (ArithmeticFunction.moebius n : ℝ)| ≤ A)
    (hw0 : 0 ≤ w (L + 1))
    (hw_nonneg : ∀ x, L < x → x ≤ U → 0 ≤ w x)
    (hw1 : w (L + 1) ≤ 1)
    (hwanti : ∀ x y, L < x → x ≤ y → y ≤ U → w y ≤ w x) :
    |∑ n ∈ Finset.Ioc L U,
      (ArithmeticFunction.moebius n : ℝ) * w n| ≤ 2 * A := by
  let g : ℕ → ℝ := fun i => if L + 1 + i ≤ U then w (L + 1 + i) else 0
  have hsum :
      (∑ n ∈ Finset.Ioc L U,
        (ArithmeticFunction.moebius n : ℝ) * w n) =
      ∑ i ∈ Finset.range (U - L),
        (ArithmeticFunction.moebius (L + 1 + i) : ℝ) * g i := by
    rw [← Finset.Ico_add_one_add_one_eq_Ioc]
    rw [Finset.sum_Ico_eq_sum_range]
    rw [show U + 1 - (L + 1) = U - L by omega]
    apply Finset.sum_congr rfl
    intro i hi
    have hi' : i < U - L := Finset.mem_range.mp hi
    have hiu : L + 1 + i ≤ U := by omega
    simp [g, hiu]
  have hA : 0 ≤ A := (abs_nonneg _).trans (hM L le_rfl hLU.le)
  have hprefix : ∀ k ≤ U - L,
      |∑ i ∈ Finset.range k,
        (ArithmeticFunction.moebius (L + 1 + i) : ℝ)| ≤ 2 * A := by
    intro k hk
    rw [hc_moebius_aux_axer_aux_block_prefix]
    have hkU : L + k ≤ U := by omega
    calc
      |(∑ n ∈ Finset.Icc 1 (L + k), (ArithmeticFunction.moebius n : ℝ)) -
          ∑ n ∈ Finset.Icc 1 L, (ArithmeticFunction.moebius n : ℝ)| ≤
          |∑ n ∈ Finset.Icc 1 (L + k), (ArithmeticFunction.moebius n : ℝ)| +
            |∑ n ∈ Finset.Icc 1 L, (ArithmeticFunction.moebius n : ℝ)| :=
        abs_sub _ _
      _ ≤ A + A := add_le_add (hM (L + k) (by omega) hkU) (hM L le_rfl hLU.le)
      _ = 2 * A := by ring
  have hg0 : 0 ≤ g := by
    intro i
    change 0 ≤ g i
    by_cases hiu : L + 1 + i ≤ U
    · simpa [g, hiu] using hw_nonneg (L + 1 + i) (by omega) hiu
    · simp [g, hiu]
  have hg1 : g 0 ≤ 1 := by
    have hzero : L + 1 + 0 ≤ U := by omega
    simpa [g, hzero] using hw1
  have hg : AntitoneOn g (Set.Iio (U - L)) := by
    intro x hx y hy hxy
    have hx' : x < U - L := hx
    have hy' : y < U - L := hy
    have hxu : L + 1 + x ≤ U := by omega
    have hyu : L + 1 + y ≤ U := by omega
    simp only [g, if_pos hxu, if_pos hyu]
    exact hwanti (L + 1 + x) (L + 1 + y) (by omega) (by omega) hyu
  have habel := Finset.abs_sum_mul_le_mul_of_abs_sum_range_le
    (f := fun i => (ArithmeticFunction.moebius (L + 1 + i) : ℝ))
    (g := g) (M := 2 * A) (n := U - L)
    hprefix hg0 hg
  rw [hsum]
  calc
    |∑ i ∈ Finset.range (U - L),
        (ArithmeticFunction.moebius (L + 1 + i) : ℝ) * g i| ≤
        (2 * A) * g 0 := habel
    _ ≤ (2 * A) * 1 := mul_le_mul_of_nonneg_left hg1 (by positivity)
    _ = 2 * A := by ring

lemma hc_moebius_aux_axer_aux_weight_bounds (N j n : ℕ) (hj : 1 ≤ j)
    (hlo : N / (j + 1) < n) (hhi : n ≤ N / j) :
    0 ≤ (N : ℝ) / n - j ∧ (N : ℝ) / n - j ≤ 1 := by
  have hnpos : 0 < n := (Nat.zero_le (N / (j + 1))).trans_lt hlo
  have hnRpos : 0 < (n : ℝ) := by exact_mod_cast hnpos
  have hmulhiNat : n * j ≤ N := (Nat.le_div_iff_mul_le hj).mp hhi
  have hmulloNat : N < n * (j + 1) :=
    (Nat.div_lt_iff_lt_mul (Nat.succ_pos j)).mp hlo
  have hmulhi : (n : ℝ) * j ≤ N := by exact_mod_cast hmulhiNat
  have hmullo : (N : ℝ) < (n : ℝ) * ((j + 1 : ℕ) : ℝ) := by
    exact_mod_cast hmulloNat
  constructor
  · apply sub_nonneg.mpr
    apply (le_div_iff₀ hnRpos).2
    simpa [mul_comm] using hmulhi
  · have hdivlt : (N : ℝ) / n < (j : ℝ) + 1 := by
      apply (div_lt_iff₀ hnRpos).2
      simpa [mul_comm] using hmullo
    linarith

lemma hc_moebius_aux_axer_aux_weight_anti (N j : ℕ) {m n : ℕ}
    (hlo : N / (j + 1) < m) (hmn : m ≤ n) (hhi : n ≤ N / j) :
    (N : ℝ) / n - j ≤ (N : ℝ) / m - j := by
  have hmpos : 0 < m := (Nat.zero_le (N / (j + 1))).trans_lt hlo
  have hmRpos : 0 < (m : ℝ) := by exact_mod_cast hmpos
  have hmnR : (m : ℝ) ≤ n := by exact_mod_cast hmn
  have hdiv : (N : ℝ) / n ≤ (N : ℝ) / m :=
    div_le_div_of_nonneg_left (by positivity) hmRpos hmnR
  linarith

lemma hc_moebius_aux_axer_aux_divisor_identity (N : ℕ) (hN : 1 ≤ N) :
    ∑ n ∈ Finset.Icc 1 N,
        (ArithmeticFunction.moebius n : ℝ) * ((N / n : ℕ) : ℝ) = 1 := by
  have h := ArithmeticFunction.sum_Ioc_mul_zeta_eq_sum
    (ArithmeticFunction.moebius : ArithmeticFunction ℝ) N
  rw [ArithmeticFunction.coe_moebius_mul_coe_zeta] at h
  rw [← Finset.Icc_succ_left_eq_Ioc] at h
  norm_num at h
  simpa [ArithmeticFunction.one_apply, hN] using h.symm

lemma hc_moebius_aux_axer_aux_block_div_eq (N j n : ℕ) (hj : 1 ≤ j)
    (hlo : N / (j + 1) < n) (hhi : n ≤ N / j) :
    N / n = j := by
  have hnpos : 0 < n := (Nat.zero_le (N / (j + 1))).trans_lt hlo
  have hmulhi : n * j ≤ N := (Nat.le_div_iff_mul_le hj).mp hhi
  have hmullo : N < n * (j + 1) :=
    (Nat.div_lt_iff_lt_mul (Nat.succ_pos j)).mp hlo
  apply (Nat.div_eq_iff hnpos).2
  constructor
  · simpa [Nat.mul_comm] using hmulhi
  · have heq : n * (j + 1) = j * n + n := by ring
    omega

lemma hc_moebius_aux_axer_aux_frac_bounds (N n : ℕ) (hn : 1 ≤ n) :
    0 ≤ (N : ℝ) / n - ((N / n : ℕ) : ℝ) ∧
      (N : ℝ) / n - ((N / n : ℕ) : ℝ) < 1 := by
  have hnpos : 0 < (n : ℝ) := by exact_mod_cast (by omega : 0 < n)
  have hx : 0 ≤ (N : ℝ) / n := div_nonneg (by positivity) hnpos.le
  have hfloor : ((N / n : ℕ) : ℝ) = ⌊(N : ℝ) / n⌋₊ := by
    rw [Nat.floor_div_eq_div]
  constructor
  · apply sub_nonneg.mpr
    rw [hfloor]
    exact Nat.floor_le hx
  · rw [hfloor]
    have := Nat.lt_floor_add_one ((N : ℝ) / n)
    linarith

lemma hc_moebius_aux_axer_aux_term_abs_le_one (N n : ℕ) (hn : 1 ≤ n) :
    |(ArithmeticFunction.moebius n : ℝ) *
      ((N : ℝ) / n - ((N / n : ℕ) : ℝ))| ≤ 1 := by
  have hmu : |(ArithmeticFunction.moebius n : ℝ)| ≤ 1 := by
    have hi := ArithmeticFunction.abs_moebius_le_one (n := n)
    have hiR : ((|ArithmeticFunction.moebius n| : ℤ) : ℝ) ≤ 1 := by
      exact_mod_cast hi
    simpa only [Int.cast_abs] using hiR
  have hfrac := hc_moebius_aux_axer_aux_frac_bounds N n hn
  rw [abs_mul, abs_of_nonneg hfrac.1]
  calc
    |(ArithmeticFunction.moebius n : ℝ)| *
        ((N : ℝ) / n - ((N / n : ℕ) : ℝ)) ≤
        1 * ((N : ℝ) / n - ((N / n : ℕ) : ℝ)) :=
      mul_le_mul_of_nonneg_right hmu hfrac.1
    _ ≤ 1 * 1 := mul_le_mul_of_nonneg_left hfrac.2.le (by norm_num)
    _ = 1 := by ring

lemma hc_moebius_aux_axer_aux_finite_estimate
    (N K N₀ : ℕ) (η : ℝ)
    (hK : 2 ≤ K) (hη : 0 ≤ η) (hN : 1 ≤ N) (hKN : K * N₀ ≤ N)
    (hM : ∀ x, N₀ ≤ x →
      |∑ n ∈ Finset.Icc 1 x, (ArithmeticFunction.moebius n : ℝ)| ≤ η * x) :
    |(Finset.Icc 1 N).sum
        (fun n => (ArithmeticFunction.moebius n : ℝ) / n)| ≤
      1 / (N : ℝ) + 1 / (K : ℝ) + 2 * (K : ℝ) * η := by
  let R : ℝ := ∑ n ∈ Finset.Icc 1 N,
    (ArithmeticFunction.moebius n : ℝ) *
      ((N : ℝ) / n - ((N / n : ℕ) : ℝ))
  let low : ℝ := ∑ n ∈ Finset.Icc 1 N with n ≤ N / K,
    (ArithmeticFunction.moebius n : ℝ) *
      ((N : ℝ) / n - ((N / n : ℕ) : ℝ))
  let high : ℝ := ∑ n ∈ Finset.Icc 1 N with N / K < n,
    (ArithmeticFunction.moebius n : ℝ) *
      ((N : ℝ) / n - ((N / n : ℕ) : ℝ))
  have hNpos : 0 < (N : ℝ) := by exact_mod_cast (by omega : 0 < N)
  have hKpos : 0 < K := by omega
  have hKrealpos : 0 < (K : ℝ) := by exact_mod_cast hKpos
  have hNS :
      (N : ℝ) * (Finset.Icc 1 N).sum
        (fun n => (ArithmeticFunction.moebius n : ℝ) / n) = 1 + R := by
    dsimp only [R]
    calc
      (N : ℝ) * (Finset.Icc 1 N).sum
          (fun n => (ArithmeticFunction.moebius n : ℝ) / n) =
          ∑ n ∈ Finset.Icc 1 N,
            (N : ℝ) * ((ArithmeticFunction.moebius n : ℝ) / n) := by
        rw [Finset.mul_sum]
      _ = ∑ n ∈ Finset.Icc 1 N,
          (ArithmeticFunction.moebius n : ℝ) * ((N : ℝ) / n) := by
        apply Finset.sum_congr rfl
        intro n hn
        simp only [div_eq_mul_inv]
        ring
      _ = (∑ n ∈ Finset.Icc 1 N,
          (ArithmeticFunction.moebius n : ℝ) * ((N / n : ℕ) : ℝ)) +
          ∑ n ∈ Finset.Icc 1 N,
            (ArithmeticFunction.moebius n : ℝ) *
              ((N : ℝ) / n - ((N / n : ℕ) : ℝ)) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro n hn
        ring
      _ = 1 + ∑ n ∈ Finset.Icc 1 N,
          (ArithmeticFunction.moebius n : ℝ) *
            ((N : ℝ) / n - ((N / n : ℕ) : ℝ)) := by
        rw [hc_moebius_aux_axer_aux_divisor_identity N hN]
  have hS :
      (Finset.Icc 1 N).sum (fun n => (ArithmeticFunction.moebius n : ℝ) / n) =
        1 / (N : ℝ) + R / (N : ℝ) := by
    calc
      (Finset.Icc 1 N).sum (fun n => (ArithmeticFunction.moebius n : ℝ) / n) =
          (1 + R) / (N : ℝ) := (eq_div_iff hNpos.ne').2
            (by simpa [mul_comm] using hNS)
      _ = 1 / (N : ℝ) + R / (N : ℝ) := by ring
  have hsplit : R = low + high := by
    dsimp only [R, low, high]
    have hs := Finset.sum_filter_add_sum_filter_not (Finset.Icc 1 N)
      (fun n => n ≤ N / K)
      (fun n => (ArithmeticFunction.moebius n : ℝ) *
        ((N : ℝ) / n - ((N / n : ℕ) : ℝ)))
    simpa only [not_le] using hs.symm
  have hlowcard :
      Finset.card ((Finset.Icc 1 N).filter (fun n => n ≤ N / K)) ≤ N / K := by
    calc
      Finset.card ((Finset.Icc 1 N).filter (fun n => n ≤ N / K)) ≤
          Finset.card (Finset.Icc 1 (N / K)) := by
        apply Finset.card_le_card
        intro n hn
        have hn' := Finset.mem_filter.mp hn
        have hbase := Finset.mem_Icc.mp hn'.1
        exact Finset.mem_Icc.mpr ⟨hbase.1, hn'.2⟩
      _ = N / K := by simp
  have hlow : |low| ≤ ((N / K : ℕ) : ℝ) := by
    dsimp only [low]
    calc
      |∑ n ∈ (Finset.Icc 1 N).filter (fun n => n ≤ N / K),
          (ArithmeticFunction.moebius n : ℝ) *
            ((N : ℝ) / n - ((N / n : ℕ) : ℝ))| ≤
          ∑ n ∈ (Finset.Icc 1 N).filter (fun n => n ≤ N / K),
            |(ArithmeticFunction.moebius n : ℝ) *
              ((N : ℝ) / n - ((N / n : ℕ) : ℝ))| :=
        Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ n ∈ (Finset.Icc 1 N).filter (fun n => n ≤ N / K), (1 : ℝ) := by
        apply Finset.sum_le_sum
        intro n hn
        exact hc_moebius_aux_axer_aux_term_abs_le_one N n (Finset.mem_Icc.mp (Finset.mem_filter.mp hn).1).1
      _ = (Finset.card ((Finset.Icc 1 N).filter (fun n => n ≤ N / K)) : ℝ) := by simp
      _ ≤ ((N / K : ℕ) : ℝ) := by exact_mod_cast hlowcard
  have hinner : ∀ j ∈ Finset.Icc 1 (K - 1),
      |∑ n ∈ Finset.Icc 1 N with N / n = j,
        (ArithmeticFunction.moebius n : ℝ) *
          ((N : ℝ) / n - ((N / n : ℕ) : ℝ))| ≤ 2 * η * (N : ℝ) := by
    intro j hjmem
    have hj : 1 ≤ j := (Finset.mem_Icc.mp hjmem).1
    rw [hc_moebius_aux_axer_aux_block_fiber_eq N j hj]
    let L := N / (j + 1)
    let U := N / j
    have heq :
        (∑ n ∈ Finset.Ioc L U,
          (ArithmeticFunction.moebius n : ℝ) *
            ((N : ℝ) / n - ((N / n : ℕ) : ℝ))) =
        ∑ n ∈ Finset.Ioc L U,
          (ArithmeticFunction.moebius n : ℝ) * ((N : ℝ) / n - j) := by
      apply Finset.sum_congr rfl
      intro n hn
      have hn' := Finset.mem_Ioc.mp hn
      rw [hc_moebius_aux_axer_aux_block_div_eq N j n hj hn'.1 hn'.2]
    rw [heq]
    by_cases hLU : L < U
    · have hjhi : j ≤ K - 1 := (Finset.mem_Icc.mp hjmem).2
      have hden : j + 1 ≤ K := by omega
      have hdivK : N / K ≤ N / (j + 1) := by
        apply (Nat.le_div_iff_mul_le (Nat.succ_pos j)).2
        have hmul := Nat.mul_le_mul_right (N / K) hden
        have hbase := Nat.mul_div_le N K
        have hmul' : (N / K) * (j + 1) ≤ (N / K) * K := by
          simpa [Nat.mul_comm] using hmul
        exact hmul'.trans (by simpa [Nat.mul_comm] using hbase)
      have hN₀div : N₀ ≤ N / K := by
        apply (Nat.le_div_iff_mul_le hKpos).2
        simpa [Nat.mul_comm] using hKN
      have hblockM : ∀ x, L ≤ x → x ≤ U →
          |∑ n ∈ Finset.Icc 1 x, (ArithmeticFunction.moebius n : ℝ)| ≤
            η * (N : ℝ) := by
        intro x hxL hxU
        have hxN₀ : N₀ ≤ x := hN₀div.trans (hdivK.trans (by simpa [L] using hxL))
        have hxN : x ≤ N := by
          exact hxU.trans (by simpa [U] using Nat.div_le_self N j)
        calc
          |∑ n ∈ Finset.Icc 1 x, (ArithmeticFunction.moebius n : ℝ)| ≤
              η * (x : ℝ) := hM x hxN₀
          _ ≤ η * (N : ℝ) := by
            exact mul_le_mul_of_nonneg_left (by exact_mod_cast hxN) hη
      have hw := hc_moebius_aux_axer_aux_weight_bounds N j (L + 1) hj (by omega) (by omega)
      have hbound := hc_moebius_aux_axer_aux_abel_block L U (fun n => (N : ℝ) / n - j) (η * (N : ℝ))
        hLU hblockM hw.1
        (fun x hx hxU => (hc_moebius_aux_axer_aux_weight_bounds N j x hj (by simpa [L] using hx)
          (by simpa [U] using hxU)).1)
        hw.2
        (fun x y hx hxy hy => hc_moebius_aux_axer_aux_weight_anti N j (by simpa [L] using hx) hxy
          (by simpa [U] using hy))
      simpa [mul_assoc] using hbound
    · have hUL : U ≤ L := Nat.le_of_not_gt hLU
      rw [Finset.Ioc_eq_empty_of_le hUL, Finset.sum_empty, abs_zero]
      positivity
  have hhigh : |high| ≤ 2 * (K : ℝ) * η * (N : ℝ) := by
    dsimp only [high]
    rw [hc_moebius_aux_axer_aux_high_sum_eq_fibers N K hK]
    calc
      |∑ j ∈ Finset.Icc 1 (K - 1),
          ∑ n ∈ Finset.Icc 1 N with N / n = j,
            (ArithmeticFunction.moebius n : ℝ) *
              ((N : ℝ) / n - ((N / n : ℕ) : ℝ))| ≤
          ∑ j ∈ Finset.Icc 1 (K - 1),
            |∑ n ∈ Finset.Icc 1 N with N / n = j,
              (ArithmeticFunction.moebius n : ℝ) *
                ((N : ℝ) / n - ((N / n : ℕ) : ℝ))| :=
        Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ j ∈ Finset.Icc 1 (K - 1), 2 * η * (N : ℝ) := by
        apply Finset.sum_le_sum
        intro j hj
        exact hinner j hj
      _ = ((K - 1 : ℕ) : ℝ) * (2 * η * (N : ℝ)) := by simp
      _ ≤ (K : ℝ) * (2 * η * (N : ℝ)) := by
        gcongr
        exact_mod_cast (by omega : K - 1 ≤ K)
      _ = 2 * (K : ℝ) * η * (N : ℝ) := by ring
  have hR : |R| ≤ ((N / K : ℕ) : ℝ) + 2 * (K : ℝ) * η * (N : ℝ) := by
    rw [hsplit]
    calc
      |low + high| ≤ |low| + |high| := abs_add_le _ _
      _ ≤ ((N / K : ℕ) : ℝ) + 2 * (K : ℝ) * η * (N : ℝ) := add_le_add hlow hhigh
  have hfloorNat : (N / K) * K ≤ N := by
    simpa [Nat.mul_comm] using Nat.mul_div_le N K
  have hfloorReal : ((N / K : ℕ) : ℝ) * (K : ℝ) ≤ (N : ℝ) := by
    exact_mod_cast hfloorNat
  have hlowNorm :
      ((N / K : ℕ) : ℝ) / (N : ℝ) ≤ 1 / (K : ℝ) := by
    apply (div_le_div_iff₀ hNpos hKrealpos).2
    simpa using hfloorReal
  rw [hS]
  calc
    |1 / (N : ℝ) + R / (N : ℝ)| ≤
        |1 / (N : ℝ)| + |R / (N : ℝ)| := abs_add_le _ _
    _ = 1 / (N : ℝ) + |R| / (N : ℝ) := by
      rw [abs_of_nonneg (by positivity), abs_div, abs_of_nonneg hNpos.le]
    _ ≤ 1 / (N : ℝ) +
        (((N / K : ℕ) : ℝ) + 2 * (K : ℝ) * η * (N : ℝ)) / (N : ℝ) := by
      gcongr
    _ = 1 / (N : ℝ) + ((N / K : ℕ) : ℝ) / (N : ℝ) +
        2 * (K : ℝ) * η := by
      field_simp [hNpos.ne']
      <;> ring
    _ ≤ 1 / (N : ℝ) + 1 / (K : ℝ) + 2 * (K : ℝ) * η := by
      gcongr

lemma hc_moebius_aux_axer_aux_mertens_eventual_bound
    (h : Tendsto (fun N : ℕ =>
      (∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ)) / N)
      atTop (nhds 0))
    {η : ℝ} (hη : 0 < η) :
    ∃ N₀ : ℕ, 1 ≤ N₀ ∧ ∀ x, N₀ ≤ x →
      |∑ n ∈ Finset.Icc 1 x, (ArithmeticFunction.moebius n : ℝ)| ≤ η * x := by
  obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.1 h η hη)
  refine ⟨max N 1, le_max_right _ _, ?_⟩
  intro x hx
  have hxN : N ≤ x := (le_max_left N 1).trans hx
  have hx1 : 1 ≤ x := (le_max_right N 1).trans hx
  have hxpos : 0 < (x : ℝ) := by exact_mod_cast (by omega : 0 < x)
  have hdist := hN x hxN
  have hdiv : |∑ n ∈ Finset.Icc 1 x, (ArithmeticFunction.moebius n : ℝ)| /
      (x : ℝ) < η := by
    simpa [Real.dist_eq] using hdist
  exact ((div_lt_iff₀ hxpos).mp hdiv).le

theorem hc_moebius_aux_axer
    (h : Tendsto (fun N : ℕ => (∑ n ∈ Finset.Icc 1 N, (ArithmeticFunction.moebius n : ℝ)) / N)
      atTop (nhds 0)) :
    Tendsto (fun N : ℕ => (Finset.Icc 1 N).sum (fun n => (ArithmeticFunction.moebius n : ℝ)/n))
      atTop (nhds 0) := by
  refine Metric.tendsto_atTop.2 ?_
  intro δ hδ
  obtain ⟨K₀, hK₀⟩ := exists_nat_gt (3 / δ)
  let K := K₀ + 2
  have hK : 2 ≤ K := by dsimp [K]; omega
  have hKpos : 0 < K := by omega
  have hKrealpos : 0 < (K : ℝ) := by exact_mod_cast hKpos
  have hKgt : 3 / δ < (K : ℝ) := by
    exact hK₀.trans (by dsimp [K]; norm_num)
  have hthree : 3 < δ * (K : ℝ) := by
    simpa [mul_comm] using (div_lt_iff₀ hδ).mp hKgt
  have hKrecip : 1 / (K : ℝ) < δ / 3 := by
    apply (div_lt_iff₀ hKrealpos).2
    nlinarith
  let η : ℝ := δ / (12 * (K : ℝ))
  have hη : 0 < η := by dsimp [η]; positivity
  obtain ⟨N₀, hN₀, hM⟩ := hc_moebius_aux_axer_aux_mertens_eventual_bound h hη
  obtain ⟨N₁, hN₁⟩ := exists_nat_gt (6 / δ)
  let B := max (K * N₀) N₁
  refine ⟨B, ?_⟩
  intro N hN
  have hKN : K * N₀ ≤ N := (le_max_left (K * N₀) N₁).trans hN
  have hNN₁ : N₁ ≤ N := (le_max_right (K * N₀) N₁).trans hN
  have hN1 : 1 ≤ N := by
    have : 1 ≤ K * N₀ := Nat.le_trans hN₀ (Nat.le_mul_of_pos_left N₀ hKpos)
    exact this.trans hKN
  have hNpos : 0 < (N : ℝ) := by exact_mod_cast (by omega : 0 < N)
  have hN₁N : (N₁ : ℝ) ≤ (N : ℝ) := by exact_mod_cast hNN₁
  have hNgt : 6 / δ < (N : ℝ) := hN₁.trans_le hN₁N
  have hsix : 6 < δ * (N : ℝ) := by
    simpa [mul_comm] using (div_lt_iff₀ hδ).mp hNgt
  have hNrecip : 1 / (N : ℝ) < δ / 6 := by
    apply (div_lt_iff₀ hNpos).2
    nlinarith
  have hconst : 2 * (K : ℝ) * η = δ / 6 := by
    dsimp [η]
    field_simp [hKrealpos.ne']
    <;> ring
  have hest := hc_moebius_aux_axer_aux_finite_estimate N K N₀ η hK hη.le hN1 hKN hM
  rw [Real.dist_eq, sub_zero]
  exact hest.trans_lt (by rw [hconst]; nlinarith)

end GoldbachGrahamMoebius
end

section


namespace GoldbachMoebiusLog

open Finset Filter ArithmeticFunction GoldbachGrahamMoebius
open scoped ArithmeticFunction.Moebius

noncomputable section

def logMoebiusSum (x : ℝ) : ℝ :=
  ∑ n ∈ Icc 1 ⌊x⌋₊, ((moebius n:ℝ)/(n:ℝ))*Real.log (x/(n:ℝ))

private def harmonicError (N n : ℕ) : ℝ :=
  (harmonic (N/n):ℝ)-Real.log ((N:ℝ)/(n:ℝ))-Real.eulerMascheroniConstant

private def harmonicErrorSum (N : ℕ) : ℝ :=
  ∑ n ∈ Icc 1 N, ((moebius n:ℝ)/(n:ℝ))*harmonicError N n

private theorem harmonicError_abs_mul_le {N n : ℕ} (hn : 1 ≤ n) (hN : n ≤ N) :
    |((moebius n:ℝ)/(n:ℝ))*harmonicError N n| ≤ 2/(N:ℝ) := by
  have hn0 : (0:ℝ) < n := by exact_mod_cast Nat.zero_lt_one.trans_le hn
  have hN0 : (0:ℝ) < N := by exact_mod_cast Nat.zero_lt_one.trans_le (hn.trans hN)
  have hnR : (n:ℝ) ≤ N := by exact_mod_cast hN
  have hy : 1 ≤ (N:ℝ)/(n:ℝ) := (le_div_iff₀ hn0).mpr (by simpa using hnR)
  have he := harmonic_floor_log_error hy
  rw [Nat.floor_div_eq_div] at he
  rw [abs_mul,abs_div,abs_of_pos hn0]
  calc
    _ ≤ (1/(n:ℝ))*(2/((N:ℝ)/(n:ℝ))) :=
      mul_le_mul (div_le_div_of_nonneg_right (abs_moebius_real_le_one n) hn0.le) he
        (abs_nonneg _) (by positivity)
    _ = _ := by field_simp [hn0.ne',hN0.ne']

private theorem normalized_moebius_block_le {N a b : ℕ} (hN : 0 < N) {η C : ℝ} (hη : 0 ≤ η)
    (hC : 0 < C) (w : ℕ→ℝ)
    (hM : ∀ n, a ≤ n → n ≤ b → |∑ i∈Icc 1 n,(moebius i:ℝ)| ≤ η*(N:ℝ))
    (hw : ∀ n, a < n → n ≤ b → 0 ≤ w n ∧ w n ≤ C)
    (hA : ∀ i j, a < i → i ≤ j → j ≤ b → w j ≤ w i) :
    |(∑ n ∈ Ioc a b, (moebius n:ℝ)*w n)/(N:ℝ)| ≤ 2*η*C := by
  by_cases hab : a < b
  · have hNext : a+1 ≤ b := hab
    have hA' := hc_moebius_aux_axer_aux_abel_block a b (fun n => w n/C) (η*(N:ℝ)) hab hM
      (div_nonneg ((hw _ (Nat.lt_succ_self a) hNext).1) hC.le)
      (fun n ha hb => div_nonneg (hw n ha hb).1 hC.le)
      ((div_le_one hC).mpr ((hw _ (Nat.lt_succ_self a) hNext).2))
      (fun i j hai hij hjb => div_le_div_of_nonneg_right (hA i j hai hij hjb) hC.le)
    have he : (∑ n∈Ioc a b,(moebius n:ℝ)*(w n/C))=(∑ n∈Ioc a b,(moebius n:ℝ)*w n)/C := by
      rw [sum_div]
      apply sum_congr rfl
      intro n _
      rw [mul_div_assoc]
    have hNR : (0:ℝ) < N := by exact_mod_cast hN
    rw [he,abs_div,abs_of_pos hC] at hA'
    rw [abs_div,abs_of_pos hNR]
    have hsum := (div_le_iff₀ hC).mp hA'
    apply (div_le_iff₀ hNR).mpr
    convert hsum using 1 <;> ring
  · simp [Ioc_eq_empty hab, mul_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 2) hη) hC.le]

private theorem harmonicError_fiber_le {N K j : ℕ} (hN : 0 < N) (hK : 2 ≤ K) (hj : j∈Icc 1 (K-1))
    {η : ℝ} (hη : 0 ≤ η)
    (hM : ∀ n, N/K ≤ n → n ≤ N → |∑ i∈Icc 1 n,(moebius i:ℝ)| ≤ η*(N:ℝ)) :
    |∑ n ∈ (Icc 1 N).filter (fun n => N/n=j), ((moebius n:ℝ)/(n:ℝ))*harmonicError N n| ≤
      2*η*((K:ℝ) * |(harmonic j:ℝ)-Real.eulerMascheroniConstant|+(K:ℝ)^2) := by
  have hj₁ := (mem_Icc.mp hj).1
  have hjK : j+1 ≤ K := by have := (mem_Icc.mp hj).2; omega
  let A := N/(j+1)
  let B := N/j
  let u (n : ℕ) := (N:ℝ)/(n:ℝ)
  let v (n : ℕ) := u n*Real.log (u n)
  let γ := Real.eulerMascheroniConstant
  have hK0 : (0:ℝ) < K := by exact_mod_cast (by omega : 0 < K)
  have hNR : (0:ℝ) < N := by exact_mod_cast hN
  have hM' (n : ℕ) (hnA : A ≤ n) (hnB : n ≤ B) :
      |∑ i∈Icc 1 n,(moebius i:ℝ)| ≤ η*(N:ℝ) := by
    apply hM n ((Nat.div_le_div_left hjK (Nat.succ_pos j)).trans hnA)
    exact hnB.trans (Nat.div_le_self _ _)
  have hu (n : ℕ) (ha : A < n) (hb : n ≤ B) : 1 ≤ u n ∧ u n ≤ K := by
    obtain ⟨hlo,hhi⟩ := hc_moebius_aux_axer_aux_weight_bounds N j n hj₁ ha hb
    have hjR₁ : (1:ℝ) ≤ j := by exact_mod_cast hj₁
    have hjRK : (j:ℝ)+1 ≤ K := by exact_mod_cast hjK
    constructor <;> dsimp only [u] <;> linarith only [hlo,hhi,hjR₁,hjRK]
  have hU (n m : ℕ) (hn : A < n) (hnm : n ≤ m) (_ : m ≤ B) : u m ≤ u n := by
    have hnR : (0:ℝ) < n := by exact_mod_cast (Nat.zero_lt_of_lt hn)
    exact div_le_div_of_nonneg_left hNR.le hnR (by exact_mod_cast hnm)
  have hUbound := normalized_moebius_block_le hN hη hK0 u hM'
    (fun n ha hb => ⟨zero_le_one.trans (hu n ha hb).1,(hu n ha hb).2⟩) hU
  have hVbound : |(∑ n∈Ioc A B,(moebius n:ℝ)*v n)/(N:ℝ)| ≤ 2*η*(K:ℝ)^2 := by
    refine normalized_moebius_block_le hN hη (sq_pos_of_pos hK0) v hM' ?_ ?_
    · intro n ha hb
      obtain ⟨h₁,h₂⟩ := hu n ha hb
      have h₃ : Real.log (u n) ≤ K :=
        (Real.log_le_sub_one_of_pos (zero_lt_one.trans_le h₁)).trans ((sub_le_self _ zero_le_one).trans h₂)
      have h₄ := Real.log_nonneg h₁
      exact ⟨mul_nonneg (zero_le_one.trans h₁) h₄, by
        simpa only [v,pow_two] using mul_le_mul h₂ h₃ h₄ hK0.le⟩
    · intro n m ha hnm hb
      have h := hU n m ha hnm hb
      have h₁ := (hu m (ha.trans_le hnm) hb).1
      exact mul_le_mul h (Real.log_le_log (zero_lt_one.trans_le h₁) h)
        (Real.log_nonneg h₁) (zero_le_one.trans (h₁.trans h))
  rw [hc_moebius_aux_axer_aux_block_fiber_eq N j hj₁]
  change |∑ n∈Ioc A B,((moebius n:ℝ)/(n:ℝ))*harmonicError N n| ≤ _
  have hEq : (∑ n∈Ioc A B,((moebius n:ℝ)/(n:ℝ))*harmonicError N n) =
      ((harmonic j:ℝ)-γ)*((∑ n∈Ioc A B,(moebius n:ℝ)*u n)/(N:ℝ))-
        (∑ n∈Ioc A B,(moebius n:ℝ)*v n)/(N:ℝ) := by
    simp_rw [sum_div,mul_sum,←sum_sub_distrib]
    apply sum_congr rfl
    intro n hn
    obtain ⟨ha,hb⟩ := mem_Ioc.mp hn
    have hdiv := hc_moebius_aux_axer_aux_block_div_eq N j n hj₁ ha hb
    dsimp only [harmonicError,u,v,γ]
    rw [hdiv]
    field_simp [hNR.ne',show (n:ℝ)≠0 by exact_mod_cast (Nat.ne_of_gt (Nat.zero_lt_of_lt ha))]
    ring
  rw [hEq]
  refine (abs_sub _ _).trans ?_
  rw [abs_mul]
  calc
    _ ≤ |(harmonic j:ℝ)-γ| * (2*η*(K:ℝ))+2*η*(K:ℝ)^2 :=
      (add_le_add) (mul_le_mul_of_nonneg_left hUbound (abs_nonneg _)) hVbound
    _ = _ := by ring

private theorem harmonicErrorSum_tendsto_zero : Tendsto harmonicErrorSum atTop (nhds 0) := by
  refine Metric.tendsto_atTop.2 ?_
  intro δ hδ
  obtain ⟨K₀,hK₀⟩ := exists_nat_gt (4/δ)
  let K := K₀+2
  have hK : 2 ≤ K := by dsimp [K]; omega
  have hK0 : (0:ℝ) < K := by exact_mod_cast (by omega : 0 < K)
  have hKlarge : 4/δ < (K:ℝ) := hK₀.trans (by dsimp [K]; norm_num)
  have hSmall : 2/(K:ℝ)<δ/2 := by
    apply (div_lt_iff₀ hK0).2
    nlinarith only [(div_lt_iff₀ hδ).mp hKlarge]
  let D : ℝ := ∑ j∈ Icc 1 (K-1), ((K:ℝ) * |(harmonic j:ℝ)-Real.eulerMascheroniConstant|+(K:ℝ)^2)
  have hD : 0 ≤ D := by
    dsimp only [D]
    apply Finset.sum_nonneg
    intro j _
    positivity
  let η := δ/(4*(D+1))
  have hη : 0<η := by dsimp [η]; positivity
  obtain ⟨N₀,hN₀,hM⟩ := hc_moebius_aux_axer_aux_mertens_eventual_bound hc_moebius_aux_mu_littleO hη
  refine ⟨K*N₀,fun N hN => ?_⟩
  have hKM : N₀ ≤ N/K := (Nat.le_div_iff_mul_le (by omega : 0 < K)).2 (by simpa [Nat.mul_comm] using hN)
  have hNpos : 0 < N := (Nat.mul_pos (by omega) (Nat.zero_lt_one.trans_le hN₀)).trans_le hN
  have hNR : (0:ℝ) < N := by exact_mod_cast hNpos
  let F (n : ℕ) := ((moebius n:ℝ)/(n:ℝ))*harmonicError N n
  let S := Icc 1 N
  have hM' (m : ℕ) (h₁ : N/K ≤ m) (h₂ : m ≤ N) : |∑ n∈Icc 1 m,(moebius n:ℝ)| ≤ η*(N:ℝ) :=
    (hM m (hKM.trans h₁)).trans (mul_le_mul_of_nonneg_left (by exact_mod_cast h₂) hη.le)
  have hLow : |∑ n∈S.filter (fun n => n ≤ N/K),F n| ≤ 2/(K:ℝ) := by
    have hSet : S.filter (fun n => n ≤ N/K)=Icc 1 (N/K) := by
      ext n
      simp only [S,mem_filter,mem_Icc]
      exact ⟨fun h => ⟨h.1.1,h.2⟩, fun h => ⟨⟨h.1,h.2.trans (Nat.div_le_self _ _)⟩,h.2⟩⟩
    rw [hSet]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc
      _ ≤ ∑ _∈Icc 1 (N/K), (2:ℝ)/(N:ℝ) :=
        sum_le_sum fun n hn => harmonicError_abs_mul_le (mem_Icc.mp hn).1
          ((mem_Icc.mp hn).2.trans (Nat.div_le_self _ _))
      _ = ((N/K:ℕ):ℝ)*(2/(N:ℝ)) := by
        simp only [sum_const,nsmul_eq_mul,Nat.card_Icc,Nat.add_sub_cancel]
      _ ≤ _ := by
        have hh : ((N/K:ℕ):ℝ)*(K:ℝ) ≤ N := by exact_mod_cast Nat.div_mul_le_self N K
        apply (le_div_iff₀ hK0).mpr
        rw [show ((N/K:ℕ):ℝ)*(2/(N:ℝ))*(K:ℝ)=(((N/K:ℕ):ℝ)*(K:ℝ))*(2/(N:ℝ)) by ring]
        exact (mul_le_mul_of_nonneg_right hh (by positivity)).trans_eq (mul_div_cancel₀ _ hNR.ne')
  have hHigh : |∑ n∈S.filter (fun n => N/K < n),F n| ≤ 2*η*D := by
    rw [hc_moebius_aux_axer_aux_high_sum_eq_fibers N K hK F]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc
      _ ≤ ∑ j ∈ Icc 1 (K-1), (2*η)*((K:ℝ) * |(harmonic j:ℝ)-Real.eulerMascheroniConstant|+(K:ℝ)^2) :=
        sum_le_sum fun j hj => harmonicError_fiber_le hNpos hK hj hη.le hM'
      _ = _ := by simp only [D,Finset.mul_sum]
  have hEq : harmonicErrorSum N = (∑ n∈S.filter (fun n => n ≤ N/K),F n)+
      (∑ n∈S.filter (fun n => N/K < n),F n) := by
    simpa only [harmonicErrorSum,S,F,not_le] using
      (sum_filter_add_sum_filter_not S (fun n => n ≤ N/K) F).symm
  have hTiny : 2*η*D ≤ δ/2 := by
    dsimp only [η]
    have hDen : 0 < D+1 := by positivity
    calc
      _ = (δ/2*D)/(D+1) := by field_simp [hDen.ne']; ring
      _ ≤ _ := (div_le_iff₀ hDen).mpr (by nlinarith only [hδ])
  rw [Real.dist_eq,sub_zero,hEq]
  exact ((abs_add_le _ _).trans (add_le_add hLow hHigh)).trans_lt (by linarith only [hSmall,hTiny])

/-- Qualitative PNT suffices for the nonshifted logarithmic Möbius sum. -/
theorem tendsto_logMoebiusSum_one_nat : Tendsto (fun N : ℕ => logMoebiusSum N) atTop (nhds 1) := by
  let M (N : ℕ) := ∑ n∈Icc 1 N,(moebius n:ℝ)/(n:ℝ)
  have hM : Tendsto M atTop (nhds 0) := hc_moebius_aux_axer hc_moebius_aux_mu_littleO
  have h := (tendsto_const_nhds (x:=(1:ℝ))).sub
    ((tendsto_const_nhds (x:=Real.eulerMascheroniConstant)).mul hM |>.add harmonicErrorSum_tendsto_zero)
  simp only [mul_zero,add_zero,sub_zero] at h
  refine h.congr' ?_
  filter_upwards [eventually_ge_atTop (1:ℕ)] with N hN
  have hId := sum_moebius_harmonic (N:ℝ) (by exact_mod_cast hN)
  simp only [Nat.floor_natCast,Nat.floor_div_eq_div] at hId
  have hsum : logMoebiusSum N+Real.eulerMascheroniConstant*M N+harmonicErrorSum N=1 := by
    rw [logMoebiusSum,Nat.floor_natCast,harmonicErrorSum]
    dsimp only [M]
    rw [mul_sum,←sum_add_distrib,←sum_add_distrib,←hId]
    apply sum_congr rfl
    intro n _
    dsimp only [harmonicError]
    ring
  linarith only [hsum]

/-- The real-cutoff form used by the scaled sieve Laplace argument. -/
theorem tendsto_logMoebiusSum_one : Tendsto logMoebiusSum atTop (nhds 1) := by
  have hN : Tendsto (fun x : ℝ => ⌊x⌋₊) atTop atTop := tendsto_nat_floor_atTop
  have hF := tendsto_logMoebiusSum_one_nat.comp hN
  have he : Tendsto (fun x : ℝ => logMoebiusSum x-logMoebiusSum (⌊x⌋₊:ℕ)) atTop (nhds 0) := by
    have hInv := (tendsto_const_div_atTop_nhds_zero_nat (𝕜:=ℝ) 2).comp hN
    apply squeeze_zero_norm' ?_ hInv
    filter_upwards [eventually_ge_atTop (1:ℝ)] with x hx
    let N := ⌊x⌋₊
    have hN₁ : 1 ≤ N := Nat.le_floor hx
    have hNpos : (0:ℝ) < N := by exact_mod_cast Nat.zero_lt_one.trans_le hN₁
    have hNx : (N:ℝ) ≤ x := Nat.floor_le (zero_le_one.trans hx)
    have heq : logMoebiusSum x-logMoebiusSum (N:ℕ) =
        Real.log (x/(N:ℝ))*(∑ n∈Icc 1 N,(moebius n:ℝ)/(n:ℝ)) := by
      rw [logMoebiusSum,logMoebiusSum,Nat.floor_natCast]
      change (∑ n∈Icc 1 N,((moebius n:ℝ)/(n:ℝ))*Real.log (x/(n:ℝ))) - _ = _
      rw [←sum_sub_distrib,mul_sum]
      apply sum_congr rfl
      intro n hn
      have hn0 : (0:ℝ) < n := by exact_mod_cast (Nat.zero_lt_one.trans_le (mem_Icc.mp hn).1)
      rw [Real.log_div (by positivity : x≠0) hn0.ne',Real.log_div hNpos.ne' hn0.ne',
        Real.log_div (by positivity : x≠0) hNpos.ne']
      ring
    rw [Function.comp_apply,Real.norm_eq_abs,heq,abs_mul,abs_of_nonneg (Real.log_nonneg (by
      exact (one_le_div hNpos).2 hNx))]
    have hlog : Real.log (x/(N:ℝ)) ≤ 1/(N:ℝ) := by
      have h := Real.log_le_sub_one_of_pos (div_pos (zero_lt_one.trans_le hx) hNpos)
      apply h.trans
      have hxx : x ≤ (N:ℝ)+1 := (Nat.lt_floor_add_one x).le
      have hb := div_le_div_of_nonneg_right hxx hNpos.le
      rw [add_div,div_self hNpos.ne'] at hb
      linarith only [hb]
    have hM := abs_sum_moebius_div_le (x:=(N:ℝ)) (by exact_mod_cast hN₁)
    simp only [Nat.floor_natCast] at hM
    exact (mul_le_mul hlog hM (abs_nonneg _) (by positivity)).trans_eq (by ring)
  have h := he.add hF
  simpa only [Function.comp_apply,sub_add_cancel,zero_add] using h

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

noncomputable section

set_option maxHeartbeats 950000 in

private theorem affine_error_core (a b base prev goal prevGoal H E C z gap loss : ℝ)
    (ha : 0≤a) (ha₁ : a≤1) (hb : 0≤b) (hb₁ : b≤1)
    (hbase : |base-goal|≤H) (hprev : |prev-prevGoal|≤E+C*z)
    (hgap : |prevGoal-goal|≤gap) (hloss : |(b-1)*goal|≤loss) :
    |(1-a)*base+a*b*prev-goal|≤(1-a)*H+a*(E+C*z)+a*gap+a*loss := by
  let P := (1-a)*(base-goal)
  let Q := (a*b)*(prev-prevGoal)
  let R := (a*b)*(prevGoal-goal)
  let S := a*((b-1)*goal)
  have h1a := sub_nonneg.mpr ha₁
  have hab := mul_nonneg ha hb
  have hab₁ := mul_le_of_le_one_right ha hb₁
  have hP : |P|≤(1-a)*H := by
    change |(1-a)*(base-goal)|≤_
    rw [abs_mul,abs_of_nonneg h1a]
    exact mul_le_mul_of_nonneg_left hbase h1a
  have hQ : |Q|≤a*(E+C*z) := by
    change |(a*b)*(prev-prevGoal)|≤_
    rw [abs_mul,abs_of_nonneg hab]
    exact mul_le_mul hab₁ hprev (abs_nonneg _) ha
  have hR : |R|≤a*gap := by
    change |(a*b)*(prevGoal-goal)|≤_
    rw [abs_mul,abs_of_nonneg hab]
    exact mul_le_mul hab₁ hgap (abs_nonneg _) ha
  have hS : |S|≤a*loss := by
    change |a*((b-1)*goal)|≤_
    rw [abs_mul,abs_of_nonneg ha]
    exact mul_le_mul_of_nonneg_left hloss ha
  have hm : (1-a)*base+a*b*prev-goal=P+Q+R+S := by
    dsimp only [P,Q,R,S]
    ring
  rw [hm,abs_le]
  have hsum : |P|+|Q|+|R|+|S|≤(1-a)*H+a*(E+C*z)+a*gap+a*loss :=
    (add_le_add) (add_le_add (add_le_add hP hQ) hR) hS
  exact ⟨by linarith only [neg_abs_le P,neg_abs_le Q,neg_abs_le R,neg_abs_le S,hsum],
    by linarith only [le_abs_self P,le_abs_self Q,le_abs_self R,le_abs_self S,hsum]⟩

set_option maxHeartbeats 950000 in
/-- Pointwise one-prime stability with a positive main term and a Lipschitz envelope. -/
theorem primeRecurrence_stable {a e z M H C base prev goal prevGoal : ℝ}
    (ha : 0≤a) (ha₁ : a<1) (he : 0≤e) (hz : 0≤z) (hM : 0≤M)
    (hH : 0≤H) (hC : 0≤C) (hgoal : 0≤goal) (hgoal' : goal≤M)
    (hnear : |prevGoal-goal|≤e*z)
    (hbase : |base-goal|≤H)
    (hprev : |prev-prevGoal|≤H+a/(1-a)*(C+e+e*M)*z+C*z) :
    |(1-a)*base+a*Real.exp (-e*z)*prev-goal|≤H+a/(1-a)*(C+e+e*M)*z := by
  let b := Real.exp (-e*z)
  let E := H+a/(1-a)*(C+e+e*M)*z
  have hb : 0≤b := Real.exp_nonneg _
  have hb' : b≤1 := Real.exp_le_one_iff.mpr
    (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr he) hz)
  have hL : -(b-1)≤e*z := by
    have hh := Real.add_one_le_exp (-e*z)
    change -e*z+1≤b at hh
    linarith only [hh]
  have hloss : |(b-1)*goal|≤(e*z)*M := by
    rw [abs_mul,abs_of_nonpos (sub_nonpos.mpr hb'),abs_of_nonneg hgoal]
    exact mul_le_mul hL hgoal' hgoal (mul_nonneg he hz)
  have hCore : |(1-a)*base+a*b*prev-goal|≤(1-a)*H+a*(E+C*z)+a*(e*z)+a*(e*z*M) :=
    affine_error_core a b base prev goal prevGoal H E C z (e*z) (e*z*M)
      ha ha₁.le hb hb' hbase hprev hnear hloss
  have hcancel := div_mul_cancel₀ a (sub_ne_zero.mpr ha₁.ne')
  have hId : (1-a)*E=(1-a)*H+a*(C+e+e*M)*z := by
    calc
      _=(1-a)*H+(a/(1-a)*(1-a))*(C+e+e*M)*z := by dsimp only [E]; ring
      _=_ := by rw [hcancel]
  exact hCore.trans_eq (calc
    _=((1-a)*H+a*(C+e+e*M)*z)+a*E := by ring
    _=E := by rw [←hId]; ring)

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open Finset ArithmeticFunction
open scoped Classical
noncomputable section

def normalizedAvoidLog (S : Finset ℕ) (e x : ℝ) : ℝ :=
  (∏ p ∈ S, (1-(p:ℝ)⁻¹))*avoidLog S (Real.exp x) e

theorem normalizedAvoidLog_of_neg (S : Finset ℕ) {e x : ℝ} (hx : x<0) :
    normalizedAvoidLog S e x = 0 := by
  rw [normalizedAvoidLog,avoidLog_of_lt_one S (Real.exp_lt_one_iff.mpr hx),mul_zero]

private theorem normalizedAvoidLog_insert {S : Finset ℕ} {p : ℕ} (hp : p.Prime) (hpS : p∉S)
    (hS : ∀ l∈S, Nat.Prime l) (e x : ℝ) :
    normalizedAvoidLog (insert p S) e x =
      (1-(p:ℝ)⁻¹)*normalizedAvoidLog S e x +
      (p:ℝ)⁻¹*Real.exp (-e*Real.log (p:ℝ))*normalizedAvoidLog (insert p S) e (x-Real.log (p:ℝ)) := by
  have hp₀ : (0:ℝ)<p := by exact_mod_cast hp.pos
  have hScale : Real.exp (x-Real.log (p:ℝ)) = Real.exp x/(p:ℝ) := by
    rw [Real.exp_sub,Real.exp_log hp₀]
  have hPow : ((p:ℝ)^(1+e))⁻¹ = (p:ℝ)⁻¹*Real.exp (-e*Real.log (p:ℝ)) := by
    rw [Real.rpow_add hp₀,Real.rpow_one,mul_inv,Real.rpow_def_of_pos hp₀,
      show -e*Real.log (p:ℝ)=-(Real.log (p:ℝ)*e) by ring,Real.exp_neg]
  unfold normalizedAvoidLog
  rw [remove_prime hp hpS hS, hScale, hPow]
  conv_lhs => rw [prod_insert hpS]
  conv_rhs => rw [prod_insert hpS]
  ring

set_option maxHeartbeats 1200000 in
/-- Finite Euler-factor transport of an affine logarithmic asymptotic. -/
theorem normalizedAvoidLog_error_le {e B C : ℝ} {H : ℝ → ℝ}
    (he : 0≤e) (hB : 0≤B) (hC : 0≤C)
    (hH : ∀ x, 0≤H x) (hNegative : ∀ x<0, 1≤H x)
    (hShift : ∀ x z, 0≤z → H (x-z) ≤ H x+C*z)
    (hBase : ∀ x≤B, |normalizedAvoidLog ∅ e x-(1+e*max 0 x)| ≤ H x)
    (S : Finset ℕ) (hS : ∀ p∈S, Nat.Prime p) {x : ℝ} (hx : x≤B) :
    |normalizedAvoidLog S e x-(1+e*max 0 x)| ≤
      H x+(C+e+e*(1+e*B))*(∑ p∈S, Real.log (p:ℝ)/((p:ℝ)-1)) := by
  let M := 1+e*B
  let cost := C+e+e*M
  let target (x : ℝ) := 1+e*max 0 x
  let mass (S : Finset ℕ) := ∑ p∈S, Real.log (p:ℝ)/((p:ℝ)-1)
  have hM : 0≤M := by dsimp only [M]; positivity
  have hcost : 0≤cost := by dsimp only [cost]; positivity
  have hMass (S : Finset ℕ) (hS : ∀ p∈S, Nat.Prime p) : 0 ≤ mass S := by
    unfold mass
    apply sum_nonneg
    intro p hp
    have hp' : (1:ℝ)<p := by exact_mod_cast (hS p hp).one_lt
    exact div_nonneg (Real.log_nonneg hp'.le) (sub_nonneg.mpr hp'.le)
  have hTarget (x : ℝ) (hx : x≤B) : 0≤target x ∧ target x≤M := by
    dsimp only [target,M]
    exact ⟨by positivity, add_le_add le_rfl (mul_le_mul_of_nonneg_left (max_le hB hx) he)⟩
  change |normalizedAvoidLog S e x-target x| ≤ H x+cost*mass S
  induction S using Finset.induction_on generalizing x with
  | empty =>
    simpa only [mass,sum_empty,mul_zero,add_zero] using hBase x hx
  | @insert p S hpS ih =>
    have hp := hS p (mem_insert_self p S)
    have hSR : ∀ l∈S,Nat.Prime l := fun l hl => hS l (mem_insert_of_mem hl)
    have hp₀ : (0:ℝ)<p := by exact_mod_cast hp.pos
    have hp₁ : (1:ℝ)<p := by exact_mod_cast hp.one_lt
    let a := (p:ℝ)⁻¹
    let z := Real.log (p:ℝ)
    have ha : 0≤a := inv_nonneg.mpr hp₀.le
    have ha₁ : a<1 := inv_lt_one_of_one_lt₀ hp₁
    have hz : 0<z := Real.log_pos hp₁
    have hMass' : mass (insert p S) = mass S+(a/(1-a))*z := by
      dsimp only [mass,z,a]
      rw [sum_insert hpS]
      have h : (p:ℝ)⁻¹/(1-(p:ℝ)⁻¹) = ((p:ℝ)-1)⁻¹ := by
        field_simp [hp₀.ne',sub_ne_zero.mpr hp₁.ne',sub_ne_zero.mpr ha₁.ne']
      rw [h,div_eq_mul_inv (Real.log (p:ℝ))]
      ring
    have hStep (n : ℕ) : ∀ y : ℝ, ⌊Real.exp y⌋₊=n → y≤B →
        |normalizedAvoidLog (insert p S) e y-target y| ≤ H y+cost*mass (insert p S) := by
      induction n using Nat.strong_induction_on with
      | _ n hrec =>
        intro y hyn hyB
        by_cases hy : y<0
        · dsimp only [target]
          rw [normalizedAvoidLog_of_neg _ hy,max_eq_left hy.le,mul_zero,add_zero]
          norm_num
          exact (hNegative y hy).trans (le_add_of_nonneg_right
            (mul_nonneg hcost (hMass _ hS)))
        have hy₀ : 0≤y := le_of_not_gt hy
        have hn : 0<n := by rw [←hyn]; exact Nat.floor_pos.mpr (Real.one_le_exp_iff.mpr hy₀)
        have hyB' : y-z≤B := (sub_le_self _ hz.le).trans hyB
        have hn' : ⌊Real.exp (y-z)⌋₊ < n := by
          rw [show Real.exp (y-z)=Real.exp y/(p:ℝ) by
            dsimp only [z]
            rw [Real.exp_sub,Real.exp_log hp₀],
            Nat.floor_div_natCast,hyn]
          exact Nat.div_lt_self hn hp.one_lt
        have hprev := hrec _ hn' _ rfl hyB'
        have hbase := ih hSR hyB
        have hShift' := hShift y z hz.le
        have hnear : |target (y-z)-target y|≤e*z := by
          dsimp only [target]
          rw [show 1+e*max 0 (y-z)-(1+e*max 0 y)=e*(max 0 (y-z)-max 0 y) by ring,
            abs_mul,abs_of_nonneg he]
          apply mul_le_mul_of_nonneg_left _ he
          have hh := abs_max_sub_max_le_max (0:ℝ) (y-z) 0 y
          rw [show y-z-y=-z by ring,abs_neg,abs_of_nonneg hz.le,sub_self,abs_zero,max_eq_right hz.le] at hh
          exact hh
        have hprev' : |normalizedAvoidLog (insert p S) e (y-z)-target (y-z)| ≤
            (H y+cost*mass S)+a/(1-a)*(C+e+e*M)*z+C*z := by
          refine hprev.trans ?_
          rw [hMass']
          have hE := add_le_add_right hShift' (cost*(mass S+a/(1-a)*z))
          convert hE using 1 <;> dsimp only [cost] <;> ring
        have hh := primeRecurrence_stable ha ha₁ he hz.le hM
          (add_nonneg (hH y) (mul_nonneg hcost (hMass S hSR))) hC
          (hTarget y hyB).1 (hTarget y hyB).2 hnear hbase hprev'
        rw [normalizedAvoidLog_insert hp hpS hSR,hMass']
        convert hh using 1
        dsimp only [cost]
        ring
    exact hStep ⌊Real.exp x⌋₊ x rfl hx

set_option maxHeartbeats 1000000 in
/-- Positive one-prime recurrences preserve any nondecreasing uniform bound. -/
theorem normalizedAvoidLog_abs_le {e : ℝ} {B : ℝ → ℝ} (he : 0≤e)
    (hB : ∀ x, 0≤B x) (hm : Monotone B)
    (hBase : ∀ x, |normalizedAvoidLog ∅ e x|≤B x)
    (S : Finset ℕ) (hS : ∀ p∈S, Nat.Prime p) (x : ℝ) :
    |normalizedAvoidLog S e x|≤B x := by
  induction S using Finset.induction_on generalizing x with
  | empty => exact hBase x
  | @insert p S hpS ih =>
    have hp := hS p (mem_insert_self p S)
    have hSR : ∀ l∈S,Nat.Prime l := fun l hl => hS l (mem_insert_of_mem hl)
    have hp₀ : (0:ℝ)<p := by exact_mod_cast hp.pos
    have hp₁ : (1:ℝ)<p := by exact_mod_cast hp.one_lt
    let a := (p:ℝ)⁻¹
    let z := Real.log (p:ℝ)
    let b := Real.exp (-e*z)
    have ha : 0≤a := inv_nonneg.mpr hp₀.le
    have ha₁ : a<1 := inv_lt_one_of_one_lt₀ hp₁
    have hz : 0<z := Real.log_pos hp₁
    have hb : 0≤b := Real.exp_nonneg _
    have hb₁ : b≤1 := Real.exp_le_one_iff.mpr
      (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr he) hz.le)
    have hStep (n : ℕ) : ∀ y : ℝ, ⌊Real.exp y⌋₊=n →
        |normalizedAvoidLog (insert p S) e y|≤B y := by
      induction n using Nat.strong_induction_on with
      | _ n hrec =>
        intro y hyn
        by_cases hy : y<0
        · rw [normalizedAvoidLog_of_neg _ hy,abs_zero]
          exact hB y
        have hy₀ : 0≤y := le_of_not_gt hy
        have hn : 0<n := by rw [←hyn]; exact Nat.floor_pos.mpr (Real.one_le_exp_iff.mpr hy₀)
        have hn' : ⌊Real.exp (y-z)⌋₊ < n := by
          rw [show Real.exp (y-z)=Real.exp y/(p:ℝ) by
            dsimp only [z]
            rw [Real.exp_sub,Real.exp_log hp₀],
            Nat.floor_div_natCast,hyn]
          exact Nat.div_lt_self hn hp.one_lt
        have hp' := (hrec _ hn' _ rfl).trans (hm (sub_le_self _ hz.le))
        have h₁ : 0≤1-a := sub_nonneg.mpr ha₁.le
        have h₂ : 0≤a*b := mul_nonneg ha hb
        have h₂' : a*b≤a := mul_le_of_le_one_right ha hb₁
        rw [normalizedAvoidLog_insert hp hpS hSR]
        change |(1-a)*normalizedAvoidLog S e y+(a*b)*normalizedAvoidLog (insert p S) e (y-z)|≤_
        refine (abs_add_le _ _).trans ?_
        simp only [abs_mul,abs_of_nonneg h₁,abs_of_nonneg h₂]
        have h := add_le_add (mul_le_mul_of_nonneg_left (ih hSR y) h₁)
          (mul_le_mul h₂' hp' (abs_nonneg _) ha)
        exact h.trans_eq (by ring)
    exact hStep ⌊Real.exp x⌋₊ x rfl

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open Finset

noncomputable section

/-- The normalized logarithmic first moment of the deleted Euler factors. -/
def primeEulerLogMass (r : ℕ) : ℝ :=
  ∑ p ∈ r.primeFactors, Real.log (p:ℝ)/((p:ℝ)-1)

/-- A cutoff gives a uniform bound with only the product-of-prime-factors identity. -/
theorem primeEulerLogMass_le {r K : ℕ} (hr : 0<r) (hK : 0<K) :
    primeEulerLogMass r ≤ (K:ℝ)+Real.log (r:ℝ)/(K:ℝ) := by
  classical
  let S := r.primeFactors
  let F (p : ℕ) : ℝ := Real.log (p:ℝ)/((p:ℝ)-1)
  have hK₀ : (0:ℝ)<K := by exact_mod_cast hK
  have hPrime (p : ℕ) (hp : p∈S) : Nat.Prime p := Nat.prime_of_mem_primeFactors hp
  have hLarge : (∑ p∈S.filter (fun p => K<p),F p) ≤ Real.log (r:ℝ)/(K:ℝ) := by
    calc
      _ ≤ ∑ p∈S.filter (fun p => K<p), Real.log (p:ℝ)/(K:ℝ) := by
        refine sum_le_sum fun p hp => ?_
        obtain ⟨hpS,hpK⟩ := mem_filter.mp hp
        have hh : (K:ℝ)+1≤p := by exact_mod_cast hpK
        have hn : 0≤Real.log (p:ℝ) := Real.log_nonneg (by exact_mod_cast (hPrime p hpS).one_lt.le)
        exact div_le_div_of_nonneg_left hn hK₀ (by linarith only [hh])
      _ ≤ ∑ p∈S, Real.log (p:ℝ)/(K:ℝ) := by
        refine sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun p hp _ => ?_
        exact div_nonneg (Real.log_nonneg (by exact_mod_cast (hPrime p hp).one_lt.le)) hK₀.le
      _ = Real.log ((∏ p∈S,p:ℕ):ℝ)/(K:ℝ) := by
        rw [←sum_div,Nat.cast_prod,Real.log_prod]
        intro p hp
        exact_mod_cast (hPrime p hp).ne_zero
      _ ≤ _ := by
        have hr' : (∏ p∈S,p)∣r := Nat.prod_primeFactors_dvd _
        have hLe : (∏ p∈S,p)≤r := Nat.le_of_dvd hr hr'
        have hPos : 0<(∏ p∈S,p) := Finset.prod_pos fun p hp => (hPrime p hp).pos
        exact div_le_div_of_nonneg_right (Real.log_le_log (by exact_mod_cast hPos) (by exact_mod_cast hLe)) hK₀.le
  have hSmall : (∑ p∈S.filter (fun p => p≤K),F p) ≤ (K:ℝ) := by
    have hSub : S.filter (fun p => p≤K) ⊆ Icc 1 K := fun p hp =>
      mem_Icc.mpr ⟨(hPrime p (mem_filter.mp hp).1).one_lt.le,(mem_filter.mp hp).2⟩
    calc
      _ ≤ ∑ _p∈S.filter (fun p => p≤K), (1:ℝ) := by
        refine sum_le_sum fun p hp => ?_
        have hp₀ : (1:ℝ)<p := by exact_mod_cast (hPrime p (mem_filter.mp hp).1).one_lt
        exact (div_le_one (sub_pos.mpr hp₀)).mpr
          (Real.log_le_sub_one_of_pos (zero_lt_one.trans hp₀))
      _ ≤ ∑ _p∈Icc 1 K, (1:ℝ) :=
        sum_le_sum_of_subset_of_nonneg hSub (fun _ _ _ => zero_le_one)
      _ = _ := by simp
  have hEq : primeEulerLogMass r =
      (∑ p∈S.filter (fun p => p≤K),F p)+(∑ p∈S.filter (fun p => K<p),F p) := by
    simpa only [primeEulerLogMass,S,F,not_le] using (sum_filter_add_sum_filter_not S (fun p => p≤K) F).symm
  rw [hEq]
  exact add_le_add hSmall hLarge

/-- At logarithmic scales the deleted prime factors have uniformly negligible
normalized logarithmic mass. -/
theorem primeEulerLogMass_div_le {r : ℕ} (hr : 0<r) {L V : ℝ}
    (hL : 4≤L) (hV : 0≤V) (hrL : Real.log (r:ℝ)≤V*L) :
    primeEulerLogMass r / L ≤ (1+2*V)/Real.sqrt L := by
  let Y := Real.sqrt L
  let K := ⌊Y⌋₊
  have hY2 : (2:ℝ)≤Y := by
    dsimp only [Y]
    exact (Real.le_sqrt (by norm_num) (by linarith)).mpr (by nlinarith only [hL])
  have hY : 0<Y := by linarith only [hY2]
  have hK : 0<K := Nat.zero_lt_one.trans_le (Nat.le_floor (by linarith only [hY2] : (1:ℝ)≤Y))
  have hK₀ : (0:ℝ)<K := by exact_mod_cast hK
  have h₁ : (K:ℝ)≤Y := Nat.floor_le hY.le
  have h₂ : Y/2≤(K:ℝ) := by
    have h := Nat.lt_floor_add_one Y
    dsimp only [K]
    linarith only [hY2,h]
  have hS : Y^2=L := Real.sq_sqrt (by linarith only [hL])
  have hLog : 0≤Real.log (r:ℝ) := Real.log_nonneg (by exact_mod_cast Nat.one_le_of_lt hr)
  have hB := primeEulerLogMass_le hr hK
  have hD : Real.log (r:ℝ)/(K:ℝ)≤V*L/(Y/2) :=
    (div_le_div_of_nonneg_right hrL hK₀.le).trans
      (div_le_div_of_nonneg_left (by positivity) (by positivity) h₂)
  calc
    _ ≤ (Y+V*L/(Y/2))/L := div_le_div_of_nonneg_right (hB.trans (add_le_add h₁ hD)) (by linarith only [hL])
    _ = _ := by
      change (Y+V*L/(Y/2))/L=(1+2*V)/Y
      rw [←hS]
      field_simp [hY.ne']

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open MeasureTheory Set
open scoped Interval

noncomputable section

private def expCutoff (e x u : ℝ) : ℝ := Real.exp (-e*u)*(x-u)

private def expCutoffDeriv (e x u : ℝ) : ℝ := Real.exp (-e*u)*(-e*(x-u)-1)

/-- The twice-differentiated exponential cutoff in the near-one shift. -/
def expCutoffSecond (e x u : ℝ) : ℝ := (2*e+e^2*(x-u))*Real.exp (-e*u)

private theorem hasDerivAt_expCutoff (e x u : ℝ) :
    HasDerivAt (expCutoff e x) (expCutoffDeriv e x u) u := by
  have h₁ : HasDerivAt (fun t : ℝ => Real.exp (-e*t)) (Real.exp (-e*u)*(-e)) u := by
    simpa only [id_eq,mul_one] using ((hasDerivAt_id u).const_mul (-e)).exp
  have h₂ : HasDerivAt (fun t : ℝ => x-t) (-1) u := (hasDerivAt_id u).const_sub x
  exact (h₁.mul h₂).congr_deriv (by unfold expCutoffDeriv; ring)

private theorem hasDerivAt_expCutoffDeriv (e x u : ℝ) :
    HasDerivAt (expCutoffDeriv e x) (expCutoffSecond e x u) u := by
  have h₁ : HasDerivAt (fun t : ℝ => Real.exp (-e*t)) (Real.exp (-e*u)*(-e)) u := by
    simpa only [id_eq,mul_one] using ((hasDerivAt_id u).const_mul (-e)).exp
  have h₂ : HasDerivAt (fun t : ℝ => x-t) (-1) u := (hasDerivAt_id u).const_sub x
  exact (h₁.mul ((h₂.const_mul (-e)).sub_const 1)).congr_deriv (by unfold expCutoffSecond; ring)

/-- One scalar integration by parts for the shifted truncated Möbius logarithm. -/
theorem exp_cutoff_shift_identity (e a x : ℝ) :
    Real.exp (-e*a)*(x-a) = Real.exp (-e*x)*(x-a)+
      ∫ u in a..x, expCutoffSecond e x u*(u-a) := by
  let G (t : ℝ) := expCutoffDeriv e x t*(t-a)-expCutoff e x t
  have hG (t : ℝ) : HasDerivAt G (expCutoffSecond e x t*(t-a)) t := by
    have hA : HasDerivAt (fun u : ℝ => u-a) 1 t := (hasDerivAt_id t).sub_const a
    exact (((hasDerivAt_expCutoffDeriv e x t).mul hA).sub
      (hasDerivAt_expCutoff e x t)).congr_deriv (by ring)
  have hC : Continuous (fun u : ℝ => expCutoffSecond e x u*(u-a)) := by
    unfold expCutoffSecond
    fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hG t) (hC.intervalIntegrable _ _)]
  simp only [G,expCutoff,expCutoffDeriv,sub_self,mul_zero,zero_sub,sub_zero]
  ring

/-- The constant-one input is sent to the exact asymptotic target 1+e*x. -/
theorem exp_cutoff_shift_one (e x : ℝ) :
    Real.exp (-e*x)+(∫ u in (0:ℝ)..x, expCutoffSecond e x u) = 1+e*x := by
  have hC : Continuous (expCutoffSecond e x) := by unfold expCutoffSecond; fun_prop
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hasDerivAt_expCutoffDeriv e x t)
    (hC.intervalIntegrable _ _)]
  simp only [expCutoffDeriv,sub_self,mul_zero,zero_sub,Real.exp_zero,one_mul,sub_zero]
  ring

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open Finset ArithmeticFunction MeasureTheory Set
open scoped Interval ArithmeticFunction.Moebius

noncomputable section

/-- The right-shifted logarithmic Möbius sum. -/
def shiftedLogMoebiusSum (e x : ℝ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 ⌊x⌋₊, ((moebius n:ℝ)/(n:ℝ))*Real.exp (-e*Real.log (n:ℝ))*Real.log (x/(n:ℝ))

theorem logMoebiusSum_eq_positive_part {u x : ℝ} (hux : u ≤ x) :
    logMoebiusSum (Real.exp u) = ∑ n ∈ Finset.Icc 1 ⌊Real.exp x⌋₊,
      ((moebius n:ℝ)/(n:ℝ))*max 0 (u-Real.log (n:ℝ)) := by
  unfold logMoebiusSum
  let S (v : ℝ) := Finset.Icc 1 ⌊Real.exp v⌋₊
  have hSub : S u ⊆ S x := Finset.Icc_subset_Icc_right (Nat.floor_mono (Real.exp_le_exp.mpr hux))
  calc
    _ = ∑ n ∈ S u, ((moebius n:ℝ)/(n:ℝ))*max 0 (u-Real.log (n:ℝ)) := by
      apply sum_congr rfl
      intro n hn
      obtain ⟨hn₀,hn₁⟩ := Finset.mem_Icc.mp hn
      have hN : (0:ℝ) < n := by exact_mod_cast Nat.zero_lt_one.trans_le hn₀
      have hx : (n:ℝ) ≤ Real.exp u :=
        (by exact_mod_cast hn₁ : (n:ℝ) ≤ (⌊Real.exp u⌋₊:ℝ)).trans (Nat.floor_le (Real.exp_nonneg _))
      have hl := (Real.log_le_log hN hx)
      rw [Real.log_exp] at hl
      rw [Real.log_div (Real.exp_ne_zero _) hN.ne',Real.log_exp,max_eq_right (sub_nonneg.mpr hl)]
    _ = _ := by
      refine sum_subset hSub ?_
      intro n hn hn'
      have hlt : ⌊Real.exp u⌋₊ < n := lt_of_not_ge fun h =>
        hn' (Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp hn).1,h⟩)
      have hX := (Nat.floor_lt (Real.exp_nonneg _)).mp hlt
      have hn0 : (0:ℝ)<n := by exact_mod_cast (Nat.zero_lt_one.trans_le (Finset.mem_Icc.mp hn).1)
      have hL := (Real.lt_log_iff_exp_lt hn0).2 hX
      rw [max_eq_left (sub_nonpos.mpr hL.le),mul_zero]

private theorem exp_cutoff_shift_clipped {e a x : ℝ} (ha : 0 ≤ a) (hax : a ≤ x) :
    Real.exp (-e*a)*(x-a) = Real.exp (-e*x)*(x-a)+
      ∫ u in (0:ℝ)..x, expCutoffSecond e x u*max 0 (u-a) := by
  rw [exp_cutoff_shift_identity e a x]
  congr 1
  let f (u : ℝ) := expCutoffSecond e x u*max 0 (u-a)
  have hC : Continuous f := by unfold f expCutoffSecond; fun_prop
  have hInt₀ : IntervalIntegrable f volume 0 a := hC.intervalIntegrable 0 a
  have hInt₁ : IntervalIntegrable f volume a x := hC.intervalIntegrable a x
  have hJoin := intervalIntegral.integral_add_adjacent_intervals hInt₀ hInt₁
  have hLeft : (∫ u in (0:ℝ)..a, f u)=0 := by
    trans ∫ _u in (0:ℝ)..a, (0:ℝ)
    · apply intervalIntegral.integral_congr
      intro u hu
      rw [uIcc_of_le ha] at hu
      simp only [f,max_eq_left (sub_nonpos.mpr hu.2),mul_zero]
    · simp
  rw [hLeft,zero_add] at hJoin
  change (∫ u in a..x,expCutoffSecond e x u*(u-a)) = ∫ u in (0:ℝ)..x, f u
  rw [←hJoin]
  apply intervalIntegral.integral_congr
  intro u hu
  rw [uIcc_of_le hax] at hu
  simp only [f,max_eq_right (sub_nonneg.mpr hu.1)]

set_option maxHeartbeats 1200000 in
/-- Exact weak shift of the truncated logarithmic Möbius sum. -/
theorem shiftedLogMoebiusSum_exp_eq {e x : ℝ} (hx : 0 ≤ x) :
    shiftedLogMoebiusSum e (Real.exp x) = Real.exp (-e*x)*logMoebiusSum (Real.exp x)+
      ∫ u in (0:ℝ)..x, expCutoffSecond e x u*logMoebiusSum (Real.exp u) := by
  let S := Finset.Icc 1 ⌊Real.exp x⌋₊
  let coeff (n : ℕ) : ℝ := (moebius n:ℝ)/(n:ℝ)
  let a (n : ℕ) : ℝ := Real.log (n:ℝ)
  have hN (n : ℕ) (hn : n∈S) : 0 ≤ a n ∧ a n ≤ x := by
    obtain ⟨hn₀,hn₁⟩ := Finset.mem_Icc.mp hn
    have hn₀R : (1:ℝ) ≤ n := by exact_mod_cast hn₀
    have hn₁R : (n:ℝ) ≤ Real.exp x :=
      (by exact_mod_cast hn₁ : (n:ℝ) ≤ (⌊Real.exp x⌋₊:ℝ)).trans (Nat.floor_le (Real.exp_nonneg _))
    refine ⟨Real.log_nonneg hn₀R,?_⟩
    change Real.log (n:ℝ)≤x
    exact (Real.log_le_log (zero_lt_one.trans_le hn₀R) hn₁R).trans_eq (Real.log_exp x)
  have hLog (n : ℕ) (hn : n∈S) : Real.log (Real.exp x/(n:ℝ))=x-a n := by
    have h₀ : (0:ℝ)<n := by exact_mod_cast Nat.zero_lt_one.trans_le (Finset.mem_Icc.mp hn).1
    rw [Real.log_div (Real.exp_ne_zero _) h₀.ne',Real.log_exp]
  have hIntegral : (∫ u in (0:ℝ)..x, expCutoffSecond e x u*logMoebiusSum (Real.exp u)) =
      ∑ n∈S, coeff n*(∫ u in (0:ℝ)..x,expCutoffSecond e x u*max 0 (u-a n)) := by
    have hC (n : ℕ) : Continuous (fun u => coeff n*(expCutoffSecond e x u*max 0 (u-a n))) := by
      unfold expCutoffSecond
      fun_prop
    calc
      _ = ∫ u in (0:ℝ)..x, ∑ n∈S, coeff n*(expCutoffSecond e x u*max 0 (u-a n)) := by
        apply intervalIntegral.integral_congr
        intro u hu
        rw [uIcc_of_le hx] at hu
        change expCutoffSecond e x u * logMoebiusSum (Real.exp u) = _
        rw [logMoebiusSum_eq_positive_part hu.2]
        change expCutoffSecond e x u*(∑ n∈S, coeff n*max 0 (u-a n))= _
        rw [mul_sum]
        exact sum_congr rfl fun _ _ => by ring
      _ = _ := by
        rw [intervalIntegral.integral_finsetSum (fun n _ => (hC n).intervalIntegrable _ _)]
        exact sum_congr rfl fun _ _ => intervalIntegral.integral_const_mul _ _
  rw [hIntegral]
  unfold shiftedLogMoebiusSum logMoebiusSum
  change (∑ n∈S, coeff n*Real.exp (-e*a n)*Real.log (Real.exp x/(n:ℝ))) =
    Real.exp (-e*x)*(∑ n∈S, coeff n*Real.log (Real.exp x/(n:ℝ)))+_
  rw [mul_sum,←sum_add_distrib]
  apply sum_congr rfl
  intro n hn
  rw [hLog n hn]
  have he := congrArg (fun v => coeff n*v) (exp_cutoff_shift_clipped (e:=e) (hN n hn).1 (hN n hn).2)
  linear_combination he

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open Filter Finset MeasureTheory Set
open scoped Interval ArithmeticFunction.Moebius

noncomputable section

/-- The shifted Möbius logarithm approaches its affine main term uniformly
when the logarithmic cutoff stays in a fixed proportional interval. -/
theorem eventually_shiftedLogMoebiusSum_uniform {t η V ε : ℝ}
    (ht : 0 ≤ t) (hη : 0 < η) (hV : 0 ≤ V) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ x ∈ Set.Icc (η*L) (V*L),
      |shiftedLogMoebiusSum (t/L) (Real.exp x)-(1+(t/L)*x)| ≤ ε := by
  let f (u : ℝ) := logMoebiusSum (Real.exp u)
  let C := 2*t+t^2*V
  let δ := ε/(2*(1+C*V))
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  have hδ : 0 < δ := by dsimp only [δ]; positivity
  have hLimit : Tendsto f atTop (nhds 1) := tendsto_logMoebiusSum_one.comp Real.tendsto_exp_atTop
  obtain ⟨B₀,hB₀⟩ := Metric.tendsto_atTop.1 hLimit δ hδ
  let B := max 0 B₀
  have hB : 0 ≤ B := le_max_left _ _
  have hClose (u : ℝ) (hu : B ≤ u) : |f u-1| ≤ δ := by
    simpa only [Real.dist_eq] using (hB₀ u ((le_max_right _ _).trans hu)).le
  have hUniform (u : ℝ) (hu : 0 ≤ u) : |f u-1| ≤ 6 := by
    have h := abs_sum_moebius_log_le (x:=Real.exp u) (Real.one_le_exp_iff.mpr hu)
    change |f u|≤5 at h
    exact (abs_sub _ _).trans (by rw [abs_one]; linarith only [h])
  filter_upwards [eventually_ge_atTop (max 1 (max (B/η) (12*C*B/ε)))] with L hL x hx
  have hL₁ : 1 ≤ L := (le_max_left _ _).trans hL
  have hL₀ : 0 < L := zero_lt_one.trans_le hL₁
  have hBx : B ≤ x := by
    have h := (le_max_left (B/η) (12*C*B/ε)).trans ((le_max_right _ _).trans hL)
    have hBL : B≤L*η := (div_le_iff₀ hη).mp h
    exact hBL.trans (by simpa only [mul_comm] using hx.1)
  have hx₀ : 0 ≤ x := hB.trans hBx
  have hErr : 6*(C/L)*B≤ε/2 := by
    have h := (le_max_right (B/η) (12*C*B/ε)).trans ((le_max_right _ _).trans hL)
    have hh := (div_le_iff₀ hε).mp h
    rw [show 6*(C/L)*B=(6*C*B)/L by ring]
    exact (div_le_iff₀ hL₀).mpr (by nlinarith only [hh])
  let e := t/L
  let k := expCutoffSecond e x
  let g (u : ℝ) := k u*(f u-1)
  have he : 0≤e := div_nonneg ht hL₀.le
  have hK (u : ℝ) (hu : u∈Set.Icc 0 x) : 0≤k u ∧ k u≤C/L := by
    have hk : 0≤2*e+e^2*(x-u) := by positivity [sub_nonneg.mpr hu.2]
    change 0≤(2*e+e^2*(x-u))*Real.exp (-e*u) ∧ _
    refine ⟨mul_nonneg hk (Real.exp_nonneg _),?_⟩
    have hExp : Real.exp (-e*u)≤1 := Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg
      (neg_nonpos.mpr he) hu.1)
    refine (mul_le_of_le_one_right hk hExp).trans ?_
    have hT : x-u≤V*L := (sub_le_self _ hu.1).trans hx.2
    have hR := add_le_add_left (mul_le_mul_of_nonneg_left hT (sq_nonneg e)) (2*e)
    calc
      2*e+e^2*(x-u)≤2*e+e^2*(V*L) := by simpa only [add_comm] using hR
      _ = C/L := by dsimp only [C,e]; field_simp [hL₀.ne'] <;> ring
  have hfC : ContinuousOn f (Set.Icc 0 x) := by
    have hC' : Continuous (fun u : ℝ => ∑ n∈Finset.Icc 1 ⌊Real.exp x⌋₊,
      ((ArithmeticFunction.moebius n:ℝ)/(n:ℝ))*max 0 (u-Real.log (n:ℝ))) := by fun_prop
    refine hC'.continuousOn.congr fun u hu => ?_
    exact logMoebiusSum_eq_positive_part hu.2
  have hkC : Continuous k := by unfold k expCutoffSecond; fun_prop
  have hG : ContinuousOn g (Set.Icc 0 x) := hkC.continuousOn.mul (hfC.sub continuousOn_const)
  have hInt₀ : IntervalIntegrable g volume 0 B := by
    apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le hB]
    exact hG.mono (Set.Icc_subset_Icc_right hBx)
  have hInt₁ : IntervalIntegrable g volume B x := by
    apply ContinuousOn.intervalIntegrable
    rw [uIcc_of_le hBx]
    exact hG.mono (Set.Icc_subset_Icc_left hB)
  have hBound₀ : |∫ u in (0:ℝ)..B,g u|≤(C/L)*6*B := by
    rw [←Real.norm_eq_abs]
    calc
      _ ≤ (C/L*6)*|B-0| := intervalIntegral.norm_integral_le_of_norm_le_const fun u hu => by
        rw [uIoc_of_le hB] at hu
        obtain ⟨hk₀,hk₁⟩ := hK u ⟨hu.1.le,hu.2.trans hBx⟩
        simp only [g,Real.norm_eq_abs,abs_mul,abs_of_nonneg hk₀]
        exact mul_le_mul hk₁ (hUniform u hu.1.le) (abs_nonneg _) (div_nonneg hC hL₀.le)
      _ = _ := by rw [sub_zero,abs_of_nonneg hB]
  have hBound₁ : |∫ u in B..x,g u|≤(C/L)*δ*x := by
    rw [←Real.norm_eq_abs]
    calc
      _ ≤ (C/L*δ)*|x-B| := intervalIntegral.norm_integral_le_of_norm_le_const fun u hu => by
        rw [uIoc_of_le hBx] at hu
        obtain ⟨hk₀,hk₁⟩ := hK u ⟨hB.trans hu.1.le,hu.2⟩
        simp only [g,Real.norm_eq_abs,abs_mul,abs_of_nonneg hk₀]
        exact mul_le_mul hk₁ (hClose u hu.1.le) (abs_nonneg _) (div_nonneg hC hL₀.le)
      _ ≤ _ := by
        rw [abs_of_nonneg (sub_nonneg.mpr hBx)]
        exact mul_le_mul_of_nonneg_left (sub_le_self _ hB) (by positivity)
  rw [shiftedLogMoebiusSum_exp_eq hx₀,←exp_cutoff_shift_one e x]
  change |Real.exp (-e*x)*f x+(∫ u in (0:ℝ)..x,k u*f u)-
    (Real.exp (-e*x)+∫ u in (0:ℝ)..x,k u)| ≤ ε
  have hDiff : (∫ u in (0:ℝ)..x,k u*f u)-(∫ u in (0:ℝ)..x,k u)=(∫ u in (0:ℝ)..x,g u) := by
    have hA : IntervalIntegrable (fun u=>k u*f u) volume 0 x := by
      apply ContinuousOn.intervalIntegrable
      rw [uIcc_of_le hx₀]
      exact hkC.continuousOn.mul hfC
    rw [←intervalIntegral.integral_sub hA (hkC.intervalIntegrable _ _)]
    apply intervalIntegral.integral_congr
    intro u _
    simp only [g,mul_sub,mul_one]
  rw [show Real.exp (-e*x)*f x+(∫ u in (0:ℝ)..x,k u*f u)-
      (Real.exp (-e*x)+∫ u in (0:ℝ)..x,k u)=
    Real.exp (-e*x)*(f x-1)+((∫ u in (0:ℝ)..x,k u*f u)-(∫ u in (0:ℝ)..x,k u)) by ring,
    hDiff,←intervalIntegral.integral_add_adjacent_intervals hInt₀ hInt₁]
  have hE : Real.exp (-e*x)≤1 := Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg
    (neg_nonpos.mpr he) hx₀)
  have hFx : |Real.exp (-e*x)*(f x-1)|≤δ := by
    rw [abs_mul,abs_of_nonneg (Real.exp_nonneg _)]
    exact (mul_le_of_le_one_left (abs_nonneg _) hE).trans (hClose _ hBx)
  have hLast : (C/L)*δ*x≤C*δ*V := by
    calc
      _ ≤ (C/L)*δ*(V*L) := mul_le_mul_of_nonneg_left hx.2 (by positivity)
      _ = _ := by field_simp [hL₀.ne'] <;> ring
  have hSmall : δ+C*δ*V=ε/2 := by
    dsimp only [δ]
    have hh : (1+C*V)≠0 := by positivity
    field_simp [hh] <;> ring
  calc
    _ ≤ |Real.exp (-e*x)*(f x-1)|+|(∫ u in (0:ℝ)..B,g u)+(∫ u in B..x,g u)| :=
      abs_add_le _ _
    _ ≤ δ+((C/L)*6*B+(C/L)*δ*x) :=
      (add_le_add) hFx ((abs_add_le _ _).trans (add_le_add hBound₀ hBound₁))
    _ ≤ ε := by linarith only [hErr,hLast,hSmall]

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open ArithmeticFunction Filter Finset MeasureTheory Set
open scoped Interval Classical
noncomputable section

theorem normalizedAvoidLog_empty_eq (e x : ℝ) :
    normalizedAvoidLog ∅ e x = shiftedLogMoebiusSum e (Real.exp x) := by
  have hSet : (Finset.Icc 1 ⌊Real.exp x⌋₊).filter (avoidPrimes ∅) =
      Finset.Icc 1 ⌊Real.exp x⌋₊ := filter_eq_self.mpr fun n _ => by simp [avoidPrimes]
  have hN : normalizedAvoidLog ∅ e x = ∑ n∈Finset.Icc 1 ⌊Real.exp x⌋₊, logCoefficient (Real.exp x) e n := by
    simp only [normalizedAvoidLog,avoidLog,Finset.prod_empty,one_mul,hSet]
  rw [hN,shiftedLogMoebiusSum]
  refine Finset.sum_congr rfl fun n hn => ?_
  have h : (0:ℝ)<n := by exact_mod_cast Nat.zero_lt_one.trans_le (Finset.mem_Icc.mp hn).1
  rw [logCoefficient,Real.rpow_add h,Real.rpow_one,Real.rpow_def_of_pos h,
    show -e*Real.log (n:ℝ)=-(Real.log (n:ℝ)*e) by ring,Real.exp_neg]
  ring

/-- A coarse bound valid for any nonnegative shift, with the affine main-term size. -/
theorem abs_shiftedLogMoebiusSum_exp_le {e x : ℝ} (he : 0≤e) (hx : 0≤x) :
    |shiftedLogMoebiusSum e (Real.exp x)| ≤ 5*(1+e*x) := by
  let f (u : ℝ) := logMoebiusSum (Real.exp u)
  let k := expCutoffSecond e x
  have hk : Continuous k := by unfold k expCutoffSecond; fun_prop
  have hNonneg (u : ℝ) (hu : u∈Set.Icc 0 x) : 0≤k u := by
    exact mul_nonneg (by positivity [sub_nonneg.mpr hu.2]) (Real.exp_nonneg _)
  have hF (u : ℝ) (hu : u∈Set.Icc 0 x) : |f u|≤5 :=
    abs_sum_moebius_log_le (Real.one_le_exp_iff.mpr hu.1)
  have hFC : ContinuousOn f (Set.Icc 0 x) := by
    have hC' : Continuous (fun u : ℝ => ∑ n∈Finset.Icc 1 ⌊Real.exp x⌋₊,
      ((ArithmeticFunction.moebius n:ℝ)/(n:ℝ))*max 0 (u-Real.log (n:ℝ))) := by fun_prop
    exact hC'.continuousOn.congr fun u hu => logMoebiusSum_eq_positive_part hu.2
  have hAC : ContinuousOn (fun u => ‖k u*f u‖) (Set.Icc 0 x) :=
    (hk.continuousOn.mul hFC).norm
  have hInt : |∫ u in (0:ℝ)..x,k u*f u|≤5*(∫ u in (0:ℝ)..x,k u) := by
    rw [←Real.norm_eq_abs,←intervalIntegral.integral_const_mul]
    refine (intervalIntegral.norm_integral_le_integral_norm hx).trans ?_
    refine intervalIntegral.integral_mono_on hx (hAC.intervalIntegrable_of_Icc hx)
      ((continuous_const.mul hk).intervalIntegrable _ _) fun u hu => ?_
    simp only [Real.norm_eq_abs,abs_mul,abs_of_nonneg (hNonneg u hu)]
    rw [mul_comm (5:ℝ)]
    exact mul_le_mul_of_nonneg_left (hF u hu) (hNonneg u hu)
  rw [shiftedLogMoebiusSum_exp_eq hx]
  change |Real.exp (-e*x)*f x+(∫ u in (0:ℝ)..x,k u*f u)| ≤ _
  calc
    _ ≤ |Real.exp (-e*x)*f x|+|∫ u in (0:ℝ)..x,k u*f u| := abs_add_le _ _
    _ ≤ Real.exp (-e*x)*5+5*(∫ u in (0:ℝ)..x,k u) := by
      rw [abs_mul,abs_of_nonneg (Real.exp_nonneg _)]
      exact add_le_add (mul_le_mul_of_nonneg_left (hF x ⟨hx,le_rfl⟩) (Real.exp_nonneg _)) hInt
    _ = _ := by
      have h := exp_cutoff_shift_one e x
      change Real.exp (-e*x)+(∫ u in (0:ℝ)..x,k u)=1+e*x at h
      linarith only [h]

theorem normalizedAvoidLog_abs_le_affine (S : Finset ℕ) (hS : ∀ p∈S, p.Prime)
    {e : ℝ} (he : 0≤e) (x : ℝ) :
    |normalizedAvoidLog S e x|≤5*(1+e * max 0 x) := by
  refine normalizedAvoidLog_abs_le (B:=fun u : ℝ => 5*(1+e * max 0 u)) he
    (fun u=>by positivity) ?_ ?_ S hS x
  · intro x y hxy
    change 5*(1+e * max 0 x) ≤ 5*(1+e * max 0 y)
    exact mul_le_mul_of_nonneg_left (add_le_add le_rfl
      (mul_le_mul_of_nonneg_left (max_le_max le_rfl hxy) he)) (by norm_num)
  · intro x
    by_cases ht : x<0
    · rw [normalizedAvoidLog_of_neg _ ht,abs_zero]
      positivity
    have hh : 0≤x := le_of_not_gt ht
    rw [normalizedAvoidLog_empty_eq,max_eq_right hh]
    exact abs_shiftedLogMoebiusSum_exp_le he hh


set_option maxHeartbeats 1000000 in
/-- The shifted Möbius main term is uniform for the varying coprime cutoff. -/
theorem eventually_normalizedAvoidLog_uniform {t η V ε : ℝ}
    (ht : 0≤t) (hη : 0<η) (hV : 0≤V) (hε : 0<ε) :
    ∀ᶠ L : ℝ in atTop, ∀ r : ℕ, 0<r → Real.log (r:ℝ)≤V*L →
      ∀ x∈Set.Icc (η*L) (V*L),
      |normalizedAvoidLog r.primeFactors (t/L) x-(1+(t/L)*x)|≤ε := by
  let M := 1+t*V
  let C₀ := 12*M/η
  let D := C₀+t+t*M
  have hM : 1≤M := le_add_of_nonneg_right (mul_nonneg ht hV)
  have hC₀ : 0≤C₀ := by dsimp only [C₀]; positivity
  have hD : 0≤D := by dsimp only [D]; positivity
  have hLarge := (tendsto_atTop.1 Real.tendsto_sqrt_atTop) (2*D*(1+2*V)/ε)
  filter_upwards [eventually_shiftedLogMoebiusSum_uniform ht (by linarith : 0<η/2) hV
    (by linarith : 0<ε/2), eventually_ge_atTop (4:ℝ),hLarge] with L hA hL hS r hr hrL x hx
  have hL₀ : 0<L := by linarith only [hL]
  let e := t/L
  let C := C₀/L
  let H (u : ℝ) := ε/2+C * max 0 (η*L-u)
  have he : 0≤e := div_nonneg ht hL₀.le
  have hC : 0≤C := div_nonneg hC₀ hL₀.le
  have hCB : C*((η/2)*L)=6*M := by
    dsimp only [C,C₀]
    field_simp [hL₀.ne',hη.ne']
    ring
  have hH (u : ℝ) : 0≤H u := by dsimp only [H]; positivity
  have hHlarge (u : ℝ) (hu : u≤(η/2)*L) : 6*M≤H u := by
    have hk : (η/2)*L≤ max 0 (η*L-u) := (by linarith only [hu] : η/2*L≤η*L-u).trans
      (le_max_right _ _)
    have hK := mul_le_mul_of_nonneg_left hk hC
    rw [hCB] at hK
    dsimp only [H]
    linarith only [hK,hε]
  have hNegative (u : ℝ) (hu : u<0) : 1≤H u := by
    have hh := hHlarge u (hu.le.trans (by positivity))
    linarith only [hh,hM]
  have hShift (u z : ℝ) (hz : 0≤z) : H (u-z)≤H u+C*z := by
    dsimp only [H]
    have hh := max_sub_max_le_max (0:ℝ) (η*L-(u-z)) 0 (η*L-u)
    rw [sub_self,show η*L-(u-z)-(η*L-u)=z by ring,max_eq_right hz] at hh
    have hh' := mul_le_mul_of_nonneg_left hh hC
    linarith only [hh']
  have hBase (u : ℝ) (hu : u≤V*L) : |normalizedAvoidLog ∅ e u-(1+e * max 0 u)|≤H u := by
    by_cases hu₀ : u<0
    · rw [normalizedAvoidLog_of_neg _ hu₀,max_eq_left hu₀.le]
      simpa using hNegative u hu₀
    have hu' : 0≤u := le_of_not_gt hu₀
    rw [normalizedAvoidLog_empty_eq,max_eq_right hu']
    by_cases hNear : (η/2)*L≤u
    · exact (hA u ⟨hNear,hu⟩).trans (le_add_of_nonneg_right (by positivity))
    have huu : 1+e*u≤M := by
      have hB := mul_le_mul_of_nonneg_left hu he
      have hE : e*(V*L)=t*V := by dsimp only [e]; field_simp [hL₀.ne'] <;> ring
      rw [hE] at hB
      exact add_le_add le_rfl hB
    have hCrude := abs_shiftedLogMoebiusSum_exp_le he hu'
    have hA' := abs_sub (shiftedLogMoebiusSum e (Real.exp u)) (1+e*u)
    have hMain : 0≤1+e*u := by positivity
    have hCrude' : |shiftedLogMoebiusSum e (Real.exp u)-(1+e*u)|≤6*M := by
      rw [abs_of_nonneg hMain] at hA'
      linarith only [hCrude,hA',huu]
    exact hCrude'.trans (hHlarge u (le_of_not_ge hNear))
  have hErr := normalizedAvoidLog_error_le he (mul_nonneg hV hL₀.le) hC hH hNegative hShift
    hBase r.primeFactors (fun p hp => Nat.prime_of_mem_primeFactors hp) hx.2
  have hx₀ : 0≤x := (mul_nonneg hη.le hL₀.le).trans hx.1
  have hHx : H x=ε/2 := by
    simp [H,max_eq_left (sub_nonpos.mpr hx.1)]
  have hD' : C+e+e*(1+e*(V*L))=D/L := by
    dsimp only [C,e,D,M]
    field_simp [hL₀.ne'] <;> ring
  rw [max_eq_right hx₀,hHx,hD',←primeEulerLogMass] at hErr
  have hSQ : 0<Real.sqrt L := Real.sqrt_pos.2 hL₀
  have hRate : (D/L)*primeEulerLogMass r≤ε/2 := by
    calc
      _ = D*(primeEulerLogMass r/L) := by ring
      _ ≤ D*((1+2*V)/Real.sqrt L) := mul_le_mul_of_nonneg_left
        (primeEulerLogMass_div_le hr hL hV hrL) hD
      _ = (D*(1+2*V))/Real.sqrt L := by ring
      _ ≤ ε/2 := (div_le_iff₀ hSQ).mpr (by
        have hh := (div_le_iff₀ hε).mp hS
        linarith only [hh])
  linarith only [hErr,hRate]

theorem normalizedAvoidLog_primeFactors_eq {r : ℕ} (hr : 0<r) (e x : ℝ) :
    normalizedAvoidLog r.primeFactors e x = ((r.totient:ℝ)/r) *
      ∑ d ∈ (Finset.Icc 1 ⌊Real.exp x⌋₊).filter (fun d => r.Coprime d),
        ((moebius d : ℝ)/(d:ℝ)^(1+e))*Real.log (Real.exp x/(d:ℝ)) := by
  have hfilter : avoidPrimes r.primeFactors = fun d => r.Coprime d := by
    funext d
    apply propext
    constructor
    · intro h
      by_contra hn
      obtain ⟨p,hp,hpr,hpd⟩ := Nat.Prime.not_coprime_iff_dvd.mp hn
      exact h p (Nat.mem_primeFactors.mpr ⟨hp,hpr,hr.ne'⟩) hpd
    · intro hc p hp hpd
      exact (Nat.Prime.not_coprime_iff_dvd.mpr
        ⟨p,Nat.prime_of_mem_primeFactors hp,Nat.dvd_of_mem_primeFactors hp,hpd⟩) hc
  have ht : (r.totient:ℝ) = (r:ℝ)*∏ p ∈ r.primeFactors, (1-(p:ℝ)⁻¹) := by
    have hh := congrArg (fun a : ℚ => (a:ℝ)) (Nat.totient_eq_mul_prod_factors r)
    simpa only [Rat.cast_natCast,Rat.cast_mul,Rat.cast_prod,Rat.cast_sub,Rat.cast_one,Rat.cast_inv] using hh
  have hr₀ : (r:ℝ)≠0 := by exact_mod_cast hr.ne'
  have ht' : (r.totient:ℝ)/r = ∏ p ∈ r.primeFactors, (1-(p:ℝ)⁻¹) := by
    apply (div_eq_iff hr₀).mpr
    rw [ht,mul_comm]
  simp only [normalizedAvoidLog,avoidLog,hfilter,ht',logCoefficient]

end
end GoldbachMoebiusLog
end

section
namespace GoldbachMoebiusLog

open Finset
noncomputable section

/-- The local change in the Euler factor when the diagonal is shifted. -/
def eigenCorrection (r : ℕ) (e : ℝ) : ℝ :=
  ∏ p∈r.primeFactors,(1+(1-Real.exp (-e*Real.log (p:ℝ)))/((p:ℝ)-1))

theorem one_le_eigenCorrection_le {r : ℕ} {e : ℝ} (he : 0≤e) :
    1≤eigenCorrection r e ∧ eigenCorrection r e≤Real.exp (e*primeEulerLogMass r) := by
  let F (p : ℕ) : ℝ := (1-Real.exp (-e*Real.log (p:ℝ)))/((p:ℝ)-1)
  have hF (p : ℕ) (hp : p∈r.primeFactors) :
      0≤F p ∧ F p≤e*(Real.log (p:ℝ)/((p:ℝ)-1)) := by
    have hp₁ : (1:ℝ)<p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_lt
    have hlog := Real.log_nonneg hp₁.le
    have hz := mul_nonneg he hlog
    have hE : Real.exp (-e*Real.log (p:ℝ))≤1 :=
      Real.exp_le_one_iff.mpr (by linarith only [hz, neg_mul e (Real.log (p:ℝ))])
    obtain h := Real.add_one_le_exp (-e*Real.log (p:ℝ))
    have h₁ : 1-Real.exp (-e*Real.log (p:ℝ))≤e*Real.log (p:ℝ) := by linarith only [h]
    exact ⟨div_nonneg (sub_nonneg.mpr hE) (sub_nonneg.mpr hp₁.le),
      (div_le_div_of_nonneg_right h₁ (sub_nonneg.mpr hp₁.le)).trans_eq (by ring)⟩
  change 1≤(∏ p∈r.primeFactors,(1+F p)) ∧
    (∏ p∈r.primeFactors,(1+F p))≤Real.exp (e*primeEulerLogMass r)
  constructor
  · calc
      1=(∏ _p∈r.primeFactors,(1:ℝ)) := Finset.prod_const_one.symm
      _≤_ := prod_le_prod₀ (fun _ _ => zero_le_one) (fun p hp => le_add_of_nonneg_right (hF p hp).1)
  · rw [primeEulerLogMass,Finset.mul_sum,Real.exp_sum]
    refine prod_le_prod₀ (fun p hp => le_trans zero_le_one (le_add_of_nonneg_right (hF p hp).1))
      (fun p hp => ?_)
    have hExp := Real.add_one_le_exp (e*(Real.log (p:ℝ)/((p:ℝ)-1)))
    calc
      1+F p≤1+e*(Real.log (p:ℝ)/((p:ℝ)-1)) := add_le_add le_rfl (hF p hp).2
      _≤_ := by simpa only [add_comm] using hExp

/-- Factor the exact Selberg eigenvalue into the harmonic comparator and a correction. -/
theorem squarefree_eigen_eq {r : ℕ} (hr : Squarefree r) (e : ℝ) :
    (∏ p∈r.primeFactors,((p:ℝ)^(1+e))⁻¹*(1-((p:ℝ)^(1+e))⁻¹))*((r:ℝ)/r.totient)^2 =
      Real.exp (-e*Real.log (r:ℝ))*(r.totient:ℝ)⁻¹*eigenCorrection r e := by
  let S := r.primeFactors
  let q (p : ℕ) : ℝ := Real.exp (-e*Real.log (p:ℝ))
  let g (p : ℕ) : ℝ := ((p:ℝ)-1)
  let h (p : ℕ) : ℝ := 1+(1-q p)/g p
  have hp (p : ℕ) (hp : p∈S) : (1:ℝ)<p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_lt
  have htot : (r.totient:ℝ) = ∏ p∈S,g p := by
    have ht := Nat.totient_eq_div_primeFactors_mul r
    rw [Nat.prod_primeFactors_of_squarefree hr,Nat.div_self (Nat.pos_of_ne_zero hr.ne_zero),one_mul] at ht
    rw [ht,Nat.cast_prod]
    exact prod_congr rfl fun p hP => Nat.cast_sub (Nat.prime_of_mem_primeFactors hP).one_lt.le
  have hprod : (r:ℝ) = ∏ p∈S,(p:ℝ) := by
    rw [←Nat.cast_prod,Nat.prod_primeFactors_of_squarefree hr]
  have hlogs : Real.exp (-e*Real.log (r:ℝ))=∏ p∈S,q p := by
    unfold q
    rw [hprod,Real.log_prod,Finset.mul_sum,Real.exp_sum]
    exact fun p hp' => (zero_lt_one.trans (hp p hp')).ne'
  have hratio : ((r:ℝ)/r.totient)^2=∏ p∈S,((p:ℝ)/g p)^2 := by
    rw [hprod,htot,←Finset.prod_div_distrib,←Finset.prod_pow]
  have hs (p : ℕ) (hP : p∈S) : ((p:ℝ)^(1+e))⁻¹=(p:ℝ)⁻¹*q p := by
    have hpos := zero_lt_one.trans (hp p hP)
    dsimp only [q]
    rw [Real.rpow_add hpos,Real.rpow_one,mul_inv,Real.rpow_def_of_pos hpos,
      show -e*Real.log (p:ℝ)=-(Real.log (p:ℝ)*e) by ring,Real.exp_neg]
  rw [hratio,hlogs,htot,←Finset.prod_inv_distrib,eigenCorrection,←Finset.prod_mul_distrib,
    ←Finset.prod_mul_distrib,←Finset.prod_mul_distrib]
  apply prod_congr rfl
  intro p hP
  rw [hs p hP]
  change (p:ℝ)⁻¹*q p*(1-(p:ℝ)⁻¹*q p)*((p:ℝ)/g p)^2 = q p*(g p)⁻¹*h p
  dsimp only [h,g]
  field_simp [(zero_lt_one.trans (hp p hP)).ne',sub_ne_zero.mpr (hp p hP).ne']
  ring

theorem eventually_eigenCorrection_le {t v ε : ℝ} (ht : 0≤t) (hv : 0≤v) (hε : 0<ε) :
    ∀ᶠ L : ℝ in Filter.atTop, ∀ r : ℕ, 0<r → Real.log (r:ℝ)≤v*L →
      1≤eigenCorrection r (t/L) ∧ eigenCorrection r (t/L)≤1+ε := by
  have hLog : 0<Real.log (1+ε) := Real.log_pos (by linarith only [hε])
  have hLarge := (Filter.tendsto_atTop.1 Real.tendsto_sqrt_atTop) (t*(1+2*v)/Real.log (1+ε))
  filter_upwards [hLarge,Filter.eventually_ge_atTop (4:ℝ)] with L hS hL r hr hrL
  have hL₀ : 0<L := by linarith only [hL]
  have hSQ : 0<Real.sqrt L := Real.sqrt_pos.2 hL₀
  have hc := one_le_eigenCorrection_le (r:=r) (div_nonneg ht hL₀.le : 0≤t/L)
  refine ⟨hc.1,hc.2.trans ?_⟩
  rw [←Real.exp_log (by linarith only [hε] : 0<1+ε)]
  apply Real.exp_le_exp.mpr
  calc
    (t/L)*primeEulerLogMass r = t*(primeEulerLogMass r/L) := by ring
    _ ≤ t*((1+2*v)/Real.sqrt L) := mul_le_mul_of_nonneg_left
      (primeEulerLogMass_div_le hr hL hv hrL) ht
    _ = (t*(1+2*v))/Real.sqrt L := by ring
    _ ≤ Real.log (1+ε) := (div_le_iff₀ hSQ).mpr (by
      have hh := (div_le_iff₀ hLog).mp hS
      simpa only [mul_comm] using hh)

end
end GoldbachMoebiusLog
end

section
namespace GoldbachGrahamDiagonal

open Finset
noncomputable section

/-- The ideal scaled Selberg coordinate for two logarithmic cutoffs. -/
def grahamProfile (t u v z : ℝ) : ℝ :=
  if z≤u then t else (1+t*(v-z))/(v-u)

/-- On either side of the lower cutoff the affine main term gives the same
finite coefficient after forming the difference, up to the endpoint strips. -/
theorem grahamProfile_approx {t u v z η ε : ℝ} (hη : 0<η) (hε : 0≤ε)
    (huv : u<v) (hz : 0≤z) (hzv : z≤v-η)
    (hBand : z≤u-η ∨ u+η≤z)
    (A : ℝ → ℝ) (hA : ∀ x∈Set.Icc η v, |A x-(1+t*x)|≤ε)
    (hZero : ∀ x<0, A x=0) :
    |(A (v-z)-A (u-z))/(v-u)-grahamProfile t u v z| ≤ 2*ε/(v-u) := by
  have hd := sub_pos.mpr huv
  have hV := hA (v-z) ⟨by linarith only [hzv],sub_le_self _ hz⟩
  rcases hBand with hLeft | hRight
  · have hU := hA (u-z) ⟨by linarith only [hLeft],(sub_le_self _ hz).trans huv.le⟩
    rw [grahamProfile,ite_eq_left (by linarith only [hLeft,hη] : z≤u)]
    rw [show (A (v-z)-A (u-z))/(v-u)-t =
      ((A (v-z)-(1+t*(v-z)))-(A (u-z)-(1+t*(u-z))))/(v-u) by
        field_simp [hd.ne'] <;> ring,abs_div,abs_of_pos hd]
    exact div_le_div_of_nonneg_right ((abs_sub _ _).trans (by linarith only [hU,hV])) hd.le
  · have hU := hZero (u-z) (by linarith only [hRight,hη])
    rw [hU,sub_zero,grahamProfile,ite_eq_right (by linarith only [hRight,hη] : ¬z≤u),
      ←sub_div,abs_div,abs_of_pos hd]
    exact div_le_div_of_nonneg_right (hV.trans (by linarith only [hε])) hd.le

theorem grahamProfile_abs_le {t u v z : ℝ} (ht : 0≤t) (huv : u<v)
    (hz : z∈Set.Icc 0 v) : |grahamProfile t u v z| ≤ t+(1+t*v)/(v-u) := by
  have hDen := sub_pos.mpr huv
  have hV : 0≤v := hz.1.trans hz.2
  unfold grahamProfile
  split_ifs
  · rw [abs_of_nonneg ht]
    exact le_add_of_nonneg_right (by positivity)
  · rw [abs_of_nonneg (by positivity [sub_nonneg.mpr hz.2])]
    have hb := mul_le_mul_of_nonneg_left (sub_le_self v hz.1) ht
    apply le_trans (div_le_div_of_nonneg_right _ hDen.le)
    · exact le_add_of_nonneg_left ht
    · linarith only [hb]


/-- Discarding narrow bands at the two cutoffs suffices for diagonal convergence. -/
theorem diagonal_compare_of_good {ι : Type*} [DecidableEq ι] (S G : Finset ι) (hGS : G⊆S)
    (w c f g : ι → ℝ) {M ε : ℝ} (hM : 0≤M) (hε : 0≤ε) (hε₁ : ε≤1)
    (hw : ∀ i∈S, 0≤w i) (hc : ∀ i∈S, 1≤c i ∧ c i≤1+ε)
    (hf : ∀ i∈S, |f i|≤M) (hg : ∀ i∈S, |g i|≤M)
    (hGood : ∀ i∈G, |f i-g i|≤ε) :
    |(∑ i∈S,w i*c i*(f i)^2)-(∑ i∈S,w i*(g i)^2)| ≤
      ε*(M^2+2*M)*(∑ i∈S,w i)+3*M^2*(∑ i∈S\G,w i) := by
  let err (i : ι) := w i*(c i*(f i)^2-(g i)^2)
  have hNo (i : ι) (hi : i∈S) : |err i|≤w i*(3*M^2) := by
    have hc₀ : 0≤c i := zero_le_one.trans (hc i hi).1
    have hc₂ : c i≤2 := (hc i hi).2.trans (by linarith only [hε₁])
    have hf₂ : (f i)^2≤M^2 := (sq_le_sq).mpr (by simpa only [abs_of_nonneg hM] using hf i hi)
    have hg₂ : (g i)^2≤M^2 := (sq_le_sq).mpr (by simpa only [abs_of_nonneg hM] using hg i hi)
    dsimp only [err]
    rw [abs_mul,abs_of_nonneg (hw i hi)]
    apply mul_le_mul_of_nonneg_left _ (hw i hi)
    have hF := mul_le_mul hc₂ hf₂ (sq_nonneg _) (by norm_num : (0:ℝ)≤2)
    have hF₀ := mul_nonneg hc₀ (sq_nonneg (f i))
    have hG₀ := sq_nonneg (g i)
    rw [abs_le]
    constructor <;> nlinarith only [hF,hF₀,hg₂,hG₀,sq_nonneg M]
  have hYes (i : ι) (hi : i∈G) : |err i|≤w i*(ε*(M^2+2*M)) := by
    have hiS := hGS hi
    have hcd : |c i-1|≤ε := by
      rw [abs_of_nonneg (sub_nonneg.mpr (hc i hiS).1)]
      linarith only [(hc i hiS).2]
    have hsq : |(f i)^2-(g i)^2|≤ε*(2*M) := by
      rw [show (f i)^2-(g i)^2=(f i-g i)*(f i+g i) by ring,abs_mul]
      exact mul_le_mul (hGood i hi)
        ((abs_add_le _ _).trans (by linarith only [hf i hiS,hg i hiS])) (abs_nonneg _) hε
    dsimp only [err]
    rw [abs_mul,abs_of_nonneg (hw i hiS)]
    apply mul_le_mul_of_nonneg_left _ (hw i hiS)
    have hF : (f i)^2≤M^2 := (sq_le_sq).mpr (by simpa only [abs_of_nonneg hM] using hf i hiS)
    calc
      _ = |(c i-1)*(f i)^2+((f i)^2-(g i)^2)| := by congr 1; ring
      _ ≤ |(c i-1)*(f i)^2|+|(f i)^2-(g i)^2| := abs_add_le _ _
      _ ≤ ε*M^2+ε*(2*M) := by
        rw [abs_mul,abs_of_nonneg (sq_nonneg (f i))]
        exact add_le_add (mul_le_mul hcd hF (sq_nonneg _) hε) hsq
      _ = _ := by ring
  rw [←sum_sub_distrib]
  simp_rw [show ∀ i,w i*c i*(f i)^2-w i*(g i)^2=err i from fun i => by dsimp only [err]; ring]
  have hS : (∑ i∈S, |err i|) = (∑ i∈S\G,|err i|)+(∑ i∈G,|err i|) :=
    (sum_sdiff hGS).symm
  have hSum := Finset.abs_sum_le_sum_abs (s:=S) (f:=err)
  rw [hS] at hSum
  refine hSum.trans ?_
  have hBound₀ := sum_le_sum (s:=S\G) (fun i hi => hNo i (mem_sdiff.mp hi).1)
  have hBound₁ := sum_le_sum (s:=G) hYes
  simp only [←sum_mul] at hBound₀ hBound₁
  have hSub : (∑ i∈G,w i)≤∑ i∈S,w i := sum_le_sum_of_subset_of_nonneg hGS (fun i hi _ => hw i hi)
  have hBound₁' := hBound₁.trans (mul_le_mul_of_nonneg_right hSub (by positivity :
    0≤ε*(M^2+2*M)))
  have h := add_le_add hBound₀ hBound₁'
  exact h.trans_eq (by ring)

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter MeasureTheory
open scoped Topology Interval Classical
noncomputable section

/-- The support of the shifted Selberg diagonal on the logarithmic scale. -/
def grahamIndices (v L : ℝ) : Finset ℕ :=
  (Icc 1 ⌊Real.exp (v*L)⌋₊).filter Squarefree

/-- Index height in the logarithmic coordinate. -/
def grahamIndexHeight (L : ℝ) (r : ℕ) : ℝ := Real.log (r:ℝ)/L

/-- Quotient form for the empirical Selberg diagonal weight. -/
def grahamDiagonalWeight (t L : ℝ) (r : ℕ) : ℝ :=
  L⁻¹*Real.exp (-t*grahamIndexHeight L r)*(r.totient:ℝ)⁻¹

/-- The good part avoids the jumps of the two logarithmic Möbius coordinates. -/
def grahamGoodIndices (u v η L : ℝ) : Finset ℕ :=
  (grahamIndices v L).filter fun r =>
    grahamIndexHeight L r≤v-η ∧
      (grahamIndexHeight L r≤u-η ∨ u+η≤grahamIndexHeight L r)

def grahamEmpirical (b L : ℝ) (f : ℝ → ℝ) : ℝ :=
  ∑ r∈grahamIndices b L, L⁻¹*(r.totient:ℝ)⁻¹*f (grahamIndexHeight L r)

private theorem grahamIndices_filter_le {L b c : ℝ} (hL : 0<L) (hcb : c≤b) :
    (grahamIndices b L).filter (fun r=>grahamIndexHeight L r≤c)=grahamIndices c L := by
  ext r
  simp only [grahamIndices,mem_filter,mem_Icc]
  constructor
  · rintro ⟨⟨⟨hr, _⟩, hsf⟩, hz⟩
    have hrR : (0:ℝ)<r := by exact_mod_cast Nat.zero_lt_one.trans_le hr
    have hEq := (div_le_iff₀ hL).mp (show Real.log (r:ℝ)/L≤c from hz)
    exact ⟨⟨hr,Nat.le_floor ((Real.log_le_iff_le_exp hrR).mp hEq)⟩,hsf⟩
  · rintro ⟨⟨hr, hc⟩, hsf⟩
    have hrR : (0:ℝ)<r := by exact_mod_cast Nat.zero_lt_one.trans_le hr
    have hEq : (r:ℝ)≤Real.exp (c*L) :=
      (Nat.cast_le.mpr hc).trans (Nat.floor_le (Real.exp_nonneg _))
    refine ⟨⟨⟨hr,hc.trans (Nat.floor_mono ?_)⟩,hsf⟩,?_⟩
    · exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hcb hL.le)
    · exact (div_le_iff₀ hL).mpr ((Real.log_le_iff_le_exp hrR).mpr hEq)

private theorem grahamIndices_subset {L b c : ℝ} (hL : 0<L) (hcb : c≤b) :
    grahamIndices c L⊆grahamIndices b L := by
  rw [←grahamIndices_filter_le hL hcb]
  exact filter_subset _ _

theorem grahamDiagonalWeight_le {L v t : ℝ} {r : ℕ} (hL : 0<L) (ht : 0≤t)
    (hr : r∈grahamIndices v L) :
    grahamDiagonalWeight t L r≤L⁻¹*(r.totient:ℝ)⁻¹ := by
  have hr' : 1≤r := (mem_Icc.mp (mem_filter.mp hr).1).1
  have hz₀ : 0≤grahamIndexHeight L r :=
    div_nonneg (Real.log_nonneg (by exact_mod_cast hr')) hL.le
  have he : Real.exp (-t*grahamIndexHeight L r)≤1 :=
    Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr ht) hz₀)
  unfold grahamDiagonalWeight
  exact mul_le_mul_of_nonneg_right (mul_le_of_le_one_right (inv_nonneg.mpr hL.le) he) (by positivity)

theorem diagonal_bad_band_le {L t u v η : ℝ} (hL : 0<L) (ht : 0≤t) (hη : 0<η)
    (hUV : u+η≤v-η) :
    (∑ r∈grahamIndices v L \ grahamGoodIndices u v η L,grahamDiagonalWeight t L r) ≤
      (grahamEmpirical v L (fun _=>1)-grahamEmpirical (v-η) L (fun _=>1))+
      (grahamEmpirical (u+η) L (fun _=>1)-grahamEmpirical (u-η) L (fun _=>1)) := by
  let A := grahamIndices v L \ grahamIndices (v-η) L
  let B := grahamIndices (u+η) L \ grahamIndices (u-η) L
  have hVV : v-η≤v := sub_le_self _ hη.le
  have hUU : u-η≤u+η := by linarith only [hη]
  have hBsub : grahamIndices (u+η) L⊆grahamIndices (v-η) L :=
    grahamIndices_subset hL hUV
  have hUnion : grahamIndices v L \ grahamGoodIndices u v η L⊆A∪B := by
    intro r hr
    obtain ⟨hS,hG⟩ := Finset.mem_sdiff.mp hr
    have hG' : ¬(grahamIndexHeight L r≤v-η ∧
      (grahamIndexHeight L r≤u-η ∨ u+η≤grahamIndexHeight L r)) :=
      fun hh=>hG (mem_filter.mpr ⟨hS,hh⟩)
    have hSel (b : ℝ) (hb : b≤v) : r∈grahamIndices b L ↔ grahamIndexHeight L r≤b := by
      rw [←grahamIndices_filter_le hL hb,mem_filter,and_iff_right hS]
    by_cases hV : grahamIndexHeight L r≤v-η
    · have hLow : ¬grahamIndexHeight L r≤u-η := fun h => hG' ⟨hV,Or.inl h⟩
      have hHigh : grahamIndexHeight L r≤u+η :=
        (lt_of_not_ge fun h => hG' ⟨hV,Or.inr h⟩).le
      exact mem_union_right _ (mem_sdiff.mpr ⟨(hSel _ (hUV.trans hVV)).mpr hHigh,
        fun h => hLow ((hSel _ (hUU.trans (hUV.trans hVV))).mp h)⟩)
    · exact mem_union_left _ (mem_sdiff.mpr ⟨hS,fun h => hV ((hSel _ hVV).mp h)⟩)
  have hDisj : Disjoint A B := by
    refine disjoint_left.mpr fun r ha hb => ?_
    exact (mem_sdiff.mp ha).2 (hBsub (mem_sdiff.mp hb).1)
  let g (r : ℕ) := L⁻¹*(r.totient:ℝ)⁻¹
  calc
    _ ≤ ∑ r∈grahamIndices v L \ grahamGoodIndices u v η L,g r :=
      sum_le_sum fun r hr=> grahamDiagonalWeight_le hL ht (mem_sdiff.mp hr).1
    _ ≤ ∑ r∈A∪B,g r :=
      sum_le_sum_of_subset_of_nonneg hUnion (fun r _ _ => by dsimp only [g]; positivity)
    _ = (∑ r∈A,g r)+(∑ r∈B,g r) := sum_union hDisj
    _ = _ := by
      unfold grahamEmpirical
      simp only [mul_one]
      rw [sum_sdiff_eq_sub (grahamIndices_subset hL hVV),sum_sdiff_eq_sub (grahamIndices_subset hL hUU)]

variable (empiricalLimit : ∀ b : ℝ, 0≤b → ∀ f : ℝ → ℝ, ContDiff ℝ 1 f →
  Tendsto (fun L : ℝ => grahamEmpirical b L f) atTop (𝓝 (∫ z in (0:ℝ)..b,f z)))

include empiricalLimit

theorem grahamProfile_empirical_limit {t u v : ℝ} (hu : 0≤u) (huv : u<v) :
    Tendsto (fun L : ℝ => ∑ r∈grahamIndices v L,
      grahamDiagonalWeight t L r*(grahamProfile t u v (grahamIndexHeight L r))^2)
      atTop (𝓝 ((∫ z in (0:ℝ)..u,t^2*Real.exp (-t*z))+
        ((v-u)^2)⁻¹*(∫ z in u..v,Real.exp (-t*z)*(1+t*(v-z))^2))) := by
  let f (z : ℝ) := t^2*Real.exp (-t*z)
  let g (z : ℝ) := ((v-u)^2)⁻¹*(Real.exp (-t*z)*(1+t*(v-z))^2)
  have hf : ContDiff ℝ 1 f := by unfold f; fun_prop
  have hg : ContDiff ℝ 1 g := by unfold g; fun_prop
  have h1 := empiricalLimit u hu f hf
  have h2 := empiricalLimit v (hu.trans huv.le) g hg
  have h3 := empiricalLimit u hu g hg
  have h := h1.add (h2.sub h3)
  have hgInt₁ : IntervalIntegrable g volume 0 u := hg.continuous.intervalIntegrable _ _
  have hgInt₂ : IntervalIntegrable g volume u v := hg.continuous.intervalIntegrable _ _
  have hJ := intervalIntegral.integral_add_adjacent_intervals hgInt₁ hgInt₂
  have hDif : (∫ z in (0:ℝ)..v,g z)-(∫ z in (0:ℝ)..u,g z)=∫ z in u..v,g z := by
    linarith only [hJ]
  have hVal : (∫ z in u..v,g z)=
      ((v-u)^2)⁻¹*(∫ z in u..v,Real.exp (-t*z)*(1+t*(v-z))^2) :=
    intervalIntegral.integral_const_mul _ _
  rw [hDif,hVal] at h
  refine h.congr' ?_
  filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
  let I := grahamIndices u L
  let S := grahamIndices v L
  have hIS : I⊆S := grahamIndices_subset hL huv.le
  have hCase (r : ℕ) (hr : r∈S) : r∈I ↔ grahamIndexHeight L r≤u := by
    show r∈grahamIndices u L ↔ _
    rw [←grahamIndices_filter_le hL huv.le,mem_filter,and_iff_right hr]
  change grahamEmpirical u L f+(grahamEmpirical v L g-grahamEmpirical u L g)=_
  unfold grahamEmpirical
  rw [←sum_sdiff_eq_sub hIS]
  rw [←sum_sdiff hIS (f := fun r => grahamDiagonalWeight t L r*
    (grahamProfile t u v (grahamIndexHeight L r))^2)]
  rw [add_comm]
  refine congrArg₂ (·+·) ?_ ?_
  · refine sum_congr rfl fun r hr => ?_
    have hPos := mem_sdiff.mp hr
    have hU : ¬grahamIndexHeight L r≤u := fun hh=>hPos.2 ((hCase _ hPos.1).mpr hh)
    rw [grahamProfile,ite_eq_right hU]
    dsimp only [g,grahamDiagonalWeight]
    rw [div_pow]
    simp only [div_eq_mul_inv]
    ring
  · refine sum_congr rfl fun r hr => ?_
    rw [grahamProfile,ite_eq_left ((hCase _ (hIS hr)).mp hr)]
    dsimp only [f,grahamDiagonalWeight]
    ring

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open GoldbachPintzTheta GoldbachMoebiusLog Finset Filter
open scoped Classical
noncomputable section

private theorem graham_pos_log_index {v L : ℝ} {r : ℕ} (hL : 0<L)
    (hr : r∈grahamIndices v L) :
    0<r ∧ Squarefree r ∧ grahamIndexHeight L r∈Set.Icc 0 v := by
  obtain ⟨hi,hq⟩ := mem_filter.mp hr
  obtain ⟨hr₁,hrv⟩ := mem_Icc.mp hi
  have hrp := Nat.zero_lt_one.trans_le hr₁
  have hrR : (0:ℝ)<r := by exact_mod_cast hrp
  have hrLog : Real.log (r:ℝ)≤v*L := by
    rw [←Real.log_exp (v*L)]
    exact Real.log_le_log hrR ((Nat.cast_le.mpr hrv).trans (Nat.floor_le (Real.exp_nonneg _)))
  exact ⟨hrp,hq,div_nonneg (Real.log_nonneg (by exact_mod_cast hr₁)) hL.le,(div_le_iff₀ hL).mpr hrLog⟩

private theorem graham_coordinate_log {r : ℕ} (hr : 0<r) (e x : ℝ) :
    normalizedAvoidLog r.primeFactors e (x-Real.log (r:ℝ)) =
      ((r.totient:ℝ)/r)*coprimeLogCoordinate r (1+e) (Real.exp x) := by
  have hrR : (0:ℝ)<r := by exact_mod_cast hr
  rw [normalizedAvoidLog_primeFactors_eq hr,Real.exp_sub,Real.exp_log hrR]
  rfl

set_option maxHeartbeats 1500000 in
/-- Compare the actual diagonal to its explicit profile, charging only the
mass of fixed endpoint bands and a uniform approximation error. -/
theorem eventually_diagonal_profile_compare {t u v η ε : ℝ} (ht : 0≤t) (hu : 0≤u)
    (huv : u<v) (hη : 0<η) (hε : 0<ε) (hε₁ : ε≤1) :
    ∀ᶠ L : ℝ in atTop,
      |L*rpowForm (Icc 1 ⌊Real.exp (v*L)⌋₊) (barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) (1+t/L) -
        (∑ r∈grahamIndices v L, grahamDiagonalWeight t L r*(grahamProfile t u v (grahamIndexHeight L r))^2)| ≤
        ε*((10*(1+t*v)/(v-u)+t)^2+2*(10*(1+t*v)/(v-u)+t))*
          (∑ r∈grahamIndices v L,grahamDiagonalWeight t L r)+
        3*(10*(1+t*v)/(v-u)+t)^2*
          (∑ r∈grahamIndices v L \ grahamGoodIndices u v η L,grahamDiagonalWeight t L r) := by
  have hv : 0≤v := hu.trans huv.le
  have hd := sub_pos.mpr huv
  let M := 10*(1+t*v)/(v-u)+t
  let δ := ε*(v-u)/2
  have hM : 0≤M := by dsimp only [M]; positivity
  have hδ : 0<δ := by dsimp only [δ]; positivity
  filter_upwards [eventually_gt_atTop (0:ℝ),eventually_eigenCorrection_le ht hv hε,
    eventually_normalizedAvoidLog_uniform ht hη hv hδ] with L hL hCorr hApprox
  let S := grahamIndices v L
  let G := grahamGoodIndices u v η L
  let e := t/L
  let z (r : ℕ) := grahamIndexHeight L r
  let c (r : ℕ) := eigenCorrection r e
  let w (r : ℕ) := grahamDiagonalWeight t L r
  let A (r : ℕ) (y : ℝ) := normalizedAvoidLog r.primeFactors e (y*L)
  let f (r : ℕ) := (A r (v-z r)-A r (u-z r))/(v-u)
  let g (r : ℕ) := grahamProfile t u v (z r)
  have he : 0≤e := div_nonneg ht hL.le
  have hS (r : ℕ) (hr : r∈S) := graham_pos_log_index hL hr
  have hLog (r : ℕ) (hr : r∈S) : Real.log (r:ℝ)≤v*L := (div_le_iff₀ hL).mp (hS r hr).2.2.2
  have hGS : G⊆S := filter_subset _ _
  have hW (r : ℕ) (hr : r∈S) : 0≤w r := by dsimp only [w,grahamDiagonalWeight]; positivity
  have hC (r : ℕ) (hr : r∈S) : 1≤c r ∧ c r≤1+ε := hCorr r (hS r hr).1 (hLog r hr)
  have hA (r : ℕ) (hr : r∈S) (y : ℝ) (hy : y≤v) : |A r y|≤5*(1+t*v) := by
    have hn := normalizedAvoidLog_abs_le_affine r.primeFactors
      (fun _ hp=> Nat.prime_of_mem_primeFactors hp) he (y*L)
    refine hn.trans ?_
    have hy' : max 0 (y*L)≤v*L := max_le (mul_nonneg hv hL.le) (mul_le_mul_of_nonneg_right hy hL.le)
    have hh := mul_le_mul_of_nonneg_left hy' he
    have he' : e*(v*L)=t*v := by dsimp only [e]; field_simp [hL.ne'] <;> ring
    rw [he'] at hh
    linarith only [hh]
  have hf (r : ℕ) (hr : r∈S) : |f r|≤M := by
    have hz := (hS r hr).2.2.1
    have hV := hA r hr (v-z r) (sub_le_self _ hz)
    have hU := hA r hr (u-z r) ((sub_le_self _ hz).trans huv.le)
    dsimp only [f]
    rw [abs_div,abs_of_pos hd]
    have hh : |A r (v-z r)-A r (u-z r)|≤10*(1+t*v) :=
      (abs_sub _ _).trans (by linarith only [hV,hU])
    exact (div_le_div_of_nonneg_right hh hd.le).trans (le_add_of_nonneg_right ht)
  have hg (r : ℕ) (hr : r∈S) : |g r|≤M := by
    refine (grahamProfile_abs_le ht huv (hS r hr).2.2).trans ?_
    dsimp only [M]
    have hh := div_le_div_of_nonneg_right (show 1+t*v≤10*(1+t*v) by nlinarith only [mul_nonneg ht hv]) hd.le
    linarith only [hh]
  have hGood (r : ℕ) (hr : r∈G) : |f r-g r|≤ε := by
    obtain ⟨hrS,hzV,hBand⟩ := mem_filter.mp hr
    have hApprox' (y : ℝ) (hy : y∈Set.Icc η v) : |A r y-(1+t*y)|≤δ := by
      have hP := hApprox r (hS r hrS).1 (hLog r hrS) (y*L)
        ⟨mul_le_mul_of_nonneg_right hy.1 hL.le,mul_le_mul_of_nonneg_right hy.2 hL.le⟩
      have he' : e*(y*L)=t*y := by dsimp only [e]; field_simp [hL.ne'] <;> ring
      change |A r y-(1+e*(y*L))|≤δ at hP
      rwa [he'] at hP
    have hZero (y : ℝ) (hy : y<0) : A r y=0 :=
      normalizedAvoidLog_of_neg _ (mul_neg_of_neg_of_pos hy hL)
    have hh := grahamProfile_approx hη hδ.le huv (hS r hrS).2.2.1 hzV hBand (A r) hApprox' hZero
    have hRec : 2*δ/(v-u)=ε := by dsimp only [δ]; field_simp [hd.ne']
    rw [hRec] at hh
    exact hh
  have hScale (r : ℕ) (a : ℝ) : (a-z r)*L=a*L-Real.log (r:ℝ) := by
    dsimp only [z,grahamIndexHeight]
    field_simp [hL.ne']
  have hden : Real.log (Real.exp (v*L)/Real.exp (u*L))=(v-u)*L := by
    rw [Real.log_div (Real.exp_ne_zero _) (Real.exp_ne_zero _),Real.log_exp,Real.log_exp]
    ring
  have hId : L*rpowForm (Icc 1 ⌊Real.exp (v*L)⌋₊)
      (barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) (1+t/L)=∑ r∈S,w r*c r*(f r)^2 := by
    rw [barbanVehov_diagonal_eq (Real.exp_nonneg _) (Real.exp_le_exp.mpr
      (mul_le_mul_of_nonneg_right huv.le hL.le)) (by positivity : 0<1+t/L),Finset.mul_sum]
    refine sum_congr rfl fun r hr => ?_
    have hr' := (hS r hr).1
    have heig := squarefree_eigen_eq (hS r hr).2.1 e
    dsimp only [normalizedRpowEigen]
    rw [heig,←graham_coordinate_log hr',←graham_coordinate_log hr',hden]
    have hZ : -e*Real.log (r:ℝ)= -t*z r := by dsimp only [e,z,grahamIndexHeight]; ring
    rw [hZ]
    dsimp only [w,grahamDiagonalWeight,c,f,A]
    rw [hScale,hScale]
    field_simp [hd.ne',hL.ne']
    ring
  rw [hId]
  exact diagonal_compare_of_good S G hGS w c f g hM hε.le hε₁ hW hC hf hg hGood

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachMoebiusLog

open MeasureTheory Set
open scoped Interval

noncomputable section

/-- The limiting diagonal expression for the scaled sieve energy. -/
theorem scaled_diagonal_laplace_eq {t u v : ℝ} (ht : 0<t) (huv : u<v) :
    ((∫ z in (0:ℝ)..u, t^2*Real.exp (-t*z)) +
        ((v-u)^2)⁻¹*(∫ z in u..v, Real.exp (-t*z)*(1+t*(v-z))^2))/t =
      1+(Real.exp (-t*u)-Real.exp (-t*v))/(t^2*(v-u)^2) := by
  have hP (z : ℝ) : HasDerivAt (fun z => -t*Real.exp (-t*z)) (t^2*Real.exp (-t*z)) z := by
    have hE := (((hasDerivAt_id z).const_mul (-t)).exp).const_mul (-t)
    apply hE.congr_deriv
    simp only [id_eq,mul_one]
    ring
  have hI : (∫ z in (0:ℝ)..u, t^2*Real.exp (-t*z)) = t*(1-Real.exp (-t*u)) := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun z _ => hP z)
      (Continuous.intervalIntegrable (by fun_prop) _ _)]
    simp only [mul_zero,Real.exp_zero,mul_one]
    ring
  have hQ (z : ℝ) : HasDerivAt
      (fun z => -Real.exp (-t*z)*(t*(v-z)^2+t⁻¹))
      (Real.exp (-t*z)*(1+t*(v-z))^2) z := by
    have hA : HasDerivAt (fun z => v-z) (-1) z := (hasDerivAt_id z).const_sub v
    have hE := (((hasDerivAt_id z).const_mul (-t)).exp).neg
    have hB := ((hA.pow 2).const_mul t).add_const t⁻¹
    apply (hE.mul hB).congr_deriv
    simp only [id_eq,mul_one,Nat.cast_ofNat,Nat.reduceSub,pow_one,Pi.pow_apply,Pi.neg_apply]
    field_simp [ht.ne']
    ring
  have hII : (∫ z in u..v, Real.exp (-t*z)*(1+t*(v-z))^2) =
      Real.exp (-t*u)*(t*(v-u)^2+t⁻¹)-Real.exp (-t*v)*t⁻¹ := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun z _ => hQ z)
      (Continuous.intervalIntegrable (by fun_prop) _ _)]
    simp only [sub_self,zero_pow (by norm_num : (2:ℕ)≠0),mul_zero,zero_add]
    ring
  rw [hI,hII]
  field_simp [ht.ne',sub_ne_zero.mpr (ne_of_gt huv)]
  ring


end
end GoldbachMoebiusLog
end

section
namespace GoldbachGrahamDiagonal

open GoldbachMollifiedHarmonic Filter MeasureTheory
open scoped Topology Interval
noncomputable section

/-- The zeta factor contributing to the unweighted diagonal scale. -/
theorem realZetaSeries_one_add_div_tendsto {t : ℝ} (ht : 0<t) :
    Tendsto (fun L : ℝ => realZetaSeries (1+t/L)/L) atTop (𝓝 (1/t)) := by
  have hi : Tendsto (fun L : ℝ => L⁻¹) atTop (𝓝 0) := tendsto_inv_atTop_zero
  have hx : Tendsto (fun L : ℝ => 1+t/L) atTop (𝓝 1) := by
    simpa only [div_eq_mul_inv,mul_zero,add_zero] using tendsto_const_nhds.add (tendsto_const_nhds.mul hi)
  have hx' : Tendsto (fun L : ℝ => 1+t/L) atTop (𝓝[>]1) := by
    rw [tendsto_nhdsWithin_iff]
    refine ⟨hx,?_⟩
    filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
    exact Set.mem_Ioi.mpr (lt_add_of_pos_right _ (div_pos ht hL))
  have hz := (tendsto_sub_mul_tsum_nat_rpow.comp hx').div_const t
  refine hz.congr' ?_
  filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
  change ((1+t/L-1)*(∑' n:ℕ,1/(n:ℝ)^(1+t/L)))/t=realZetaSeries (1+t/L)/L
  simp only [realZetaSeries,one_div,add_sub_cancel_left]
  field_simp [ht.ne',hL.ne']

/-- Multiply the finite diagonal limit by the zeta pole to recover the
Laplace transform of the ramp density. -/
theorem graham_series_limit_of_diagonal {t u v : ℝ} {F : ℝ → ℝ}
    (ht : 0<t) (huv : u<v)
    (hDiag : Tendsto (fun L : ℝ => L*F L) atTop
      (𝓝 ((∫ z in (0:ℝ)..u,t^2*Real.exp (-t*z))+
        ((v-u)^2)⁻¹*(∫ z in u..v,Real.exp (-t*z)*(1+t*(v-z))^2)))) :
    Tendsto (fun L : ℝ => realZetaSeries (1+t/L)*F L) atTop
      (𝓝 (1+(Real.exp (-t*u)-Real.exp (-t*v))/(t^2*(v-u)^2))) := by
  let D := (∫ z in (0:ℝ)..u,t^2*Real.exp (-t*z))+
    ((v-u)^2)⁻¹*(∫ z in u..v,Real.exp (-t*z)*(1+t*(v-z))^2)
  have hz := (realZetaSeries_one_add_div_tendsto ht).mul hDiag
  have hD : (1/t)*D=1+(Real.exp (-t*u)-Real.exp (-t*v))/(t^2*(v-u)^2) := by
    rw [show (1/t)*D=D/t by ring]
    exact GoldbachMoebiusLog.scaled_diagonal_laplace_eq ht huv
  change Tendsto (fun L : ℝ=>realZetaSeries (1+t/L)/L*(L*F L)) atTop (𝓝 ((1/t)*D)) at hz
  rw [hD] at hz
  refine hz.congr' ?_
  filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
  field_simp [hL.ne'] <;> ring

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open ArithmeticFunction Finset
open scoped ArithmeticFunction Moebius

noncomputable section

private def natReciprocal : ArithmeticFunction ℝ :=
  (ArithmeticFunction.zeta : ArithmeticFunction ℝ).pdiv (ArithmeticFunction.id : ArithmeticFunction ℝ)

private def moebiusReciprocal : ArithmeticFunction ℝ :=
  (μ : ArithmeticFunction ℝ).pdiv (ArithmeticFunction.id : ArithmeticFunction ℝ)

private def totientReal : ArithmeticFunction ℝ :=
  ⟨fun n => n.totient,by simp⟩

def squarefreeTotientMass : ArithmeticFunction ℝ :=
  ((μ : ArithmeticFunction ℝ).ppow 2).pdiv totientReal

def totientMassCorrection : ArithmeticFunction ℝ := squarefreeTotientMass*moebiusReciprocal

theorem squarefreeTotientMass_apply (n : ℕ) :
    squarefreeTotientMass n = (moebius n:ℝ)^2/(n.totient:ℝ) := by
  simp only [squarefreeTotientMass,pdiv_apply,ppow_apply (by decide : 0 < 2),intCoe_apply]
  rfl

theorem natReciprocal_apply (n : ℕ) :
    natReciprocal n = (n:ℝ)⁻¹ := by
  by_cases h : n=0
  · simp [h]
  · simp [natReciprocal,Nat.cast_ne_zero.mpr h, zeta_apply_ne h,id_apply,one_div]

private theorem moebiusReciprocal_apply (n : ℕ) :
    moebiusReciprocal n = (moebius n:ℝ)/(n:ℝ) := by
  simp [moebiusReciprocal,id_apply]

theorem totientMassCorrection_multiplicative : totientMassCorrection.IsMultiplicative := by
  have hφ : totientReal.IsMultiplicative := by
    refine ⟨by simp [totientReal],?_⟩
    intro m n h
    simp [totientReal,Nat.totient_mul h]
  have hμ : (μ : ArithmeticFunction ℝ).IsMultiplicative := isMultiplicative_moebius.intCast
  exact ((hμ.ppow (k:=2)).pdiv hφ).mul (hμ.pdiv isMultiplicative_id.natCast)

private theorem product_pdiv_id (f g : ArithmeticFunction ℝ) :
    f.pdiv (ArithmeticFunction.id : ArithmeticFunction ℝ) *
      g.pdiv (ArithmeticFunction.id : ArithmeticFunction ℝ) =
      (f*g).pdiv (ArithmeticFunction.id : ArithmeticFunction ℝ) := by
  ext n
  rw [ArithmeticFunction.mul_apply,pdiv_apply,ArithmeticFunction.mul_apply,sum_div]
  apply sum_congr rfl
  intro m hm
  have h := (Nat.mem_divisorsAntidiagonal.mp hm).1
  simp only [pdiv_apply,natCoe_apply,id_apply,div_mul_div_comm]
  rw [← Nat.cast_mul,h]

private theorem reciprocal_mul_moebiusReciprocal :
    natReciprocal*moebiusReciprocal=1 := by
  rw [natReciprocal,moebiusReciprocal,product_pdiv_id,coe_zeta_mul_coe_moebius]
  ext n
  by_cases hn : n=1
  · simp [hn,id_apply]
  · simp [ArithmeticFunction.one_apply_ne hn]

theorem squarefreeTotientMass_eq_convolution :
    squarefreeTotientMass=natReciprocal*totientMassCorrection := by
  rw [totientMassCorrection,mul_left_comm,reciprocal_mul_moebiusReciprocal,mul_one]

theorem dirichlet_mul_apply_prime_pow (f g : ArithmeticFunction ℝ) {p : ℕ}
    (hp : p.Prime) (k : ℕ) :
    (f*g) (p^k)=∑ i ∈ range (k+1),f (p^i)*g (p^(k-i)) := by
  classical
  let e : ℕ ↪ ℕ := ⟨(p^·),Nat.pow_right_injective hp.one_lt⟩
  have he : (antidiagonal k).map (e.prodMap e) = (p^k).divisorsAntidiagonal := by
    apply le_antisymm (Nat.antidiagonal_map_subset_divisorsAntidiagonal_pow hp.one_lt k)
    intro m hm
    obtain ⟨hmul,hn⟩ := Nat.mem_divisorsAntidiagonal.mp hm
    obtain ⟨i,hi,he1⟩ := (Nat.dvd_prime_pow hp).mp (Dvd.intro m.2 hmul)
    obtain ⟨j,hj,he2⟩ := (Nat.dvd_prime_pow hp).mp (Dvd.intro_left m.1 hmul)
    have hk : i+j=k := (Nat.pow_right_injective hp.one_lt) (by change p^(i+j)=p^k; rw [pow_add,← he1,← he2,hmul])
    exact mem_map.mpr ⟨(i,j),mem_antidiagonal.mpr hk,Prod.ext he1.symm he2.symm⟩
  rw [ArithmeticFunction.mul_apply,← he,sum_map,Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  rfl

private theorem moebiusReciprocal_large_prime_pow {p k : ℕ}
    (hp : p.Prime) (hk : 2 ≤ k) : moebiusReciprocal (p^k)=0 := by
  rw [moebiusReciprocal_apply,moebius_apply_prime_pow hp (by omega),ite_eq_right (by omega)]
  simp

private theorem squarefreeTotientMass_large_prime_pow {p k : ℕ}
    (hp : p.Prime) (hk : 2 ≤ k) : squarefreeTotientMass (p^k)=0 := by
  rw [squarefreeTotientMass_apply,moebius_apply_prime_pow hp (by omega),ite_eq_right (by omega)]
  simp

theorem totientMassCorrection_prime_pow {p : ℕ} (hp : p.Prime) (k : ℕ) :
    totientMassCorrection (p^k) =
      if k=0 then 1 else if k=1 then 1/((p:ℝ)*(p-1))
      else if k=2 then -1/((p:ℝ)*(p-1)) else 0 := by
  rw [totientMassCorrection,dirichlet_mul_apply_prime_pow _ _ hp]
  have hp1 : (1:ℝ)<p := by exact_mod_cast hp.one_lt
  have hcast : ((p-1:ℕ):ℝ) = (p:ℝ)-1 := Nat.cast_sub (Nat.one_le_of_lt hp.one_lt)
  have hf : squarefreeTotientMass p = 1/((p:ℝ)-1) := by
    rw [squarefreeTotientMass_apply,moebius_apply_prime hp,Nat.totient_prime hp,hcast]
    norm_num
  have hg : moebiusReciprocal p = -1/(p:ℝ) := by
    rw [moebiusReciprocal_apply,moebius_apply_prime hp]
    norm_num
  have hf1 : squarefreeTotientMass 1=1 := by simp [squarefreeTotientMass_apply]
  have hg1 : moebiusReciprocal 1=1 := by simp [moebiusReciprocal_apply]
  rcases k with _|_|_|k
  · simp [hf1,hg1]
  · norm_num [sum_range_succ,hf,hg,hf1,hg1]
    field_simp [show (p:ℝ) ≠ 0 by positivity,sub_ne_zero.mpr hp1.ne']
    ring
  · norm_num [sum_range_succ,hf,hg,hf1,hg1,
      squarefreeTotientMass_large_prime_pow hp (show (2:ℕ) ≤ 2 by decide),
      moebiusReciprocal_large_prime_pow hp (show (2:ℕ) ≤ 2 by decide)]
    field_simp [show (p:ℝ) ≠ 0 by positivity,sub_ne_zero.mpr hp1.ne']
  · simp only [Nat.succ_ne_zero,ite_eq_right]
    apply sum_eq_zero
    intro i hi
    by_cases h : 2 ≤ i
    · rw [squarefreeTotientMass_large_prime_pow hp h,zero_mul]
    · rw [moebiusReciprocal_large_prime_pow hp (by omega),mul_zero]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open ArithmeticFunction Finset
open scoped BigOperators Topology

noncomputable section

private theorem totientMassCorrection_local_tsum {p : ℕ} (hp : p.Prime) :
    (∑' k : ℕ, totientMassCorrection (p^k))=1 := by
  have hS : ∀ k ∉ range 3, totientMassCorrection (p^k)=0 := by
    intro k hk
    simp only [mem_range,not_lt] at hk
    rw [totientMassCorrection_prime_pow hp]
    simp [show k ≠ 0 by omega, show k ≠ 1 by omega, show k ≠ 2 by omega]
  rw [tsum_eq_sum hS]
  simp [sum_range_succ,totientMassCorrection_prime_pow hp]
  have hp1 : (1:ℝ) < p := by exact_mod_cast hp.one_lt
  field_simp [show (p:ℝ) ≠ 0 by positivity,sub_ne_zero.mpr hp1.ne'] <;> ring

private theorem totientMassCorrection_local_norm_tsum {p : ℕ} (hp : p.Prime) :
    (∑' k : ℕ, ‖totientMassCorrection (p^k)‖)=1+2/((p:ℝ)*(p-1)) := by
  have hS : ∀ k ∉ range 3, ‖totientMassCorrection (p^k)‖=0 := by
    intro k hk
    simp only [mem_range,not_lt] at hk
    rw [totientMassCorrection_prime_pow hp]
    split_ifs <;> simp_all <;> omega
  have hp1 : (1:ℝ)<p := by exact_mod_cast hp.one_lt
  have hpos : 0 < (p:ℝ)*((p:ℝ)-1) := by positivity
  rw [tsum_eq_sum hS]
  simp only [sum_range_succ,totientMassCorrection_prime_pow hp]
  norm_num [Real.norm_eq_abs,abs_of_pos hpos,abs_div,abs_of_pos (sub_pos.mpr hp1),
    abs_of_pos (zero_lt_one.trans hp1)]
  field_simp [show (p:ℝ) ≠ 0 by positivity, sub_ne_zero.mpr hp1.ne'] <;> ring

private theorem totientMassCorrection_local_norm_summable {p : ℕ} (hp : p.Prime) :
    Summable (fun k : ℕ => ‖totientMassCorrection (p^k)‖) := by
  apply summable_of_ne_finset_zero (s:=range 3)
  intro k hk
  simp only [mem_range,not_lt] at hk
  rw [totientMassCorrection_prime_pow hp]
  split_ifs <;> simp_all <;> omega

private theorem sum_reciprocal_consecutive_le_one (N : ℕ) :
    ∑ n ∈ Ico 2 N,1/((n:ℝ)*(n-1)) ≤ 1 := by
  by_cases hN : 2 ≤ N
  · have he : ∀ (k : ℕ), 2 ≤ k → (∑ n ∈ Ico 2 k,1/((n:ℝ)*(n-1))) = 1-1/((k:ℝ)-1) := by
      intro k hk
      induction k,hk using Nat.le_induction with
      | base => norm_num
      | succ k hk ih =>
          rw [sum_Ico_succ_top hk, ih]
          have hk' : (2:ℝ) ≤ k := by exact_mod_cast hk
          simp only [Nat.cast_succ, add_sub_cancel_right]
          field_simp [show (k:ℝ) ≠ 0 by linarith,show (k:ℝ)-1 ≠ 0 by linarith]
          ring
    rw [he N hN]
    have : (2:ℝ) ≤ N := by exact_mod_cast hN
    exact sub_le_self _ (one_div_nonneg.mpr (by linarith))
  · have he : Ico 2 N=∅ := Ico_eq_empty_of_le (by omega)
    simp [he]

theorem summable_norm_totientMassCorrection :
    Summable (fun n : ℕ => ‖totientMassCorrection n‖) := by
  classical
  let f (n : ℕ) := ‖totientMassCorrection n‖
  have h1 : f 1=1 := by simp [f,totientMassCorrection_multiplicative.map_one]
  have hmul {m n : ℕ} (h : m.Coprime n) : f (m*n)=f m*f n := by
    simp only [f,totientMassCorrection_multiplicative.map_mul_of_coprime h,norm_mul]
  have hS {p : ℕ} (hp : p.Prime) : Summable (fun k : ℕ => ‖f (p^k)‖) := by
    simpa [f] using totientMassCorrection_local_norm_summable hp
  have hval {p : ℕ} (hp : p.Prime) : (∑' k : ℕ, f (p^k))=1+2/((p:ℝ)*(p-1)) :=
    totientMassCorrection_local_norm_tsum hp
  apply summable_of_sum_range_le (c:=Real.exp 2) (fun _ => norm_nonneg _)
  intro N
  obtain ⟨hSumm,hT⟩ :=
    EulerProduct.summable_and_hasSum_smoothNumbers_prod_primesBelow_tsum h1 hmul hS N
  have hTS : Summable (fun m : N.smoothNumbers => f m) := hT.summable
  let A := (range N).filter (fun n => n≠0)
  let g : {n : ℕ // n∈A} ↪ N.smoothNumbers :=
    ⟨fun n => ⟨n.val,Nat.mem_smoothNumbers_of_lt (Nat.pos_of_ne_zero (mem_filter.mp n.property).2)
          (mem_range.mp (mem_filter.mp n.property).1)⟩,
      fun a b h => Subtype.ext (congrArg (fun n : N.smoothNumbers => n.val) h)⟩
  have hFin : (∑ n ∈ range N, f n) ≤ ∑' m : N.smoothNumbers, f m := by
    calc
      _ = ∑ n ∈ A,f n := by
        symm
        apply sum_subset (filter_subset _ _)
        intro n hn hn'
        have hn0 : n=0 := by by_contra h; exact hn' (mem_filter.mpr ⟨hn,h⟩)
        simp [f,hn0]
      _ = ∑ n : {n : ℕ // n∈A}, f n.val := (sum_subtype A (fun _ => Iff.rfl) f)
      _ = ∑ m ∈ (univ : Finset {n : ℕ // n∈A}).map g,f m := by
        rw [sum_map]
        rfl
      _ ≤ _ := hTS.sum_le_tsum _ (fun _ _ => norm_nonneg _)
  refine hFin.trans ?_
  rw [hT.tsum_eq]
  have hPrime {p : ℕ} (h : p∈N.primesBelow) : p.Prime ∧ p<N := by
    rcases (Nat.mem_primesBelow.mp h) with ⟨h',hp⟩
    exact ⟨hp,h'⟩
  have hP (p : ℕ) (hp : p∈N.primesBelow) : (∑' k : ℕ,f (p^k)) ≤
      Real.exp (2/((p:ℝ)*(p-1))) := by
    rw [hval (hPrime hp).1]
    linarith [Real.add_one_le_exp (2/((p:ℝ)*(p-1)))]
  calc
    _ ≤ ∏ p ∈ N.primesBelow, Real.exp (2/((p:ℝ)*(p-1))) := by
      exact prod_le_prod₀ (fun p _ => tsum_nonneg (fun _ => norm_nonneg _)) hP
    _ = Real.exp (∑ p ∈ N.primesBelow,2/((p:ℝ)*(p-1))) := (Real.exp_sum _ _).symm
    _ ≤ _ := by
      apply Real.exp_le_exp.mpr
      have he : (∑ p ∈ N.primesBelow,2/((p:ℝ)*(p-1))) =
          2*(∑ p ∈ N.primesBelow,1/((p:ℝ)*(p-1))) := by
        simp only [mul_sum,div_eq_mul_inv,one_mul]
      rw [he]
      have hSum : (∑ p ∈ N.primesBelow,1/((p:ℝ)*(p-1))) ≤ 1 := by
        refine (sum_le_sum_of_subset_of_nonneg ?_ (fun n hn _ => ?_)).trans
          (sum_reciprocal_consecutive_le_one N)
        · intro p hp
          exact mem_Ico.mpr ⟨(hPrime hp).1.two_le,(hPrime hp).2⟩
        · have : (2:ℝ) ≤ n := by exact_mod_cast (mem_Ico.mp hn).1
          exact one_div_nonneg.mpr (mul_nonneg (by linarith) (by linarith))
      simpa only [mul_one] using mul_le_mul_of_nonneg_left hSum (show (0:ℝ) ≤ 2 by norm_num)

theorem tsum_totientMassCorrection : (∑' n : ℕ, totientMassCorrection n)=1 := by
  rw [← totientMassCorrection_multiplicative.eulerProduct_tprod summable_norm_totientMassCorrection]
  have he (p : Nat.Primes) : (∑' k : ℕ,totientMassCorrection ((p:ℕ)^k))=1 :=
    totientMassCorrection_local_tsum p.property
  simp_rw [he,tprod_one]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter
open scoped Topology

noncomputable section

private theorem harmonic_eq_sum_reciprocals (N : ℕ) :
    (harmonic N:ℝ)=∑ d ∈ Icc 1 N, (d:ℝ)⁻¹ := by
  induction N with
  | zero => simp [Nat.not_succ_le_zero]
  | succ N ih =>
    rw [harmonic_succ,Rat.cast_add,ih]
    have h : Icc 1 (N+1) = insert (N+1) (Icc 1 N) := by
      ext i
      simp only [mem_Icc,mem_insert]
      omega
    rw [h,sum_insert (by simp)]
    push_cast
    ring

theorem squarefreeTotientMass_sum_eq (N : ℕ) :
    (∑ d ∈ Icc 1 N, squarefreeTotientMass d) =
      ∑ d ∈ Icc 1 N, totientMassCorrection d*(harmonic (N/d):ℝ) := by
  classical
  let A := (Icc 1 N).sigma (fun d => Icc 1 (N/d))
  let B := (Icc 1 N).sigma Nat.divisorsAntidiagonal
  have hPair : (∑ a ∈ A, totientMassCorrection a.1*((a.2:ℝ)⁻¹)) =
      ∑ b ∈ B, totientMassCorrection b.2.1*((b.2.2:ℝ)⁻¹) := by
    refine sum_bij (fun a _ => ⟨a.1*a.2, (a.1,a.2)⟩) ?_ ?_ ?_ ?_
    · intro a ha
      obtain ⟨hd,hm⟩ := mem_sigma.mp ha
      obtain ⟨hd₀,_⟩ := mem_Icc.mp hd
      obtain ⟨hm₀,hm₁⟩ := mem_Icc.mp hm
      have hdm : a.1*a.2 ≤ N := by
        simpa only [Nat.mul_comm] using (Nat.le_div_iff_mul_le (Nat.zero_lt_one.trans_le hd₀)).mp hm₁
      have hp : 0 < a.1*a.2 := Nat.mul_pos (Nat.zero_lt_one.trans_le hd₀) (Nat.zero_lt_one.trans_le hm₀)
      exact mem_sigma.mpr ⟨mem_Icc.mpr ⟨hp,hdm⟩,Nat.mem_divisorsAntidiagonal.mpr ⟨rfl,hp.ne'⟩⟩
    · rintro ⟨d,m⟩ _ ⟨d',m'⟩ _ h
      have hp := congrArg (fun b : Σ _ : ℕ, ℕ × ℕ => b.2) h
      change (d,m) = (d',m') at hp
      cases hp
      rfl
    · rintro ⟨n,⟨d,m⟩⟩ hb
      obtain ⟨hn,hdm⟩ := mem_sigma.mp hb
      obtain ⟨he,_⟩ := Nat.mem_divisorsAntidiagonal.mp hdm
      have hd := Nat.pos_of_ne_zero (Nat.left_ne_zero_of_mem_divisorsAntidiagonal hdm)
      have hm := Nat.pos_of_ne_zero (Nat.right_ne_zero_of_mem_divisorsAntidiagonal hdm)
      have hn₁ := (mem_Icc.mp hn).2
      have hdN : d ≤ N := (Nat.le_mul_of_pos_right _ hm).trans (he.trans_le hn₁)
      have hmN : m ≤ N/d := (Nat.le_div_iff_mul_le hd).mpr (by rwa [mul_comm,he])
      refine ⟨⟨d,m⟩,mem_sigma.mpr ⟨mem_Icc.mpr ⟨hd,hdN⟩,mem_Icc.mpr ⟨hm,hmN⟩⟩,?_⟩
      change (⟨d*m,(d,m)⟩ : Σ _ : ℕ, ℕ × ℕ) = ⟨n,(d,m)⟩
      rw [he]
    · intro a _
      rfl
  have hInner (n : ℕ) : (∑ a ∈ n.divisorsAntidiagonal,
      totientMassCorrection a.1*((a.2:ℝ)⁻¹)) = squarefreeTotientMass n := by
    rw [squarefreeTotientMass_eq_convolution,mul_comm,ArithmeticFunction.mul_apply]
    apply sum_congr rfl
    intro a ha
    rw [natReciprocal_apply]
  calc
    _ = ∑ b ∈ B, totientMassCorrection b.2.1*((b.2.2:ℝ)⁻¹) := by
      simp only [B,sum_sigma,hInner]
    _ = _ := by
      rw [← hPair]
      simp only [A,sum_sigma,harmonic_eq_sum_reciprocals,mul_sum]

private theorem norm_harmonic_floor_div_log_le {x : ℝ} (hx : Real.exp 1 ≤ x)
    {d : ℕ} (hd : d≠0) : ‖(harmonic ⌊x/(d:ℝ)⌋₊:ℝ)/Real.log x‖≤2 := by
  have hlog : 1≤Real.log x := by
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hx0 : 0<x := (Real.exp_pos _).trans_le hx
  have hd1 : (1:ℝ)≤d := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hd
  by_cases h : 1≤x/(d:ℝ)
  · have hs := harmonic_floor_le_one_add_log _ h
    have hlt : x/(d:ℝ)≤x := div_le_self hx0.le hd1
    have hlog' : Real.log (x/(d:ℝ))≤Real.log x := Real.log_le_log (by linarith) hlt
    rw [Real.norm_of_nonneg (div_nonneg (by rw [harmonic_eq_sum_reciprocals]; positivity)
      (by linarith))]
    apply (div_le_iff₀ (show 0<Real.log x by linarith)).mpr
    linarith only [hlog,hs,hlog']
  · have hn : ⌊x/(d:ℝ)⌋₊=0 := Nat.floor_eq_zero.mpr (lt_of_not_ge h)
    norm_num [hn]

private theorem harmonic_floor_div_log_tendsto {d : ℕ} (hd : d≠0) :
    Tendsto (fun x : ℝ => (harmonic ⌊x/(d:ℝ)⌋₊:ℝ)/Real.log x) atTop (𝓝 1) := by
  have hd0 : 0<(d:ℝ) := by exact_mod_cast Nat.pos_of_ne_zero hd
  have ht₁ := (Real.tendsto_log_atTop.const_div_atTop (Real.log (d:ℝ))).const_sub 1
  have ht₂ := (Real.tendsto_log_atTop.const_div_atTop (1:ℝ)).const_add 1
  simp only [sub_zero,add_zero] at ht₁ ht₂
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' ht₁ ht₂
  · filter_upwards [eventually_ge_atTop (d:ℝ),eventually_gt_atTop (1:ℝ)] with x hxd hx
    have hL := Real.log_pos hx
    have hy : 0≤x/(d:ℝ) := div_nonneg (by linarith) hd0.le
    have h := log_le_harmonic_floor _ hy
    rw [Real.log_div (by linarith) hd0.ne'] at h
    rw [← div_self hL.ne',← sub_div]
    exact div_le_div_of_nonneg_right h hL.le
  · filter_upwards [eventually_ge_atTop (d:ℝ),eventually_gt_atTop (1:ℝ)] with x hxd hx
    have hL := Real.log_pos hx
    have hy : 1≤x/(d:ℝ) := (le_div_iff₀ hd0).mpr (by simpa using hxd)
    have h := harmonic_floor_le_one_add_log _ hy
    have hd1 : (1:ℝ)≤d := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hd
    have h' := Real.log_le_log (show 0<x/(d:ℝ) by linarith) (div_le_self (by linarith) hd1)
    have he : (1+Real.log x)/Real.log x = 1+1/Real.log x := by
      rw [add_div,div_self hL.ne',add_comm]
    rw [←he]
    exact div_le_div_of_nonneg_right (by linarith only [h,h']) hL.le

theorem squarefreeTotientMass_sum_div_log_tendsto :
    Tendsto (fun x : ℝ => (∑ d ∈ Icc 1 ⌊x⌋₊, squarefreeTotientMass d)/Real.log x)
      atTop (𝓝 1) := by
  let f (x : ℝ) (d : ℕ) := totientMassCorrection d*((harmonic ⌊x/(d:ℝ)⌋₊:ℝ)/Real.log x)
  have hlim (d : ℕ) : Tendsto (fun x => f x d) atTop (𝓝 (totientMassCorrection d)) := by
    by_cases hd : d=0
    · subst d
      simpa [f] using (tendsto_const_nhds : Tendsto (fun _ : ℝ => (0:ℝ)) atTop (𝓝 0))
    · simpa only [f,mul_one] using (harmonic_floor_div_log_tendsto hd).const_mul
        (totientMassCorrection d)
  have hBound : ∀ᶠ x : ℝ in atTop, ∀ d : ℕ, ‖f x d‖ ≤ 2*‖totientMassCorrection d‖ := by
    filter_upwards [eventually_ge_atTop (Real.exp 1)] with x hx
    intro d
    by_cases hd : d=0
    · simp [f,hd]
    · dsimp only [f]
      rw [norm_mul,mul_comm (2:ℝ)]
      exact mul_le_mul_of_nonneg_left (norm_harmonic_floor_div_log_le hx hd) (norm_nonneg _)
  have ht := tendsto_tsum_of_dominated_convergence
    (summable_norm_totientMassCorrection.mul_left 2) hlim hBound
  rw [tsum_totientMassCorrection] at ht
  refine ht.congr' (Eventually.of_forall (fun x => ?_))
  change (∑' d, f x d)= (∑ d ∈ Icc 1 ⌊x⌋₊, squarefreeTotientMass d)/Real.log x
  rw [squarefreeTotientMass_sum_eq,tsum_eq_sum (s:=Icc 1 ⌊x⌋₊)]
  · simp only [sum_div,f,Nat.floor_div_natCast,mul_div_assoc]
  · intro d hd
    by_cases hd0 : d=0
    · simp [f,hd0]
    · have hN : ⌊x⌋₊<d := by
        simp only [mem_Icc,not_and] at hd
        exact lt_of_not_ge (hd (Nat.one_le_iff_ne_zero.mpr hd0))
      simp [f,Nat.floor_div_natCast,Nat.div_eq_of_lt hN]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Filter Finset
open scoped Topology

noncomputable section

/-- The cumulative squarefree totient mass on the logarithmic scale. -/
def totientLogMass (L b : ℝ) : ℝ :=
  (∑ r ∈ Icc 1 ⌊Real.exp (b*L)⌋₊, squarefreeTotientMass r)/L

theorem squarefreeTotientMass_nonneg (n : ℕ) : 0 ≤ squarefreeTotientMass n := by
  rw [squarefreeTotientMass_apply]
  positivity

theorem squarefreeTotientMass_eq_ite (n : ℕ) :
    squarefreeTotientMass n=if Squarefree n then (n.totient:ℝ)⁻¹ else 0 := by
  rw [squarefreeTotientMass_apply]
  by_cases hn : Squarefree n
  · rw [ite_eq_left hn,← Int.cast_pow,
      ArithmeticFunction.moebius_sq_eq_one_of_squarefree hn,Int.cast_one,one_div]
  · rw [ite_eq_right hn,ArithmeticFunction.moebius_eq_zero_of_not_squarefree hn]
    norm_num


theorem totientLogMass_tendsto {b : ℝ} (hb : 0≤b) :
    Tendsto (fun L : ℝ => totientLogMass L b) atTop (𝓝 b) := by
  rcases hb.eq_or_lt with h|h
  · subst b
    simpa [totientLogMass,squarefreeTotientMass_apply] using (tendsto_inv_atTop_zero : Tendsto (fun L : ℝ => L⁻¹) atTop (𝓝 0))
  · have hExp : Tendsto (fun L : ℝ => Real.exp (b*L)) atTop atTop :=
      Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop' h)
    have ht := (squarefreeTotientMass_sum_div_log_tendsto.comp hExp).const_mul b
    rw [mul_one] at ht
    refine ht.congr' ?_
    filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
    change b*((∑ r ∈ Icc 1 ⌊Real.exp (b*L)⌋₊,
      squarefreeTotientMass r)/Real.log (Real.exp (b*L))) = _
    rw [totientLogMass,Real.log_exp]
    field_simp [h.ne',hL.ne']

theorem totientLogMass_monotone {L : ℝ} (hL : 0≤L) : Monotone (totientLogMass L) := by
  intro a b hab
  unfold totientLogMass
  apply div_le_div_of_nonneg_right _ hL
  exact sum_le_sum_of_subset_of_nonneg (Finset.Icc_subset_Icc le_rfl
    (Nat.floor_mono (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hab hL))))
    (fun r _ _ => squarefreeTotientMass_nonneg r)

theorem log_index_le_iff_mem {L : ℝ} (hL : 0<L)
    {r : ℕ} (hr : 0<r) (b : ℝ) :
    Real.log (r:ℝ)/L≤b ↔ r∈Icc 1 ⌊Real.exp (b*L)⌋₊ := by
  rw [mem_Icc,and_iff_right (show 1 ≤ r from hr),div_le_iff₀ hL,Nat.le_floor_iff (Real.exp_nonneg _)]
  have hr' : (0:ℝ)<r := by exact_mod_cast hr
  rw [Real.log_le_iff_le_exp hr']


end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter MeasureTheory
open scoped Topology Interval

noncomputable section

private def totientAtomSet (L b : ℝ) : Finset ℕ :=
  Icc 1 ⌊Real.exp (b*L)⌋₊

private def totientAtomPos (L : ℝ) (r : ℕ) : ℝ := Real.log (r:ℝ)/L

private def totientAtomWeight (L : ℝ) (r : ℕ) : ℝ := squarefreeTotientMass r/L

private def atomCumulative (L b x : ℝ) : ℝ :=
  ∑ r ∈ totientAtomSet L b,
    (Set.Ici (totientAtomPos L r)).indicator (fun _ : ℝ => totientAtomWeight L r) x

private theorem atom_pos_mem {L b : ℝ} (hL : 0<L) {r : ℕ} (hr : r∈totientAtomSet L b) :
    totientAtomPos L r ∈ Set.Icc 0 b := by
  have hr1 := (mem_Icc.mp hr).1
  exact ⟨div_nonneg (Real.log_nonneg (by exact_mod_cast hr1)) hL.le,
    (log_index_le_iff_mem hL hr1 b).mpr hr⟩

private theorem atomCumulative_eq {L b x : ℝ} (hL : 0<L) (hxb : x≤b) :
    atomCumulative L b x=totientLogMass L x := by
  classical
  have he : (totientAtomSet L b).filter (fun r => totientAtomPos L r≤x)=totientAtomSet L x := by
    ext r
    simp only [mem_filter,totientAtomSet]
    constructor
    · rintro ⟨hr,hx⟩
      exact (log_index_le_iff_mem hL (mem_Icc.mp hr).1 x).mp hx
    · intro hr
      have hx := (log_index_le_iff_mem hL (mem_Icc.mp hr).1 x).mpr hr
      exact ⟨(log_index_le_iff_mem hL (mem_Icc.mp hr).1 b).mp (hx.trans hxb),hx⟩
  unfold atomCumulative totientLogMass
  simp only [totientAtomWeight,Set.indicator,Set.mem_Ici]
  rw [←sum_filter,he]
  simp only [totientAtomSet,←sum_div]

private theorem atomCumulative_measurable (L b : ℝ) :
    Measurable (atomCumulative L b) := by
  unfold atomCumulative
  exact Finset.measurable_fun_sum _ (fun _ _ => measurable_const.indicator measurableSet_Ici)

private theorem intervalIntegrable_indicator_Ici {g : ℝ→ℝ} {b y : ℝ} (hb : 0≤b)
    (hg : Continuous g) :
    IntervalIntegrable ((Set.Ici y).indicator g) volume 0 b := by
  rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hb]
  exact ((intervalIntegrable_iff_integrableOn_Ioc_of_le hb).mp
    (hg.intervalIntegrable 0 b)).indicator measurableSet_Ici

private theorem integral_indicator_Ici {g : ℝ→ℝ} {b y : ℝ} (hy : 0≤y) (hyb : y≤b) :
    (∫ x in (0:ℝ)..b, (Set.Ici y).indicator g x) = ∫ x in y..b, g x := by
  have hae : (Set.Ici y).indicator g =ᵐ[volume] (Set.Ioi y).indicator g := by
    filter_upwards [volume.ae_ne y] with x hx
    have h : y≤x ↔ y<x := ⟨fun h => lt_of_le_of_ne h (Ne.symm hx),le_of_lt⟩
    simp only [Set.indicator,Set.mem_Ici,Set.mem_Ioi,h]
  have hI : Set.Ioi y ∩ Set.Ioc 0 b=Set.Ioc y b := by
    ext x
    simp only [Set.mem_inter_iff,Set.mem_Ioi,Set.mem_Ioc]
    exact ⟨fun ⟨h,_,h'⟩ => ⟨h,h'⟩,fun ⟨h,h'⟩ => ⟨h,hy.trans_lt h,h'⟩⟩
  rw [intervalIntegral.integral_of_le (hy.trans hyb),intervalIntegral.integral_of_le hyb,
    integral_congr_ae (ae_restrict_of_ae hae),MeasureTheory.integral_indicator measurableSet_Ioi,
    Measure.restrict_restrict measurableSet_Ioi,hI]

private theorem totientAtom_integral {b L : ℝ} (hb : 0≤b) (hL : 0<L) {f : ℝ→ℝ}
    (hf : ContDiff ℝ 1 f) :
    (∑ r ∈ totientAtomSet L b, totientAtomWeight L r*f (totientAtomPos L r)) =
      f b*totientLogMass L b - ∫ x in (0:ℝ)..b, deriv f x*atomCumulative L b x := by
  classical
  have hdc : Continuous (deriv f) := hf.continuous_deriv_one
  have hdd : Differentiable ℝ f := hf.differentiable (by norm_num)
  have hI :
      (∫ x in (0:ℝ)..b, deriv f x*atomCumulative L b x) =
        ∑ r ∈ totientAtomSet L b, totientAtomWeight L r*(f b-f (totientAtomPos L r)) := by
    simp only [atomCumulative,mul_sum]
    rw [intervalIntegral.integral_finsetSum]
    · apply sum_congr rfl
      intro r hr
      have hz := atom_pos_mem hL hr
      have he (x : ℝ) : deriv f x*(Set.Ici (totientAtomPos L r)).indicator
          (fun _ : ℝ => totientAtomWeight L r) x =
          totientAtomWeight L r*(Set.Ici (totientAtomPos L r)).indicator (deriv f) x := by
        unfold Set.indicator
        split <;> simp_all [mul_comm]
      simp only [he,intervalIntegral.integral_const_mul,integral_indicator_Ici hz.1 hz.2]
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => (hdd x).hasDerivAt)
        (hdc.intervalIntegrable _ _)]
    · intro r hr
      have he (x : ℝ) : deriv f x*(Set.Ici (totientAtomPos L r)).indicator
          (fun _ : ℝ => totientAtomWeight L r) x =
          totientAtomWeight L r*(Set.Ici (totientAtomPos L r)).indicator (deriv f) x := by
        unfold Set.indicator
        split <;> simp_all [mul_comm]
      simp_rw [he]
      exact (intervalIntegrable_indicator_Ici hb hdc).const_mul _
  rw [hI]
  have hS : (∑ r ∈ totientAtomSet L b, totientAtomWeight L r)=totientLogMass L b := by
    simp only [totientAtomSet,totientAtomWeight,totientLogMass,←sum_div]
  simp only [mul_sub,sum_sub_distrib,←Finset.sum_mul,hS]
  ring

set_option maxHeartbeats 1000000 in
private theorem tendsto_totientAtoms {b : ℝ} (hb : 0≤b) {f : ℝ→ℝ}
    (hf : ContDiff ℝ 1 f) :
    Tendsto (fun L : ℝ => ∑ r ∈ totientAtomSet L b,
      totientAtomWeight L r*f (totientAtomPos L r)) atTop (𝓝 (∫ x in (0:ℝ)..b,f x)) := by
  have hdc : Continuous (deriv f) := hf.continuous_deriv_one
  have hdd : Differentiable ℝ f := hf.differentiable (by norm_num)
  have hFb := totientLogMass_tendsto hb
  have hFbound : ∀ᶠ L : ℝ in atTop, totientLogMass L b ≤ b+1 :=
    (hFb.eventually (eventually_lt_nhds (lt_add_one b))).mono (fun _ h => h.le)
  have hConv : Tendsto (fun L : ℝ => ∫ x in (0:ℝ)..b, deriv f x*atomCumulative L b x)
      atTop (𝓝 (∫ x in (0:ℝ)..b, deriv f x*x)) := by
    refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence
      (fun x : ℝ => (b+1)*‖deriv f x‖) ?_ ?_
      ((continuous_const.mul hdc.norm).intervalIntegrable _ _) ?_
    · exact Eventually.of_forall (fun L =>
        (hdc.measurable.mul (atomCumulative_measurable L b)).aestronglyMeasurable)
    · filter_upwards [eventually_gt_atTop (0:ℝ),hFbound] with L hL hLf
      exact Eventually.of_forall (fun x hx => by
        obtain ⟨hx₀,hxb⟩ := (by simpa only [Set.uIoc_of_le hb] using hx :
          x∈Set.Ioc 0 b)
        have hM0 : 0 ≤ totientLogMass L x := by
          unfold totientLogMass
          exact div_nonneg (sum_nonneg (fun r _ => squarefreeTotientMass_nonneg r)) hL.le
        rw [norm_mul,atomCumulative_eq hL hxb,Real.norm_of_nonneg hM0,mul_comm (b+1)]
        exact mul_le_mul_of_nonneg_left
          (((totientLogMass_monotone hL.le) hxb).trans hLf) (norm_nonneg _))
    · exact Eventually.of_forall (fun x hx => by
        obtain ⟨hx₀,hxb⟩ := (by simpa only [Set.uIoc_of_le hb] using hx :
          x∈Set.Ioc 0 b)
        refine ((totientLogMass_tendsto hx₀.le).const_mul (deriv f x)).congr' ?_
        filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
        rw [atomCumulative_eq hL hxb])
  have hFTC :
      (∫ x in (0:ℝ)..b, f x) + (∫ x in (0:ℝ)..b,deriv f x*x) = f b*b := by
    have hi : IntervalIntegrable (fun x : ℝ => deriv f x*x) volume 0 b :=
      (hdc.mul continuous_id).intervalIntegrable _ _
    rw [←intervalIntegral.integral_add (hf.continuous.intervalIntegrable _ _) hi]
    have hD (x : ℝ) : HasDerivAt (fun t : ℝ => f t*t) (f x+deriv f x*x) x := by
      convert ((hdd x).hasDerivAt.mul (hasDerivAt_id x)) using 1 <;>
        first | rfl | (funext t; rfl) | (simp only [id_eq,mul_one]; ring) | ring
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hD x)
      ((hf.continuous.add (hdc.mul continuous_id)).intervalIntegrable _ _),mul_zero,sub_zero]
  have hL := ((hFb.const_mul (f b)).sub hConv)
  have he : f b*b-(∫ x in (0:ℝ)..b,deriv f x*x) = ∫ x in (0:ℝ)..b,f x :=
    sub_eq_iff_eq_add.mpr hFTC.symm
  rw [he] at hL
  refine hL.congr' ?_
  filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL'
  exact (totientAtom_integral hb hL' hf).symm

/-- Smooth fixed test functions converge against the empirical log-scale mass. -/
theorem tendsto_squarefree_totient_log_test {b : ℝ} (hb : 0≤b)
    (f : ℝ→ℝ) (hf : ContDiff ℝ 1 f) :
    Tendsto (fun L : ℝ => ∑ r∈(Icc 1 ⌊Real.exp (b*L)⌋₊).filter Squarefree,
      L⁻¹*(r.totient:ℝ)⁻¹*f (Real.log (r:ℝ)/L))
      atTop (𝓝 (∫ x in (0:ℝ)..b, f x)) := by
  refine (tendsto_totientAtoms hb hf).congr' (Eventually.of_forall (fun L => ?_))
  simp only [totientAtomSet,totientAtomWeight,totientAtomPos,sum_filter,
    squarefreeTotientMass_eq_ite]
  apply sum_congr rfl
  intro r hr
  split_ifs <;> simp [div_eq_mul_inv,mul_comm]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter MeasureTheory
open scoped Topology Interval Classical
noncomputable section

variable (empiricalLimit : ∀ b : ℝ, 0≤b → ∀ f : ℝ → ℝ, ContDiff ℝ 1 f →
  Tendsto (fun L : ℝ => grahamEmpirical b L f) atTop (𝓝 (∫ z in (0:ℝ)..b,f z)))

include empiricalLimit

set_option maxHeartbeats 1600000 in
/-- The scaled finite Selberg diagonal acquires its piecewise affine profile. -/
theorem barbanVehov_scaled_diagonal_tendsto {t u v : ℝ} (ht : 0≤t) (hu : 0<u)
    (huv : u<v) :
    Tendsto (fun L : ℝ => L*GoldbachPintzTheta.rpowForm (Icc 1 ⌊Real.exp (v*L)⌋₊)
      (GoldbachPintzTheta.barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) (1+t/L))
      atTop (𝓝 ((∫ z in (0:ℝ)..u,t^2*Real.exp (-t*z))+
        ((v-u)^2)⁻¹*(∫ z in u..v,Real.exp (-t*z)*(1+t*(v-z))^2))) := by
  let M := 10*(1+t*v)/(v-u)+t
  let J := M^2+2*M
  let K := 3*M^2
  have hv : 0≤v := hu.le.trans huv.le
  have hM : 0≤M := by dsimp only [M]; positivity [sub_pos.mpr huv]
  have hJ : 0≤J := by dsimp only [J]; positivity
  have hK : 0≤K := by dsimp only [K]; positivity
  refine Metric.tendsto_nhds.2 fun ε hε => ?_
  let η := min (u/2) (min ((v-u)/4) (ε/(32*(1+K))))
  let δ := min (1/2) (ε/(8*(1+J)*(1+v)))
  have hη : 0<η := lt_min (by positivity) (lt_min (by positivity [sub_pos.mpr huv]) (by positivity))
  have hδ : 0<δ := lt_min (by norm_num) (by positivity)
  have hδ₁ : δ≤1 := (min_le_left _ _).trans (by norm_num)
  have hηu : η≤u/2 := min_le_left _ _
  have hηg : η≤(v-u)/4 := (min_le_right _ _).trans (min_le_left _ _)
  have hηSmall : 32*(1+K)*η≤ε := by
    have hh : η≤ε/(32*(1+K)) := (min_le_right _ _).trans (min_le_right _ _)
    have hh' := (le_div_iff₀ (by positivity : 0<32*(1+K))).mp hh
    linarith only [hh']
  have hδSmall : 8*(1+J)*(1+v)*δ≤ε := by
    have hh : δ≤ε/(8*(1+J)*(1+v)) := min_le_right _ _
    have hh' := (le_div_iff₀ (by positivity : 0<8*(1+J)*(1+v))).mp hh
    linarith only [hh']
  have hUV : u+η≤v-η := by linarith only [hηg,huv]
  have hE (b : ℝ) (hb : 0≤b) :
      Tendsto (fun L : ℝ => grahamEmpirical b L (fun _=>1)) atTop (𝓝 b) := by
    have hh := empiricalLimit b hb (fun _=>1) contDiff_const
    simpa only [intervalIntegral.integral_const,sub_zero,smul_eq_mul,mul_one] using hh
  have hSumBound := (Metric.tendsto_nhds.1 (hE v hv)) 1 zero_lt_one
  have hBD := ((hE v hv).sub (hE (v-η) (by linarith only [hUV,hu,hη]))).add
    ((hE (u+η) (by positivity)).sub (hE (u-η) (by linarith only [hηu,hu])))
  have hBD' := (Metric.tendsto_nhds.1 hBD) η hη
  have hProf := (Metric.tendsto_nhds.1 (grahamProfile_empirical_limit empiricalLimit (t:=t) hu.le huv))
    (ε/2) (by positivity)
  filter_upwards [eventually_gt_atTop (0:ℝ),hSumBound,hBD',hProf,
    eventually_diagonal_profile_compare ht hu.le huv hη hδ hδ₁] with L hL hSum hBad hP hC
  have hMass : (∑ r∈grahamIndices v L,grahamDiagonalWeight t L r)≤v+1 := by
    have hh := sum_le_sum (s:=grahamIndices v L) fun r hr => grahamDiagonalWeight_le hL ht hr
    have he : (∑ r∈grahamIndices v L,L⁻¹*(r.totient:ℝ)⁻¹)=grahamEmpirical v L (fun _=>1) := by
      simp only [grahamEmpirical,mul_one]
    rw [Real.dist_eq] at hSum
    have hAccum := (le_abs_self _).trans hSum.le
    linarith only [hh,he,hAccum]
  have hBadMass : (∑ r∈grahamIndices v L \ grahamGoodIndices u v η L,grahamDiagonalWeight t L r)≤4*η := by
    have hh := diagonal_bad_band_le hL ht hη hUV
    rw [Real.dist_eq] at hBad
    have hD := (le_abs_self _).trans hBad.le
    linarith only [hh,hD]
  have hA : δ*J*(v+1)≤ε/8 := by
    have hD := mul_nonneg hδ.le (add_nonneg zero_le_one hv)
    nlinarith only [hδSmall,hD]
  have hB : K*(4*η)≤ε/8 := by nlinarith only [hηSmall,hη]
  have hC' : |L*GoldbachPintzTheta.rpowForm (Icc 1 ⌊Real.exp (v*L)⌋₊)
      (GoldbachPintzTheta.barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) (1+t/L)-
      (∑ r∈grahamIndices v L,grahamDiagonalWeight t L r*(grahamProfile t u v (grahamIndexHeight L r))^2)|≤ε/4 := by
    exact hC.trans ((add_le_add (mul_le_mul_of_nonneg_left hMass (mul_nonneg hδ.le hJ))
      (mul_le_mul_of_nonneg_left hBadMass hK)).trans (by linarith only [hA,hB]))
  rw [Real.dist_eq] at hP ⊢
  exact (abs_sub_le _ _ _).trans_lt (by linarith only [hP,hC',hε])

/-- Exact limiting Laplace transform of the Barbàn–Vehov square energy. -/
theorem barbanVehov_laplace_tendsto {t u v : ℝ} (ht : 0<t) (hu : 0<u) (huv : u<v) :
    Tendsto (fun L : ℝ => GoldbachMollifiedHarmonic.realZetaSeries (1+t/L)*
      GoldbachPintzTheta.rpowForm (Icc 1 ⌊Real.exp (v*L)⌋₊)
        (GoldbachPintzTheta.barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) (1+t/L))
      atTop (𝓝 (1+(Real.exp (-t*u)-Real.exp (-t*v))/(t^2*(v-u)^2))) :=
  graham_series_limit_of_diagonal ht huv
    (barbanVehov_scaled_diagonal_tendsto empiricalLimit ht.le hu huv)

/-- Laplace moments of the actual square of the Barbàn–Vehov divisor sum. -/
theorem barbanVehov_square_laplace_tendsto {t u v : ℝ} (ht : 0<t) (hu : 0<u) (huv : u<v) :
    Tendsto (fun L : ℝ =>
      ∑' n : ℕ, (GoldbachPintzHalasz.realDivisorWeight (Icc 1 ⌊Real.exp (v*L)⌋₊)
        (GoldbachPintzTheta.barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) n)^2/(n:ℝ)^(1+t/L))
      atTop (𝓝 (1+(Real.exp (-t*u)-Real.exp (-t*v))/(t^2*(v-u)^2))) := by
  refine (barbanVehov_laplace_tendsto empiricalLimit ht hu huv).congr' ?_
  filter_upwards [eventually_gt_atTop (0:ℝ)] with L hL
  exact (GoldbachMollifiedHarmonic.real_divisor_square_series _ _
    (lt_add_of_pos_right 1 (div_pos ht hL))).2.symm

omit empiricalLimit in
/-- Germ of the actual Barbàn–Vehov Laplace moment for fixed positive scales. -/
theorem barbanVehov_square_laplace_limit {t u v : ℝ} (ht : 0<t) (hu : 0<u) (huv : u<v) :
    Tendsto (fun L : ℝ =>
      ∑' n : ℕ, (GoldbachPintzHalasz.realDivisorWeight (Icc 1 ⌊Real.exp (v*L)⌋₊)
        (GoldbachPintzTheta.barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) n)^2/(n:ℝ)^(1+t/L))
      atTop (𝓝 (1+(Real.exp (-t*u)-Real.exp (-t*v))/(t^2*(v-u)^2))) := by
  exact barbanVehov_square_laplace_tendsto (fun b hb f hf =>
    tendsto_squarefree_totient_log_test hb f hf) ht hu huv

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Filter Polynomial
open scoped Topology Polynomial

noncomputable section

abbrev LaplaceInterval := Set.Icc (0:ℝ) 1
abbrev Test := C(LaplaceInterval, ℝ)

def asTest (p : ℝ[X]) : Test := p.toContinuousMapOn LaplaceInterval

private theorem asTest_eq_sum (p : ℝ[X]) :
    asTest p=∑ n ∈ p.support, (p.coeff n) • asTest (X^n) := by
  ext x
  simp only [asTest,Polynomial.toContinuousMapOn_apply,ContinuousMap.sum_apply,
    ContinuousMap.smul_apply,smul_eq_mul]
  change p.eval (x:ℝ) = ∑ n ∈ p.support,p.coeff n*(X^n:ℝ[X]).eval (x:ℝ)
  simp only [eval_pow,eval_X]
  rw [eval_eq_sum]
  rfl

/-- Uniform boundedness and convergence on powers on the closed unit interval
give convergence against every continuous test. -/
theorem continuousLinearMap_tendsto_of_moments {ι : Type*} {l : Filter ι}
    (A : ι → Test →L[ℝ] ℝ) (T : Test →L[ℝ] ℝ) {C : ℝ} (hC : 0≤C)
    (hb : ∀ᶠ q in l, ‖A q‖≤C)
    (hM : ∀ n : ℕ, Tendsto (fun q => A q (asTest (X^n))) l (𝓝 (T (asTest (X^n)))))
    (f : Test) : Tendsto (fun q => A q f) l (𝓝 (T f)) := by
  have hPoly (p : ℝ[X]) : Tendsto (fun q => A q (asTest p)) l (𝓝 (T (asTest p))) := by
    rw [asTest_eq_sum]
    simp only [map_sum,map_smul,smul_eq_mul]
    exact tendsto_finsetSum _ (fun n _ => tendsto_const_nhds.mul (hM n))
  apply Metric.tendsto_nhds.2
  intro ε hε
  let M := C+‖T‖+1
  have hM0 : 0<M := by dsimp [M]; positivity
  let δ := ε/(4*M)
  have hδ : 0<δ := div_pos hε (mul_pos (by norm_num) hM0)
  obtain ⟨p,hp⟩ := exists_polynomial_near_continuousMap 0 1 f δ hδ
  let g := asTest p
  have hfg : ‖f-g‖<δ := by
    rw [norm_sub_rev]
    exact hp
  have hpg := (Metric.tendsto_nhds.1 (hPoly p)) (ε/2) (by positivity)
  filter_upwards [hb,hpg] with q hq hq'
  have hA : ‖A q (f-g)‖ ≤ C*δ :=
    ((A q).le_opNorm _).trans <| mul_le_mul hq hfg.le (norm_nonneg _) hC
  have hT : ‖T (g-f)‖ ≤ ‖T‖*δ := by
    rw [norm_sub_rev] at hfg
    exact (T.le_opNorm _).trans (mul_le_mul_of_nonneg_left hfg.le (norm_nonneg _))
  have hg' : ‖A q g-T g‖<ε/2 := by
    rwa [dist_eq_norm] at hq'
  rw [dist_eq_norm]
  have hId : A q f-T f = A q (f-g)+(A q g-T g)+T (g-f) := by simp [map_sub]
  rw [hId]
  have hTriangle := (norm_add_le (A q (f-g)+(A q g-T g)) (T (g-f))).trans
    (add_le_add (norm_add_le (A q (f-g)) (A q g-T g)) (le_refl _))
  have hD : M*δ=ε/4 := by dsimp [δ]; field_simp [hM0.ne']
  have hCD : C*δ+‖T‖*δ≤ε/4 := by
    rw [← hD,← add_mul]
    exact mul_le_mul_of_nonneg_right (by dsimp [M]; linarith) hδ.le
  linarith only [hTriangle,hA,hT,hg',hCD,hε]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Filter MeasureTheory
open scoped Interval Topology

noncomputable section

def testExtend (f : Test) (x : ℝ) : ℝ :=
  f (Set.projIcc 0 1 zero_le_one x)

private theorem testExtend_continuous (f : Test) : Continuous (testExtend f) :=
  f.continuous.comp continuous_projIcc

private theorem testExtend_norm_le (f : Test) (x : ℝ) : ‖testExtend f x‖ ≤ ‖f‖ :=
  f.norm_coe_le_norm _

def rampIntegral (u v : ℝ) (f : Test) : ℝ :=
  ∫ t in u..v, ∫ y in (0:ℝ)..Real.exp (-t), testExtend f y

theorem rampInner_continuous (f : Test) :
    Continuous (fun t : ℝ => ∫ y in (0:ℝ)..Real.exp (-t), testExtend f y) :=
  (intervalIntegral.continuous_primitive (fun a b => (testExtend_continuous f).intervalIntegrable a b) 0).comp
    (Real.continuous_exp.comp continuous_neg)

def unitIntervalOne : LaplaceInterval := ⟨1,zero_le_one,le_rfl⟩

private theorem rampIntegral_norm_le {u v : ℝ} (hu : 0≤u) (huv : u≤v) (f : Test) :
    ‖rampIntegral u v f‖≤‖f‖*(v-u) := by
  unfold rampIntegral
  have h := intervalIntegral.norm_integral_le_of_norm_le_const
    (f:=fun t : ℝ => ∫ y in (0:ℝ)..Real.exp (-t), testExtend f y) (C:=‖f‖)
    (a:=u) (b:=v) ?_
  · simpa only [abs_of_nonneg (sub_nonneg.mpr huv)] using h
  intro t ht
  rw [Set.uIoc_of_le huv] at ht
  have ht₀ : 0≤t := hu.trans ht.1.le
  have hi := intervalIntegral.norm_integral_le_of_norm_le_const
    (f:=testExtend f) (C:=‖f‖) (a:=0) (b:=Real.exp (-t)) (fun x _ => testExtend_norm_le f x)
  have hE : Real.exp (-t)≤1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr ht₀)
  rw [sub_zero,abs_of_nonneg (Real.exp_nonneg _)] at hi
  exact hi.trans (mul_le_of_le_one_right (norm_nonneg _) hE)

private def rampLinear (u v : ℝ) : Test →ₗ[ℝ] ℝ where
  toFun f := f unitIntervalOne+((v-u)⁻¹)^2*rampIntegral u v f
  map_add' f g := by
    have hi (f g : Test) (t : ℝ) : (∫ y in (0:ℝ)..Real.exp (-t),testExtend (f+g) y) =
        (∫ y in (0:ℝ)..Real.exp (-t),testExtend f y)+(∫ y in (0:ℝ)..Real.exp (-t),testExtend g y) := by
      exact intervalIntegral.integral_add
        ((testExtend_continuous f).intervalIntegrable _ _) ((testExtend_continuous g).intervalIntegrable _ _)
    simp only [rampIntegral,hi,ContinuousMap.add_apply]
    rw [intervalIntegral.integral_add ((rampInner_continuous f).intervalIntegrable _ _)
      ((rampInner_continuous g).intervalIntegrable _ _)]
    ring
  map_smul' c f := by
    simp only [rampIntegral,testExtend,ContinuousMap.smul_apply,smul_eq_mul,
      intervalIntegral.integral_const_mul,RingHom.id_apply]
    ring

def rampFunctional {u v : ℝ} (hu : 0≤u) (huv : u<v) : Test →L[ℝ] ℝ :=
  (rampLinear u v).mkContinuous (1+(v-u)⁻¹) <| by
    intro f
    change ‖f unitIntervalOne+((v-u)⁻¹)^2*rampIntegral u v f‖ ≤ (1+(v-u)⁻¹)*‖f‖
    apply (norm_add_le _ _).trans
    rw [norm_mul,Real.norm_of_nonneg (by positivity : (0:ℝ)≤((v-u)⁻¹)^2)]
    refine (add_le_add (f.norm_coe_le_norm _) (mul_le_mul_of_nonneg_left
      (rampIntegral_norm_le hu huv.le f) (by positivity))).trans_eq ?_
    have h : v-u≠0 := (sub_pos.mpr huv).ne'
    field_simp [h] <;> ring

theorem rampFunctional_apply {u v : ℝ} (hu : 0≤u) (huv : u<v) (f : Test) :
    rampFunctional hu huv f=f unitIntervalOne+((v-u)⁻¹)^2*rampIntegral u v f := rfl

private theorem integral_exp_neg_mul {u v c : ℝ} (hc : 0<c) :
    (∫ t in u..v, Real.exp (-c*t))=(Real.exp (-c*u)-Real.exp (-c*v))/c := by
  have hd (x : ℝ) : HasDerivAt (fun t : ℝ => -Real.exp (-c*t)/c) (Real.exp (-c*x)) x := by
    have h := (((hasDerivAt_id x).const_mul (-c)).exp.neg).div_const c
    convert h using 1
    · funext t
      simp only [Pi.neg_apply,id_eq]
    · simp only [id_eq,mul_one]
      field_simp [hc.ne']
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hd x)
    ((Real.continuous_exp.comp (continuous_const.mul continuous_id)).intervalIntegrable _ _)]
  ring

theorem rampFunctional_moment {u v : ℝ} (hu : 0≤u) (huv : u<v) (n : ℕ) :
    rampFunctional hu huv (asTest (Polynomial.X^n))=
      1+(Real.exp (-((n:ℝ)+1)*u)-Real.exp (-((n:ℝ)+1)*v))/(((n:ℝ)+1)^2*(v-u)^2) := by
  have hn : (0:ℝ)<(n:ℝ)+1 := by positivity
  have h1 : asTest (Polynomial.X^n) unitIntervalOne=1 := by
    simp [asTest,unitIntervalOne]
  rw [rampFunctional_apply,h1,rampIntegral]
  have hI (t : ℝ) (ht : t∈Set.uIcc u v) :
      (∫ y in (0:ℝ)..Real.exp (-t),testExtend (asTest (Polynomial.X^n)) y) =
        Real.exp (-((n:ℝ)+1)*t)/((n:ℝ)+1) := by
    rw [Set.uIcc_of_le huv.le] at ht
    have hE : Real.exp (-t)≤1 := Real.exp_le_one_iff.mpr (by linarith only [hu,ht.1])
    have he : (∫ y in (0:ℝ)..Real.exp (-t),testExtend (asTest (Polynomial.X^n)) y) =
        ∫ y in (0:ℝ)..Real.exp (-t),y^n := by
      apply intervalIntegral.integral_congr
      intro y hy
      rw [Set.uIcc_of_le (Real.exp_nonneg _)] at hy
      have hy' : y∈LaplaceInterval := ⟨hy.1,hy.2.trans hE⟩
      simp [testExtend,Set.projIcc_of_mem _ hy',asTest]
    rw [he,integral_pow,zero_pow (Nat.succ_ne_zero _),sub_zero,←Real.exp_nat_mul]
    push_cast
    congr 2
    ring
  rw [intervalIntegral.integral_congr hI,intervalIntegral.integral_div,
    integral_exp_neg_mul hn]
  have h : v-u≠0 := (sub_pos.mpr huv).ne'
  field_simp [h,hn.ne'] <;> ring

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Filter
open scoped Topology

noncomputable section

/-- The linear operation of testing summable discrete weights on an interval. -/
def atomicFunctional {ι : Type*} (w : ι→ℝ) (hw : Summable w) (hn : ∀ i, 0≤w i)
    (point : ι→LaplaceInterval) : Test →L[ℝ] ℝ := by
  have hs (f : Test) : Summable (fun i => w i*f (point i)) := by
    refine (hw.mul_right ‖f‖).of_norm_bounded (fun i => ?_)
    rw [norm_mul,Real.norm_of_nonneg (hn i)]
    exact mul_le_mul_of_nonneg_left (f.norm_coe_le_norm _) (hn i)
  let A : Test →ₗ[ℝ] ℝ :=
    { toFun := fun f => ∑' i, w i*f (point i)
      map_add' := by
        intro f g
        simp only [ContinuousMap.add_apply,mul_add,←(hs f).tsum_add (hs g)]
      map_smul' := by
        intro c f
        simp only [ContinuousMap.smul_apply,smul_eq_mul,RingHom.id_apply,←tsum_mul_left]
        congr 1
        funext i
        ring }
  refine A.mkContinuous (∑' i, w i) ?_
  intro f
  change ‖∑' i, w i*f (point i)‖≤_
  refine (norm_tsum_le_tsum_norm ((hs f).norm)).trans ?_
  rw [←tsum_mul_right]
  have hBound (i : ι) : ‖w i*f (point i)‖≤w i*‖f‖ := by
    rw [norm_mul,Real.norm_of_nonneg (hn i)]
    exact mul_le_mul_of_nonneg_left (f.norm_coe_le_norm _) (hn i)
  exact ((hs f).norm).tsum_le_tsum hBound (hw.mul_right _)

theorem atomicFunctional_apply {ι : Type*} (w : ι→ℝ) (hw : Summable w) (hn : ∀ i,0≤w i)
    (point : ι→LaplaceInterval) (f : Test) :
    atomicFunctional w hw hn point f=∑' i,w i*f (point i) := rfl

theorem atomicFunctional_norm_le {ι : Type*} (w : ι→ℝ) (hw : Summable w) (hn : ∀ i,0≤w i)
    (point : ι→LaplaceInterval) :
    ‖atomicFunctional w hw hn point‖≤∑' i,w i := by
  apply ContinuousLinearMap.opNorm_le_bound _ (tsum_nonneg hn)
  intro f
  rw [atomicFunctional_apply]
  have hNorm : Summable (fun i => ‖w i*f (point i)‖) := by
    refine (hw.mul_right ‖f‖).of_norm_bounded (fun i => ?_)
    rw [norm_norm,norm_mul,Real.norm_of_nonneg (hn i)]
    exact mul_le_mul_of_nonneg_left (f.norm_coe_le_norm _) (hn i)
  refine (norm_tsum_le_tsum_norm hNorm).trans ?_
  rw [←tsum_mul_right]
  exact hNorm.tsum_le_tsum (fun i => by
    rw [norm_mul,Real.norm_of_nonneg (hn i)]
    exact mul_le_mul_of_nonneg_left (f.norm_coe_le_norm _) (hn i)) (hw.mul_right _)

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter Polynomial GoldbachPintzTheta GoldbachPintzHalasz GoldbachMollifiedHarmonic
open scoped Topology Polynomial

noncomputable section

def grahamSquare (u v L : ℝ) (n : ℕ) : ℝ :=
  (realDivisorWeight (Icc 1 ⌊Real.exp (v*L)⌋₊)
    (barbanVehov (Real.exp (u*L)) (Real.exp (v*L))) n)^2

def tiltWeight (u v L : ℝ) (n : ℕ) : ℝ :=
  grahamSquare u v (max L 1) n/(n:ℝ)^(1+1/max L 1)

def tiltPoint (L : ℝ) (n : ℕ) : LaplaceInterval :=
  ⟨Real.exp (-Real.log (n:ℝ)/max L 1),Real.exp_nonneg _,Real.exp_le_one_iff.mpr (by
    have hL : (0:ℝ) ≤ max L 1 := zero_le_one.trans (le_max_right _ _)
    refine div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr ?_) hL
    by_cases hn : n=0
    · simp [hn]
    · exact Real.log_nonneg (by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hn))⟩

theorem tiltWeight_summable (u v L : ℝ) : Summable (tiltWeight u v L) := by
  have hL : 0 < max L 1 := zero_lt_one.trans_le (le_max_right _ _)
  exact (real_divisor_square_series _ _ (lt_add_of_pos_right 1 (one_div_pos.mpr hL))).1

def tiltFunctional (u v L : ℝ) : Test →L[ℝ] ℝ :=
  atomicFunctional (tiltWeight u v L) (tiltWeight_summable u v L)
    (fun n => div_nonneg (sq_nonneg _) (Real.rpow_nonneg (Nat.cast_nonneg _) _))
    (tiltPoint L)

theorem tiltFunctional_apply (u v L : ℝ) (f : Test) :
    tiltFunctional u v L f=∑' n,tiltWeight u v L n*f (tiltPoint L n) := rfl

private theorem tiltWeight_zero (u v L : ℝ) : tiltWeight u v L 0=0 := by
  have hL : 0 < max L 1 := zero_lt_one.trans_le (le_max_right _ _)
  have h : (1:ℝ)+1/(max L 1)≠0 := by positivity
  simp only [tiltWeight,Nat.cast_zero,Real.zero_rpow h,div_zero]

private theorem tiltFunctional_moment {u v L : ℝ} (hL : 1≤L) (j : ℕ) :
    tiltFunctional u v L (asTest (X^j)) =
      ∑' n,grahamSquare u v L n/(n:ℝ)^(1+((j:ℝ)+1)/L) := by
  rw [tiltFunctional_apply]
  apply tsum_congr
  intro n
  by_cases h0 : n=0
  · subst n
    have hLp : 0<L := zero_lt_one.trans_le hL
    have h : (1:ℝ)+((j:ℝ)+1)/L≠0 := by positivity
    simp only [tiltWeight_zero,zero_mul,Nat.cast_zero,Real.zero_rpow h,div_zero]
  · have hn : (0:ℝ)<n := by exact_mod_cast Nat.pos_of_ne_zero h0
    have hY : asTest (X^j) (tiltPoint L n)=(Real.exp (-Real.log (n:ℝ)/L))^j := by
      simp [asTest,tiltPoint,max_eq_left hL]
    rw [hY,tiltWeight,max_eq_left hL,←Real.exp_nat_mul,Real.rpow_def_of_pos hn,
      Real.rpow_def_of_pos hn]
    have he : (j:ℝ)*(-Real.log (n:ℝ)/L) = -(Real.log (n:ℝ)*((j:ℝ)/L)) := by ring
    rw [he,Real.exp_neg,←div_eq_mul_inv,div_div,←Real.exp_add]
    congr 2
    ring

theorem tiltFunctional_tendsto {u v : ℝ} (hu : 0<u) (huv : u<v) (f : Test) :
    Tendsto (fun L : ℝ => tiltFunctional u v L f) atTop (𝓝 (rampFunctional hu.le huv f)) := by
  have hT : Tendsto (fun L : ℝ => ∑' n,tiltWeight u v L n) atTop
      (𝓝 (1+(Real.exp (-u)-Real.exp (-v))/(v-u)^2)) := by
    have h := barbanVehov_square_laplace_limit (u:=u) (v:=v) (t:=1) (by norm_num) hu huv
    have hh : (1:ℝ)+(Real.exp (-(1:ℝ)*u)-Real.exp (-(1:ℝ)*v))/((1:ℝ)^2*(v-u)^2) =
        1+(Real.exp (-u)-Real.exp (-v))/(v-u)^2 := by norm_num
    rw [hh] at h
    refine h.congr' ?_
    filter_upwards [eventually_ge_atTop (1:ℝ)] with L hL
    simp only [tiltWeight,grahamSquare,max_eq_left hL]
  let C := (1+(Real.exp (-u)-Real.exp (-v))/(v-u)^2)+1
  have hC : 0≤C := by
    dsimp [C]
    have h : Real.exp (-v)≤Real.exp (-u) := Real.exp_le_exp.mpr (neg_le_neg huv.le)
    positivity
  apply continuousLinearMap_tendsto_of_moments (tiltFunctional u v) (rampFunctional hu.le huv) hC
  · have hl : ∀ᶠ L : ℝ in atTop, (∑' n,tiltWeight u v L n)<C :=
      hT.eventually (eventually_lt_nhds (lt_add_one _))
    filter_upwards [hl] with L hL
    exact (atomicFunctional_norm_le _ _ _ _).trans hL.le
  · intro j
    rw [rampFunctional_moment]
    have ht : 0<((j:ℝ)+1) := by positivity
    refine (barbanVehov_square_laplace_limit ht hu huv).congr' ?_
    filter_upwards [eventually_ge_atTop (1:ℝ)] with L hL
    exact (tiltFunctional_moment hL j).symm

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open MeasureTheory
open scoped Interval

noncomputable section

def rampCutReal (l r y : ℝ) : ℝ :=
  min 1 (max 0 ((y-l)/(r-l)))/(max y l)

theorem rampCutReal_continuous {l r : ℝ} (hl : 0<l) : Continuous (rampCutReal l r) := by
  unfold rampCutReal
  have h : Continuous (fun y : ℝ => (y-l)/(r-l)) :=
    (continuous_id.sub continuous_const).div_const _
  exact (continuous_const.min (continuous_const.max h)).div
    (continuous_id.max continuous_const) (fun y => (hl.trans_le (le_max_right y l)).ne')

theorem rampCutReal_nonneg {l r : ℝ} (hl : 0<l) (y : ℝ) : 0≤rampCutReal l r y := by
  unfold rampCutReal
  exact div_nonneg (le_min zero_le_one (le_max_left _ _)) (hl.le.trans (le_max_right _ _))

theorem rampCutReal_eq_zero {l r y : ℝ} (hlr : l<r) (hy : y≤l) :
    rampCutReal l r y=0 := by
  unfold rampCutReal
  rw [max_eq_left (div_nonpos_of_nonpos_of_nonneg (sub_nonpos.mpr hy) (sub_nonneg.mpr hlr.le)),
    min_eq_right zero_le_one,zero_div]

theorem rampCutReal_eq_inv {l r y : ℝ} (hlr : l<r) (hy : r≤y) :
    rampCutReal l r y=y⁻¹ := by
  unfold rampCutReal
  have h : 1≤(y-l)/(r-l) := (le_div_iff₀ (sub_pos.mpr hlr)).mpr (by linarith only [hy])
  rw [min_eq_left (h.trans (le_max_right _ _)), max_eq_left (hlr.le.trans hy),one_div]

def rampCut {l r : ℝ} (hl : 0<l) : Test :=
  ⟨rampCutReal l r ∘ Subtype.val,(rampCutReal_continuous hl).comp continuous_subtype_val⟩


theorem rampFunctional_cut_le {u v x η : ℝ} (hu : 0≤u) (huv : u<v)
    (hvx : v≤x) (hη : 0<η) :
    rampFunctional hu huv (rampCut (r:=Real.exp (-x)) (Real.exp_pos (-(x+η)))) ≤
      1+(2*(x+η)-u-v)/(2*(v-u)) := by
  let l := Real.exp (-(x+η))
  let r := Real.exp (-x)
  have hl : 0<l := Real.exp_pos _
  have hlr : l<r := Real.exp_lt_exp.mpr (by linarith only [hη])
  have hr : r≤1 := Real.exp_le_one_iff.mpr (by linarith only [hu,huv,hvx])
  let f : Test := rampCut (r:=r) hl
  have hF : f unitIntervalOne=1 := by
    change rampCutReal l r 1=1
    rw [rampCutReal_eq_inv hlr hr,inv_one]
  change rampFunctional hu huv f≤_
  rw [rampFunctional_apply]
  change f unitIntervalOne+((v-u)⁻¹)^2*rampIntegral u v f≤_
  rw [hF]
  have hIn {t : ℝ} (ht : t∈Set.Icc u v) :
      (∫ y in (0:ℝ)..Real.exp (-t),testExtend f y) ≤ x+η-t := by
    have ht0 := hu.trans ht.1
    have hE : Real.exp (-t)≤1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr ht0)
    have heL : l≤Real.exp (-t) := Real.exp_le_exp.mpr (by linarith only [ht.2,hvx,hη])
    have hFn : (∫ y in (0:ℝ)..Real.exp (-t),testExtend f y) =
        ∫ y in (0:ℝ)..Real.exp (-t),rampCutReal l r y := by
      apply intervalIntegral.integral_congr
      intro y hy
      rw [Set.uIcc_of_le (Real.exp_nonneg _)] at hy
      rw [testExtend,Set.projIcc_of_mem _ ⟨hy.1,hy.2.trans hE⟩]
      rfl
    rw [hFn]
    have hZero : (∫ y in (0:ℝ)..l,rampCutReal l r y)=0 := by
      refine (intervalIntegral.integral_congr (g:=fun _=>0) ?_).trans (by simp)
      intro y hy
      rw [Set.uIcc_of_le hl.le] at hy
      exact rampCutReal_eq_zero hlr hy.2
    rw [←intervalIntegral.integral_add_adjacent_intervals
      ((rampCutReal_continuous hl).intervalIntegrable 0 l)
      ((rampCutReal_continuous hl).intervalIntegrable l (Real.exp (-t))),hZero,zero_add]
    have hInv : IntervalIntegrable (fun y : ℝ => y⁻¹) volume l (Real.exp (-t)) := by
      apply ContinuousOn.intervalIntegrable
      exact continuous_id.continuousOn.inv₀ (fun s hs => by
        rw [Set.uIcc_of_le heL] at hs
        exact (hl.trans_le hs.1).ne')
    calc
      _ ≤ ∫ y in l..Real.exp (-t), y⁻¹ :=
        intervalIntegral.integral_mono_on heL
          ((rampCutReal_continuous hl).intervalIntegrable _ _) hInv (fun y hy => by
            unfold rampCutReal
            rw [max_eq_left hy.1,←one_div y]
            exact div_le_div_of_nonneg_right (min_le_left _ _) (hl.le.trans hy.1))
      _ = Real.log (Real.exp (-t))-Real.log l := by
        apply intervalIntegral.integral_eq_sub_of_hasDerivAt _ hInv
        intro y hy
        rw [Set.uIcc_of_le heL] at hy
        exact Real.hasDerivAt_log ((hl.trans_le hy.1).ne')
      _ = _ := by rw [Real.log_exp,show Real.log l=-(x+η) from Real.log_exp _]; ring
  have hBound : rampIntegral u v f≤ ∫ t in u..v, x+η-t := by
    unfold rampIntegral
    exact intervalIntegral.integral_mono_on huv.le
      ((rampInner_continuous f).intervalIntegrable _ _) (by
        apply Continuous.intervalIntegrable
        fun_prop) (fun _ ht => hIn ht)
  have hR : (∫ t in u..v, x+η-t)=(v-u)*(2*(x+η)-u-v)/2 := by
    have h₁ : IntervalIntegrable (fun _ : ℝ => x+η) volume u v := intervalIntegrable_const
    have h₂ : IntervalIntegrable (fun t : ℝ => t) volume u v := continuous_id.intervalIntegrable _ _
    have hI : (∫ t in u..v,t)=(v^2-u^2)/2 := by
      convert (integral_pow (a:=u) (b:=v) (n:=1)) using 1 <;> norm_num
    rw [intervalIntegral.integral_sub h₁ h₂,intervalIntegral.integral_const,hI]
    simp only [smul_eq_mul]
    ring
  rw [hR] at hBound
  refine add_le_add (le_refl 1) ((mul_le_mul_of_nonneg_left hBound (by positivity)).trans_eq ?_)
  field_simp [(sub_pos.mpr huv).ne'] <;> ring

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter GoldbachPintzTheta GoldbachPintzHalasz
open scoped Topology

noncomputable section

private theorem cutoff_psi_one {u v L : ℝ} (hu : 0≤u) (huv : u<v) (hL : 0<L) :
    grahamSquare u v L 1=1 := by
  have hU : 1≤Real.exp (u*L) := Real.one_le_exp (mul_nonneg hu hL.le)
  have hUV : Real.exp (u*L)<Real.exp (v*L) := Real.exp_lt_exp.mpr (mul_lt_mul_of_pos_right huv hL)
  unfold grahamSquare realDivisorWeight
  rw [sum_eq_single 1]
  · simp only [dvd_refl,ite_true,barbanVehov_one hU hUV,one_pow]
  · intro d _ hd
    simp [show ¬d∣1 from fun hh=>hd (Nat.dvd_one.mp hh)]
  · intro h
    exact (h (mem_Icc.mpr ⟨le_rfl,Nat.le_floor (by exact_mod_cast hU.trans hUV.le)⟩)).elim


private theorem tilt_slice_term {u v L : ℝ} (hL : 1≤L)
    {n : ℕ} (hn : 0<n) :
    tiltWeight u v L n*((tiltPoint L n:ℝ)⁻¹)=grahamSquare u v L n/(n:ℝ) := by
  have hnr : (0:ℝ)<n := by exact_mod_cast hn
  have hY : (tiltPoint L n:ℝ)=Real.exp (-(Real.log (n:ℝ)/L)) := by
    simp [tiltPoint,max_eq_left hL,neg_div]
  have hRpow : (n:ℝ)^(1+1/L)=(n:ℝ)*Real.exp (Real.log (n:ℝ)/L) := by
    rw [Real.rpow_def_of_pos hnr,show Real.log (n:ℝ)*(1+1/L)=
      Real.log (n:ℝ)+Real.log (n:ℝ)/L by ring,Real.exp_add,Real.exp_log hnr]
  rw [tiltWeight,max_eq_left hL,hY,Real.exp_neg,inv_inv,hRpow]
  field_simp [hnr.ne',Real.exp_ne_zero]

/-- The Graham harmonic sum above the atom at one has its sharp ramp upper bound. -/
theorem eventually_graham_harmonic_nonunit_le {u v x ε : ℝ} (hu : 0<u)
    (huv : u<v) (hvx : v≤x) (hε : 0<ε) :
    ∀ᶠ L : ℝ in atTop,
      (∑ n∈Icc 2 ⌊Real.exp (x*L)⌋₊,grahamSquare u v L n/(n:ℝ)) ≤
        (2*x-u-v)/(2*(v-u))+ε := by
  classical
  let η := (v-u)*ε/2
  have hη : 0<η := by dsimp [η]; positivity
  let l := Real.exp (-(x+η))
  let r := Real.exp (-x)
  have hl : 0<l := Real.exp_pos _
  have hlr : l<r := Real.exp_lt_exp.mpr (by linarith only [hη])
  let f : Test := rampCut (r:=r) hl
  have hF : rampFunctional hu.le huv f ≤ 1+(2*(x+η)-u-v)/(2*(v-u)) :=
    rampFunctional_cut_le hu.le huv hvx hη
  have ht := tiltFunctional_tendsto hu huv f
  have ht' : ∀ᶠ L : ℝ in atTop, tiltFunctional u v L f ≤ rampFunctional hu.le huv f+ε/2 :=
    (ht.eventually (eventually_lt_nhds (lt_add_of_pos_right _ (by positivity)))).mono (fun _ h => h.le)
  filter_upwards [eventually_ge_atTop (1:ℝ),ht'] with L hL hLim
  have hL₀ := zero_lt_one.trans_le hL
  let S := Icc 2 ⌊Real.exp (x*L)⌋₊
  let A (n : ℕ) := tiltWeight u v L n*f (tiltPoint L n)
  have hNonneg (n : ℕ) : 0≤A n :=
    mul_nonneg (by unfold tiltWeight grahamSquare; positivity) (rampCutReal_nonneg hl _)
  have hs : Summable A := by
    refine ((tiltWeight_summable u v L).mul_right ‖f‖).of_norm_bounded (fun n => ?_)
    rw [Real.norm_of_nonneg (hNonneg n)]
    exact mul_le_mul_of_nonneg_left (Real.le_norm_self _ |>.trans (f.norm_coe_le_norm _))
      (by unfold tiltWeight grahamSquare; positivity)
  have hx₀ : 0≤x := hu.le.trans (huv.le.trans hvx)
  have hOne : ¬1∈S := by simp [S]
  have hUpper (n : ℕ) (hn : n=1 ∨ n∈S) :
      A n=grahamSquare u v L n/(n:ℝ) := by
    have hr' : (0:ℝ)<n := by
      rcases hn with rfl|hn
      · norm_num
      · exact_mod_cast (show 0<n from (by norm_num : 0<2).trans_le (mem_Icc.mp hn).1)
    have hnl : (n:ℝ)≤Real.exp (x*L) := by
      rcases hn with rfl|hn
      · simpa using Real.one_le_exp (mul_nonneg hx₀ hL₀.le)
      · exact (Nat.cast_le.mpr (mem_Icc.mp hn).2).trans (Nat.floor_le (Real.exp_nonneg _))
    have hLog : Real.log (n:ℝ)≤x*L := by
      rw [←Real.log_exp (x*L)]
      exact Real.log_le_log hr' hnl
    have hPt : r≤(tiltPoint L n:ℝ) := by
      dsimp only [r,tiltPoint]
      rw [max_eq_left hL]
      exact Real.exp_le_exp.mpr
        ((le_div_iff₀ hL₀).mpr (by linarith only [hLog,show -x*L=-(x*L) by ring]))
    have hFn : f (tiltPoint L n)=(tiltPoint L n:ℝ)⁻¹ :=
      rampCutReal_eq_inv hlr hPt
    dsimp only [A]
    rw [hFn]
    exact tilt_slice_term hL (by exact_mod_cast hr')
  have hAOne : A 1=1 := by rw [hUpper 1 (Or.inl rfl),cutoff_psi_one hu.le huv hL₀]; norm_num
  have hPartial := hs.sum_le_tsum (insert 1 S) (fun n _ => hNonneg n)
  rw [sum_insert hOne,hAOne] at hPartial
  have hS : (∑ n∈S,A n)=∑ n∈S,grahamSquare u v L n/(n:ℝ) :=
    sum_congr rfl (fun n hn => hUpper n (Or.inr hn))
  rw [hS,← tiltFunctional_apply] at hPartial
  change (∑ n∈S,grahamSquare u v L n/(n:ℝ))≤_
  have hEq : (2*(x+η)-u-v)/(2*(v-u))=(2*x-u-v)/(2*(v-u))+ε/2 := by
    dsimp [η]
    field_simp [(sub_pos.mpr huv).ne']
    ring
  linarith only [hPartial,hLim,hF,hEq]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter GoldbachPintzHalasz GoldbachPintzTheta
open scoped Topology
noncomputable section

private theorem cd_grahamSquare_one {u v L : ℝ} (hu : 0 ≤ u) (huv : u < v) (hL : 0 < L) :
    grahamSquare u v L 1=1 := by
  have hU : 1≤Real.exp (u*L) := Real.one_le_exp (mul_nonneg hu hL.le)
  have hUV : Real.exp (u*L)<Real.exp (v*L) := Real.exp_lt_exp.mpr (mul_lt_mul_of_pos_right huv hL)
  unfold grahamSquare realDivisorWeight
  rw [sum_eq_single 1]
  · simp only [dvd_refl,ite_true,barbanVehov_one hU hUV,one_pow]
  · intro d _ hd
    simp [show ¬d∣1 from fun hh=>hd (Nat.dvd_one.mp hh)]
  · intro h
    exact (h (mem_Icc.mpr ⟨le_rfl,Nat.le_floor (by exact_mod_cast hU.trans hUV.le)⟩)).elim

set_option maxHeartbeats 900000 in
/-- The sharp Graham energy survives any fixed finite moving cutoff mesh
whose compact difference suppresses its unit term. -/
theorem eventually_compact_graham_energy_on_mesh {ι : Type*} (E : Finset ι)
    (η : ι→ℝ) (hη : ∀ i∈E,0 ≤ η i)
    {u₀ c₂ r ε : ℝ} (hu : 0 < u₀) (hc : 0 < c₂) (hr : c₂ ≤ r) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ i∈E,
      ∀ w : ℕ→ℝ, (∀ n, w n ≤ 1) → w 1 ≤ 2/Real.exp ((u₀+η i)*L) →
        (∑ n∈Icc 1 ⌊Real.exp ((u₀+η i+r)*L)⌋₊,
          grahamSquare (u₀+η i) (u₀+η i+c₂) L n*w n/(n:ℝ)) ≤ (2*r-c₂)/(2*c₂)+ε := by
  have hSharp : ∀ᶠ L : ℝ in atTop, ∀ i∈E,
      (∑ n∈Icc 2 ⌊Real.exp ((u₀+η i+r)*L)⌋₊,grahamSquare (u₀+η i) (u₀+η i+c₂) L n/(n:ℝ)) ≤
        (2*r-c₂)/(2*c₂)+ε/2 := by
    apply (eventually_all_finset E).mpr
    intro i hi
    have h := eventually_graham_harmonic_nonunit_le
      (x:=u₀+η i+r) (ε:=ε/2) (add_pos_of_pos_of_nonneg hu (hη i hi))
      (lt_add_of_pos_right (u₀+η i) hc) (add_le_add le_rfl hr) (by positivity)
    have he : (2*(u₀+η i+r)-(u₀+η i)-(u₀+η i+c₂))/
          (2*((u₀+η i+c₂)-(u₀+η i)))=(2*r-c₂)/(2*c₂) := by
      rw [show (u₀+η i+c₂)-(u₀+η i)=c₂ by ring]
      congr 1
      ring
    simpa only [he] using h
  let A := max 1 (Real.log (4/ε)/u₀)
  filter_upwards [eventually_ge_atTop A,hSharp] with L hL hB i hi w hw hU
  have hL₁ : 1≤L := (le_max_left _ _).trans hL
  have hL₀ := zero_lt_one.trans_le hL₁
  let u := u₀+η i
  let Y := Real.exp ((u+r)*L)
  have hu₀ : 0 < u := add_pos_of_pos_of_nonneg hu (hη i hi)
  have hu' : Real.log (4/ε) ≤ u*L := by
    have hh : Real.log (4/ε)/u₀≤L := (le_max_right _ _).trans hL
    have hh' := (div_le_iff₀ hu).mp hh
    have hU₀ : u₀≤u := le_add_of_nonneg_right (hη i hi)
    have he := mul_le_mul_of_nonneg_right hU₀ hL₀.le
    linarith only [hh',he]
  have hexp : 4/ε ≤ Real.exp (u*L) := (Real.log_le_iff_le_exp (by positivity)).mp hu'
  have hUnit : 2/Real.exp (u*L) ≤ ε/2 := by
    apply (div_le_iff₀ (Real.exp_pos _)).mpr
    have hh := (div_le_iff₀ hε).mp hexp
    linarith only [hh]
  have hY : 1 ≤ Y := Real.one_le_exp (mul_nonneg (add_nonneg hu₀.le (hc.le.trans hr)) hL₀.le)
  have hYnat : 1≤⌊Y⌋₊ := Nat.le_floor (by simpa using hY : ((1:ℕ):ℝ)≤Y)
  rw [Finset.Icc_eq_cons_Ioc hYnat,Finset.sum_cons]
  have hSlice : Finset.Ioc 1 ⌊Y⌋₊ = Finset.Icc 2 ⌊Y⌋₊ := by
    ext n
    simp [Finset.mem_Ioc,Finset.mem_Icc,Nat.succ_le_iff]
  change (grahamSquare u (u+c₂) L 1*w 1/(1:ℕ):ℝ)+
      (∑ n∈Finset.Ioc 1 ⌊Y⌋₊,grahamSquare u (u+c₂) L n*w n/(n:ℝ))≤_
  rw [cd_grahamSquare_one hu₀.le (lt_add_of_pos_right u hc) hL₀,
    Nat.cast_one,one_mul,div_one,hSlice]
  have hRest : (∑ n∈Icc 2 ⌊Y⌋₊,grahamSquare u (u+c₂) L n*w n/(n:ℝ)) ≤
      (2*r-c₂)/(2*c₂)+ε/2 := by
    refine (sum_le_sum fun n hn=>?_).trans (hB i hi)
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    exact (mul_le_mul_of_nonneg_left (hw n) (by unfold grahamSquare; positivity)).trans_eq (mul_one _)
  linarith only [hU,hUnit,hRest]

end
end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Finset Filter GoldbachPintzHalasz GoldbachPintzTheta GoldbachPintzDetector
open scoped Topology

/-- A fixed upper exponent suffices for the detector energy even when the
actual upper cutoff varies with the conductor-height balance. -/
theorem eventually_compact_graham_energy_le_of_upper {u c x : ℝ}
    (hu : 0 < u) (hc : 0 < c) (hx : u+c ≤ x) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (u*L) ≤ Y → Y ≤ Real.exp (x*L) →
      (∑ n∈support Y,
        (realDivisorWeight (support (Real.exp ((u+c)*L)))
          (barbanVehov (Real.exp (u*L)) (Real.exp ((u+c)*L))) n)^2*
          differenceWeight Y (Real.exp (u*L)) n/(n:ℝ)) ≤ (2*(x-u)-c)/(2*c)+1 := by
  have hcu : c ≤ x-u := by linarith only [hx]
  have hE := eventually_compact_graham_energy_on_mesh ({()} : Finset Unit) (fun _=>0)
    (fun _ _=>le_rfl) hu hc hcu zero_lt_one
  filter_upwards [hE,eventually_ge_atTop (1:ℝ)] with L hE hL Y hUY hY
  let U := Real.exp (u*L)
  let V := Real.exp ((u+c)*L)
  let Z := Real.exp (x*L)
  let w := differenceWeight Y U
  have hU : 1 ≤ U := Real.one_le_exp (mul_nonneg hu.le ((by norm_num : (0:ℝ)≤1).trans hL))
  have hw (n : ℕ) : 0 ≤ w n ∧ w n ≤ 1 :=
    differenceWeight_bounds (zero_lt_one.trans_le hU) hUY n
  have hw₁ : w 1 ≤ 2/U := differenceWeight_one_le hU hUY
  have hYZ : support Y ⊆ support Z := by
    intro n hn
    exact mem_Icc.mpr ⟨(mem_Icc.mp hn).1,(mem_Icc.mp hn).2.trans (Nat.floor_mono hY)⟩
  have hE' := hE () (by simp) w (fun n=>(hw n).2)
    (by simpa only [add_zero,U] using hw₁)
  have hx' : u+(x-u)=x := by ring
  refine (sum_le_sum_of_subset_of_nonneg hYZ (fun n _ _=>?_)).trans ?_
  · positivity [(hw n).1]
  · simpa only [support,grahamSquare,add_zero,hx',U,V,Z] using hE'

end GoldbachGrahamDiagonal
end

section
namespace GoldbachGrahamDiagonal

open Filter Finset GoldbachPintzHalasz GoldbachPintzTheta GoldbachPintzDetector GoldbachPintzScales
open scoped Topology

/-- Uniform coarse detector energy on the conductor-height cutoffs
without a separate logarithmic divisor-square estimate. -/
theorem canonical_compact_harmonic_from_graham :
    ∃ C H₀ : ℝ, 0<C ∧ ∀ (Q : ℕ), 1≤Q → ∀ {T : ℝ}, 0≤T → H₀≤(Q:ℝ)*(T+1) →
      let x := Real.log (Q:ℝ)
      let y := Real.log (T+1)
      let U := Real.exp (lowerLog x y)
      let W := Real.exp (thetaLog x y)
      let Y := Real.exp (upperLog x y)
      (∑ n∈support Y, (realDivisorWeight (support (U*W)) (barbanVehov U (U*W)) n)^2*
        differenceWeight Y U n/(n:ℝ)) ≤ C := by
  let u := 1+16*loss
  let c := loss
  let p := 2+32*loss
  let C := (2*(p-u)-c)/(2*c)+1
  have hu : 0<u := by norm_num [u,loss]
  have hc : 0<c := by norm_num [c,loss]
  have hup : u+c≤p := by norm_num [u,c,p,loss]
  have hC : 0<C := by norm_num [C,u,c,p,loss]
  obtain ⟨L₀,hL₀⟩ := eventually_atTop.1 (eventually_compact_graham_energy_le_of_upper hu hc hup)
  refine ⟨C,Real.exp L₀,hC,?_⟩
  intro Q hQ T hT hLarge x y U W Y
  have hQ₁ : (1:ℝ)≤Q := by exact_mod_cast hQ
  have hQ₀ := zero_lt_one.trans_le hQ₁
  have hT₁ : (1:ℝ)≤T+1 := le_add_of_nonneg_left hT
  let L := x+y
  have hL : L₀≤L := by
    have h := Real.log_le_log (Real.exp_pos L₀) hLarge
    rwa [Real.log_exp,Real.log_mul hQ₀.ne' (zero_lt_one.trans_le hT₁).ne'] at h
  have hx : 0≤x := Real.log_nonneg hQ₁
  have hy : 0≤y := Real.log_nonneg hT₁
  have hθ : 0≤thetaLog x y := mul_nonneg hc.le (add_nonneg hx hy)
  have hS := cutoff_log_comparison hx hy
  have hU : U=Real.exp (u*L) := rfl
  have hV : U*W=Real.exp ((u+c)*L) := by
    rw [hU,←Real.exp_add]
    congr 1
    change u*L+c*L=(u+c)*L
    ring
  have hUY : U≤Y := Real.exp_le_exp.mpr ((le_add_of_nonneg_right hθ).trans hS.1)
  have hY : Y≤Real.exp (p*L) := by
    apply Real.exp_le_exp.mpr
    change upperLog x y≤p*L
    dsimp only [p,L,upperLog,loss]
    linarith only [hx]
  rw [hV,hU]
  exact hL₀ L hL Y (hU ▸ hUY) hY

end GoldbachGrahamDiagonal
end

