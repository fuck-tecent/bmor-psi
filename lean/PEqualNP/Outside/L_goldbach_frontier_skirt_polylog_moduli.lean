  let W := Vf X
  let f:ℂ→ℂ := fun z=> -logDeriv riemannZeta z*W z
  let Z := Vc4 T
  let S := insert (0:ℂ) (insert (1:ℂ) Z)
  let C:ℂ→ℂ := fun z=>if z=0 then logDeriv riemannZeta 0 else
    if z=1 then -W 1 else (analyticOrderNatAt riemannZeta z:ℂ)*W z
  have hinside (z:ℂ) (hz:z∈S) : -(1/2:ℝ)<z.re ∧ z.re<b ∧ -T<z.im ∧ z.im<T := by
    rcases Finset.mem_insert.mp hz with rfl | hz
    · simp only [Complex.zero_re,Complex.zero_im]
      exact ⟨by norm_num,by linarith,by linarith,hT⟩
    rcases Finset.mem_insert.mp hz with rfl | hz
    · simp only [Complex.one_re,Complex.one_im]
      exact ⟨by norm_num,hb,by linarith,hT⟩
    obtain ⟨hz,hzi⟩ := (V7r T z).mp hz
    have hi := abs_lt.mp (lt_of_le_of_ne hzi (hheight z hz))
    exact ⟨by linarith [hz.1],hz.2.1.trans hb,hi.1,hi.2⟩
  have hreg (z:ℂ) (hz:z∈S) : ∃R:ℂ→ℂ,AnalyticAt ℂ R z ∧
      (fun s=>f s+C z/(s-z))=ᶠ[𝓝[≠] z] R := by
    by_cases hz0 : z=0
    · subst z
      simpa only [f,C,if_pos rfl,sub_zero,W] using V1k0 X hX
    by_cases hz1 : z=1
    · subst z
      simpa [f,C,neg_div,sub_eq_add_neg,W] using
        V1qi X hX
    have hzZ : z∈Z := (Finset.mem_insert.mp ((Finset.mem_insert.mp hz).resolve_left hz0)).resolve_left hz1
    have hzcrit := ((V7r T z).mp hzZ).1
    simpa only [f,C,if_neg hz0,if_neg hz1,W] using V1p3 X hX z hzcrit
  have hlocal (z:ℂ) (hz:z∈uIcc (-(1/2:ℝ)) b ×ℂ uIcc (-T) T) (hzS:z∉S) :
      AnalyticAt ℂ f z := by
    have hz0 : z≠0 := fun he=>hzS (he ▸ Finset.mem_insert_self _ _)
    have hz1 : z≠1 := fun he=>hzS (he ▸ Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
    have hre : -(1/2:ℝ)≤z.re ∧ z.re≤b := by
      simpa only [uIcc_of_le (by linarith : -(1/2:ℝ)≤b),mem_preimage,mem_Icc] using hz.1
    have him : |z.im|≤T := by
      apply abs_le.mpr
      simpa only [uIcc_of_le (by linarith : -T≤T),mem_preimage,mem_Icc] using hz.2
    have hζ : riemannZeta z≠0 := by
      intro hh
      have hc := Vrv z (by linarith [hre.1]) hh
      exact hzS (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
        ((V7r T z).mpr ⟨hc,him⟩)))
    have hsp1 : z+1≠0 := by
      intro he
      have := congrArg Complex.re he
      simp only [add_re,one_re,zero_re] at this
      linarith [hre.1]
    have ha := analyticOn_riemannZeta z hz1
    exact (ha.deriv.div ha hζ).neg.mul (Viy X hX z hz0 hsp1)
  have hrect := V1kg f C (-(1/2:ℝ)) b (-T) T S hinside hreg hlocal
  have h0Z : (0:ℂ)∉Z := by
    intro hh
    have := ((V7r T 0).mp hh).1.1
    norm_num at this
  have h1Z : (1:ℂ)∉Z := by
    intro hh
    have := ((V7r T 1).mp hh).1.2.1
    norm_num at this
  have h0S : (0:ℂ)∉insert (1:ℂ) Z := by simp [h0Z]
  have hsum : ∑z∈S,C z=logDeriv riemannZeta 0-(X:ℂ)/2+
      ∑z∈Z,(analyticOrderNatAt riemannZeta z:ℂ)*W z := by
    have hc0 : C 0=logDeriv riemannZeta 0 := by simp [C]
    have hc1 : C 1= -W 1 := by simp [C]
    have hw : W 1=(X:ℂ)/2 := by simp [W,Vf,V2a]; ring
    have hs : ∑z∈Z,C z=∑z∈Z,(analyticOrderNatAt riemannZeta z:ℂ)*W z := by
      apply Finset.sum_congr rfl
      intro z hz
      have hn0 : z≠0 := fun he=>h0Z (he ▸ hz)
      have hn1 : z≠1 := fun he=>h1Z (he ▸ hz)
      simp [C,hn0,hn1]
    rw [Finset.sum_insert h0S,Finset.sum_insert h1Z,hc0,hc1,hs,hw]
    ring
  rw [hsum] at hrect
  exact hrect
end V9l
