theorem V1hy {s : ℂ} (hs : 0 ≤ s.re) :
    1+|s.im| ≤ 2*‖s+1‖ := by
  have hre : 1 ≤ ‖s+1‖ := by
    have hh := Complex.re_le_norm (s+1)
    simp only [Complex.add_re, Complex.one_re] at hh
    linarith
  have him : |s.im| ≤ ‖s+1‖ := by
    simpa only [Complex.add_im, Complex.one_im, add_zero] using Complex.abs_im_le_norm (s+1)
  linarith
theorem V1vt (X : ℝ) (hX : 0<X) (s : ℂ)
    (hs0 : 0≤s.re) (hs2 : s.re≤2) :
    ‖∫ y in X..4*X, (y : ℂ)^s‖ ≤
      130*X^(s.re+1)/(1+|s.im|) := by
  have hp : 0≤X^(s.re+1) := Real.rpow_nonneg hX.le _
  have hd : 0<1+|s.im| := by positivity
  have hn : 0<‖s+1‖ := by
    have hh := Complex.re_le_norm (s+1)
    simp only [Complex.add_re, Complex.one_re] at hh
    linarith
  have h4 : (4 : ℝ)^(s.re+1) ≤ 64 := by
    calc
      _ ≤ (4 : ℝ)^(3 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      _ = _ := by norm_num
  have hnum : ‖((4*X : ℝ) : ℂ)^(s+1) - (X : ℂ)^(s+1)‖ ≤
      65*X^(s.re+1) := by
    calc
      _ ≤ ‖((4*X : ℝ) : ℂ)^(s+1)‖ + ‖(X : ℂ)^(s+1)‖ := norm_sub_le _ _
      _ = (4*X)^(s.re+1) + X^(s.re+1) := by
        rw [Complex.norm_cpow_eq_rpow_re_of_pos (by positivity),
          Complex.norm_cpow_eq_rpow_re_of_pos hX]
        simp only [Complex.add_re, Complex.one_re]
      _ = (4 : ℝ)^(s.re+1)*X^(s.re+1)+X^(s.re+1) := by
        rw [Real.mul_rpow (by norm_num : (0 : ℝ)≤4) hX.le]
      _ ≤ _ := by nlinarith [mul_le_mul_of_nonneg_right h4 hp]
  rw [integral_cpow (Or.inl (by linarith : -1<s.re)), norm_div]
  calc
    _ ≤ (65*X^(s.re+1))/‖s+1‖ := div_le_div_of_nonneg_right hnum hn.le
    _ ≤ _ := by
      apply (div_le_div_iff₀ hn hd).2
      have hm := mul_le_mul_of_nonneg_left (V1hy hs0)
        (by positivity : 0≤65*X^(s.re+1))
      nlinarith only [hm]
theorem V1p8 {ι : Type*} (S : Finset ι)
    (K : ι → ι → ℝ) (b : ι → ℝ) (R : ℝ)
    (hK : ∀ i∈S, ∀ j∈S, 0≤K i j)
    (hSym : ∀ i∈S, ∀ j∈S, K i j=K j i)
    (hRow : ∀ i∈S, (∑ j∈S, K i j)≤R) :
    (∑ i∈S, ∑ j∈S, K i j*b i*b j) ≤ R*∑ i∈S, (b i)^2 := by
  have htwice : 2*(∑ i∈S, ∑ j∈S, K i j*b i*b j) ≤
      (∑ i∈S, ∑ j∈S, K i j*(b i)^2) +
        (∑ i∈S, ∑ j∈S, K i j*(b j)^2) := by
    calc
      _ = ∑ i∈S, ∑ j∈S, 2*(K i j*b i*b j) := by simp only [mul_sum]
      _ ≤ ∑ i∈S, ∑ j∈S, (K i j*(b i)^2+K i j*(b j)^2) := by
        apply sum_le_sum
        intro i hi
        apply sum_le_sum
        intro j hj
        have hh := mul_nonneg (hK i hi j hj) (sq_nonneg (b i-b j))
        nlinarith only [hh]
      _ = _ := by simp only [sum_add_distrib]
  have hswap : (∑ i∈S, ∑ j∈S, K i j*(b j)^2) =
      ∑ i∈S, ∑ j∈S, K i j*(b i)^2 := by
    rw [sum_comm]
    apply sum_congr rfl
    intro i hi
    apply sum_congr rfl
    intro j hj
    rw [hSym j hj i hi]
  rw [hswap] at htwice
  have hdiag : (∑ i∈S, ∑ j∈S, K i j*(b i)^2) ≤ R*∑ i∈S, (b i)^2 := by
    calc
      _ = ∑ i∈S, (∑ j∈S, K i j)*(b i)^2 := by simp only [sum_mul]
      _ ≤ ∑ i∈S, R*(b i)^2 := by
        exact sum_le_sum fun i hi => mul_le_mul_of_nonneg_right (hRow i hi) (sq_nonneg _)
      _ = _ := (mul_sum _ _ _).symm
  linarith
theorem V1xy {ι : Type*} (S : Finset ι)
    (a ρ : ι → ℂ) (y : ℝ) (hy : 0<y) :
    ((‖∑ i∈S, a i*(y : ℂ)^(ρ i)‖^2 : ℝ) : ℂ) =
      ∑ i∈S, ∑ j∈S, (a i*conj (a j))*(y : ℂ)^(ρ i+conj (ρ j)) := by
  have hconj (z : ℂ) : conj ((y : ℂ)^z) = (y : ℂ)^(conj z) := by
    simpa only [Complex.conj_ofReal] using
      (Complex.cpow_conj (y : ℂ) z
        (by rw [Complex.arg_ofReal_of_nonneg hy.le]; exact Real.pi_ne_zero.symm)).symm
  rw [Complex.ofReal_pow, ← Complex.mul_conj']
  simp only [map_sum, map_mul, sum_mul, mul_sum]
  conv_lhs => rw [sum_comm]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  rw [hconj, Complex.cpow_add _ _ (by exact_mod_cast hy.ne')]
  ring
theorem V1kn {ι : Type*} (S : Finset ι)
    (a ρ : ι → ℂ) (X : ℝ) (hX : 0<X)
    (hρ : ∀ i∈S, 0≤(ρ i).re) :
    ((∫ y in X..4*X, ‖∑ i∈S, a i*(y : ℂ)^(ρ i)‖^2 : ℝ) : ℂ) =
      ∑ i∈S, ∑ j∈S, (a i*conj (a j)) *
        (∫ y in X..4*X, (y : ℂ)^(ρ i+conj (ρ j))) := by
  have hint (i : ι) (hi : i∈S) (j : ι) (hj : j∈S) :
