    · have hN : n=0 := by simpa [hp] using hRange
      simp [hN]
    · have hN : n=0 := by simpa [hr] using hRange
      simp [hN]
  exact (card_le_card hS).trans ((card_insert_le _ _).trans (by simp))

theorem repeatTags_class_card_le_of_simple_pair {ι κ : Type*} {S : Finset ι} {m : ι→ℕ}
    {P : ι→Prop} (key : ι→κ) (c : κ) {p r : ι}
    (hp : m p=1) (hr : m r=1) (hKey : key p≠key r)
    (hPairs : ∀ j∈S, P j → j=p ∨ j=r) :
    (((repeatTags S m).filter (fun j=>key j.1=c)).filter (fun j=>P j.1)).card≤1 := by
  apply card_le_one.mpr
  rintro ⟨i,n⟩ hi ⟨j,k⟩ hj
  obtain ⟨hIC,hP⟩ := mem_filter.mp hi
  obtain ⟨hJC,hQ⟩ := mem_filter.mp hj
  obtain ⟨hIT,hIc⟩ := mem_filter.mp hIC
  obtain ⟨hJT,hJc⟩ := mem_filter.mp hJC
  obtain ⟨hI,hn⟩ := mem_sigma.mp hIT
  obtain ⟨hJ,hk⟩ := mem_sigma.mp hJT
  dsimp at hn hk hIc hJc hP hQ hI hJ
  rcases hPairs i hI hP with rfl|rfl <;> rcases hPairs j hJ hQ with rfl|rfl
  · have hn0 : n=0 := by simpa [hp] using hn
    have hk0 : k=0 := by simpa [hp] using hk
    simp [hn0,hk0]
  · exact False.elim (hKey (hIc.trans hJc.symm))
  · exact False.elim (hKey (hJc.trans hIc.symm))
  · have hn0 : n=0 := by simpa [hr] using hn
    have hk0 : k=0 := by simpa [hr] using hk
    simp [hn0,hk0]

theorem repeatTags_mem_zero {ι : Type*} {S : Finset ι} {m : ι→ℕ} {i : ι}
    (hi : i∈S) (hPos : 0 < m i) : (⟨i,0⟩ : Σ _ : ι,ℕ)∈repeatTags S m :=
  mem_sigma.mpr ⟨hi,mem_range.mpr hPos⟩

theorem repeatTags_ne_zero_iff_fst_ne {ι : Type*} {S : Finset ι} {m : ι→ℕ}
    {i : ι} (hSimple : m i=1) {t : Σ _ : ι,ℕ} (ht : t∈repeatTags S m) :
    t≠⟨i,0⟩ ↔ t.1≠i := by
  constructor
  · intro h he
    rcases t with ⟨j,n⟩
    change j=i at he
    subst j
    have hn : n=0 := by simpa only [hSimple,mem_range,Nat.lt_one_iff] using (mem_sigma.mp ht).2
    exact h (by simp only [hn])
  · intro h he
    exact h (congrArg Sigma.fst he)

theorem repeatTags_card_le_of_simple_single {ι : Type*} {S : Finset ι} {m : ι→ℕ}
    {T : Finset (Σ _ : ι,ℕ)} {p : ι} (hp : m p=1) (hTag : T⊆repeatTags S m)
    (hSingle : ∀ j∈T,j.1=p) : T.card≤1 := by
  apply card_le_one.mpr
  have hZero (j) (hj : j∈T) : j=⟨p,0⟩ := by
    by_contra hn
    exact (repeatTags_ne_zero_iff_fst_ne hp (hTag hj)).mp hn (hSingle j hj)
  exact fun i hi j hj => (hZero i hi).trans (hZero j hj).symm

end
