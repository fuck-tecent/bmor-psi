noncomputable section

/-- The strip estimate uses a conductor base independent of the ambient
modulus. This accommodates small-conductor ratios of induced characters. -/
theorem circle_log_bounds_of_strip {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q)
    {s : ℂ} {e R T φ B Q : ℝ}
    (he : 0<e) (hR : 0<R) (hR' : R≤1/4)
    (hs : 1+e ≤ s.re) (hs' : s.re≤5/4) (hT : |s.im|+R≤T)
    (hφ : 0≤φ) (hB : 1≤B) (hQ : 1≤Q)
    (hstrip : ∀ w : ℂ, 3/4≤w.re → w.re≤3/2 → |w.im|≤T →
      ‖χ.LFunction w‖≤B*Q^(φ*max 0 (1-w.re))) :
    let E := max (Real.log (1+e⁻¹)) (Real.log B)
    0≤E ∧
    (∀ t : ℝ, 0≤Real.cos t → -E≤Real.log ‖χ.LFunction (s+circleMap 0 R t)‖) ∧
    (∀ t : ℝ, Real.cos t≤0 → Real.log ‖χ.LFunction (s+circleMap 0 R t)‖≤
      φ*R*Real.log Q*(-Real.cos t)+E) := by
  intro E
  have hQ0 := zero_lt_one.trans_le hQ
  have hlogQ := Real.log_nonneg hQ
  have hB0 := zero_lt_one.trans_le hB
  have hErr : Real.log (1+e⁻¹)≤E := le_max_left _ _
  have hErrB : Real.log B≤E := le_max_right _ _
  have hE : 0≤E := (Real.log_nonneg (le_add_of_nonneg_right (inv_nonneg.mpr he.le))).trans hErr
  have hReal (t : ℝ) : (s+circleMap 0 R t).re=s.re+R*Real.cos t := by
    rw [circleMap,zero_add,Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
      zero_mul,sub_zero,Complex.exp_mul_I]
    have hcos : (Complex.cos (t:ℂ)).re = Real.cos t := by rw [←Complex.ofReal_cos,Complex.ofReal_re]
    have hsin : (Complex.sin (t:ℂ)).im=0 := by rw [←Complex.ofReal_sin,Complex.ofReal_im]
    simp [Complex.add_re,Complex.mul_re,hcos,hsin]
  have hCircle (t : ℝ) : ‖circleMap 0 R t‖=R :=
    mem_sphere_zero_iff_norm.mp (circleMap_mem_sphere 0 hR.le t)
  refine ⟨hE,?_,?_⟩
  · intro t ht
    let w := s+circleMap 0 R t
    have hw : e≤w.re-1 := by
      dsimp only [w]
      rw [hReal]
      linarith only [hs,mul_nonneg hR.le ht]
    have hw1 : 1<w.re := by linarith only [he,hw]
    have ha := euler_log_modulus_bound χ hw1
    have hb : Real.log (1+(w.re-1)⁻¹)≤Real.log (1+e⁻¹) := by
      apply Real.log_le_log
      · positivity [sub_pos.mpr hw1]
      · exact add_le_add (le_refl _) ((inv_le_inv₀ (sub_pos.mpr hw1) he).mpr hw)
    have hc := (neg_le_abs (Real.log ‖χ.LFunction w‖)).trans (ha.trans (hb.trans hErr))
    linarith only [hc]
  · intro t ht
    let w := s+circleMap 0 R t
    have hwLo : (3/4:ℝ)≤w.re := by
      dsimp only [w]
      rw [hReal]
      have hh := mul_le_mul_of_nonneg_left (Real.neg_one_le_cos t) hR.le
      linarith only [hh,hs,he,hR']
    have hwHi : w.re≤3/2 := by
      dsimp only [w]
      rw [hReal]
      linarith only [hs',mul_nonpos_of_nonneg_of_nonpos hR.le ht]
    have hwT : |w.im|≤T := by
      change |(s+circleMap 0 R t).im|≤T
      rw [Complex.add_im]
      exact (abs_add_le _ _).trans
        ((add_le_add (le_refl |s.im|) ((Complex.abs_im_le_norm _).trans_eq (hCircle t))).trans hT)
    have hh := hstrip w hwLo hwHi hwT
    let d : ℝ := φ*max 0 (1-w.re)
    have hdd : d≤φ*R*(-Real.cos t) := by
      rw [mul_assoc]
      apply mul_le_mul_of_nonneg_left _ hφ
      apply max_le
      · positivity [neg_nonneg.mpr ht]
      · dsimp only [w]
        rw [hReal]
        nlinarith only [hs,he]
    by_cases hzero : χ.LFunction w=0
    · change Real.log ‖χ.LFunction w‖≤_
      rw [hzero,norm_zero,Real.log_zero]
      positivity [neg_nonneg.mpr ht]
    have hlog := Real.log_le_log (norm_pos_iff.mpr hzero) hh
    rw [Real.log_mul hB0.ne' (Real.rpow_pos_of_pos hQ0 _).ne',Real.log_rpow hQ0] at hlog
    change Real.log ‖χ.LFunction w‖ ≤ Real.log B + d*Real.log Q at hlog
    have hm := mul_le_mul_of_nonneg_right hdd hlogQ
    change Real.log ‖χ.LFunction w‖ ≤ _
    nlinarith only [hlog,hm,hErrB]

/-- Exact signed local logarithmic derivative bound with arbitrary strip
exponent and conductor base. -/
theorem sharp_logDeriv_of_strip {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hχ : χ≠1) {s : ℂ} {e R T δ φ B Q : ℝ}
    (he : 0<e) (hR : 0<R) (hR' : R≤1/4)
    (hs : 1+e ≤ s.re) (hs' : s.re≤5/4) (hT : |s.im|+R≤T)
    (hφ : 0≤φ) (hB : 1≤B) (hQ : 1≤Q)
    (hstrip : ∀ w : ℂ, 3/4≤w.re → w.re≤3/2 → |w.im|≤T →
      ‖χ.LFunction w‖≤B*Q^(φ*max 0 (1-w.re)))
    (hδ0 : 0≤δ) (hδ : δ<R)
    (hb : ∀ z∈sphere (0:ℂ) R, χ.LFunction (s+z)≠0)
    (V : Finset ℂ) (hV : ∀ z∈V, ‖z‖≤δ ∧ χ.LFunction (s+z)=0) :
    (-logDeriv χ.LFunction s).re ≤ φ*Real.log Q/2 + 2*(max (Real.log (1+e⁻¹)) (Real.log B))/R +
      (δ/R^2)*(∑ a∈V,(analyticOrderNatAt χ.LFunction (s+a):ℝ)) -
      ∑ a∈V,(analyticOrderNatAt χ.LFunction (s+a):ℝ)*(-(1/a)).re := by
  let f : ℂ→ℂ := fun z=>χ.LFunction (s+z)
  have hreg : regularizedL χ=χ.LFunction := by simp [regularizedL,hχ]
  have hfA (z : ℂ) : AnalyticAt ℂ χ.LFunction z := by
    rw [←hreg]
    exact analytic_regularizedL χ z (mem_univ _)
  have hA (z : ℂ) : AnalyticAt ℂ (fun w : ℂ => s+w) z := by fun_prop
  have hf (z : ℂ) : AnalyticAt ℂ f z := (hfA (s+z)).comp (f:=fun w : ℂ => s+w) (hA z)
  have hf0 : f 0≠0 := by
    change χ.LFunction (s+0)≠0
    rw [add_zero,←hreg]
    exact regularizedL_ne_zero_right χ (by linarith only [hs,he])
  obtain ⟨Z,G,hGa,hGn,hZ,hfactor⟩ := exists_disk_factorization hR (fun z _=>hf z) hf0 hb
  have hZ' (a : ℂ) (ha : a∈Z) : a≠0 ∧ ‖a‖<R ∧ a.re≤0 := by
    obtain ⟨haB,haF⟩ := (hZ a).mp ha
    refine ⟨fun h=>hf0 (h ▸ haF),mem_ball_zero_iff.mp haB,?_⟩
    by_contra hn
    have hs' : 1<(s+a).re := by rw [Complex.add_re]; linarith only [hs,he,lt_of_not_ge hn]
    apply regularizedL_ne_zero_right χ hs'
    rwa [hreg]
  have hVZ : V ⊆ Z := by
    intro a ha
    exact (hZ a).mpr ⟨mem_ball_zero_iff.mpr ((hV a ha).1.trans_lt hδ),(hV a ha).2⟩
  obtain ⟨hE,hP,hN⟩ := circle_log_bounds_of_strip χ he hR hR' hs hs' hT hφ hB hQ hstrip
  have hpv := logDeriv_sharp_of_diskFactorization hR hφ
    (Real.log_nonneg hQ) hE hδ0 Z V (analyticOrderNatAt f) hVZ hGa hGn hZ'
      (fun a ha=>(hV a ha).1) hfactor hP hN
  have hOrder (a : ℂ) : analyticOrderNatAt f a=analyticOrderNatAt χ.LFunction (s+a) := by
    have hd : deriv (fun w : ℂ => s+w) a≠0 := by simp
    unfold analyticOrderNatAt
    change (analyticOrderAt (χ.LFunction ∘ fun w : ℂ => s+w) a).toNat=_
    rw [analyticOrderAt_comp_of_deriv_ne_zero (hA a) hd]
  have hCenter : logDeriv f 0 = logDeriv χ.LFunction s := by
    change logDeriv (χ.LFunction ∘ fun z : ℂ => s+z) 0 = _
    rw [logDeriv_comp (hfA (s+0)).differentiableAt (hA 0).differentiableAt]
    simp
  rw [hCenter] at hpv
  simp only [hOrder] at hpv
  exact hpv


end

end GoldbachPintzWeightedFormula
end

