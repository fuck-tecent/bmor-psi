           ‖windowLaplace a (cdResolventPoint 0 L γ z+(ell:ℂ))‖^2)≤densityMomentScalar φ a ell+ε) :
      ∀ i∈I,∑ j∈I,cdWindowKernel L a χ ρ i j≤densityMomentScalar φ a ((1-(ρ i).re)*L)+ε := by
    intro i hi
    refine cdWindowKernel_row_le_of_analytic_fibers I χ ρ i L a _ (hMultiplicity i hi) ?_
    refine ha q hq (χ i) (hI i hi).1 _ _ (hI i hi).2.2.2.2 (hEll i hi).1
      (hEll i hi).2 _ ?_ (hCount i hi)
    intro z hz
    obtain ⟨j,hj,rfl⟩ := mem_image.mp hz
    simp only [Finset.mem_filter] at hj
    obtain ⟨hjI,hχ⟩ := hj
    rw [hχ]
    exact ⟨(hI j hjI).2.1,(hI j hjI).2.2.1.le,(hEll j hjI).2⟩
  have hRows₁ := hWindow κ hRow₁
  have hr_eq : x-u=r := by dsimp only [x]; ring
  have hRows₂ := hWindow r hRow₂
  have hAbsorb' : C*((2/w)*Real.exp ((x+κ)*(2*H))*κ/N+τ₀)/(1-δ)^2<1 := hAbsorb
  have h := cdMoment_of_actual_compact_mesh I χ ρ (L:=L) (u:=u) (v:=v) (x:=x)
    (w:=w) (κ:=κ) (H:=H) (Λ:=Λ) (φ:=φ) (C:=C) (δ:=δ) (τ₀:=τ₀) (ε:=ε) (N:=N)
    hL₀ hN hκ hw (le_add_of_nonneg_right hr.le) (by dsimp only [x]; positivity) hΛ hφ₀ hCm
    hδ₁ hε.le hEll hAbsorb' θ R hR' ?_ ?_ ?_ ?_ hRows₁ (by simpa only [hr_eq] using hRows₂)
  · simpa only [hr_eq] using h
  · intro k hk i hi
    obtain ⟨hχ,hz,hβ,hgap,hγ⟩ := hData i hi
    dsimp only
    rw [hCutU,hCutV,hCutY]
    exact hDet q hq (χ i) hχ (ρ i) hz hβ.le hgap hγ (η k) (hη k hk) θ hΘ₁ hΘ
  · intro k hk
    let wₖ := differenceWeight (cdMeshCutoff L x κ N k) (cdMeshCutoff L u κ N k)
    dsimp only
    rw [hCutV,hCutY]
    simpa only [support,grahamSquare,wₖ,hCutU,hCutY] using hEnergy k hk wₖ
      (fun n=>(differenceWeight_bounds (zero_lt_one.trans_le (hCut k hk).1) (hCut k hk).2 n).2)
      (differenceWeight_one_le (hCut k hk).1 (hCut k hk).2)
  · intro k hk i hi j hj hch
    let s := conj (ρ i)+ρ j-1
    have hpr := hPrincipal q hq s (hPair i hi j hj).1 (hPair i hi j hj).2.1
      (hPair i hi j hj).2.2 (η k) (hη k hk) θ hΘ (cdMeshCutoff L x κ N k) (hCut k hk).2
    rw [show cdQuotient (χ i) (χ j)=1 from (cdQuotient_eq_one_iff _ _).mpr hch]
    have hz : cdGramPoint L (ρ i) (ρ j)/(L:ℂ)=1-s := by
      dsimp only [cdGramPoint,s]
      field_simp [Complex.ofReal_ne_zero.mpr hL₀.ne']
      ring
    rw [hz]
    exact hpr
  · intro k hk i hi j hj hch
    let s := conj (ρ i)+ρ j-1
    have hQ := mt (cdQuotient_eq_one_iff (χ i) (χ j)).mp hch
    exact hGram q hq _ hQ (hAllowed i hi j hj hch) s (hPair i hi j hj).1.le
      (hPair i hi j hj).2.1 (hPair i hi j hj).2.2 (η k) (hη k hk) θ hΘ _ (hCut k hk).2

end GoldbachPintzWeightedFormula
