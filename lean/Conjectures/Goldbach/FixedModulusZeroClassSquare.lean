section
namespace GoldbachSignedPairs

open Finset Complex Filter Goldbach GoldbachTwistedMellin DirichletCharacter
open scoped Classical Topology

/-- A bounded conductor contributes no zero to a fixed height range whose width shrinks as 1/log q. -/
theorem eventually_no_fixed_conductor_zero (K : ℕ) (H R : ℝ) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (p : DirichletCharacter ℂ q × ℂ),
      p∈modulusZeros q H R → K<p.1.conductor := by
  have hLog : Tendsto (fun q : ℕ => Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R:=ℝ))
  have hf : ∀ᶠ q : ℕ in atTop, ∀ r ∈ range (K+1), ∀ hr : 0<r,
      ∀ χ : DirichletCharacter ℂ r,
        ∀ z ∈ @exceptionalZeros r ⟨hr.ne'⟩ χ R, H < (1-z.re)*Real.log (q:ℝ) := by
    apply (eventually_all_finset _).mpr
    intro r hr
    by_cases hpos : 0<r
    · let _ : NeZero r := ⟨hpos.ne'⟩
      suffices ∀ᶠ q : ℕ in atTop, ∀ χ : DirichletCharacter ℂ r,
          ∀ z ∈ exceptionalZeros χ R,H<(1-z.re)*Real.log (q:ℝ) by
        exact this.mono (fun q h _=>h)
      have hh : ∀ᶠ q : ℕ in atTop, ∀ χ ∈ (univ : Finset (DirichletCharacter ℂ r)),
          ∀ z ∈ exceptionalZeros χ R,H<(1-z.re)*Real.log (q:ℝ) := by
        apply (eventually_all_finset _).mpr
        intro χ _
        apply (eventually_all_finset _).mpr
        intro z hz
        have hz' := ((mem_exceptionalZeros χ R z).mp hz).2.2
        have hp : 0<1-z.re := sub_pos.mpr
          (lt_of_not_ge (fun h => GoldbachZeroFree.regularizedL_ne_zero_ge_one χ h hz'))
        exact (hLog.eventually_gt_atTop (H/(1-z.re))).mono
          (fun q h => by rw [mul_comm]; exact (div_lt_iff₀ hp).mp h)
      exact hh.mono (fun q h χ=>h χ (mem_univ χ))
    · exact Eventually.of_forall (fun _ h=>False.elim (hpos h))
  filter_upwards [hf] with q hq
  intro _ p hp
  have hh := mem_fixed_modulus_zeros.mp hp
  let _ : NeZero p.1.conductor := ⟨p.1.conductor_ne_zero⟩
  have hz : p.2∈exceptionalZeros p.1.primitiveCharacter R := by
    rw [←GoldbachWeightedMajorResidual.exceptionalZeros_primitive]
    exact hh.2.1
  by_contra! h
  have hc : p.1.conductor∈range (K+1) := mem_range.mpr (by omega)
  exact (not_lt_of_ge hh.2.2)
    (hq p.1.conductor hc (NeZero.pos _) p.1.primitiveCharacter p.2 hz)

end GoldbachSignedPairs
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Finset Goldbach GoldbachTwistedMellin GoldbachPintzNumerics
open scoped Topology Classical

noncomputable section

private theorem runner_fixed_height_sub (x y t : ℝ) :
    line x t-line y t=((x-y:ℝ):ℂ) := by
  apply Complex.ext <;> simp [line,Complex.sub_re,Complex.sub_im]

private theorem runner_rational_real (b x : ℝ) :
    (rationalZeroKernel b (x:ℂ)).re=realRationalZeroKernel b x := by
  have h : rationalZeroKernel b (x:ℂ)=(realRationalZeroKernel b x:ℂ) := by
    unfold rationalZeroKernel realRationalZeroKernel
    push_cast
    ring
  rw [h,Complex.ofReal_re]

set_option maxHeartbeats 1600000 in
/-- The four-term real-zero test at the real part of the second zero.
Only the chosen leading zero may exceed that real part in the relevant windows. -/
theorem rational_real_runner_up_gap_eventually
    {ε b κ K D p H : ℝ} (hε : 0<ε) (hb : 0<b) (hκ : 0<κ)
    (hK : 0<K) (hD : 0≤D) (hp : 0≤p) (hH : 0≤H) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (ξ χ : DirichletCharacter ℂ q)
      (σ β γ B T : ℝ) (φ : DirichletCharacter ℂ q→ℝ),
      ξ^2=1 → ξ≠1 → χ≠1 → ξ*χ≠1 →
      Real.log (q:ℝ)≤L → 1-H/L≤β → β≤σ → σ≤1 →
      1+κ/L≤β+b/L → |γ|≤L^p →
      |γ|+1/4≤T → logHeight q 0≤K*L → logHeight q γ≤K*L →
      1≤B → Real.log B≤D*Real.log L →
      (∀ ψ, ψ≠1 → 0≤φ ψ) →
      (∀ ψ, ψ≠1 → ∀ z : ℂ, 3/4≤ z.re → z.re≤3/2 → |z.im|≤T →
        ‖ψ.LFunction z‖≤B*(q:ℝ)^(φ ψ*max 0 (1-z.re))) →
      regularizedL ξ (line σ 0)=0 → regularizedL χ (line β γ)=0 →
      (∀ ψ, ψ=ξ ∨ ψ=χ ∨ ψ=ξ*χ → ∀ ρ : ℂ, regularizedL ψ ρ=0 →
        (|ρ.im|≤1 ∨ |ρ.im-γ|≤1) → (ψ=ξ ∧ ρ=line σ 0) ∨ ρ.re≤ β) →
      realRationalZeroKernel b 0 ≤
        realRationalZeroKernel b (L*(β-1))-realRationalZeroKernel b (L*(β-σ))+
          (φ ξ+φ χ+φ (ξ*χ))/2+ε := by
  have hε4 : 0<ε/4 := by positivity
  obtain ⟨r,L₀,hr,hr32,hL₀,hN⟩ := rational_prime_test_sharp_with_window
    (C:=b) hε4 hκ hb hK hD hb.le
  have hP := rational_prime_test_principal_upper_eventually (p:=p) hε4 hb hH hp
  filter_upwards [hP,eventually_ge_atTop (max L₀ (H/(2*r)))]
    with L hP hL q _ ξ χ σ β γ B T φ hξQ hξ hχ hξχ
      hq hβ₀ hβ hσ hS hγ hT hHL0 hHLγ hB hBL hφ hstrip hzξ hzχ hLead
  have hL' : L₀≤L := (le_max_left _ _).trans hL
  have hL0 : 0<L := zero_lt_one.trans_le (hL₀.trans hL')
  have hQ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hβ1 : β≤1 := hβ.trans hσ
  have hLL : H/L≤2*r := by
    have hh := (div_le_iff₀ (show 0<2*r by positivity)).mp ((le_max_right _ _).trans hL)
    exact (div_le_iff₀ hL0).mpr (by nlinarith only [hh])
  have hShift : 1<β+b/L := (lt_add_of_pos_right _ (div_pos hκ hL0)).trans_le hS
  have hT0 : (1/4:ℝ)≤T := by linarith only [hT,abs_nonneg γ]
  have hP0 := hP q (line β 0) hq (by simpa [line] using hβ₀)
    (by simpa [line] using hβ1.trans (le_add_of_nonneg_right (div_nonneg hH hL0.le)))
    (by simpa [line] using Real.rpow_nonneg hL0.le p) (by simpa [line] using hShift)
  have hPlabel : (L:ℂ)*(line β 0-1)=((L*(β-1):ℝ):ℂ) := by
    have he : line 1 0=1 := by simp [line]
    rw [←he,runner_fixed_height_sub,Complex.ofReal_mul]
  rw [hPlabel,runner_rational_real] at hP0
  have hGeo (x t : ℝ) (hx₁ : 1-H/L≤x) (hx₂ : x≤1) :
      ‖line x t-line 1 t‖≤2*r := by
    rw [runner_fixed_height_sub,Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (sub_nonpos.mpr hx₂)]
    linarith only [hx₁,hLL]
  have hLocal (ψ : DirichletCharacter ℂ q) (hψ : ψ≠1) (t : ℝ)
      (ht : |t|+1/4≤T) (hHt : logHeight q t≤K*L) :
      ∃ V : Finset ℂ,
      (∀ ρ∈V, regularizedL ψ ρ=0 ∧ |ρ.im-t|≤1) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 t‖≤2*r → regularizedL ψ ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V → (∀ ρ∈V, ρ∉U → ρ.re≤ β) →
        (rationalPrimeTest ψ b L (line β t)).re≤φ ψ*L/2+(ε/4)*L-
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL ψ) ρ:ℝ)*
            (rationalZeroKernel b ((L:ℂ)*(line β t-ρ))).re := by
    obtain ⟨V,hV,hCov,hEst⟩ := hN q ψ hψ (s:=line β t) (Q:=(q:ℝ)) hL'
      (by simpa [line] using hS) (by simpa [line] using add_le_add_right hβ1 (b/L))
      (by simpa [line] using ht) (by simpa [line] using hHt)
      (hφ ψ hψ) hB hQ hBL (hstrip ψ hψ)
    refine ⟨V,?_,(by simpa [line] using hCov),?_⟩
    · intro ρ hρ
      have hi := (Complex.abs_im_le_norm (ρ-line 1 t)).trans
        (show ‖ρ-line 1 t‖≤2*r by simpa [line] using (hV ρ hρ).2.2)
      have hw : |ρ.im-t|≤1 :=
        (show |ρ.im-t|≤2*r by simpa [line,Complex.sub_im] using hi).trans (by linarith only [hr32])
      exact ⟨(hV ρ hρ).1,hw⟩
    · intro U hU hD'
      have hh := hEst U hU (by simpa [line] using hD')
      have hq' := mul_le_mul_of_nonneg_left hq (hφ ψ hψ)
      linarith only [hh,hq']
  have hχξ : χ≠ξ := by
    intro he
    apply hξχ
    rw [he,←pow_two]
    exact hξQ
  have hprodξ : ξ*χ≠ξ := by
    intro he
    apply hχ
    calc
      _ = ξ⁻¹*(ξ*χ) := by simp [←mul_assoc]
      _ = _ := by rw [he,inv_mul_cancel]
  obtain ⟨Vξ,hVξ,hCξ,hUξ⟩ := hLocal ξ hξ 0 (by simpa using hT0) hHL0
  obtain ⟨Vχ,hVχ,hCχ,hUχ⟩ := hLocal χ hχ γ hT hHLγ
  obtain ⟨Vp,hVp,_,hUp⟩ := hLocal (ξ*χ) hξχ γ hT hHLγ
  have hMemξ := hCξ _ (hGeo σ 0 (hβ₀.trans hβ) hσ) hzξ
  have hMemχ := hCχ _ (hGeo β γ hβ₀ hβ1) hzχ
  have hUξ' := hUξ {line σ 0} (Finset.singleton_subset_iff.mpr hMemξ) (by
    intro ρ hρ hN
    rcases hLead ξ (Or.inl rfl) ρ (hVξ ρ hρ).1 (Or.inl (by simpa using (hVξ ρ hρ).2)) with h | h
    · exact False.elim (hN (Finset.mem_singleton.mpr h.2))
    · exact h)
  have hUχ' := hUχ {line β γ} (Finset.singleton_subset_iff.mpr hMemχ) (by
    intro ρ hρ _
    rcases hLead χ (Or.inr (Or.inl rfl)) ρ (hVχ ρ hρ).1 (Or.inr (hVχ ρ hρ).2) with h | h
    · exact False.elim (hχξ h.1)
    · exact h)
  have hUp' := hUp ∅ (Finset.empty_subset _) (by
    intro ρ hρ _
    rcases hLead (ξ*χ) (Or.inr (Or.inr rfl)) ρ (hVp ρ hρ).1 (Or.inr (hVp ρ hρ).2) with h | h
    · exact False.elim (hprodξ h.1)
    · exact h)
  have h0 : (rationalZeroKernel b 0).re=realRationalZeroKernel b 0 := by
    simpa only [Complex.ofReal_zero] using runner_rational_real b 0
  simp only [Finset.sum_singleton,runner_fixed_height_sub,←Complex.ofReal_mul,runner_rational_real] at hUξ'
  simp only [Finset.sum_singleton,sub_self,mul_zero,h0] at hUχ'
  simp only [Finset.sum_empty,mul_zero,sub_zero] at hUp'
  have hmξ : (1:ℝ)≤analyticOrderNatAt (regularizedL ξ) (line σ 0) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff ξ _).mpr hzξ
  have hmχ : (1:ℝ)≤analyticOrderNatAt (regularizedL χ) (line β γ) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff χ _).mpr hzχ
  have hLβ : 0<b+L*(β-σ) := by
    have hη := mul_le_mul_of_nonneg_left hS hL0.le
    simp only [mul_add,mul_one,mul_div_cancel₀ _ hL0.ne'] at hη
    nlinarith only [hη,hκ,mul_nonneg hL0.le (sub_nonneg.mpr hσ)]
  have hfξ := (realRationalZeroKernel_pos hb hLβ).le
  have hfχ := (realRationalZeroKernel_pos (x:=0) hb (by simpa using hb)).le
  have hmξ' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hmξ hfξ) hL0.le
  have hmχ' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hmχ hfχ) hL0.le
  have hPos := quadratic_four_rational_primeTest_nonneg ξ χ hξQ (σ:=β) (t:=γ) hb hL0 hShift
  refine le_of_mul_le_mul_left ?_ hL0
  nlinarith only [hP0,hUξ',hUχ',hUp',hmξ',hmχ',hPos]

end

end GoldbachPintzWeightedFormula
end

