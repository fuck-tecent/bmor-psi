theorem anchor_pole_scale {s ρ : ℂ} {b L : ℝ} (hL : L≠0)
    (hw : s+((b/L:ℝ):ℂ)≠ρ) :
    let w := s+((b/L:ℝ):ℂ)
    1/(w-ρ)+(anchorPrimeLinear b L:ℂ)/(w-ρ)^2+
      2*(anchorPrimeQuadratic b L:ℂ)/(w-ρ)^3 =
      (L:ℂ)*anchorRationalKernel b ((L:ℂ)*(s-ρ)) := by
  intro w
  have hL' : (L:ℂ)≠0 := Complex.ofReal_ne_zero.mpr hL
  have hw' : w-ρ≠0 := sub_ne_zero.mpr hw
  have hW : (b:ℂ)+(L:ℂ)*(s-ρ)=(L:ℂ)*(w-ρ) := by
    unfold w
    push_cast
    field_simp [hL']
    ring
  unfold anchorRationalKernel anchorPrimeLinear anchorPrimeQuadratic
  rw [hW]
  push_cast
  field_simp [hL',hw'] <;> ring

private theorem zeta_regular_part_locally_bounded :
    ∃ R M : ℝ, 0<R ∧ 0<M ∧ ∃ G : ℂ→ℂ, AnalyticOnNhd ℂ G (closedBall 1 R) ∧
      (∀ z∈closedBall (1:ℂ) R, ‖G z‖≤M) ∧
      (∀ z : ℂ, 1<z.re →
        -logDeriv ((1:DirichletCharacter ℂ 1).LFunction) z=G z+1/(z-1)) := by
  let χ : DirichletCharacter ℂ 1 := 1
  let f := regularizedL χ
  let G := fun z=>-logDeriv f z
  have hf (z : ℂ) : AnalyticAt ℂ f z := analytic_regularizedL χ z (mem_univ z)
  have hf1 : f 1≠0 := regularizedL_ne_zero_at_one χ
  have hGA (z : ℂ) (hz : f z≠0) : AnalyticAt ℂ G z :=
    ((hf z).deriv.fun_div (hf z) hz).neg
  let M := ‖G 1‖+1
  have hM : 0<M := by unfold M; positivity
  have hOpen : IsOpen (f ⁻¹' ({0}:Set ℂ)ᶜ) :=
    isClosed_singleton.isOpen_compl.preimage (continuous_iff_continuousAt.mpr fun z=>(hf z).continuousAt)
  have hMem : (1:ℂ) ∈ f ⁻¹' ({0}:Set ℂ)ᶜ := by simpa using hf1
  have hBound := (hGA 1 hf1).continuousAt.norm.eventually_lt_const
    (lt_add_of_pos_right (‖G 1‖) (by norm_num : (0:ℝ)<1))
  have hBoth : {z : ℂ | f z≠0 ∧ ‖G z‖<M}∈𝓝 (1:ℂ) := by
    filter_upwards [hOpen.mem_nhds hMem,hBound] with z hz hG
    exact ⟨by simpa using hz,hG⟩
  obtain ⟨r,hr,hrBall⟩ := Metric.mem_nhds_iff.mp hBoth
  let R := r/2
  have hR : 0<R := by unfold R; positivity
  have hSub : closedBall (1:ℂ) R ⊆ ball 1 r :=
    closedBall_subset_ball (by dsimp [R]; linarith only [hr])
  refine ⟨R,M,hR,hM,G,?_,?_,?_⟩
  · intro z hz; exact hGA z (hrBall (hSub hz)).1
  · intro z hz; exact (hrBall (hSub hz)).2.le
  · intro z hz
    have hz1 : z≠1 := by intro he; simp [he] at hz
    have hL := χ.LFunction_ne_zero_of_one_le_re (Or.inr hz1) hz.le
    have he := logDeriv_regularizedL_eq χ hz1 hL
    have hFlag : principalFlag χ=1 := by simp [principalFlag,χ]
    rw [hFlag] at he
    change -logDeriv χ.LFunction z=-logDeriv (regularizedL χ) z+1/(z-1)
    rw [he]
    ring

set_option maxHeartbeats 1000000 in
theorem anchor_prime_principal_upper_eventually {b ε : ℝ} (hb : 0<b) (hε : 0<ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] {σ : ℝ}, σ≤1 → 1<σ+b/L →
      (anchorPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re ≤
        L*anchorRationalKernelReal b (L*(σ-1))+ε*L := by
  obtain ⟨R,M,hR,hM,G,hGa,hGb,hGe⟩ := zeta_regular_part_locally_bounded
  let C := M+b*M/(R/2)+b^2*M/(R/2)^2
  have hC : 0<C := by unfold C; positivity
  filter_upwards [eventually_ge_atTop (max 1 (max (2*b/R) (C/ε)))]
    with L hL q _ σ hσ hσw
  have hL1 : 1≤L := (le_max_left _ _).trans hL
  have hL0 : 0<L := zero_lt_one.trans_le hL1
  have hGeo : b/L≤R/2 := by
    have hh := (div_le_iff₀ hR).mp ((le_max_left _ _).trans ((le_max_right _ _).trans hL))
    apply (div_le_iff₀ hL0).mpr
    nlinarith only [hh]
  have hC' : C≤ε*L := by
    have hh := (div_le_iff₀ hε).mp ((le_max_right _ _).trans ((le_max_right _ _).trans hL))
    linarith only [hh]
  let s := line σ 0
  let w := s+((b/L:ℝ):ℂ)
  let u : ℂ := (anchorPrimeLinear b L:ℂ)
  let v : ℂ := (anchorPrimeQuadratic b L:ℂ)
  let χ : DirichletCharacter ℂ 1 := 1
  have hwRe : w.re=σ+b/L := by simp [w,s,line]
  have hw : 1<w.re := by rwa [hwRe]
  have hw1 : w≠1 := by intro he; simp [he] at hw
  have hwD : ‖w-1‖≤R/2 := by
    have hE : w-1=((σ+b/L-1:ℝ):ℂ) := by simp [w,s,line]
    rw [hE,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (sub_pos.mpr hσw)]
    linarith only [hσ,hGeo]
  have hSub : closedBall w (R/2) ⊆ closedBall (1:ℂ) R := by
    intro z hz
    apply mem_closedBall_iff_norm.mpr
    have h := norm_add_le (z-w) (w-1)
    rw [sub_add_sub_cancel] at h
    linarith only [h,mem_closedBall_iff_norm.mp hz,hwD]
  have hW : w∈closedBall (1:ℂ) R := hSub (mem_closedBall_self (by positivity))
  have he : (fun z=>-logDeriv χ.LFunction z) =ᶠ[𝓝 w]
      (fun z=>G z-∑ ρ∈({1}:Finset ℂ), (-1:ℂ)*(1/(z-ρ))) := by
    have ho : IsOpen {z : ℂ | 1<z.re} := isOpen_lt continuous_const Complex.continuous_re
    have hm : w∈{z : ℂ | 1<z.re} := hw
    filter_upwards [ho.mem_nhds hm] with z hz
    rw [hGe z hz,Finset.sum_singleton]
    ring
  have hJ := independentRationalJet_of_partial_fractions (hGa w hW) {1} (fun _=>(-1:ℂ))
    (fun ρ hρ=>by simpa [Finset.mem_singleton.mp hρ] using hw1) he u v
  rw [Finset.sum_singleton,neg_mul,one_mul,sub_neg_eq_add] at hJ
  have hPole := anchor_pole_scale (s:=s) (ρ:=1) hL0.ne' hw1
  have hSreal : (L:ℂ)*(s-1)=((L*(σ-1):ℝ):ℂ) := by dsimp [s,line]; push_cast; ring
  rw [hSreal] at hPole
  have hPole' := congrArg Complex.re hPole
  simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero,
    anchorRationalKernel_ofReal_re] at hPole'
  have hGerr := independentRationalJet_analytic_error (show 0<R/2 by positivity)
    (hGa.mono hSub) (fun z hz=>hGb z (hSub hz)) u v
  have hlu : ‖u‖≤b := by
    have h := div_le_self hb.le hL1
    have h0 : 0≤(7/8:ℝ)*(b/L) := by positivity
    simp only [u,Complex.norm_real,Real.norm_eq_abs,anchorPrimeLinear,abs_of_nonneg h0]
    linarith only [h,div_nonneg hb.le hL0.le]
  have hlv : ‖v‖≤b^2/2 := by
    have h := pow_le_pow_left₀ (by positivity : 0≤b/L) (div_le_self hb.le hL1) 2
    have h0 : 0≤(b/L)^2/2 := by positivity
    simp only [v,Complex.norm_real,Real.norm_eq_abs,anchorPrimeQuadratic,abs_of_nonneg h0]
    linarith only [h]
  have hGt : (independentRationalJet G u v w).re≤C := by
    have h1 := (Complex.re_le_norm _).trans hGerr
    rw [Complex.sub_re] at h1
    have h2 := (Complex.re_le_norm (G w)).trans (hGb w hW)
    have h3 : ‖u‖*M/(R/2)≤b*M/(R/2) := by gcongr
    have h4 : 2*‖v‖*M/(R/2)^2≤b^2*M/(R/2)^2 := by
      have h : 2*‖v‖≤b^2 := by linarith only [hlv]
      gcongr
    dsimp only [C]
    linarith only [h1,h2,h3,h4]
  refine (anchor_principal_level_one_le (q:=q) hb hL0 hσw).trans ?_
  change (independentRationalJet (fun z=>-logDeriv χ.LFunction z) u v w).re≤_
  rw [hJ,Complex.add_re]
  change _ + (1/(w-1)+u/(w-1)^2+2*v/(w-1)^3).re≤_
  rw [hPole']
  linarith only [hGt,hC']

end

