                have h2 : (1 - ‖z / ((n : ℂ) + 1)‖)⁻¹ ≤ 2 := by
                  rw [← one_div]
                  have h3 := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 1 / 2)
                    (by linarith : (1 : ℝ) / 2 ≤ 1 - ‖z / ((n : ℂ) + 1)‖)
                  simpa using h3
                gcongr
            _ = ‖z / ((n : ℂ) + 1)‖ ^ 2 := by ring
            _ = ‖z‖ ^ 2 * (1 / ((n : ℝ) + 1) ^ 2) := by
                rw [hw, div_pow]
                ring
    _ = (2 * ‖z‖ + ‖z‖ ^ 2) * (1 / ((n : ℝ) + 1) ^ 2) := by ring
