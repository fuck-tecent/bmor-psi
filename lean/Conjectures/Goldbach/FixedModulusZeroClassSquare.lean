def boundedConductorSubgroup (q K : ℕ) : Subgroup (DirichletCharacter ℂ q) :=
  (changeLevel (R:=ℂ) (Nat.gcd_dvd_left q K.factorial)).range

def conductorClass {q : ℕ} (K : ℕ) (χ : DirichletCharacter ℂ q) :
    (DirichletCharacter ℂ q) ⧸ boundedConductorSubgroup q K := QuotientGroup.mk χ

theorem conductorClass_eq_iff {q K : ℕ} [NeZero q] (χ ψ : DirichletCharacter ℂ q) :
    conductorClass K χ = conductorClass K ψ ↔ (χ/ψ).conductor ∣ K.factorial := by
  rw [conductorClass, conductorClass, QuotientGroup.eq_iff_div_mem]
  let θ := χ/ψ
  let d := q.gcd K.factorial
  let hdq : d ∣ q := Nat.gcd_dvd_left _ _
  change θ ∈ (changeLevel (R:=ℂ) hdq).range ↔ θ.conductor ∣ K.factorial
  constructor
  · rintro ⟨θ₀,hθ⟩
    rw [← hθ,conductor_changeLevel]
    exact θ₀.conductor_dvd_level.trans (Nat.gcd_dvd_right _ _)
  · intro h
    have hd : θ.conductor ∣ d := Nat.dvd_gcd θ.conductor_dvd_level h
    refine ⟨changeLevel hd θ.primitiveCharacter,?_⟩
    rw [← changeLevel_trans,changeLevel_primitiveCharacter]


end
end GoldbachSignedPairs

