        simpa only [hPL] using hWindow hn hψ hz h)
    have h₁ : L*(r.2.re-1) = -modulusGap q r.2 := by unfold modulusGap L; ring
    have h₂ : L*(r.2.re-p.2.re) = modulusGap q p.2-modulusGap q r.2 := by unfold modulusGap L; ring
    rw [h₁,h₂] at hh
    have hEdge : realRationalZeroKernel b (-c)-realRationalZeroKernel b ((19/50:ℝ)-c)+
