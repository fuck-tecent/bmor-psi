namespace GoldbachPintzVertical

open Complex MeasureTheory Filter
open GoldbachHybridGrowth

theorem critical_integral_le_of_norm (F : ℝ → ℂ) (hF : Continuous F) {B : ℝ} (hB : 0 ≤ B)
    (h : ∀ t, ‖F t‖ ≤ B*(1+|t|)^(1/2:ℝ)) :
    (∫ t : ℝ, (1/(1+|t|)^3)*‖F t‖) ≤ B*(∫ t : ℝ, (1+t^2)⁻¹) := by
  let f (t : ℝ) := (1/(1+|t|)^3)*‖F t‖
  let g (t : ℝ) := B*(1+t^2)⁻¹
  have hg : Integrable g := integrable_inv_one_add_sq.const_mul B
  have hf₀ : Continuous f := by
    unfold f
    have ht : Continuous (fun t : ℝ => (1:ℝ)+|t|) := continuous_const.add continuous_abs
    exact (continuous_const.div (ht.pow 3) (fun t =>
      pow_ne_zero _ (show (1:ℝ)+|t| ≠ 0 by positivity))).mul hF.norm
  have hpt (t : ℝ) : f t ≤ g t := by
    have ht : 1 ≤ 1+|t| := by linarith only [abs_nonneg t]
    have hc : (1+|t|)^(1/2:ℝ) ≤ 1+|t| := by
      simpa only [Real.rpow_one] using
        Real.rpow_le_rpow_of_exponent_le ht (by norm_num : (1/2:ℝ) ≤ 1)
    have hs : 1+t^2 ≤ (1+|t|)^2 := by
      rw [← sq_abs t]
      nlinarith only [abs_nonneg t]
    change (1/(1+|t|)^3)*‖F t‖ ≤ B*(1+t^2)⁻¹
    calc
      _ ≤ (1/(1+|t|)^3)*(B*(1+|t|)) := mul_le_mul_of_nonneg_left
        ((h t).trans (mul_le_mul_of_nonneg_left hc hB)) (by positivity)
      _ = B/(1+|t|)^2 := by
        have hn : (1+|t|) ≠ 0 := by positivity
        field_simp
      _ ≤ _ := by rw [← div_eq_mul_inv]; exact div_le_div_of_nonneg_left hB (by positivity) hs
  have hf : Integrable f := by
    apply hg.mono' hf₀.aestronglyMeasurable
    filter_upwards [] with t
    rw [Real.norm_of_nonneg (by dsimp only [f]; positivity)]
    exact hpt t
  have h' := integral_mono hf hg hpt
  simpa only [f,g,integral_const_mul] using h'

theorem critical_L_integral_bound {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ ≠ 1 →
      ∀ {T γ : ℝ}, |γ| ≤ T →
      (∫ t : ℝ, (1/(1+|t|)^3)*‖χ.LFunction ((1/2:ℂ)+(γ+t)*I)‖) ≤
        C * (q:ℝ)^(1/4+ε/2) * (1+T)^(1/2:ℝ) := by
  let D := 5*(8*(1+1/ε))^(1/2:ℝ)
  let K := ∫ t : ℝ, (1+t^2)⁻¹
  have hD : 0 < D := by dsimp [D]; positivity
  have hk : 0 ≤ K := integral_nonneg (fun _ => by positivity)
  refine ⟨D*(K+1),by positivity,?_⟩
  intro q _ χ hχ T γ hT
  have ht0 : 0 ≤ T := (abs_nonneg _).trans hT
  let F (t : ℝ) := χ.LFunction ((1/2:ℂ)+(γ+t)*I)
  let B := D*(q:ℝ)^(1/4+ε/2)*(1+T)^(1/2:ℝ)
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have hF : Continuous F := (χ.differentiable_LFunction hχ).continuous.comp (by fun_prop)
  have hbound (t : ℝ) : ‖F t‖ ≤ B*(1+|t|)^(1/2:ℝ) := by
    let s : ℂ := (1/2:ℂ)+(γ+t)*I
    have hs : s.re = 1/2 := by simp [s,Complex.add_re,Complex.mul_re]
    have hi : s.im = γ+t := by simp [s,Complex.add_im,Complex.mul_im]
    have hq : (0:ℝ) ≤ q := by positivity
    have hmono : 1+|γ+t| ≤ (1+T)*(1+|t|) := by
      have h := abs_add_le γ t
      nlinarith only [h,hT,mul_nonneg ht0 (abs_nonneg t)]
    have hj := nonprincipal_LFunction_rpow_bound χ hχ hε
      (s := s) (by rw [hs]; norm_num) (by rw [hs]; norm_num)
    rw [hs, hi] at hj
    change ‖χ.LFunction s‖ ≤ _
    refine hj.trans ?_
    have hc : (1/(1-(1/2:ℝ))+1+1/(1/2:ℝ)) = 5 := by norm_num
    rw [hc,show (1:ℝ)-1/2=1/2 by norm_num]
    refine (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by positivity)
      (mul_le_mul_of_nonneg_left hmono (by positivity)) (by norm_num)) (by norm_num : (0:ℝ) ≤ 5)).trans_eq ?_
    let Cε : ℝ := 8*(1+1/ε)
    have hCε : 0 ≤ Cε := by dsimp [Cε]; positivity
    have hpow : ((q:ℝ)^(1/2+ε))^(1/2:ℝ) = (q:ℝ)^(1/4+ε/2) := by
      rw [← Real.rpow_mul hq]
      congr 1
      ring
    change 5*(Cε*(q:ℝ)^(1/2+ε)*((1+T)*(1+|t|)))^(1/2:ℝ) = _
    rw [Real.mul_rpow (show 0 ≤ Cε*(q:ℝ)^(1/2+ε) by positivity) (by positivity),
      Real.mul_rpow hCε (by positivity),
      Real.mul_rpow (show 0 ≤ 1+T by positivity) (by positivity), hpow]
    change _ = (5*Cε^(1/2:ℝ))*(q:ℝ)^(1/4+ε/2)*(1+T)^(1/2:ℝ)*(1+|t|)^(1/2:ℝ)
    ring
  refine (critical_integral_le_of_norm F hF hB hbound).trans ?_
  have hh := mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (show (0:ℝ) ≤ 1 by norm_num) : K ≤ K+1) hB
  convert hh using 1
  dsimp only [B]
  ring

end GoldbachPintzVertical

