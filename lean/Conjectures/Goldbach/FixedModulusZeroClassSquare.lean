section

namespace GoldbachHybridGrowth

open Complex Finset Set GoldbachDensityDetector
open scoped Classical BigOperators

/-- The principal conductor-one function has the matching pointwise growth
on any fixed interior vertical line. -/
theorem zeta_LFunction_bound {s : ℂ} (hσ : 0<s.re) (hσ₁ : s.re<1) :
    ‖riemannZeta s‖ ≤ (2/(1-s.re)+1/s.re)*(4*(1+|s.im|))^(1-s.re) := by
  let Z := 1+‖s‖
  let N : ℕ := ⌈Z⌉₊
  have hZ : 1≤Z := by change 1≤1+‖s‖; linarith only [norm_nonneg s]
  have hZN : Z≤(N:ℝ) := Nat.le_ceil _
  have hN1 : (1:ℝ)≤N := hZ.trans hZN
  have hN0 : (0:ℝ)<N := zero_lt_one.trans_le hN1
  have hN : 1≤N := by exact_mod_cast hN1
  have hN2 : (N:ℝ)≤2*Z := by
    have hc := Nat.ceil_lt_add_one (zero_le_one.trans hZ)
    change (N:ℝ)<Z+1 at hc
    linarith only [hc,hZ]
  have hnorm : ‖s‖≤1+|s.im| := by
    have he : s=(s.re:ℂ)+(s.im:ℂ)*I := by apply Complex.ext <;> simp
    have hn := norm_add_le (s.re:ℂ) ((s.im:ℂ)*I)
    rw [← he,norm_mul,Complex.norm_I,mul_one,Complex.norm_real,Complex.norm_real,
      Real.norm_eq_abs,Real.norm_eq_abs,abs_of_pos hσ] at hn
    linarith only [hn,hσ₁]
  have hNcut : (N:ℝ)≤4*(1+|s.im|) := by
    apply hN2.trans
    change 2*(1+‖s‖)≤4*(1+|s.im|)
    linarith only [hnorm,abs_nonneg s.im]
  have hs1 : s≠1 := by
    intro he
    simp [he] at hσ₁
  let W := (N:ℂ)^(1-s)/(s-1)
  have hd : 1-s.re≤‖s-1‖ := by
    have h := Complex.abs_re_le_norm (s-1)
    rw [sub_re,one_re,abs_of_neg (sub_neg.mpr hσ₁)] at h
    linarith only [h]
  have hW : ‖W‖≤(N:ℝ)^(1-s.re)/(1-s.re) := by
    dsimp only [W]
    rw [norm_div,Complex.norm_natCast_cpow_of_pos (Nat.zero_lt_one.trans_le hN),sub_re,one_re]
    exact div_le_div_of_nonneg_left (Real.rpow_nonneg hN0.le _) (sub_pos.mpr hσ₁) hd
  have hpartial : ‖zetaPartial N s‖≤(N:ℝ)^(1-s.re)/(1-s.re) := by
    have he : Lpartial (1:DirichletCharacter ℂ 1) N s = zetaPartial N s := by
      unfold Lpartial zetaPartial
      apply sum_congr rfl
      intro n _
      rw [Subsingleton.elim (n:ZMod 1) 1,map_one,one_mul]
    rw [← he]
    exact Lpartial_norm_le _ hσ hσ₁ hN
  have htail₀ := zeta_truncation_with_pole hσ hs1 hN
  have hnorm_le_N : ‖s‖≤N := by change 1+‖s‖≤↑N at hZN; linarith only [hZN]
  have htail : ‖riemannZeta s-zetaPartial N s-W‖≤(N:ℝ)^(1-s.re)/s.re := by
    refine htail₀.trans ?_
    calc
      _ ≤ ((N:ℝ)/s.re)*(N:ℝ)^(-s.re) := mul_le_mul_of_nonneg_right
        (div_le_div_of_nonneg_right hnorm_le_N hσ.le) (Real.rpow_nonneg hN0.le _)
      _ = _ := by
        rw [show ((N:ℝ)/s.re)*(N:ℝ)^(-s.re) =
          ((N:ℝ)*(N:ℝ)^(-s.re))/s.re by ring,
          ← Real.rpow_one_add' hN0.le (by linarith only [hσ₁]),
          show (1:ℝ)+ -s.re=1-s.re by ring]
  have hspl : riemannZeta s = (riemannZeta s-zetaPartial N s-W)+(zetaPartial N s+W) := by ring
  have htriangle : ‖riemannZeta s‖≤
      ‖riemannZeta s-zetaPartial N s-W‖+(‖zetaPartial N s‖+‖W‖) := by
    conv_lhs => rw [hspl]
    exact (norm_add_le _ _).trans (add_le_add le_rfl (norm_add_le _ _))
  calc
    _ ≤ (N:ℝ)^(1-s.re)/s.re +
        ((N:ℝ)^(1-s.re)/(1-s.re)+(N:ℝ)^(1-s.re)/(1-s.re)) :=
      htriangle.trans (add_le_add htail (add_le_add hpartial hW))
    _ = (2/(1-s.re)+1/s.re)*(N:ℝ)^(1-s.re) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow hN0.le hNcut (sub_nonneg.mpr hσ₁.le))
      (by have hh : 0<1-s.re := sub_pos.mpr hσ₁; positivity)

end GoldbachHybridGrowth

end

section

namespace GoldbachHybridGrowth

open Complex Finset MeasureTheory Set
open scoped Classical BigOperators

private theorem principal_norm_le_zeta_product (q : ℕ) [NeZero q]
    {s : ℂ} (hs : 0 ≤ s.re) (hs₁ : s≠1) :
    ‖(1:DirichletCharacter ℂ q).LFunction s‖ ≤ (2:ℝ)^q.primeFactors.card*‖riemannZeta s‖ := by
  change ‖DirichletCharacter.LFunctionTrivChar q s‖≤_
  rw [DirichletCharacter.LFunctionTrivChar_eq_mul_riemannZeta (N:=q) hs₁,norm_mul]
  apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
  rw [norm_prod,← Finset.prod_const]
  apply Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
  intro p hp
  have hpr := Nat.prime_of_mem_primeFactors hp
  refine (norm_sub_le _ _).trans ?_
  rw [norm_one,Complex.norm_natCast_cpow_of_pos hpr.pos,Complex.neg_re]
  have hpow := Real.rpow_le_one_of_one_le_of_nonpos
    (show (1:ℝ)≤p by exact_mod_cast hpr.one_lt.le) (neg_nonpos.mpr hs)
  linarith only [hpow]

/-- The principal critical-line value is bounded by the zeta estimate and an
arbitrarily small power of its modulus. -/
theorem principal_critical_growth {ε : ℝ} (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ) [NeZero q] {T γ : ℝ}, |γ|≤T →
      ∀t : ℝ, ‖(1:DirichletCharacter ℂ q).LFunction ((1/2:ℂ)+(γ+t)*I)‖ ≤
        C*(q:ℝ)^ε*(1+T)^(1/2:ℝ)*(1+|t|)^(1/2:ℝ) := by
  obtain ⟨G,hG,hFactor⟩ := primeFactor_twopow_le_rpow hε
  refine ⟨12*G,by positivity,?_⟩
  intro q _ T γ ht t
  let s : ℂ := (1/2:ℂ)+(γ+t)*I
  have hs : s.re=1/2 := by simp [s]
  have him : s.im=γ+t := by simp [s]
  have hs₁ : s≠1 := by intro h; rw [h] at hs; norm_num at hs
  have hT : 0≤T := (abs_nonneg _).trans ht
  have hmono : 1+|γ+t|≤(1+T)*(1+|t|) := by
    nlinarith only [abs_add_le γ t,ht,mul_nonneg hT (abs_nonneg t)]
  have hζ := zeta_LFunction_bound (s:=s) (by rw [hs]; norm_num) (by rw [hs]; norm_num)
  rw [hs,him,show (2/(1-(1/2:ℝ))+1/(1/2:ℝ))=6 by norm_num,
    show (1:ℝ)-1/2=1/2 by norm_num] at hζ
  have hζ' : ‖riemannZeta s‖≤12*(1+T)^(1/2:ℝ)*(1+|t|)^(1/2:ℝ) := by
    refine hζ.trans ((mul_le_mul_of_nonneg_left (Real.rpow_le_rpow (by positivity)
      (mul_le_mul_of_nonneg_left hmono (by norm_num : (0:ℝ)≤4)) (by norm_num)) (by norm_num)).trans_eq ?_)
    rw [Real.mul_rpow (by norm_num : (0:ℝ)≤4) (by positivity),
      Real.mul_rpow (by positivity : 0≤1+T) (by positivity),
      ← Real.sqrt_eq_rpow,show Real.sqrt 4=2 by rw [show (4:ℝ)=2^2 by norm_num,Real.sqrt_sq (by norm_num)]]
    ring
  refine (principal_norm_le_zeta_product q (by rw [hs]; norm_num) hs₁).trans ?_
  exact (mul_le_mul (hFactor q (NeZero.pos q)) hζ' (norm_nonneg _) (by positivity)).trans_eq (by ring)

end GoldbachHybridGrowth

end

