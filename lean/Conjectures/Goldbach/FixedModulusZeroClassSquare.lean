noncomputable section

set_option maxHeartbeats 1100000 in
/-- The analytic remainder on a fixed disk centered on the line one, with
an exact resolvent expansion and a conductor-height bound on its norm. -/
theorem nonprincipal_local_analytic_remainder_with_coverage :
    ∃ A : ℝ, 0<A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → ∀ t : ℝ, ∃ Z : Finset ℂ, ∃ G : ℂ→ℂ,
      (∀ ρ∈Z, regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ |ρ.im-t|≤2) ∧
      (∑ ρ∈Z,(analyticOrderNatAt (regularizedL χ) ρ:ℝ))≤A*logHeight q t ∧
      AnalyticOnNhd ℂ G (closedBall (line 1 t) (1/4)) ∧
      (∀ w∈closedBall (line 1 t) (1/4), ‖G w‖≤A*logHeight q t) ∧
      (∀ w∈closedBall (line 1 t) (1/4), 1<w.re →
        -logDeriv χ.LFunction w=G w-
          ∑ ρ∈Z,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)/(w-ρ)) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 t‖≤1/2 → regularizedL χ ρ=0 → ρ∈Z) := by
  let R : ℝ := 15/8
  let A : ℝ := 130200/R
  let D : ℝ := (Real.log (12/11 : ℝ))⁻¹
  have hR : 0<R := by norm_num [R]
  have hA : 0<A := by dsimp [A]; positivity
  have hD : 0<D := inv_pos.mpr (Real.log_pos (by norm_num))
  refine ⟨13*(A+D),by positivity,?_⟩
  intro q _ χ hχ t
  let f := regularizedL χ
  let c := line 2 t
  let K : ℝ := 2+|t|
  let B : ℝ := 900*(q:ℝ)*K^2
  have hq1 : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hq0 : (0:ℝ)<q := zero_lt_one.trans_le hq1
  have hK2 : 2≤K := le_add_of_nonneg_right (abs_nonneg t)
  have hK1 : 1≤K := by linarith only [hK2]
  have hK0 : 0<K := zero_lt_one.trans_le hK1
  have hB0 : 0<B := by dsimp [B]; positivity
  have hB2 : 2≤B := by
    calc
      (2:ℝ) ≤ 900*1*1 := by norm_num
      _ ≤ B := mul_le_mul (mul_le_mul_of_nonneg_left hq1 (by norm_num))
        (one_le_pow₀ hK1) zero_le_one (by positivity)
  have hReLower (w : ℂ) (hw : w∈closedBall c R) : (1/8:ℝ)≤w.re := by
    have hd := mem_closedBall_iff_norm.mp hw
    have hre := Complex.abs_re_le_norm (w-c)
    rw [Complex.sub_re,show c.re=2 by simp [c,line,Complex.mul_re]] at hre
    dsimp only [R] at hd
    linarith only [hre,hd,neg_le_abs (w.re-2)]
  have hcform : c=(2:ℂ)+(t:ℂ)*I := by apply Complex.ext <;> simp [c,line,Complex.mul_re,Complex.mul_im]
  have hcnorm : ‖c‖≤K := by
    rw [hcform]
    exact (norm_add_le _ _).trans_eq (by simp [K,Complex.norm_real,Real.norm_eq_abs])
  have hcEuclidean : c=(⟨2,t⟩:ℂ) := by
    apply Complex.ext <;> simp [c,line,Complex.mul_re,Complex.mul_im]
  have hAnchor : (1/4:ℝ)≤‖f c‖ := by
    rw [hcEuclidean]
    exact norm_regularizedL_anchor χ t
  have hf0 : f c≠0 := norm_pos_iff.mp ((by norm_num : (0:ℝ)<1/4).trans_le hAnchor)
  have hf : AnalyticOnNhd ℂ f (closedBall c R) := (analytic_regularizedL χ).mono (subset_univ _)
  have hfB (w : ℂ) (hw : w∈closedBall c (24/25*R)) : ‖f w‖≤B*‖f c‖ := by
    have hwBig := closedBall_subset_closedBall (show (24/25:ℝ)*R≤R by norm_num [R]) hw
    have hd := mem_closedBall_iff_norm.mp hwBig
