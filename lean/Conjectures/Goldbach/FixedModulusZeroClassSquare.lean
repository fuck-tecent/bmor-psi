namespace GoldbachHybridGrowth

open Complex Finset GoldbachGrhGrowth
open scoped Classical BigOperators

private theorem charPartialSum_eq_sum_Ioc {q : ℕ} (χ : DirichletCharacter ℂ q) (N : ℕ) :
    charPartialSum χ N = ∑ n ∈ Ioc 0 N, χ (n:ZMod q) := by
  calc
    _ = ∑ n ∈ Ico 0 N, χ ((1+n:ℕ):ZMod q) := by
      rw [charPartialSum,Nat.Ico_zero_eq_range]
      apply sum_congr rfl
      intro n _
      rw [Nat.add_comm n 1]
    _ = _ := by
      rw [Finset.sum_Ico_add (fun n : ℕ => χ (n:ZMod q)) 0 N 1]
      rw [Finset.Ico_add_one_add_one_eq_Ioc]


theorem charPartialSum_nonprincipal_bound {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ≠1) (N : ℕ) :
    ‖charPartialSum χ N‖≤2*Real.sqrt q*(1+Real.log q) := by
  rw [charPartialSum_eq_sum_Ioc]
  apply polya_vinogradov_of_primitive (χ:=χ) ?_ hχ N
  intro m _ ψ hψ hp M
  rw [← charPartialSum_eq_sum_Ioc]
  exact charPartialSum_primitive_bound ψ hψ hp M

/-- The Pólya–Vinogradov growth bound for all nonprincipal characters,
including imprimitive products on the off-diagonal. -/
theorem nonprincipal_LFunction_bound {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ≠1)
    {s : ℂ} (hσ : 0<s.re) (hσ₁ : s.re<1) :
    ‖χ.LFunction s‖ ≤ (1/(1-s.re)+1+1/s.re) *
      (8*Real.sqrt q*(1+Real.log q)*(1+|s.im|))^(1-s.re) := by
  have hq : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hB : 1≤Real.sqrt q*(1+Real.log q) := by
    apply one_le_mul_of_one_le_of_one_le
    · simpa using Real.sqrt_le_sqrt hq
    · linarith only [Real.log_nonneg hq]
  have hB' : 1≤2*Real.sqrt q*(1+Real.log q) := by nlinarith only [hB]
  have h := nonprincipal_LFunction_bound_of_partial_sum χ hχ hB'
    (charPartialSum_nonprincipal_bound χ hχ) hσ hσ₁
  rwa [show 4*(2*Real.sqrt q*(1+Real.log q))*(1+|s.im|) =
    8*Real.sqrt q*(1+Real.log q)*(1+|s.im|) by ring] at h

private theorem one_add_log_le_rpow {x ε : ℝ} (hx : 1≤x) (hε : 0<ε) :
    1+Real.log x ≤ (1+1/ε)*x^ε := by
  have hx0 : 0<x := zero_lt_one.trans_le hx
  have hl := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx0 ε)
  rw [Real.log_rpow hx0] at hl
  have hlog : Real.log x ≤ x^ε/ε := by
    apply (le_div_iff₀ hε).mpr
    linarith only [hl,show Real.log x*ε=ε*Real.log x by ring]
  calc
    _ ≤ x^ε+x^ε/ε := add_le_add (Real.one_le_rpow hx hε.le) hlog
    _ = _ := by ring

/-- Pointwise nonprincipal growth with an arbitrarily small conductor-power loss. -/
theorem nonprincipal_LFunction_rpow_bound {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ≠1) {ε : ℝ} (hε : 0<ε)
    {s : ℂ} (hσ : 0<s.re) (hσ₁ : s.re<1) :
    ‖χ.LFunction s‖ ≤ (1/(1-s.re)+1+1/s.re) *
      (8*(1+1/ε)*(q:ℝ)^(1/2+ε)*(1+|s.im|))^(1-s.re) := by
  have hq : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hq0 : (0:ℝ)<q := zero_lt_one.trans_le hq
  refine (nonprincipal_LFunction_bound χ hχ hσ hσ₁).trans ?_
  have hB : 8*Real.sqrt q*(1+Real.log q)*(1+|s.im|) ≤
      8*(1+1/ε)*(q:ℝ)^(1/2+ε)*(1+|s.im|) := by
    rw [Real.sqrt_eq_rpow,Real.rpow_add hq0]
    calc
      _ ≤ 8*(q:ℝ)^(1/2:ℝ)*((1+1/ε)*(q:ℝ)^ε)*(1+|s.im|) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (one_add_log_le_rpow hq hε) (by positivity))
          (by positivity)
      _ = _ := by ring
  have hbase : 0≤8*Real.sqrt (q:ℝ)*(1+Real.log q)*(1+|s.im|) := by
    have hlog := Real.log_nonneg hq
    positivity
  exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hbase hB (sub_nonneg.mpr hσ₁.le))
    (by have hh : 0<1-s.re := sub_pos.mpr hσ₁; positivity)

end GoldbachHybridGrowth


