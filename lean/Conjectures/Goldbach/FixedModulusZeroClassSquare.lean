private theorem conj_LSeries_term {q : ℕ} (χ : DirichletCharacter ℂ q) (s : ℂ) (n : ℕ) :
    conj (LSeries.term (fun a : ℕ => χ (a : ZMod q)) s n)=
      LSeries.term (fun a : ℕ => χ⁻¹ (a : ZMod q)) (conj s) n := by
  by_cases hn : n=0
  · subst n
    simp [LSeries.term]
  · rw [LSeries.term_of_ne_zero hn,LSeries.term_of_ne_zero hn,map_div₀]
    have hχ : conj (χ (n:ZMod q))=χ⁻¹ (n:ZMod q) := by
      simpa only [RCLike.star_def] using (MulChar.star_apply' χ (n:ZMod q))
    have hp : (n:ℂ).arg≠Real.pi := by
      rw [Complex.natCast_arg]
      exact Real.pi_ne_zero.symm
    have hW := Complex.conj_cpow (n:ℂ) (conj s) hp
    simp only [Complex.conj_natCast,Complex.conj_conj] at hW
    rw [hχ,←hW]

/-- Conjugation of a nonprincipal Dirichlet L-function carries the
character to its inverse. -/
theorem LFunction_inv_conj {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (hχ : χ≠1) (s : ℂ) :
    χ⁻¹.LFunction (conj s)=conj (χ.LFunction s) := by
  let f : ℂ→ℂ := conj ∘ χ.LFunction ∘ conj
  have hi : χ⁻¹≠1 := by simpa using hχ
  have hf : AnalyticOnNhd ℂ f Set.univ := by
    intro z _
    have hd : Differentiable ℂ f := fun v=>
      differentiableAt_conj_conj_iff.mpr ((differentiable_LFunction hχ) (conj v))
    exact hd.analyticAt z
  have hg : AnalyticOnNhd ℂ χ⁻¹.LFunction Set.univ :=
    fun z _=>(differentiable_LFunction hi).analyticAt z
  have hE : f =ᶠ[𝓝 (2:ℂ)] χ⁻¹.LFunction := by
    have hR : ∀ᶠ z : ℂ in 𝓝 (2:ℂ), 1<z.re :=
      continuous_re.continuousAt.eventually (lt_mem_nhds (by norm_num : (1:ℝ)<(2:ℂ).re))
    filter_upwards [hR] with z hz
    have hz' : 1<(conj z).re := by simpa only [Complex.conj_re] using hz
    change conj (χ.LFunction (conj z))=(χ⁻¹).LFunction z
    rw [χ.LFunction_eq_LSeries hz',LFunction_eq_LSeries _ hz]
    unfold LSeries
    rw [Complex.conj_tsum]
    apply tsum_congr
    intro n
    simpa only [Complex.conj_conj] using conj_LSeries_term χ (conj z) n
  have hG := hf.eqOn_of_preconnected_of_eventuallyEq hg isPreconnected_univ (Set.mem_univ (2:ℂ)) hE
    (Set.mem_univ (conj s))
  simpa [f,Function.comp_def] using hG.symm

theorem regularizedL_inv_conj_line_zero {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hχ : χ≠1) {σ t : ℝ} (h : regularizedL χ (line σ t)=0) :
    regularizedL χ⁻¹ (line σ (-t))=0 := by
  have hi : χ⁻¹≠1 := by simpa using hχ
  have hEq : conj (line σ t)=line σ (-t) := by
    apply Complex.ext <;> simp [line,Complex.conj_re,Complex.conj_im]
  rw [←hEq,regularizedL,ite_eq_right hi,LFunction_inv_conj χ hχ]
  rw [regularizedL,ite_eq_right hχ] at h
  simp [h]

end GoldbachPintzWeightedFormula
