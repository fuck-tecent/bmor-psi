open Real Set MeasureTheory intervalIntegral

/-- The negative half of the cosine contributes half of its full square
integral. This is the conductor factor in the disk logarithmic derivative. -/
theorem integral_negative_cos_sq :
    (∫ t in -Real.pi..Real.pi, (max 0 (-Real.cos t))^2) = Real.pi/2 := by
  let F : ℝ → ℝ := fun t => (max 0 (-Real.cos t))^2
  have hF : Continuous F := by dsimp only [F]; fun_prop
  have hπ := Real.pi_pos
  have hL : ∫ t in -Real.pi..-(Real.pi/2), F t =
      ∫ t in -Real.pi..-(Real.pi/2), (Real.cos t)^2 := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [uIcc_of_le (by linarith only [hπ])] at ht
    have hcos : Real.cos t ≤ 0 := by
      rw [← Real.cos_neg t]
      exact Real.cos_nonpos_of_pi_div_two_le_of_le (by linarith only [ht.2]) (by linarith only [ht.1,hπ])
    change (max 0 (-Real.cos t))^2 = _
    rw [max_eq_right (neg_nonneg.mpr hcos),neg_sq]
  have hM : ∫ t in -(Real.pi/2)..Real.pi/2, F t = 0 := by
    rw [← intervalIntegral.integral_zero]
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [uIcc_of_le (by linarith only [hπ])] at ht
    have hcos := Real.cos_nonneg_of_mem_Icc ht
    change (max 0 (-Real.cos t))^2 = 0
    simp [max_eq_left (neg_nonpos.mpr hcos)]
  have hR : ∫ t in Real.pi/2..Real.pi, F t =
      ∫ t in Real.pi/2..Real.pi, (Real.cos t)^2 := by
    refine intervalIntegral.integral_congr fun t ht => ?_
    rw [uIcc_of_le (by linarith only [hπ])] at ht
    have hcos := Real.cos_nonpos_of_pi_div_two_le_of_le ht.1 (by linarith only [ht.2,hπ])
    change (max 0 (-Real.cos t))^2 = _
    rw [max_eq_right (neg_nonneg.mpr hcos),neg_sq]
  change (∫ t in -Real.pi..Real.pi, F t) = _
  rw [← intervalIntegral.integral_add_adjacent_intervals (hF.intervalIntegrable (-Real.pi) (Real.pi/2))
    (hF.intervalIntegrable (Real.pi/2) Real.pi),
    ← intervalIntegral.integral_add_adjacent_intervals (hF.intervalIntegrable (-Real.pi) (-(Real.pi/2)))
    (hF.intervalIntegrable (-(Real.pi/2)) (Real.pi/2)),hL,hM,hR,
    integral_cos_sq,integral_cos_sq]
  simp only [Real.cos_neg,Real.sin_neg,Real.cos_pi_div_two,Real.sin_pi,Real.sin_pi_div_two,mul_zero,zero_mul]
  ring


end GoldbachPintzWeightedFormula
