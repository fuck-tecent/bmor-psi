namespace GoldbachPintzNumerics

open Finset

/-- A minimum deficit above the base cutoff preserves the additional
exponential tail factor in the undamped target moment. -/
theorem cd_raw_sum_le_of_moment {ι : Type*} (S : Finset ι) (ell : ι→ℝ) (m : ι→ℝ)
    {x r κ h h' σ B : ℝ} (hσ : 0 ≤ σ) (hh : h ≤ h')
    (hm : ∀ i∈S,0 ≤ m i) (hMin : ∀ i∈S,h' ≤ ell i)
    (hMoment : (∑ i∈S,m i*cdMomentWeight x r κ h (ell i)) ≤ B) :
    (∑ i∈S,m i*Real.exp (-(2*x+σ)*ell i)) ≤
      Real.exp (-σ*(h'-h))*(Real.exp (-σ*h)*B) := by
  have hFactor : Real.exp (-σ*h')=Real.exp (-σ*(h'-h))*Real.exp (-σ*h) := by
    rw [←Real.exp_add]
    congr 1
    ring
  calc
    _≤∑ i∈S,Real.exp (-σ*h')*(m i*cdMomentWeight x r κ h (ell i)) := by
      apply sum_le_sum
      intro i hi
      rw [cdMomentWeight,max_eq_left (sub_nonpos.mpr (hh.trans (hMin i hi))),mul_zero,sub_zero]
      rw [show -(2*x+σ)*ell i=-(2*x)*ell i+(-σ)*ell i by ring,Real.exp_add]
      have hExp := Real.exp_le_exp.mpr (mul_le_mul_of_nonpos_left (hMin i hi) (neg_nonpos.mpr hσ))
      have hMul := mul_le_mul_of_nonneg_left hExp
        (mul_nonneg (hm i hi) (Real.exp_nonneg (-(2*x)*ell i)))
      convert hMul using 1 <;> ring
    _=Real.exp (-σ*h')*(∑ i∈S,m i*cdMomentWeight x r κ h (ell i)) := (mul_sum _ _ _).symm
    _≤Real.exp (-σ*h')*B := mul_le_mul_of_nonneg_left hMoment (Real.exp_nonneg _)
    _=_ := by rw [hFactor,mul_assoc]

/-- Clip early deficits to the base cutoff while retaining the same
undamped moment bound. -/
theorem cd_clipped_sum_le_of_moment {ι : Type*} (S : Finset ι) (ell : ι→ℝ) (m : ι→ℝ)
    {x r κ h σ B : ℝ} (hσ : 0 ≤ σ) (hClip : (r+κ)/2 ≤ 2*x)
    (hm : ∀ i∈S,0 ≤ m i)
    (hMoment : (∑ i∈S,m i*cdMomentWeight x r κ h (ell i)) ≤ B) :
    (∑ i∈S,m i*Real.exp (-(2*x+σ)*max h (ell i))) ≤ Real.exp (-σ*h)*B := by
  calc
    _ ≤ ∑ i∈S,Real.exp (-σ*h)*(m i*cdMomentWeight x r κ h (ell i)) := by
      apply sum_le_sum
      intro i hi
      rw [cdMomentWeight,←mul_left_comm,←Real.exp_add]
      apply mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (hm i hi)
      by_cases hle : h ≤ ell i
      · rw [max_eq_right hle,max_eq_left (sub_nonpos.mpr hle),mul_zero,sub_zero]
        have hh := mul_le_mul_of_nonneg_left hle hσ
        linarith only [hh]
      · have hlt := le_of_lt (lt_of_not_ge hle)
        rw [max_eq_left hlt,max_eq_right (sub_nonneg.mpr hlt)]
        have hh := mul_le_mul_of_nonneg_right hClip (sub_nonneg.mpr hlt)
        linarith only [hh]
    _ = Real.exp (-σ*h)*(∑ i∈S,m i*cdMomentWeight x r κ h (ell i)) := (mul_sum _ _ _).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left hMoment (Real.exp_nonneg _)

end GoldbachPintzNumerics
end

