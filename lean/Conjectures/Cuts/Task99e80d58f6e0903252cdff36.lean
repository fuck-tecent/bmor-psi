    HasDerivAt suzukiStandardUpperAdjoint
      (∫ x : ℝ in Ioi 0, -x * Real.exp (-s * x - suzukiEin x)) s := by
  let F : ℝ → ℝ → ℝ := fun u x => Real.exp (-u * x - suzukiEin x)
  let F' : ℝ → ℝ → ℝ := fun u x => -x * Real.exp (-u * x - suzukiEin x)
