section

namespace GoldbachLinnik

open Complex Finset Goldbach GoldbachSmoothing GoldbachTwistedMellin DirichletCharacter ArithmeticFunction
open Metric Set
open scoped Classical

noncomputable section

private theorem norm_logDeriv_le_zeta_real {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {s : ℂ} (hs : 1 < s.re) :
    ‖logDeriv (LFunction χ) s‖ ≤ ‖logDeriv riemannZeta (s.re : ℂ)‖ := by
  let g : ℕ → ℂ := fun n => (ArithmeticFunction.vonMangoldt n : ℂ)
  let σ : ℂ := (s.re : ℂ)
  have hσ : 1 < σ.re := hs
  have hg : LSeriesSummable g σ := LSeriesSummable_vonMangoldt hσ
  have hχ : LSeriesSummable (twistedCoefficient χ) s := χ.LSeriesSummable_twist_vonMangoldt hs
  have hterm (n : ℕ) : ‖LSeries.term (twistedCoefficient χ) s n‖ ≤ ‖LSeries.term g σ n‖ := by
    rw [LSeries.norm_term_eq,LSeries.norm_term_eq]
    split
    · rfl
    · apply div_le_div_of_nonneg_right _ (Real.rpow_nonneg (Nat.cast_nonneg _) _)
      simp only [twistedCoefficient, Pi.mul_apply, norm_mul, g]
      exact mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)
  have hreal (n : ℕ) : LSeries.term g σ n = (‖LSeries.term g σ n‖ : ℂ) := by
    by_cases hn : n = 0
    · simp [hn]
    · rw [LSeries.norm_term_eq,ite_eq_right hn,LSeries.term_of_ne_zero hn]
      dsimp only [g,σ,ofReal_re]
      rw [norm_real,Real.norm_eq_abs,abs_of_nonneg (ArithmeticFunction.vonMangoldt_nonneg (n := n)),
        ofReal_div, ofReal_cpow (Nat.cast_nonneg _),ofReal_natCast]
  have heq : ‖LSeries g σ‖ = ∑' n, ‖LSeries.term g σ n‖ := by
    have he : LSeries g σ = ((∑' n, ‖LSeries.term g σ n‖ : ℝ):ℂ) := by
      rw [Complex.ofReal_tsum]
      exact tsum_congr hreal
    rw [he,norm_real,Real.norm_eq_abs,abs_of_nonneg (tsum_nonneg (fun _ => norm_nonneg _))]
  calc
    _ = ‖LSeries (twistedCoefficient χ) s‖ := by rw [LSeries_twistedCoefficient_eq χ hs,norm_neg]
    _ ≤ ∑' n, ‖LSeries.term (twistedCoefficient χ) s n‖ :=
      norm_tsum_le_tsum_norm hχ.norm
    _ ≤ ∑' n, ‖LSeries.term g σ n‖ := hχ.norm.tsum_le_tsum hterm hg.norm
    _ = _ := by
      rw [← heq]
      change ‖LSeries (fun n => (ArithmeticFunction.vonMangoldt n : ℂ)) σ‖ = _
      simp only [LSeries_vonMangoldt_eq_deriv_riemannZeta_div hσ,neg_div,norm_neg,logDeriv,Pi.div_apply,σ]

private theorem norm_logDeriv_regularized_zeta_bounded : ∃ B : ℝ, 0 < B ∧
    ∀ x ∈ Set.Icc (1:ℝ) 2,
      ‖logDeriv (regularizedL (1 : DirichletCharacter ℂ 1)) (x : ℂ)‖ ≤ B := by
  let f := regularizedL (1 : DirichletCharacter ℂ 1)
  have hf (s : ℂ) : AnalyticAt ℂ f s := analytic_regularizedL _ s (mem_univ _)
  have hn (x : ℝ) (hx : 1 ≤ x) : f (x : ℂ) ≠ 0 := by
    rcases eq_or_lt_of_le hx with rfl | hx'
    · exact regularizedL_ne_zero_at_one _
    · exact regularizedL_ne_zero_right _ (by simpa only [ofReal_re] using hx')
  have hc : ContinuousOn (fun x : ℝ => ‖logDeriv f (x : ℂ)‖) (Set.Icc (1:ℝ) 2) := by
    intro x hx
    have hq : ContinuousAt (logDeriv f) (x : ℂ) :=
      (hf (x:ℂ)).deriv.continuousAt.div (hf (x:ℂ)).continuousAt (hn x hx.1)
    exact (hq.norm.comp (continuous_ofReal.continuousAt : ContinuousAt (fun t : ℝ => (t:ℂ)) x)).continuousWithinAt
  obtain ⟨B,hB⟩ := isCompact_Icc.bddAbove_image hc
  refine ⟨max 1 B,lt_of_lt_of_le zero_lt_one (le_max_left _ _),?_⟩
  intro x hx
  exact (hB ⟨x,hx,rfl⟩).trans (le_max_right _ _)

private theorem norm_pole_le {w : ℂ} (hw : 1 < w.re) :
    ‖(1:ℂ)/(w-1)‖ ≤ (w.re-1)⁻¹ := by
  have hδ : 0 < w.re-1 := sub_pos.mpr hw
  have hsep : w.re-1 ≤ ‖w-1‖ := by
    have h := abs_re_le_norm (w-1)
    rwa [sub_re,one_re,abs_of_nonneg hδ.le] at h
  rw [norm_div,norm_one,← one_div (w.re-1)]
  exact one_div_le_one_div_of_le hδ hsep

private theorem norm_logDeriv_zeta_at_right : ∃ B : ℝ, 0 < B ∧
    ∀ σ : ℝ, 1 < σ → σ ≤ 2 → ‖logDeriv riemannZeta (σ:ℂ)‖ ≤ B+(σ-1)⁻¹ := by
  obtain ⟨B,hB,hbound⟩ := norm_logDeriv_regularized_zeta_bounded
  refine ⟨B,hB,?_⟩
  intro σ hσ hσ₂
  let x : ℂ := (σ:ℂ)
  let χ : DirichletCharacter ℂ 1 := 1
  have hx : 1 < x.re := hσ
  have hx_ne : x ≠ 1 := by intro h; exact hx.not_ge (by simp [h])
  have hL : LFunction χ x ≠ 0 := χ.LFunction_ne_zero_of_one_le_re (Or.inr hx_ne) hx.le
  have he : logDeriv (regularizedL χ) x = logDeriv riemannZeta x + 1/(x-1) := by
    have h := logDeriv_regularizedL_eq χ hx_ne hL
    simpa only [DirichletCharacter.LFunction_modOne_eq,χ,principalFlag,eq_self,ite_true] using h
  have hsub : logDeriv riemannZeta x = logDeriv (regularizedL χ) x - 1/(x-1) :=
    eq_sub_of_add_eq he.symm
  change ‖logDeriv riemannZeta x‖ ≤ _
  rw [hsub]
  exact (norm_sub_le _ _).trans (add_le_add (hbound σ ⟨hσ.le,hσ₂⟩) (norm_pole_le hx))

/-- To the right of one, the only inverse-width loss is the zeta pole. -/
theorem norm_logDeriv_regularized_at_right : ∃ B : ℝ, 0 < B ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (σ t : ℝ), 1 < σ → σ ≤ 2 →
      ‖logDeriv (regularizedL χ) (⟨σ,t⟩ : ℂ)‖ ≤ B+2*(σ-1)⁻¹ := by
  obtain ⟨B,hB,hbound⟩ := norm_logDeriv_zeta_at_right
  refine ⟨B,hB,?_⟩
  intro q _ χ σ t hσ hσ₂
  let s : ℂ := ⟨σ,t⟩
  change ‖logDeriv (regularizedL χ) s‖ ≤ _
  have hs : 1 < s.re := hσ
  have hs_ne : s ≠ 1 := by intro h; exact hs.not_ge (by simp [h])
  have hL : LFunction χ s ≠ 0 := χ.LFunction_ne_zero_of_one_le_re (Or.inr hs_ne) hs.le
  have hm : ‖logDeriv (LFunction χ) s‖ ≤ B+(σ-1)⁻¹ :=
    (norm_logDeriv_le_zeta_real χ hs).trans (hbound σ hσ hσ₂)
  have hflag : ‖principalFlag χ/(s-1)‖ ≤ (σ-1)⁻¹ := by
    by_cases hχ : χ = 1
    · simpa only [principalFlag, hχ, ite_true] using norm_pole_le hs
    · simpa only [principalFlag,hχ,ite_false,zero_div,norm_zero] using
        (inv_pos.mpr (sub_pos.mpr hσ)).le
  rw [logDeriv_regularizedL_eq χ hs_ne hL]
  exact (norm_add_le _ _).trans ((add_le_add hm hflag).trans_eq (by ring))

private theorem re_recip_one_add_lower {δ t : ℝ} {ρ : ℂ}
    (hδ : 0 < δ) (hre : 1-δ ≤ ρ.re) (hre' : ρ.re ≤ 1) (him : |ρ.im-t| ≤ δ/2) :
    1/(5*δ) ≤ ((1:ℂ)/(GoldbachZeroFree.line (1+δ) t-ρ)).re := by
  let u := 1+δ-ρ.re
  let v := t-ρ.im
  have hu₀ : δ ≤ u := by dsimp only [u]; linarith only [hre']
  have hu₁ : u ≤ 2*δ := by dsimp only [u]; linarith only [hre]
  have hu : 0 < u := hδ.trans_le hu₀
  have hv : |v| ≤ δ/2 := by simpa only [v,abs_sub_comm t ρ.im] using him
  have hu₂ : u^2 ≤ (2*δ)^2 := pow_le_pow_left₀ hu.le hu₁ 2
  have hv₂ : v^2 ≤ (δ/2)^2 := by
    simpa only [sq_abs] using pow_le_pow_left₀ (abs_nonneg v) hv 2
  rw [GoldbachZeroFree.re_recip_sub]
  change 1/(5*δ) ≤ u/(u^2+v^2)
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  have hprod := mul_le_mul_of_nonneg_right hu₀ hδ.le
  nlinarith only [hu₂,hv₂,hprod]

private theorem near_zero_in_halfDisk {δ t : ℝ} {ρ : ℂ} (hδ : δ ≤ 1/4)
    (hre : 1-δ ≤ ρ.re) (hre' : ρ.re ≤ 1) (him : |ρ.im-t| ≤ δ/2) :
    ‖ρ-GoldbachZeroFree.line 2 t‖ ≤ 3/2 := by
  have hr : |ρ.re-2| ≤ (5/4:ℝ) := abs_le.mpr ⟨by linarith only [hδ,hre],by linarith only [hre']⟩
  have hi : |ρ.im-t| ≤ (1/8:ℝ) := him.trans (by linarith only [hδ])
  refine (Complex.norm_le_abs_re_add_abs_im _).trans ?_
  change |ρ.re-2|+|ρ.im-t| ≤ 3/2
  linarith only [hr,hi]

set_option maxHeartbeats 900000 in
/-- The Linnik local zero count in a translated rectangle of width and height `δ`,
with full analytic multiplicity and no fixed half-plane hypothesis. -/
theorem local_zero_order_le : ∃ C : ℝ, 0 < C ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (δ t : ℝ), 0 < δ → δ ≤ 1/4 →
      ∀ S : Finset ℂ,
      (∀ ρ ∈ S, 1-δ ≤ ρ.re ∧ ρ.re ≤ 1 ∧ |ρ.im-t| ≤ δ/2 ∧ regularizedL χ ρ = 0) →
      (∑ ρ ∈ S, (analyticOrderNatAt (regularizedL χ) ρ : ℝ)) ≤
        C*(1+δ*logHeight q t) := by
  obtain ⟨A,hA,happrox⟩ := GoldbachZeroFree.neg_logDeriv_upper_with_weighted_zeros
  obtain ⟨B,hB,hderiv⟩ := norm_logDeriv_regularized_at_right
  refine ⟨5*(A+B+2),by positivity,?_⟩
  intro q _ χ δ t hδ hδ' S hS
  let f := regularizedL χ
  let s := GoldbachZeroFree.line (1+δ) t
  have hδ₁ : δ ≤ 1 := by linarith only [hδ']
  have hSdisk (ρ : ℂ) (hρ : ρ ∈ S) : regularizedL χ ρ = 0 ∧ ‖ρ-GoldbachZeroFree.line 2 t‖ ≤ 3/2 := by
    obtain ⟨hr,hr',hi,hz⟩ := hS ρ hρ
    exact ⟨hz, near_zero_in_halfDisk hδ' hr hr' hi⟩
  have happrox' := happrox q χ hδ hδ₁ S hSdisk
  have hs : 1 < s.re := by change 1 < 1+δ; linarith only [hδ]
  have hsne : s ≠ 1 := by
    intro h
    have hr := congrArg Complex.re h
    change 1+δ=1 at hr
    linarith only [hδ,hr]
  have hL := χ.LFunction_ne_zero_of_one_le_re (Or.inr hsne) hs.le
  have hre := congrArg Complex.re (logDeriv_regularizedL_eq χ hsne hL)
  rw [Complex.add_re] at hre
  have hmass : (∑ ρ ∈ S, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re) ≤
      A*logHeight q t+‖logDeriv f s‖ := by
    rw [Complex.neg_re] at happrox'
    have h := Complex.re_le_norm (logDeriv f s)
    change (logDeriv f s).re = _ at hre
    change (- (logDeriv χ.LFunction s).re) ≤ A*logHeight q t + (principalFlag χ/(s-1)).re -
      ∑ ρ ∈ S, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re at happrox'
    linarith only [happrox',hre,h]
  have hsum : (∑ ρ ∈ S, (analyticOrderNatAt f ρ:ℝ))/(5*δ) ≤
      ∑ ρ ∈ S, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re := by
    rw [div_eq_mul_inv,Finset.sum_mul]
    apply sum_le_sum
    intro ρ hρ
    obtain ⟨hr,hr',hi,_⟩ := hS ρ hρ
    rw [GoldbachZeroFree.order_recip_sub,← one_div (5*δ)]
    exact mul_le_mul_of_nonneg_left (re_recip_one_add_lower hδ hr hr' hi) (Nat.cast_nonneg _)
  have hd : ‖logDeriv f s‖ ≤ B+2*δ⁻¹ := by
    have h := hderiv q χ (1+δ) t (by linarith only [hδ]) (by linarith only [hδ₁])
    rwa [show 1+δ-1=δ by ring] at h
  have hraw : (∑ ρ ∈ S, (analyticOrderNatAt f ρ:ℝ)) ≤
      (A*logHeight q t+(B+2*δ⁻¹))*(5*δ) :=
    (div_le_iff₀ (by positivity : 0<5*δ)).mp
      (hsum.trans (hmass.trans (add_le_add (le_refl _) hd)))
  have hDL : 0 ≤ δ*logHeight q t := mul_nonneg hδ.le (zero_le_one.trans (logHeight_ge_one q t))
  have hBδ : B*δ ≤ B := mul_le_of_le_one_right hB.le hδ₁
  calc
    _ ≤ _ := hraw
    _ = 5*(A*(δ*logHeight q t)+B*δ+2) := by field_simp [hδ.ne']; ring
    _ ≤ 5*(A*(δ*logHeight q t)+B+2) := by linarith only [hBδ]
    _ ≤ 5*(A+B+2)*(1+δ*logHeight q t) := by
      nlinarith only [hA.le,mul_nonneg hB.le hDL,hDL]

end
end GoldbachLinnik

