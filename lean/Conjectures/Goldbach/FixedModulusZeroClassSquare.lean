theorem fixed_real_gap_of_no_siegel
    (hNS : ∃ c : ℝ, 0<c ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (β : ℝ),
      χ^2=1 → 1-c/Real.log ((q:ℝ)+2)<β → β<1 → χ.LFunction (β:ℂ)≠0) :
    ∃ δ : ℝ, 0<δ ∧ δ≤0.005 ∧ ∀ (q : ℕ) [NeZero q], 2≤q →
      ∀ (χ : DirichletCharacter ℂ q) (β : ℝ), χ≠1 → χ^2=1 →
        regularizedL χ (β:ℂ)=0 → δ≤(1-β)*Real.log (q:ℝ) := by
  obtain ⟨c,hc,h⟩ := hNS
  refine ⟨min (c/2) 0.005,lt_min (by positivity) (by norm_num),min_le_right _ _,?_⟩
  intro q _ hq χ β hχ hχQ hz
  have hz₁ : χ.LFunction (β:ℂ)=0 := by
    simpa only [regularizedL,hχ,ite_false] using hz
  have hβ : β<1 := by
    by_contra! hn
    exact LFunction_ne_zero_of_one_le_re χ (Or.inl hχ) (by simpa only [Complex.ofReal_re] using hn) hz₁
  have hqR : (2:ℝ)≤q := by exact_mod_cast hq
  have hqP : (0:ℝ)<q := by linarith only [hqR]
  have hL : 0<Real.log (q:ℝ) := Real.log_pos (by linarith only [hqR])
  have hLP : 0<Real.log ((q:ℝ)+2) := Real.log_pos (by linarith only [hqR])
  have hb : β≤1-c/Real.log ((q:ℝ)+2) := by
    by_contra! hh
    exact h q χ β hχQ hh hβ hz₁
  have hA : c≤(1-β)*Real.log ((q:ℝ)+2) := (div_le_iff₀ hLP).mp (by linarith only [hb])
  have hqMul : 0≤((q:ℝ)+1)*((q:ℝ)-2) :=
    mul_nonneg (by linarith only [hqR]) (sub_nonneg.mpr hqR)
  have hB : Real.log ((q:ℝ)+2)≤2*Real.log (q:ℝ) := calc
    _ ≤ Real.log ((q:ℝ)^2) := Real.log_le_log (by positivity) (by nlinarith only [hqMul])
    _ = _ := by rw [Real.log_pow]; norm_num
  have hC := mul_le_mul_of_nonneg_left hB (sub_nonneg.mpr hβ.le)
  apply (min_le_left _ _).trans
  nlinarith only [hA,hC]

end GoldbachSignedPairs
end

