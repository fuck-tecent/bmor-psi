        have hy1' : y.1=a := mem_singleton.mp hy1
        obtain ⟨hyG,hyg⟩ := mem_filter.mp hy2
        exact mem_filter.mpr ⟨mem_product.mpr ⟨hy1' ▸ ha,hyG⟩,by rw [hy1',hyg]⟩
  calc
    _ = ∑ _a∈F, ∑ b∈G, (G.filter (fun y => g y=g b)).card := by
      rw [← mul_sum]
      simp
    _ ≤ _ := by
      apply sum_le_sum
      intro a ha
      apply sum_le_sum
      intro b _
      exact hl a ha b
