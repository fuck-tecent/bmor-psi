section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

abbrev MonicDegree (K : Type*) [Field K] (n : ℕ) :=
  { P : K[X] // P.Monic ∧ P.natDegree=n }

noncomputable instance monicDegreeFintype (n : ℕ) : Fintype (MonicDegree K n) :=
  Fintype.ofEquiv (Fin n → K)
    (((monicEquivDegreeLT n).trans (degreeLTEquiv K n).toEquiv).symm)

def evaluationWeight {s : ℕ} (a : Fin s → K) (χ : Fin s → K → ℂ) (P : K[X]) : ℂ :=
  ∏ i, χ i (P.eval (a i))

theorem sum_evaluationWeight_eq_zero_of_card_le {s n : ℕ} (a : Fin s → K)
    (ha : Function.Injective a) (χ : Fin s → K → ℂ) (i : Fin s)
    (hi : ∑ x : K, χ i x=0) (hsn : s ≤ n) :
    ∑ P : MonicDegree K n, evaluationWeight a χ P.val=0 := by
  classical
  let Q := Lagrange.basis univ a i
  have hiU : i ∈ (univ : Finset (Fin s)) := mem_univ _
  have hQself : Q.eval (a i)=1 := Lagrange.eval_basis_self ha.injOn hiU
  have hQoff {j : Fin s} (hj : j ≠ i) : Q.eval (a j)=0 :=
    Lagrange.eval_basis_of_ne hj.symm (mem_univ j)
  have hQ : Q.natDegree < n := by
    change (Lagrange.basis univ a i).natDegree < n
    rw [Lagrange.natDegree_basis ha.injOn hiU,card_univ,Fintype.card_fin]
    have := i.isLt
    omega
  let T (c : K) (P : MonicDegree K n) : MonicDegree K n := by
    have hp : IsMonicOfDegree P.val n := ⟨P.property.2,P.property.1⟩
    have hdeg : (C c*Q).natDegree < n := by
      refine natDegree_mul_le.trans_lt ?_
      simpa using hQ
    have h := hp.add_right hdeg
    exact ⟨P.val+C c*Q,h.monic,h.natDegree_eq⟩
  have hT (c : K) : Function.Bijective (T c) := by
    apply Finite.injective_iff_bijective.mp
    intro P R h
    have h' := congrArg Subtype.val h
    change P.val+C c*Q=R.val+C c*Q at h'
    exact Subtype.ext (add_right_cancel h')
  let S : ℂ := ∑ P : MonicDegree K n, evaluationWeight a χ P.val
  let W (c : K) (P : MonicDegree K n) := evaluationWeight a χ (T c P).val
  have hAcross (P : MonicDegree K n) : ∑ c : K, W c P=0 := by
    have hn (c : K) : W c P =
        (∏ j ∈ univ.erase i, χ j (P.val.eval (a j))) * χ i (P.val.eval (a i)+c) := by
      change (∏ j, χ j ((P.val+C c*Q).eval (a j)))=_
      rw [← prod_erase_mul _ _ hiU]
      congr 1
      · apply prod_congr rfl
        intro j hj
        have h := hQoff (mem_erase.mp hj).1
        simp [h]
      · simp [hQself]
    simp_rw [hn,← mul_sum]
    have hs : (∑ c : K, χ i (P.val.eval (a i)+c))=0 := by
      simpa using (Equiv.sum_comp (Equiv.addLeft (P.val.eval (a i))) (χ i)).trans hi
    rw [hs,mul_zero]
  have hEach (c : K) : ∑ P : MonicDegree K n, W c P=S :=
    (Equiv.ofBijective (T c) (hT c)).sum_comp (fun P => evaluationWeight a χ P.val)
  have hZ : (Fintype.card K:ℂ)*S=0 := by
    calc
      _ = ∑ c : K,S := by simp [nsmul_eq_mul]
      _ = ∑ c : K, ∑ P : MonicDegree K n,W c P := by simp_rw [hEach]
      _ = 0 := by rw [sum_comm]; simp [hAcross]
  exact (mul_eq_zero.mp hZ).resolve_left (by exact_mod_cast Fintype.card_ne_zero)

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset UniqueFactorizationMonoid
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [DecidableEq K]

theorem pow_dvd_iff_le_factor_count {P p : K[X]} (hP : P ≠ 0)
    (hp : Irreducible p) (hpm : p.Monic) (k : ℕ) :
    p^k ∣ P ↔ k ≤ (normalizedFactors P).count p := by
  classical
  rw [pow_dvd_iff_le_emultiplicity,emultiplicity_eq_count_normalizedFactors hp hP,
    hpm.normalize_eq_self]
  norm_cast

theorem natDegree_eq_sum_prime_power_divisors {P : K[X]} (hP : P.Monic) :
    P.natDegree =
      ∑ p ∈ (normalizedFactors P).toFinset,
        ∑ _k ∈ Icc 1 ((normalizedFactors P).count p), p.natDegree := by
  classical
  calc
    P.natDegree = ((normalizedFactors P).map natDegree).sum :=
      (Polynomial.sum_natDegree_normalizedFactors P).symm
    _ = ∑ p ∈ (normalizedFactors P).toFinset,
        (normalizedFactors P).count p*p.natDegree := by
      simpa [nsmul_eq_mul] using (Finset.sum_multiset_map_count (normalizedFactors P) natDegree)
    _ = _ := by
      apply sum_congr rfl
      intro p hp
      rw [sum_const,nsmul_eq_mul,Nat.card_Icc]
      simp

theorem exists_monic_quotient_of_monic_dvd {P D : K[X]}
    (hP : P.Monic) (hD : D.Monic) (h : D ∣ P) :
    ∃! Q : K[X], Q.Monic ∧ Q.natDegree=P.natDegree-D.natDegree ∧ P=D*Q := by
  obtain ⟨Q,rfl⟩ := h
  have hQ0 : Q ≠ 0 := right_ne_zero_of_mul hP.ne_zero
  have hQm : Q.Monic := by
    have ht := hP.leadingCoeff
    rwa [leadingCoeff_mul,hD.leadingCoeff,one_mul] at ht
  refine ⟨Q,⟨hQm,?_ ,rfl⟩,?_⟩
  · rw [natDegree_mul hD.ne_zero hQ0]
    omega
  · rintro R ⟨hRm,hRd,hReq⟩
    exact mul_left_cancel₀ hD.ne_zero hReq.symm

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial Classical

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

theorem sum_monic_degree_dvd (w : K[X] →* ℂ) (n : ℕ) {D : K[X]}
    (hD : D.Monic) (hDn : D.natDegree ≤ n) :
    (∑ P : MonicDegree K n, if D ∣ P.val then w P.val else 0) =
      w D * ∑ Q : MonicDegree K (n-D.natDegree),w Q.val := by
  classical
  let M := MonicDegree K n
  let B := MonicDegree K (n-D.natDegree)
  let A := { P : M // D ∣ P.val }
  let f (Q : B) : A := by
    have he : (D*Q.val).natDegree=n := by
      rw [natDegree_mul hD.ne_zero Q.property.1.ne_zero,Q.property.2]
      omega
    exact ⟨⟨D*Q.val,hD.mul Q.property.1,he⟩,⟨Q.val,rfl⟩⟩
  have hMap : Function.Bijective f := by
    constructor
    · intro Q R h
      have hv : D*Q.val=D*R.val := congrArg (fun P : A => P.val.val) h
      exact Subtype.ext (mul_left_cancel₀ hD.ne_zero hv)
    · intro P
      obtain ⟨Q,⟨hQ,hQdeg,hQeq⟩,_⟩ :=
        exists_monic_quotient_of_monic_dvd P.val.property.1 hD P.property
      refine ⟨⟨Q,hQ,by simpa only [P.val.property.2] using hQdeg⟩,?_⟩
      exact Subtype.ext (Subtype.ext hQeq.symm)
  have hEq := (Equiv.ofBijective f hMap).sum_comp (fun P : A => w P.val.val)
  calc
    _ = ∑ P : A, w P.val.val := by
      rw [← Finset.sum_filter]
      exact Finset.sum_subtype _ (by simp) _
    _ = ∑ Q : B,w (D*Q.val) := hEq.symm
    _ = _ := by
      dsimp [B]
      simp only [map_mul,← mul_sum]

def evaluationWeight_mul {s : ℕ} (a : Fin s → K) (χ : Fin s → MulChar K ℂ) :
    K[X] →* ℂ where
  toFun := evaluationWeight a (fun i => χ i)
  map_one' := by simp [evaluationWeight]
  map_mul' P Q := by simp [evaluationWeight,prod_mul_distrib]

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset UniqueFactorizationMonoid
open scoped Polynomial Classical

noncomputable section

variable {K : Type*} [Field K] [Fintype K] [DecidableEq K]

def monicDegreeLE (K : Type*) [Field K] [Fintype K] [DecidableEq K] (n : ℕ) : Finset K[X] :=
  (range (n+1)).biUnion (fun m => (univ : Finset (MonicDegree K m)).image Subtype.val)

theorem mem_monicDegreeLE {n : ℕ} {P : K[X]} :
    P ∈ monicDegreeLE K n ↔ P.Monic ∧ P.natDegree ≤ n := by
  constructor
  · intro h
    obtain ⟨m,hm,h⟩ := mem_biUnion.mp h
    obtain ⟨Q,_,rfl⟩ := mem_image.mp h
    refine ⟨Q.property.1,?_⟩
    rw [Q.property.2]
    exact Nat.le_of_lt_succ (mem_range.mp hm)
  · intro h
    refine mem_biUnion.mpr ⟨P.natDegree,mem_range.mpr (Nat.lt_succ_of_le h.2),?_⟩
    exact mem_image.mpr ⟨⟨P,h.1,rfl⟩,mem_univ _,rfl⟩

def primePowerDegreeLE (K : Type*) [Field K] [Fintype K] [DecidableEq K] (n : ℕ) : Finset (K[X]×ℕ) :=
  ((monicDegreeLE K n).product (Icc 1 n)).filter
    (fun pk => Irreducible pk.1 ∧ pk.2*pk.1.natDegree ≤ n)

theorem mem_primePowerDegreeLE {n : ℕ} {p : K[X]} {k : ℕ} :
    (p,k) ∈ primePowerDegreeLE K n ↔
      p.Monic ∧ Irreducible p ∧ 1 ≤ k ∧ k*p.natDegree ≤ n := by
  constructor
  · intro h
    obtain ⟨h1,h2,h3⟩ := mem_filter.mp h
    obtain ⟨hp,hk⟩ := mem_product.mp h1
    exact ⟨(mem_monicDegreeLE.mp hp).1,h2,(mem_Icc.mp hk).1,h3⟩
  · rintro ⟨hpm,hp,hk,hn⟩
    have hpn : 1 ≤ p.natDegree := hp.natDegree_pos
    have hpn' : p.natDegree ≤ n :=
      (Nat.le_mul_of_pos_left _ hk).trans hn
    have hkn : k ≤ n := (Nat.le_mul_of_pos_right _ hpn).trans hn
    exact mem_filter.mpr ⟨mem_product.mpr
      ⟨mem_monicDegreeLE.mpr ⟨hpm,hpn'⟩,mem_Icc.mpr ⟨hk,hkn⟩⟩,hp,hn⟩

theorem sum_primePowerDegreeLE_dvd {n : ℕ} {P : K[X]} (hP : P.Monic)
    (hPn : P.natDegree ≤ n) :
    (∑ pk ∈ primePowerDegreeLE K n, if pk.1^pk.2 ∣ P then pk.1.natDegree else 0) =
      P.natDegree := by
  classical
  let S := (normalizedFactors P).toFinset
  let T (p : K[X]) := (Icc 1 ((normalizedFactors P).count p)).image (fun k => (p,k))
  have hST : S.biUnion T = (primePowerDegreeLE K n).filter (fun pk => pk.1^pk.2 ∣ P) := by
    ext pk
    obtain ⟨p,k⟩ := pk
    rw [mem_filter,mem_primePowerDegreeLE]
    constructor
    · intro h
      obtain ⟨p',hp',h⟩ := mem_biUnion.mp h
      obtain ⟨k',hk',he⟩ := mem_image.mp h
      obtain ⟨rfl,rfl⟩ := Prod.mk.inj he
      obtain ⟨hp,hpm,_⟩ :=
        (Polynomial.mem_normalizedFactors_iff hP.ne_zero).mp (Multiset.mem_toFinset.mp hp')
      obtain ⟨hk1,hk2⟩ := mem_Icc.mp hk'
      have hD := (pow_dvd_iff_le_factor_count hP.ne_zero hp hpm _).2 hk2
      have hdeg := natDegree_le_of_dvd hD hP.ne_zero
      rw [natDegree_pow] at hdeg
      exact ⟨⟨hpm,hp,hk1,by simpa [mul_comm] using hdeg.trans hPn⟩,hD⟩
    · rintro ⟨⟨hpm,hp,hk,hkD⟩,hD⟩
      have hk2 := (pow_dvd_iff_le_factor_count hP.ne_zero hp hpm k).1 hD
      have hCount : 0 < (normalizedFactors P).count p := hk.trans hk2
      have hp' : p ∈ S := Multiset.mem_toFinset.mpr (Multiset.count_pos.mp hCount)
      exact mem_biUnion.mpr ⟨p,hp',mem_image.mpr ⟨k,mem_Icc.mpr ⟨hk,hk2⟩,rfl⟩⟩
  have hDisj : (↑S : Set K[X]).PairwiseDisjoint T := by
    intro p hp p' hp' hne
    apply disjoint_left.mpr
    intro pk hk hk'
    obtain ⟨k,_,rfl⟩ := mem_image.mp hk
    obtain ⟨k',_,he⟩ := mem_image.mp hk'
    exact hne (congrArg Prod.fst he).symm
  rw [← sum_filter,← hST,sum_biUnion hDisj,natDegree_eq_sum_prime_power_divisors hP]
  apply sum_congr rfl
  intro p hp
  rw [sum_image]
  intro k _ k' _ he
  exact congrArg Prod.snd he

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial Classical

noncomputable section

variable {K : Type*} [Field K] [Fintype K] [DecidableEq K]

def monicWeightCoeff (w : K[X] →* ℂ) (n : ℕ) : ℂ :=
  ∑ P : MonicDegree K n,w P.val

def primePowerWeightCoeff (w : K[X] →* ℂ) (n : ℕ) : ℂ :=
  ∑ pk ∈ (primePowerDegreeLE K n).filter (fun pk => pk.2*pk.1.natDegree=n),
    (pk.1.natDegree:ℂ)*(w pk.1)^pk.2

@[simp]
theorem monicWeightCoeff_zero (w : K[X] →* ℂ) : monicWeightCoeff w 0=1 := by
  classical
  unfold monicWeightCoeff
  let P : MonicDegree K 0 := ⟨1,monic_one,natDegree_one⟩
  have h (Q : MonicDegree K 0) : Q=P :=
    Subtype.ext (eq_one_of_monic_natDegree_zero Q.property.1 Q.property.2)
  refine (sum_eq_single P ?_ (by simp)).trans ?_
  · intro Q hQ hNe
    exact False.elim (hNe (h Q))
  · exact map_one w


set_option maxHeartbeats 1200000 in
theorem monicWeightCoeff_recursion (w : K[X] →* ℂ) (n : ℕ) :
    (n:ℂ)*monicWeightCoeff w n =
      ∑ m ∈ range (n+1),primePowerWeightCoeff w m*monicWeightCoeff w (n-m) := by
  classical
  let S := primePowerDegreeLE K n
  let d (pk : K[X]×ℕ) := pk.2*pk.1.natDegree
  let W (pk : K[X]×ℕ) := (pk.1.natDegree:ℂ)*(w pk.1)^pk.2
  have hMaps (pk : K[X]×ℕ) (hp : pk ∈ S) : d pk ∈ range (n+1) :=
    mem_range.mpr (Nat.lt_succ_of_le (mem_primePowerDegreeLE.mp hp).2.2.2)
  have hFib {m : ℕ} (hm : m ≤ n) :
      S.filter (fun pk => d pk=m) =
      (primePowerDegreeLE K m).filter (fun pk => d pk=m) := by
    ext pk
    obtain ⟨p,k⟩ := pk
    simp only [mem_filter,S,mem_primePowerDegreeLE,d]
    constructor
    · rintro ⟨⟨hpm,hp,hk,hkn⟩,h⟩
      exact ⟨⟨hpm,hp,hk,h.le⟩,h⟩
    · rintro ⟨⟨hpm,hp,hk,hkm⟩,h⟩
      exact ⟨⟨hpm,hp,hk,hkm.trans hm⟩,h⟩
  calc
    _ = ∑ P : MonicDegree K n, (P.val.natDegree:ℂ)*w P.val := by
      rw [monicWeightCoeff,mul_sum]
      apply sum_congr rfl
      intro P _
      rw [P.property.2]
    _ = ∑ P : MonicDegree K n,∑ pk ∈ S,
          if pk.1^pk.2 ∣ P.val then (pk.1.natDegree:ℂ)*w P.val else 0 := by
      apply sum_congr rfl
      intro P _
      have he := sum_primePowerDegreeLE_dvd P.property.1 P.property.2.le
      change (∑ pk ∈ S, if pk.1^pk.2 ∣ P.val then pk.1.natDegree else 0)=_ at he
      have heC := congrArg (fun m : ℕ => (m:ℂ)) he
      push_cast at heC
      rw [← heC,sum_mul]
      apply sum_congr rfl
      intro pk _
      split <;> simp_all
    _ = ∑ pk ∈ S,W pk * monicWeightCoeff w (n-d pk) := by
      rw [sum_comm]
      apply sum_congr rfl
      intro pk hp
      have h := mem_primePowerDegreeLE.mp hp
      have hdeg : (pk.1^pk.2).natDegree=d pk := by simp [d,mul_comm]
      have hq := sum_monic_degree_dvd w n (h.1.pow pk.2) (hdeg.symm ▸ h.2.2.2)
      have hh : (∑ P : MonicDegree K n, if pk.1^pk.2 ∣ P.val then
          (pk.1.natDegree:ℂ)*w P.val else 0) =
          (pk.1.natDegree:ℂ) * ∑ P : MonicDegree K n, if pk.1^pk.2 ∣ P.val then w P.val else 0 := by
        rw [mul_sum]
        apply sum_congr rfl
        intro P _
        split <;> simp_all
      dsimp only [W]
      rw [hh,hq,hdeg,map_pow,monicWeightCoeff,mul_assoc]
    _ = _ := by
      rw [← sum_fiberwise_of_maps_to hMaps]
      apply sum_congr rfl
      intro m hm
      have hm' := Nat.le_of_lt_succ (mem_range.mp hm)
      rw [hFib hm',primePowerWeightCoeff,sum_mul]
      apply sum_congr rfl
      intro pk hpk
      have hd := (mem_filter.mp hpk).2
      rw [hd]

def monicWeightSeries (w : K[X] →* ℂ) : PowerSeries ℂ :=
  PowerSeries.mk (monicWeightCoeff w)

def primePowerWeightSeries (w : K[X] →* ℂ) : PowerSeries ℂ :=
  PowerSeries.mk (primePowerWeightCoeff w)

theorem derivative_monicWeightSeries (w : K[X] →* ℂ) :
    PowerSeries.X*PowerSeries.derivative (monicWeightSeries w) =
      primePowerWeightSeries w*monicWeightSeries w := by
  ext n
  conv_rhs => rw [PowerSeries.coeff_mul,Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  simp only [monicWeightSeries,primePowerWeightSeries,PowerSeries.coeff_mk]
  rw [← monicWeightCoeff_recursion]
  cases n with
  | zero => simp
  | succ n =>
      rw [PowerSeries.coeff_succ_X_mul,PowerSeries.coeff_derivative]
      simp [monicWeightSeries,PowerSeries.coeff_mk,mul_comm]

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial

noncomputable section

def reciprocalPowerSeries (r : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk (fun n => if n=0 then 0 else r^n)

theorem reciprocalPowerSeries_mul_linear (r : ℂ) :
    (1-PowerSeries.C r*PowerSeries.X)*reciprocalPowerSeries r =
      PowerSeries.C r*PowerSeries.X := by
  rw [sub_mul,one_mul,mul_assoc]
  ext n
  rw [map_sub,PowerSeries.coeff_C_mul,PowerSeries.coeff_C_mul]
  cases n with
  | zero => simp [reciprocalPowerSeries,PowerSeries.coeff_X]
  | succ n =>
      rw [PowerSeries.coeff_succ_X_mul]
      cases n <;> simp [reciprocalPowerSeries,PowerSeries.coeff_X,pow_succ,mul_comm]

def linearSeries (r : ℂ) : PowerSeries ℂ := 1-PowerSeries.C r*PowerSeries.X

theorem derivative_product_linearSeries (R : Multiset ℂ) :
    PowerSeries.X * PowerSeries.derivative (R:=ℂ) (R.map linearSeries).prod =
      -(R.map linearSeries).prod*(R.map reciprocalPowerSeries).sum := by
  classical
  induction R using Multiset.induction_on with
  | empty => simp [PowerSeries.derivative_one]
  | cons r R ih =>
      simp only [Multiset.map_cons,Multiset.prod_cons,Multiset.sum_cons]
      let U := linearSeries r
      let V := (R.map linearSeries).prod
      let W := (R.map reciprocalPowerSeries).sum
      let D := PowerSeries.derivative (R:=ℂ)
      have hd : (PowerSeries.X : PowerSeries ℂ)*D U=-U*reciprocalPowerSeries r := by
        change (PowerSeries.X : PowerSeries ℂ)*
          D (1-PowerSeries.C r*PowerSeries.X)=-U*reciprocalPowerSeries r
        have hr : U*reciprocalPowerSeries r = PowerSeries.C r*PowerSeries.X :=
          reciprocalPowerSeries_mul_linear r
        rw [neg_mul,hr]
        simp [D,map_sub,Derivation.leibniz,PowerSeries.derivative_one,smul_eq_mul,mul_comm]
      change (PowerSeries.X : PowerSeries ℂ)*D (U*V)=-(U*V)*(reciprocalPowerSeries r+W)
      calc
        _ = U*(PowerSeries.X*D V)+V*(PowerSeries.X*D U) := by
          rw [D.leibniz]
          simp only [smul_eq_mul]
          ring
        _ = _ := by
          change (PowerSeries.X : PowerSeries ℂ)*D V=-V*W at ih
          rw [ih,hd]
          ring

theorem exists_product_linearSeries_of_coeff_zero_eq_one (P : ℂ[X]) (hP : P.coeff 0=1) :
    ∃ R : Multiset ℂ, R.card=P.natDegree ∧ (P : PowerSeries ℂ)=(R.map linearSeries).prod := by
  classical
  have hP0 : P ≠ 0 := by intro h; simp [h] at hP
  have hSplits : P.Splits := IsAlgClosed.splits P
  have hNZ (r : ℂ) (hr : r ∈ P.roots) : r ≠ 0 := by
    intro he
    subst r
    have h := (mem_roots hP0).mp hr
    simpa [← Polynomial.coeff_zero_eq_eval_zero,hP] using h
  have hC : P.leadingCoeff*(P.roots.map (fun r => -r)).prod=1 := by
    have h := hSplits.eval_eq_prod_roots 0
    simpa [← Polynomial.coeff_zero_eq_eval_zero,hP] using h.symm
  refine ⟨P.roots.map Inv.inv,by simpa using hSplits.natDegree_eq_card_roots.symm,?_⟩
  let Ξ : ℂ → ℂ[X] := fun r => 1-Polynomial.C r⁻¹*X
  have hfactor : (P.roots.map (fun r => X-Polynomial.C r)).prod =
      (P.roots.map (fun r => Polynomial.C (-r))).prod*(P.roots.map Ξ).prod := by
    rw [← Multiset.prod_map_mul]
    congr 1
    apply Multiset.map_congr rfl
    intro r hr
    have h : (-r)*r⁻¹=-1 := by rw [neg_mul, mul_inv_cancel₀ (hNZ r hr)]
    rw [show Ξ r=1-Polynomial.C r⁻¹*X from rfl,mul_sub,mul_one,← mul_assoc,← map_mul,h]
    simp only [map_neg,map_one,neg_mul,one_mul]
    ring
  have hIdentity : P = (P.roots.map Ξ).prod := by
    calc
      P = Polynomial.C P.leadingCoeff*(P.roots.map (fun r => X-Polynomial.C r)).prod :=
        hSplits.eq_prod_roots
      _ = _ := by
        have hmap : (P.roots.map (fun r => Polynomial.C (-r))).prod =
            Polynomial.C (P.roots.map (fun r => -r)).prod := by
          rw [map_multiset_prod, Multiset.map_map]
          rfl
        rw [hfactor,← mul_assoc,hmap,← map_mul,hC,map_one,one_mul]
  calc
    (P : PowerSeries ℂ) = ((P.roots.map Ξ).prod : PowerSeries ℂ) :=
      congrArg (fun p : ℂ[X] => (p : PowerSeries ℂ)) hIdentity
    _ = _ := by
      change Polynomial.coeToPowerSeries.ringHom ((P.roots.map Ξ).prod) = _
      rw [map_multiset_prod,Multiset.map_map,Multiset.map_map]
      congr 1
      apply Multiset.map_congr rfl
      intro r _
      change ((Ξ r : ℂ[X]) : PowerSeries ℂ) = linearSeries r⁻¹
      simp [Ξ,linearSeries]

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial Classical

noncomputable section

variable {K : Type*} [Field K] [Fintype K] [DecidableEq K]

theorem primePowerWeightCoeff_eq_neg_power_sum (w : K[X] →* ℂ) {s : ℕ} (hs : 0<s)
    (hTail : ∀ n≥s, monicWeightCoeff w n=0) :
    ∃ R : Multiset ℂ, R.card<s ∧ ∀ n : ℕ, n>0 →
      primePowerWeightCoeff w n=-(R.map (fun z => z^n)).sum := by
  classical
  let P : ℂ[X] := ∑ j∈range s,monomial j (monicWeightCoeff w j)
  have hCoeff (n : ℕ) : P.coeff n=monicWeightCoeff w n := by
    unfold P
    rw [finsetSum_coeff]
    by_cases hn : n<s
    · rw [sum_eq_single_of_mem n (mem_range.mpr hn)]
      · simp [coeff_monomial]
      · intro j _ hj
        simp [coeff_monomial,hj,Ne.symm hj]
    · rw [hTail n (le_of_not_gt hn)]
      apply sum_eq_zero
      intro j hj
      have hne : j≠n := fun h => hn (h ▸ mem_range.mp hj)
      simp [coeff_monomial,hne,Ne.symm hne]
  have hP : P.coeff 0=1 := (hCoeff 0).trans (monicWeightCoeff_zero w)
  have hBound : P.natDegree<s := by
    have hh : P.natDegree ≤ s-1 := by
      apply natDegree_sum_le_of_forall_le
      intro j hj
      have h : (monomial j (monicWeightCoeff w j)).natDegree ≤ j := natDegree_monomial_le _
      exact h.trans (by have := mem_range.mp hj; omega)
    omega
  obtain ⟨R,hR,hRe⟩ := exists_product_linearSeries_of_coeff_zero_eq_one P hP
  have hSeries : monicWeightSeries w=(R.map linearSeries).prod := by
    rw [← hRe]
    ext n
    simp [monicWeightSeries,Polynomial.coeff_coe,hCoeff]
  have hD := derivative_monicWeightSeries w
  rw [hSeries,derivative_product_linearSeries,neg_mul,mul_comm] at hD
  have hP0 : (R.map linearSeries).prod ≠ 0 := by
    intro h
    have hz := congrArg (PowerSeries.coeff 0) (hSeries.trans h)
    simpa [monicWeightSeries] using hz
  have hW : primePowerWeightSeries w=-(R.map reciprocalPowerSeries).sum := by
    apply mul_left_cancel₀ hP0
    simpa only [mul_neg,mul_comm,mul_left_comm] using hD.symm
  refine ⟨R,hR.trans_lt hBound,?_⟩
  intro n hn
  have he := congrArg (PowerSeries.coeff n) hW
  rw [map_neg,map_multiset_sum] at he
  have hEval : (⇑(PowerSeries.coeff n) ∘ reciprocalPowerSeries) = (fun z : ℂ => z^n) := by
    funext z
    simp [reciprocalPowerSeries,hn.ne']
  simpa only [primePowerWeightSeries,PowerSeries.coeff_mk,Multiset.map_map,hEval] using he

end
end GoldbachBurgess
end

