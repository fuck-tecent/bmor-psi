namespace GoldbachHybridGrowth

open Complex Finset Set MeasureTheory GoldbachGrhGrowth GoldbachDensityDetector OAI.LargePrimeGaps
open scoped Classical BigOperators

/-! The following four lemmas use the Pólya–Vinogradov argument from
Conjectures.Goldbach.RoughFifthMass, with the same finite Fourier and Gauss
sum estimates already imported by the hybrid large sieve. -/

theorem exponential_kernel_offdiagonal_bound {ι : Type*} [DecidableEq ι] (s : Finset ι) (θ : ι→ℝ)
    {D : ℕ} (hD : 0<D)
    (hsep : ∀ i∈s,∀ j∈s,i≠j→∀ m:ℤ,1/(D:ℝ)≤|θ i-θ j-m|)
    (N : ℕ) {i : ι} (hi : i∈s) :
    (∑ j∈s.erase i,‖∑ n∈Finset.range N,bvExp ((n:ℝ)*(θ j-θ i))‖)≤
      (D:ℝ)*(harmonic D:ℝ) := by
  have h:=exponential_kernel_row_bound s θ hD hsep N hi
  rw [←Finset.sum_erase_add _ _ hi] at h
  have hd : ‖∑ n∈Finset.range N,bvExp ((n:ℝ)*(θ i-θ i))‖=(N:ℝ) := by simp
  rw [hd] at h
  linarith

theorem residue_frequency_separation {q : ℕ} [NeZero q] {a b : ZMod q}
    (hab : a≠b) (m : ℤ) :
    1/(q:ℝ)≤|(a.val:ℝ)/q-(b.val:ℝ)/q-m| := by
  have hz : (a.val:ℤ)-(b.val:ℤ)-m*(q:ℤ)≠0 := by
    intro he
    have h:=congrArg (fun t:ℤ => (t:ZMod q)) he
    simp only [Int.cast_sub,Int.cast_natCast,Int.cast_mul,ZMod.natCast_self,mul_zero,
      sub_zero,Int.cast_zero,ZMod.natCast_zmod_val] at h
    exact hab (sub_eq_zero.mp h)
  have hnum : (1:ℝ)≤|(((a.val:ℤ)-(b.val:ℤ)-m*(q:ℤ)):ℝ)| := by
    exact_mod_cast Int.one_le_abs hz
  have hq : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  have he : (a.val:ℝ)/q-(b.val:ℝ)/q-m=
      ((((a.val:ℤ)-(b.val:ℤ)-m*(q:ℤ)):ℤ):ℝ)/(q:ℝ) := by
    push_cast
    field_simp
  rw [he,abs_div,abs_of_pos hq]
  simpa only [Int.cast_sub,Int.cast_mul,Int.cast_natCast] using
    div_le_div_of_nonneg_right hnum hq.le

theorem modularFourierSum_one {q N : ℕ} [NeZero q] (u : ZMod q) :
    modularFourierSum (q:=q) (fun _:Fin N=>1) u=
      ∑ n∈Finset.range N,bvExp ((n:ℝ)*((u.val:ℝ)/q)) := by
  unfold modularFourierSum
  rw [←Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro n _
  rw [one_mul]
  have he : (((n:ℕ)*u.val:ℕ):ZMod q)=((n:ℕ):ZMod q)*u := by simp
  rw [←he]
  have hh:=ZMod.stdAddChar_coe (N:=q) (((n:ℕ)*u.val:ℕ):ℤ)
  simp only [Int.cast_natCast] at hh
  rw [hh]
  unfold bvExp
  push_cast
  congr 1
  ring

theorem primitive_polya_vinogradov {q : ℕ} (hq : 1<q) {χ : DirichletCharacter ℂ q}
    (hχ : χ.IsPrimitive) (N : ℕ) :
    ‖∑ n:Fin N,χ ((n:ℕ):ZMod q)‖≤Real.sqrt q*(harmonic q:ℝ) := by
  classical
  let : NeZero q := ⟨by omega⟩
  let : Fact (1<q) := ⟨hq⟩
  let θ : ZMod q→ℝ := fun x=>(x.val:ℝ)/q
  let f : ZMod q→ℝ := fun u=>‖∑ n∈Finset.range N,bvExp ((n:ℝ)*θ u)‖
  have hr : (∑ u∈(Finset.univ : Finset (ZMod q)).erase 0,f u)≤(q:ℝ)*(harmonic q:ℝ) := by
    have h:=exponential_kernel_offdiagonal_bound Finset.univ θ (by omega : 0<q)
      (fun _ _ _ _ hne m => residue_frequency_separation hne m) N (Finset.mem_univ (0:ZMod q))
    simpa only [θ,ZMod.val_zero,Nat.cast_zero,zero_div,sub_zero,f] using h
  have hu : Finset.univ.image (fun u:(ZMod q)ˣ=>(u:ZMod q))⊆(Finset.univ : Finset (ZMod q)).erase 0 := by
    intro x hx
    obtain ⟨u,_,rfl⟩:=Finset.mem_image.mp hx
    exact Finset.mem_erase.mpr ⟨Units.ne_zero u,Finset.mem_univ _⟩
  have hg:=primitive_character_gauss_expansion (fun _:Fin N=>1) hχ
  have hnorm : ‖gaussSum (χ⁻¹) ZMod.stdAddChar‖*
      ‖∑ n:Fin N,χ ((n:ℕ):ZMod q)‖≤(q:ℝ)*(harmonic q:ℝ) := by
    calc
      _ = ‖∑ u:(ZMod q)ˣ,modularFourierSum (q:=q) (fun _:Fin N=>1) (u:ZMod q)*(χ⁻¹) u‖ := by
        simpa only [norm_mul,sequenceCharacterSum,one_mul] using congrArg norm hg
      _ ≤ ∑ u:(ZMod q)ˣ,‖modularFourierSum (q:=q) (fun _:Fin N=>1) (u:ZMod q)*(χ⁻¹) u‖ := norm_sum_le _ _
      _ ≤ ∑ u:(ZMod q)ˣ,f (u:ZMod q) := by
        apply Finset.sum_le_sum
        intro u _
        rw [norm_mul,modularFourierSum_one]
        exact mul_le_of_le_one_right (norm_nonneg _) ((χ⁻¹).norm_le_one _)
      _ = ∑ x∈Finset.univ.image (fun u:(ZMod q)ˣ=>(u:ZMod q)),f x := by
        rw [Finset.sum_image Units.val_injective.injOn]
      _ ≤ ∑ x∈(Finset.univ : Finset (ZMod q)).erase 0,f x :=
        Finset.sum_le_sum_of_subset_of_nonneg hu (fun _ _ _ => norm_nonneg _)
      _ ≤ _ := hr
  have hgn : ‖gaussSum (χ⁻¹) ZMod.stdAddChar‖=Real.sqrt q := by
    have hs:=primitive_gauss_norm_sq (primitive_inverse hχ)
    rw [←hs,Real.sqrt_sq (norm_nonneg _)]
  rw [hgn] at hnorm
  have hsq : (Real.sqrt (q:ℝ))^2=(q:ℝ) := Real.sq_sqrt (Nat.cast_nonneg _)
  have hpos : 0<Real.sqrt (q:ℝ) := Real.sqrt_pos.mpr (by exact_mod_cast (show 0<q by omega))
  have he : (q:ℝ)*(harmonic q:ℝ)=Real.sqrt q*(Real.sqrt q*(harmonic q:ℝ)) := by
    calc
      _ = (Real.sqrt (q:ℝ))^2*(harmonic q:ℝ) := by rw [hsq]
      _ = _ := by ring
  rw [he] at hnorm
  exact (mul_le_mul_iff_right₀ hpos).mp hnorm

/-- On the entire right half-plane for a nonprincipal character, cutting the
series costs at most the bounded periodic finite sum times the Abel tail. -/
theorem nonprincipal_truncation_of_partial_sum_bound {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hχ : χ ≠ 1) {B : ℝ} (hB : ∀ M : ℕ, ‖charPartialSum χ M‖ ≤ B) {s : ℂ} (hs : 0 < s.re) {N : ℕ} (hN : 1 ≤ N) :
    ‖DirichletCharacter.LFunction χ s - Lpartial χ N s‖ ≤
      B * (1 + ‖s‖ / s.re) * (N : ℝ) ^ (-s.re) := by
  let c : ℕ → ℂ := fun n => if n = 0 then 0 else χ (n : ZMod q)
  let f : ℝ → ℂ := fun x => (x : ℂ) ^ (-s)
  let F : ℝ → ℂ := fun x => (x : ℂ) ^ (-s - 1) * charPartialSum χ ⌊x⌋₊
  have hn : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hn0 : (0 : ℝ) < N := zero_lt_one.trans_le hn
  have hs0 : s ≠ 0 := by
    intro he
    simp [he] at hs
  have hdiff {x : ℝ} (hx : 0 < x) :
      HasDerivAt f (-s * (x : ℂ) ^ (-s - 1)) x :=
    hasDerivAt_ofReal_cpow_const hx.ne' (neg_ne_zero.mpr hs0)
  have hcont (p : ℂ) : ContinuousOn (fun x : ℝ => (x : ℂ) ^ p) (Set.Ici 1) := by
    intro x hx
    exact (continuousAt_ofReal_cpow_const x p
      (Or.inr (zero_lt_one.trans_le hx).ne')).continuousWithinAt
  have hder : IntegrableOn (deriv f) (Set.Icc (1 : ℝ) N) := by
    have hcd : ContinuousOn (fun x : ℝ => -s * (x : ℂ) ^ (-s - 1))
        (Set.Icc (1 : ℝ) N) :=
      continuousOn_const.mul ((hcont _).mono Set.Icc_subset_Ici_self)
    exact (hcd.integrableOn_compact isCompact_Icc).congr_fun
      (fun x hx => (hdiff (zero_lt_one.trans_le hx.1)).deriv.symm) measurableSet_Icc
  have hc (M : ℕ) : (∑ k ∈ Finset.Icc 0 M, c k) = charPartialSum χ M := by
    rw [← Nat.range_succ_eq_Icc_zero, Finset.sum_range_succ']
    simp [c, charPartialSum]
  have habel := sum_mul_eq_sub_integral_mul₀' (c := c) (f := f) (m := N)
    (hc := by simp [c]) (hf_diff := fun x hx => (hdiff (zero_lt_one.trans_le hx.1)).differentiableAt)
    (hf_int := hder)
  have htrunc : (∑ k ∈ Finset.Icc 0 N, f k * c k) = Lpartial χ N s := by
    rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le N), Finset.sum_cons]
    simp only [c, ite_true, mul_zero, zero_add, Lpartial]
    rw [← Finset.Icc_add_one_left_eq_Ioc]
    apply Finset.sum_congr rfl
    intro k hk
    have hpos := (Finset.mem_Icc.mp hk).1
    simp only [ite_eq_right (by omega : k ≠ 0), f, ofReal_natCast, mul_comm]
  have hint₁ : (∫ x in Set.Ioc (1 : ℝ) N,
      deriv f x * ∑ k ∈ Finset.Icc 0 ⌊x⌋₊, c k) = -s * ∫ x in Set.Ioc (1 : ℝ) N, F x := by
    rw [← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Ioc
    intro x hx
    change deriv f x * (∑ k ∈ Finset.Icc 0 ⌊x⌋₊, c k) = -s * F x
    rw [hc, (hdiff (zero_lt_one.trans hx.1)).deriv]
    dsimp only [F]
    ring
  have hrem (x : ℝ) (hx : 0 < x) : ‖F x‖ ≤ B * x ^ (-s.re - 1) := by
    dsimp only [F]
    rw [norm_mul, norm_cpow_eq_rpow_re_of_pos hx, sub_re, neg_re, one_re]
    exact (mul_le_mul_of_nonneg_left (hB _)
      (Real.rpow_nonneg hx.le _)).trans_eq (mul_comm _ _)
  have hp : -s.re - 1 < -1 := by linarith
  have hInt {a : ℝ} (ha : 0 < a) : IntegrableOn F (Set.Ioi a) := by
    have hMajor := (integrableOn_Ioi_rpow_of_lt hp ha).const_mul B
    refine Integrable.mono' hMajor ?_ ?_
    · have hF : Measurable F := ((measurable_ofReal.pow_const _).mul
        ((measurable_of_countable (charPartialSum χ)).comp measurable_id.nat_floor))
      exact hF.aestronglyMeasurable
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      exact hrem x (ha.trans hx)
  have hBase := hInt one_pos
  have hR := hInt hn0
  have hspl : (∫ x in Set.Ioi (1 : ℝ), F x) =
      (∫ x in Set.Ioc (1 : ℝ) N, F x) + ∫ x in Set.Ioi (N : ℝ), F x := by
    rw [← Set.Ioc_union_Ioi_eq_Ioi hn, setIntegral_union
      Set.Ioc_disjoint_Ioi_same measurableSet_Ioi
      (hBase.mono_set Set.Ioc_subset_Ioi_self) hR]
  have hmain : DirichletCharacter.LFunction χ s - Lpartial χ N s =
      s * (∫ x in Set.Ioi (N : ℝ), F x) - f N * charPartialSum χ N := by
    rw [LFunction_eq_remainderMellin χ hχ hs, remainderMellin_eq_integral]
    simp only [charMean_eq, ite_eq_right hχ, mul_zero, sub_zero]
    change s * (∫ x in Set.Ioi (1 : ℝ), F x) - Lpartial χ N s = _
    rw [hspl, ← htrunc, habel, hc, hint₁]
    ring
  have htail : ‖∫ x in Set.Ioi (N : ℝ), F x‖ ≤
      B * (N : ℝ) ^ (-s.re) / s.re := by
    refine (norm_integral_le_of_norm_le
      ((integrableOn_Ioi_rpow_of_lt hp hn0).const_mul B) ?_).trans_eq ?_
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      exact hrem x (hn0.trans hx)
    · rw [integral_const_mul, integral_Ioi_rpow_of_lt hp hn0,
        show -s.re - 1 + 1 = -s.re by ring]
      simp only [div_neg, neg_div, neg_neg, ← mul_div_assoc]
  rw [hmain]
  have hnorm : ‖f N‖ = (N : ℝ) ^ (-s.re) := by
    dsimp only [f]
    rw [norm_cpow_eq_rpow_re_of_pos hn0, neg_re]
  calc
    _ ≤ ‖s‖ * ‖∫ x in Set.Ioi (N : ℝ), F x‖ + ‖f N‖ * ‖charPartialSum χ N‖ := by
      simpa only [norm_mul] using norm_sub_le
        (s * ∫ x in Set.Ioi (N : ℝ), F x) (f N * charPartialSum χ N)
    _ ≤ ‖s‖ * (B * (N : ℝ) ^ (-s.re) / s.re) +
        (N : ℝ) ^ (-s.re) * B := by
      rw [hnorm]
      apply add_le_add (mul_le_mul_of_nonneg_left htail (norm_nonneg _))
      exact mul_le_mul_of_nonneg_left (hB _) (by positivity)
    _ = _ := by ring

/-- Pólya–Vinogradov for the finite sum used in the centered Mellin formula. -/
theorem charPartialSum_primitive_bound {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) (hχ₁ : χ ≠ 1) (N : ℕ) :
    ‖charPartialSum χ N‖ ≤ Real.sqrt q * (1+Real.log q) := by
  have hq : 1<q := by
    by_contra! h
    have hq₁ : q=1 := le_antisymm h (NeZero.pos q)
    subst q
    exact hχ₁ (Subsingleton.elim _ _)
  let : Fact (1<q) := ⟨hq⟩
  have hp := primitive_polya_vinogradov hq hχ (N+1)
  rw [Fin.sum_univ_eq_sum_range (fun n : ℕ => χ (n:ZMod q)) (N+1),
    Finset.sum_range_succ'] at hp
  have hps : ‖charPartialSum χ N‖ ≤ Real.sqrt q * (harmonic q:ℝ) := by
    simpa [charPartialSum,MulChar.map_zero] using hp
  exact hps.trans (mul_le_mul_of_nonneg_left (harmonic_le_one_add_log q) (Real.sqrt_nonneg _))

theorem Lpartial_norm_le {q : ℕ} (χ : DirichletCharacter ℂ q) {s : ℂ}
    (hσ : 0<s.re) (hσ₁ : s.re<1) {N : ℕ} (hN : 1≤N) :
    ‖Lpartial χ N s‖ ≤ (N:ℝ)^(1-s.re)/(1-s.re) := by
  have hh : 0<1-s.re := sub_pos.mpr hσ₁
  have hanti : AntitoneOn (fun x : ℝ => x^(-s.re)) (Icc (1:ℝ) (N:ℝ)) := by
    intro a ha b _ hab
    exact Real.rpow_le_rpow_of_nonpos (zero_lt_one.trans_le ha.1) hab (neg_nonpos.mpr hσ.le)
  have hint := AntitoneOn.sum_le_integral_Ico hN hanti
  have hshift :
      (∑ n ∈ Ico 1 N, ((n+1:ℕ):ℝ)^(-s.re)) = ∑ n ∈ Ioc 1 N, (n:ℝ)^(-s.re) := by
    calc
      _ = ∑ n ∈ Ico 1 N, ((1+n:ℕ):ℝ)^(-s.re) := by
        apply sum_congr rfl
        intro n _
        rw [Nat.add_comm n 1]
      _ = _ := by
        rw [Finset.sum_Ico_add (fun n : ℕ => (n:ℝ)^(-s.re)) 1 N 1]
        rw [Finset.Ico_add_one_add_one_eq_Ioc]
  rw [hshift,integral_rpow (Or.inl (by linarith only [hσ₁]))] at hint
  rw [Nat.cast_one,Real.one_rpow,show -s.re+1=1-s.re by ring] at hint
  rw [Lpartial]
  calc
    _ ≤ ∑ n ∈ Icc 1 N, (n:ℝ)^(-s.re) := by
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro n hn
      have hn0 : 0<n := (mem_Icc.mp hn).1
      rw [norm_mul,Complex.norm_natCast_cpow_of_pos hn0,Complex.neg_re]
      exact mul_le_of_le_one_left (by positivity) (χ.norm_le_one _)
    _ = 1 + ∑ n ∈ Ioc 1 N, (n:ℝ)^(-s.re) := by
      rw [Finset.Icc_eq_cons_Ioc hN,Finset.sum_cons,Nat.cast_one,Real.one_rpow]
    _ ≤ 1+((N:ℝ)^(1-s.re)-1)/(1-s.re) := add_le_add le_rfl hint
    _ ≤ _ := by
      rw [sub_div]
      have hi : 1≤1/(1-s.re) := (le_div_iff₀ hh).mpr (by linarith only [hσ])
      linarith only [hi]

set_option maxHeartbeats 550000 in
/-- Pólya–Vinogradov growth on any fixed interior vertical line. -/
theorem nonprincipal_LFunction_bound_of_partial_sum {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ₁ : χ ≠ 1) {B : ℝ} (hB : 1≤B)
    (hPartial : ∀ N : ℕ, ‖charPartialSum χ N‖≤B)
    {s : ℂ} (hσ : 0<s.re) (hσ₁ : s.re<1) :
    ‖χ.LFunction s‖ ≤ (1/(1-s.re)+1+1/s.re) * (4*B*(1+|s.im|))^(1-s.re) := by
  let Z : ℝ := B*(1+‖s‖)
  let N : ℕ := ⌈Z⌉₊
  have hB0 : 0≤B := zero_le_one.trans hB
  have hZ : 1≤Z := one_le_mul_of_one_le_of_one_le hB (by linarith only [norm_nonneg s])
  have hZN : Z≤(N:ℝ) := Nat.le_ceil _
  have hN1 : (1:ℝ)≤N := hZ.trans hZN
  have hN : 1≤N := by exact_mod_cast hN1
  have hN2 : (N:ℝ)≤2*Z := by
    have hc := Nat.ceil_lt_add_one (zero_le_one.trans hZ)
    change (N:ℝ)<Z+1 at hc
    linarith only [hc,hZ]
  have hscale : B*(1+‖s‖/s.re)≤(1+1/s.re)*(N:ℝ) := by
    calc
      _ ≤ (1+1/s.re)*Z := by
        change B*(1+‖s‖/s.re) ≤ (1+1/s.re)*(B*(1+‖s‖))
        have he : (1+1/s.re)*(B*(1+‖s‖))-B*(1+‖s‖/s.re) =
            B*(‖s‖+1/s.re) := by ring
        exact sub_nonneg.mp (he.symm ▸ (by positivity : 0≤B*(‖s‖+1/s.re)))
      _ ≤ _ := mul_le_mul_of_nonneg_left hZN (by positivity)
  have htail := nonprincipal_truncation_of_partial_sum_bound χ hχ₁
    hPartial hσ hN
  have hbound := (norm_le_norm_sub_add (χ.LFunction s) (Lpartial χ N s)).trans
    (add_le_add htail (Lpartial_norm_le χ hσ hσ₁ hN))
  have hnorm : ‖s‖≤1+|s.im| := by
    have he : s=(s.re:ℂ)+(s.im:ℂ)*I := by apply Complex.ext <;> simp
    have hn := norm_add_le (s.re:ℂ) ((s.im:ℂ)*I)
    rw [← he,norm_mul,Complex.norm_I,mul_one,Complex.norm_real,Complex.norm_real,
      Real.norm_eq_abs,Real.norm_eq_abs,abs_of_pos hσ] at hn
    linarith only [hn,hσ₁]
  have hNcut : (N:ℝ)≤4*B*(1+|s.im|) := by
    refine hN2.trans ?_
    have hx := mul_le_mul_of_nonneg_left
      (show 1+‖s‖≤2*(1+|s.im|) by linarith only [hnorm,abs_nonneg s.im]) hB0
    dsimp only [Z]
    nlinarith only [hx]
  have hN0 : (0:ℝ)<N := zero_lt_one.trans_le hN1
  have hmain :
      ((1+1/s.re)*(N:ℝ))*(N:ℝ)^(-s.re)+(N:ℝ)^(1-s.re)/(1-s.re) =
        (1/(1-s.re)+1+1/s.re)*(N:ℝ)^(1-s.re) := by
    rw [mul_assoc,← Real.rpow_one_add' hN0.le (by linarith only [hσ₁]),show (1:ℝ)+ -s.re=1-s.re by ring]
    ring
  calc
    _ ≤ B*(1+‖s‖/s.re)*(N:ℝ)^(-s.re)+(N:ℝ)^(1-s.re)/(1-s.re) := hbound
    _ ≤ ((1+1/s.re)*(N:ℝ))*(N:ℝ)^(-s.re)+(N:ℝ)^(1-s.re)/(1-s.re) :=
      (add_le_add) (mul_le_mul_of_nonneg_right hscale (Real.rpow_nonneg hN0.le _)) le_rfl
    _ = (1/(1-s.re)+1+1/s.re)*(N:ℝ)^(1-s.re) := hmain
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow hN0.le hNcut (sub_nonneg.mpr hσ₁.le))
      (by have hh : 0<1-s.re := sub_pos.mpr hσ₁; positivity)

theorem primitive_LFunction_bound {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) (hχ₁ : χ ≠ 1)
    {s : ℂ} (hσ : 0<s.re) (hσ₁ : s.re<1) :
    ‖χ.LFunction s‖ ≤ (1/(1-s.re)+1+1/s.re) *
      (4*Real.sqrt q*(1+Real.log q)*(1+|s.im|))^(1-s.re) := by
  have hq : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hB : 1≤Real.sqrt q*(1+Real.log q) := by
    apply one_le_mul_of_one_le_of_one_le
    · simpa using Real.sqrt_le_sqrt hq
    · linarith only [Real.log_nonneg hq]
  simpa only [mul_assoc] using nonprincipal_LFunction_bound_of_partial_sum χ hχ₁ hB
    (charPartialSum_primitive_bound χ hχ hχ₁) hσ hσ₁

end GoldbachHybridGrowth

end

section

namespace GoldbachPintzDetector

open Complex MeasureTheory GoldbachTypeII

/-- Cubic averaging preserves a square-root growth envelope in the ordinate. -/
theorem criticalIntegral_le_sqrt_envelope {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (γ : ℝ) {B : ℝ} (hB : 0 ≤ B)
    (hL : ∀ t : ℝ, ‖χ.LFunction (((1/2 : ℝ) : ℂ)+(t : ℂ)*I)‖ ≤ B * Real.sqrt (1+|t|)) :
    criticalIntegral χ γ ≤ B * Real.sqrt (1+|γ|) * Real.pi := by
  let C := B * Real.sqrt (1+|γ|)
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  let f (t : ℝ) :=
    cubicWeight t γ * ‖χ.LFunction (((1/2 : ℝ) : ℂ)+(t : ℂ)*I)‖
  let g (t : ℝ) := C * (1+(t-γ)^2)⁻¹
  have hg : Integrable g := by
    have hp := measurePreserving_sub_right (volume : Measure ℝ) γ
    apply Integrable.const_mul _ C
    change Integrable ((fun t : ℝ => (1+t^2)⁻¹) ∘ fun t => t-γ)
    exact hp.integrable_comp_of_integrable integrable_inv_one_add_sq
  have hf (t : ℝ) : f t ≤ g t := by
    let v := t-γ
    have hv : |t| ≤ |v|+|γ| := by
      have he := abs_add_le (t-γ) γ
      simpa only [sub_add_cancel] using he
    have hscale : 1+|t| ≤ (1+|γ|)*(1+|v|) := by
      nlinarith only [hv, mul_nonneg (abs_nonneg γ) (abs_nonneg v)]
    have hsqrt := Real.sqrt_le_sqrt hscale
    rw [Real.sqrt_mul (by positivity : 0 ≤ 1+|γ|)] at hsqrt
    have hv' : Real.sqrt (1+|v|) ≤ 1+|v| :=
      Real.sqrt_le_self_iff.mpr (.inr (by linarith [abs_nonneg v]))
    have hden : 1+v^2 ≤ (1+|v|)^2 := by
      rw [← sq_abs v]
      nlinarith only [abs_nonneg v]
    have hW : 0 ≤ cubicWeight t γ := by unfold cubicWeight; positivity
    calc
      _ ≤ cubicWeight t γ * (B * Real.sqrt (1+|t|)) :=
        mul_le_mul_of_nonneg_left (hL t) hW
      _ ≤ cubicWeight t γ * (C * (1+|v|)) := by
        apply mul_le_mul_of_nonneg_left _ hW
        calc
          _ ≤ B * (Real.sqrt (1+|γ|) * Real.sqrt (1+|v|)) :=
            mul_le_mul_of_nonneg_left hsqrt hB
          _ = C * Real.sqrt (1+|v|) := by dsimp only [C]; ring
          _ ≤ _ := mul_le_mul_of_nonneg_left hv' hC
      _ = C * ((1+|v|)^2)⁻¹ := by
        unfold cubicWeight
        rw [abs_sub_comm γ t]
        change (1/(1+|v|)^3) * (C*(1+|v|)) = _
        have hvpos : (0 : ℝ) < 1+|v| := by positivity
        field_simp
      _ ≤ g t := mul_le_mul_of_nonneg_left (inv_anti₀ (by positivity) hden) hC
  have hn (t : ℝ) : 0 ≤ f t := by dsimp only [f]; unfold cubicWeight; positivity
  calc
    _ ≤ ∫ t, g t := integral_mono_of_nonneg (Filter.Eventually.of_forall hn) hg
      (Filter.Eventually.of_forall hf)
    _ = C * Real.pi := by
      dsimp only [g]
      rw [integral_const_mul]
      simp_rw [sub_eq_add_neg]
      rw [integral_add_right_eq_self (fun t : ℝ => (1+t^2)⁻¹) (-γ), integral_univ_inv_one_add_sq]
    _ = _ := rfl

/-- Explicit critical-line integral estimate for a primitive nonprincipal
character from Pólya–Vinogradov. -/
theorem criticalIntegral_le_primitive {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχp : χ.IsPrimitive) (hχ : χ ≠ 1) (γ : ℝ) :
    criticalIntegral χ γ ≤
      (5 * Real.sqrt (4*Real.sqrt (q : ℝ)*(1+Real.log (q : ℝ)))) *
        Real.sqrt (1+|γ|) * Real.pi := by
  let A := 4*Real.sqrt (q : ℝ)*(1+Real.log (q : ℝ))
  have hq : (1 : ℝ) ≤ q := by exact_mod_cast NeZero.pos q
  have hA : 0 ≤ A := by dsimp only [A]; have := Real.log_nonneg hq; positivity
  apply criticalIntegral_le_sqrt_envelope χ γ (by positivity)
  intro t
  let s : ℂ := ((1/2 : ℝ) : ℂ)+(t : ℂ)*I
  have hre : s.re = (1/2 : ℝ) := by simp [s, Complex.mul_re]
  have him : s.im = t := by simp [s, Complex.mul_im]
  have hL := GoldbachHybridGrowth.primitive_LFunction_bound χ hχp hχ
    (s := s) (by rw [hre]; norm_num) (by rw [hre]; norm_num)
  rw [hre, him] at hL
  change ‖χ.LFunction s‖ ≤ (5*Real.sqrt A)*Real.sqrt (1+|t|)
  calc
    _ ≤ 5 * (A*(1+|t|))^(1/2 : ℝ) := by norm_num [A] at hL ⊢; exact hL
    _ = _ := by rw [← Real.sqrt_eq_rpow, Real.sqrt_mul hA, mul_assoc]

end GoldbachPintzDetector

end

section

namespace GoldbachPintzDetector

open Finset Complex
open GoldbachSieveSeries

theorem polynomialBound_le_sqrt {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {U V W : ℝ} {θ : ℕ → ℝ}
    (hU : 0 < U) (hUV : U < V) (hW : 0 ≤ W) (hθ : ∀ d, |θ d| ≤ 1) :
    polynomialBound χ U V W θ ≤ 12*Real.sqrt V*Real.sqrt W := by
  have hV : 0 ≤ V := (hU.trans hUV).le
  calc
    _ ≤ ∑ d ∈ support V, ∑ e ∈ support W, 1 / Real.sqrt ((d.lcm e : ℕ) : ℝ) :=
      polynomialBound_le_inverse_sqrt_lcm χ hU hUV hθ
    _ ≤ 12*Real.sqrt (⌊V⌋₊ : ℝ)*Real.sqrt (⌊W⌋₊ : ℝ) :=
      lcm_inverse_sqrt_mass ⌊V⌋₊ ⌊W⌋₊
    _ ≤ _ := by
      gcongr
      exacts [Nat.floor_le hV, Nat.floor_le hW]

/-- The compact primitive detector with the left term bounded explicitly
in the conductor and ordinate. -/
theorem compact_detector_lower_primitive {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχp : χ.IsPrimitive) (hχ : χ ≠ 1)
    {ρ : ℂ} (hρ : χ.LFunction ρ = 0) (hlo : 3/4 ≤ ρ.re) (hhi : ρ.re ≤ 1)
    {U V W Y Z : ℝ} {θ : ℕ → ℝ}
    (hZ : 2 ≤ Z) (hZU : Z ≤ U) (hUV : U < V) (hW : 1 ≤ W)
    (hθ₁ : θ 1 = 1) (hθ : ∀ d, |θ d| ≤ 1) (hZY : Z ≤ Y) :
    (1/4 : ℝ) ≤
      ‖∑ n ∈ support Y, LSeries.term (coefficient χ U V W θ) ρ n *
        (differenceWeight Y Z n : ℂ)‖ +
      (250 * (12 * Real.sqrt V * Real.sqrt W) * Y ^ (1/2 - ρ.re)) *
        ((5 * Real.sqrt (4 * Real.sqrt (q : ℝ) * (1 + Real.log (q : ℝ)))) *
          Real.sqrt (1 + |ρ.im|) * Real.pi) := by
  let B := 12 * Real.sqrt V * Real.sqrt W
  have hU : 0 < U := by linarith
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have h := compact_detector_lower hχ hρ hlo hhi hZ hZU hUV hW hθ₁ hZY hB
    (fun _ hs => (norm_polynomial_le_bound χ U V W θ hs).trans
      (polynomialBound_le_sqrt χ hU hUV (zero_le_one.trans hW) hθ))
  have hY : 0 ≤ Y := by linarith
  have hscale : 0 ≤ 250 * B * Y ^ (1/2 - ρ.re) :=
    mul_nonneg (mul_nonneg (by norm_num) hB) (Real.rpow_nonneg hY _)
  exact h.trans (add_le_add_right
    (mul_le_mul_of_nonneg_left (criticalIntegral_le_primitive hχp hχ ρ.im) hscale) _)

end GoldbachPintzDetector

