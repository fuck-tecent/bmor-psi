    filter_upwards [hs,eventually_gt_atTop (1 : ℝ),
      Real.tendsto_log_atTop.eventually_ge_atTop (1 : ℝ)] with X hsmall hX hL
    refine ⟨hX,hL,?_⟩
    simpa only [Real.rpow_natCast,Real.norm_of_nonneg (by positivity : 0≤(Real.log X)^(B+4)),
      Real.norm_of_nonneg (by positivity : 0≤X^(1/6 : ℝ)),one_mul] using hsmall
  exact eventually_atTop.mp he
theorem V209 (Q X h : ℝ) (hQ : 0≤Q) (hX : 0<X) (hh : 0<h)
