/-- The same Selberg theta weights work on every point of the cutoff mesh,
with the sharp coefficient of the principal residue. -/
theorem exists_theta_with_sharp_residue_coefficient {W : ℝ} (hW : 2≤W) :
    ∃ θ : ℕ→ℝ, θ 1=1 ∧ (∀ d, |θ d|≤1) ∧
      ∀ (q : ℕ) [NeZero q],
        let D := Icc 1 ⌊W⌋₊
        let u := fun d => (θ d:ℂ)
        ‖sieveProductPolynomial (1:DirichletCharacter ℂ q) D D u u 1*principalResidueFactor q‖≤
          1/Real.log W := by
  obtain ⟨θ,hθ₁,hθ,_,hSharp⟩ := GoldbachPintzTheta.exists_theta_sharp hW
  refine ⟨θ,hθ₁,hθ,?_⟩
  intro q _
  let D := Icc 1 ⌊W⌋₊
  let u := fun d => (θ d:ℂ)
  let F := ((q.totient:ℝ)/(q:ℝ))*GoldbachPintzTheta.quadratic D θ q
  have hF : 0≤F := mul_nonneg (by positivity)
    (GoldbachPintzTheta.quadratic_nonneg D θ (NeZero.pos q) (fun _ hd=>(mem_Icc.mp hd).1))
  change ‖sieveProductPolynomial (1:DirichletCharacter ℂ q) D D u u 1*principalResidueFactor q‖≤_
  rw [sieveProductPolynomial_principal_one_eq_quadratic,principalResidueFactor_eq_totient]
  rw [show ((GoldbachPintzTheta.quadratic D θ q:ℝ):ℂ)*((q.totient:ℂ)/(q:ℂ))=(F:ℂ) by
    dsimp only [F]; push_cast; ring]
  rw [Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hF]
  exact hSharp q (NeZero.pos q)

end GoldbachSieveSeries
