section

namespace GoldbachSieveSeries

open Complex Finset GoldbachCubicRiesz
open scoped Classical BigOperators

private theorem series_term_one (a : ℕ → ℂ) (n : ℕ) :
    LSeries.term a (1:ℂ) n=a n/(n:ℂ) := by
  by_cases hn : n=0
  · simp [hn]
  · rw [LSeries.term_of_ne_zero hn,Complex.cpow_one]

private theorem coprime_lcm_iff (q d e : ℕ) :
    q.Coprime (d.lcm e) ↔ q.Coprime d ∧ q.Coprime e := by
  constructor
  · intro h
    exact ⟨h.coprime_dvd_right (Nat.dvd_lcm_left _ _),
      h.coprime_dvd_right (Nat.dvd_lcm_right _ _)⟩
  · intro h
    exact (Nat.coprime_mul_iff_right.mpr h).coprime_dvd_right
      (Nat.lcm_dvd (dvd_mul_right d e) (dvd_mul_left e d))

theorem sieveProductPolynomial_principal_one_eq_quadratic {q : ℕ} [NeZero q]
    (S : Finset ℕ) (θ : ℕ → ℝ) :
    sieveProductPolynomial (1:DirichletCharacter ℂ q) S S (fun d => (θ d:ℂ))
      (fun d => (θ d:ℂ)) 1 = (GoldbachPintzTheta.quadratic S θ q:ℂ) := by
  let χ : DirichletCharacter ℂ q := 1
  have hχ (d e : ℕ) :
      χ (d.lcm e:ZMod q) = if q.Coprime d ∧ q.Coprime e then 1 else 0 := by
    have hunit : IsUnit (d.lcm e:ZMod q) ↔ q.Coprime d ∧ q.Coprime e := by
      rw [ZMod.isUnit_iff_coprime,Nat.coprime_comm,coprime_lcm_iff]
    split_ifs with h
    · exact MulChar.one_apply (hunit.mpr h)
    · exact MulChar.map_nonunit χ (hunit.not.mpr h)
  calc
    _ = ∑ d ∈ S, ∑ e ∈ S, χ (d.lcm e:ZMod q) * ((θ d:ℂ)*(θ e:ℂ))/(d.lcm e:ℂ) := by
      change sieveProductPolynomial χ S S (fun d => (θ d:ℂ))
        (fun d => (θ d:ℂ)) 1 = _
      unfold sieveProductPolynomial
      simp_rw [series_term_one,Pi.mul_apply,lcmWeight,Finset.mul_sum,Finset.sum_div]
      rw [sum_comm]
      apply sum_congr rfl
      intro d hd
      rw [sum_comm]
      apply sum_congr rfl
      intro e he
      rw [sum_eq_single (d.lcm e)]
      · simp
      · intro r _ hr
        simp [Ne.symm hr]
      · intro hn
        exact (hn (mem_image.mpr ⟨(d,e),mem_product.mpr ⟨hd,he⟩,rfl⟩)).elim
    _ = _ := by
      unfold GoldbachPintzTheta.quadratic
      simp only [Complex.ofReal_sum,Complex.ofReal_div,Complex.ofReal_mul,Complex.ofReal_natCast]
      simp only [Finset.sum_filter]
      apply sum_congr rfl
      intro d _
      split_ifs with hd
      · apply sum_congr rfl
        intro e _
        by_cases he : q.Coprime e
        · rw [hχ,ite_eq_left (show q.Coprime d ∧ q.Coprime e from ⟨hd,he⟩),
            ite_eq_left he,one_mul]
        · rw [hχ,ite_eq_right (fun h : q.Coprime d ∧ q.Coprime e => he h.2),
            ite_eq_right he,zero_mul,zero_div]
      · apply sum_eq_zero
        intro e _
        simp [hχ,hd]

/-- The exact principal residue is bounded by the real theta quadratic
factor times the compact Riesz bound. -/
theorem norm_theta_principal_gram_residue_le {q : ℕ} [NeZero q]
    (S : Finset ℕ) (hS : ∀ d ∈ S, 0<d) (θ : ℕ → ℝ) {B : ℝ}
    (hθ : ((q.totient:ℝ)/(q:ℝ))*GoldbachPintzTheta.quadratic S θ q≤B)
    {Y U : ℝ} (hU : 1≤U) (hUY : U≤Y) {w : ℂ} (hw : 0 ≤ w.re) (hw₀ : w≠0) :
    ‖gramRieszDifference Y U w *
      sieveProductPolynomial (1:DirichletCharacter ℂ q) S S (fun d => (θ d:ℂ))
        (fun d => (θ d:ℂ)) 1 * principalResidueFactor q‖ ≤
      B * Y^w.re*min (Real.log (Y/U)) (2/‖w‖) := by
  let F := ((q.totient:ℝ)/(q:ℝ))*GoldbachPintzTheta.quadratic S θ q
  have hF : 0≤F := mul_nonneg (by positivity)
    (GoldbachPintzTheta.quadratic_nonneg S θ (NeZero.pos q) hS)
  have hcoef : ((GoldbachPintzTheta.quadratic S θ q:ℝ):ℂ) *
      ((q.totient:ℂ)/(q:ℂ)) = (F:ℂ) := by
    dsimp [F]
    push_cast
    ring
  have hy0 : 0<Y := zero_lt_one.trans_le (hU.trans hUY)
  have hYmin : 0≤Y^w.re*min (Real.log (Y/U)) (2/‖w‖) := by
    apply mul_nonneg (Real.rpow_nonneg hy0.le _)
    apply le_min _ (by positivity)
    exact Real.log_nonneg ((le_div_iff₀ (zero_lt_one.trans_le hU)).mpr (by simpa using hUY))
  rw [sieveProductPolynomial_principal_one_eq_quadratic,principalResidueFactor_eq_totient,
    mul_assoc,hcoef,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hF]
  exact (mul_le_mul (norm_gramRieszDifference_le hU hUY hw hw₀) hθ hF hYmin).trans_eq (by ring)

end GoldbachSieveSeries


end

section

namespace GoldbachPintzCharacters

open DirichletCharacter GoldbachConductorRegroup
open B13BilateralVaughanReductionProof.DyadicMixedB4MoebiusGauss (changeLevel_nat_indicator)
open scoped ComplexConjugate

noncomputable section

def pairCharacter {r s : ℕ} (χ : DirichletCharacter ℂ r) (ψ : DirichletCharacter ℂ s) :
    DirichletCharacter ℂ (r*s) :=
  (changeLevel (dvd_mul_right r s) χ)⁻¹ * changeLevel (dvd_mul_left s r) ψ

theorem pairCharacter_natCast {r s : ℕ} (χ : DirichletCharacter ℂ r)
    (ψ : DirichletCharacter ℂ s) (n : ℕ) :
    pairCharacter χ ψ (n : ZMod (r*s)) = conj (χ (n : ZMod r)) * ψ (n : ZMod s) := by
  unfold pairCharacter
  rw [MulChar.mul_apply, ← MulChar.star_apply',
    changeLevel_nat_indicator (dvd_mul_right r s) χ n,
    changeLevel_nat_indicator (dvd_mul_left s r) ψ n]
  by_cases h : n.Coprime (r*s)
  · simp only [ite_eq_left h, one_mul, starRingEnd_apply]
  · have hn : ¬(n.Coprime r ∧ n.Coprime s) := fun hp => h (Nat.coprime_mul_iff_right.mpr hp)
    have hz : conj (χ (n : ZMod r)) * ψ (n : ZMod s) = 0 := by
      by_cases hr : n.Coprime r
      · have hs : ¬n.Coprime s := fun hs => hn ⟨hr,hs⟩
        rw [ψ.map_nonunit (fun hu => hs ((ZMod.isUnit_iff_coprime n s).mp hu)), mul_zero]
      · rw [χ.map_nonunit (fun hu => hr ((ZMod.isUnit_iff_coprime n r).mp hu))]
        simp
    simp [h,hz]

theorem tag_eq_of_principal_pair {r s : ℕ} [NeZero (r*s)]
    {χ : DirichletCharacter ℂ r} {ψ : DirichletCharacter ℂ s}
    (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive) (h : pairCharacter χ ψ = 1) :
    (⟨r,χ⟩ : Σ q : ℕ, DirichletCharacter ℂ q) = ⟨s,ψ⟩ := by
  have hl : changeLevel (dvd_mul_right r s) χ = changeLevel (dvd_mul_left s r) ψ := by
    have hh : (changeLevel (dvd_mul_right r s) χ)⁻¹ * changeLevel (dvd_mul_left s r) ψ = 1 := h
    exact inv_mul_eq_one.mp hh
  have hc := congrArg (fun ξ : DirichletCharacter ℂ (r*s) =>
    (⟨ξ.conductor,ξ.primitiveCharacter⟩ : Σ q : ℕ, DirichletCharacter ℂ q)) hl
  exact (primitiveCharacter_sigma_changeLevel (dvd_mul_right r s) χ hχ).symm.trans
    (hc.trans (primitiveCharacter_sigma_changeLevel (dvd_mul_left s r) ψ hψ))

theorem pairCharacter_ne_one_of_ne_tag {r s : ℕ} [NeZero (r*s)]
    {χ : DirichletCharacter ℂ r} {ψ : DirichletCharacter ℂ s}
    (hχ : χ.IsPrimitive) (hψ : ψ.IsPrimitive)
    (h : (⟨r,χ⟩ : Σ q : ℕ, DirichletCharacter ℂ q) ≠ ⟨s,ψ⟩) :
    pairCharacter χ ψ ≠ 1 :=
  fun hp => h (tag_eq_of_principal_pair hχ hψ hp)

end
end GoldbachPintzCharacters

end


section

namespace GoldbachHalasz

open Finset Complex
open scoped ComplexConjugate

noncomputable section

def weightedDot {α : Type*} (s : Finset α) (w : α → ℝ) (a b : α → ℂ) : ℂ :=
  ∑ x ∈ s, (w x : ℂ) * a x * conj (b x)

def weightedSquare {α : Type*} (s : Finset α) (w : α → ℝ) (a : α → ℂ) : ℝ :=
  ∑ x ∈ s, w x * ‖a x‖^2

theorem weightedDot_self {α : Type*} (s : Finset α) (w : α → ℝ) (a : α → ℂ) :
    weightedDot s w a a = (weightedSquare s w a : ℂ) := by
  simp only [weightedDot, weightedSquare, Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_pow,
    mul_assoc, Complex.mul_conj']

theorem weightedDot_cauchy {α : Type*} (s : Finset α) (w : α → ℝ) (a b : α → ℂ)
    (hw : ∀ x ∈ s, 0 ≤ w x) :
    ‖weightedDot s w a b‖^2 ≤ weightedSquare s w a * weightedSquare s w b := by
  let u (x : α) := Real.sqrt (w x) * ‖a x‖
  let v (x : α) := Real.sqrt (w x) * ‖b x‖
  have hB : ‖weightedDot s w a b‖ ≤ ∑ x ∈ s, u x * v x := by
    refine (norm_sum_le _ _).trans_eq ?_
    apply sum_congr rfl
    intro x hx
    simp only [norm_mul, Complex.norm_real, Complex.norm_conj, Real.norm_of_nonneg (hw x hx), u, v]
    rw [show Real.sqrt (w x) * ‖a x‖ * (Real.sqrt (w x) * ‖b x‖) =
      (Real.sqrt (w x))^2 * ‖a x‖ * ‖b x‖ by ring, Real.sq_sqrt (hw x hx)]
  have hua : (∑ x ∈ s, u x ^ 2) = weightedSquare s w a := by
    unfold weightedSquare
    exact sum_congr rfl (fun x hx => by simp only [u,mul_pow,Real.sq_sqrt (hw x hx)])
  have hvb : (∑ x ∈ s, v x ^ 2) = weightedSquare s w b := by
    unfold weightedSquare
    exact sum_congr rfl (fun x hx => by simp only [v,mul_pow,Real.sq_sqrt (hw x hx)])
  exact (pow_le_pow_left₀ (norm_nonneg _) hB _).trans (by
    simpa only [hua,hvb] using sum_mul_sq_le_sq_mul_sq s u v)

private def phase (z : ℂ) : ℂ := (‖z‖ : ℂ)⁻¹ * conj z

private theorem phase_mul (z : ℂ) : phase z * z = (‖z‖ : ℂ) := by
  by_cases hz : z = 0
  · simp [hz,phase]
  · unfold phase
    rw [mul_assoc, mul_comm (conj z) z, Complex.mul_conj']
    have hn : (‖z‖ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr hz)
    field_simp

private theorem phase_norm_le (z : ℂ) : ‖phase z‖ ≤ 1 := by
  by_cases hz : z = 0
  · simp [hz,phase]
  · simp [phase, norm_inv, norm_ne_zero_iff.mpr hz]

private def combination {α ι : Type*} (I : Finset ι) (c : ι → ℂ) (b : ι → α → ℂ) (x : α) : ℂ :=
  ∑ i ∈ I, c i * b i x

private theorem dot_combination_right {α ι : Type*} (s : Finset α) (w : α → ℝ)
    (I : Finset ι) (a : α → ℂ) (c : ι → ℂ) (b : ι → α → ℂ) :
    weightedDot s w a (combination I c b) =
      ∑ i ∈ I, conj (c i) * weightedDot s w a (b i) := by
  simp only [weightedDot, combination, map_sum, map_mul, mul_sum]
  rw [sum_comm]
  exact sum_congr rfl (fun i _ => sum_congr rfl (fun _ _ => by ring))

private theorem dot_combination_left {α ι : Type*} (s : Finset α) (w : α → ℝ)
    (I : Finset ι) (a : α → ℂ) (c : ι → ℂ) (b : ι → α → ℂ) :
    weightedDot s w (combination I c b) a =
      ∑ i ∈ I, c i * weightedDot s w (b i) a := by
  simp only [weightedDot, combination, mul_sum, sum_mul]
  rw [sum_comm]
  exact sum_congr rfl (fun i _ => sum_congr rfl (fun _ _ => by ring))

/-- Finite weighted Halász inequality, allowing arbitrary detector phases. -/
theorem halasz {α ι : Type*} (s : Finset α) (I : Finset ι) (w : α → ℝ)
    (a : α → ℂ) (b : ι → α → ℂ) (hw : ∀ x ∈ s, 0 ≤ w x) :
    (∑ i ∈ I, ‖weightedDot s w a (b i)‖)^2 ≤
      weightedSquare s w a * ∑ i ∈ I, ∑ j ∈ I, ‖weightedDot s w (b i) (b j)‖ := by
  let y (i : ι) := weightedDot s w a (b i)
  let c (i : ι) := conj (phase (y i))
  let v := combination I c b
  have hc (i : ι) : ‖c i‖ ≤ 1 := by simpa only [c, Complex.norm_conj] using phase_norm_le (y i)
  have hy : weightedDot s w a v = (↑((∑ i ∈ I, ‖y i‖) : ℝ) : ℂ) := by
    rw [show v = combination I c b from rfl, dot_combination_right]
    rw [Complex.ofReal_sum]
    refine sum_congr rfl (fun i _ => ?_)
    change conj (conj (phase (y i))) * y i = _
    simpa only [starRingEnd_self_apply] using phase_mul (y i)
  have hself : weightedDot s w v v =
      ∑ i ∈ I, ∑ j ∈ I, c i * conj (c j) * weightedDot s w (b i) (b j) := by
    rw [show v = combination I c b from rfl, dot_combination_left]
    apply sum_congr rfl
    intro i _
    rw [dot_combination_right, mul_sum]
    exact sum_congr rfl (fun _ _ => by ring)
  have hpos : 0 ≤ weightedSquare s w v := by
    exact sum_nonneg (fun x hx => mul_nonneg (hw x hx) (sq_nonneg _))
  have hdiag : weightedSquare s w v ≤ ∑ i ∈ I, ∑ j ∈ I, ‖weightedDot s w (b i) (b j)‖ := by
    rw [← Real.norm_of_nonneg hpos, ← Complex.norm_real, ← weightedDot_self, hself]
    refine (norm_sum_le _ _).trans (sum_le_sum (fun i _ => ?_))
    refine (norm_sum_le _ _).trans (sum_le_sum (fun j _ => ?_))
    have hprod : ‖c i‖ * ‖c j‖ ≤ 1 := by
      simpa only [mul_one] using mul_le_mul (hc i) (hc j) (norm_nonneg _) (zero_le_one : (0:ℝ) ≤ 1)
    simpa only [norm_mul, c, Complex.norm_conj] using
      mul_le_of_le_one_left (norm_nonneg (weightedDot s w (b i) (b j))) hprod
  have hE : 0 ≤ weightedSquare s w a := by
    exact sum_nonneg (fun x hx => mul_nonneg (hw x hx) (sq_nonneg _))
  refine le_trans ?_ (mul_le_mul_of_nonneg_left hdiag hE)
  have hs := weightedDot_cauchy s w a v hw
  rw [hy, Complex.norm_real, Real.norm_of_nonneg (sum_nonneg (fun _ _ => norm_nonneg _))] at hs
  exact hs

end
end GoldbachHalasz

end

section

namespace GoldbachHalasz

/-- Remove the logarithm of the number of detected zeros after the small
off-diagonal term has been absorbed. -/
theorem count_le_of_halasz_recursion (A B ε : ℝ) (hA : 0 ≤ A) (hB : 0 ≤ B) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ J ell b : ℝ, 1 ≤ J → b ≤ 1/2 →
      J^2 ≤ A*J*Real.exp (B*ell)*(1+Real.log J)^2 + b*J^2 →
      J ≤ C*Real.exp ((1+ε)*B*ell) := by
  let d := ε/(1+ε)
  let t := 1+ε
  have ht : 0 < t := by dsimp [t]; positivity
  have hd : 0 < d := div_pos hε ht
  have he : 1-d = t⁻¹ := by
    dsimp [d,t]
    field_simp
    ring
  obtain ⟨K,hK,hlog⟩ := GoldbachSpectralGeometry.log_power_le_small_power 2 hd
  let Z := 2*A*K+1
  have hZ : 0 < Z := by dsimp only [Z]; positivity
  refine ⟨Z^t, by positivity, ?_⟩
  intro J ell b hJ hb hmain
  have hJ0 := zero_lt_one.trans_le hJ
  have hfirst : J/2 ≤ A*Real.exp (B*ell)*(1+Real.log J)^2 := by
    have haux : (1/2:ℝ)*J^2 ≤ A*J*Real.exp (B*ell)*(1+Real.log J)^2 := by
      have hbb := mul_le_mul_of_nonneg_right hb (sq_nonneg J)
      linarith only [hbb,hmain]
    apply le_of_mul_le_mul_right _ hJ0
    linear_combination haux
  have hsecond : J ≤ Z*Real.exp (B*ell)*J^d := calc
    _ ≤ 2*(A*Real.exp (B*ell)*(1+Real.log J)^2) := by linarith only [hfirst]
    _ ≤ 2*(A*Real.exp (B*ell)*(K*J^d)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hlog J hJ) (by positivity)) (by positivity)
    _ = (2*A*K)*Real.exp (B*ell)*J^d := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
      (le_add_of_nonneg_right zero_le_one) (by positivity)) (by positivity)
  have hpow : J^(1-d) ≤ Z*Real.exp (B*ell) := by
    rw [Real.rpow_sub hJ0,Real.rpow_one]
    exact (div_le_iff₀ (Real.rpow_pos_of_pos hJ0 _)).mpr hsecond
  have h := Real.rpow_le_rpow (by positivity : 0 ≤ J^(1-d)) hpow ht.le
  rw [← Real.rpow_mul hJ0.le,he,inv_mul_cancel₀ ht.ne',Real.rpow_one,
    Real.mul_rpow hZ.le (Real.exp_nonneg _),← Real.exp_mul] at h
  convert h using 1
  dsimp [t]
  ring_nf

end GoldbachHalasz

end

section

namespace GoldbachPintzHalasz

open Finset Complex GoldbachHalasz
open scoped Classical ComplexConjugate

noncomputable section

/-- The finite family obtained by giving every item its analytic-order copies. -/
def multiplicityTags {ι : Type*} (I : Finset ι) (m : ι → ℕ) : Finset (Σ _ : ι, ℕ) :=
  I.sigma (fun i => range (m i))

theorem sum_multiplicityTags {ι : Type*} (I : Finset ι) (m : ι → ℕ) (f : ι → ℝ) :
    (∑ x ∈ multiplicityTags I m, f x.1) = ∑ i ∈ I, (m i:ℝ)*f i := by
  simp [multiplicityTags,sum_sigma, nsmul_eq_mul]

/-- The detector vector for a fixed character and zero. -/
def detectorVector (θ : ℕ → ℝ) (χ : ℕ → ℂ) (ρ : ℂ) (n : ℕ) : ℂ :=
  conj ((θ n:ℂ)*χ n*(n:ℂ)^(1-ρ))

def detectorSum (S : Finset ℕ) (w ψ θ : ℕ → ℝ) (χ : ℕ → ℂ) (ρ : ℂ) : ℂ :=
  ∑ n ∈ S, (w n:ℂ)*LSeries.term (fun k => (ψ k:ℂ)*(θ k:ℂ)*χ k) ρ n

def gramSum (S : Finset ℕ) (w θ : ℕ → ℝ) (χ η : ℕ → ℂ) (ρ ζ : ℂ) : ℂ :=
  ∑ n ∈ S, (w n:ℂ)*LSeries.term (fun k => (θ k:ℂ)^2*conj (χ k)*η k) (conj ρ+ζ-1) n

/-- The detector is the weighted dot product at the designated zero. -/
theorem detectorSum_eq_weightedDot (S : Finset ℕ) (hS : ∀ n ∈ S, n ≠ 0)
    (w ψ θ : ℕ → ℝ) (χ : ℕ → ℂ) (ρ : ℂ) :
    detectorSum S w ψ θ χ ρ =
      weightedDot S (fun n => w n/(n:ℝ)) (fun n => (ψ n:ℂ)) (detectorVector θ χ ρ) := by
  unfold detectorSum weightedDot
  apply sum_congr rfl
  intro n hn
  have hn₀ : (n:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (hS n hn)
  rw [LSeries.term_of_ne_zero (hS n hn),detectorVector, starRingEnd_self_apply,ofReal_div,ofReal_natCast,
    Complex.cpow_sub _ _ hn₀,Complex.cpow_one]
  field_simp [hn₀]

private theorem conj_nat_cpow (n : ℕ) (s : ℂ) :
    conj ((n:ℂ)^s) = (n:ℂ)^(conj s) := by
  have ha : Complex.arg (n:ℂ) ≠ Real.pi := by simpa only [Complex.natCast_arg] using Real.pi_ne_zero.symm
  simpa only [map_natCast] using (Complex.cpow_conj (n:ℂ) s ha).symm

private theorem gram_cpow {n : ℕ} (hn : n ≠ 0) (ρ ζ : ℂ) :
    (n:ℂ)^(1-conj ρ)*(n:ℂ)^(1-ζ) = (n:ℂ)/(n:ℂ)^(conj ρ+ζ-1) := by
  have hn₀ : (n:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn
  rw [← Complex.cpow_add _ _ hn₀]
  have he : 1-conj ρ+(1-ζ) = 1-(conj ρ+ζ-1) := by ring
  rw [he,Complex.cpow_sub _ _ hn₀,Complex.cpow_one]

/-- Gram entries are finite weighted Dirichlet-series terms of the product character. -/
theorem gramSum_eq_weightedDot (S : Finset ℕ) (hS : ∀ n ∈ S, n ≠ 0)
    (w θ : ℕ → ℝ) (χ η : ℕ → ℂ) (ρ ζ : ℂ) :
    gramSum S w θ χ η ρ ζ =
      weightedDot S (fun n => w n/(n:ℝ)) (detectorVector θ χ ρ) (detectorVector θ η ζ) := by
  unfold gramSum weightedDot
  apply sum_congr rfl
  intro n hn
  have hn₀ : (n:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (hS n hn)
  rw [LSeries.term_of_ne_zero (hS n hn)]
  simp only [detectorVector,starRingEnd_self_apply,ofReal_div,ofReal_natCast,map_mul,map_sub,map_one,
    Complex.conj_ofReal,conj_nat_cpow]
  calc
    _ = ((w n:ℂ)/(n:ℂ))*((θ n:ℂ)^2*conj (χ n)*η n)*
          ((n:ℂ)/(n:ℂ)^(conj ρ+ζ-1)) := by field_simp [hn₀]
    _ = _ := by rw [← gram_cpow (hS n hn)]; ring

def realDivisorWeight (D : Finset ℕ) (a : ℕ → ℝ) (n : ℕ) : ℝ :=
  ∑ d ∈ D, if d ∣ n then a d else 0

theorem cast_realDivisorWeight (D : Finset ℕ) (a : ℕ → ℝ) (n : ℕ) :
    (realDivisorWeight D a n:ℂ) = GoldbachSieveSeries.divisorWeight D (fun d => (a d:ℂ)) n := by
  simp only [realDivisorWeight,GoldbachSieveSeries.divisorWeight,ofReal_sum]
  exact sum_congr rfl (fun d _ => by split <;> simp_all)

/-- The detector matches the product of the two divisor weights. -/
theorem detectorSum_eq_sieveProduct (S D E : Finset ℕ) (w ψ θ : ℕ → ℝ)
    (χ : ℕ → ℂ) (ρ : ℂ) :
    detectorSum S w (realDivisorWeight D ψ) (realDivisorWeight E θ) χ ρ =
      ∑ n ∈ S, LSeries.term (χ * GoldbachSieveSeries.sieveProduct D E
        (fun d => (ψ d:ℂ)) (fun d => (θ d:ℂ))) ρ n*(w n:ℂ) := by
  have he : (fun n => (realDivisorWeight D ψ n:ℂ)*(realDivisorWeight E θ n:ℂ)*χ n) =
      χ * GoldbachSieveSeries.sieveProduct D E (fun d => (ψ d:ℂ)) (fun d => (θ d:ℂ)) := by
    funext n
    simp only [cast_realDivisorWeight,Pi.mul_apply,GoldbachSieveSeries.sieveProduct]
    ring
  unfold detectorSum
  rw [he]
  exact sum_congr rfl (fun _ _ => mul_comm _ _)

/-- The Gram entry uses the square of the divisor weight and the product of the characters. -/
theorem gramSum_eq_sieveSquare (S E : Finset ℕ) (w θ : ℕ → ℝ)
    (χ η : ℕ → ℂ) (ρ ζ : ℂ) :
    gramSum S w (realDivisorWeight E θ) χ η ρ ζ =
      ∑ n ∈ S, LSeries.term ((fun k => conj (χ k)*η k) * GoldbachSieveSeries.sieveProduct E E
        (fun d => (θ d:ℂ)) (fun d => (θ d:ℂ))) (conj ρ+ζ-1) n*(w n:ℂ) := by
  have he : (fun n => (realDivisorWeight E θ n:ℂ)^2*conj (χ n)*η n) =
      (fun k => conj (χ k)*η k) * GoldbachSieveSeries.sieveProduct E E
        (fun d => (θ d:ℂ)) (fun d => (θ d:ℂ)) := by
    funext n
    simp only [cast_realDivisorWeight,Pi.mul_apply,GoldbachSieveSeries.sieveProduct]
    ring
  unfold gramSum
  rw [he]
  exact sum_congr rfl (fun _ _ => mul_comm _ _)

/-- The detector norm for the weighted inner product is a harmonic sum. -/
theorem weightedSquare_detector (S : Finset ℕ) (w ψ : ℕ → ℝ) :
    weightedSquare S (fun n => w n/(n:ℝ)) (fun n => (ψ n:ℂ)) =
      ∑ n ∈ S, (ψ n)^2*w n/(n:ℝ) := by
  unfold weightedSquare
  apply sum_congr rfl
  intro n _
  simp only [Complex.norm_real,Real.norm_eq_abs,sq_abs]
  ring

/-- Apply Halász to the detector family with its full multiplicities. -/
theorem detector_gram_halasz {ι : Type*} (S : Finset ℕ) (hS : ∀ n ∈ S, n ≠ 0)
    (I : Finset ι) (m : ι → ℕ) (w ψ θ : ℕ → ℝ) (hW : ∀ n ∈ S, 0 ≤ w n)
    (χ : ι → ℕ → ℂ) (ρ : ι → ℂ) :
    (∑ i ∈ I, (m i:ℝ)*‖detectorSum S w ψ θ (χ i) (ρ i)‖)^2 ≤
      (∑ n ∈ S, (ψ n)^2*w n/(n:ℝ)) *
        ∑ i ∈ I, (m i:ℝ)*(∑ j ∈ I, (m j:ℝ)*‖gramSum S w θ (χ i) (χ j) (ρ i) (ρ j)‖) := by
  have h := halasz S (multiplicityTags I m) (fun n => w n/(n:ℝ)) (fun n => (ψ n:ℂ))
    (fun j => detectorVector θ (χ j.1) (ρ j.1))
    (fun n hn => div_nonneg (hW n hn) (Nat.cast_nonneg _))
  simp only [← detectorSum_eq_weightedDot S hS,← gramSum_eq_weightedDot S hS,
    weightedSquare_detector] at h
  have hInner (i : ι) := sum_multiplicityTags I m (fun j => ‖gramSum S w θ (χ i) (χ j) (ρ i) (ρ j)‖)
  simp_rw [hInner] at h
  rw [sum_multiplicityTags I m (fun i => ‖detectorSum S w ψ θ (χ i) (ρ i)‖),
    sum_multiplicityTags I m (fun i =>
      ∑ j ∈ I, (m j:ℝ)*‖gramSum S w θ (χ i) (χ j) (ρ i) (ρ j)‖)] at h
  exact h

end
end GoldbachPintzHalasz

end

section

namespace GoldbachPintzCharacters

open Complex Finset GoldbachCubicRiesz GoldbachSieveSeries
open GoldbachPintzHalasz
open scoped ComplexConjugate

/-- The actual Halász Gram entry is the Riesz cutoff difference at the
common character level. -/
theorem compact_gramSum_eq_cutoff_sub {r s : ℕ}
    (χ : DirichletCharacter ℂ r) (ψ : DirichletCharacter ℂ s)
    {Y U : ℝ} (hU : 0 < U) (hUY : U ≤ Y) (W : ℝ) (θ : ℕ → ℝ) (ρ ω : ℂ) :
    gramSum (GoldbachPintzDetector.support Y) (GoldbachPintzDetector.differenceWeight Y U)
      (realDivisorWeight (Icc 1 ⌊W⌋₊) θ)
      (fun n => χ (n : ZMod r)) (fun n => ψ (n : ZMod s)) ρ ω =
    cutoffSum (LSeries.term (gramCoefficient (pairCharacter χ ψ) W θ) (conj ρ+ω-1)) Y -
      cutoffSum (LSeries.term (gramCoefficient (pairCharacter χ ψ) W θ) (conj ρ+ω-1)) U := by
  rw [GoldbachPintzDetector.cutoff_sub_eq_difference _ hU hUY, gramSum_eq_sieveSquare]
  have hcoeff :
      ((fun n : ℕ => conj (χ (n : ZMod r)) * ψ (n : ZMod s)) *
        sieveProduct (Icc 1 ⌊W⌋₊) (Icc 1 ⌊W⌋₊)
          (fun d => (θ d : ℂ)) (fun d => (θ d : ℂ))) =
      gramCoefficient (pairCharacter χ ψ) W θ := by
    funext n
    simp only [Pi.mul_apply, gramCoefficient]
    rw [pairCharacter_natCast χ ψ n]
  rw [hcoeff]

end GoldbachPintzCharacters


