    rw [sub_div]
    linarith only [hβ]
  have hB : 1≤B := Real.one_le_rpow G.log_one (by norm_num)
  have hBL : Real.log B≤8*Real.log L := by dsimp only [B]; rw [Real.log_rpow hL]
  have hγ : |r.2.im|≤L^(1:ℝ) := by
    rw [Real.rpow_one]
    linarith only [hγR,hR,hRU,G.large_log]
  have ht : |r.2.im|≤4*U := by linarith only [hγR,hR,hRU]
  have hT : |r.2.im|+1/4≤T :=
    (G.primeTestWindow (σ:=1) hχ ht (fun _ hz _ => le_of_not_gt
      (fun h => regularizedL_ne_zero_right r.1 h hz))).height
  have h0 := G.log_height 0 (by simp; linarith only [hR,hRU])
  have hγlog := G.log_height _ ht
  have hPL : line p.2.re 0=p.2 := by rw [←hReal,line_of_coordinates]
  have hRL := line_of_coordinates r.2
