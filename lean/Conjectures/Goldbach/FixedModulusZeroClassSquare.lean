noncomputable section

private theorem inverse_fourier_def (f : ℝ→ℂ) :
    VectorFourier.fourierIntegral Real.fourierChar volume (-innerₗ ℝ) f = 𝓕⁻ f := rfl

/-- A right-half-plane resolvent turns the inverse Fourier transform into
its positive-time Laplace integral. This is the exact residue term on the
original vertical line, before applying the local contour formula. -/
theorem inverseFourier_resolvent_integral {K : ℝ→ℂ} (hK : Integrable K)
    {Z : ℂ} (hZ : 0<Z.re) :
    (∫ u : ℝ, K u/(Z-((2*Real.pi*u:ℝ):ℂ)*I)) =
      ∫ v in Ioi (0:ℝ), cexp (-(Z*(v:ℂ)))*(𝓕⁻ K) v := by
  let A : ℝ→ℂ := fun v => (Ioi (0:ℝ)).indicator
    (fun v => cexp (-(Z*(v:ℂ)))) v
  have hA : Integrable A := by
    have hi := integrableOn_exp_mul_complex_Ioi (a:=-Z) (by simpa using hZ) (0:ℝ)
    simpa only [A,neg_mul] using hi.integrable_indicator measurableSet_Ioi
  have hF (u : ℝ) : (𝓕⁻ A) u = (Z-((2*Real.pi*u:ℝ):ℂ)*I)⁻¹ := by
    let w := Z-((2*Real.pi*u:ℝ):ℂ)*I
    have hw : 0<w.re := by simpa [w,Complex.sub_re,Complex.mul_re] using hZ
    rw [Real.fourierInv_eq']
    have hI : (∫ v : ℝ, cexp ((↑(2*Real.pi*⟪v,u⟫_ℝ):ℂ)*I) • A v) =
        ∫ v in Ioi (0:ℝ), cexp ((-w)*(v:ℂ)) := by
      rw [← integral_indicator measurableSet_Ioi]
      apply integral_congr_ae
      filter_upwards with v
      by_cases hv : v∈Ioi (0:ℝ)
      · rw [show A v=cexp (-(Z*(v:ℂ))) from indicator_of_mem hv _,indicator_of_mem hv,
          smul_eq_mul,←Complex.exp_add,Real.inner_apply]
        congr 1
        unfold w
        push_cast
        ring
      · simp [A,hv]
    rw [hI,integral_exp_mul_complex_Ioi (by simpa using hw)]
    simp only [Complex.ofReal_zero,mul_zero,Complex.exp_zero,neg_div_neg_eq,one_div,w]
  have hflip : (-innerₗ ℝ).flip = -innerₗ ℝ := by
    apply LinearMap.ext
    intro x
    apply LinearMap.ext
    intro y
    change -⟪y,x⟫_ℝ = -⟪x,y⟫_ℝ
    rw [real_inner_comm]
  have hc : Continuous (fun p : ℝ×ℝ => (-innerₗ ℝ) p.1 p.2) := continuous_inner.neg
  have h := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (L:=-innerₗ ℝ) (μ:=volume) (ν:=volume) Real.continuous_fourierChar hc hA hK
  simp only [hflip,inverse_fourier_def,smul_eq_mul,hF] at h
  have hJ : (∫ z : ℝ,A z*(𝓕⁻ K) z) =
      ∫ z in Ioi (0:ℝ), cexp (-(Z*(z:ℂ)))*(𝓕⁻ K) z := by
    rw [←integral_indicator measurableSet_Ioi]
    apply integral_congr_ae
    filter_upwards with z
    by_cases hz : z∈Ioi (0:ℝ) <;> simp [A,hz]
  rw [hJ] at h
  rw [← h]
  apply integral_congr_ae
  filter_upwards with u
  rw [div_eq_mul_inv,mul_comm]

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex MeasureTheory Set GradedNear
open scoped FourierTransform InnerProductSpace RealInnerProductSpace ComplexConjugate

noncomputable section

/-- Even extension of the real compact sinh test. -/
def sinhEvenTest (ω ell : ℝ) (t : ℝ) : ℂ := (sinhTest ω ell |t|:ℂ)

private theorem sinhEvenTest_continuous (ω ell : ℝ) : Continuous (sinhEvenTest ω ell) :=
  Complex.continuous_ofReal.comp ((sinhTest_continuous ω ell).comp continuous_abs)

private theorem sinhEvenTest_support (ω ell : ℝ) : Function.support (sinhEvenTest ω ell) ⊆ Icc (-ω) ω := by
  intro t ht
  by_contra hn
  have hs : ω≤|t| := by
    by_contra! h
    exact hn ((abs_le.mp h.le))
  exact ht (by simp [sinhEvenTest,sinhTest_vanish hs])

private theorem sinhEvenTest_integrable (ω ell : ℝ) : Integrable (sinhEvenTest ω ell) :=
  (sinhEvenTest_continuous ω ell).integrable_of_hasCompactSupport
    (HasCompactSupport.of_support_subset_isCompact isCompact_Icc (sinhEvenTest_support ω ell))

private def imaginaryFrequency (u : ℝ) : ℂ := ((2*Real.pi*u:ℝ):ℂ)*I

/-- The Fourier transform of the even sinh test is twice the real part of its
Laplace transform on the imaginary axis. -/
theorem sinhEvenTest_fourier_eq (ω ell u : ℝ) :
    (𝓕 (sinhEvenTest ω ell)) u = ((2*(laplace (sinhTest ω ell) (imaginaryFrequency u)).re:ℝ):ℂ) := by
  let z := imaginaryFrequency u
  let g (t : ℝ) := sinhEvenTest ω ell t*Complex.exp (-(z*(t:ℂ)))
  have hg : Integrable g := by
    have hGc : Continuous g := (sinhEvenTest_continuous ω ell).mul (by fun_prop)
    apply hGc.integrable_of_hasCompactSupport
    refine HasCompactSupport.of_support_subset_isCompact (isCompact_Icc (a:=-ω) (b:=ω)) ?_
    intro t ht
    exact sinhEvenTest_support ω ell (fun h => ht (by simp [g,h]))
  have hEq : (𝓕 (sinhEvenTest ω ell)) u = ∫ t : ℝ, g t := by
    rw [Real.fourier_eq']
    apply integral_congr_ae
    filter_upwards with t
    rw [smul_eq_mul,Real.inner_apply]
    unfold g z imaginaryFrequency
    rw [mul_comm (Complex.exp _) (sinhEvenTest ω ell t)]
    congr 2
    push_cast
    ring
  have hPos : (∫ t in Ioi (0:ℝ), g t) = laplace (sinhTest ω ell) z := by
    apply setIntegral_congr_fun measurableSet_Ioi
    intro t ht
    simp [g,sinhEvenTest,abs_of_pos (show 0<t from ht)]
  have hReflect (t : ℝ) : g t = conj (g (-t)) := by
    simp only [g,sinhEvenTest,abs_neg,Complex.ofReal_neg,map_mul,Complex.conj_ofReal,← Complex.exp_conj]
    congr 2
    simp [z,imaginaryFrequency,Complex.conj_I,map_mul,show conj (2:ℂ)=2 by simpa only [Nat.cast_ofNat] using map_natCast (starRingEnd ℂ) 2]
  have hNeg : (∫ t in Iic (0:ℝ), g t) = conj (laplace (sinhTest ω ell) z) := by
    calc
      _ = ∫ t in Iic (0:ℝ), (fun s => conj (g s)) (-t) :=
        setIntegral_congr_fun measurableSet_Iic (fun t _ => hReflect t)
      _ = _ := by
        rw [integral_comp_neg_Iic 0 (fun s => conj (g s)),neg_zero,integral_conj,hPos]
  rw [hEq,← integral_add_compl measurableSet_Ioi hg,compl_Ioi,hPos,hNeg]
  apply Complex.ext <;> simp <;> ring

/-- A pointwise bound for the positive Fourier spectrum. -/
theorem sinhEvenTest_fourier_bound {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell) (u : ℝ) :
    ‖(𝓕 (sinhEvenTest ω ell)) u‖ ≤
      (4*ell*Real.exp (ell*ω))/(ell^2+(2*Real.pi*u)^2) := by
  let z := imaginaryFrequency u
  let v := z+(ell:ℂ)
  have hvR : v.re=ell := by simp [v,z,imaginaryFrequency,Complex.mul_re]
  have hvN : ‖v‖^2=ell^2+(2*Real.pi*u)^2 := by
    rw [Complex.sq_norm,Complex.normSq_apply,hvR]
    simp [v,z,imaginaryFrequency,Complex.mul_im,pow_two]
  have hv0 : 0<‖v‖ := by
    have h := Complex.re_le_norm v
    rw [hvR] at h
    exact hell.trans_le h
  have hNum : ‖(1:ℂ)-Complex.exp (-(v*(ω:ℂ)))‖≤2 := by
    refine (norm_sub_le _ _).trans ?_
    rw [norm_one,Complex.norm_exp,Complex.neg_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
      mul_zero,sub_zero,hvR]
    have h := Real.exp_le_one_iff.mpr (neg_nonpos.mpr (mul_nonneg hell.le hω.le))
    linarith only [h]
  rw [sinhEvenTest_fourier_eq,Complex.norm_real,Real.norm_eq_abs]
  change |2*(laplace (sinhTest ω ell) z).re| ≤ _
  unfold z imaginaryFrequency
  rw [sinhTest_boundary hω hell,abs_of_nonneg (by positivity)]
  change 2*((ell*Real.exp (ell*ω)/2)*‖windowLaplace ω v‖^2) ≤ _
  rw [windowLaplace,norm_div,div_pow,←hvN]
  have hN := pow_le_pow_left₀ (norm_nonneg _) hNum 2
  have hD := div_le_div_of_nonneg_right hN (sq_nonneg ‖v‖)
  calc
    _ ≤ 2*((ell*Real.exp (ell*ω)/2)*(2^2/‖v‖^2)) := by gcongr
    _ = _ := by ring

/-- The positive Fourier spectrum is integrable, so it may be used as an
actual averaging measure in the sharp log-derivative estimate. -/
theorem sinhEvenTest_fourier_integrable {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell) :
    Integrable (𝓕 (sinhEvenTest ω ell)) := by
  let k : ℝ := min (ell^2) ((2*Real.pi)^2)
  have hk : 0<k := lt_min (by positivity) (by positivity [Real.pi_pos])
  let C := 4*ell*Real.exp (ell*ω)/k
  apply (integrable_inv_one_add_sq.const_mul C).mono'
  · exact (VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
      (innerSL ℝ).continuous₂ (sinhEvenTest_integrable ω ell)).aestronglyMeasurable
  · filter_upwards with u
    have hden : k*(1+u^2)≤ell^2+(2*Real.pi*u)^2 := by
      have hl := min_le_left (ell^2) ((2*Real.pi)^2)
      have hr := mul_le_mul_of_nonneg_right (min_le_right (ell^2) ((2*Real.pi)^2)) (sq_nonneg u)
      dsimp only [k] at *
      nlinarith only [hl,hr]
    exact (sinhEvenTest_fourier_bound hω hell u).trans
      ((div_le_div_of_nonneg_left (by positivity) (by positivity) hden).trans_eq (by
        dsimp only [C]
        rw [div_eq_mul_inv,mul_inv]
        ring))

/-- The total mass and every Fourier moment of the averaging spectrum are
exactly the values of the even compact test. -/
theorem sinhEvenTest_spectrum_fourierInv {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell) (v : ℝ) :
    (𝓕⁻ (𝓕 (sinhEvenTest ω ell))) v = sinhEvenTest ω ell v :=
  (sinhEvenTest_integrable ω ell).fourierInv_fourier_eq (sinhEvenTest_fourier_integrable hω hell)
    (sinhEvenTest_continuous ω ell).continuousAt

/-- Averaging a right-side resolvent against the positive spectrum recovers
exactly the compact zero-test transform at the scaled spectral point. -/
theorem sinhEvenTest_resolvent {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell) {Z : ℂ} (hZ : 0<Z.re) :
    (∫ u : ℝ, (𝓕 (sinhEvenTest ω ell)) u/(Z-((2*Real.pi*u:ℝ):ℂ)*I)) =
      laplace (sinhTest ω ell) Z := by
  rw [inverseFourier_resolvent_integral (sinhEvenTest_fourier_integrable hω hell) hZ,laplace]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro t ht
  change Complex.exp (-(Z*(t:ℂ)))*(𝓕⁻ (𝓕 (sinhEvenTest ω ell))) t = _
  rw [sinhEvenTest_spectrum_fourierInv hω hell,sinhEvenTest,abs_of_pos (show 0<t from ht),mul_comm]

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex MeasureTheory Set Filter GradedNear
open scoped FourierTransform
noncomputable section

def sinhSpectrumWeight (ω ell u : ℝ) : ℝ := ((𝓕 (sinhEvenTest ω ell)) u).re

theorem sinhSpectrumWeight_nonneg {ω ell : ℝ} (hω : 0 < ω) (hell : 0 < ell) (u : ℝ) :
    0 ≤ sinhSpectrumWeight ω ell u := by
  rw [sinhSpectrumWeight,sinhEvenTest_fourier_eq,Complex.ofReal_re]
  change 0≤2*(laplace (sinhTest ω ell) (((2*Real.pi*u:ℝ):ℂ)*I)).re
  rw [sinhTest_boundary hω hell]
  positivity

theorem sinhSpectrumWeight_integrable {ω ell : ℝ} (hω : 0 < ω) (hell : 0 < ell) :
    Integrable (sinhSpectrumWeight ω ell) :=
  (sinhEvenTest_fourier_integrable hω hell).re

theorem sinhSpectrumWeight_integral {ω ell : ℝ} (hω : 0 < ω) (hell : 0 < ell) :
    (∫ u : ℝ,sinhSpectrumWeight ω ell u)=sinhTest ω ell 0 := by
  have h := sinhEvenTest_spectrum_fourierInv hω hell 0
  rw [Real.fourierInv_eq'] at h
  simp only [Real.inner_apply,mul_zero,Complex.ofReal_zero,zero_mul,Complex.exp_zero,one_smul,
    sinhEvenTest,abs_zero] at h
  calc
    _ = (∫ u : ℝ,(𝓕 (sinhEvenTest ω ell)) u).re :=
      integral_re (sinhEvenTest_fourier_integrable hω hell)
    _ = _ := by simpa only [Complex.ofReal_re] using congrArg Complex.re h

theorem integral_tail_le_inv_of_square_bound {f : ℝ→ℝ} (hf : Integrable f)
    {R C : ℝ} (hR : 0 < R) (hC : 0 ≤ C)
    (hbound : ∀ t, R < |t| → f t ≤ C*(|t|)^(-2:ℝ)) :
    (∫ t in (Icc (-R) R)ᶜ, f t) ≤ 2*C/R := by
  have hSet : (Icc (-R) R)ᶜ=Iio (-R)∪Ioi R := by
    ext t
    simp only [mem_compl_iff,mem_Icc,mem_union,mem_Iio,mem_Ioi,not_and_or,not_le]
  have hD : Disjoint (Iio (-R)) (Ioi R) := Set.disjoint_left.mpr fun t ht ht' =>
    (not_lt_of_ge (by linarith only [hR] : -R ≤ R)) (lt_trans ht' ht)
  have hPos := integrableOn_Ioi_rpow_of_lt (by norm_num : (-2:ℝ) <  -1) hR
  have hInt : (∫ t in Ioi R,t^(-2:ℝ))=1/R := by
    rw [integral_Ioi_rpow_of_lt (by norm_num : (-2:ℝ) <  -1) hR]
    norm_num [Real.rpow_neg_one]
  have hPosLe : (∫ t in Ioi R,f t) ≤ C/R := by
    have hCompare (t : ℝ) (ht : t∈Ioi R) : f t ≤ C*t^(-2:ℝ) := by
      have ht' : R<t := ht
      have hT : 0<t := hR.trans ht'
      simpa only [abs_of_pos hT] using hbound t (by rwa [abs_of_pos hT])
    have hi := setIntegral_mono_on hf.integrableOn (hPos.const_mul C) measurableSet_Ioi hCompare
    rw [integral_const_mul,hInt] at hi
    simpa only [mul_one_div] using hi
  have hNegLe : (∫ t in Iio (-R),f t) ≤ C/R := by
    rw [←integral_Iic_eq_integral_Iio,←integral_comp_neg_Ioi]
    have hh : Integrable (fun t : ℝ => f (-t)) :=
      (Measure.measurePreserving_neg (volume : Measure ℝ)).integrable_comp_of_integrable hf
    have hCompare (t : ℝ) (ht : t∈Ioi R) : f (-t) ≤ C*t^(-2:ℝ) := by
      have ht' : R<t := ht
      have hT : 0<t := hR.trans ht'
      simpa only [abs_neg,abs_of_pos hT] using hbound (-t) (by rwa [abs_neg,abs_of_pos hT])
    have hi := setIntegral_mono_on hh.integrableOn (hPos.const_mul C) measurableSet_Ioi hCompare
    rw [integral_const_mul,hInt] at hi
    simpa only [mul_one_div] using hi
  rw [hSet,setIntegral_union hD measurableSet_Ioi hf.integrableOn hf.integrableOn]
  exact (add_le_add hNegLe hPosLe).trans_eq (by ring)

theorem sinhSpectrumWeight_tail_le {ω ell A R : ℝ} (hω : 0 < ω) (hell : 0 < ell)
    (hA : ell ≤ A) (hR : 0 < R) :
    (∫ u in (Icc (-R) R)ᶜ,sinhSpectrumWeight ω ell u) ≤
      2*(4*ell*Real.exp (A*ω))/R := by
  apply integral_tail_le_inv_of_square_bound (sinhSpectrumWeight_integrable hω hell) hR (by positivity)
  intro t ht
  have ht₀ : 0 < |t| := hR.trans ht
  have hD : |t|^2 ≤ ell^2+(2*Real.pi*t)^2 := by
    rw [sq_abs,mul_pow]
    have hpi : (1:ℝ) ≤ (2*Real.pi)^2 := by nlinarith only [Real.pi_gt_three,sq_nonneg (2*Real.pi-1)]
    nlinarith only [sq_nonneg ell,mul_nonneg (sub_nonneg.mpr hpi) (sq_nonneg t)]
  have hE : Real.exp (ell*ω) ≤ Real.exp (A*ω) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hA hω.le)
  calc
    _ ≤ ‖(𝓕 (sinhEvenTest ω ell)) t‖ := Complex.re_le_norm _
    _ ≤ _ := (sinhEvenTest_fourier_bound hω hell t).trans (by
      have hh : 4*ell*Real.exp (ell*ω)/(ell^2+(2*Real.pi*t)^2) ≤
          (4*ell*Real.exp (A*ω))/|t|^2 :=
        div_le_div₀ (by positivity) (mul_le_mul_of_nonneg_left hE (by positivity))
          (pow_pos ht₀ 2) hD
      refine hh.trans_eq ?_
      rw [div_eq_mul_inv]
      congr 1
      rw [Real.rpow_neg ht₀.le,Real.rpow_ofNat])

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Real MeasureTheory Set GoldbachSmoothing GoldbachTwistedMellin
open scoped FourierTransform InnerProductSpace RealInnerProductSpace

noncomputable section

private def spectrumLine (s : ℂ) (L u : ℝ) : ℂ := s+((2*Real.pi*u/L:ℝ):ℂ)*I

private theorem spectrumLine_re (s : ℂ) (L u : ℝ) : (spectrumLine s L u).re=s.re := by
  simp [spectrumLine,Complex.mul_re]

private theorem term_spectrumLine_eq (a : ℕ → ℂ) (s : ℂ) {L : ℝ} (hL : 0<L) (n : ℕ) (u : ℝ) :
    LSeries.term a (spectrumLine s L u) n = LSeries.term a s n *
      Complex.exp ((↑(2*Real.pi*u*(-Real.log (n:ℝ)/L):ℝ):ℂ)*I) := by
  by_cases hn : n=0
  · simp [hn]
  have hnC : (n:ℂ)≠0 := by exact_mod_cast hn
  simp only [LSeries.term_of_ne_zero hn]
  rw [spectrumLine,Complex.cpow_def_of_ne_zero hnC,Complex.cpow_def_of_ne_zero hnC,mul_add,Complex.exp_add]
  have hlog : Complex.log (n:ℂ)=((Real.log (n:ℝ):ℝ):ℂ) := by
    simpa only [Complex.ofReal_natCast] using (Complex.ofReal_log (Nat.cast_nonneg n)).symm
  have he : Complex.exp ((↑(2*Real.pi*u*(-Real.log (n:ℝ)/L):ℝ):ℂ)*I) =
      (Complex.exp (Complex.log (n:ℂ)*((↑(2*Real.pi*u/L:ℝ):ℂ)*I)))⁻¹ := by
    rw [← Complex.exp_neg,hlog]
    congr 1
    push_cast
    field_simp [show (L:ℂ)≠0 by exact_mod_cast hL.ne']
  rw [he]
  simp only [div_eq_mul_inv,mul_inv]
  ring

private theorem integral_sinh_spectrum_phase {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell) (t : ℝ) :
    (∫ u : ℝ, Complex.exp ((↑(2*Real.pi*u*t:ℝ):ℂ)*I)*(𝓕 (sinhEvenTest ω ell)) u) =
      sinhEvenTest ω ell t := by
  rw [← sinhEvenTest_spectrum_fourierInv hω hell t, Real.fourierInv_eq']
  simp only [Real.inner_apply,smul_eq_mul]
  apply integral_congr_ae
  filter_upwards with u
  rw [mul_assoc (2*Real.pi) u t]

set_option maxHeartbeats 1800000 in
/-- Averaging the right-side logarithmic derivative against the nonnegative
sinh spectrum gives the exact weighted finite Mangoldt sum. -/
theorem sinh_spectrum_prime_identity {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {ω ell L : ℝ} (hω : 0<ω) (hell : 0<ell) (hL : 0<L) {s : ℂ} (hs : 1<s.re) :
    (∫ u : ℝ, (-logDeriv χ.LFunction (spectrumLine s L u))*(𝓕 (sinhEvenTest ω ell)) u) =
      ∑ n ∈ Finset.Icc 1 ⌊Real.exp (ω*L)⌋₊,
        LSeries.term (twistedCoefficient χ) s n*(sinhTest ω ell (Real.log (n:ℝ)/L):ℂ) := by
  let a := twistedCoefficient χ
  let K := 𝓕 (sinhEvenTest ω ell)
  let F (n : ℕ) (u : ℝ) := LSeries.term a (spectrumLine s L u) n*K u
  let S := Finset.Icc 1 ⌊Real.exp (ω*L)⌋₊
  have hK : Integrable K := sinhEvenTest_fourier_integrable hω hell
  have hAbs : Summable (fun n => ‖LSeries.term a s n‖) :=
    summable_norm_iff.mpr (χ.LSeriesSummable_twist_vonMangoldt hs)
  have hN (n : ℕ) (u : ℝ) : ‖F n u‖=‖LSeries.term a s n‖*‖K u‖ := by
    change ‖LSeries.term a (spectrumLine s L u) n*K u‖=_
    rw [norm_mul,LSeries.norm_term_eq,LSeries.norm_term_eq,spectrumLine_re]
  have hF (n : ℕ) : Integrable (F n) := by
    refine (hK.norm.const_mul ‖LSeries.term a s n‖).mono' ?_ ?_
    · have hc : Continuous (fun u => LSeries.term a (spectrumLine s L u) n) := by
        simp_rw [term_spectrumLine_eq a s hL n]
        fun_prop
      exact hc.aestronglyMeasurable.mul hK.aestronglyMeasurable
    · filter_upwards with u
      exact le_of_eq (hN n u)
  have hFs : Summable (fun n => ∫ u : ℝ, ‖F n u‖) := by
    simp_rw [hN, integral_const_mul]
    exact hAbs.mul_right _
  have hEach (n : ℕ) : (∫ u : ℝ, F n u) =
      LSeries.term a s n*(sinhTest ω ell (Real.log (n:ℝ)/L):ℂ) := by
    change (∫ u : ℝ, LSeries.term a (spectrumLine s L u) n*K u)=_
    simp_rw [term_spectrumLine_eq a s hL n,mul_assoc,integral_const_mul]
    have hI := integral_sinh_spectrum_phase hω hell (-Real.log (n:ℝ)/L)
    simp only [mul_assoc] at hI
    dsimp only [K]
    rw [hI]
    by_cases hn : n=0
    · simp [hn]
    have hln : 0 ≤ Real.log (n:ℝ) := Real.log_nonneg (by exact_mod_cast Nat.one_le_iff_ne_zero.mpr hn)
    rw [sinhEvenTest,abs_of_nonpos (div_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hln) hL.le), neg_div, neg_neg]
  calc
    _ = ∫ u : ℝ, ∑' n, F n u := by
      apply integral_congr_ae
      filter_upwards with u
      change (-logDeriv χ.LFunction (spectrumLine s L u))*K u=∑' n, F n u
      rw [←LSeries_twistedCoefficient_eq χ (by rwa [spectrumLine_re])]
      simp only [F,a,LSeries,tsum_mul_right]
    _ = ∑' n, ∫ u : ℝ,F n u := (integral_tsum_of_summable_integral_norm hF hFs).symm
    _ = ∑' n, LSeries.term a s n*(sinhTest ω ell (Real.log (n:ℝ)/L):ℂ) := tsum_congr hEach
    _ = _ := by
      rw [tsum_eq_sum (s:=S)]
      intro n hn
      by_cases hn0 : n=0
      · subst n; simp
      have hnW : ⌊Real.exp (ω*L)⌋₊ < n := by
        by_contra! h
        exact hn (Finset.mem_Icc.mpr ⟨Nat.one_le_iff_ne_zero.mpr hn0,h⟩)
      have hnh := (Nat.floor_lt (Real.exp_pos _).le).mp hnW
      have hLog : ω*L<Real.log (n:ℝ) := (Real.lt_log_iff_exp_lt (by positivity)).mpr hnh
      rw [sinhTest_vanish ((le_div_iff₀ hL).mpr hLog.le),Complex.ofReal_zero,mul_zero]

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex MeasureTheory Set Filter Finset GradedNear
open scoped FourierTransform
noncomputable section

/-- Integrate a local real inequality against a positive spectral kernel,
charging the discarded mass with any uniform pointwise bound. -/
theorem weighted_integral_le_of_local_bound {K F G : ℝ→ℝ} {S : Set ℝ}
    (hS : MeasurableSet S) (hK : Integrable K) (hPos : ∀ t, 0 ≤ K t)
    (hF : Integrable (fun t=>K t*F t)) (hG : Integrable (fun t=>K t*G t))
    {A B : ℝ} (hA : 0≤A) (hLocal : ∀ t∈S,F t≤A+G t)
    (hGlobal : ∀ t∉S,F t≤B+G t) :
    (∫ t : ℝ,K t*F t) ≤
      A*(∫ t : ℝ,K t)+(∫ t : ℝ,K t*G t)+B*(∫ t in Sᶜ,K t) := by
  let H (t : ℝ) := A*K t+K t*G t+B*Sᶜ.indicator K t
  have hInt : Integrable H :=
    ((hK.const_mul A).add hG).add ((hK.indicator hS.compl).const_mul B)
  have hPt (t : ℝ) : K t*F t≤H t := by
    by_cases ht : t∈S
    · have hh := mul_le_mul_of_nonneg_left (hLocal t ht) (hPos t)
      simp only [H,Set.indicator_of_notMem (show t∉Sᶜ from fun h=>h ht),mul_zero,add_zero]
      nlinarith only [hh]
    · have hh := mul_le_mul_of_nonneg_left (hGlobal t ht) (hPos t)
      simp only [H,Set.indicator_of_mem (show t∈Sᶜ from ht)]
      nlinarith only [hh,mul_nonneg hA (hPos t)]
  refine (integral_mono hF hInt hPt).trans_eq ?_
  have hJ₁ : Integrable (fun t => A*K t+K t*G t) := (hK.const_mul A).add hG
  have hJ₂ : Integrable (fun t => B*Sᶜ.indicator K t) := (hK.indicator hS.compl).const_mul B
  unfold H
  rw [integral_add hJ₁ hJ₂,integral_add (hK.const_mul A) hG,integral_const_mul,
    integral_const_mul,integral_indicator hS.compl]

def scaledSpectrumDenominator (Z : ℂ) (u : ℝ) : ℂ :=
  Z-((2*Real.pi*u:ℝ):ℂ)*I

theorem scaledSpectrumDenominator_re (Z : ℂ) (u : ℝ) :
    (scaledSpectrumDenominator Z u).re=Z.re := by
  simp [scaledSpectrumDenominator,Complex.mul_re]

theorem sinhSpectrum_integrable_resolvent {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell)
    {Z : ℂ} (hZ : 0<Z.re) :
    Integrable (fun u : ℝ=>sinhSpectrumWeight ω ell u*((scaledSpectrumDenominator Z u)⁻¹).re) := by
  have hK := sinhSpectrumWeight_integrable hω hell
  refine (hK.norm.const_mul (Z.re)⁻¹).mono' ?_ ?_
  · have hC : Continuous (fun u : ℝ=>(scaledSpectrumDenominator Z u)⁻¹) :=
      (by unfold scaledSpectrumDenominator; fun_prop : Continuous (scaledSpectrumDenominator Z)).inv₀
        (fun u hu => by
          have hh := congrArg Complex.re hu
          rw [scaledSpectrumDenominator_re,Complex.zero_re] at hh
          exact hZ.ne' hh)
    exact hK.aestronglyMeasurable.mul (Complex.continuous_re.comp hC).aestronglyMeasurable
  · filter_upwards with u
    rw [norm_mul,Real.norm_eq_abs (sinhSpectrumWeight ω ell u)]
    have hz := Complex.re_le_norm (scaledSpectrumDenominator Z u)
    rw [scaledSpectrumDenominator_re] at hz
    have hNorm : |((scaledSpectrumDenominator Z u)⁻¹).re| ≤ (Z.re)⁻¹ :=
      (Complex.abs_re_le_norm ((scaledSpectrumDenominator Z u)⁻¹)).trans
        (by rw [norm_inv]; exact inv_anti₀ hZ hz)
    simp only [Real.norm_eq_abs]
    exact (mul_le_mul_of_nonneg_left hNorm (abs_nonneg _)).trans_eq (mul_comm _ _)

theorem sinhSpectrum_weighted_resolvent_eq {ω ell : ℝ} (hω : 0<ω) (hell : 0<ell)
    {Z : ℂ} (hZ : 0<Z.re) :
    (∫ u : ℝ,sinhSpectrumWeight ω ell u*((scaledSpectrumDenominator Z u)⁻¹).re)=
      (laplace (sinhTest ω ell) Z).re := by
  let K := 𝓕 (sinhEvenTest ω ell)
  let H (u : ℝ) := K u/(scaledSpectrumDenominator Z u)
  have hK := sinhEvenTest_fourier_integrable hω hell
  have hKI : Integrable H := by
    refine (hK.norm.const_mul (Z.re)⁻¹).mono' ?_ ?_
    · have hC : Continuous (fun u : ℝ=>(scaledSpectrumDenominator Z u)⁻¹) :=
        (by unfold scaledSpectrumDenominator; fun_prop : Continuous (scaledSpectrumDenominator Z)).inv₀
          (fun u hu => by
            have hh := congrArg Complex.re hu
            rw [scaledSpectrumDenominator_re,Complex.zero_re] at hh
            exact hZ.ne' hh)
      simp only [H,div_eq_mul_inv]
      exact hK.aestronglyMeasurable.mul hC.aestronglyMeasurable
    · filter_upwards with u
      have hz := Complex.re_le_norm (scaledSpectrumDenominator Z u)
      rw [scaledSpectrumDenominator_re] at hz
      change ‖K u/scaledSpectrumDenominator Z u‖ ≤ (Z.re)⁻¹*‖K u‖
      rw [norm_div,div_eq_mul_inv]
      exact (mul_le_mul_of_nonneg_left (inv_anti₀ hZ hz) (norm_nonneg (K u))).trans_eq (mul_comm _ _)
  have hEq := congrArg Complex.re (sinhEvenTest_resolvent hω hell hZ)
  change (∫ u : ℝ,H u).re=(laplace (sinhTest ω ell) Z).re at hEq
  calc
    _ = ∫ u : ℝ,(H u).re := by
      apply integral_congr_ae
      filter_upwards with u
      dsimp only [H,K]
      rw [div_eq_mul_inv,sinhEvenTest_fourier_eq,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
        zero_mul,sub_zero,sinhSpectrumWeight,sinhEvenTest_fourier_eq,Complex.ofReal_re]
    _ = (∫ u : ℝ,H u).re := integral_re hKI
    _ = _ := hEq

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Metric Set Filter Finset Goldbach GoldbachSmoothing GoldbachTwistedMellin
open scoped Topology Classical

noncomputable section


set_option maxHeartbeats 1900000 in
/-- The rational Heath–Brown test with the sharp growth coefficient
and explicit analytic, Cauchy and local zero-selection errors. -/
theorem rational_prime_series_sharp_of_strip :
    ∃ A : ℝ, 0<A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
    χ≠1 → ∀ {w : ℂ} {r e T φ B Q : ℝ},
      0<r → r≤1/32 → 0<e → 1+e≤w.re → w.re≤1+r/2 →
      |w.im|+1/4≤T → 0≤φ → 1≤B → 1≤Q →
      (∀ z : ℂ, 3/4≤z.re → z.re≤3/2 → |z.im|≤T →
        ‖χ.LFunction z‖≤B*Q^(φ*max 0 (1-z.re))) →
      ∃ V : Finset ℂ,
      (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re≤1) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 w.im‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
      ∀ c : ℂ,
      (∑' n : ℕ, LSeries.term (twistedCoefficient χ) w n *
        (1+c*Complex.log (n:ℂ)+(c*Complex.log (n:ℂ))^2/3)).re ≤
      φ*Real.log Q/2 + 16*(max (Real.log (1+e⁻¹)) (Real.log B)) +
        192*r*(A*logHeight q w.im) +
        ‖c‖*((1+r⁻¹)*(A*logHeight q w.im))/(r/2) +
        (2/3:ℝ)*‖c‖^2*((1+r⁻¹)*(A*logHeight q w.im))/(r/2)^2 -
        ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
          (1/(w-ρ)+c/(w-ρ)^2+(2*c^2/3)/(w-ρ)^3).re := by
  obtain ⟨A,hA,hAux⟩ := nonprincipal_local_analytic_remainder_with_coverage
  refine ⟨A,hA,?_⟩
  intro q _ χ hχ w r e T φ B Q hr hrmax he hwe hwr hT hφ hB hQ hstrip
  let t := w.im
  let M := A*logHeight q t
  let m := analyticOrderNatAt (regularizedL χ)
  have hM : 0≤M := mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one q t))
  have hw : 1<w.re := by linarith only [he,hwe]
  have hwdist : ‖w-line 1 t‖≤r/2 := by
    have heq : w-line 1 t=((w.re-1:ℝ):ℂ) := by
      apply Complex.ext <;> simp [t,line,Complex.sub_re,Complex.sub_im,Complex.mul_re,Complex.mul_im]
    rw [heq,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (sub_pos.mpr hw)]
    linarith only [hwr]
  obtain ⟨Z,G,hZ,hZMass,hGa,hGb,hGe,hcover⟩ := hAux q χ hχ t
  obtain ⟨G',hG'a,hG'b,hG'e⟩ := selected_analytic_remainder χ hr
    (hrmax.trans (by norm_num)) hM Z G hGa hGb hZMass hGe
  let V := Z.filter (fun ρ=>‖ρ-line 1 t‖≤2*r)
  have hVZ : V⊆Z := Finset.filter_subset _ _
  have hVM : (∑ ρ∈V,(m ρ:ℝ))≤M :=
    (Finset.sum_le_sum_of_subset_of_nonneg hVZ (fun _ _ _=>Nat.cast_nonneg _)).trans hZMass
  have hV (ρ : ℂ) (hρ : ρ∈V) : ‖ρ-w‖≤3*r ∧ regularizedL χ ρ=0 := by
    obtain ⟨hρZ,hρd⟩ := Finset.mem_filter.mp hρ
    have hh := norm_add_le (ρ-line 1 t) (line 1 t-w)
    rw [sub_add_sub_cancel,norm_sub_rev (line 1 t) w] at hh
    exact ⟨by linarith only [hh,hρd,hwdist,hr],(hZ ρ hρZ).1⟩
  obtain ⟨R,hRlo,hRhi,hRfree⟩ := auxiliary_radius_avoids_zeros χ hχ t w
    (hwdist.trans (by linarith only [hrmax])) Z hcover
  have hR : 0<R := (by norm_num : (0:ℝ)<1/8).trans hRlo
  have hδR : 3*r<R := by linarith only [hRlo,hrmax]
  let W := V.map (Equiv.subRight w).toEmbedding
  obtain ⟨hW,hW0,hW1⟩ := translate_finite_zeros χ hχ w V hV
  have hD := sharp_logDeriv_of_strip χ hχ he hR hRhi.le hwe
    (hwr.trans (by linarith only [hrmax])) (by linarith only [hT,hRhi])
    hφ hB hQ hstrip (mul_nonneg (by norm_num) hr.le) hδR hRfree W hW
  change _ ≤ _ + _ + (3*r/R^2)*(∑ z∈W,(analyticOrderNatAt χ.LFunction (w+z):ℝ)) -
    ∑ z∈W,(analyticOrderNatAt χ.LFunction (w+z):ℝ)*(-(1/z)).re at hD
  rw [hW0,hW1] at hD
  have hwBall : w∈ball (line 1 t) r := mem_ball_iff_norm.mpr
    (hwdist.trans_lt (by linarith only [hr]))
  have hDe : (fun z=>-logDeriv χ.LFunction z) =ᶠ[𝓝 w]
      (fun z=>G' z-∑ ρ∈V,(m ρ:ℂ)*(1/(z-ρ))) := by
    have hwRe : w∈{z : ℂ | 1<z.re} := hw
    have ho : IsOpen {z : ℂ | 1<z.re} := isOpen_lt continuous_const Complex.continuous_re
    filter_upwards [isOpen_ball.mem_nhds hwBall,ho.mem_nhds hwRe] with z hz hz'
    simpa [div_eq_mul_inv] using hG'e z (ball_subset_closedBall hz) hz'
  have hwSmall : closedBall w (r/2) ⊆ closedBall (line 1 t) r := by
    intro z hz
    apply mem_closedBall_iff_norm.mpr
    have hh := norm_add_le (z-w) (w-line 1 t)
    rw [sub_add_sub_cancel] at hh
    linarith only [hh,mem_closedBall_iff_norm.mp hz,hwdist]
  have hG'0 := hG'a w (ball_subset_closedBall hwBall)
  have hcG : G' w=(fun z=>-logDeriv χ.LFunction z) w+
      ∑ ρ∈V,(m ρ:ℂ)*(1/(w-ρ)) := by
    have h := hDe.eq_of_nhds
    dsimp only at h ⊢
    rw [h,sub_add_cancel]
  have hE : 0 ≤ max (Real.log (1+e⁻¹)) (Real.log B) :=
    (Real.log_nonneg hB).trans (le_max_right _ _)
  have hE' : 2*(max (Real.log (1+e⁻¹)) (Real.log B))/R≤
      16*(max (Real.log (1+e⁻¹)) (Real.log B)) := by
    apply (div_le_iff₀ hR).mpr
    have hh := mul_le_mul_of_nonneg_left hRlo.le (mul_nonneg (by norm_num : (0:ℝ)≤16) hE)
    nlinarith only [hh]
  have hR8 : (1/64:ℝ) ≤ R^2 := by
    have hh := pow_le_pow_left₀ (show (0:ℝ)≤1/8 by norm_num) hRlo.le 2
    norm_num at hh ⊢
    exact hh
  have hV' : (3*r/R^2)*(∑ ρ∈V,(m ρ:ℝ))≤192*r*M := calc
    _ ≤ (3*r/R^2)*M := mul_le_mul_of_nonneg_left hVM (by positivity)
    _ ≤ _ := by
      rw [div_mul_eq_mul_div]
      apply (div_le_iff₀ (by positivity : 0<R^2)).mpr
      have hh := mul_le_mul_of_nonneg_left hR8 (show 0≤192*r*M by positivity)
      nlinarith only [hh]
  have hG'Re : (G' w).re≤φ*Real.log Q/2+16*(max (Real.log (1+e⁻¹)) (Real.log B))+192*r*M := by
    rw [hcG,Complex.add_re,re_weighted_pole_sum]
    linarith only [hD,hE',hV']
  refine ⟨V,(fun ρ hρ=>⟨(hV ρ hρ).2,(hZ ρ (hVZ hρ)).2.1⟩),?_,?_⟩
  · intro ρ hρ hzero
    refine Finset.mem_filter.mpr ⟨hcover ρ (hρ.trans ?_) hzero,hρ⟩
    linarith only [hrmax]
  · intro c
    have hp := rationalLogJet_of_partial_fractions hG'0 V (fun ρ=>(m ρ:ℂ))
      (fun ρ hρ heq=>by subst ρ; exact (not_lt_of_ge (hZ w (hVZ hρ)).2.1) hw) hDe c
    have he := rationalLogJet_analytic_error (show 0<r/2 by positivity)
      (hG'a.mono hwSmall) (fun z hz=>hG'b z (hwSmall hz)) c
    rw [←rationalLogJet_eq_prime_series χ hw c,hp,Complex.sub_re,re_weighted_pole_sum]
    have hg := (Complex.re_le_norm (rationalLogJet G' c w-G' w)).trans he
    rw [Complex.sub_re] at hg
    change _ ≤ _
    linarith only [hG'Re,hg]

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Finset Goldbach GoldbachSmoothing GoldbachTwistedMellin

noncomputable section

private theorem real_inv_sub_nonneg {w z : ℂ} (h : z.re≤w.re) : 0≤((w-z)⁻¹).re := by
  rw [Complex.inv_re,Complex.sub_re]
  exact div_nonneg (sub_nonneg.mpr h) (Complex.normSq_nonneg _)

/-- The sharp first-order explicit formula on any selected nearby zeros.
This is the pointwise input for positive Fourier averaging. -/
theorem first_order_zero_resolvent_le_of_strip :
    ∃ A : ℝ, 0<A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
    χ≠1 → ∀ {w : ℂ} {r e T φ B Q : ℝ},
      0<r → r≤1/32 → 0<e → 1+e≤w.re → w.re≤1+r/2 →
      |w.im|+1/4≤T → 0≤φ → 1≤B → 1≤Q →
      (∀ z : ℂ, 3/4≤z.re → z.re≤3/2 → |z.im|≤T →
        ‖χ.LFunction z‖≤B*Q^(φ*max 0 (1-z.re))) →
      ∀ V : Finset ℂ, (∀ ρ∈V, ‖ρ-line 1 w.im‖≤2*r ∧ regularizedL χ ρ=0) →
      (∑ ρ∈V, (analyticOrderNatAt (regularizedL χ) ρ:ℝ)*((w-ρ)⁻¹).re) ≤
        φ*Real.log Q/2 + 16*(max (Real.log (1+e⁻¹)) (Real.log B)) +
        192*r*(A*logHeight q w.im) + (logDeriv χ.LFunction w).re := by
  obtain ⟨A,hA,hSharp⟩ := rational_prime_series_sharp_of_strip
  refine ⟨A,hA,?_⟩
  intro q _ χ hχ w r e T φ B Q hr hrmax he hwe hwr hT hφ hB hQ hstrip V hV
  obtain ⟨Z,hZ,hCover,hTest⟩ := hSharp q χ hχ hr hrmax he hwe hwr hT hφ hB hQ hstrip
  have hw : 1<w.re := lt_of_lt_of_le (lt_add_of_pos_right 1 he) hwe
  have hSub : V⊆Z := fun ρ hρ => hCover ρ (hV ρ hρ).1 (hV ρ hρ).2
  have hPos (ρ : ℂ) (hρ : ρ∈Z) : 0≤((w-ρ)⁻¹).re :=
    real_inv_sub_nonneg ((hZ ρ hρ).2.trans hw.le)
  have hMono : (∑ ρ∈V, (analyticOrderNatAt (regularizedL χ) ρ:ℝ)*((w-ρ)⁻¹).re) ≤
      ∑ ρ∈Z, (analyticOrderNatAt (regularizedL χ) ρ:ℝ)*((w-ρ)⁻¹).re :=
    sum_le_sum_of_subset_of_nonneg hSub (fun ρ hρ _ => mul_nonneg (Nat.cast_nonneg _) (hPos ρ hρ))
  have h := hTest 0
  simp only [pow_two,zero_mul,mul_zero,zero_div,add_zero,mul_one,norm_zero,one_div] at h
  change (LSeries (twistedCoefficient χ) w).re ≤ _ at h
  rw [LSeries_twistedCoefficient_eq χ hw, Complex.neg_re] at h
  apply hMono.trans
  linarith only [h]

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Finset Goldbach GoldbachTwistedMellin GoldbachHybridGrowth
open scoped ComplexConjugate Topology

noncomputable section

def cdRightLine (b L γ u : ℝ) : ℂ := ⟨1+b/L,γ+2*Real.pi*u/L⟩

def cdResolventPoint (b L γ : ℝ) (ρ : ℂ) : ℂ :=
  ⟨b+(1-ρ.re)*L,(ρ.im-γ)*L⟩

theorem cd_resolvent_scale {L : ℝ} (hL : 0 < L) (b γ u : ℝ) (ρ : ℂ) :
    L*((scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u)⁻¹).re =
      ((cdRightLine b L γ u-ρ)⁻¹).re := by
  have h : scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u =
      (L:ℂ)*conj (cdRightLine b L γ u-ρ) := by
    apply Complex.ext <;> simp [scaledSpectrumDenominator,cdResolventPoint,cdRightLine,Complex.mul_re,Complex.mul_im]
    · field_simp [hL.ne'] <;> ring
    · field_simp [hL.ne'] <;> ring
  rw [h,mul_inv,←map_inv₀,Complex.mul_re,←Complex.ofReal_inv,Complex.ofReal_re,Complex.ofReal_im,
    Complex.conj_re,zero_mul,sub_zero]
  rw [←mul_assoc,mul_inv_cancel₀ hL.ne',one_mul]

/-- The logarithms of the right displacement and the bounded-height
Burgess prefactor are negligible compared with the logarithmic scale. -/
theorem eventually_spectral_log_errors {B b ε : ℝ} (hB : 1 ≤ B) (hb : 0 < b) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, 16*max (Real.log (1+L/b)) (Real.log (B*(1+L))) ≤ ε*L := by
  let K := max (1+1/b) (2*B)
  have hK : 1 ≤ K := (le_add_of_nonneg_right (by positivity : 0 ≤ 1/b)).trans (le_max_left _ _)
  have hKn := Real.log_nonneg hK
  have hK0 := zero_lt_one.trans_le hK
  have hlog₀ := isLittleO_log_rpow_rpow_atTop (s:=1) (1:ℝ) zero_lt_one
  have hbnd := hlog₀.bound (by positivity : 0 < ε/32)
  filter_upwards [eventually_ge_atTop (max 1 (32*Real.log K/ε)),hbnd] with L hL hLL
  have hL₁ : 1 ≤ L := (le_max_left _ _).trans hL
  have hL₀ := zero_lt_one.trans_le hL₁
  have hNear (z : ℝ) (hz : 0 < z) (hzK : z ≤ K*L) :
      Real.log z ≤ Real.log K+Real.log L := by
    exact (Real.log_le_log hz hzK).trans_eq (Real.log_mul hK0.ne' hL₀.ne')
  have hA : 1+L/b ≤ K*L := by
    have hh := mul_le_mul_of_nonneg_right (le_max_left (1+1/b) (2*B)) hL₀.le
    calc
      1+L/b≤L+L/b := add_le_add hL₁ le_rfl
      _=(1+1/b)*L := by ring
      _≤_ := hh
  have hB' : B*(1+L) ≤ K*L := by
    have hh := mul_le_mul_of_nonneg_right (le_max_right (1+1/b) (2*B)) hL₀.le
    nlinarith only [hh,mul_nonneg (zero_le_one.trans hB) (sub_nonneg.mpr hL₁)]
  have hM := max_le (hNear (1+L/b) (by positivity) hA) (hNear (B*(1+L)) (by positivity) hB')
  have hK' : 32*Real.log K≤ε*L := by
    have hh := (div_le_iff₀ hε).mp ((le_max_right 1 (32*Real.log K/ε)).trans hL)
    simpa only [mul_comm] using hh
  have hlog : Real.log L ≤ (ε/32)*L := by
    simpa only [Real.rpow_one,Real.norm_eq_abs,abs_of_nonneg hL₀.le,
      abs_of_nonneg (Real.log_nonneg hL₁)] using hLL
  linarith only [hM,hK',hlog]

set_option maxHeartbeats 1500000 in
/-- The sharp explicit formula on a finite nearby zero set, normalized to
the spacing and line displacement used by the sinh spectrum. -/
theorem cd_near_resolvent_eventually {φ T H : ℝ} (hφ : 3/8 < φ)
    (hT : 0 ≤ T) (hH : 0 ≤ H) :
    ∃ C : ℝ, 0 < C ∧ ∀ (r b ε : ℝ), 0 < r → r ≤ 1/32 → 0 < b → 0 < ε →
    ∀ᶠ L : ℝ in atTop,
      ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L → ∀ χ : DirichletCharacter ℂ q, χ≠1 →
      ∀ γ : ℝ, |γ| ≤ T →
      ∀ V : Finset ℂ, (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re ≤ 1 ∧ (1-ρ.re)*L ≤ H ∧ |ρ.im-γ| ≤ r/2) →
      ∀ u : ℝ, |u| ≤ r*L/(4*Real.pi) →
      (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
        ((scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u)⁻¹).re) ≤
        φ/2+C*r+ε+(logDeriv χ.LFunction (cdRightLine b L γ u)).re/L := by
  obtain ⟨C,hC,hSharp⟩ := first_order_zero_resolvent_le_of_strip
  obtain ⟨B,hB,hFun⟩ := nonprincipal_LFunction_uniform_burgess_strip_linear_height hφ
  refine ⟨384*C,by positivity,?_⟩
  intro r b ε hr hrsmall hb hε
  let U := T+1
  let B₀ := B*(1+U)
  let H₀ := max (2*b/r) (2*H/r)
  let K := Real.log (2*(2+U))
  have hU : 0 ≤ U := by dsimp only [U]; positivity
  have hB₀ : 1 ≤ B₀ := one_le_mul_of_one_le_of_one_le hB (by dsimp only [U]; linarith only [hT])
  filter_upwards [eventually_ge_atTop (max (max 1 H₀) K),
    eventually_spectral_log_errors hB₀ hb hε] with L hL hLog
  intro q _ hq χ hχ γ hγ V hV u hu
  have hL₁ : 1 ≤ L := (le_max_left 1 H₀).trans ((le_max_left _ _).trans hL)
  have hL₀ := zero_lt_one.trans_le hL₁
  have hQ : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  have hQ₀ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hφ₀ : 0 ≤ φ := by linarith only [hφ]
  have hLh : H₀ ≤ L := (le_max_right 1 H₀).trans ((le_max_left _ _).trans hL)
  have hbSmall : b/L ≤ r/2 := by
    have hh := (div_le_iff₀ hr).mp ((le_max_left _ _).trans hLh)
    exact (div_le_iff₀ hL₀).mpr (by nlinarith only [hh])
  have hHSmall : H/L ≤ r/2 := by
    have hh := (div_le_iff₀ hr).mp ((le_max_right _ _).trans hLh)
    exact (div_le_iff₀ hL₀).mpr (by nlinarith only [hh])
  have huSmall : |2*Real.pi*u/L|≤r/2 := by
    rw [abs_div,abs_of_pos hL₀,abs_mul,abs_of_nonneg (by positivity : 0 ≤ 2*Real.pi)]
    apply (div_le_iff₀ hL₀).mpr
    have hh := (le_div_iff₀ (by positivity : 0 < 4*Real.pi)).mp hu
    nlinarith only [hh]
  let w := cdRightLine b L γ u
  have hwR : w.re=1+b/L := rfl
  have hwI : w.im=γ+2*Real.pi*u/L := rfl
  have hwU : |w.im|+1/4 ≤ U := by
    rw [hwI]
    have h := abs_add_le γ (2*Real.pi*u/L)
    dsimp only [U]
    linarith only [h,hγ,huSmall,hrsmall]
  let B₁ := B₀*(1+L)
  have hB₁ : 1 ≤ B₁ := one_le_mul_of_one_le_of_one_le hB₀ (by linarith only [hL₁])
  have hStrip (s : ℂ) (hs : 3/4 ≤ s.re) (hs' : s.re ≤ 3/2) (hsi : |s.im|≤U) :
      ‖χ.LFunction s‖≤B₁*(Real.exp L)^(φ*max 0 (1-s.re)) := by
    have hh := hFun q χ hχ hU s hs hs' hsi
    have hqE : (q:ℝ) ≤ Real.exp L := (Real.log_le_iff_le_exp hQ).mp hq
    refine hh.trans ?_
    dsimp only [B₁,B₀]
    gcongr
  have hNear (ρ : ℂ) (hρ : ρ∈V) : ‖ρ-line 1 w.im‖≤2*r ∧ regularizedL χ ρ=0 := by
    obtain ⟨hz,hre,hgap,him⟩ := hV ρ hρ
    refine ⟨?_,hz⟩
    have hRe : 1-ρ.re ≤ r/2 := ((le_div_iff₀ hL₀).mpr hgap).trans hHSmall
    have hi : |ρ.im-w.im|≤|ρ.im-γ|+|2*Real.pi*u/L| := by
      rw [hwI,show ρ.im-(γ+2*Real.pi*u/L)=(ρ.im-γ)+(-(2*Real.pi*u/L)) by ring]
      simpa only [abs_neg] using abs_add_le (ρ.im-γ) (-(2*Real.pi*u/L))
    let z := ρ-line 1 w.im
    have hNorm : ‖z‖≤|z.re|+|z.im| := by
      calc
        _=‖(z.re:ℂ)+(z.im:ℂ)*I‖ := congrArg norm (Complex.re_add_im z).symm
        _≤_ := (norm_add_le _ _).trans_eq (by simp [Complex.norm_real,Real.norm_eq_abs])
    refine hNorm.trans ?_
    simp only [z,Complex.sub_re,Complex.sub_im,line,Complex.add_re,Complex.add_im,Complex.ofReal_re,
      Complex.ofReal_im,Complex.mul_re,Complex.mul_im,Complex.I_re,Complex.I_im,mul_zero,zero_mul,
      mul_one,add_zero,zero_add,sub_zero]
    rw [abs_of_nonpos (sub_nonpos.mpr hre)]
    linarith only [hRe,hi,him,huSmall,hr]
  have hSharp' := hSharp q χ hχ (w:=w) (r:=r) (e:=b/L) (T:=U) (φ:=φ)
    (B:=B₁) (Q:=Real.exp L) hr hrsmall (div_pos hb hL₀)
    (by rw [hwR]) (by rw [hwR]; linarith only [hbSmall]) hwU hφ₀ hB₁
    (Real.one_le_exp_iff.mpr hL₀.le) hStrip V hNear
  have hHeight : logHeight q w.im ≤ 2*L := by
    have hLogK : K≤L := (le_max_right _ _).trans hL
    unfold logHeight
    rw [show 2*(q:ℝ)*(2+|w.im|)=(q:ℝ)*(2*(2+|w.im|)) by ring,
      Real.log_mul hQ.ne' (by positivity)]
    have hh := Real.log_le_log (by positivity : 0 < 2*(2+|w.im|))
      (show 2*(2+|w.im|)≤2*(2+U) by linarith only [hwU])
    dsimp only [K] at hLogK
    linarith only [hh,hLogK,hq]
  have hScaled : (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*((w-ρ)⁻¹).re)=
      L*(∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
        ((scaledSpectrumDenominator (cdResolventPoint b L γ ρ) u)⁻¹).re) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro ρ _
    rw [mul_left_comm,cd_resolvent_scale hL₀]
  rw [hScaled,Real.log_exp,inv_div] at hSharp'
  have hErr : 192*r*(C*logHeight q w.im)≤(384*C)*r*L := by
    have hh := mul_le_mul_of_nonneg_left hHeight (show 0≤192*r*C by positivity)
    nlinarith only [hh]
  apply le_of_mul_le_mul_right _ hL₀
  have hMain := hSharp'
  dsimp only [B₁] at hMain
  unfold w at hMain
  have hRhs :
      (φ/2+(384*C)*r+ε+(logDeriv χ.LFunction (cdRightLine b L γ u)).re/L)*L =
      (φ/2+(384*C)*r+ε)*L+(logDeriv χ.LFunction (cdRightLine b L γ u)).re := by
    field_simp [hL₀.ne']
  rw [hRhs]
  nlinarith only [hMain,hLog,hErr]

end
end GoldbachPintzWeightedFormula
end

