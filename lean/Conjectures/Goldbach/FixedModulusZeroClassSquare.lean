noncomputable def rawDensity376 (p c₁ c₂ κ y : ℝ) :=
  let φ : ℝ := 47/125
  let r := φ+c₁+c₂
  let a := 2*(p*φ+3*c₁+c₂+κ)
  (r/(c₁*c₂))*Real.sqrt (densityMomentScalar φ κ y*densityMomentScalar φ r y)/κ*
    Real.exp (-(493/100-a)*y)

private theorem B_bound {κ y : ℝ} (hk : 0≤κ) (hy : 0<y) {b₁ b₂ : ℝ}
    (h₁ : b₁≤Real.exp (-κ*y)) (h₂ : b₂≤Real.exp (-2*κ*y)) :
    densityMomentScalar (47/125) κ y ≤ (47/250)*((1-b₂)/y)+((1-b₁)/y)^2 := by
  unfold densityMomentScalar
  have H₁ : 0≤(1-Real.exp (-κ*y))/y := div_nonneg
    (sub_nonneg.mpr (Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg
      (neg_nonpos.mpr hk) hy.le))) hy.le
  have H₂ := div_le_div_of_nonneg_right (sub_le_sub_left h₂ (1:ℝ)) hy.le
  have H₃ := pow_le_pow_left₀ H₁
    (div_le_div_of_nonneg_right (sub_le_sub_left h₁ (1:ℝ)) hy.le) 2
  norm_num only [show ((47/125:ℝ)/2)=47/250 by norm_num]
  exact add_le_add (mul_le_mul_of_nonneg_left H₂ (by norm_num)) H₃

private theorem B_nonneg_Pintz376Numerics {k y : ℝ} (hk : 0≤k) (hy : 0<y) :
    0≤densityMomentScalar (47/125) k y := by
  unfold densityMomentScalar
  have h : 0≤1-Real.exp (-2*k*y) := sub_nonneg.mpr (Real.exp_le_one_iff.mpr
    (mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonpos_of_nonneg (by norm_num) hk) hy.le))
  positivity

set_option maxHeartbeats 1400000 in
/-- C and D tail bounds using the larger raw detector energy r/c₂. -/
theorem raw_density_376_numbers :
    rawDensity376 2 0.12 0.24 0.22 1 < 4.10 ∧
    rawDensity376 1 0.06 0.12 0.10 2.60 < 0.009 := by
  have hCK : densityMomentScalar (47/125) 0.22 1 ≤ 0.10595 := by
    refine (B_bound (by norm_num) (by norm_num) (b₁:=0.80251) (b₂:=0.64402) ?_ ?_).trans (by norm_num)
    · rw [show (-0.22:ℝ)*1= -0.22 by norm_num]
      dyadic_interval [prec := 32]
    · rw [show (-2:ℝ)*0.22*1= -0.44 by norm_num]
      dyadic_interval [prec := 32]
  have hCR : densityMomentScalar (47/125) 0.736 1 ≤ 0.41632 := by
    refine (B_bound (by norm_num) (by norm_num) (b₁:=0.47902) (b₂:=0.22946) ?_ ?_).trans (by norm_num)
    · rw [show (-0.736:ℝ)*1= -0.736 by norm_num]
      dyadic_interval [prec := 32]
    · rw [show (-2:ℝ)*0.736*1= -1.472 by norm_num]
      dyadic_interval [prec := 32]
  have hDK : densityMomentScalar (47/125) 0.10 2.60 ≤ 0.03708 := by
    refine (B_bound (by norm_num) (by norm_num) (b₁:=0.77104) (b₂:=0.59451) ?_ ?_).trans (by norm_num)
    · rw [show (-0.10:ℝ)*2.60= -0.26 by norm_num]
      dyadic_interval [prec := 32]
    · rw [show (-2:ℝ)*0.10*2.60= -0.52 by norm_num]
      dyadic_interval [prec := 32]
  have hDR : densityMomentScalar (47/125) 0.556 2.60 ≤ 0.15475 := by
    refine (B_bound (by norm_num) (by norm_num) (b₁:=0.23560) (b₂:=0.05550) ?_ ?_).trans (by norm_num)
    · rw [show (-0.556:ℝ)*2.60= -1.4456 by norm_num]
      dyadic_interval [prec := 32]
    · rw [show (-2:ℝ)*0.556*2.60= -2.8912 by norm_num]
      dyadic_interval [prec := 32]
  have hSC : Real.sqrt (densityMomentScalar (47/125) 0.22 1 *
      densityMomentScalar (47/125) 0.736 1) ≤ 0.21004 :=
    (Real.sqrt_le_iff.mpr ⟨by norm_num,(mul_le_mul hCK hCR
      (B_nonneg_Pintz376Numerics (by norm_num) (by norm_num)) (by norm_num)).trans (by norm_num)⟩)
  have hSD : Real.sqrt (densityMomentScalar (47/125) 0.10 2.60 *
      densityMomentScalar (47/125) 0.556 2.60) ≤ 0.07576 :=
    (Real.sqrt_le_iff.mpr ⟨by norm_num,(mul_le_mul hDK hDR
      (B_nonneg_Pintz376Numerics (by norm_num) (by norm_num)) (by norm_num)).trans (by norm_num)⟩)
  constructor
  · have hE : Real.exp (-1.786:ℝ)≤0.16765 := by dyadic_interval [prec := 32]
    dsimp only [rawDensity376]
    rw [show ((47/125:ℝ)+0.12+0.24)=0.736 by norm_num,
      show -(493/100-2*(2*(47/125)+3*0.12+0.24+0.22))*(1:ℝ)= -1.786 by norm_num]
    refine lt_of_le_of_lt ?_ (by norm_num : (0.736/(0.12*0.24))*0.21004/0.22*0.16765 < (4.10:ℝ))
    gcongr
  · have hE : Real.exp (-8.7828:ℝ)≤0.0001534 := by dyadic_interval [prec := 36]
    dsimp only [rawDensity376]
    rw [show ((47/125:ℝ)+0.06+0.12)=0.556 by norm_num,
      show -(493/100-2*(1*(47/125)+3*0.06+0.12+0.10))*(2.60:ℝ)= -8.7828 by norm_num]
    refine lt_of_le_of_lt ?_ (by norm_num : (0.556/(0.06*0.12))*0.07576/0.10*0.0001534 < (0.009:ℝ))
    gcongr

/-- Constants after summing the four class-count bands. -/
theorem rational_376_final_budget :
    7*Real.exp (-4.93) + 5*Real.exp (-5.6695) + 9*Real.exp (-7.395) +
      30*Real.exp (-9.6135) + 0.009 < (0.085:ℝ) ∧
    (0.672:ℝ)^2+0.086*(2*0.672+4.10) < 0.93 := by
