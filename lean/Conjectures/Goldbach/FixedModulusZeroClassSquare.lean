namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K]

def shiftPolynomial {s : ℕ} (a : Fin s → K) (e : Fin s → ℕ) : K[X] :=
  ∏ j, (C (a j)-X)^e j

theorem shiftPolynomial_ne_zero {s : ℕ} (a : Fin s → K) (e : Fin s → ℕ) :
    shiftPolynomial a e ≠ 0 := by
  classical
  unfold shiftPolynomial
  apply prod_ne_zero_iff.mpr
  intro j _
  exact pow_ne_zero _ (sub_ne_zero.mpr (ne_comm.mp (X_ne_C _)))

theorem natDegree_shiftPolynomial {s : ℕ} (a : Fin s → K) (e : Fin s → ℕ) :
    (shiftPolynomial a e).natDegree ≤ ∑ j, e j := by
  classical
  unfold shiftPolynomial
  refine (natDegree_prod_le _ _).trans (sum_le_sum ?_)
  intro j _
  refine natDegree_pow_le.trans ?_
  have h : (C (a j)-X : K[X]).natDegree≤1 := by
    refine (natDegree_sub_le _ _).trans ?_
    simp
  simpa only [mul_one,one_mul] using Nat.mul_le_mul_left (e j) h

theorem rootMultiplicity_shiftPolynomial_eq_one {s : ℕ} (a : Fin s → K)
    (ha : Function.Injective a) (e : Fin s → ℕ) (i : Fin s) (hi : e i=1) :
    (shiftPolynomial a e).rootMultiplicity (a i)=1 := by
  classical
  let R : K[X] := ∏ j ∈ univ.erase i, (C (a j)-X)^e j
  let D : K[X] := C (a i)-X
  have hDe : D = -(X-C (a i)) := by simp [D,neg_sub]
  have hR : R.eval (a i) ≠ 0 := by
    rw [eval_prod]
    apply prod_ne_zero_iff.mpr
    intro j hj
    rw [eval_pow,eval_sub,eval_C,eval_X]
    exact pow_ne_zero _ (sub_ne_zero.mpr (ha.ne (mem_erase.mp hj).1))
  have hR0 : R ≠ 0 := by intro h; exact hR (by simp [h])
  have hD : D ≠ 0 := sub_ne_zero.mpr (ne_comm.mp (X_ne_C _))
  have hP : shiftPolynomial a e=R*D := by
    unfold shiftPolynomial
    rw [← prod_erase_mul _ _ (mem_univ i),hi,pow_one]
  rw [hP,rootMultiplicity_mul (mul_ne_zero hR0 hD)]
  have hn : R.rootMultiplicity (a i)=0 := by
    apply Nat.eq_zero_of_not_pos
    exact fun h => hR ((rootMultiplicity_pos hR0).mp h)
  have hScale : D= C (-1:K)*(X-C (a i)) := by rw [hDe,map_neg,map_one,neg_mul,one_mul]
  rw [hn,zero_add,hScale,rootMultiplicity_C_mul (by simp),rootMultiplicity_X_sub_C]
  simp

theorem eval_shiftPolynomial {s : ℕ} (a : Fin s → K) (e : Fin s → ℕ) (x : K) :
    (shiftPolynomial a e).eval x=∏ j, (a j-x)^e j := by
  unfold shiftPolynomial
  rw [eval_prod]
  simp

end
end GoldbachBurgess
