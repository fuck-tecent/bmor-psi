namespace ShortAPFrequencyAssembly

open Filter MeasureTheory Set
open scoped BigOperators ENNReal

private theorem abs_sub_ge_one_of_floor_gap {u v : ℝ}
    (hp : ⌊u⌋ % 2 = ⌊v⌋ % 2) (hne : ⌊u⌋ ≠ ⌊v⌋) : 1 ≤ |u-v| := by
  have hlo (u v : ℝ) (h : ⌊u⌋ + 2 ≤ ⌊v⌋) : 1 ≤ v-u := by
    have h' : (⌊u⌋:ℝ) + 2 ≤ (⌊v⌋:ℝ) := by exact_mod_cast h
    linarith [Int.lt_floor_add_one u, Int.floor_le v]
  rcases (show ⌊u⌋ + 2 ≤ ⌊v⌋ ∨ ⌊v⌋ + 2 ≤ ⌊u⌋ by omega) with h | h
  · exact (hlo u v h).trans (by linarith [neg_le_abs (u-v)])
  · exact (hlo v u h).trans (le_abs_self _)

/-- Take one point from each occupied half-open unit cell. Splitting the cell
indices by parity gives two well-spaced families and an upper bound for the
continuous energy by the corresponding sample counts. -/
theorem exists_samples_energy_bound {ι : Type*} (I : Finset ι) (P : ι → Set ℝ)
    (F : ι → ℝ → ℂ) {a b A : ℝ}
    (hP : ∀ i, P i ⊆ Icc a b) (hm : ∀ i ∈ I, MeasurableSet (P i))
    (hF : ∀ i ∈ I, ∀ t ∈ P i, ‖F i t‖ ≤ A) :
    ∃ S₀ S₁ : ι → Finset ℝ,
      ShortAPLargeValues.WellSpaced S₀ ∧ ShortAPLargeValues.WellSpaced S₁ ∧
      (∀ i, (↑(S₀ i) : Set ℝ) ⊆ P i) ∧ (∀ i, (↑(S₁ i) : Set ℝ) ⊆ P i) ∧
      (∑ i ∈ I, ∫ t in P i, ‖F i t‖^2) ≤ A^2 *
        ((∑ i ∈ I, ((S₀ i).card:ℝ)) + ∑ i ∈ I, ((S₁ i).card:ℝ)) := by
  classical
  let O (i : ι) := (Finset.Icc ⌊a⌋ ⌊b⌋).filter (fun n => ∃ t ∈ P i, ⌊t⌋ = n)
  let sample (i : ι) (n : ℤ) : ℝ :=
    if h : n ∈ O i then (Finset.mem_filter.mp h).2.choose else 0
  have hp (i : ι) (n : ℤ) (hn : n ∈ O i) : sample i n ∈ P i ∧ ⌊sample i n⌋ = n := by
    dsimp only [sample]
    rw [dite_eq_left hn]
    exact (Finset.mem_filter.mp hn).2.choose_spec
  let cells (e : Bool) (i : ι) := (O i).filter (fun n => if e then n % 2 = 0 else n % 2 ≠ 0)
  let S (e : Bool) (i : ι) := (cells e i).image (sample i)
  have hO (e : Bool) (i : ι) : cells e i ⊆ O i := Finset.filter_subset _ _
  have hCard (e : Bool) (i : ι) : (S e i).card = (cells e i).card := by
    refine Finset.card_image_of_injOn ?_
    intro n hn m hm hnm
    exact ((hp i n (hO e i hn)).2).symm.trans
      ((congrArg Int.floor hnm).trans (hp i m (hO e i hm)).2)
  have hBoth (i : ι) : (S true i).card + (S false i).card = (O i).card := by
    rw [hCard,hCard]
    simpa [cells] using (O i).card_filter_add_card_filter_not (fun n => n % 2 = 0)
  have hSpacing (e : Bool) : ShortAPLargeValues.WellSpaced (S e) := by
    intro i u hu v hv huv
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.mp hv
    have hParity : n % 2 = m % 2 := by
      have hn' := (Finset.mem_filter.mp hn).2
      have hm' := (Finset.mem_filter.mp hm).2
      cases e <;> simp only [Bool.false_eq_true, ite_false, ite_true] at hn' hm' <;> omega
    apply abs_sub_ge_one_of_floor_gap
    · simpa only [(hp i n (hO e i hn)).2, (hp i m (hO e i hm)).2] using hParity
    · rw [(hp i n (hO e i hn)).2, (hp i m (hO e i hm)).2]
      exact fun hnm => huv (congrArg (sample i) hnm)
  have hSubset (e : Bool) (i : ι) : (↑(S e i) : Set ℝ) ⊆ P i := by
    intro t ht
    obtain ⟨n,hn,rfl⟩ := Finset.mem_image.mp (show t ∈ S e i from ht)
    exact (hp i n (hO e i hn)).1
  refine ⟨S true,S false,hSpacing true,hSpacing false,hSubset true,hSubset false,?_⟩
  have hvolume (i : ι) : volume (P i) ≤ ((O i).card : ℝ≥0∞) := by
    let cell (n : ℤ) : Set ℝ := Ico (n:ℝ) ((n:ℝ)+1)
    have hcover : P i ⊆ ⋃ n ∈ O i, cell n := by
      intro t ht
      have hmem : ⌊t⌋ ∈ O i := Finset.mem_filter.mpr
        ⟨Finset.mem_Icc.mpr ⟨Int.floor_mono (hP i ht).1,Int.floor_mono (hP i ht).2⟩,t,ht,rfl⟩
      exact mem_iUnion.mpr ⟨⌊t⌋, mem_iUnion.mpr ⟨hmem,Int.floor_le t,Int.lt_floor_add_one t⟩⟩
    calc
      volume (P i) ≤ volume (⋃ n ∈ O i, cell n) := measure_mono hcover
      _ ≤ ∑ n ∈ O i, volume (cell n) := measure_biUnion_finset_le _ _
      _ = _ := by simp [cell, Real.volume_Ico]
  have hpoint (i : ι) (hi : i ∈ I) : (∫ t in P i, ‖F i t‖^2) ≤
      A^2 * ((S true i).card+(S false i).card : ℝ) := by
    have hv : volume (P i) ≠ ⊤ := ((hvolume i).trans_lt (ENNReal.natCast_lt_top _)).ne
    have hreal : volume.real (P i) ≤ ((O i).card : ℝ) := by
      simpa only [Measure.real,ENNReal.toReal_natCast] using
        (ENNReal.toReal_le_toReal hv (ENNReal.natCast_ne_top _)).mpr (hvolume i)
    calc
      (∫ t in P i, ‖F i t‖^2) ≤ ∫ _t in P i, A^2 := by
        apply integral_mono_of_nonneg (Filter.Eventually.of_forall fun t => sq_nonneg _)
          (integrableOn_const hv)
        filter_upwards [ae_restrict_mem (hm i hi)] with t ht
        exact pow_le_pow_left₀ (norm_nonneg _) (hF i hi t ht) 2
      _ = volume.real (P i) * A^2 := by rw [setIntegral_const, smul_eq_mul]
      _ ≤ ((O i).card : ℝ) * A^2 := mul_le_mul_of_nonneg_right hreal (sq_nonneg _)
      _ = _ := by rw [← hBoth i,Nat.cast_add]; ring
  calc
    _ ≤ ∑ i ∈ I, A^2 * ((S true i).card+(S false i).card : ℝ) := Finset.sum_le_sum hpoint
    _ = _ := by simp only [← Finset.mul_sum,Finset.sum_add_distrib]

/-- Half-open dyadic frequency band, including frequency zero at scale one. -/
def frequencyBand (T : ℝ) : Set ℝ := {t | T ≤ |t|+1 ∧ |t|+1 < 2*T}

/-- Simultaneously restrict every normalized factor amplitude to its bin.
The actual value in the bin is the shifted quantity `‖F‖+1`. -/
def amplitudeBox {ι ρ : Type*} (s : Finset ι) (F : ι → ρ → ℝ → ℂ)
    (T : ℝ) (U : ι → ℝ) (χ : ρ) : Set ℝ :=
  frequencyBand T ∩ ⋂ j ∈ s, {t | U j ≤ ‖F j χ t‖+1 ∧ ‖F j χ t‖+1 < 2*U j}

theorem measurableSet_frequencyBand (T : ℝ) : MeasurableSet (frequencyBand T) := by
  have h : Continuous (fun t : ℝ => |t|+1) := continuous_abs.add_const _
  exact (measurableSet_le measurable_const h.measurable).inter
    (measurableSet_lt h.measurable measurable_const)

theorem measurableSet_amplitudeBox {ι ρ : Type*} (s : Finset ι) (F : ι → ρ → ℝ → ℂ)
    (T : ℝ) (U : ι → ℝ) (χ : ρ) (hF : ∀ j ∈ s, Continuous (F j χ)) :
    MeasurableSet (amplitudeBox s F T U χ) := by
  apply (measurableSet_frequencyBand T).inter
  refine s.measurableSet_biInter fun j hj => ?_
  have h := (hF j hj).norm.add_const (1:ℝ)
  exact (measurableSet_le measurable_const h.measurable).inter
    (measurableSet_lt h.measurable measurable_const)

theorem abs_le_of_mem_amplitudeBox {ι ρ : Type*} {s : Finset ι} {F : ι → ρ → ℝ → ℂ}
    {T : ℝ} {U : ι → ℝ} {χ : ρ} {t : ℝ} (ht : t ∈ amplitudeBox s F T U χ) : |t| ≤ 2*T := by
  have hh : |t|+1 < 2*T := ht.1.2
  linarith

theorem mem_amplitudeBox_factor {ι ρ : Type*} {s : Finset ι} {F : ι → ρ → ℝ → ℂ}
    {T : ℝ} {U : ι → ℝ} {χ : ρ} {t : ℝ} (ht : t ∈ amplitudeBox s F T U χ)
    {j : ι} (hj : j ∈ s) : U j ≤ ‖F j χ t‖+1 ∧ ‖F j χ t‖+1 < 2*U j :=
  mem_iInter.mp (mem_iInter.mp ht.2 j) hj

theorem exists_box_samples {ι ρ : Type*} (I : Finset ρ) (s : Finset ι)
    (F : ι → ρ → ℝ → ℂ) (T : ℝ) (U : ι → ℝ)
    (hF : ∀ χ ∈ I, ∀ j ∈ s, Continuous (F j χ)) :
    ∃ S₀ S₁ : ρ → Finset ℝ,
      ShortAPLargeValues.WellSpaced S₀ ∧ ShortAPLargeValues.WellSpaced S₁ ∧
      (∀ χ, (↑(S₀ χ) : Set ℝ) ⊆ amplitudeBox s F T U χ) ∧
      (∀ χ, (↑(S₁ χ) : Set ℝ) ⊆ amplitudeBox s F T U χ) ∧
      (∑ χ ∈ I, ∫ t in amplitudeBox s F T U χ, ‖∏ j ∈ s, F j χ t‖^2) ≤
        ((2:ℝ)^s.card)^2 * (∏ j ∈ s, (U j)^2) *
        ((∑ χ ∈ I, ((S₀ χ).card:ℝ)) + ∑ χ ∈ I, ((S₁ χ).card:ℝ)) := by
  let A := (2:ℝ)^s.card * ∏ j ∈ s, U j
  obtain ⟨S₀,S₁,h₀,h₁,hs₀,hs₁,hE⟩ :=
    exists_samples_energy_bound I (amplitudeBox s F T U) (fun χ t => ∏ j ∈ s, F j χ t)
      (fun _ _ ht => by
        have h := abs_le.mp (abs_le_of_mem_amplitudeBox ht)
        simpa only [Set.mem_Icc,neg_mul] using h)
      (fun χ hχ => measurableSet_amplitudeBox s F T U χ (hF χ hχ))
      (fun χ _ t ht => by
        rw [norm_prod]
        calc
          _ ≤ ∏ j ∈ s, 2*U j := Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) fun j hj => by
            have h := (mem_amplitudeBox_factor ht hj).2
            linarith
          _ = A := by rw [Finset.prod_mul_distrib, Finset.prod_const])
  refine ⟨S₀,S₁,h₀,h₁,hs₀,hs₁,?_⟩
  simpa only [A,mul_pow,Finset.prod_pow] using hE

theorem continuous_factor (N : ℕ) (f : ArithmeticFunction ℂ) {q : ℕ}
    (χ : DirichletCharacter ℂ q) :
    Continuous (fun t : ℝ => ShortAPFactorSampling.factor N f χ (1/2+(t:ℂ)*Complex.I)) := by
  unfold ShortAPFactorSampling.factor
  refine continuous_finsetSum _ (fun n hn => ?_)
  have hn0 : (n:ℂ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
  have h : Continuous (fun t : ℝ => (1/2+(t:ℂ)*Complex.I : ℂ)) := by fun_prop
  have hp := h.const_cpow (Or.inl hn0)
  exact continuous_const.div hp (fun _ => Complex.cpow_ne_zero_iff.mpr (Or.inl hn0))

noncomputable def boxSamplingConstant (c C CHeight : ℝ) : ℝ :=
  ShortAPFactorSampling.commonSamplingConstant 2048 c CHeight +
    ShortAPComplementSampling.complementConstant c C CHeight

set_option maxRecDepth 8192 in
set_option maxHeartbeats 900000 in
/-- Section 4 estimate (4.9) for the boxes meeting the two amplitude caps
and the short-factor cutoffs. Both sampling inputs are proved here from the
actual finite Dirichlet polynomials. -/
theorem actual_box_energy {ι : Type*} [DecidableEq ι] {c C C₀ CHeight : ℝ}
    {p : ℕ} (hp : ShortAPFactorSampling.logExponent 2048 1 ≤ p)
    (hc : 1 ≤ c) (hC : 1 ≤ C) (hC₀ : 0 < C₀) (hHeight : 1 ≤ CHeight) :
    ∀ᶠ x : ℝ in atTop, ∀ (s : Finset ι) (N d : ι → ℕ) (M U : ι → ℝ)
      (f : ι → ArithmeticFunction ℂ) (Q : ℕ) (T H D θ β : ℝ),
    let V := ∏ j ∈ s, (U j)^2
    let F := fun j (χ : ShortAP.CharIndex) (t : ℝ) =>
      ShortAPFactorSampling.factor (N j) (f j) χ.2 (1/2+(t:ℂ)*Complex.I)
    1 ≤ Q → 1 ≤ T → 0 ≤ H → 0 < D → (Q:ℝ)^2*(2*T) ≤ CHeight*H →
    5/8 ≤ θ → θ ≤ 1 → (1-θ)/3+1/32 ≤ β → s.card ≤ 8 →
    (∀ j ∈ s, (1:ℝ)/4 ≤ M j ∧ M j ≤ x^((1:ℝ)/3-1/256)) →
    x ≤ C₀ * (∏ j ∈ s, M j) → (∏ j ∈ s, M j) ≤ C*x →
    (∀ j ∈ s, 1 ≤ N j ∧ (N j:ℝ) ≤ c*M j) → (∀ j ∈ s, 1 ≤ U j) →
    (∑ j ∈ s, d j) ≤ 1 →
    (∀ j ∈ s, ∀ n > N j, f j n = 0) →
    (∀ j ∈ s, ∀ n : ℕ, 1 ≤ n → ‖f j n‖ ≤ (Real.log n)^d j) →
    D^2*x^β*(Real.log x)^19 = x^θ → H*x^β ≤ x*(Real.log x)^120 →
    V*D^2 ≤ (Real.log x)^512*x → V*(Real.log x)^(p+512*2048+77) ≤ x →
    (∑ χ ∈ ShortAP.primitiveFamily Q, ∫ t in amplitudeBox s F T U χ,
        ‖∏ j ∈ s, F j χ t‖^2) * (Real.log x)^77 ≤
      (((2:ℝ)^8)^2 * (4*boxSamplingConstant c C CHeight))*x := by
  let K := boxSamplingConstant c C CHeight
  have hKa := ShortAPFactorSampling.commonSamplingConstant_nonneg 2048 hc hHeight
  have hKb := ShortAPComplementSampling.complementConstant_nonneg hc hC hHeight
  have hK : 0 ≤ K := add_nonneg hKa hKb
  have hKaK : ShortAPFactorSampling.commonSamplingConstant 2048 c CHeight ≤ K :=
    le_add_of_nonneg_right hKb
  have hKbK : ShortAPComplementSampling.complementConstant c C CHeight ≤ K :=
    le_add_of_nonneg_left hKa
  filter_upwards [eventually_ge_atTop (Real.exp 1),
    ShortAPFourthSection.high_branch_card_bound (ι := ι) p hK hC₀] with x hx hCard
  intro s N d M U f Q T H D θ β V F hQ hT hH hD hHT hθ hθ' hβ hs hM hprod hprod'
    hN hU hd hSupport hCoeff hid hHT' hcap hcap'
  have hL : 1 ≤ Real.log x := by
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hx1 : 1 ≤ x := (Real.one_le_exp (by norm_num : (0:ℝ) ≤ 1)).trans hx
  have hM₀ (j : ι) (hj : j ∈ s) : 0 ≤ M j := by linarith [(hM j hj).1]
  have hM₁ (j : ι) (hj : j ∈ s) : M j ≤ x := calc
    _ ≤ x^((1:ℝ)/3-1/256) := (hM j hj).2
    _ ≤ x^(1:ℝ) := Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num)
    _ = _ := Real.rpow_one _
  have hv (j : ι) (hj : j ∈ s) : 1 ≤ (U j)^2 := one_le_pow₀ (hU j hj)
  have hT' : 1 ≤ 2*T := by linarith
  have hR (S : ShortAP.CharIndex → Finset ℝ) (hSep : ShortAPLargeValues.WellSpaced S)
      (hSub : ∀ χ, (↑(S χ) : Set ℝ) ⊆ amplitudeBox s F T U χ) :
      (∑ χ ∈ ShortAP.primitiveFamily Q, ((S χ).card:ℝ)) * V * (Real.log x)^77 ≤ (2*K)*x := by
    let R := ∑ χ ∈ ShortAP.primitiveFamily Q, ((S χ).card:ℝ)
    have hBand : ∀ χ ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S χ, |t| ≤ 2*T :=
      fun χ _ t ht => abs_le_of_mem_amplitudeBox (hSub χ ht)
    have hValue : ∀ χ ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S χ, ∀ j ∈ s,
        U j ≤ ‖F j χ t‖+1 := fun χ _ t ht j hj => (mem_amplitudeBox_factor (hSub χ ht) hj).1
    have hR0 : 0 ≤ R := Finset.sum_nonneg fun χ _ => Nat.cast_nonneg (S χ).card
    refine hCard s M (fun j => (U j)^2) R H D θ β hθ hθ' hβ hR0
      hH hD hs (fun j hj => ⟨hM₀ j hj,(hM j hj).2⟩) hprod hv hid hHT' hcap hcap' ?_ ?_
    · intro j hj _ hvj
      have hdj : d j ≤ 1 := (Finset.single_le_sum (fun i _ => Nat.zero_le (d i)) hj).trans hd
      have hu : 2 ≤ U j := by
        by_contra! hh
        nlinarith only [hvj,mul_pos (sub_pos.mpr hh) (show 0 < 2+U j by linarith [hU j hj])]
      have hNx : (N j:ℝ) ≤ c*x := (hN j hj).2.trans
        (mul_le_mul_of_nonneg_left (hM₁ j hj) (zero_le_one.trans hc))
      have hsamp := ShortAPFactorSampling.sampled_factor_power_scales (N j) Q 2048 (d j)
        (hN j hj).1 hQ hx (hM₀ j hj) hH hc hHeight (hN j hj).2 hNx hHT hT' hu (f j)
        (hSupport j hj) (hCoeff j hj) S hSep hBand (fun χ hχ t ht => hValue χ hχ t ht j hj)
      refine hsamp.trans ((ShortAPFactorSampling.scaled_power_budget_le 2048 (d j) hdj hc hHeight
        hL (hM₀ j hj) hH).trans ?_)
      have hsum : 0 ≤ M j^2048+H := add_nonneg (pow_nonneg (hM₀ j hj) _) hH
      exact mul_le_mul (mul_le_mul_of_nonneg_right hKaK hsum) (pow_le_pow_right₀ hL hp)
        (pow_nonneg (zero_le_one.trans hL) _) (mul_nonneg hK hsum)
    · intro j hj hlong
      have hMj : 1 ≤ M j := (Real.one_le_rpow hx1 (by norm_num : (0:ℝ) ≤ 1/1024)).trans hlong.le
      have hsamp := ShortAPComplementSampling.sampled_complement_scales s hj hs N d M U f hx hH hT'
        hc hC hHeight (fun i hi => (hM i hi).1) hMj (fun i hi => (hN i hi).2) hprod'
        (fun i hi => (hN i hi).1) hU hd hSupport hCoeff Q hQ hHT S hSep hBand hValue
      refine hsamp.trans ?_
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hKbK (add_nonneg (div_nonneg (zero_le_one.trans hx1)
          (zero_le_one.trans hMj)) hH)) (sq_nonneg _)) (pow_nonneg (zero_le_one.trans hL) _)
  obtain ⟨S₀,S₁,h₀,h₁,hSub₀,hSub₁,hE⟩ := exists_box_samples (ShortAP.primitiveFamily Q) s F T U
    (fun χ _ j _ => continuous_factor (N j) (f j) χ.2)
  let R₀ := ∑ χ ∈ ShortAP.primitiveFamily Q, ((S₀ χ).card:ℝ)
  let R₁ := ∑ χ ∈ ShortAP.primitiveFamily Q, ((S₁ χ).card:ℝ)
  have hcount := add_le_add (hR S₀ h₀ hSub₀) (hR S₁ h₁ hSub₁)
  have hcount' : R₀*V*(Real.log x)^77 + R₁*V*(Real.log x)^77 ≤ (4*K)*x :=
    hcount.trans_eq (by ring)
  have hB : ((2:ℝ)^s.card)^2 ≤ ((2:ℝ)^8)^2 :=
    pow_le_pow_left₀ (by positivity) (pow_le_pow_right₀ (by norm_num) hs) _
  calc
    _ ≤ (((2:ℝ)^s.card)^2 * V*(R₀+R₁))*(Real.log x)^77 :=
      mul_le_mul_of_nonneg_right hE (pow_nonneg (zero_le_one.trans hL) _)
    _ = ((2:ℝ)^s.card)^2 * (R₀*V*(Real.log x)^77+R₁*V*(Real.log x)^77) := by ring
    _ ≤ ((2:ℝ)^s.card)^2 * ((4*K)*x) := mul_le_mul_of_nonneg_left hcount' (sq_nonneg _)
    _ ≤ ((2:ℝ)^8)^2 * ((4*K)*x) :=
      mul_le_mul_of_nonneg_right hB
        (mul_nonneg (mul_nonneg (by norm_num : (0:ℝ)≤4) hK) (zero_le_one.trans hx1))
    _ = _ := (mul_assoc (((2:ℝ)^8)^2) (4*K) x).symm

private theorem setIntegral_le_cover_sum {α : Type*} (J : Finset α) (P : Set ℝ)
    (B : α → Set ℝ) (f : ℝ → ℝ) (hP : MeasurableSet P) (hf : ∀ t, 0 ≤ f t)
    (hB : ∀ j ∈ J, MeasurableSet (B j)) (hi : ∀ j ∈ J, IntegrableOn f (B j))
    (hcover : ∀ t ∈ P, ∃ j ∈ J, t ∈ B j) :
    (∫ t in P, f t) ≤ ∑ j ∈ J, ∫ t in B j, f t := by
  classical
  have hnon (s : Set ℝ) (t : ℝ) : 0 ≤ s.indicator f t := by
    by_cases ht : t ∈ s
    · simpa only [Set.indicator_of_mem ht] using hf t
    · rw [Set.indicator_of_notMem ht]
  have hInt (j : α) (hj : j ∈ J) : Integrable ((B j).indicator f) :=
    (integrable_indicator_iff (hB j hj)).mpr (hi j hj)
  rw [← integral_indicator hP]
  calc
    _ ≤ ∫ t : ℝ, ∑ j ∈ J, (B j).indicator f t := by
      apply integral_mono_of_nonneg (Filter.Eventually.of_forall (hnon P))
        (integrable_finsetSum J hInt)
      filter_upwards with t
      by_cases ht : t ∈ P
      · obtain ⟨j,hj,hj'⟩ := hcover t ht
        rw [Set.indicator_of_mem ht, ← Set.indicator_of_mem hj' f]
        exact Finset.single_le_sum (fun k _ => hnon (B k) t) hj
      · rw [Set.indicator_of_notMem ht]
        exact Finset.sum_nonneg fun j _ => hnon (B j) t
    _ = _ := by
      rw [integral_finsetSum J hInt]
      exact Finset.sum_congr rfl fun j hj => integral_indicator (hB j hj)

/-- Select a dyadic bin for a real value in `[1,2^B)`. -/
theorem exists_dyadic_bin {y : ℝ} {B : ℕ} (hy : 1 ≤ y) (hyB : y < (2:ℝ)^B) :
    ∃ k : Fin B, (2:ℝ)^(k:ℕ) ≤ y ∧ y < 2*(2:ℝ)^(k:ℕ) := by
  let n := ⌊y⌋₊
  let k := Nat.log 2 n
  have hn : 1 ≤ n := (Nat.one_le_floor_iff y).mpr hy
  have hk : (2:ℝ)^k ≤ y := (by exact_mod_cast Nat.pow_log_le_self 2 (Nat.ne_of_gt hn) :
      (2:ℝ)^k ≤ (n:ℝ)).trans (Nat.floor_le (zero_le_one.trans hy))
  have hkB : k < B := by
    by_contra! h
    exact (not_lt_of_ge ((pow_le_pow_right₀ (by norm_num : (1:ℝ) ≤ 2) h).trans hk)) hyB
  refine ⟨⟨k,hkB⟩,hk,?_⟩
  have hu : y < ((2^(k+1):ℕ):ℝ) := Nat.lt_of_floor_lt (Nat.lt_pow_succ_log_self (by decide) n)
  simpa only [Nat.cast_pow,Nat.cast_mul,Nat.cast_ofNat,pow_succ'] using hu

noncomputable def dyadicAmplitude {ι : Type*} {s : Finset ι} {B : ℕ} (b : s → Fin B) (j : ι) : ℝ := by
  classical
  exact if h : j ∈ s then (2:ℝ)^(b ⟨j,h⟩:ℕ) else 1

theorem one_le_dyadicAmplitude {ι : Type*} {s : Finset ι} {B : ℕ} (b : s → Fin B)
    (j : ι) : 1 ≤ dyadicAmplitude b j := by
  unfold dyadicAmplitude
  split_ifs
  · exact one_le_pow₀ (by norm_num)
  · exact le_rfl

private theorem frequencyBand_subset {T : ℝ} : frequencyBand T ⊆ Icc (-(2*T)) (2*T) := by
  intro t ht
  apply abs_le.mp
  have h : |t|+1 < 2*T := ht.2
  linarith

/-- Cover a frequency band by the finitely indexed dyadic amplitude boxes. -/
theorem band_energy_le_sum_boxes {ι ρ : Type*} [DecidableEq ι] (I : Finset ρ) (s : Finset ι)
    (F : ι → ρ → ℝ → ℂ) (T : ℝ) (B : ℕ)
    (hF : ∀ χ ∈ I, ∀ j ∈ s, Continuous (F j χ))
    (hB : ∀ χ ∈ I, ∀ t ∈ frequencyBand T, ∀ j ∈ s, ‖F j χ t‖+1 < (2:ℝ)^B) :
    (∑ χ ∈ I, ∫ t in frequencyBand T, ‖∏ j ∈ s, F j χ t‖^2) ≤
      ∑ b : s → Fin B, ∑ χ ∈ I, ∫ t in amplitudeBox s F T (dyadicAmplitude b) χ,
        ‖∏ j ∈ s, F j χ t‖^2 := by
  classical
  rw [Finset.sum_comm]
  refine Finset.sum_le_sum fun χ hχ => ?_
  let f (t : ℝ) := ‖∏ j ∈ s, F j χ t‖^2
  have hf : Continuous f := (continuous_finsetProd _ (hF χ hχ)).norm.pow _
  apply setIntegral_le_cover_sum _ _ _ f (measurableSet_frequencyBand T) (fun _ => sq_nonneg _)
  · exact fun b _ => measurableSet_amplitudeBox s F T (dyadicAmplitude b) χ (hF χ hχ)
  · intro b _
    exact hf.integrableOn_Icc.mono_set (inter_subset_left.trans frequencyBand_subset)
  · intro t ht
    choose b hb using fun j : s => exists_dyadic_bin (by linarith [norm_nonneg (F j χ t)])
      (hB χ hχ t ht j j.property)
    refine ⟨b,Finset.mem_univ _,ht,?_⟩
    refine mem_iInter.mpr fun j => mem_iInter.mpr fun hj => ?_
    simpa only [dyadicAmplitude,dite_eq_left hj,Set.mem_ofPred_eq] using hb ⟨j,hj⟩

/-- Cover a bounded continuous frequency integral first by dyadic frequency
bands and then by amplitude boxes. Neither covering is an input. -/
theorem interval_energy_le_sum_bands_boxes {ι ρ : Type*} [DecidableEq ι] (I : Finset ρ) (s : Finset ι)
    (F : ι → ρ → ℝ → ℂ) (Tmax : ℝ) (Bfreq Bamp : ℕ)
    (hFreq : Tmax+1 < (2:ℝ)^Bfreq)
    (hF : ∀ χ ∈ I, ∀ j ∈ s, Continuous (F j χ))
    (hB : ∀ χ ∈ I, ∀ k : Fin Bfreq, ∀ t ∈ frequencyBand ((2:ℝ)^(k:ℕ)),
      ∀ j ∈ s, ‖F j χ t‖+1 < (2:ℝ)^Bamp) :
    (∑ χ ∈ I, ∫ t in Icc (-Tmax) Tmax, ‖∏ j ∈ s, F j χ t‖^2) ≤
      ∑ k : Fin Bfreq, ∑ b : s → Fin Bamp, ∑ χ ∈ I,
        ∫ t in amplitudeBox s F ((2:ℝ)^(k:ℕ)) (dyadicAmplitude b) χ,
          ‖∏ j ∈ s, F j χ t‖^2 := by
  classical
  calc
    _ ≤ ∑ χ ∈ I, ∑ k : Fin Bfreq, ∫ t in frequencyBand ((2:ℝ)^(k:ℕ)), ‖∏ j ∈ s, F j χ t‖^2 := by
      refine Finset.sum_le_sum fun χ hχ => ?_
      let f (t : ℝ) := ‖∏ j ∈ s, F j χ t‖^2
      have hf : Continuous f := (continuous_finsetProd _ (hF χ hχ)).norm.pow _
      apply setIntegral_le_cover_sum _ _ _ f measurableSet_Icc (fun _ => sq_nonneg _)
      · exact fun k _ => measurableSet_frequencyBand _
      · exact fun k _ => hf.integrableOn_Icc.mono_set frequencyBand_subset
      · intro t ht
        have hupper : |t|+1 < (2:ℝ)^Bfreq := (add_le_add_left (abs_le.mpr ht) 1).trans_lt hFreq
        obtain ⟨k,hk⟩ := exists_dyadic_bin (by linarith [abs_nonneg t]) hupper
        exact ⟨k,Finset.mem_univ _,hk⟩
    _ = ∑ k : Fin Bfreq, ∑ χ ∈ I, ∫ t in frequencyBand ((2:ℝ)^(k:ℕ)), ‖∏ j ∈ s, F j χ t‖^2 :=
      Finset.sum_comm
    _ ≤ _ := Finset.sum_le_sum fun k _ => band_energy_le_sum_boxes I s F _ Bamp hF
      (fun χ hχ => hB χ hχ k)

noncomputable def dyadicBins (y : ℝ) : ℕ := Nat.log 2 ⌊y⌋₊ + 1

theorem lt_two_pow_dyadicBins (y : ℝ) : y < (2:ℝ)^(dyadicBins y) := by
  have h : y < ((2^(dyadicBins y):ℕ):ℝ) := Nat.lt_of_floor_lt
    (Nat.lt_pow_succ_log_self (by decide) _)
  exact_mod_cast h

noncomputable def dyadicBinConstant (a C : ℝ) : ℝ :=
  1 + (Real.log C+a)/Real.log 2

/-- The number of dyadic indices for a polynomially bounded scale costs
one logarithm, with an explicit constant. -/
theorem dyadicBins_le_log {y x a C : ℝ} (hx : Real.exp 1 ≤ x)
    (hy : 1 ≤ y) (hC : 1 ≤ C) (hBound : y ≤ C*x^a) :
    (dyadicBins y:ℝ) ≤ dyadicBinConstant a C * Real.log x := by
  let m := Nat.log 2 ⌊y⌋₊
  have hm : (2:ℝ)^m ≤ y := (by
    exact_mod_cast Nat.pow_log_le_self 2 (Nat.ne_of_gt ((Nat.one_le_floor_iff y).mpr hy)) :
      (2:ℝ)^m ≤ (⌊y⌋₊:ℝ)).trans (Nat.floor_le (zero_le_one.trans hy))
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hx0 : 0 < x := (Real.exp_pos _).trans_le hx
  have hL : 1 ≤ Real.log x := by
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hC0 : 0 < C := zero_lt_one.trans_le hC
  have hlog := Real.log_le_log (pow_pos (by norm_num : (0:ℝ)<2) m) (hm.trans hBound)
  rw [Real.log_pow, Real.log_mul hC0.ne' (Real.rpow_pos_of_pos hx0 _).ne', Real.log_rpow hx0] at hlog
  have hlog' : (m:ℝ)*Real.log 2 ≤ (Real.log C + a)*Real.log x := calc
    _ ≤ Real.log C + a*Real.log x := hlog
    _ ≤ _ := by nlinarith [mul_nonneg (Real.log_nonneg hC) (sub_nonneg.mpr hL)]
  have hm' : (m:ℝ) ≤ (Real.log C+a)*Real.log x/Real.log 2 := (le_div_iff₀ h2).mpr hlog'
  change ((m+1:ℕ):ℝ) ≤ _
  rw [Nat.cast_add,Nat.cast_one]
  calc
    _ ≤ (Real.log C+a)*Real.log x/Real.log 2 + Real.log x := by linarith only [hL,hm']
    _ = _ := by unfold dyadicBinConstant; ring

/-- The dyadic summation loss is at most nine logarithms for at most eight
factors, for any nonnegative uniform per-band/per-box upper bound. -/
theorem sum_dyadic_budget {ι : Type*} [DecidableEq ι] (s : Finset ι) {Bfreq Bamp : ℕ}
    (hs : s.card ≤ 8) (hBa : 1 ≤ Bamp) {a C L E : ℝ}
    (ha : 0 ≤ a) (hL : 0 ≤ L) (hE : 0 ≤ E)
    (hBf : (Bfreq:ℝ) ≤ a*L) (hBa' : (Bamp:ℝ) ≤ C*L)
    (W : Fin Bfreq → (s → Fin Bamp) → ℝ) (hW : ∀ k b, W k b ≤ E) :
    (∑ k : Fin Bfreq, ∑ b : s → Fin Bamp, W k b) ≤ (a*C^8)*L^9*E := by
  classical
  have hBa1 : (1:ℝ) ≤ Bamp := by exact_mod_cast hBa
  have hcount : (Bfreq:ℝ)*(Bamp:ℝ)^s.card ≤ (a*C^8)*L^9 := calc
    _ ≤ (Bfreq:ℝ)*(Bamp:ℝ)^8 := mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ hBa1 hs) (Nat.cast_nonneg _)
    _ ≤ (a*L)*(C*L)^8 := mul_le_mul hBf
      (pow_le_pow_left₀ (Nat.cast_nonneg Bamp) hBa' _) (pow_nonneg (Nat.cast_nonneg Bamp) _) (mul_nonneg ha hL)
    _ = _ := by ring
  calc
    _ ≤ ∑ _k : Fin Bfreq, ∑ _b : s → Fin Bamp, E := Finset.sum_le_sum fun k _ =>
      Finset.sum_le_sum fun b _ => hW k b
    _ = ((Bfreq:ℝ)*(Bamp:ℝ)^s.card)*E := by
      simp [Fintype.card_pi]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_right hcount hE

/-- A uniform amplitude ceiling for the actual finite Dirichlet polynomials.
The crude quadratic bound suffices to count all dyadic amplitude boxes. -/
theorem factor_amplitude_le_quadratic {q : ℕ} (χ : DirichletCharacter ℂ q)
    (N d : ℕ) (hN : 1 ≤ N) (hd : d ≤ 1) (f : ArithmeticFunction ℂ)
    (hCoeff : ∀ n : ℕ, 1 ≤ n → ‖f n‖ ≤ (Real.log n)^d) (t : ℝ) :
    ‖ShortAPFactorSampling.factor N f χ (1/2+(t:ℂ)*Complex.I)‖+1 ≤ (N:ℝ)^2+1 := by
  let z : ℂ := 1/2+(t:ℂ)*Complex.I
  have hzr : z.re = 1/2 := by simp [z]
  have hNreal : (1:ℝ) ≤ N := by exact_mod_cast hN
  have hterm (n : ℕ) (hn : n ∈ Finset.Icc 1 N) :
      ‖f n * χ (n:ZMod q) / (n:ℂ)^z‖ ≤ N := by
    obtain ⟨hn₁,hn₂⟩ := Finset.mem_Icc.mp hn
    have hnf : ‖f n‖ ≤ N := (hCoeff n hn₁).trans (by
      rcases (show d=0 ∨ d=1 by omega) with h | h
      · simpa [h] using hNreal
      · rw [h,pow_one]
        have hn₁' : (0:ℝ) < n := by exact_mod_cast hn₁
        have hn₂' : (n:ℝ) ≤ N := by exact_mod_cast hn₂
        linarith [Real.log_le_sub_one_of_pos hn₁'])
    have hc : 1 ≤ ‖(n:ℂ)^z‖ := by
      rw [Complex.norm_natCast_cpow_of_pos hn₁,hzr]
      exact Real.one_le_rpow (by exact_mod_cast hn₁) (by norm_num)
    rw [norm_div,norm_mul]
    exact (div_le_self (mul_nonneg (norm_nonneg _) (norm_nonneg _)) hc).trans
      ((mul_le_of_le_one_right (norm_nonneg _) (χ.norm_le_one _)).trans hnf)
  have hsum : ‖ShortAPFactorSampling.factor N f χ z‖ ≤ (N:ℝ)^2 := calc
    _ ≤ ∑ n ∈ Finset.Icc 1 N, ‖f n * χ (n:ZMod q)/(n:ℂ)^z‖ := norm_sum_le _ _
    _ ≤ ∑ _n ∈ Finset.Icc 1 N, (N:ℝ) := Finset.sum_le_sum hterm
    _ = _ := by simp [Nat.card_Icc,pow_two]
  exact add_le_add_left hsum 1

theorem actual_factor_dyadic_ceiling {q : ℕ} (χ : DirichletCharacter ℂ q)
    (N d : ℕ) (hN : 1 ≤ N) (hd : d ≤ 1) (f : ArithmeticFunction ℂ)
    (hCoeff : ∀ n : ℕ, 1 ≤ n → ‖f n‖ ≤ (Real.log n)^d)
    {c x : ℝ} (hx : 1 ≤ x) (hNscale : (N:ℝ) ≤ c*x) (t : ℝ) :
    ‖ShortAPFactorSampling.factor N f χ (1/2+(t:ℂ)*Complex.I)‖+1 <
      (2:ℝ)^(dyadicBins ((c^2+1)*x^2)) := by
  refine (factor_amplitude_le_quadratic χ N d hN hd f hCoeff t).trans_lt ?_
  apply lt_of_le_of_lt _ (lt_two_pow_dyadicBins _)
  have hpow := pow_le_pow_left₀ (Nat.cast_nonneg (α:=ℝ) N) hNscale 2
  rw [mul_pow] at hpow
  have hx2 : 1 ≤ x^2 := one_le_pow₀ hx
  nlinarith only [hpow,hx2]

/-- The finite dyadic cover specialized to the Section 4 polynomials. -/
theorem actual_interval_energy_le_dyadic {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (N d : ι → ℕ) (f : ι → ArithmeticFunction ℂ)
    (Q : ℕ) (Tmax : ℝ) {x c : ℝ} (hx : 1 ≤ x)
    (hN : ∀ j ∈ s, 1 ≤ N j ∧ (N j:ℝ) ≤ c*x) (hd : ∑ j ∈ s, d j ≤ 1)
    (hCoeff : ∀ j ∈ s, ∀ n : ℕ, 1 ≤ n → ‖f j n‖ ≤ (Real.log n)^d j) :
    let Bfreq := dyadicBins (Tmax+1)
    let Bamp := dyadicBins ((c^2+1)*x^2)
    let F := fun j (χ : ShortAP.CharIndex) (t : ℝ) =>
      ShortAPFactorSampling.factor (N j) (f j) χ.2 (1/2+(t:ℂ)*Complex.I)
    (∑ χ ∈ ShortAP.primitiveFamily Q, ∫ t in Icc (-Tmax) Tmax, ‖∏ j ∈ s, F j χ t‖^2) ≤
      ∑ k : Fin Bfreq, ∑ b : s → Fin Bamp, ∑ χ ∈ ShortAP.primitiveFamily Q,
        ∫ t in amplitudeBox s F ((2:ℝ)^(k:ℕ)) (dyadicAmplitude b) χ,
          ‖∏ j ∈ s, F j χ t‖^2 := by
  intro Bfreq Bamp F
  apply interval_energy_le_sum_bands_boxes
  · exact lt_two_pow_dyadicBins _
  · exact fun χ _ j _ => continuous_factor (N j) (f j) χ.2
  · intro χ _ _ t _ j hj
    have hdj : d j ≤ 1 := (Finset.single_le_sum (fun i _ => Nat.zero_le (d i)) hj).trans hd
    exact actual_factor_dyadic_ceiling χ.2 (N j) (d j) (hN j hj).1 hdj (f j)
      (hCoeff j hj) hx (hN j hj).2 t

/-- Keep just the dyadic pairs covered by the moderate-height and
two-amplitude-cap argument. The factor-length cutoff belongs to the HB block. -/
noncomputable def admissibleDyadicPairs {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (Bfreq Bamp p : ℕ) (x D β : ℝ) : Finset (Fin Bfreq × (s → Fin Bamp)) :=
  (Finset.univ.product Finset.univ).filter fun a =>
    let T := (2:ℝ)^(a.1:ℕ)
    let V := ∏ j ∈ s, (dyadicAmplitude a.2 j)^2
    (D^2*T)*x^β ≤ x*(Real.log x)^120 ∧ V*D^2 ≤ (Real.log x)^512*x ∧
      V*(Real.log x)^(p+512*2048+77) ≤ x

noncomputable def admissibleEnergyConstant (c C CHeight : ℝ) : ℝ :=
  (dyadicBinConstant 1 2 * (dyadicBinConstant 2 (c^2+1))^8) *
    (((2:ℝ)^8)^2 * (4*boxSamplingConstant c C CHeight))

set_option maxRecDepth 8192 in
set_option maxHeartbeats 900000 in
/-- Sum only the actual Section 4 boxes whose heights and amplitudes meet
the stated caps. The complete continuous integral on their union inside
the requested frequency interval costs at most nine logarithms. -/
theorem actual_admissible_dyadic_energy {ι : Type*} [DecidableEq ι]
    {c C C₀ CHeight : ℝ} {p : ℕ} (hp : ShortAPFactorSampling.logExponent 2048 1 ≤ p)
    (hc : 1 ≤ c) (hC : 1 ≤ C) (hC₀ : 0 < C₀) (hHeight : 1 ≤ CHeight) :
    ∀ᶠ x : ℝ in atTop, ∀ (s : Finset ι) (N d : ι → ℕ) (M : ι → ℝ)
      (f : ι → ArithmeticFunction ℂ) (Q : ℕ) (Tmax D θ β : ℝ),
    let Bfreq := dyadicBins (Tmax+1)
    let Bamp := dyadicBins ((c^2+1)*x^2)
    let F := fun j (χ : ShortAP.CharIndex) (t : ℝ) =>
      ShortAPFactorSampling.factor (N j) (f j) χ.2 (1/2+(t:ℂ)*Complex.I)
    let J := admissibleDyadicPairs s Bfreq Bamp p x D β
    let box := fun (a : Fin Bfreq × (s → Fin Bamp)) χ =>
      amplitudeBox s F ((2:ℝ)^(a.1:ℕ)) (dyadicAmplitude a.2) χ
    let P := fun χ => Icc (-Tmax) Tmax ∩ ⋃ a ∈ J, box a χ
    1 ≤ Q → 0 ≤ Tmax → Tmax ≤ x → 0 < D → (Q:ℝ)^2*2 ≤ CHeight*D^2 →
    5/8 ≤ θ → θ ≤ 1 → (1-θ)/3+1/32 ≤ β → s.card ≤ 8 →
    (∀ j ∈ s, (1:ℝ)/4 ≤ M j ∧ M j ≤ x^((1:ℝ)/3-1/256)) →
    x ≤ C₀*(∏ j ∈ s, M j) → (∏ j ∈ s, M j) ≤ C*x →
    (∀ j ∈ s, 1 ≤ N j ∧ (N j:ℝ) ≤ c*M j) → (∑ j ∈ s, d j) ≤ 1 →
    (∀ j ∈ s, ∀ n > N j, f j n = 0) →
    (∀ j ∈ s, ∀ n : ℕ, 1 ≤ n → ‖f j n‖ ≤ (Real.log n)^d j) →
    D^2*x^β*(Real.log x)^19 = x^θ →
    (∑ χ ∈ ShortAP.primitiveFamily Q, ∫ t in P χ, ‖∏ j ∈ s, F j χ t‖^2) *
      (Real.log x)^68 ≤ admissibleEnergyConstant c C CHeight*x := by
  classical
  filter_upwards [eventually_ge_atTop (Real.exp 1), actual_box_energy (ι := ι) hp hc hC hC₀ hHeight]
    with x hx hBox
  intro s N d M f Q Tmax D θ β Bfreq Bamp F J box P hQ hTmax hTx hD hHeightQ hθ hθ' hβ hs hM
    hprod hprod' hN hd hSupport hCoeff hid
  let L := Real.log x
  let a := dyadicBinConstant 1 2
  let b := dyadicBinConstant 2 (c^2+1)
  let K := ((2:ℝ)^8)^2 * (4*boxSamplingConstant c C CHeight)
  let I := ShortAP.primitiveFamily Q
  let E (k : Fin Bfreq × (s → Fin Bamp)) :=
    ∑ χ ∈ I, ∫ t in box k χ, ‖∏ j ∈ s, F j χ t‖^2
  let W (k : Fin Bfreq) (u : s → Fin Bamp) := if (k,u) ∈ J then E (k,u)*L^77 else 0
  let A := ∑ χ ∈ I, ∫ t in P χ, ‖∏ j ∈ s, F j χ t‖^2
  change A*L^68 ≤ (a*b^8*K)*x
  have hL : 1 ≤ L := by
    dsimp only [L]
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hx₁ : 1 ≤ x := (Real.one_le_exp (by norm_num : (0:ℝ) ≤ 1)).trans hx
  have hK₀ : 0 ≤ boxSamplingConstant c C CHeight :=
    show _ from add_nonneg (ShortAPFactorSampling.commonSamplingConstant_nonneg 2048 hc hHeight)
      (ShortAPComplementSampling.complementConstant_nonneg hc hC hHeight)
  have hK : 0 ≤ K := mul_nonneg (sq_nonneg _) (mul_nonneg (by norm_num) hK₀)
  have hW (k : Fin Bfreq) (u : s → Fin Bamp) : W k u ≤ K*x := by
    by_cases hu : (k,u) ∈ J
    · have hAd := (Finset.mem_filter.mp hu).2
      let T := (2:ℝ)^(k:ℕ)
      have hT : 1 ≤ T := one_le_pow₀ (by norm_num)
      have hHT : (Q:ℝ)^2*(2*T) ≤ CHeight*(D^2*T) := calc
        _ = ((Q:ℝ)^2*2)*T := by ring
        _ ≤ (CHeight*D^2)*T := mul_le_mul_of_nonneg_right hHeightQ (zero_le_one.trans hT)
        _ = _ := by ring
      rw [show W k u = E (k,u)*L^77 by dsimp only [W]; rw [ite_eq_left hu]]
      exact hBox s N d M (dyadicAmplitude u) f Q T (D^2*T) D θ β hQ hT
        (mul_nonneg (sq_nonneg _) (zero_le_one.trans hT)) hD hHT hθ hθ' hβ hs hM hprod hprod'
        hN (fun j _ => one_le_dyadicAmplitude u j) hd hSupport hCoeff hid hAd.1 hAd.2.1 hAd.2.2
    · rw [show W k u = 0 by dsimp only [W]; rw [ite_eq_right hu]]
      exact mul_nonneg hK (zero_le_one.trans hx₁)
  have hPos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have ha : 0 ≤ a := by
    dsimp only [a,dyadicBinConstant]
    positivity
  have hBfreq : (Bfreq:ℝ) ≤ a*L := by
    apply dyadicBins_le_log (a := 1) (C := 2) hx (by linarith) (by norm_num)
    rw [Real.rpow_one]
    linarith
  have hBamp : (Bamp:ℝ) ≤ b*L := by
    have h := add_le_add_left (sq_nonneg c) 1
    have hx₂ : 1 ≤ x^2 := one_le_pow₀ hx₁
    apply dyadicBins_le_log (a := 2) (C := c^2+1)
      hx (one_le_mul_of_one_le_of_one_le (by linarith only [h]) hx₂)
      (by linarith only [h])
    rw [Real.rpow_two]
  have hBamp1 : 1 ≤ Bamp := by dsimp only [Bamp,dyadicBins]; omega
  have hSummed := sum_dyadic_budget s hs hBamp1 ha (zero_le_one.trans hL)
    (mul_nonneg hK (zero_le_one.trans hx₁)) hBfreq hBamp W hW
  have hCover : A ≤ ∑ k ∈ J, E k := calc
    _ ≤ ∑ χ ∈ I, ∑ k ∈ J, ∫ t in box k χ, ‖∏ j ∈ s, F j χ t‖^2 := by
      refine Finset.sum_le_sum fun χ _ => ?_
      let G (t : ℝ) := ‖∏ j ∈ s, F j χ t‖^2
      have hF (j : ι) : Continuous (F j χ) := continuous_factor (N j) (f j) χ.2
      have hG : Continuous G := (continuous_finsetProd _ (fun j _ => hF j)).norm.pow _
      have hMb (k : Fin Bfreq × (s → Fin Bamp)) : MeasurableSet (box k χ) :=
        measurableSet_amplitudeBox s F _ _ χ (fun j _ => hF j)
      have hP : MeasurableSet (P χ) := measurableSet_Icc.inter
        (J.measurableSet_biUnion (fun k _ => hMb k))
      apply setIntegral_le_cover_sum J _ (fun k => box k χ) G hP (fun _ => sq_nonneg _)
      · exact fun k _ => hMb k
      · exact fun k _ => hG.integrableOn_Icc.mono_set (inter_subset_left.trans frequencyBand_subset)
      · intro t ht
        obtain ⟨k,hk⟩ := mem_iUnion.mp ht.2
        obtain ⟨hJ,hmem⟩ := mem_iUnion.mp hk
        exact ⟨k,hJ,hmem⟩
    _ = _ := Finset.sum_comm
  have hSumEq : (∑ k ∈ J, E k)*L^77 = ∑ k : Fin Bfreq, ∑ u : s → Fin Bamp, W k u := by
    rw [Finset.sum_mul]
    calc
      _ = ∑ k ∈ J, W k.1 k.2 := Finset.sum_congr rfl fun k hk => by
        dsimp only [W]
        rw [ite_eq_left (show (k.1,k.2) ∈ J from hk)]
      _ = ∑ k ∈ Finset.univ.product Finset.univ, W k.1 k.2 := Finset.sum_subset
        (Finset.filter_subset _ _) (fun k _ hk => by
          dsimp only [W]
          rw [ite_eq_right (show (k.1,k.2) ∉ J from hk)])
      _ = _ := Finset.sum_product _ _ _
  apply (le_of_mul_le_mul_right · (pow_pos (zero_lt_one.trans_le hL) 9))
  calc
    A*L^68*L^9 = A*L^77 := by rw [mul_assoc, ← pow_add]
    _ ≤ (∑ k ∈ J, E k)*L^77 := mul_le_mul_of_nonneg_right hCover (pow_nonneg (zero_le_one.trans hL) _)
    _ = _ := hSumEq
    _ ≤ (a*b^8)*L^9*(K*x) := hSummed
    _ = _ := by ring

end ShortAPFrequencyAssembly

end

section

/-!
# Critical-line Möbius factors in the small-conductor reduction

The Abel and convolution identities below are for the coefficients of the
sharp Möbius factors in Koukoulopoulos, *Primes in short arithmetic progressions*,
§4, (4.8). A prime character initial sum estimate must first be transferred to the
Möbius initial sum; it cannot simply replace it in Abel summation.
-/

open Finset MeasureTheory ArithmeticFunction
open scoped BigOperators ArithmeticFunction.Moebius ArithmeticFunction.zeta

namespace ShortAPSmallConductorMobius

open ShortAPLongWindowAnalyticSupport.Conjectures.Goldbach.PacketRationalPeakExcess_aux.OAI.LargePrimeGaps

noncomputable section

def critical (t : ℝ) : ℂ := 1 / 2 + (t : ℂ) * Complex.I

def mobiusTwist {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  (μ n : ℂ) * χ (n : ZMod q)

def mobiusPrefix {q : ℕ} (χ : DirichletCharacter ℂ q) (y : ℝ) : ℂ :=
  ∑ n ∈ Finset.Icc 0 ⌊y⌋₊, mobiusTwist χ n

def mobiusPoly {q : ℕ} (χ : DirichletCharacter ℂ q) (t a b : ℝ) : ℂ :=
  ∑ n ∈ Finset.Ioc ⌊a⌋₊ ⌊b⌋₊, mobiusTwist χ n / (n : ℂ) ^ critical t

private theorem norm_critical (t : ℝ) : ‖critical t‖ ≤ 1 + |t| := by
  calc
    ‖critical t‖ ≤ ‖(1 / 2 : ℂ)‖ + ‖(t : ℂ) * Complex.I‖ := norm_add_le _ _
    _ ≤ _ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one, norm_div,
        norm_one]
      norm_num

/-- Abel summation on a sharp interval contained in one dyadic shell. The loss
is linear in `|t|`, so this transfer alone does not cover the high frequencies
in (4.8). -/
theorem mobiusPoly_le_of_prefix {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ)
    {a b B : ℝ} (ha : 0 < a) (hab : a ≤ b) (hb : b ≤ 2 * a) (hB : 0 ≤ B)
    (hprefix : ∀ y ∈ Set.Icc a b, ‖mobiusPrefix χ y‖ ≤ B) :
    ‖mobiusPoly χ t a b‖ ≤ (3 + |t|) * B * a ^ (-(1 / 2 : ℝ)) := by
  let s := critical t
  let f (y : ℝ) := (y : ℂ) ^ (-s)
  have hs : s.re = 1 / 2 := by simp [s, critical]
  have hp (y : ℝ) (hy : y ∈ Set.Icc a b) : 0 < y := ha.trans_le hy.1
  have hd (y : ℝ) (hy : y ∈ Set.Icc a b) :
      deriv f y = (-s) * (y : ℂ) ^ (-s - 1) := Complex.deriv_ofReal_cpow_const _ (hp y hy).ne'
  have hcont : ContinuousOn (deriv f) (Set.Icc a b) := by
    apply ContinuousOn.congr _ hd
    exact continuousOn_const.mul (Complex.continuous_ofReal.continuousOn.cpow_const
      (fun y hy => Complex.ofReal_mem_slitPlane.2 (hp y hy)))
  have hfi : ∀ y ∈ Set.Icc a b, DifferentiableAt ℝ f y :=
    fun y hy => differentiableAt_id.ofReal_cpow_const _ (hp y hy).ne'
  have hInt : IntegrableOn (deriv f) (Set.Icc a b) volume := hcont.integrableOn_compact isCompact_Icc
  have habel := sum_mul_eq_sub_sub_integral_mul (mobiusTwist χ) ha.le hab hfi hInt
  have hpoly : mobiusPoly χ t a b =
      f b * mobiusPrefix χ b - f a * mobiusPrefix χ a -
        ∫ y in Set.Ioc a b, deriv f y * mobiusPrefix χ y := by
    unfold mobiusPrefix
    rw [← habel]
    unfold mobiusPoly
    apply Finset.sum_congr rfl
    intro n _
    simp only [f, s, Complex.ofReal_natCast, Complex.cpow_neg, div_eq_mul_inv, mul_comm]
  have hfn (y : ℝ) (hy : y ∈ Set.Icc a b) : ‖f y‖ ≤ a ^ (-(1 / 2 : ℝ)) := by
    have hre : (-s).re = -(1 / 2 : ℝ) := by rw [Complex.neg_re, hs]
    change ‖(y : ℂ) ^ (-s)‖ ≤ _
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (hp y hy), hre]
    exact Real.rpow_le_rpow_of_nonpos ha hy.1 (by norm_num)
  have hdn (y : ℝ) (hy : y ∈ Set.Icc a b) : ‖deriv f y‖ ≤
      (1 + |t|) * a ^ (-(3 / 2 : ℝ)) := by
    have hre : (-s - 1).re = -(3 / 2 : ℝ) := by
      rw [Complex.sub_re, Complex.neg_re, Complex.one_re, hs]; ring
    rw [hd y hy, norm_mul, norm_neg, Complex.norm_cpow_eq_rpow_re_of_pos (hp y hy), hre]
    exact mul_le_mul (norm_critical t) (Real.rpow_le_rpow_of_nonpos ha hy.1 (by norm_num))
      (Real.rpow_nonneg (hp y hy).le _) (by positivity)
  have hI : ‖∫ y in Set.Ioc a b, deriv f y * mobiusPrefix χ y‖ ≤
      a * (((1 + |t|) * a ^ (-(3 / 2 : ℝ))) * B) := by
    have hh := norm_setIntegral_le_of_norm_le_const (show volume (Set.Ioc a b) < ⊤ from measure_Ioc_lt_top)
      (f := fun y => deriv f y * mobiusPrefix χ y)
      (C := ((1 + |t|) * a ^ (-(3 / 2 : ℝ))) * B) (fun y hy => by
        rw [norm_mul]
        have hy' := Set.Ioc_subset_Icc_self hy
        exact mul_le_mul (hdn y hy') (hprefix y hy') (norm_nonneg _) (by positivity))
    rw [Measure.real, Real.volume_Ioc, ENNReal.toReal_ofReal (sub_nonneg.mpr hab)] at hh
    exact hh.trans ((mul_le_mul_of_nonneg_left (show b - a ≤ a by linarith) (by positivity)).trans_eq
      (mul_comm _ _))
  rw [hpoly]
  have ha' : a * a ^ (-(3 / 2 : ℝ)) = a ^ (-(1 / 2 : ℝ)) := by
    calc
      _ = a ^ (1 : ℝ) * a ^ (-(3 / 2 : ℝ)) := by rw [Real.rpow_one]
      _ = _ := by rw [← Real.rpow_add ha]; congr 1; norm_num
  calc
    _ ≤ ‖f b * mobiusPrefix χ b‖ + ‖f a * mobiusPrefix χ a‖ +
        ‖∫ y in Set.Ioc a b, deriv f y * mobiusPrefix χ y‖ :=
      (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ (a ^ (-(1 / 2 : ℝ)) * B + a ^ (-(1 / 2 : ℝ)) * B) +
        a * (((1 + |t|) * a ^ (-(3 / 2 : ℝ))) * B) := by
      simp only [norm_mul]
      have e (y : ℝ) (hy : y ∈ Set.Icc a b) : ‖f y‖ * ‖mobiusPrefix χ y‖ ≤
          a ^ (-(1 / 2 : ℝ)) * B :=
        mul_le_mul (hfn y hy) (hprefix y hy) (norm_nonneg _) (by positivity)
      exact add_le_add (add_le_add (e b ⟨hab, le_rfl⟩) (e a ⟨le_rfl, hab⟩)) hI
    _ = _ := by
      calc _ = (a ^ (-(1 / 2 : ℝ)) * B + a ^ (-(1 / 2 : ℝ)) * B) +
          (1 + |t|) * B * (a * a ^ (-(3 / 2 : ℝ))) := by ring
           _ = _ := by rw [ha']; ring

/-- Twisting a real arithmetic function by a completely multiplicative
Dirichlet character commutes with Dirichlet convolution. -/
def twist {q : ℕ} (χ : DirichletCharacter ℂ q) (f : ArithmeticFunction ℝ) : ArithmeticFunction ℂ :=
  ⟨fun n => (f n : ℂ) * χ (n : ZMod q), by simp⟩

@[simp] theorem twist_apply {q : ℕ} (χ : DirichletCharacter ℂ q)
    (f : ArithmeticFunction ℝ) (n : ℕ) : twist χ f n = (f n : ℂ) * χ (n : ZMod q) := rfl

theorem twist_mul {q : ℕ} (χ : DirichletCharacter ℂ q) (f g : ArithmeticFunction ℝ) :
    twist χ (f * g) = twist χ f * twist χ g := by
  ext n
  simp only [twist_apply, ArithmeticFunction.mul_apply, Complex.ofReal_sum, Complex.ofReal_mul,
    Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro p hp
  rw [← (Nat.mem_divisorsAntidiagonal.mp hp).1, Nat.cast_mul, map_mul]
  ring

private theorem twist_one {q : ℕ} (χ : DirichletCharacter ℂ q) : twist χ 1 = 1 := by
  ext n
  by_cases hn : n = 1 <;> simp [hn]

def logMultiply (f : ArithmeticFunction ℂ) : ArithmeticFunction ℂ :=
  ⟨fun n => f n * (Real.log (n : ℝ) : ℂ), by simp⟩

@[simp] theorem logMultiply_apply (f : ArithmeticFunction ℂ) (n : ℕ) :
    logMultiply f n = f n * (Real.log (n : ℝ) : ℂ) := rfl

private theorem logMultiply_one : logMultiply 1 = 0 := by
  ext n
  by_cases hn : n = 1 <;> simp [hn]

theorem logMultiply_mul (f g : ArithmeticFunction ℂ) :
    logMultiply (f * g) = logMultiply f * g + f * logMultiply g := by
  ext n
  simp only [logMultiply_apply, add_apply, ArithmeticFunction.mul_apply,
    Finset.sum_mul, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro p hp
  have hp₁ : (p.1 : ℝ) ≠ 0 := by exact_mod_cast Nat.left_ne_zero_of_mem_divisorsAntidiagonal hp
  have hp₂ : (p.2 : ℝ) ≠ 0 := by exact_mod_cast Nat.right_ne_zero_of_mem_divisorsAntidiagonal hp
  rw [← (Nat.mem_divisorsAntidiagonal.mp hp).1, Nat.cast_mul, Real.log_mul hp₁ hp₂, Complex.ofReal_add]
  ring

private theorem logMultiply_twist_zeta {q : ℕ} (χ : DirichletCharacter ℂ q) :
    logMultiply (twist χ ζ) = twist χ ArithmeticFunction.log := by
  ext n
  by_cases hn : n = 0
  · simp [hn]
  · simp [ArithmeticFunction.zeta_apply_ne hn, mul_comm]

/-- The exact twisted Möbius logarithmic identity needed to transfer a prime
character estimate to Möbius: `(μχ) log = -(μχ)*(Λχ)`, with Dirichlet convolution. -/
theorem logMultiply_mobius_twist {q : ℕ} (χ : DirichletCharacter ℂ q) :
    logMultiply (twist χ μ) = -(twist χ μ * twist χ ArithmeticFunction.vonMangoldt) := by
  let M := twist χ μ
  let Z := twist χ ζ
  let L := twist χ ArithmeticFunction.vonMangoldt
  have hinv : M * Z = 1 := by
    dsimp only [M, Z]
    rw [← twist_mul, ArithmeticFunction.coe_moebius_mul_coe_zeta, twist_one]
  have hlogz : logMultiply Z = L * Z := by
    dsimp only [Z, L]
    rw [logMultiply_twist_zeta, ← twist_mul, ArithmeticFunction.vonMangoldt_mul_zeta]
  have hmain : (logMultiply M + M * L) * Z = 0 := by
    calc
      _ = logMultiply M * Z + M * logMultiply Z := by rw [add_mul, mul_assoc M L Z, hlogz]
      _ = logMultiply (M * Z) := (logMultiply_mul M Z).symm
      _ = _ := by rw [hinv, logMultiply_one]
  have hsum := congrArg (fun x : ArithmeticFunction ℂ => x * M) hmain
  change ((logMultiply M + M * L) * Z) * M = 0 * M at hsum
  rw [mul_assoc, mul_comm Z M, hinv, mul_one, zero_mul] at hsum
  change logMultiply M = -(M * L)
  calc
    _ = (logMultiply M + M * L) - M * L := by ring
    _ = _ := by rw [hsum, zero_sub]

/-- The actual sharp factor necessarily stops at the smaller of `2N` and the
Heath--Brown truncation `H`; neither endpoint is rounded in the wrong direction. -/
theorem sharpBoxFactor_eq {H j i d n : ℕ} (hi : j + 1 ≤ i) :
    ShortAPBoxedHB.boxFactor H j i d n =
      if ShortAPDyadicPartition.scale d < (n : ℝ) ∧
          (n : ℝ) ≤ min (2 * ShortAPDyadicPartition.scale d) H then (μ n : ℝ) else 0 := by
  let N := ShortAPDyadicPartition.scale d
  have hN : 0 < N := ShortAPDyadicPartition.scale_pos d
  have hs : ShortAPBoxedHB.isSharp j i = true := by simp [ShortAPBoxedHB.isSharp, hi]
  have hi0 : i ≠ 0 := by omega
  have h1 : 1 < (n : ℝ) / N ↔ N < n := by rw [lt_div_iff₀ hN, one_mul]
  have h2 : (n : ℝ) / N ≤ 2 ↔ (n : ℝ) ≤ 2 * N := div_le_iff₀ hN
  have h3 : (n : ℝ) ≤ H ↔ n ≤ H := by norm_cast
  simp only [ShortAPBoxedHB.boxFactor, hs, ite_true, ShortAPDyadicPartition.piece_apply,
    ShortAPHeathBrown.factor, ite_eq_right hi0, ite_eq_right (not_lt.mpr hi), ShortAPHeathBrown.truncate_apply]
  change (if 1 < (n : ℝ) / N ∧ (n : ℝ) / N ≤ 2 then (1 : ℝ) else 0) *
      (if n ≤ H then (μ n : ℝ) else 0) =
    if N < (n : ℝ) ∧ (n : ℝ) ≤ min (2 * N) H then (μ n : ℝ) else 0
  simp only [h1, h2, le_min_iff, h3]
  by_cases ha : N < (n : ℝ) <;> by_cases hb : (n : ℝ) ≤ 2 * N <;>
    by_cases hc : n ≤ H <;> simp [ha, hb, hc]

/-- The truncated polynomial of the original sharp box is the genuine
Möbius polynomial on `(N, min(2*N,H)]`, rather than an untruncated shell. -/
theorem sharpBoxPoly_eq {H j i d q : ℕ} (hi : j + 1 ≤ i)
    (χ : DirichletCharacter ℂ q) (t : ℝ) :
    (∑ n ∈ Finset.Icc 1 ⌊2 * ShortAPDyadicPartition.scale d⌋₊,
      (ShortAPBoxedHB.boxFactor H j i d n : ℂ) * χ (n : ZMod q) / (n : ℂ) ^ critical t) =
      mobiusPoly χ t (ShortAPDyadicPartition.scale d) (min (2 * ShortAPDyadicPartition.scale d) H) := by
  let N := ShortAPDyadicPartition.scale d
  let Y := min (2 * N) (H : ℝ)
  have hN : 0 < N := ShortAPDyadicPartition.scale_pos d
  have hY : 0 ≤ Y := le_min (by positivity) (Nat.cast_nonneg H)
  have hmem (n : ℕ) : n ∈ Finset.Ioc ⌊N⌋₊ ⌊Y⌋₊ ↔ N < (n : ℝ) ∧ (n : ℝ) ≤ Y := by
    rw [Finset.mem_Ioc, Nat.floor_lt hN.le, Nat.le_floor_iff hY]
  have hsub : Finset.Ioc ⌊N⌋₊ ⌊Y⌋₊ ⊆ Finset.Icc 1 ⌊2 * N⌋₊ := by
    intro n hn
    exact Finset.mem_Icc.mpr ⟨(Finset.mem_Ioc.mp hn).1.pos,
      (Finset.mem_Ioc.mp hn).2.trans (Nat.floor_mono (min_le_left _ _))⟩
  change (∑ n ∈ Finset.Icc 1 ⌊2*N⌋₊,
    (ShortAPBoxedHB.boxFactor H j i d n : ℂ) * χ (n : ZMod q) / (n : ℂ)^critical t) =
    ∑ n ∈ Finset.Ioc ⌊N⌋₊ ⌊Y⌋₊, mobiusTwist χ n / (n : ℂ)^critical t
  calc
    _ = ∑ n ∈ Finset.Ioc ⌊N⌋₊ ⌊Y⌋₊,
        (ShortAPBoxedHB.boxFactor H j i d n : ℂ) * χ (n : ZMod q) / (n : ℂ)^critical t := by
      symm
      refine Finset.sum_subset hsub fun n _ hn => ?_
      rw [sharpBoxFactor_eq hi, ite_eq_right (fun h => hn ((hmem n).2 h))]
      simp
    _ = _ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [sharpBoxFactor_eq hi, ite_eq_left ((hmem n).1 hn)]
      simp [mobiusTwist]

/-- The uniform, unshifted Siegel--Walfisz estimate for the prime-character
initial sum at actual primitive conductors `q>1` (hence no principal main term).
Uses the openai/math/DFQDZZ development attributed in `ShortAPLongWindow`.
This is an estimate for `Λχ`, not `μχ`. -/
theorem prime_prefix_siegelWalfisz (A B : ℝ) (hA : 0 < A) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∃ X : ℝ, 1 < X ∧
      ∀ x : ℝ, X ≤ x → ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log x) ^ B →
        ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
          ‖primeCharacterPrefix x χ‖ ≤ C * x * (Real.log x) ^ (-A) := by
  obtain ⟨C, hC, X, hX, h⟩ := siegelWalfisz A B hA hB
  refine ⟨C, hC, X, hX, ?_⟩
  intro x hx q hq hq' χ hp
  have hq0 : 0 < q := Nat.zero_lt_one.trans hq
  have : NeZero q := ⟨hq0.ne'⟩
  have hnon : χ ≠ 1 := by
    intro hχ
    have hc := (DirichletCharacter.isPrimitive_def χ).1 hp
    rw [hχ, DirichletCharacter.conductor_one] at hc
    omega
  simpa [primeCharacterError, hnon] using h x hx q hq0 hq' χ hp

/-- Exact finite hyperbola expansion for the logarithmically weighted
Möbius initial sum. The next analytic step must bound this convolution. -/
theorem logWeighted_mobius_prefix_eq {q : ℕ} (χ : DirichletCharacter ℂ q) (X : ℕ) :
    (∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)) =
      -(∑ d ∈ Finset.Ioc 0 X, mobiusTwist χ d * primeCharacterPrefix (X / d : ℕ) χ) := by
  let F := twist χ μ
  let G := twist χ ArithmeticFunction.vonMangoldt
  have he : logMultiply F = -(F * G) := logMultiply_mobius_twist χ
  have e (n : ℕ) : F n = mobiusTwist χ n := by
    simp [F, mobiusTwist]
  have hprefix (n : ℕ) : (∑ u ∈ Finset.Ioc 0 n, G u) = primeCharacterPrefix (n : ℝ) χ := by
    simp [primeCharacterPrefix, G, mul_comm]
  calc
    _ = ∑ n ∈ Finset.Ioc 0 X, (logMultiply F) n := by simp only [logMultiply_apply, e]
    _ = -(∑ n ∈ Finset.Ioc 0 X, (F * G) n) := by simp [he, Finset.sum_neg_distrib]
    _ = _ := by
      rw [ArithmeticFunction.sum_Ioc_mul_eq_sum_sum]
      simp only [e, hprefix]

open Filter

theorem norm_mobiusTwist_le_one {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) :
    ‖mobiusTwist χ n‖ ≤ 1 := by
  have hm : ‖(μ n : ℂ)‖ ≤ 1 := by
    rw [Complex.norm_intCast, ← Int.cast_abs]
    exact_mod_cast ArithmeticFunction.abs_moebius_le_one (n := n)
  rw [mobiusTwist, norm_mul]
  exact (mul_le_mul hm (χ.norm_le_one _) (norm_nonneg _) zero_le_one).trans_eq (one_mul _)

private theorem primeCharacterPrefix_trivial {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) :
    ‖primeCharacterPrefix (n : ℝ) χ‖ ≤ (Real.log 4 + 4) * n := by
  unfold primeCharacterPrefix
  simp only [Nat.floor_natCast]
  calc
    _ ≤ ∑ k ∈ Finset.Ioc 0 n, ‖χ (k : ZMod q) * (ArithmeticFunction.vonMangoldt k : ℂ)‖ :=
      norm_sum_le _ _
    _ ≤ ∑ k ∈ Finset.Ioc 0 n, ArithmeticFunction.vonMangoldt k := by
      apply Finset.sum_le_sum
      intro k _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ArithmeticFunction.vonMangoldt_nonneg]
      exact mul_le_of_le_one_left ArithmeticFunction.vonMangoldt_nonneg (χ.norm_le_one _)
    _ = Chebyshev.psi (n : ℝ) := by simp [Chebyshev.psi]
    _ ≤ _ := Chebyshev.psi_le_const_mul_self (Nat.cast_nonneg n)

theorem harmonic_prefix (X : ℕ) :
    (∑ d ∈ Finset.Ioc 0 X, (d : ℝ)⁻¹) ≤ 1 + Real.log X := by
  have he : Finset.Ioc 0 X = Finset.Icc 1 X := by
    ext d
    simp only [Finset.mem_Ioc, Finset.mem_Icc]
    omega
  rw [he, ← show (harmonic X : ℝ) = ∑ d ∈ Finset.Icc 1 X, (d : ℝ)⁻¹ by
    simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast]]
  exact harmonic_le_one_add_log X

private theorem harmonic_tail (X K : ℕ) (hK : 0 < K) (hKX : K ≤ X) :
    (∑ d ∈ Finset.Ioc (X / K) X, (d : ℝ)⁻¹) ≤ Real.log (2 * (K : ℝ)) := by
  let A := X / K
  have hA : 0 < A := Nat.div_pos hKX hK
  have hAx : A ≤ X := Nat.div_le_self _ _
  have hAr : 0 < (A : ℝ) := by exact_mod_cast hA
  have hXr : 0 < (X : ℝ) := by exact_mod_cast hA.trans_le hAx
  have hprod : X ≤ 2 * K * A := by
    calc
      X = X % K + K * A := (Nat.mod_add_div X K).symm
      _ ≤ K * A + K * A := Nat.add_le_add
        ((Nat.mod_lt X hK).le.trans (Nat.le_mul_of_pos_right K hA)) le_rfl
      _ = _ := by ring
  have hdiv : (X : ℝ) / A ≤ 2 * K := by
    apply (div_le_iff₀ hAr).2
    exact_mod_cast hprod
  calc
    _ = ∑ i ∈ Finset.Ico A X, ((i + 1 : ℕ) : ℝ)⁻¹ := by
      rw [Finset.sum_Ico_add' (fun i : ℕ => (i : ℝ)⁻¹) A X (c := 1),
        Finset.Ico_add_one_add_one_eq_Ioc]
    _ ≤ ∫ y in (A : ℝ)..(X : ℝ), y⁻¹ :=
      (inv_antitoneOn_Icc_right hAr).sum_le_integral_Ico hAx
    _ = _ := integral_inv_of_pos hAr hXr
    _ ≤ _ := Real.log_le_log (div_pos hXr hAr) hdiv

/-- Explicit transfer budget for the first round: the cutoff `K` separates
the range where the prime initial sum enjoys cancellation from the small-range
part, estimated by Chebyshev and a short harmonic sum. -/
theorem log_weighted_prefix_le_split {q : ℕ} (χ : DirichletCharacter ℂ q)
    (X K : ℕ) (hK : 0 < K) (hKX : K ≤ X) {ε : ℝ} (hε : 0 ≤ ε)
    (hprime : ∀ y : ℕ, K ≤ y → y ≤ X → ‖primeCharacterPrefix (y : ℝ) χ‖ ≤ ε * y) :
    ‖∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)‖ ≤
      ε * X * (1 + Real.log X) + (Real.log 4 + 4) * X * Real.log (2 * (K : ℝ)) := by
  let D := X / K
  have hD : D ≤ X := Nat.div_le_self _ _
  have hC : 0 ≤ Real.log 4 + 4 := by positivity
  have hdiv (d : ℕ) (hd : 0 < d) : ((X / d : ℕ) : ℝ) ≤ (X : ℝ) * (d : ℝ)⁻¹ := by
    rw [← div_eq_mul_inv]
    apply (le_div_iff₀ (Nat.cast_pos.mpr hd)).2
    exact_mod_cast Nat.div_mul_le_self X d
  let f (d : ℕ) := ‖mobiusTwist χ d * primeCharacterPrefix (X / d : ℕ) χ‖
  have hs : (∑ d ∈ Finset.Ioc 0 D, f d) ≤ ε * X * (1 + Real.log X) := by
    calc
      _ ≤ ∑ d ∈ Finset.Ioc 0 D, ε * X * (d : ℝ)⁻¹ := by
        apply Finset.sum_le_sum
        intro d hd
        have hm := Finset.mem_Ioc.mp hd
        have hdk : K ≤ X / d := (Nat.le_div_iff_mul_le hm.1).2 (by
          rw [mul_comm]
          exact (Nat.le_div_iff_mul_le hK).1 hm.2)
        unfold f
        rw [norm_mul]
        calc
          _ ≤ ‖primeCharacterPrefix (X / d : ℕ) χ‖ :=
            mul_le_of_le_one_left (norm_nonneg _) (norm_mobiusTwist_le_one χ d)
          _ ≤ ε * (X / d : ℕ) := hprime _ hdk (Nat.div_le_self _ _)
          _ ≤ ε * ((X : ℝ) * (d : ℝ)⁻¹) := mul_le_mul_of_nonneg_left (hdiv d hm.1) hε
          _ = _ := (mul_assoc _ _ _).symm
      _ ≤ ∑ d ∈ Finset.Ioc 0 X, ε * X * (d : ℝ)⁻¹ :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.Ioc_subset_Ioc_right hD)
          (fun _ _ _ => by positivity)
      _ ≤ _ := by rw [← Finset.mul_sum]; exact mul_le_mul_of_nonneg_left (harmonic_prefix X) (by positivity)
  have hl : (∑ d ∈ Finset.Ioc D X, f d) ≤ (Real.log 4 + 4) * X * Real.log (2 * (K : ℝ)) := by
    calc
      _ ≤ ∑ d ∈ Finset.Ioc D X, (Real.log 4 + 4) * X * (d : ℝ)⁻¹ := by
        apply Finset.sum_le_sum
        intro d hd
        have hd0 : 0 < d := Nat.zero_le D |>.trans_lt (Finset.mem_Ioc.mp hd).1
        unfold f
        rw [norm_mul]
        calc
          _ ≤ ‖primeCharacterPrefix (X / d : ℕ) χ‖ :=
            mul_le_of_le_one_left (norm_nonneg _) (norm_mobiusTwist_le_one χ d)
          _ ≤ _ := primeCharacterPrefix_trivial χ _
          _ ≤ (Real.log 4 + 4) * ((X : ℝ) * (d : ℝ)⁻¹) :=
            mul_le_mul_of_nonneg_left (hdiv d hd0) hC
          _ = _ := (mul_assoc _ _ _).symm
      _ ≤ _ := by rw [← Finset.mul_sum]; exact mul_le_mul_of_nonneg_left (harmonic_tail X K hK hKX) (by positivity)
  rw [logWeighted_mobius_prefix_eq, norm_neg]
  exact (norm_sum_le _ _).trans (by
    change (∑ d ∈ Finset.Ioc 0 X, f d) ≤ _
    rw [← Finset.sum_Ioc_consecutive _ (Nat.zero_le D) hD]
    exact add_le_add hs hl)

private theorem sum_log_deficit_le (X : ℕ) (hX : 1 ≤ X) :
    (∑ n ∈ Finset.Ioc 0 X, (Real.log (X : ℝ) - Real.log (n : ℝ))) ≤ (X : ℝ) := by
  have hmono : MonotoneOn Real.log (Set.Icc (1 : ℝ) X) := by
    intro a ha b hb hab
    exact Real.log_le_log (zero_lt_one.trans_le ha.1) hab
  have hl := hmono.integral_le_sum_Ico hX
  rw [Finset.sum_Ico_add' (fun i : ℕ => Real.log (i : ℝ)) 1 X (c := 1),
    Finset.Ico_add_one_add_one_eq_Ioc] at hl
  have hs : (∑ n ∈ Finset.Ioc 0 X, Real.log n) = ∑ n ∈ Finset.Ioc 1 X, Real.log n := by
    rw [← Finset.sum_Ioc_consecutive _ (by decide : (0 : ℕ) ≤ 1) hX]
    have he : Finset.Ioc (0 : ℕ) 1 = {1} := by ext n; simp only [Finset.mem_Ioc, Finset.mem_singleton]; omega
    simp [he]
  simp only [Nat.cast_one, integral_log, Real.log_one, mul_zero, sub_zero] at hl
  rw [Finset.sum_sub_distrib, Finset.sum_const, Nat.card_Ioc, Nat.sub_zero, nsmul_eq_mul, hs]
  linarith

private theorem mobiusPrefix_mul_log_le (X : ℕ) (hX : 1 ≤ X) {q : ℕ} (χ : DirichletCharacter ℂ q) :
    ‖mobiusPrefix χ (X : ℝ)‖ * Real.log X ≤
      ‖∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)‖ + X := by
  let L := Real.log (X : ℝ)
  have hL : 0 ≤ L := Real.log_nonneg (by exact_mod_cast hX)
  have hf : mobiusPrefix χ (X : ℝ) = ∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n := by
    unfold mobiusPrefix
    rw [Nat.floor_natCast, ← Finset.add_sum_Ioc_eq_sum_Icc (Nat.zero_le X)]
    simp [mobiusTwist]
  have he : mobiusPrefix χ (X : ℝ) * (L : ℂ) =
      (∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)) +
        ∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * ((L - Real.log (n : ℝ) : ℝ) : ℂ) := by
    rw [hf, Finset.sum_mul, ← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro n _
    push_cast
    ring
  have hdeficit : ‖∑ n ∈ Finset.Ioc 0 X,
      mobiusTwist χ n * ((L - Real.log (n : ℝ) : ℝ) : ℂ)‖ ≤ X := by
    apply (norm_sum_le _ _).trans
    refine (Finset.sum_le_sum (g := fun n : ℕ => L - Real.log (n : ℝ)) (fun n hn => ?_)).trans
      (sum_log_deficit_le X hX)
    have hm := Finset.mem_Ioc.mp hn
    have hnon : 0 ≤ L - Real.log (n : ℝ) := sub_nonneg.mpr
      (Real.log_le_log (by exact_mod_cast hm.1) (by exact_mod_cast hm.2))
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hnon]
    exact mul_le_of_le_one_left hnon (norm_mobiusTwist_le_one χ n)
  calc
    _ = ‖mobiusPrefix χ (X : ℝ) * (L : ℂ)‖ := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hL]
    _ ≤ _ := by rw [he]; exact (norm_add_le _ _).trans (add_le_add le_rfl hdeficit)

/-- A first unconditional logarithmic saving for the actual Möbius initial sum
of primitive characters with conductor at most a fixed power of `log X`.
The loss from short prime prefixes is `sqrt(log X)`, not `log X`. -/
theorem mobiusPrefix_natural_log_saving (B : ℝ) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ X : ℕ in atTop,
      ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log X) ^ B →
        ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
          ‖mobiusPrefix χ (X : ℝ)‖ ≤ C * X / Real.sqrt (Real.log X) := by
  obtain ⟨C₀, hC₀, X₀, hX₀, hSW⟩ := prime_prefix_siegelWalfisz 4 (2 * B) (by norm_num) (by positivity)
  let Cψ := Real.log 4 + 4
  let C := 2 * C₀ + Cψ * (1 + Real.log 4) + 1
  have hCψ : 0 ≤ Cψ := by dsimp [Cψ]; positivity
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  have log_tend := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have exp_tend := Real.tendsto_exp_atTop.comp (Real.tendsto_sqrt_atTop.comp log_tend)
  filter_upwards [log_tend.eventually (eventually_ge_atTop (4 : ℝ)),
    exp_tend.eventually (eventually_ge_atTop (max X₀ 2)), eventually_ge_atTop (1 : ℕ)]
    with X hL hY hX
  intro q hq hqlog χ hp
  let L := Real.log (X : ℝ)
  let R := Real.sqrt L
  let Y := Real.exp R
  let K := ⌈Y⌉₊
  change 4 ≤ L at hL
  have hL0 : 0 < L := by linarith
  have hR0 : 0 < R := Real.sqrt_pos.mpr hL0
  have hR2 : R ^ 2 = L := Real.sq_sqrt hL0.le
  have hR : 2 ≤ R := by
    by_contra! h
    have hn : R ^ 2 < (2 : ℝ) ^ 2 := pow_lt_pow_left₀ h hR0.le (by decide)
    rw [hR2] at hn
    linarith [show (4 : ℝ) ≤ L from hL]
  have hXr : (1 : ℝ) ≤ X := by exact_mod_cast hX
  have hYX₀ : X₀ ≤ Y := (le_max_left _ _).trans hY
  have hY2 : 2 ≤ Y := (le_max_right _ _).trans hY
  have hYK : Y ≤ K := Nat.le_ceil _
  have hK' : (K : ℝ) ≤ Y + 1 := (Nat.ceil_lt_add_one (by positivity : 0 ≤ Y)).le
  have hKX : K ≤ X := by
    have hRY : 2 * R ≤ L := by nlinarith [mul_nonneg hR0.le (sub_nonneg.mpr hR)]
    have hh : (K : ℝ) ≤ X := calc
      _ ≤ Y + 1 := hK'
      _ ≤ Y * Y := by nlinarith [mul_nonneg (by linarith : 0 ≤ Y) (sub_nonneg.mpr hY2)]
      _ = Real.exp (2 * R) := by dsimp [Y]; rw [← Real.exp_add]; congr 1; ring
      _ ≤ Real.exp L := Real.exp_le_exp.mpr hRY
      _ = X := Real.exp_log (by linarith)
    exact_mod_cast hh
  have hK : 0 < K := by
    have h : (0 : ℝ) < K := lt_of_lt_of_le (by linarith : (0 : ℝ) < Y) hYK
    exact_mod_cast h
  let ε := C₀ / L ^ 2
  have hε : 0 ≤ ε := by dsimp [ε]; positivity
  have hprime (y : ℕ) (hyK : K ≤ y) (_ : y ≤ X) : ‖primeCharacterPrefix (y : ℝ) χ‖ ≤ ε * y := by
    have hy : Y ≤ (y : ℝ) := hYK.trans (by exact_mod_cast hyK)
    have hylog : R ≤ Real.log (y : ℝ) := by
      simpa [Y] using Real.log_le_log (Real.exp_pos R) hy
    have hqY : (q : ℝ) ≤ (Real.log (y : ℝ)) ^ (2 * B) := by
      refine hqlog.trans ?_
      have he : L ^ B = R ^ (2 * B) := by
        change L ^ B = (Real.sqrt L) ^ (2 * B)
        rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL0.le]
        congr 1
        ring
      rw [he]
      exact Real.rpow_le_rpow hR0.le hylog (by positivity)
    have hsmall : (Real.log (y : ℝ)) ^ (-(4 : ℝ)) ≤ (L ^ 2)⁻¹ := by
      refine (Real.rpow_le_rpow_of_nonpos hR0 hylog (by norm_num : -(4 : ℝ) ≤ 0)).trans_eq ?_
      change (Real.sqrt L) ^ (-(4 : ℝ)) = (L ^ 2)⁻¹
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL0.le,
        show (1 / 2 : ℝ) * -4 = -(2 : ℝ) by norm_num, Real.rpow_neg hL0.le, Real.rpow_two]
    calc
      _ ≤ C₀ * y * (Real.log (y : ℝ)) ^ (-(4 : ℝ)) := hSW y (hYX₀.trans hy) q hq hqY χ hp
      _ ≤ C₀ * y * (L ^ 2)⁻¹ := mul_le_mul_of_nonneg_left hsmall (by positivity)
      _ = _ := by dsimp [ε]; rw [div_eq_mul_inv]; ring
  have hlogK : Real.log (2 * (K : ℝ)) ≤ (1 + Real.log 4) * R := by
    calc
      _ ≤ Real.log (4 * Y) := Real.log_le_log (by positivity) (by linarith)
      _ = Real.log 4 + R := by rw [Real.log_mul (by norm_num) (by positivity), Real.log_exp]
      _ ≤ _ := by
        have h := mul_nonneg (Real.log_nonneg (by norm_num : (1 : ℝ) ≤ 4)) (show 0 ≤ R - 1 by linarith)
        nlinarith
  have hεL : ε * (1 + L) ≤ 2 * C₀ := by
    have hpoly : 1 + L ≤ 2 * L ^ 2 := by
      have h : 1 ≤ L := by linarith
      nlinarith [mul_nonneg (sub_nonneg.mpr h) hL0.le]
    calc
      _ ≤ ε * (2 * L ^ 2) := mul_le_mul_of_nonneg_left hpoly hε
      _ = _ := by dsimp [ε]; field_simp
  have hlin : ε * X * (1 + L) ≤ 2 * C₀ * (X : ℝ) * R := by
    calc
      _ = ε * (1 + L) * X := by ring
      _ ≤ 2 * C₀ * X := mul_le_mul_of_nonneg_right hεL (Nat.cast_nonneg X)
      _ ≤ _ := le_mul_of_one_le_right (by positivity) (by linarith)
  have hlogw := log_weighted_prefix_le_split χ X K hK hKX hε hprime
  have hweighted : ‖∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)‖ + (X : ℝ) ≤ C * X * R := by
    refine (add_le_add hlogw le_rfl).trans ?_
    have hh := mul_le_mul_of_nonneg_left hlogK (show 0 ≤ Cψ * (X : ℝ) by positivity)
    have hXr' : (X : ℝ) ≤ (X : ℝ) * R := le_mul_of_one_le_right (Nat.cast_nonneg X) (by linarith)
    change ε * X * (1 + L) + Cψ * X * Real.log (2 * (K : ℝ)) + (X : ℝ) ≤ C * X * R
    dsimp [C]
    nlinarith only [hlin, hh, hXr']
  change ‖mobiusPrefix χ (X : ℝ)‖ ≤ C * X / R
  apply (le_div_iff₀ hR0).2
  apply le_of_mul_le_mul_right _ hR0
  calc
    _ = ‖mobiusPrefix χ (X : ℝ)‖ * L := by rw [mul_assoc, ← pow_two, hR2]
    _ ≤ _ := (mobiusPrefix_mul_log_le X hX χ).trans hweighted

/-- Unconditional low-frequency logarithmic saving for the genuine sharp
Möbius polynomial, uniformly for any fixed polylogarithmic conductor range.
The upper endpoint can be smaller than `2N` because of the HB truncation. -/
theorem mobiusPoly_low_frequency_log_saving (B : ℝ) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop,
      ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log N) ^ B →
      ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
      ∀ t : ℝ, |t| ≤ (Real.log N) ^ (1 / 4 : ℝ) →
      ∀ b : ℝ, (N : ℝ) ≤ b → b ≤ 2 * N →
        ‖mobiusPoly χ t N b‖ ≤ C * Real.sqrt N / (Real.log N) ^ (1 / 4 : ℝ) := by
  obtain ⟨C, hC, h⟩ := mobiusPrefix_natural_log_saving B hB
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.mp h
  refine ⟨8 * C, by positivity, ?_⟩
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [eventually_ge_atTop N₀, hlog.eventually (eventually_ge_atTop (1 : ℝ)),
    eventually_ge_atTop (1 : ℕ)] with N hN hL hN₁
  intro q hq hqlog χ hp t ht b hNb hb
  let L := Real.log (N : ℝ)
  let J := L ^ (1 / 4 : ℝ)
  let R := Real.sqrt (N : ℝ)
  let A := 2 * C * (N : ℝ) / Real.sqrt L
  change 1 ≤ L at hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hJ : 1 ≤ J := Real.one_le_rpow hL (by norm_num)
  have hJ0 : 0 < J := zero_lt_one.trans_le hJ
  have hNr : (0 : ℝ) < N := by exact_mod_cast (Nat.zero_lt_succ 0).trans_le hN₁
  have hR : 0 < R := Real.sqrt_pos.mpr hNr
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hprefix (y : ℝ) (hy : y ∈ Set.Icc (N : ℝ) b) : ‖mobiusPrefix χ y‖ ≤ A := by
    let K := ⌊y⌋₊
    have hy0 : 0 ≤ y := hNr.le.trans hy.1
    have hNK : N ≤ K := (Nat.le_floor_iff hy0).2 hy.1
    have hK : (K : ℝ) ≤ 2 * N := (Nat.floor_le hy0).trans (hy.2.trans hb)
    have hlogK : L ≤ Real.log (K : ℝ) := Real.log_le_log hNr (by exact_mod_cast hNK)
    have hqK : (q : ℝ) ≤ (Real.log (K : ℝ)) ^ B :=
      hqlog.trans (Real.rpow_le_rpow hL0.le hlogK hB.le)
    have he : mobiusPrefix χ y = mobiusPrefix χ (K : ℝ) := by
      unfold mobiusPrefix
      rw [Nat.floor_natCast]
    rw [he]
    calc
      _ ≤ C * K / Real.sqrt (Real.log K) := hN₀ K (hN.trans hNK) q hq hqK χ hp
      _ ≤ (2 * C * (N : ℝ)) / Real.sqrt (Real.log K) :=
        div_le_div_of_nonneg_right (by nlinarith [mul_le_mul_of_nonneg_left hK hC.le]) (by positivity)
      _ ≤ A := div_le_div_of_nonneg_left (by positivity) (Real.sqrt_pos.mpr hL0) (Real.sqrt_le_sqrt hlogK)
  have hnorm := mobiusPoly_le_of_prefix χ t hNr hNb hb hA hprefix
  have hExpo : (N : ℝ) ^ (-(1 / 2 : ℝ)) = R⁻¹ := by
    rw [Real.rpow_neg hNr.le, ← Real.sqrt_eq_rpow]
  have hRoot : Real.sqrt L = J ^ 2 := by
    dsimp [J]
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hL0.le]
    norm_num
  calc
    _ ≤ (3 + |t|) * A * (N : ℝ) ^ (-(1 / 2 : ℝ)) := hnorm
    _ ≤ (4 * J) * A * (N : ℝ) ^ (-(1 / 2 : ℝ)) := by
      gcongr
      linarith [show |t| ≤ J from ht]
    _ = 8 * C * R / J := by
      rw [hExpo]
      dsimp only [A]
      rw [hRoot]
      have hNs : (N : ℝ) = R ^ 2 := (Real.sq_sqrt hNr.le).symm
      field_simp [hJ0.ne', hR.ne']
      rw [hNs]
      ring

/-- The low-frequency saving applied to the actual sharp HB factor, with its
own truncation. The equality `scale d = N` is satisfied for `d ≥ 1` by taking
`N = 2^(d-1)`. -/
theorem sharpBox_low_frequency_log_saving (B : ℝ) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop,
      ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log N) ^ B →
      ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
      ∀ t : ℝ, |t| ≤ (Real.log N) ^ (1 / 4 : ℝ) →
      ∀ H j i d : ℕ, j + 1 ≤ i → ShortAPDyadicPartition.scale d = (N : ℝ) → N ≤ H →
        ‖∑ n ∈ Finset.Icc 1 ⌊2 * ShortAPDyadicPartition.scale d⌋₊,
          (ShortAPBoxedHB.boxFactor H j i d n : ℂ) * χ (n : ZMod q) / (n : ℂ) ^ critical t‖ ≤
          C * Real.sqrt N / (Real.log N) ^ (1 / 4 : ℝ) := by
  obtain ⟨C, hC, h⟩ := mobiusPoly_low_frequency_log_saving B hB
  refine ⟨C, hC, ?_⟩
  filter_upwards [h] with N hN
  intro q hq hq' χ hχ t ht H j i d hi hd hH
  rw [sharpBoxPoly_eq hi χ t, hd]
  exact hN q hq hq' χ hχ t ht _
    (le_min (by linarith [Nat.cast_nonneg (α := ℝ) N]) (by exact_mod_cast hH)) (min_le_left _ _)

/-- Hyperbola decomposition separating small and large Mangoldt variables.
The small-variable side uses Möbius prefixes at `X/m`. The large-variable
side uses differences of prime prefixes, with no boundary error when `K`
is larger than an individual `X/d`. -/
theorem logWeighted_mobius_hyperbola_split {q : ℕ} (χ : DirichletCharacter ℂ q)
    (X K : ℕ) (hKX : K ≤ X) :
    (∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)) = -(
      (∑ m ∈ Finset.Ioc 0 K, (ArithmeticFunction.vonMangoldt m : ℂ) * χ (m : ZMod q) *
        mobiusPrefix χ (X / m : ℕ)) +
      ∑ d ∈ Finset.Ioc 0 X, mobiusTwist χ d *
        (primeCharacterPrefix (X / d : ℕ) χ - primeCharacterPrefix (min K (X / d) : ℕ) χ)) := by
  let F := twist χ μ
  let G := twist χ ArithmeticFunction.vonMangoldt
  let G₀ : ArithmeticFunction ℂ := ⟨fun n => if n ≤ K then G n else 0, by simp⟩
  let G₁ := G - G₀
  have hG : F * G = G₀ * F + F * G₁ := by dsimp [G₁]; ring
  have eF (n : ℕ) : F n = mobiusTwist χ n := by simp [F, mobiusTwist]
  have eG (n : ℕ) : G n = (ArithmeticFunction.vonMangoldt n : ℂ) * χ (n : ZMod q) := rfl
  have hslice (n : ℕ) : (Finset.Ioc 0 n).filter (fun u => u ≤ K) = Finset.Ioc 0 (min K n) := by
    ext u
    simp only [Finset.mem_filter, Finset.mem_Ioc, le_min_iff]
    tauto
  have hprefix₀ (n : ℕ) : (∑ u ∈ Finset.Ioc 0 n, G₀ u) =
      primeCharacterPrefix (min K n : ℕ) χ := by
    change (∑ u ∈ Finset.Ioc 0 n, if u ≤ K then G u else 0) = _
    rw [← Finset.sum_filter, hslice]
    simp only [primeCharacterPrefix, Nat.floor_natCast]
    simp [G, mul_comm]
  have hprefix₁ (n : ℕ) : (∑ u ∈ Finset.Ioc 0 n, G₁ u) =
      primeCharacterPrefix (n : ℝ) χ - primeCharacterPrefix (min K n : ℕ) χ := by
    simp only [G₁, sub_apply, Finset.sum_sub_distrib, hprefix₀]
    simp [primeCharacterPrefix, G, mul_comm]
  have hmobius (n : ℕ) : (∑ u ∈ Finset.Ioc 0 n, F u) = mobiusPrefix χ (n : ℝ) := by
    rw [mobiusPrefix, Nat.floor_natCast, ← Finset.add_sum_Ioc_eq_sum_Icc (Nat.zero_le n)]
    simp [eF, mobiusTwist]
  have hsm : (∑ n ∈ Finset.Ioc 0 X, (G₀ * F) n) =
      ∑ m ∈ Finset.Ioc 0 K, (ArithmeticFunction.vonMangoldt m : ℂ) * χ (m : ZMod q) *
        mobiusPrefix χ (X / m : ℕ) := by
    rw [ArithmeticFunction.sum_Ioc_mul_eq_sum_sum]
    simp only [hmobius]
    change (∑ m ∈ Finset.Ioc 0 X, (if m ≤ K then G m else 0) * mobiusPrefix χ (X/m : ℕ)) = _
    simp_rw [ite_mul, zero_mul, eG]
    rw [← Finset.sum_filter, hslice, min_eq_left hKX]
  have hlg : (∑ n ∈ Finset.Ioc 0 X, (F * G₁) n) = ∑ d ∈ Finset.Ioc 0 X, mobiusTwist χ d *
        (primeCharacterPrefix (X / d : ℕ) χ - primeCharacterPrefix (min K (X / d) : ℕ) χ) := by
    rw [ArithmeticFunction.sum_Ioc_mul_eq_sum_sum]
    simp only [hprefix₁, eF]
  calc
    _ = ∑ n ∈ Finset.Ioc 0 X, (logMultiply F) n := by simp only [logMultiply_apply, eF]
    _ = -(∑ n ∈ Finset.Ioc 0 X, (F * G) n) := by
      rw [show logMultiply F = -(F * G) from logMultiply_mobius_twist χ]
      simp
    _ = _ := by rw [hG]; simp only [add_apply, Finset.sum_add_distrib, hsm, hlg]

end
end ShortAPSmallConductorMobius

end

