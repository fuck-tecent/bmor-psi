namespace GoldbachPintzNumerics

open Complex

/-- The real-axis decrease of the rational Laplace kernel dominates its
decrease at every imaginary ordinate. -/
theorem rational_kernel_defect_le_real {b a : ℝ} (hb : 0≤ b) (ha : 0≤ a) {z : ℂ}
    (hz : 0<b+z.re) :
    (rationalZeroKernel b z-rationalZeroKernel b (z+(a:ℂ))).re≤
      realRationalZeroKernel b z.re-realRationalZeroKernel b (z.re+a) := by
  let u : ℝ := b+z.re
  let v : ℂ := (b:ℂ)+z
  let w : ℂ := v+(a:ℂ)
  let p := v⁻¹
  let q := w⁻¹
  let x : ℝ := u⁻¹
  let y : ℝ := (u+a)⁻¹
  have hu : 0<u := hz
  have hua : 0<u+a := add_pos_of_pos_of_nonneg hu ha
  have hv : u≤ ‖v‖ := (show v.re=u by simp [v,u,Complex.add_re]) ▸ Complex.re_le_norm v
  have hw : u+a≤ ‖w‖ := (show w.re=u+a by simp [w,v,u,Complex.add_re]) ▸ Complex.re_le_norm w
  have hv0 : v≠0 := norm_pos_iff.mp (hu.trans_le hv)
  have hw0 : w≠0 := norm_pos_iff.mp (hua.trans_le hw)
  have hp : ‖p‖≤ x := by rw [norm_inv]; exact inv_anti₀ hu hv
  have hq : ‖q‖≤ y := by rw [norm_inv]; exact inv_anti₀ hua hw
  have hx : 0≤ x := (inv_pos.mpr hu).le
  have hy : 0≤ y := (inv_pos.mpr hua).le
  have hxy : y≤ x := inv_anti₀ hu (le_add_of_nonneg_right ha)
  have hd₁ : ‖p-q‖≤ x-y := calc
    _ = ‖(a:ℂ)*(p*q)‖ := by
      congr 1
      change v⁻¹-w⁻¹=(a:ℂ)*(v⁻¹*w⁻¹)
      field_simp [hv0,hw0]
      change v+(a:ℂ)-v=(a:ℂ)
      ring
    _ ≤ a*(x*y) := by
      rw [norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg ha]
      exact mul_le_mul_of_nonneg_left (mul_le_mul hp hq (norm_nonneg _) hx) ha
    _ = _ := by
      unfold x y
      field_simp [hu.ne',hua.ne']
      <;> ring
  have hd₂ : ‖p^2-q^2‖≤ x^2-y^2 := calc
    _ = ‖(p-q)*(p+q)‖ := by congr 1; ring
    _ ≤ (x-y)*(x+y) := by
      rw [norm_mul]
      exact mul_le_mul hd₁ ((norm_add_le _ _).trans (add_le_add hp hq))
        (norm_nonneg _) (sub_nonneg.mpr hxy)
    _ = _ := by ring
  have hd₃ : ‖p^3-q^3‖≤ x^3-y^3 := calc
    _ = ‖(p-q)*(p^2+p*q+q^2)‖ := by congr 1; ring
    _ ≤ (x-y)*(x^2+x*y+y^2) := by
      rw [norm_mul]
      refine mul_le_mul hd₁ ?_ (norm_nonneg _) (sub_nonneg.mpr hxy)
      refine (norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add ?_ ?_)) ?_)
      · rw [norm_pow]; exact pow_le_pow_left₀ (norm_nonneg _) hp _
      · rw [norm_mul]; exact mul_le_mul hp hq (norm_nonneg _) hx
      · rw [norm_pow]; exact pow_le_pow_left₀ (norm_nonneg _) hq _
    _ = _ := by ring
  have hK : rationalZeroKernel b z-rationalZeroKernel b (z+(a:ℂ))=
      (p-q)+(b:ℂ)*(p^2-q^2)+((2*b^2/3:ℝ):ℂ)*(p^3-q^3) := by
    unfold rationalZeroKernel p q w v
    rw [←add_assoc]
    simp only [div_eq_mul_inv,←inv_pow,one_mul]
    ring
  have hReal : realRationalZeroKernel b z.re-realRationalZeroKernel b (z.re+a)=
      (x-y)+b*(x^2-y^2)+(2*b^2/3)*(x^3-y^3) := by
    unfold realRationalZeroKernel x y u
    rw [←add_assoc]
    simp only [div_eq_mul_inv,←inv_pow,one_mul]
    ring
  rw [hK,hReal]
  refine (Complex.re_le_norm _).trans ((norm_add_le _ _).trans (add_le_add
    ((norm_add_le _ _).trans (add_le_add hd₁ ?_)) ?_))
  · rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hb]
    exact mul_le_mul_of_nonneg_left hd₂ hb
  · rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (by positivity)]
    exact mul_le_mul_of_nonneg_left hd₃ (by positivity)

end GoldbachPintzNumerics
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Finset Goldbach GoldbachTwistedMellin GoldbachPintzNumerics
open scoped Topology Classical

noncomputable section


set_option maxHeartbeats 2000000 in
/-- The same-character second zero satisfies the real-axis doubled pole
deficit inequality, including a nonreal second ordinate. -/
theorem rational_same_character_runner_up_gap_eventually
    {ε b κ K D p H : ℝ} (hε : 0<ε) (hb : 0<b) (hκ : 0<κ)
    (hK : 0<K) (hD : 0≤ D) (hp : 0≤ p) (hH : 0≤ H) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (ξ : DirichletCharacter ℂ q)
      (σ β γ B T φ : ℝ), ξ^2=1 → ξ≠1 →
      Real.log (q:ℝ)≤ L → 1-H/L≤ β → β≤ σ → σ≤ 1 →
      1+κ/L≤ β+b/L → |γ|≤ L^p →
      |γ|+1/4≤ T → logHeight q 0≤ K*L → logHeight q γ≤ K*L →
      1≤ B → Real.log B≤ D*Real.log L → 0≤ φ →
      (∀ z : ℂ, 3/4≤ z.re → z.re≤ 3/2 → |z.im|≤ T →
        ‖ξ.LFunction z‖≤ B*(q:ℝ)^(φ*max 0 (1-z.re))) →
      regularizedL ξ (line σ 0)=0 → regularizedL ξ (line β γ)=0 →
      line σ 0≠line β γ → analyticOrderNatAt (regularizedL ξ) (line σ 0)=1 →
      (∀ ρ : ℂ, regularizedL ξ ρ=0 → (|ρ.im|≤ 1 ∨ |ρ.im-γ|≤ 1) →
        ρ=line σ 0 ∨ ρ.re≤ β) →
      realRationalZeroKernel b 0 ≤
        2*(realRationalZeroKernel b (L*(β-1))-realRationalZeroKernel b (L*(β-σ)))+φ+ε := by
  let e : ℝ := ε/5
  let M : ℝ := 1+b+2*b^2/3
  have he : 0<e := by unfold e; positivity
  obtain ⟨r,L₀,hr,hr32,hL₀,hN⟩ := rational_prime_test_sharp_with_window
    (C:=b) he hκ hb hK hD hb.le
  have hP := rational_prime_test_principal_upper_eventually (p:=p) he hb hH hp
  have hLarge := eventually_ge_atTop (max L₀ (max (H/r) (max (1/r) (M/(e*r)))))
  filter_upwards [hP,hLarge] with L hP hL q _ ξ σ β γ B T φ hXi2 hξ hq hβ₀ hβ hσ hS hγ hT hHL0 hHLγ
    hB hBL hφ hstrip hzξ hzχ hne hSimple hLead
  have hL' : L₀≤ L := (le_max_left _ _).trans hL
  have hL0 : 0<L := zero_lt_one.trans_le (hL₀.trans hL')
  have hQ : (1:ℝ)≤ q := by exact_mod_cast NeZero.pos q
  have hβ1 : β≤ 1 := hβ.trans hσ
  have hLL : H/L≤ r := by
    have hh := (div_le_iff₀ hr).mp ((le_max_left _ _).trans ((le_max_right _ _).trans hL))
    exact (div_le_iff₀ hL0).mpr (by nlinarith only [hh])
  have hInv := (div_le_iff₀ hr).mp
    ((le_max_left _ _).trans ((le_max_right _ _).trans ((le_max_right _ _).trans hL)))
  have hBig := (div_le_iff₀ (mul_pos he hr)).mp
    ((le_max_right _ _).trans ((le_max_right _ _).trans ((le_max_right _ _).trans hL)))
  have hShift : 1<β+b/L := (lt_add_of_pos_right _ (div_pos hκ hL0)).trans_le hS
  have hT0 : (1/4:ℝ)≤ T := by linarith only [hT,abs_nonneg γ]
  have hPr (t : ℝ) (ht : |t|≤ L^p) :
      (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line β t)).re≤
        L*(rationalZeroKernel b (((L*(β-1):ℝ):ℂ)+((L*t:ℝ):ℂ)*I)).re+e*L := by
    have hh := hP q (line β t) hq (by simpa [line] using hβ₀)
      (by simpa [line] using hβ1.trans (le_add_of_nonneg_right (div_nonneg hH hL0.le)))
      (by simpa [line] using ht) (by simpa [line] using hShift)
    have h1 : line 1 0=1 := by simp [line]
    rw [←h1,rational_scaled_line_sub,sub_zero] at hh
    exact hh
  have hPr₀ := hPr 0 (by simpa using Real.rpow_nonneg hL0.le p)
  simp only [mul_zero,Complex.ofReal_zero,zero_mul,add_zero,runner_rational_real] at hPr₀
  have hPrγ := hPr γ hγ
  have hGeo (x t : ℝ) (hx₁ : 1-H/L≤ x) (hx₂ : x≤ 1) :
      ‖line x t-line 1 t‖≤ r := by
    rw [runner_fixed_height_sub,Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (sub_nonpos.mpr hx₂)]
    linarith only [hx₁,hLL]
  have hLocal (t : ℝ) (ht : |t|+1/4≤ T) (hHt : logHeight q t≤ K*L) :
      ∃ V : Finset ℂ, (∀ ρ∈V, regularizedL ξ ρ=0 ∧ |ρ.im-t|≤ 1) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 t‖≤ 2*r → regularizedL ξ ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V → (∀ ρ∈V, ρ∉U → ρ.re≤ β) →
        (rationalPrimeTest ξ b L (line β t)).re≤ φ*L/2+e*L-
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL ξ) ρ:ℝ)*
            (rationalZeroKernel b ((L:ℂ)*(line β t-ρ))).re := by
    obtain ⟨V,hV,hCov,hEst⟩ := hN q ξ hξ (s:=line β t) (Q:=(q:ℝ)) hL'
      (by simpa [line] using hS) (by simpa [line] using add_le_add_right hβ1 (b/L))
      (by simpa [line] using ht) (by simpa [line] using hHt) hφ hB hQ hBL hstrip
    refine ⟨V,?_,(by simpa [line] using hCov),?_⟩
    · intro ρ hρ
      have hi := (Complex.abs_im_le_norm (ρ-line 1 t)).trans
        (show ‖ρ-line 1 t‖≤ 2*r by simpa [line] using (hV ρ hρ).2.2)
      have hw : |ρ.im-t|≤ 1 :=
        (show |ρ.im-t|≤ 2*r by simpa [line,Complex.sub_im] using hi).trans (by linarith only [hr32])
      exact ⟨(hV ρ hρ).1,hw⟩
    · intro U hU hD'
      have hh := hEst U hU (by simpa [line] using hD')
      have hq' := mul_le_mul_of_nonneg_left hq hφ
      linarith only [hh,hq']
  obtain ⟨V0,hV0,hC0,hU0⟩ := hLocal 0 (by simpa using hT0) hHL0
  obtain ⟨Vγ,hVγ,hCγ,hUγ⟩ := hLocal γ hT hHLγ
  have hGeoσ := hGeo σ 0 (hβ₀.trans hβ) hσ
  have h0Mem := hC0 _ (hGeoσ.trans (by linarith only [hr])) hzξ
  have hγMem := hCγ _ ((hGeo β γ hβ₀ hβ1).trans (by linarith only [hr])) hzχ
  have h0Est := hU0 {line σ 0} (Finset.singleton_subset_iff.mpr h0Mem) (by
    intro ρ hρ hN
    rcases hLead ρ (hV0 ρ hρ).1 (Or.inl (by simpa using (hV0 ρ hρ).2)) with h|h
    · exact False.elim (hN (Finset.mem_singleton.mpr h))
    · exact h)
  simp only [Finset.sum_singleton,runner_fixed_height_sub,←Complex.ofReal_mul,
    runner_rational_real,hSimple,Nat.cast_one,one_mul] at h0Est
  have hR0 : (rationalZeroKernel b 0).re=realRationalZeroKernel b 0 := by
    simpa only [Complex.ofReal_zero] using runner_rational_real b 0
  have hm : (1:ℝ)≤ analyticOrderNatAt (regularizedL ξ) (line β γ) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff ξ _).mpr hzχ
  have hF0 := (realRationalZeroKernel_pos (x:=0) hb (by simpa using hb)).le
  have hm' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hm hF0) hL0.le
  let Z : ℂ := ((L*(β-1):ℝ):ℂ)+((L*γ:ℝ):ℂ)*I
  let W : ℂ := ((L*(β-σ):ℝ):ℂ)+((L*γ:ℝ):ℂ)*I
  let Δ := realRationalZeroKernel b (L*(β-1))-realRationalZeroKernel b (L*(β-σ))
  have hZre : Z.re=L*(β-1) := by simp [Z,Complex.add_re,Complex.mul_re]
  have hBZ : 0<b+Z.re := by
    rw [hZre]
    have hh := mul_le_mul_of_nonneg_left hS hL0.le
    simp only [mul_add,mul_one,mul_div_cancel₀ _ hL0.ne'] at hh
    nlinarith only [hh,hκ]
  have hA : 0≤ L*(1-σ) := mul_nonneg hL0.le (sub_nonneg.mpr hσ)
  have hΔ : 0≤ Δ := sub_nonneg.mpr (realRationalZeroKernel_antitone hb
    (by rwa [hZre] at hBZ) (by nlinarith only [hA]))
  have hDef : (rationalZeroKernel b Z).re-(rationalZeroKernel b W).re≤ Δ := by
    have hh := rational_kernel_defect_le_real hb.le hA hBZ
    have hW : Z+((L*(1-σ):ℝ):ℂ)=W := by unfold Z W; push_cast; ring
    rw [hW,Complex.sub_re,hZre,show L*(β-1)+L*(1-σ)=L*(β-σ) by ring] at hh
    exact hh
  change (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line β γ)).re≤
    L*(rationalZeroKernel b Z).re+e*L at hPrγ
  have hGγ :
      (rationalPrimeTest ξ b L (line β γ)).re+
        (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line β γ)).re≤
        φ*L/2+3*e*L-L*realRationalZeroKernel b 0+L*Δ := by
    by_cases hMem : line σ 0∈Vγ
    · have hAll : {line σ 0,line β γ}⊆Vγ :=
        Finset.insert_subset_iff.mpr ⟨hMem,Finset.singleton_subset_iff.mpr hγMem⟩
      have hUp := hUγ {line σ 0,line β γ} hAll (by
        intro ρ hρ hNot
        rcases hLead ρ (hVγ ρ hρ).1 (Or.inr (hVγ ρ hρ).2) with h|h
        · exact False.elim (hNot (by simp [h]))
        · exact h)
      rw [Finset.sum_insert (by simpa using hne),Finset.sum_singleton] at hUp
      simp only [sub_self,mul_zero,hR0,hSimple,Nat.cast_one,one_mul] at hUp
      rw [rational_scaled_line_sub,sub_zero] at hUp
      change _≤ φ*L/2+e*L-L*((rationalZeroKernel b W).re+
        (analyticOrderNatAt (regularizedL ξ) (line β γ):ℝ)*realRationalZeroKernel b 0) at hUp
      have hSum := add_le_add hUp hPrγ
      have hDef' := mul_le_mul_of_nonneg_left hDef hL0.le
      have hE_L := mul_nonneg he.le hL0.le
      linear_combination hSum+hm'+hDef'+hE_L
    · have hFar : r < |γ| := by
        by_contra! hNear
        apply hMem
        apply hCγ _ _ hzξ
        have hc : line 1 0-line 1 γ=((-γ:ℝ):ℂ)*I := by
          apply Complex.ext <;> simp [line,Complex.sub_re,Complex.sub_im]
        rw [←sub_add_sub_cancel (line σ 0) (line 1 0)]
        refine (norm_add_le _ _).trans ?_
        have hOther : ‖line 1 0-line 1 γ‖≤ r := by
          rw [hc,norm_mul,norm_I,mul_one,Complex.norm_real,Real.norm_eq_abs,abs_neg]
          exact hNear
        simpa only [two_mul] using add_le_add hGeoσ hOther
      have hY : |Z.im|=L*|γ| := by simp [Z,Complex.add_im,Complex.mul_im,abs_mul,abs_of_nonneg hL0.le]
      have hGt := mul_lt_mul_of_pos_left hFar hL0
      have hY1 : 1≤ |Z.im| := by rw [hY]; linarith only [hGt,hInv]
      have hM : M/|Z.im|≤ e := by
        refine (div_le_iff₀ (zero_lt_one.trans_le hY1)).mpr ?_
        rw [hY]
        nlinarith only [hBig,mul_le_mul_of_nonneg_left hGt.le he.le]
      have hTiny := mul_le_mul_of_nonneg_left
        ((rational_kernel_re_le_height hb.le Z hY1).trans hM) hL0.le
      have hUp := hUγ {line β γ} (Finset.singleton_subset_iff.mpr hγMem) (by
        intro ρ hρ _
        rcases hLead ρ (hVγ ρ hρ).1 (Or.inr (hVγ ρ hρ).2) with h|h
        · exact False.elim (hMem (h ▸ hρ))
        · exact h)
      simp only [Finset.sum_singleton,sub_self,mul_zero,hR0] at hUp
      have hSum := add_le_add hUp hPrγ
      have hDL := mul_nonneg hL0.le hΔ
      linear_combination hSum+hm'+hTiny+hDL
  have hPos := quadratic_four_rational_primeTest_nonneg ξ ξ hXi2 (σ:=β) (t:=γ) hb hL0 hShift
  rw [←pow_two,hXi2] at hPos
  have hPos' : 0≤
      (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line β 0)).re+
      (rationalPrimeTest ξ b L (line β 0)).re+
      ((rationalPrimeTest ξ b L (line β γ)).re+
        (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line β γ)).re) := by linarith only [hPos]
  have hT := hPos'.trans (add_le_add (add_le_add hPr₀ h0Est) hGγ)
  refine le_of_mul_le_mul_left ?_ hL0
  unfold Δ e at hT
  linarith only [hT]

end

