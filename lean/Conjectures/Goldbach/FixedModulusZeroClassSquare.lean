noncomputable section

/-- Restrict the analytic remainder to exactly the nearby zeros that enter
the compact smoothed prime sum. The omitted resolvents are analytic on the
concentric half disk and cost only a fixed inverse-radius factor. -/
theorem selected_analytic_remainder {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {t r M : ℝ} (hr : 0<r) (hr1 : r≤1/4) (hM : 0≤M) (Z : Finset ℂ) (G : ℂ→ℂ)
    (hGa : AnalyticOnNhd ℂ G (closedBall (line 1 t) (1/4)))
    (hGb : ∀ w∈closedBall (line 1 t) (1/4), ‖G w‖≤M)
    (hZ : (∑ ρ∈Z,(analyticOrderNatAt (regularizedL χ) ρ:ℝ))≤M)
    (hGe : ∀ w∈closedBall (line 1 t) (1/4), 1<w.re →
      -logDeriv χ.LFunction w=G w-
        ∑ ρ∈Z,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)/(w-ρ)) :
    let V := Z.filter (fun ρ => ‖ρ-line 1 t‖≤2*r)
    ∃ G' : ℂ→ℂ,
      AnalyticOnNhd ℂ G' (closedBall (line 1 t) r) ∧
      (∀ w∈closedBall (line 1 t) r, ‖G' w‖≤(1+r⁻¹)*M) ∧
      (∀ w∈closedBall (line 1 t) r, 1<w.re →
        -logDeriv χ.LFunction w=G' w-
          ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)/(w-ρ)) := by
  intro V
  let c := line 1 t
  let m := analyticOrderNatAt (regularizedL χ)
  let W := Z \ V
  let G' : ℂ→ℂ := fun w => G w-∑ ρ∈W,(m ρ:ℂ)/(w-ρ)
  have hV : V⊆Z := Finset.filter_subset _ _
  have hW : W⊆Z := Finset.sdiff_subset
  have hFar (w : ℂ) (hw : w∈closedBall c r) (ρ : ℂ) (hρ : ρ∈W) :
      r≤‖w-ρ‖ := by
    obtain ⟨hρZ,hρV⟩ := Finset.mem_sdiff.mp hρ
    have hdist : 2*r < ‖ρ-c‖ := by
      by_contra! h
      exact hρV (Finset.mem_filter.mpr ⟨hρZ,h⟩)
    have h := norm_add_le (ρ-w) (w-c)
    rw [sub_add_sub_cancel,norm_sub_rev ρ w] at h
    linarith only [h,hdist,mem_closedBall_iff_norm.mp hw]
  refine ⟨G',?_,?_,?_⟩
  · intro w hw
    apply (hGa w (closedBall_subset_closedBall hr1 hw)).fun_sub
    apply W.analyticAt_fun_sum
    intro ρ hρ
    have hD : AnalyticAt ℂ (fun w : ℂ => w-ρ) w := by fun_prop
    have hn : w-ρ≠0 := norm_pos_iff.mp (hr.trans_le (hFar w hw ρ hρ))
    exact analyticAt_const.fun_div hD hn
  · intro w hw
    have hg := hGb w (closedBall_subset_closedBall hr1 hw)
    have hb :
        ‖∑ ρ∈W,(m ρ:ℂ)/(w-ρ)‖≤r⁻¹*M := by
      refine (norm_sum_le _ _).trans ?_
      calc
        _ ≤ ∑ ρ∈W,(m ρ:ℝ)*r⁻¹ := by
          apply Finset.sum_le_sum
          intro ρ hρ
          have hd := hFar w hw ρ hρ
          rw [norm_div,Complex.norm_natCast,div_eq_mul_inv]
          exact mul_le_mul_of_nonneg_left
            ((inv_le_inv₀ (hr.trans_le hd) hr).mpr hd) (Nat.cast_nonneg _)
        _ ≤ _ := by
          rw [←Finset.sum_mul,mul_comm]
          apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr hr.le)
          exact (Finset.sum_le_sum_of_subset_of_nonneg hW (fun ρ _ _=>Nat.cast_nonneg _)).trans hZ
    exact ((norm_sub_le _ _).trans (add_le_add hg hb)).trans_eq (by ring)
  · intro w hw hwRe
    rw [hGe w (closedBall_subset_closedBall hr1 hw) hwRe]
    have hsum := Finset.sum_sdiff hV (f:=fun ρ=>(m ρ:ℂ)/(w-ρ))
    change G w-(∑ ρ∈Z,(m ρ:ℂ)/(w-ρ)) = G w-(∑ ρ∈W,(m ρ:ℂ)/(w-ρ))-(∑ ρ∈V,(m ρ:ℂ)/(w-ρ))
    rw [←hsum]
    ring

end

end GoldbachPintzWeightedFormula
end

