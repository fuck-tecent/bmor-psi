namespace GoldbachPintzFamily

open Finset Complex Goldbach GoldbachTwistedMellin GoldbachTypeII GoldbachDensitySlices
  GoldbachPintzCharacters GoldbachPintzHalasz GoldbachSieveSeries GoldbachPintzScales GoldbachLinnik
open scoped Classical ComplexConjugate

noncomputable section

abbrev level {Q : ℕ} (r : TaggedZero Q) : ℕ := r.1.1.val+1

def naturalColumn {Q : ℕ} (i : CharacterFamily Q) : Σ q : ℕ, DirichletCharacter ℂ q :=
  ⟨i.1.val+1,i.2⟩

theorem naturalColumn_injective (Q : ℕ) : Function.Injective (naturalColumn (Q:=Q)) := by
  rintro ⟨⟨r,hr⟩,χ⟩ ⟨⟨s,hs⟩,ψ⟩ h
  have h' : (⟨r+1,χ⟩ : Σ q : ℕ, DirichletCharacter ℂ q) = ⟨s+1,ψ⟩ := h
  obtain ⟨hre,hχ⟩ := Sigma.mk.inj_iff.mp h'
  have hrs : r = s := by omega
  subst s
  have hχ' : χ = ψ := eq_of_heq hχ
  subst ψ
  rfl

def column {Q : ℕ} (r : TaggedZero Q) : Σ q : ℕ, DirichletCharacter ℂ q := naturalColumn r.1

theorem column_eq_iff {Q : ℕ} (r s : TaggedZero Q) : column r = column s ↔ r.1 = s.1 :=
  (naturalColumn_injective Q).eq_iff

def characterValue {Q : ℕ} (r : TaggedZero Q) (n : ℕ) : ℂ := r.1.2 (n : ZMod (level r))

def order {Q : ℕ} (r : TaggedZero Q) : ℕ := analyticOrderNatAt (regularizedL r.1.2) r.2

def taggedPair {Q : ℕ} (r s : TaggedZero Q) : DirichletCharacter ℂ (level r * level s) :=
  pairCharacter r.1.2 s.1.2

theorem taggedPair_natCast {Q : ℕ} (r s : TaggedZero Q) (n : ℕ) :
    taggedPair r s (n : ZMod (level r*level s)) = conj (characterValue r n)*characterValue s n :=
  pairCharacter_natCast _ _ n

theorem level_le {Q : ℕ} (r : TaggedZero Q) : level r ≤ Q := by
  dsimp only [level]
  exact Nat.succ_le_of_lt r.1.1.isLt

theorem pair_level_le {Q : ℕ} (r s : TaggedZero Q) : level r*level s ≤ Q^2 := by
  simpa only [pow_two] using Nat.mul_le_mul (level_le r) (level_le s)

theorem family_mem_geometry {Q : ℕ} {σ T : ℝ} {r : TaggedZero Q}
    (hr : r ∈ familyZeroTags Q σ T) :
    r.1.2.IsPrimitive ∧ r.1.2 ≠ 1 ∧
      σ ≤ r.2.re ∧ r.2.re ≤ 1 ∧ |r.2.im| ≤ T ∧ regularizedL r.1.2 r.2 = 0 ∧
      r.1.2.LFunction r.2 = 0 := by
  obtain ⟨hc,hz⟩ := mem_sigma.mp hr
  obtain ⟨hp,hn⟩ := mem_primitiveNonprincipalFamily.mp hc
  obtain ⟨hlo,hhi,him,hz0⟩ := mem_densityZeros.mp hz
  exact ⟨hp,hn,hlo,hhi,him,hz0,densityZeros_mem_L_zero hn hz⟩

theorem taggedPair_ne_one {Q : ℕ} {σ T : ℝ} {r s : TaggedZero Q}
    (hr : r ∈ familyZeroTags Q σ T) (hs : s ∈ familyZeroTags Q σ T)
    (h : column r ≠ column s) : taggedPair r s ≠ 1 := by
  have hp := (family_mem_geometry hr).1
  have hq := (family_mem_geometry hs).1
  let _ : NeZero (level r*level s) := ⟨Nat.ne_of_gt (Nat.mul_pos (Nat.zero_lt_succ _) (Nat.zero_lt_succ _))⟩
  exact pairCharacter_ne_one_of_ne_tag hp hq h

/-- The finite zero set obtained by fixing the character column. -/
def columnZeros {Q : ℕ} (Z : Finset (TaggedZero Q)) (r : TaggedZero Q) : Finset ℂ :=
  (Z.filter (fun s => column s = column r)).image Sigma.snd

theorem mem_columnZeros {Q : ℕ} {Z : Finset (TaggedZero Q)} {r : TaggedZero Q} {ρ : ℂ} :
    ρ ∈ columnZeros Z r ↔ (⟨r.1,ρ⟩ : TaggedZero Q) ∈ Z := by
  constructor
  · intro h
    obtain ⟨⟨s,ζ⟩,hs,he⟩ := mem_image.mp h
    change ζ = ρ at he
    obtain ⟨hsZ,hcol⟩ := mem_filter.mp hs
    have hkey : s = r.1 := (column_eq_iff ⟨s,ζ⟩ r).mp hcol
    subst s
    subst ζ
    exact hsZ
  · intro h
    exact mem_image.mpr ⟨⟨r.1,ρ⟩,mem_filter.mpr ⟨h,rfl⟩,rfl⟩

/-- Sums over a column preserve the zero and its multiplicity exactly. -/
theorem sum_column_eq {Q : ℕ} (Z : Finset (TaggedZero Q)) (r : TaggedZero Q)
    (F : TaggedZero Q → ℝ) :
    (∑ s ∈ Z.filter (fun s => column s = column r), F s) =
      ∑ ρ ∈ columnZeros Z r,F ⟨r.1,ρ⟩ := by
  have hinj : Set.InjOn (Sigma.snd : TaggedZero Q → ℂ)
      (↑(Z.filter (fun s => column s = column r)) : Set (TaggedZero Q)) := by
    rintro ⟨i,u⟩ hi ⟨j,v⟩ hj huv
    have hi' : i = r.1 := (column_eq_iff ⟨i,u⟩ r).mp (mem_filter.mp hi).2
    have hj' : j = r.1 := (column_eq_iff ⟨j,v⟩ r).mp (mem_filter.mp hj).2
    change u = v at huv
    subst i
    subst j
    subst u
    rfl
  rw [columnZeros,sum_image hinj]
  apply sum_congr rfl
  rintro ⟨s,ρ⟩ hs
  have hs' : s = r.1 := (column_eq_iff ⟨s,ρ⟩ r).mp (mem_filter.mp hs).2
  subst s
  rfl

theorem card_column_le_order {Q : ℕ} {σ T : ℝ} {Z : Finset (TaggedZero Q)}
    (hZ : Z ⊆ familyZeroTags Q σ T) (r : TaggedZero Q) :
    ((columnZeros Z r).card:ℝ) ≤ ∑ s ∈ Z, (order s:ℝ) := by
  have hcard : (columnZeros Z r).card ≤ Z.card :=
    card_image_le.trans (card_le_card (filter_subset _ _))
  calc
    _ ≤ (Z.card:ℝ) := by exact_mod_cast hcard
    _ = ∑ _s ∈ Z, (1:ℝ) := by simp [nsmul_eq_mul]
    _ ≤ _ := by
      apply sum_le_sum
      intro s hs
      exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff s.1.2 s.2).mpr
        ((family_mem_geometry (hZ hs)).2.2.2.2.2.1)

/-- The finite detector term for one nonprincipal primitive zero. -/
def primitiveDetector {Q : ℕ} (S D E : Finset ℕ) (w ψ θ : ℕ → ℝ) (r : TaggedZero Q) : ℂ :=
  ∑ n ∈ S, LSeries.term (characterValue r * sieveProduct D E
    (fun k => (ψ k:ℂ)) (fun k => (θ k:ℂ))) r.2 n*(w n:ℂ)

/-- The finite Gram term on the common product modulus, including the principal case. -/
def primitiveGram {Q : ℕ} (S E : Finset ℕ) (w θ : ℕ → ℝ) (r s : TaggedZero Q) : ℂ :=
  ∑ n ∈ S, LSeries.term ((fun k : ℕ => taggedPair r s (k : ZMod (level r*level s))) *
    sieveProduct E E (fun k => (θ k:ℂ)) (fun k => (θ k:ℂ))) (conj r.2+s.2-1) n*(w n:ℂ)

theorem primitiveDetector_eq_detectorSum {Q : ℕ} (S D E : Finset ℕ)
    (w ψ θ : ℕ → ℝ) (r : TaggedZero Q) :
    primitiveDetector S D E w ψ θ r =
      detectorSum S w (realDivisorWeight D ψ) (realDivisorWeight E θ) (characterValue r) r.2 :=
  (detectorSum_eq_sieveProduct S D E w ψ θ (characterValue r) r.2).symm

theorem primitiveGram_eq_gramSum {Q : ℕ} (S E : Finset ℕ)
    (w θ : ℕ → ℝ) (r s : TaggedZero Q) :
    primitiveGram S E w θ r s =
      gramSum S w (realDivisorWeight E θ) (characterValue r) (characterValue s) r.2 s.2 := by
  rw [gramSum_eq_sieveSquare]
  unfold primitiveGram
  simp only [taggedPair_natCast]

/-- The primitive-family instance of the detector and Gram inequality with full analytic orders. -/
theorem primitive_table_halasz {Q : ℕ} (S D E : Finset ℕ) (hS : ∀ n ∈ S, n ≠ 0)
    (Z : Finset (TaggedZero Q)) (w ψ θ : ℕ → ℝ) (hw : ∀ n ∈ S, 0 ≤ w n) :
    (∑ r ∈ Z, (order r:ℝ)*‖primitiveDetector S D E w ψ θ r‖)^2 ≤
      (∑ n ∈ S, (realDivisorWeight D ψ n)^2*w n/(n:ℝ)) *
        ∑ r ∈ Z, (order r:ℝ)*(∑ s ∈ Z, (order s:ℝ)*‖primitiveGram S E w θ r s‖) := by
  simp only [primitiveDetector_eq_detectorSum,primitiveGram_eq_gramSum]
  exact detector_gram_halasz S hS Z order w (realDivisorWeight D ψ) (realDivisorWeight E θ) hw
    characterValue Sigma.snd

/-- The chosen upper cutoff converts the normalized count to the desired conductor-height scale. -/
theorem upperLog_density_scale {Q : ℕ} (hQ : 1 ≤ Q) {T δ : ℝ} (hT : 0 ≤ T) (hδ : 0 ≤ δ) :
    (Real.exp (upperLog (Real.log (Q:ℝ)) (Real.log (T+1))))^(2*δ*(1+1/200:ℝ)) ≤
      ((Q:ℝ)^3*(T+1)^4)^((1+1/100:ℝ)*δ) := by
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  have hQ₀ := zero_lt_one.trans_le hQ₁
  have hT₁ : 1 ≤ T+1 := by linarith only [hT]
  have hT₀ := zero_lt_one.trans_le hT₁
  rw [Real.rpow_def_of_pos (Real.exp_pos _),Real.log_exp,Real.rpow_def_of_pos (by positivity),
    Real.log_mul (pow_ne_zero _ hQ₀.ne') (pow_ne_zero _ hT₀.ne'),Real.log_pow,Real.log_pow]
  apply Real.exp_le_exp.mpr
  have h := mul_le_mul_of_nonneg_right
    (density_exponent_le (Real.log_nonneg hQ₁) (Real.log_nonneg hT₁)) hδ
  norm_num at h ⊢
  nlinarith only [h]

theorem logHeight_le_four_upperLog {Q : ℕ} (hQ : 1 ≤ Q) {T : ℝ} (hT : 0 ≤ T)
    (hlarge : 1 ≤ Real.log (Q:ℝ)+Real.log (T+1)) :
    logHeight Q (T+2) ≤ 4*upperLog (Real.log (Q:ℝ)) (Real.log (T+1)) := by
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  have hQ₀ := zero_lt_one.trans_le hQ₁
  have hT₁ : 1 ≤ T+1 := by linarith only [hT]
  have hT₀ := zero_lt_one.trans_le hT₁
  have hx := Real.log_nonneg hQ₁
  have hy := Real.log_nonneg hT₁
  have hgeom : 2*(Q:ℝ)*(2+|T+2|) ≤ 8*(Q:ℝ)*(T+1) := by
    rw [abs_of_nonneg (by linarith only [hT] : 0 ≤ T+2)]
    nlinarith only [mul_nonneg hQ₀.le hT]
  have hlog := Real.log_le_log (by positivity) hgeom
  have h8 : Real.log 8 ≤ 3 := by
    have h2 := Real.log_le_sub_one_of_pos (show (0:ℝ) < 2 by norm_num)
    rw [show (8:ℝ) = 2^3 by norm_num,Real.log_pow]
    norm_num
    linarith only [h2]
  rw [Real.log_mul (by positivity : (8:ℝ)*(Q:ℝ) ≠ 0) hT₀.ne',
    Real.log_mul (by norm_num : (8:ℝ) ≠ 0) hQ₀.ne'] at hlog
  unfold logHeight upperLog loss
  linarith only [hlog,h8,hx,hy,hlarge]

/-- If the count is already larger than `Y^(2δ)`, its own logarithm
absorbs the local-height factor without increasing the density exponent. -/
theorem heightGap_le_large_countLog {Y J δ H K : ℝ} (hY : 0 < Y) (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hH : H ≤ K*Real.log Y) (hJ : Y^(2*δ) < J) :
    1+δ*H ≤ (1+K)*(1+Real.log (1+J)) := by
  have hp := Real.rpow_pos_of_pos hY (2*δ)
  have hJ₀ := hp.trans hJ
  have hL := Real.log_le_log hp hJ.le
  rw [Real.log_rpow hY] at hL
  have hL' := Real.log_le_log hJ₀ (show J ≤ 1+J by linarith)
  have hlog₀ := Real.log_nonneg (show 1 ≤ 1+J by linarith only [hJ₀])
  have hδlog : δ*Real.log Y ≤ Real.log (1+J) := by linarith only [hL,hL',hlog₀]
  calc
    _ ≤ 1+δ*(K*Real.log Y) := add_le_add le_rfl (mul_le_mul_of_nonneg_left hH hδ)
    _ = 1+K*(δ*Real.log Y) := by ring
    _ ≤ 1+K*Real.log (1+J) := add_le_add le_rfl (mul_le_mul_of_nonneg_left hδlog hK)
    _ ≤ _ := by nlinarith only [hK,hlog₀]

end
