def tagCharacter {q : ℕ} (t : ModulusTag q) := t.1.1
def tagZero {q : ℕ} (t : ModulusTag q) := t.1.2

theorem census_tag_zero_geometry {q : ℕ} [NeZero q] {H R U : ℝ}
    {T : Finset (ModulusTag q)} (hT : T⊆repeatTags (modulusZeros q H R) modulusOrder)
    (hRU : R≤U) :
    ∀ t∈T, tagCharacter t≠1 ∧ regularizedL (tagCharacter t) (tagZero t)=0 ∧
      (tagZero t).re<1 ∧ modulusGap q (tagZero t)≤H ∧ |(tagZero t).im|≤U := by
  intro t ht
  have hMem := (mem_sigma.mp (hT ht)).1
  obtain ⟨hχ,hz,hGap⟩ := mem_fixed_modulus_zeros.mp hMem
  obtain ⟨_,hTime,hZ⟩ := (mem_exceptionalZeros _ _ _).mp hz
  have hReal : t.1.2.re<1 := by
    by_contra! hn
    apply LFunction_ne_zero_of_one_le_re t.1.1 (Or.inl hχ) hn
    simpa only [regularizedL,hχ,ite_false] using hZ
  exact ⟨hχ,hZ,hReal,hGap,hTime.trans hRU⟩

private theorem cd_census_fiber {q : ℕ} [NeZero q] {H R : ℝ}
    {T : Finset (ModulusTag q)} (hT : T⊆repeatTags (modulusZeros q H R) modulusOrder)
    (i : ModulusTag q) (z : ℂ) :
    (((T.filter (fun j=>tagCharacter i=tagCharacter j)).filter
      (fun j=>tagZero j=z)).card)≤ analyticOrderNatAt (regularizedL (tagCharacter i)) z := by
  let V := (T.filter (fun j=>tagCharacter i=tagCharacter j)).filter (fun j=>tagZero j=z)
  have hf (j : ModulusTag q) (hj : j∈V) : j.1=(tagCharacter i,z) := by
    have hS := (mem_filter.mp hj).2
    have hC := (mem_filter.mp (mem_filter.mp hj).1).2
    exact Prod.ext hC.symm hS
  have hIdx : Set.InjOn (fun (t : ModulusTag q)=>t.2) V := by
    rintro ⟨a,m⟩ hi ⟨b,n⟩ hj hm
    change m=n at hm
    have he : a=b := (hf _ hi).trans (hf _ hj).symm
    subst b
    subst n
    rfl
  change V.card≤_
  rw [←card_image_of_injOn hIdx]
  have hSub : V.image (fun t => t.2)⊆
      range (analyticOrderNatAt (regularizedL (tagCharacter i)) z) := by
    intro k hk
    obtain ⟨j,hj,rfl⟩ := mem_image.mp hk
    have hJ := (mem_filter.mp (mem_filter.mp hj).1).1
    have hN := (mem_sigma.mp (hT hJ)).2
    have he := hf _ hj
    simpa only [he,modulusOrder,mem_range] using hN
  exact (card_le_card hSub).trans_eq (card_range _)

private theorem cd_census_order_sum {q : ℕ} [NeZero q] {H R : ℝ}
    {T : Finset (ModulusTag q)} (hT : T⊆repeatTags (modulusZeros q H R) modulusOrder)
    (i : ModulusTag q) :
    (∑ z∈((T.filter (fun j=>tagCharacter i=tagCharacter j)).image tagZero),
      (analyticOrderNatAt (regularizedL (tagCharacter i)) z:ℝ)) ≤
    ∑ p∈modulusZeros q H R,(modulusOrder p:ℝ) := by
  let V := ((T.filter (fun j=>tagCharacter i=tagCharacter j)).image tagZero)
  let F (z : ℂ) := (tagCharacter i,z)
  have hf : V.image F⊆modulusZeros q H R := by
    intro p hp
    obtain ⟨z,hz,rfl⟩ := mem_image.mp hp
    obtain ⟨j,hj,rfl⟩ := mem_image.mp hz
    have hj' := (mem_sigma.mp (hT (mem_filter.mp hj).1)).1
    exact (show j.1=F (tagZero j) from Prod.ext (mem_filter.mp hj).2.symm rfl) ▸ hj'
  have hInj : Function.Injective F := fun _ _ he=>congrArg Prod.snd he
  change (∑ z∈V,(modulusOrder (F z):ℝ))≤_
  calc
    _ = ∑ p∈V.image F,(modulusOrder p:ℝ) :=
      (sum_image (f:=fun p=>(modulusOrder p:ℝ)) hInj.injOn).symm
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hf (fun _ _ _=>by positivity)

theorem cd_census_rows {q : ℕ} [NeZero q] {H R J : ℝ}
    {T : Finset (ModulusTag q)} (hT : T⊆repeatTags (modulusZeros q H R) modulusOrder)
    (hJ : (∑ p∈modulusZeros q H R,(modulusOrder p:ℝ))≤J) :
    (∀ i∈T,∀ z∈((T.filter (fun j=>tagCharacter i=tagCharacter j)).image tagZero),
      (((T.filter (fun j=>tagCharacter i=tagCharacter j)).filter
        (fun j=>tagZero j=z)).card)≤analyticOrderNatAt (regularizedL (tagCharacter i)) z) ∧
    (∀ i∈T,(∑ z∈((T.filter (fun j=>tagCharacter i=tagCharacter j)).image tagZero),
      (analyticOrderNatAt (regularizedL (tagCharacter i)) z:ℝ))≤J) :=
  ⟨fun i _ z _ => cd_census_fiber hT i z,fun i _=>(cd_census_order_sum hT i).trans hJ⟩

theorem cd_census_small_quotients {q K : ℕ} [NeZero q] {T : Finset (ModulusTag q)}
    (hClass : OneConductorClass K T) :
    ∀ i∈T,∀ j∈T,tagCharacter i≠tagCharacter j →
      (cdQuotient (tagCharacter i) (tagCharacter j)).conductor≤K.factorial := by
  intro i hi j hj _
  have hd := (conductorClass_eq_iff (tagCharacter j) (tagCharacter i)).mp (hClass j hj i hi)
  exact Nat.le_of_dvd (Nat.factorial_pos K)
    (by simpa only [cdQuotient,div_eq_mul_inv,mul_comm] using hd)

end
end GoldbachSignedPairs
