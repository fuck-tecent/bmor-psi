noncomputable section

theorem sum_class_squares_le {ι : Type*} (S : Finset ι) (A B : ι→ℝ)
    {a b A₀ B₀ : ℝ}
    (hA₀ : 0≤A₀) (hB₀ : 0≤B₀)
    (hA : ∀ i∈S, 0≤A i ∧ A i≤A₀)
    (hB : ∀ i∈S, 0≤B i ∧ B i≤B₀)
    (ha : (∑ i∈S,A i)≤a) (hb : (∑ i∈S,B i)≤b) :
    (∑ i∈S,(A i+B i)^2)≤A₀*a+B₀*(2*a+b) := by
  calc
    _ ≤ ∑ i∈S, (A₀*A i+B₀*(2*A i+B i)) := by
      apply sum_le_sum
      intro i hi
      obtain ⟨h₁,h₂⟩ := hA i hi
      obtain ⟨h₃,h₄⟩ := hB i hi
      have hL := mul_le_mul_of_nonneg_right h₂ h₁
      have hR := mul_le_mul_of_nonneg_right h₄ (show 0≤2*A i+B i by positivity)
      nlinarith only [hL,hR]
    _ = A₀*(∑ i∈S,A i)+B₀*(2*(∑ i∈S,A i)+(∑ i∈S,B i)) := by
      simp only [sum_add_distrib,←mul_sum]
    _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left ha hA₀)
      (mul_le_mul_of_nonneg_left (add_le_add (mul_le_mul_of_nonneg_left ha (by norm_num)) hb) hB₀)

theorem sum_early_excess_bound {ι : Type*} (S : Finset ι) (level : ι→ℝ)
    {a c H b A α β N J : ℝ}
    (hb : 0<b) (hA : 0≤A) (hAb : 4≤A*b) (hα : 0≤α) (hβ : 0≤β)
    (hac : a≤c) (hch : c≤H)
    (hStart : Real.exp (-A*a)-Real.exp (-A*H)-
        β*(realRationalZeroKernel b 0-realRationalZeroKernel b (H-a))≤α)
    (hCut : Real.exp (-A*c)-Real.exp (-A*H)≤
        β*(realRationalZeroKernel b (c-a)-realRationalZeroKernel b (H-a)))
    (hmin : ∀ i∈S, a≤level i) (hsmall : ((S.filter (fun i => level i<c)).card:ℝ)≤N)
    (hmoment : (∑ i∈S,max 0
      (realRationalZeroKernel b (level i-a)-realRationalZeroKernel b (H-a)))≤J) :
    (∑ i∈S,max 0 (Real.exp (-A*level i)-Real.exp (-A*H)))≤α*N+β*J := by
  classical
  calc
    _ ≤ ∑ i∈S,((if level i<c then α else 0)+β*
      max 0 (realRationalZeroKernel b (level i-a)-realRationalZeroKernel b (H-a))) :=
      sum_le_sum fun i hi =>
        rational_excess_one_threshold_le hb hA hAb hα hβ hac hch hStart hCut (hmin i hi)
    _ = α*((S.filter (fun i => level i<c)).card:ℝ) +
        β*(∑ i∈S,max 0 (realRationalZeroKernel b (level i-a)-realRationalZeroKernel b (H-a))) := by
      rw [sum_add_distrib,←mul_sum,←sum_filter,sum_const,nsmul_eq_mul,mul_comm α]
    _ ≤ _ := add_le_add (mul_le_mul_of_nonneg_left hsmall hα) (mul_le_mul_of_nonneg_left hmoment hβ)

theorem exp_weight_split {A H y : ℝ} (hA : 0≤A) :
    Real.exp (-A*y) = max 0 (Real.exp (-A*y)-Real.exp (-A*H))+
      Real.exp (-A*max y H) := by
  rcases le_total H y with h|h
  · rw [max_eq_left h,max_eq_left]
    · ring
    · exact sub_nonpos.mpr (Real.exp_le_exp.mpr (mul_le_mul_of_nonpos_left h (by linarith)))
  · rw [max_eq_right h,max_eq_right]
    · ring
    · exact sub_nonneg.mpr (Real.exp_le_exp.mpr (mul_le_mul_of_nonpos_left h (by linarith)))

end
end GoldbachPintzNumerics
