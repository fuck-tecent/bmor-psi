      S.filter (fun i => h i ≤ Real.exp s) := by
    intro i hi
    obtain ⟨hiS, hi⟩ := Finset.mem_filter.mp hi
    refine Finset.mem_filter.mpr ⟨hiS, ?_⟩
    have hex := (Real.log_le_iff_le_exp (by linarith [hh i hiS] : 0 < 1 + h i)).mp hi
    linarith
