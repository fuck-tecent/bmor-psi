  have h0Mem := hC0 _ (hGeoσ.trans (by linarith only [hr])) hzξ
  have hγMem := hCγ _ ((hGeo β γ hβ₀ hβ1).trans (by linarith only [hr])) hzχ
  have h0Est := hU0 {line σ 0} (Finset.singleton_subset_iff.mpr h0Mem) (by
