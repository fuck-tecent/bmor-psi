private theorem local_logDeriv_eq_inside {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hχ : χ≠1) {w : ℂ} {R : ℝ} (hR : 0<R) (hw : 1<w.re)
    (G : ℂ→ℂ) (hG : AnalyticOnNhd ℂ G (closedBall w R)) (V : Finset ℂ)
    (hV : ∀ ρ∈V, ρ.re≤1)
    (he : (fun z=>-logDeriv χ.LFunction z) =ᶠ[𝓝 w]
      (fun z=>G z-∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*(1/(z-ρ))))
    {u : ℂ} (hu : u∈ball w R) (hu' : 1<u.re) :
    -logDeriv χ.LFunction u =
      G u-∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*(1/(u-ρ)) := by
  let A := ball w R ∩ {z : ℂ | 1<z.re}
  let F : ℂ→ℂ := fun z=>-logDeriv χ.LFunction z
  let E : ℂ→ℂ := fun z=>G z-∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*(1/(z-ρ))
  have hA : Convex ℝ A := (convex_ball _ _).inter (convex_halfSpace_gt reCLM.toLinearMap.isLinear 1)
  have hF : AnalyticOnNhd ℂ F A := by
    intro v hv
    have hd := (DirichletCharacter.differentiable_LFunction hχ).analyticAt v
    have hn : χ.LFunction v≠0 := by
      simpa [regularizedL,hχ] using regularizedL_ne_zero_right χ hv.2
    exact (hd.deriv.div hd hn).neg
  have hE : AnalyticOnNhd ℂ E A := by
    intro v hv
    apply (hG v (ball_subset_closedBall hv.1)).sub
    apply Finset.analyticAt_fun_sum
    intro ρ hρ
    have hn : v-ρ≠0 := by
      intro h
      have hh := congrArg Complex.re (sub_eq_zero.mp h)
      have hL := hV ρ hρ
      exact (not_le_of_gt hv.2) (hh ▸ hL)
    exact analyticAt_const.mul (analyticAt_const.div (analyticAt_id.sub analyticAt_const) hn)
  exact hF.eqOn_of_preconnected_of_eventuallyEq hE hA.isPreconnected
    ⟨mem_ball_self hR,hw⟩ he ⟨hu,hu'⟩

set_option maxHeartbeats 2600000 in
/-- A signed exponential kernel preserves the sharp nonprincipal conductor
cost when all of its shifts use the same analytic remainder. -/
theorem exponential_prime_nonprincipal_upper {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    {b₀ C ε K D κ : ℝ} (hb₀ : 0<b₀) (hC : 0≤C)
    (hb : ∀ i∈S,b₀≤ b i ∧ b i≤ b₀+C)
    (hε : 0<ε) (hK : 0<K) (hD : 0≤D) (hκ : 0<κ)
    (hc : 0≤∑ i∈S,exponentialAutoCoeff S a b i) :
    ∃ r L₀ : ℝ, 0<r ∧ r≤1/32 ∧ 1≤L₀ ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ≠1 →
    ∀ {L φ B Q T : ℝ} {s : ℂ}, L₀≤L →
      1+κ/L≤ s.re+b₀/L → s.re≤1 → |s.im|+1/4≤T →
      logHeight q s.im≤K*L → 0≤φ → 1≤B → 1≤Q → Real.log B≤D*Real.log L →
      (∀ z : ℂ, 3/4≤ z.re → z.re≤3/2 → |z.im|≤T →
        ‖χ.LFunction z‖≤B*Q^(φ*max 0 (1-z.re))) →
      ∃ V : Finset ℂ,
        (∀ ρ∈V,regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ ‖ρ-line 1 s.im‖≤2*r) ∧
        (∀ ρ : ℂ, ‖ρ-line 1 s.im‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
        ∀ U : Finset ℂ, U⊆V → (∀ ρ∈V, ρ∉U → ρ.re≤ s.re) →
          (exponentialPrimeTest S a b χ L s).re≤
            (∑ i∈S,exponentialAutoCoeff S a b i)*(φ*Real.log Q/2)+ε*L-
              L*∑ ρ∈U,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
                (exponentialAutoTransform S a b ((L:ℂ)*(s-ρ))).re := by
  obtain ⟨A,hA,hAux⟩ := sharp_local_window_remainder
  let J : ℝ := ∑ i∈S,|exponentialAutoCoeff S a b i|
  let ε' := ε/(J+1)
  have hJ : 0≤J := Finset.sum_nonneg (fun _ _=>abs_nonneg _)
  have hε' : 0<ε' := div_pos hε (by positivity)
  have hJf : (∑ i∈S,exponentialAutoCoeff S a b i)≤J :=
    Finset.sum_le_sum fun _ _=>le_abs_self _
  obtain ⟨r,L₀,hr,hr32,hL₀,hBudget⟩ := rational_jet_error_budget
    (b:=2*C+1) (C:=2*(C+b₀)) hε' hA hK hκ (by positivity) hD (by positivity)
  refine ⟨r,L₀,hr,hr32,hL₀,?_⟩
  intro q _ χ hχ L φ B Q T s hL hsr hσ hT hHt hφ hB hQ hBL hStrip
  have hLp : 0<L := zero_lt_one.trans_le (hL₀.trans hL)
  let w : ℂ := s+(b₀/L:ℝ)
  let v (i : ι) : ℂ := s+(b i/L:ℝ)
  let M : ℝ := A*logHeight q s.im
  have hM : 0≤M := mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one q s.im))
  have hML : M≤A*K*L := by
    unfold M
    exact (mul_le_mul_of_nonneg_left hHt hA.le).trans_eq (by ring)
  obtain ⟨hGeom,hErr⟩ := hBudget L M B hL hM hML hBL
  have hGeo (d : ℝ) (hd : d≤C+b₀) : d/L≤r/4 := by
    have hh := (div_le_div_of_nonneg_right (show 2*d≤2*(C+b₀) by linarith only [hd]) hLp.le).trans hGeom
    linarith only [hh,show 2*d/L=2*(d/L) by ring]
  have hwL : 1+κ/L≤w.re := by simpa only [w,Complex.add_re,Complex.ofReal_re] using hsr
  have hwU : w.re≤1+r/2 := by
    have hG := hGeo b₀ (by linarith only [hC])
    simp only [w,Complex.add_re,Complex.ofReal_re]
    linarith only [hσ,hG,hr]
  have hwI : w.im=s.im := by simp [w,Complex.add_im]
  have hw1 : 1<w.re := (lt_add_of_pos_right _ (div_pos hκ hLp)).trans_le hwL
  obtain ⟨V,G,hV,hCov,hG,hGNorm,hGe,hSharp⟩ := hAux q χ hχ (w:=w) hr hr32
    (div_pos hκ hLp) hwL hwU (by simpa only [hwI] using hT) hφ hB hQ hStrip
  let K₀ := 16*max (Real.log (1+(κ/L)⁻¹)) (Real.log B)+192*r*M
  let Δ := (4*(1+r⁻¹)*M/r)*(C/L)
  have hK₀ : 0≤K₀ := by
    unfold K₀
    exact add_nonneg (mul_nonneg (by norm_num) ((Real.log_nonneg hB).trans (le_max_right _ _)))
      (mul_nonneg (by positivity) hM)
  have hΔ : 0≤Δ := by unfold Δ; positivity
  have hD (i : ι) (hi : i∈S) :
      ‖v i-w‖=(b i-b₀)/L := by
    change ‖s+(b i/L:ℝ)-(s+(b₀/L:ℝ))‖=_
    rw [show s+(b i/L:ℝ)-(s+(b₀/L:ℝ))=(((b i-b₀)/L:ℝ):ℂ) by push_cast; ring,
      Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (div_nonneg (sub_nonneg.mpr (hb i hi).1) hLp.le)]
  have hVNorm (i : ι) (hi : i∈S) : ‖v i-w‖≤r/4 := by
    rw [hD i hi]
    exact hGeo _ (by linarith only [(hb i hi).2,hb₀])
  have hVreal (i : ι) (hi : i∈S) : 1<(v i).re := by
    apply hw1.trans_le
    simp only [w,v,Complex.add_re,Complex.ofReal_re]
    exact add_le_add_right (div_le_div_of_nonneg_right (hb i hi).1 hLp.le) s.re
  have hAt (i : ι) (hi : i∈S) :
      -logDeriv χ.LFunction (v i)=G (v i)-
      ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*(1/(v i-ρ)) :=
    local_logDeriv_eq_inside χ hχ (by positivity) hw1 G hG V (fun ρ hρ=>(hV ρ hρ).2.1) hGe
      (mem_ball_iff_norm.mpr ((hVNorm i hi).trans_lt (by linarith only [hr]))) (hVreal i hi)
  have hDiff (i : ι) (hi : i∈S) : ‖G (v i)-G w‖≤Δ := by
    have hB := analytic_disk_half_lipschitz (R:=r/2) (M:=(1+r⁻¹)*M)
      (by positivity) hG (by simpa only [hwI] using hGNorm)
      (mem_closedBall_self (by positivity)) (mem_closedBall_iff_norm.mpr
        ((hVNorm i hi).trans (by ring_nf; exact le_rfl)))
    refine hB.trans ?_
    have hi' : ‖v i-w‖≤C/L := by
      rw [hD i hi]
      exact div_le_div_of_nonneg_right (by linarith only [(hb i hi).2]) hLp.le
    have hP := mul_le_mul_of_nonneg_left hi' (show 0≤2*((1+r⁻¹)*M)/(r/2) by positivity)
    exact hP.trans_eq (by unfold Δ; ring)
  have hΔB :
      Δ≤((2*C+1)/L)*((1+r⁻¹)*M)/(r/2) := by
    unfold Δ
    have he : 4*(1+r⁻¹)*M/r*(C/L)=
        ((2*C)/L)*((1+r⁻¹)*M)/(r/2) := by ring
    rw [he]
    gcongr
    linarith
  have hB₀ : K₀+Δ≤ε'*L := by
    have hE₂ : 0≤(2/3:ℝ)*((2*C+1)/L)^2*((1+r⁻¹)*M)/(r/2)^2 := by positivity
    unfold K₀
    linarith only [hErr,hΔB,hE₂]
  have hWeighted : (∑ i∈S,exponentialAutoCoeff S a b i)*K₀+J*Δ≤ε*L := calc
    _ ≤ J*K₀+J*Δ := add_le_add_left (mul_le_mul_of_nonneg_right hJf hK₀) _
    _ = J*(K₀+Δ) := by ring
    _ ≤ (J+1)*(ε'*L) := mul_le_mul (by linarith only) hB₀ (by positivity) (by positivity)
    _ = _ := by unfold ε'; field_simp [show J+1≠0 by positivity]
  have hSharp' : (G w).re≤φ*Real.log Q/2+K₀ := by
    simp only [hwI] at hSharp
    unfold K₀ M
    linarith only [hSharp]
  have hRsum := exponential_prime_remainder_re_le S (exponentialAutoCoeff S a b) v G hc hSharp' hDiff
  have hTest := exponentialPrimeTest_eq_local S a b χ hLp s V (analyticOrderNatAt (regularizedL χ)) G
    (by simpa [v] using hAt)
  refine ⟨V, (by simpa only [hwI] using hV), (by simpa only [hwI] using hCov), ?_⟩
  intro U hU hDiscard
  have hNonneg : ∀ ρ∈V, ρ∉U → 0≤(exponentialAutoTransform S a b ((L:ℂ)*(s-ρ))).re := by
    intro ρ hρ hρU
    apply exponentialAutoTransform_re_nonneg S a b
      (fun i hi=>hb₀.trans_le (hb i hi).1)
    rw [Complex.re_ofReal_mul,Complex.sub_re]
    exact mul_nonneg hLp.le (sub_nonneg.mpr (hDiscard ρ hρ hρU))
  let W (ρ : ℂ) : ℝ := (analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
    (exponentialAutoTransform S a b ((L:ℂ)*(s-ρ))).re
  have hSub : (∑ ρ∈U,W ρ)≤∑ ρ∈V,W ρ := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hU
    intro ρ hρ hρU
    exact mul_nonneg (Nat.cast_nonneg _) (hNonneg ρ hρ hρU)
  have hS := mul_le_mul_of_nonneg_left hSub hLp.le
  have hTest' := congrArg Complex.re hTest
  have hSRe : (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*
      exponentialAutoTransform S a b ((L:ℂ)*(s-ρ))).re=∑ ρ∈V,W ρ := by
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl ?_
    intro ρ _
    rw [←Complex.ofReal_natCast,Complex.re_ofReal_mul]
  rw [Complex.sub_re,Complex.re_ofReal_mul,hSRe] at hTest'
  change (exponentialPrimeTest S a b χ L s).re =
    (∑ i∈S,(exponentialAutoCoeff S a b i:ℂ)*G (v i)).re-L*∑ ρ∈V,W ρ at hTest'
  have hU' : (exponentialPrimeTest S a b χ L s).re≤
      (∑ i∈S,exponentialAutoCoeff S a b i)*(φ*Real.log Q/2)+ε*L-
