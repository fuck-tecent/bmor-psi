/-- Sharp C/D sinh row on the full bounded-height zero set, including the
contribution of the discarded distant ordinates. -/
theorem cd_sinh_row_eventually {φ ω T H J ε : ℝ} (hφ : 3/8 < φ)
    (hω : 0 < ω) (hT : 0 ≤ T) (hH : 0 ≤ H) (hJ : 0 ≤ J) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ χ : DirichletCharacter ℂ q, χ≠1 →
      ∀ γ ell : ℝ, |γ| ≤ T → 0 < ell → ell ≤ H →
      ∀ V : Finset ℂ, (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re ≤ 1 ∧ (1-ρ.re)*L ≤ H) →
        (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)) ≤ J →
        (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
          ‖windowLaplace ω (cdResolventPoint 0 L γ ρ+(ell:ℂ))‖^2) ≤
          densityMomentScalar φ ω ell+ε := by
  obtain ⟨C,D,hC,hD,hNear⟩ := cd_sinh_laplace_near_eventually hφ hω hT hH hJ
  let K := 1+ω*Real.cosh (H*ω)
  let S := 1+J*ω^3*Real.cosh (H*ω)
  let e := ε/(64*K)
  let r := min (1/32) (e/(1+C))
  let b := ε/(64*S)
  let A := ((Real.log 4+4)*ω*Real.cosh (H*ω))+
      (J/b+D+2/b)*(32*Real.pi*Real.exp (H*ω)/r)
  have hK : 0 < K := by dsimp only [K]; positivity
  have hS : 0 < S := by dsimp only [S]; positivity
  have he : 0 < e := by dsimp only [e]; positivity
  have hr : 0 < r := lt_min (by norm_num) (by positivity)
  have hb : 0 < b := by dsimp only [b]; positivity
  have hrSmall : r ≤ 1/32 := min_le_left _ _
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have hEK : e*K=ε/64 := by dsimp only [e]; field_simp [hK.ne']
  have hBS : b*S=ε/64 := by dsimp only [b]; field_simp [hS.ne']
  have hrC : C*r≤e := by
    have h := (le_div_iff₀ (by positivity : 0<1+C)).mp (min_le_right (1/32:ℝ) (e/(1+C)))
    linarith only [h,hr.le]
  filter_upwards [hNear r b e hr hrSmall hb he,eventually_ge_atTop (1:ℝ),
    eventually_ge_atTop (64*A/ε),eventually_ge_atTop (32*J/(ε*r^2))] with L hN hL hL₁ hL₂
  intro q _ hq χ hχ γ ell hγ hell hEll V hV hCount
  have hL₀ := zero_lt_one.trans_le hL
  let close (ρ : ℂ) : Prop := |ρ.im-γ|≤r/2
  let S₁ := V.filter close
  let S₂ := V.filter fun ρ=>¬close ρ
  let m (ρ : ℂ) := analyticOrderNatAt (regularizedL χ) ρ
  let z (ρ : ℂ) := cdResolventPoint 0 L γ ρ
  let f (ρ : ℂ) := (m ρ:ℝ)*‖windowLaplace ω (z ρ+(ell:ℂ))‖^2
  have hM₁ : (∑ ρ∈S₁,(m ρ:ℝ))≤J := by
    refine (sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _=>Nat.cast_nonneg _).trans hCount
  have hM₂ : (∑ ρ∈S₂,(m ρ:ℝ))≤J := by
    refine (sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun _ _ _=>Nat.cast_nonneg _).trans hCount
  have hClose (ρ : ℂ) (hρ : ρ∈S₁) :
      regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ (1-ρ.re)*L≤H ∧ |ρ.im-γ|≤r/2 := by
    obtain ⟨hρ',hNear'⟩ := mem_filter.mp hρ
    obtain ⟨h0,h1,h2⟩ := hV ρ hρ'
    exact ⟨h0,h1,h2,hNear'⟩
  have hz (ρ : ℂ) (hρ : ρ∈V) : 0≤(z ρ).re :=
    (add_nonneg) le_rfl (mul_nonneg (sub_nonneg.mpr (hV ρ hρ).2.1) hL₀.le)
  have hSinh : sinhTest ω ell 0≤ell*K := by
    refine (cd_sinhTest_zero_le hω hell hEll).trans ?_
    dsimp only [K]
    linarith only [hell.le]
  have hOne : (C*r+e)*sinhTest ω ell 0≤(ε/32)*ell := by
    have hco : 0 ≤ C*r+e := by positivity
    calc
      _≤(C*r+e)*(ell*K) := mul_le_mul_of_nonneg_left hSinh hco
      _≤(2*e)*(ell*K) := mul_le_mul_of_nonneg_right (by linarith only [hrC]) (by positivity)
      _=2*(e*K)*ell := by ring
      _=(ε/32)*ell := by rw [hEK]; ring
  have hTwo : A*ell/L≤(ε/64)*ell := by
    have hAL : A/L≤ε/64 := (div_le_iff₀ hL₀).mpr (by
      have hh := (div_le_iff₀ hε).mp hL₁
      linarith only [hh])
    calc
      _=(A/L)*ell := by ring
      _≤_ := mul_le_mul_of_nonneg_right hAL hell.le
  have hThree : J*((b*ell)*ω^3*Real.cosh (H*ω))≤(ε/64)*ell := by
    have hh : J*ω^3*Real.cosh (H*ω)≤S := by dsimp only [S]; linarith
    calc
      _=(J*ω^3*Real.cosh (H*ω))*(b*ell) := by ring
      _≤S*(b*ell) := mul_le_mul_of_nonneg_right hh (by positivity)
      _=(b*S)*ell := by ring
      _=_ := by rw [hBS]
  have hLap := hN q hq χ hχ γ ell hγ hell hEll S₁ hClose hM₁
  have hEF : (∑ ρ∈S₁,(m ρ:ℝ)*(laplace (sinhTest ω ell) (z ρ)).re)≤
      (φ/2)*sinhTest ω ell 0+(laplace (sinhTest ω ell) 0).re+(ε/4)*ell := by
    change (∑ ρ∈S₁,(m ρ:ℝ)*(laplace (sinhTest ω ell) (z ρ)).re)≤
      (φ/2+C*r+e)*sinhTest ω ell 0+(laplace (sinhTest ω ell) 0).re+A*ell/L+
        J*((b*ell)*ω^3*Real.cosh (H*ω)) at hLap
    nlinarith only [hLap,hOne,hTwo,hThree,mul_pos hε hell]
  have hPhi := sinh_row_le_of_explicit_formula S₁ m z hω hell
    (fun ρ hρ=>hz ρ (mem_filter.mp hρ).1) hEF
  have hSmallRow : (∑ ρ∈S₁,f ρ)≤densityMomentScalar φ ω ell+ε/2 := by
    refine hPhi.trans (add_le_add le_rfl ?_)
    have hW : 1≤Real.exp (ell*ω) := Real.one_le_exp (mul_nonneg hell.le hω.le)
    apply (div_le_iff₀ (by positivity : 0<ell*Real.exp (ell*ω)/2)).mpr
    have hh := mul_le_mul_of_nonneg_left hW (by positivity : 0≤ε*ell/4)
    nlinarith only [hh]
  have hFarRow : (∑ ρ∈S₂,f ρ)≤ε/2 := by
    have hR : 0<r*L/2 := by positivity
    have hF (ρ : ℂ) (hρ : ρ∈S₂) : ‖windowLaplace ω (z ρ+(ell:ℂ))‖≤2/(r*L/2) := by
      obtain ⟨hρ',hq'⟩ := mem_filter.mp hρ
      have hsep : r/2≤|ρ.im-γ| := le_of_lt (lt_of_not_ge hq')
      have hZ : 0≤(z ρ+(ell:ℂ)).re := by simp only [add_re,ofReal_re]; positivity [hz ρ hρ']
      apply norm_windowLaplace_le_of_large_im hω.le hZ hR
      change r*L/2≤|(ρ.im-γ)*L+0|
      rw [add_zero,abs_mul,abs_of_pos hL₀]
      have h := mul_le_mul_of_nonneg_right hsep hL₀.le
      linarith only [h]
    have hPred : (∑ ρ∈S₂,f ρ)≤J*(2/(r*L/2))^2 := by
      calc
        _ ≤ ∑ ρ∈S₂,(m ρ:ℝ)*(2/(r*L/2))^2 := by
          apply sum_le_sum
          intro ρ hρ
          exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hF ρ hρ) 2) (Nat.cast_nonneg _)
        _≤_ := by rw [←sum_mul]; exact mul_le_mul_of_nonneg_right hM₂ (sq_nonneg _)
    refine hPred.trans ?_
    have hProduct := (div_le_iff₀ (by positivity : 0<ε*r^2)).mp hL₂
    have hLSq : L≤L^2 := by
      rw [pow_two]
      simpa only [one_mul] using mul_le_mul_of_nonneg_right hL hL₀.le
    have hProduct' : 32*J≤(L^2)*(ε*r^2) :=
      hProduct.trans (mul_le_mul_of_nonneg_right hLSq (mul_nonneg hε.le (sq_nonneg r)))
    rw [show J*(2/(r*L/2))^2=16*J/(r^2*L^2) by field_simp [hr.ne',hL₀.ne'] <;> ring]
    apply (div_le_iff₀ (by positivity : 0<r^2*L^2)).mpr
    nlinarith only [hProduct']
  have hSplit : (∑ ρ∈V,f ρ)=(∑ ρ∈S₁,f ρ)+(∑ ρ∈S₂,f ρ) :=
    (sum_filter_add_sum_filter_not V close f).symm
  change (∑ ρ∈V,f ρ)≤_
  rw [hSplit]
  linarith only [hSmallRow,hFarRow]

end
end GoldbachPintzWeightedFormula
end

