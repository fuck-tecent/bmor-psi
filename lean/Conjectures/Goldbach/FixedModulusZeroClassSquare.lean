noncomputable section

private theorem scaled_line_sub (L x y s t : ℝ) :
    (L:ℂ)*(line x s-line y t)=((L*(x-y):ℝ):ℂ)+((L*(s-t):ℝ):ℂ)*I := by
  apply Complex.ext <;> simp [line,Complex.add_re,Complex.add_im,Complex.mul_re,
    Complex.mul_im,Complex.sub_re,Complex.sub_im]

private theorem rational_re_ofReal (b x : ℝ) :
    (rationalZeroKernel b (x:ℂ)).re=realRationalZeroKernel b x := by
  have h : rationalZeroKernel b (x:ℂ)=(realRationalZeroKernel b x:ℂ) := by
    unfold rationalZeroKernel realRationalZeroKernel
    push_cast
    ring
  rw [h,Complex.ofReal_re]

private theorem rational_re_le_large_ordinate {b : ℝ} (hb : 0≤b) (z : ℂ)
    (hz : 1≤|z.im|) :
    (rationalZeroKernel b z).re≤(1+b+2*b^2/3)/|z.im| := by
  let y := |z.im|
  let v := ‖(b:ℂ)+z‖
  have hY : y≤v := by simpa [y,v,Complex.add_im] using Complex.abs_im_le_norm ((b:ℂ)+z)
  have hy : 0<y := zero_lt_one.trans_le hz
  have hv : 1≤v := hz.trans hY
  have hv2 : v≤v^2 := by nlinarith only [hv,mul_nonneg (show 0≤v by positivity) (sub_nonneg.mpr hv)]
  have hv3 : v≤v^3 := hv2.trans (by
    simpa only [pow_succ,mul_one] using mul_le_mul_of_nonneg_left hv (sq_nonneg v))
  have h1 := div_le_div_of_nonneg_left (show (0:ℝ)≤1 by norm_num) hy hY
  have h2 := div_le_div_of_nonneg_left hb hy (hY.trans hv2)
  have h3 := div_le_div_of_nonneg_left (show 0≤2*b^2/3 by positivity) hy (hY.trans hv3)
  calc
    _ ≤ ‖rationalZeroKernel b z‖ := Complex.re_le_norm _
    _ ≤ 1/v+b/v^2+(2*b^2/3)/v^3 := by
      unfold rationalZeroKernel
      refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
      · refine (norm_add_le _ _).trans ?_
        rw [norm_div,norm_one,norm_div,norm_pow,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hb]
      · rw [norm_div,norm_pow]
        rw [Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (by positivity)]
    _ ≤ _ := by rw [add_div,add_div]; exact add_le_add (add_le_add h1 h2) h3

set_option maxHeartbeats 1600000 in
/-- A distinct zero of the same character has gap strictly above .60,
provided the leading gap is at most .31 and the square is nonprincipal. -/
theorem same_secondary_gap_of_strip_at {K D p b g H : ℝ} (hK : 0<K) (hD : 0≤D)
    (hp : 0≤p) (hg : 0≤g) (hgH : g≤H) (hbg : 1+g≤b)
    (hPole : (1/2:ℝ)*realRationalZeroKernel b (-g)≤realRationalZeroKernel b 0)
    (hMargin : realRationalZeroKernel b (-g)-realRationalZeroKernel b 0+
      (47/100:ℝ)+1/1000 < realRationalZeroKernel b (H-g)) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q)
      (σ β s t B T : ℝ), Real.log (q:ℝ)≤L → β≤σ → σ≤1 → (1-σ)*L≤ g →
      |s|≤L^p → |t|≤L^p → 1≤B → Real.log B≤D*Real.log L →
      PrimeTestWindow χ s σ T B L K (47/125) → PrimeTestWindow χ t σ T B L K (47/125) →
      PrimeTestWindow (χ*χ) (t+s) σ T B L K (47/125) →
      regularizedL χ (line σ s)=0 → regularizedL χ (line β t)=0 →
      line σ s≠line β t → H<(1-β)*L := by
  let ε : ℝ := 1/10000
  let M : ℝ := 1+b+2*b^2/3
  have hb : 0<b := by linarith only [hg,hbg]
  have hε : 0<ε := by norm_num [ε]
  obtain ⟨r,L₀,hr,hr32,hL₀,hN⟩ := rational_prime_test_sharp_with_window
    (κ:=1) (C:=b) hε (by norm_num) hb hK hD hb.le
  have hP := rational_prime_test_principal_upper_eventually (b:=b) (K:=H) (p:=p+1) hε hb
    (hg.trans hgH) (by positivity)
  have hLarge := eventually_ge_atTop (max (max 2 L₀) (max (H/r) (max (1/r) (M/(ε*r)))))
  filter_upwards [hP,hLarge] with L hP hL q _ χ σ β s t B T hq hβ hσ hlam hs ht hB hBL
    hχ hψ hsq hzχ hzψ hdist
  by_contra! hmu
  have hL2 : 2≤L := (le_max_left _ _).trans ((le_max_left _ _).trans hL)
  have hL' : L₀≤L := (le_max_right _ _).trans ((le_max_left _ _).trans hL)
  have hL0 : 0<L := zero_lt_one.trans_le (hL₀.trans hL')
  have hQ1 : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hR := (div_le_iff₀ hr).mp ((le_max_left _ _).trans ((le_max_right _ _).trans hL))
  have hR' : H≤r*L := by linarith only [hR,mul_comm L r]
  have hInv := (div_le_iff₀ hr).mp
    ((le_max_left _ _).trans ((le_max_right _ _).trans ((le_max_right _ _).trans hL)))
  have hBig := (div_le_iff₀ (mul_pos hε hr)).mp
    ((le_max_right _ _).trans ((le_max_right _ _).trans ((le_max_right _ _).trans hL)))
  have hShift : 1+1/L≤σ+b/L := by
    refine le_of_mul_le_mul_left ?_ hL0
    simp only [mul_add,mul_one,mul_div_cancel₀ _ hL0.ne']
    nlinarith only [hlam,hbg]
  have hShift' : 1<σ+b/L := (lt_add_of_pos_right _ (div_pos one_pos hL0)).trans_le hShift
  have hσL : 1-H/L≤σ := by
    have he := ((le_div_iff₀ hL0).mpr (hlam.trans hgH))
    linarith only [he]
  have hσU : σ≤1+H/L := hσ.trans (le_add_of_nonneg_right (div_nonneg (hg.trans hgH) hL0.le))
  have hHeight : |t-s|≤L^(p+1) := by
    rw [Real.rpow_add hL0,Real.rpow_one]
    calc
      _ ≤ |t|+|s| := abs_sub _ _
      _ ≤ L^p+L^p := add_le_add ht hs
      _ = L^p*2 := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hL2 (Real.rpow_nonneg hL0.le p)
  have hPr (u : ℝ) (hu : |u|≤L^(p+1)) :
      (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ u)).re≤
        L*(rationalZeroKernel b (((L*(σ-1):ℝ):ℂ)+((L*u:ℝ):ℂ)*I)).re+ε*L := by
    have hh := hP q (line σ u) hq (by simpa [line] using hσL) (by simpa [line] using hσU)
      (by simpa [line] using hu) (by simpa [line] using hShift')
    have he : line 1 0=1 := by simp [line]
    rw [←he,scaled_line_sub,sub_zero] at hh
    exact hh
  have hP0 := hPr 0 (by simpa using Real.rpow_nonneg hL0.le (p+1))
  have hPE := hPr (t-s) hHeight
  simp only [mul_zero,Complex.ofReal_zero,zero_mul,add_zero,rational_re_ofReal] at hP0
  have hLocal (η : DirichletCharacter ℂ q) (u : ℝ)
      (hη : PrimeTestWindow η u σ T B L K (47/125)) :
      ∃ V : Finset ℂ,
      (∀ ρ : ℂ, ‖ρ-line 1 u‖≤2*r → regularizedL η ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V →
        (rationalPrimeTest η b L (line σ u)).re≤(47/125:ℝ)*L/2+ε*L-
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL η) ρ:ℝ)*
            (rationalZeroKernel b ((L:ℂ)*(line σ u-ρ))).re := by
    obtain ⟨V,hV,hCov,hEst⟩ := hN q η hη.nonprincipal (s:=line σ u) (Q:=(q:ℝ)) hL'
      (by simpa [line] using hShift) (by simpa [line] using add_le_add_right hσ (b/L))
      (by simpa [line] using hη.height) (by simpa [line] using hη.logHeight_le)
      (by norm_num) hB hQ1 hBL hη.strip
    refine ⟨V,(by simpa [line] using hCov),?_⟩
    intro U hU
    have hDiscard (ρ : ℂ) (hρ : ρ∈V) (_ : ρ∉U) : ρ.re≤ (line σ u).re := by
      have hi := (Complex.abs_im_le_norm (ρ-line 1 u)).trans
        (show ‖ρ-line 1 u‖≤2*r by simpa [line] using (hV ρ hρ).2.2)
      have hw : |ρ.im-u|≤1 :=
        (show |ρ.im-u|≤2*r by simpa [line,Complex.sub_im] using hi).trans (by linarith only [hr32])
      simpa [line] using hη.leading ρ (hV ρ hρ).1 hw
    have hh := hEst U hU hDiscard
    have hq' := mul_le_mul_of_nonneg_left hq (show (0:ℝ)≤47/125 by norm_num)
    linarith only [hh,hq']
  have hGeo (x u : ℝ) (hx : x≤1) (hxL : (1-x)*L≤H) :
      ‖line x u-line 1 u‖≤r := by
    have he : line x u-line 1 u=((x-1:ℝ):ℂ) := by
      apply Complex.ext <;> simp [line,Complex.sub_re,Complex.sub_im]
    rw [he,Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (sub_nonpos.mpr hx)]
    apply le_of_mul_le_mul_right _ hL0
    nlinarith only [hxL,hR']
  obtain ⟨Vχ,hcovχ,hUpχ⟩ := hLocal χ s hχ
  obtain ⟨Vψ,hcovψ,hUpψ⟩ := hLocal χ t hψ
  obtain ⟨Vsq,_,hUpSq⟩ := hLocal (χ*χ) (t+s) hsq
  have hχGeo := hGeo σ s hσ (hlam.trans hgH)
  have hχMem := hcovχ _ (hχGeo.trans (by linarith only [hr])) hzχ
  have hψMem := hcovψ _ ((hGeo β t (hβ.trans hσ) hmu).trans (by linarith only [hr])) hzψ
  have hχEst := hUpχ {line σ s} (Finset.singleton_subset_iff.mpr hχMem)
  have hSqEst := hUpSq ∅ (Finset.empty_subset Vsq)
  have hχm : (1:ℝ)≤analyticOrderNatAt (regularizedL χ) (line σ s) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff χ _).mpr hzχ
  have hψm : (1:ℝ)≤analyticOrderNatAt (regularizedL χ) (line β t) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff χ _).mpr hzψ
  have hf0 : 0≤realRationalZeroKernel b 0 := by unfold realRationalZeroKernel; positivity
  have hδ : 0≤L*(σ-β) := mul_nonneg hL0.le (sub_nonneg.mpr hβ)
  have hfδ : 0≤realRationalZeroKernel b (L*(σ-β)) := by unfold realRationalZeroKernel; positivity
  have hχm' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hχm hf0) hL0.le
  have hψm' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hψm hfδ) hL0.le
  have hZero : (rationalZeroKernel b 0).re=realRationalZeroKernel b 0 := by
    simpa only [Complex.ofReal_zero] using rational_re_ofReal b 0
  simp only [Finset.sum_singleton,sub_self,mul_zero,hZero] at hχEst
  simp only [Finset.sum_empty,mul_zero,sub_zero] at hSqEst
  have hDirect :
      (rationalZeroKernel b ((L:ℂ)*(line σ t-line β t))).re=realRationalZeroKernel b (L*(σ-β)) := by
    rw [scaled_line_sub]
    simp only [sub_self,mul_zero,Complex.ofReal_zero,zero_mul,add_zero,rational_re_ofReal]
  let Z : ℂ := ((L*(σ-1):ℝ):ℂ)+((L*(t-s):ℝ):ℂ)*I
  change (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ (t-s))).re≤
    L*(rationalZeroKernel b Z).re+ε*L at hPE
  have hψEst :
      (rationalPrimeTest χ b L (line σ t)).re+
          (1/2:ℝ)*(rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ (t-s))).re
        ≤(47/125:ℝ)*L/2+(2*ε)*L-L*realRationalZeroKernel b (L*(σ-β)) := by
    by_cases hClose : |t-s|≤r
    · have hTGeo : ‖line σ s-line 1 t‖≤2*r := by
        have he : line 1 s-line 1 t=((s-t:ℝ):ℂ)*I := by
          apply Complex.ext <;> simp [line,Complex.sub_re,Complex.sub_im]
        rw [←sub_add_sub_cancel (line σ s) (line 1 s) (line 1 t)]
        refine (norm_add_le _ _).trans ?_
        have hSide : ‖line 1 s-line 1 t‖≤r := by
          rw [he,norm_mul,Complex.norm_I,mul_one,Complex.norm_real,Real.norm_eq_abs,abs_sub_comm]
          exact hClose
        simpa only [two_mul] using add_le_add hχGeo hSide
      have hχMem' := hcovψ _ hTGeo hzχ
      have hSub : {line σ s,line β t}⊆Vψ :=
        Finset.insert_subset_iff.mpr ⟨hχMem',Finset.singleton_subset_iff.mpr hψMem⟩
      have hBoth := hUpψ {line σ s,line β t} hSub
      rw [Finset.sum_insert (by simpa using hdist),Finset.sum_singleton,hDirect] at hBoth
      have hRoom0 :
          (1/2:ℝ)*realRationalZeroKernel b (-((1-σ)*L))≤realRationalZeroKernel b 0 :=
        (mul_le_mul_of_nonneg_left
          (realRationalZeroKernel_antitone hb (by linarith only [hbg]) (by linarith only [hlam]))
          (by norm_num)).trans hPole
      have hComp := rational_principal_resolvent_dominated (d:=1) (t:=L*(t-s)) hb
        (mul_nonneg (sub_nonneg.mpr hσ) hL0.le)
        (show (1-σ)*L<b by linarith only [hlam,hbg]) (by norm_num : (0:ℝ)≤1/2)
        (by simpa only [one_mul] using hRoom0)
      have hF : (L:ℂ)*(line σ t-line σ s)=((L*(t-s):ℝ):ℂ)*I := by
        rw [scaled_line_sub]
        simp
      rw [hF] at hBoth
      have he : -((1-σ)*L)=L*(σ-1) := by ring
      simp only [he,one_mul] at hComp
      change (1/2:ℝ)*(rationalZeroKernel b Z).re≤
        (rationalZeroKernel b (((L*(t-s):ℝ):ℂ)*I)).re at hComp
      have hK0 := rationalZeroKernel_re_nonneg (b:=b) (x:=0) (t:=L*(t-s)) hb (le_refl 0)
      simp only [Complex.ofReal_zero,zero_add] at hK0
      have hχExtra := (mul_le_mul_of_nonneg_right hχm hK0)
      simp only [one_mul] at hχExtra
      have hRoom := mul_le_mul_of_nonneg_left (hComp.trans hχExtra) hL0.le
      have hSum := add_le_add hBoth (mul_le_mul_of_nonneg_left hPE (by norm_num : (0:ℝ)≤1/2))
      have hεL := mul_nonneg hε.le hL0.le
      linear_combination hSum+hRoom+hψm'+(1/2:ℝ)*hεL
    · have hY : |Z.im|=L*|t-s| := by
        simp [Z,Complex.add_im,Complex.mul_im,abs_mul,abs_of_nonneg hL0.le]
      have hGt := mul_lt_mul_of_pos_left (lt_of_not_ge hClose) hL0
      have hY1 : 1≤|Z.im| := by rw [hY]; linarith only [hGt,hInv]
      have hM : M/|Z.im|≤ε := by
        refine (div_le_iff₀ (zero_lt_one.trans_le hY1)).mpr ?_
        rw [hY]
        nlinarith only [hBig,mul_le_mul_of_nonneg_left hGt.le hε.le]
      have hTiny := mul_le_mul_of_nonneg_left ((rational_re_le_large_ordinate hb.le Z hY1).trans hM) hL0.le
      have hOne := hUpψ {line β t} (Finset.singleton_subset_iff.mpr hψMem)
      rw [Finset.sum_singleton,hDirect] at hOne
      have hSum := add_le_add hOne (mul_le_mul_of_nonneg_left hPE (by norm_num : (0:ℝ)≤1/2))
      linear_combination hSum+(1/2:ℝ)*hTiny+hψm'
  have hPos := pair_rational_primeTest_nonneg χ χ (s:=t) (t:=s) hb hL0 hShift'
  rw [mul_inv_cancel] at hPos
  have hBound : realRationalZeroKernel b (L*(σ-β))≤
      realRationalZeroKernel b (L*(σ-1))-realRationalZeroKernel b 0+47/100+(9/2)*ε := by
    refine le_of_mul_le_mul_left ?_ hL0
    have hPos' : 0≤
        (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re+
        ((rationalPrimeTest χ b L (line σ t)).re+
          (1/2:ℝ)*(rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ (t-s))).re)+
        (rationalPrimeTest χ b L (line σ s)).re+
        (1/2:ℝ)*(rationalPrimeTest (χ*χ) b L (line σ (t+s))).re := by linarith only [hPos]
    have hUχ : (rationalPrimeTest χ b L (line σ s)).re≤
        (47/125:ℝ)*L/2+ε*L-L*realRationalZeroKernel b 0 := by linarith only [hχEst,hχm']
    have hSum := add_le_add (add_le_add (add_le_add hP0 hψEst) hUχ)
      (mul_le_mul_of_nonneg_left hSqEst (by norm_num : (0:ℝ)≤1/2))
    have hTotal := hPos'.trans hSum
    ring_nf at hTotal ⊢
    linarith only [hTotal]
  have hAux : realRationalZeroKernel b ((1-β)*L-(1-σ)*L)≤
      realRationalZeroKernel b (-((1-σ)*L))-realRationalZeroKernel b 0+47/100+(9/2)*ε := by
    rwa [show (1-β)*L-(1-σ)*L=L*(σ-β) by ring,show -((1-σ)*L)=L*(σ-1) by ring]
  have hBnd : realRationalZeroKernel b ((1-β)*L-(1-σ)*L)≤
      realRationalZeroKernel b (-((1-σ)*L))-realRationalZeroKernel b 0+((47/100:ℝ)+1/1000) := by
    norm_num [ε] at hAux ⊢
    linarith only [hAux]
  exact (not_lt_of_ge hmu) (rational_gap_certificate_of_margin hb (by linarith only [hbg])
    (hg.trans hgH) (by linarith only [hMargin]) hlam
    (mul_le_mul_of_nonneg_right (show 1-σ≤1-β by linarith only [hβ]) hL0.le) hBnd)


end

