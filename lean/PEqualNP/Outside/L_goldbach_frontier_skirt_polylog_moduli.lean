  have hp := Vlk F
    (fun χ y => ∑ i∈S χ, Ve y h ((V1 χ).zeros i))
    X (D*(Q : ℝ)^2*X^(1/2 : ℝ)*(Real.log X)^2) hXp.le (by positivity)
