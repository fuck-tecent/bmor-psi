  have hmuH : μ≤ H := hmu.trans hLog
  have hL0 : 0<L := zero_lt_one.trans_le hL
  have hmu0 : 0≤ μ := mul_nonneg (sub_nonneg.mpr (hβ.trans hσ)) hL0.le
  have hβL : 1-H/L≤ β := by
    have he : 1-β≤ H/L := (le_div_iff₀ hL0).mpr hmuH
    linarith only [he]
