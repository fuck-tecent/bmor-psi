namespace GoldbachTypeII

open Finset


noncomputable def cubicWeight (t γ : ℝ) : ℝ :=
  1 / (1 + |γ - t|) ^ 3


end GoldbachTypeII


namespace GoldbachTypeII

open Complex Set Filter MeasureTheory GoldbachCubicRiesz

theorem symbol_left_bound {a t : ℝ} (ha₀ : -(1 / 2 : ℝ) ≤ a) (ha₁ : a ≤ -(1 / 4 : ℝ)) :
    ‖symbol ((a : ℂ) + t * I)‖ ≤ 250 / (1 + |t|) ^ 3 := by
  let w : ℂ := (a : ℂ) + t * I
  have hwRe : w.re = a := by simp [w, Complex.mul_re]
  have hwIm : w.im = t := by simp [w, Complex.mul_im]
  have h0 : (1 / 4 : ℝ) ≤ ‖w‖ := by
    have h := Complex.abs_re_le_norm w
    rw [hwRe, abs_of_nonpos (by linarith : a ≤ 0)] at h
    linarith
  have h1 : (1 / 4 : ℝ) ≤ ‖w + 1‖ := by
    have h := Complex.re_le_norm (w + 1)
    simp only [Complex.add_re, Complex.one_re, hwRe] at h
    linarith
  have h2 : (1 / 4 : ℝ) ≤ ‖w + 2‖ := by
    have h := Complex.re_le_norm (w + 2)
    norm_num [Complex.add_re, hwRe] at h
    linarith
  have hi₀ : |t| ≤ ‖w‖ := by simpa [hwIm] using Complex.abs_im_le_norm w
  have hi₁ : |t| ≤ ‖w + 1‖ := by simpa [hwIm] using Complex.abs_im_le_norm (w + 1)
  have hi₂ : |t| ≤ ‖w + 2‖ := by simpa [hwIm] using Complex.abs_im_le_norm (w + 2)
  have hn₀ : 1 + |t| ≤ 5 * ‖w‖ := by linarith
  have hn₁ : 1 + |t| ≤ 5 * ‖w + 1‖ := by linarith
  have hn₂ : 1 + |t| ≤ 5 * ‖w + 2‖ := by linarith
  have hp : (1 + |t|)^3 ≤ 125 * (‖w‖ * ‖w + 1‖ * ‖w + 2‖) := by
    rw [pow_succ, pow_two]
    exact (mul_le_mul (mul_le_mul hn₀ hn₁ (by positivity) (by positivity)) hn₂
      (by positivity) (by positivity)).trans_eq (by ring)
  have hp₀ : 0 < ‖w‖ * ‖w + 1‖ * ‖w + 2‖ := by
    exact mul_pos (mul_pos (by linarith) (by linarith)) (by linarith)
  change ‖symbol w‖ ≤ _
  rw [symbol, norm_div, norm_mul, norm_mul, Complex.norm_ofNat]
  exact (div_le_div_iff₀ hp₀ (by positivity)).mpr (by linarith only [hp])

noncomputable def criticalMollified {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (D : ℕ)
    (t : ℝ) : ℂ :=
  let s : ℂ := ((1 / 2 : ℝ) : ℂ) + (t : ℂ) * I
  χ.LFunction s * mollifier D χ s


end GoldbachTypeII


namespace GoldbachCubicRiesz

open Complex

/-- Linear growth of a nonprincipal Dirichlet L-function on the right
half-plane, from its centered character-sum representation. -/
theorem nonprincipal_LFunction_norm_le {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1) {s : ℂ} (hs : (1 / 2 : ℝ) ≤ s.re) :
    ‖χ.LFunction s‖ ≤ 6 * (q : ℝ) * ‖s‖ := by
  have hs₀ : 0 < s.re := by linarith
  have hM : ‖GoldbachGrhGrowth.remainderMellin χ s‖ ≤ 6 * (q : ℝ) := by
    calc
      _ ≤ (3 * (q : ℝ)) / s.re := GoldbachGrhGrowth.norm_remainderMellin_le χ hs₀
      _ ≤ (3 * (q : ℝ)) / (1 / 2 : ℝ) :=
        div_le_div_of_nonneg_left (by positivity) (by norm_num) hs
      _ = _ := by ring
  rw [GoldbachGrhGrowth.LFunction_eq_remainderMellin χ hχ hs₀, norm_mul]
  exact (mul_le_mul_of_nonneg_left hM (norm_nonneg s)).trans_eq (mul_comm _ _)

/-- Uniform linear growth on horizontal edges for the shifted L-function
times a multiplier bounded in the same half-plane. -/
theorem shifted_product_linear_growth {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχ : χ ≠ 1) (ρ : ℂ) (M : ℂ → ℂ) {B A : ℝ} (hB : 0 ≤ B) (hA : 0 ≤ A)
    (hM : ∀ s, (1 / 2 : ℝ) ≤ s.re → ‖M s‖ ≤ B)
    {x t : ℝ} (hx : |x| ≤ A) (hσ : (1 / 2 : ℝ) ≤ ρ.re + x) :
    ‖χ.LFunction (ρ + ((x : ℂ) + t * I)) * M (ρ + ((x : ℂ) + t * I))‖ ≤
      (6 * (q : ℝ) * (1 + ‖ρ‖ + A) * B) * (1 + |t|) := by
  let s := ρ + ((x : ℂ) + t * I)
  have hs : (1 / 2 : ℝ) ≤ s.re := by
    simpa [s, Complex.add_re, Complex.mul_re] using hσ
  have hbound : ‖s‖ ≤ (1 + ‖ρ‖ + A) * (1 + |t|) := by
    calc
      _ ≤ ‖ρ‖ + ‖(x : ℂ) + t * I‖ := norm_add_le _ _
      _ ≤ ‖ρ‖ + (|x| + |t|) := by
        apply add_le_add_right
        simpa [norm_mul, Complex.norm_real, Real.norm_eq_abs] using
          (norm_add_le (x : ℂ) ((t : ℂ) * I))
      _ ≤ ‖ρ‖ + (A + |t|) := by exact add_le_add_right (add_le_add_left hx _) _
      _ ≤ _ := by
        nlinarith only [mul_nonneg (add_nonneg (norm_nonneg ρ) hA) (abs_nonneg t)]
  rw [norm_mul]
  calc
    _ ≤ (6 * (q : ℝ) * ‖s‖) * B :=
      mul_le_mul (nonprincipal_LFunction_norm_le hχ hs) (hM s hs)
        (norm_nonneg _) (by positivity)
    _ ≤ (6 * (q : ℝ) * ((1 + ‖ρ‖ + A) * (1 + |t|))) * B :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hbound (by positivity)) hB
    _ = _ := by ring

end GoldbachCubicRiesz

namespace GoldbachTypeII

open Complex Filter MeasureTheory GoldbachCubicRiesz

set_option maxHeartbeats 800000 in
theorem weighted_criticalMollified_integrable {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1) (D : ℕ) (γ : ℝ) :
    Integrable (fun u => cubicWeight u γ * ‖criticalMollified χ D u‖) := by
  let C : ℝ := (6 * (q : ℝ) * (2 * Real.sqrt D)) * (1 + |γ|)
  have hI : Integrable (fun u : ℝ => C * (1 + (u - γ)^2)⁻¹) := by
    have hp := measurePreserving_sub_right (volume : Measure ℝ) γ
    apply Integrable.const_mul _ C
    change Integrable ((fun x : ℝ => (1 + x^2)⁻¹) ∘ fun x => x - γ)
    exact hp.integrable_comp_of_integrable integrable_inv_one_add_sq
  have hc : Continuous (criticalMollified χ D) := by
    change Continuous ((fun s => χ.LFunction s * mollifier D χ s) ∘ fun t : ℝ =>
      ((1 / 2 : ℝ) : ℂ) + (t : ℂ) * I)
    exact ((DirichletCharacter.differentiable_LFunction hχ).continuous.mul
      (mollifier_differentiable D χ).continuous).comp (by fun_prop)
  have hm : Continuous (fun u => cubicWeight u γ * ‖criticalMollified χ D u‖) := by
    apply Continuous.mul _ hc.norm
    unfold cubicWeight
    have hden : Continuous (fun u : ℝ => (1 + |γ - u|) ^ 3) := by fun_prop
    have hdn (u : ℝ) : (1 + |γ - u|) ^ 3 ≠ 0 :=
      pow_ne_zero 3 (ne_of_gt (show (0 : ℝ) < 1 + |γ - u| by positivity))
    exact continuous_const.div hden hdn
  apply hI.mono' hm.aestronglyMeasurable
  apply Eventually.of_forall
  intro u
  let B : ℝ := 6 * (q : ℝ) * (2 * Real.sqrt D)
  have hB : 0 ≤ B := by positivity
  have hu : |u| ≤ |u - γ| + |γ| := by
    have h := abs_add_le (u - γ) γ
    rwa [sub_add_cancel] at h
  have hlinear : ‖criticalMollified χ D u‖ ≤ B * (1 + |u|) := by
    let s : ℂ := ((1 / 2 : ℝ) : ℂ) + (u : ℂ) * I
    have hs : (1 / 2 : ℝ) ≤ s.re := by simp [s, Complex.mul_re]
    have hsn : ‖s‖ ≤ 1 + |u| := by
      apply (norm_add_le _ _).trans
      rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real,
        Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
      linarith
    change ‖χ.LFunction s * mollifier D χ s‖ ≤ _
    rw [norm_mul]
    calc
      _ ≤ (6 * (q : ℝ) * ‖s‖) * (2 * Real.sqrt D) :=
        mul_le_mul (nonprincipal_LFunction_norm_le hχ hs) (norm_mollifier_le D χ hs)
          (norm_nonneg _) (by positivity)
      _ ≤ (6 * (q : ℝ) * (1 + |u|)) * (2 * Real.sqrt D) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsn (by positivity)) (by positivity)
      _ = B * (1 + |u|) := by dsimp [B]; ring
  have hmul : 1 + |u| ≤ (1 + |γ|) * (1 + |u - γ|) := by
    nlinarith only [hu, mul_nonneg (abs_nonneg γ) (abs_nonneg (u - γ))]
  have hden : 1 + (u - γ)^2 ≤ (1 + |u - γ|)^2 := by
    rw [(sq_abs (u - γ)).symm]
    nlinarith only [abs_nonneg (u - γ)]
  have hpos : 0 < 1 + |u - γ| := by positivity
  rw [Real.norm_of_nonneg (by unfold cubicWeight; positivity)]
  calc
    _ ≤ cubicWeight u γ * (B * ((1 + |γ|) * (1 + |u - γ|))) := by
      exact mul_le_mul_of_nonneg_left (hlinear.trans (mul_le_mul_of_nonneg_left hmul hB))
        (by unfold cubicWeight; positivity)
    _ = C / (1 + |u - γ|)^2 := by
      unfold cubicWeight
      rw [abs_sub_comm γ u]
      dsimp [C, B]
      field_simp
    _ ≤ _ := by
      rw [div_eq_mul_inv]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      exact inv_anti₀ (by positivity) hden

end GoldbachTypeII


