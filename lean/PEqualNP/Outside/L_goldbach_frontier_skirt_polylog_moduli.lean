namespace Viu
open Vhy Vbt
structure ShortWindowParameters (B : ℕ) (X Q h : ℝ) (K : ℕ) : Prop where
  X_ge_four : 4≤X
  log_ge_one : 1≤Real.log X
  delta_ge_one : 1≤X^(1/12 : ℝ)
  Vhv : X^(1/12 : ℝ)≤X/2
  height_ge_two : 2≤(2 : ℝ)^(K+1)
  height_ge_rpow : X^(3/2 : ℝ)≤(2 : ℝ)^(K+1)
  height_le_twice_rpow : (2 : ℝ)^(K+1)≤2*X^(3/2 : ℝ)
  height_le_square : (2 : ℝ)^(K+1)≤X^2
  height_log : Real.log (Q*(2 : ℝ)^(K+1))≤2*Real.log X
  scale : Q^2/(h/X)≤X^(5/12 : ℝ)
  boundary_budget : X^(1/12 : ℝ)*Q^4*X^2*(Real.log X)^4≤h^2*X/(Real.log X)^B
  residual_budget :
    (X^(1/12 : ℝ)*Real.log X + Real.sqrt X*Real.log X/X^(1/12 : ℝ) +
      Q^2*X^2*Real.log (Q*(2 : ℝ)^(K+1))/(X^(1/12 : ℝ)*(2 : ℝ)^(K+1)))^2*X≤
        12*(h^2*X/(Real.log X)^B)
  height_log_plus_two :
    Real.log (Q*((2 : ℝ)^(K+1)+2))≤2*Real.log (Q*(2 : ℝ)^(K+1))
theorem V135 (B : ℕ) :
    ∃ X₀ : ℝ,∀ X Q h : ℝ,X₀≤X → 1≤Q → Q≤2*(Real.log X)^24 →
      0<h → Q^2*X^(7/12 : ℝ)≤h →
      ∃ K : ℕ,ShortWindowParameters B X Q h K := by
  obtain ⟨Xold,hold⟩ := V1lp B
  refine ⟨max Xold 4,?_⟩
  intro X Q h hX hQ hQX hh hlower
  have hXold : Xold≤X := (le_max_left _ _).trans hX
  have hX4 : 4≤X := (le_max_right _ _).trans hX
  have hX1 : 1≤X := by linarith
  have hXp : 0<X := by linarith
  have hL : 1≤Real.log X := by
    apply (Real.le_log_iff_exp_le hXp).2
    exact Real.exp_one_lt_three.le.trans (by linarith)
  have hscale := V20w hXp hh hlower
  obtain ⟨j,hδ1,hδX,hUlo,hUhi,hU2,hlog,hboundary,hsecondOld,hthird,hfirstOld⟩ :=
    hold X Q h hXold hQ hQX hh hscale
  have hδhalf := Vhv X hX4
  have hXpow : X≤X^(3/2 : ℝ) := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hX1
      (by norm_num : (1 : ℝ)≤3/2)
  have hUmin : 2≤(2 : ℝ)^j := by linarith
  have hfirst : (X^(1/12 : ℝ)*Real.log X)^2*X≤h^2*X/(Real.log X)^B := by
    simpa only [mul_pow] using hfirstOld
  have hsecond : (Real.sqrt X*Real.log X/X^(1/12 : ℝ))^2*X≤
      h^2*X/(Real.log X)^B :=
    (V1hi hX1 hL hQ hδ1).trans hboundary
  have hres9 := V1ul X (X^(1/12 : ℝ)*Real.log X)
    (Real.sqrt X*Real.log X/X^(1/12 : ℝ))
    (Q^2*X^2*Real.log (Q*(2 : ℝ)^j)/(X^(1/12 : ℝ)*(2 : ℝ)^j))
    (h^2*X/(Real.log X)^B) hXp.le hfirst hsecond hthird
  have hres12 :
      (X^(1/12 : ℝ)*Real.log X + Real.sqrt X*Real.log X/X^(1/12 : ℝ) +
        Q^2*X^2*Real.log (Q*(2 : ℝ)^j)/(X^(1/12 : ℝ)*(2 : ℝ)^j))^2*X≤
          12*(h^2*X/(Real.log X)^B) := by
    apply hres9.trans
    have hnonneg : 0≤h^2*X/(Real.log X)^B := by positivity
    linarith
  cases j with
  | zero => norm_num at hUmin
  | succ K =>
    refine ⟨K,{
      X_ge_four := hX4
      log_ge_one := hL
      delta_ge_one := hδ1
      Vhv := hδhalf
      height_ge_two := hUmin
      height_ge_rpow := hUlo
      height_le_twice_rpow := hUhi
      height_le_square := hU2
      height_log := hlog
      scale := hscale
      boundary_budget := hboundary
      residual_budget := hres12
      height_log_plus_two := V14r Q ((2 : ℝ)^(K+1)) hQ hUmin
    }⟩
end Viu
