theorem V189 (χ : PrimitiveComplexCharacter) (n : ℕ) :
    ‖Vl χ n‖≤Real.log (n : ℝ) := by
  rw [Vl,norm_mul,Complex.norm_real,Real.norm_of_nonneg vonMangoldt_nonneg]
