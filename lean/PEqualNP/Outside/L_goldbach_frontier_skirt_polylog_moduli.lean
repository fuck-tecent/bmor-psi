section
namespace Viu
theorem V20w {X Q h : ℝ} (hX : 0<X) (hh : 0<h)
    (hlower : Q^2*X^(7/12 : ℝ)≤h) :
    Q^2/(h/X)≤X^(5/12 : ℝ) := by
  have hid : X^(5/12 : ℝ)*X^(7/12 : ℝ)=X := by
    rw [← Real.rpow_add hX]
    norm_num
  apply (div_le_iff₀ (div_pos hh hX)).2
  rw [← mul_div_assoc]
  apply (le_div_iff₀ hX).2
  calc
    _ = X^(5/12 : ℝ)*(Q^2*X^(7/12 : ℝ)) := by
      calc
        _ = Q^2*(X^(5/12 : ℝ)*X^(7/12 : ℝ)) := by rw [hid]
        _ = _ := by ring
    _ ≤ X^(5/12 : ℝ)*h :=
      mul_le_mul_of_nonneg_left hlower (Real.rpow_nonneg hX.le _)
theorem Vhv (X : ℝ) (hX : 4≤X) :
    X^(1/12 : ℝ)≤X/2 := by
  have hX1 : 1≤X := by linarith
  have hs : X^(1/12 : ℝ)≤Real.sqrt X := by
    rw [Real.sqrt_eq_rpow]
    exact Real.rpow_le_rpow_of_exponent_le hX1 (by norm_num)
  apply hs.trans
  apply Real.sqrt_le_iff.mpr
  constructor
  · linarith
  · nlinarith [mul_nonneg (by linarith : 0≤X) (by linarith : 0≤X-4)]
theorem V1hi {X Q δ : ℝ}
    (hX : 1≤X) (hL : 1≤Real.log X) (hQ : 1≤Q) (hδ : 1≤δ) :
    (Real.sqrt X*Real.log X/δ)^2*X≤δ*Q^4*X^2*(Real.log X)^4 := by
  have hXp : 0<X := by linarith
  have hδ2 : 1≤δ^2 := one_le_pow₀ hδ
  have hQ4 : 1≤Q^4 := one_le_pow₀ hQ
  have hL24 : (Real.log X)^2≤(Real.log X)^4 :=
    pow_le_pow_right₀ hL (by decide)
  have hid : (Real.sqrt X*Real.log X/δ)^2*X=X^2*(Real.log X)^2/δ^2 := by
    rw [div_pow,mul_pow,Real.sq_sqrt hXp.le]
    ring
  rw [hid]
  calc
    _ ≤ X^2*(Real.log X)^2 := div_le_self (by positivity) hδ2
    _ ≤ (δ*Q^4)*(X^2*(Real.log X)^2) :=
      le_mul_of_one_le_left (by positivity) (one_le_mul_of_one_le_of_one_le hδ hQ4)
    _ = δ*Q^4*X^2*(Real.log X)^2 := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hL24 (by positivity)
theorem V1ul (X a b c R : ℝ) (hX : 0≤X)
    (ha : a^2*X≤R) (hb : b^2*X≤R) (hc : c^2*X≤R) :
    (a+b+c)^2*X≤9*R := by
  have hthree : (a+b+c)^2≤3*(a^2+b^2+c^2) := by
    nlinarith [sq_nonneg (a-b),sq_nonneg (b-c),sq_nonneg (c-a)]
  calc
    _ ≤ (3*(a^2+b^2+c^2))*X := mul_le_mul_of_nonneg_right hthree hX
    _ = 3*(a^2*X+b^2*X+c^2*X) := by ring
    _ ≤ _ := by linarith
end Viu
end

