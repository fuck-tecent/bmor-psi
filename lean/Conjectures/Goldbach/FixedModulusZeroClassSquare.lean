noncomputable section

/-- The disk factor that removes one zero and preserves the boundary modulus. -/
def diskZeroFactor (R : ℝ) (a z : ℂ) : ℂ :=
  (R:ℂ)*(z-a)/((R:ℂ)^2-conj a*z)

theorem diskZeroFactor_denom_ne {R : ℝ} (hR : 0<R) {a z : ℂ} (ha : ‖a‖<R) (hz : ‖z‖≤R) :
    (R:ℂ)^2-conj a*z ≠ 0 := by
  intro he
  have h := congrArg norm (sub_eq_zero.mp he)
  rw [norm_pow,norm_mul,Complex.norm_conj,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hR] at h
  have h1 := mul_le_mul_of_nonneg_left hz (norm_nonneg a)
  have h2 := mul_lt_mul_of_pos_right ha hR
  nlinarith only [h,h1,h2]

/-- A disk zero factor has exactly unit modulus on the boundary. -/
theorem diskZeroFactor_norm_boundary {R : ℝ} (hR : 0<R) {a z : ℂ} (ha : ‖a‖<R) (hz : ‖z‖=R) :
    ‖diskZeroFactor R a z‖=1 := by
  have he : (R:ℂ)^2-conj a*z = conj (z-a)*z := by
    rw [map_sub,sub_mul,Complex.conj_mul',hz]
  have hn : z-a ≠ 0 := by
    intro h
    have he := congrArg norm (sub_eq_zero.mp h)
    rw [hz] at he
    exact (ne_of_lt ha).symm he
  rw [diskZeroFactor,he,norm_div,norm_mul,norm_mul,Complex.norm_conj,Complex.norm_real,Real.norm_eq_abs,
    abs_of_pos hR,hz,mul_comm R]
  exact div_self (mul_ne_zero (norm_ne_zero_iff.mpr hn) hR.ne')

/-- Exact logarithmic derivative of a disk factor at its center. -/
theorem diskZeroFactor_logDeriv_zero {R : ℝ} (hR : 0<R) {a : ℂ} (ha : a≠0) :
    logDeriv (diskZeroFactor R a) (0:ℂ) = -(1/a)+conj a/(R:ℂ)^2 := by
  have hRc : (R:ℂ) ≠ 0 := by exact_mod_cast hR.ne'
  let n : ℂ→ℂ := fun z => z-a
  let d : ℂ→ℂ := fun z => (R:ℂ)^2-conj a*z
  have hn : n 0≠0 := by simpa [n] using ha
  have hd : d 0≠0 := by simpa [d] using pow_ne_zero 2 hRc
  have hnd : HasDerivAt n 1 0 := (hasDerivAt_id (0:ℂ)).sub_const _
  have hdd : HasDerivAt d (-conj a) (0:ℂ) := by
    have hlin : HasDerivAt (fun z : ℂ => (-conj a)*z) (-conj a) (0:ℂ) := by
      simpa only [id_eq,mul_one] using (hasDerivAt_id' (0:ℂ)).const_mul (-conj a)
    convert hlin.add_const ((R:ℂ)^2) using 1
    ext z
    dsimp [d]
    ring
  have he : diskZeroFactor R a = fun z => (R:ℂ)*(n z/d z) := by
    funext z
    simp only [diskZeroFactor,n,d,mul_div_assoc]
  rw [he,logDeriv_const_mul _ _ hRc,logDeriv_fun_div _ hn hd hnd.differentiableAt hdd.differentiableAt,
    logDeriv_apply,logDeriv_apply,hnd.deriv,hdd.deriv]
  simp [n,d,neg_div]

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Real Set Metric Filter MeasureTheory Finset intervalIntegral
open scoped Topology ComplexConjugate Classical

noncomputable section

private theorem integral_negative_cos_sq_full :
    (∫ t in 0..2*Real.pi, (max 0 (-Real.cos t))^2) = Real.pi/2 := by
  let w : ℝ→ℝ := fun t => (max 0 (-Real.cos t))^2
  have hp : Function.Periodic w (2*Real.pi) := fun t => by simp [w]
  have hi := hp.intervalIntegral_add_eq 0 (-Real.pi)
  simpa only [zero_add,show -Real.pi+2*Real.pi=Real.pi by ring,w,integral_negative_cos_sq] using hi

private theorem growth_cosine_full {R φ ℓ E : ℝ} (hR : 0<R) (_hφ : 0≤φ)
    (_hℓ : 0≤ℓ) (hE : 0≤E) (u : ℝ→ℝ)
    (hu : ContinuousOn u (Set.uIcc 0 (2*Real.pi)))
    (hpos : ∀ t, 0≤Real.cos t → -E≤u t)
    (hneg : ∀ t, Real.cos t≤0 → u t≤φ*R*ℓ*(-Real.cos t)+E) :
    (∫ t in 0..2*Real.pi, (-Real.cos t)*u t)/(Real.pi*R) ≤ φ*ℓ/2+2*E/R := by
  let w : ℝ→ℝ := fun t => (max 0 (-Real.cos t))^2
  have hw : Continuous w := by dsimp only [w]; fun_prop
  have hs : (∫ t in 0..2*Real.pi, (-Real.cos t)*u t) ≤
      ∫ t in 0..2*Real.pi, φ*R*ℓ*w t+E := by
    apply intervalIntegral.integral_mono_on (by positivity)
    · exact (Real.continuous_cos.neg.continuousOn.fun_mul hu).intervalIntegrable
    · exact ((hw.const_mul _).add continuous_const).intervalIntegrable _ _
    · intro t _
      by_cases ht : 0≤Real.cos t
      · have h1 := mul_le_mul_of_nonpos_left (hpos t ht) (neg_nonpos.mpr ht)
        have h2 := mul_le_mul_of_nonneg_right (Real.cos_le_one t) hE
        simp only [w,max_eq_left (neg_nonpos.mpr ht),zero_pow (by decide : (2:ℕ)≠0),mul_zero,zero_add]
        nlinarith only [h1,h2]
      · have ht' := le_of_not_ge ht
        have h1 := mul_le_mul_of_nonneg_left (hneg t ht') (neg_nonneg.mpr ht')
        have h2 := mul_le_mul_of_nonneg_right (Real.neg_one_le_cos t) hE
        simp only [w,max_eq_right (neg_nonneg.mpr ht')]
        nlinarith only [h1,h2]
  have hI : (∫ t in 0..2*Real.pi, φ*R*ℓ*w t+E) =
      φ*R*ℓ*(Real.pi/2)+2*Real.pi*E := by
    rw [intervalIntegral.integral_add ((hw.const_mul _).intervalIntegrable _ _) intervalIntegrable_const,
      intervalIntegral.integral_const_mul,
      show (∫ t in 0..2*Real.pi, w t)=Real.pi/2 from integral_negative_cos_sq_full,
      intervalIntegral.integral_const]
    simp only [smul_eq_mul]
    ring
  refine (div_le_div_of_nonneg_right (hs.trans_eq hI) (by positivity)).trans_eq ?_
  field_simp [Real.pi_ne_zero,hR.ne']

set_option maxHeartbeats 800000 in
private theorem blaschke_analytic {R : ℝ} (hR : 0<R)
    {a : ℂ} (ha : ‖a‖<R) {z : ℂ} (hz : ‖z‖≤R) :
    AnalyticAt ℂ (diskZeroFactor R a) z := by
  have hn : AnalyticAt ℂ (fun w : ℂ => (R:ℂ)*(w-a)) z := by fun_prop
  have hd : AnalyticAt ℂ (fun w : ℂ => (R:ℂ)^2-conj a*w) z := by fun_prop
  exact hn.fun_div hd (diskZeroFactor_denom_ne hR ha hz)

private theorem blaschke_real_logDeriv_nonneg {R : ℝ} (hR : 0<R)
    {a : ℂ} (ha : a≠0) (haR : ‖a‖<R) (haRe : a.re≤0) :
    0≤(logDeriv (diskZeroFactor R a) 0).re := by
  rw [diskZeroFactor_logDeriv_zero hR ha,Complex.add_re,Complex.neg_re,
    Complex.div_re,Complex.one_re,Complex.one_im,one_mul,zero_mul,zero_div,add_zero]
  have hre : ((conj a)/(R:ℂ)^2).re = a.re/R^2 := by
    rw [←Complex.ofReal_pow, div_ofReal_re, Complex.conj_re]
  rw [hre,Complex.normSq_eq_norm_sq,←neg_div]
  have hR2 : 0<R^2 := by positivity
  have ha2 : 0<‖a‖^2 := by positivity [norm_pos_iff.mpr ha]
  have hcmp : ‖a‖^2≤R^2 := pow_le_pow_left₀ (norm_nonneg _) haR.le _
  have hnonneg := div_le_div_of_nonneg_left (neg_nonneg.mpr haRe) ha2 hcmp
  rw [neg_div] at hnonneg
  linarith only [hnonneg]

set_option maxHeartbeats 1000000 in
/-- Exact Heath-Brown local disk estimate after removing the zeros by disk
factors. The selected zeros pay only their distance from the center divided
by the square of the disk radius. -/
theorem logDeriv_sharp_of_diskFactorization
    {f G : ℂ→ℂ} {R φ ℓ E δ : ℝ} (hR : 0<R) (hφ : 0≤φ) (hℓ : 0≤ℓ)
    (hE : 0≤E) (hδ : 0≤δ)
    (Z V : Finset ℂ) (m : ℂ→ℕ) (hVZ : V ⊆ Z)
    (hGa : AnalyticOnNhd ℂ G (closedBall 0 R))
    (hGn : ∀ z∈closedBall (0:ℂ) R, G z≠0)
    (hZ : ∀ a∈Z, a≠0 ∧ ‖a‖<R ∧ a.re≤0)
    (hV : ∀ a∈V, ‖a‖≤δ)
    (hfactor : ∀ z∈closedBall (0:ℂ) R,
      f z=G z*(∏ a∈Z,diskZeroFactor R a z^m a))
    (hpos : ∀ t, 0≤Real.cos t → -E≤Real.log ‖f (circleMap 0 R t)‖)
    (hneg : ∀ t, Real.cos t≤0 →
      Real.log ‖f (circleMap 0 R t)‖≤φ*R*ℓ*(-Real.cos t)+E) :
    (-logDeriv f 0).re ≤ φ*ℓ/2+2*E/R + (δ/R^2)*(∑ a∈V,(m a:ℝ)) -
      ∑ a∈V,(m a:ℝ)*(-(1/a)).re := by
  let v : ℂ→ℂ := fun z => ∏ a∈Z,diskZeroFactor R a z^m a
  have hnorm (t : ℝ) : ‖f (circleMap 0 R t)‖=‖G (circleMap 0 R t)‖ := by
    have ht := circleMap_mem_sphere (0:ℂ) hR.le t
    have htn := mem_sphere_zero_iff_norm.mp ht
    rw [hfactor _ (sphere_subset_closedBall ht),norm_mul,norm_prod]
    suffices (∏ a∈Z,‖diskZeroFactor R a (circleMap 0 R t)^m a‖)=1 by rw [this,mul_one]
    exact Finset.prod_eq_one fun a ha => by
      rw [norm_pow,diskZeroFactor_norm_boundary hR (hZ a ha).2.1 htn,one_pow]
  have hGcont : ContinuousOn (fun t => Real.log ‖G (circleMap 0 R t)‖) (Set.uIcc 0 (2*Real.pi)) := by
    apply ContinuousOn.log
    · exact ((hGa.continuousOn.comp (continuous_circleMap _ _).continuousOn)
        (fun t _ => sphere_subset_closedBall (circleMap_mem_sphere _ hR.le _))).norm
    · intro t _
      exact norm_ne_zero_iff.mpr (hGn _ (sphere_subset_closedBall (circleMap_mem_sphere _ hR.le _)))
  have hGlog : -(logDeriv G 0).re≤φ*ℓ/2+2*E/R := by
    rw [logDeriv_re_eq_cosine hR hGa hGn,←neg_div,←intervalIntegral.integral_neg]
    simp_rw [←neg_mul]
    apply growth_cosine_full hR hφ hℓ hE _ hGcont
    · intro t ht; rw [←hnorm]; exact hpos t ht
    · intro t ht; rw [←hnorm]; exact hneg t ht
  have hamem : (0:ℂ)∈closedBall (0:ℂ) R := mem_closedBall_self hR.le
  have hD (a : ℂ) (ha : a∈Z) : DifferentiableAt ℂ (diskZeroFactor R a) 0 :=
    (blaschke_analytic hR (hZ a ha).2.1 (by simp [hR.le])).differentiableAt
  have hN (a : ℂ) (ha : a∈Z) : diskZeroFactor R a 0 ≠ 0 := by
    have hRc : (R:ℂ)≠0 := by exact_mod_cast hR.ne'
    simp [diskZeroFactor,hRc,(hZ a ha).1]
  have hvD : DifferentiableAt ℂ v 0 :=
    DifferentiableAt.fun_finsetProd (fun a ha => (hD a ha).pow _)
  have hvN : v 0≠0 :=
    Finset.prod_ne_zero_iff.mpr (fun a ha => pow_ne_zero _ (hN a ha))
  have hEq : f =ᶠ[𝓝 (0:ℂ)] (fun z => G z*v z) := by
    filter_upwards [closedBall_mem_nhds (0:ℂ) hR] with z hz
    exact hfactor z hz
  have hd : logDeriv f 0=logDeriv G 0 + ∑ a∈Z,(m a:ℂ)*logDeriv (diskZeroFactor R a) 0 := by
    rw [logDeriv_apply,hEq.deriv_eq,hEq.eq_of_nhds,←logDeriv_apply,
      logDeriv_fun_mul _ (hGn _ hamem) hvN (hGa _ hamem).differentiableAt hvD]
    congr 1
    unfold v
    rw [logDeriv_fun_prod (f:=fun a (z:ℂ)=>diskZeroFactor R a z ^ m a)
      (fun a ha => pow_ne_zero _ (hN a ha)) (fun a ha => (hD a ha).fun_pow _)]
    exact Finset.sum_congr rfl fun a ha => logDeriv_fun_pow (hD a ha) _
  have hreal : (-logDeriv f 0).re =
      -(logDeriv G 0).re - ∑ a∈Z,(m a:ℝ)*(logDeriv (diskZeroFactor R a) 0).re := by
    rw [hd,Complex.neg_re,Complex.add_re,
      show (∑ a∈Z,(m a:ℂ)*logDeriv (diskZeroFactor R a) 0).re = _ from map_sum Complex.reAddGroupHom _ _]
    rw [neg_add]
    congr 2
    apply Finset.sum_congr rfl
    intro a _
    change ((m a:ℂ)*logDeriv (diskZeroFactor R a) 0).re = _
    rw [←Complex.ofReal_natCast]
    simp [Complex.mul_re]
  have hmono : (∑ a∈V,(m a:ℝ)*(logDeriv (diskZeroFactor R a) 0).re) ≤
      ∑ a∈Z,(m a:ℝ)*(logDeriv (diskZeroFactor R a) 0).re := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hVZ
    intro a ha _
    exact mul_nonneg (Nat.cast_nonneg _) (blaschke_real_logDeriv_nonneg hR (hZ a ha).1 (hZ a ha).2.1 (hZ a ha).2.2)
  have hdiff : (∑ a∈V,(m a:ℝ)*(-(1/a)).re) - (δ/R^2)*(∑ a∈V,(m a:ℝ)) ≤
      ∑ a∈V,(m a:ℝ)*(logDeriv (diskZeroFactor R a) 0).re := by
    rw [Finset.mul_sum,← Finset.sum_sub_distrib]
    apply Finset.sum_le_sum
    intro a ha
    have hbound : -δ/R^2 ≤ ((conj a)/(R:ℂ)^2).re := by
      rw [←Complex.ofReal_pow,div_ofReal_re,Complex.conj_re]
      apply div_le_div_of_nonneg_right _ (sq_nonneg R)
      have h := (abs_re_le_norm a).trans (hV a ha)
      linarith only [h,neg_le_abs a.re]
    rw [diskZeroFactor_logDeriv_zero hR (hZ a (hVZ ha)).1,Complex.add_re]
    calc
      _ = (m a:ℝ)*((-(1/a)).re+(-δ/R^2)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (add_le_add (le_refl _) hbound) (Nat.cast_nonneg _)
  rw [hreal]
  linarith only [hGlog,hmono,hdiff]

end

end GoldbachPintzWeightedFormula
end

