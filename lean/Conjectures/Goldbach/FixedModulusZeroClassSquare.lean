namespace GoldbachBurgessPrefix

open Complex Finset Filter
open scoped Topology

noncomputable section

set_option maxHeartbeats 950000 in
/-- A complete fourth moment of the expected size implies the direct
Burgess estimate on middle-length integer prefixes. -/
theorem direct_burgess_prefix_mid_of_moment {q N : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hq : 65536≤q)
    (hNlo : (q:ℝ)^(3/8:ℝ)≤N) (hNhi : (N:ℝ)≤(q:ℝ)^(5/8:ℝ))
    (hτ : 2*(q.divisors.card:ℝ)^2≤(burgessShiftLength q N:ℝ))
    {C e : ℝ} (hC : 0≤C)
    (hFourth : let B := burgessBlockLength q
      (∑ x : ZMod q,‖shortSum χ B x‖^4) ≤
        C*(q:ℝ)^e*((q:ℝ)*(B:ℝ)^2+(q:ℝ)^(1/2:ℝ)*(B:ℝ)^4)) :
    ‖prefixSum (fun n=>χ (n:ZMod q)) N‖ ≤
      (1+(256*C*(q.divisors.card:ℝ)^2*(q:ℝ)^e*(1+Real.log (q:ℝ)))^(1/4:ℝ))*
        ((N:ℝ)^(3/5:ℝ)*(q:ℝ)^(3/20:ℝ)) := by
  classical
  let V := burgessShiftLength q N
  let B := burgessBlockLength q
  let A := coprimePrefix q V
  let u (a : ℕ) : (ZMod q)ˣ := if h : q.Coprime a then ZMod.unitOfCoprime a h.symm else 1
  have hA : A⊆Icc 1 V := Finset.filter_subset _ _
  have hu (a : ℕ) (ha : a∈A) : ((u a):ZMod q)=a := by
    have h : q.Coprime a := (mem_filter.mp ha).2
    unfold u
    rw [dif_pos h,ZMod.coe_unitOfCoprime]
  obtain ⟨hBdown,hBup,hVdown,hVup,hVN,hV1,hB1,_⟩ := burgess_middle_scale hq hNlo hNhi
  change V*N<q at hVN
  have hQ1 : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hQ0 : (0:ℝ)<q := zero_lt_one.trans_le hQ1
  have hN0 : (0:ℝ)<N := (Real.rpow_pos_of_pos hQ0 _).trans_le hNlo
  have hNnat : 0<N := by exact_mod_cast hN0
  have hV0 : (0:ℝ)<V := by exact_mod_cast hV1
  have hB0 : (0:ℝ)<B := by exact_mod_cast hB1
  have hVQ : (V:ℝ)≤q := by
    exact_mod_cast (Nat.le_mul_of_pos_right V hNnat).trans (le_of_lt hVN)
  have hLog : Real.log (V:ℝ)≤Real.log (q:ℝ) := Real.log_le_log hV0 hVQ
  have hτ0 : (0:ℝ)<q.divisors.card := by
    exact_mod_cast Finset.card_pos.mpr ⟨1,Nat.mem_divisors.mpr ⟨one_dvd _,NeZero.ne q⟩⟩
  have hAC : (V:ℝ)/(2*(q.divisors.card:ℝ))≤(A.card:ℝ) :=
    coprimePrefix_card_lower (NeZero.pos q) hτ
  have hA0 : (0:ℝ)<A.card := (by positivity : 0<(V:ℝ)/(2*(q.divisors.card:ℝ))).trans_le hAC
  have hL : 0≤1+Real.log (q:ℝ) := by positivity
  have hCol := sum_sq_fiberCount_le A u hV1 hA hu hVN
  have hCol' : (∑ x : ZMod q,(fiberCount A u N x:ℝ)^2)≤2*(V:ℝ)*(N:ℝ)*(1+Real.log (q:ℝ)) :=
    hCol.trans (mul_le_mul_of_nonneg_left (by linarith only [hLog]) (by positivity))
  have hHold := prefix_fourth_le χ A u N B V (fun a ha=>(mem_Icc.mp (hA ha)).2) hu
  have hActual :
      (max (((A.card:ℝ)*B)*(‖prefixSum (fun n => χ (n:ZMod q)) N‖-2*(V:ℝ)*B)) 0)^4 ≤
      ((A.card:ℝ)*N)^2*(2*(V:ℝ)*(N:ℝ)*(1+Real.log (q:ℝ)))*
        (C*(q:ℝ)^e*((q:ℝ)*(B:ℝ)^2+(q:ℝ)^(1/2:ℝ)*(B:ℝ)^4)) := by
    refine hHold.trans (mul_le_mul (mul_le_mul_of_nonneg_left hCol' (sq_nonneg _)) hFourth ?_ ?_)
    · exact Finset.sum_nonneg fun _ _=>by positivity
    · positivity
  exact direct_prefix_fourth_numeric hQ0 hN0 hV0 hB0 hA0 hτ0 hC hL hAC
    hBdown hBup hVdown hVup hActual

theorem eventual_burgess_unit_budget :
    ∀ᶠ q : ℕ in atTop, ∀ N : ℕ, (q:ℝ)^(3/8:ℝ)≤N →
      (N:ℝ)≤(q:ℝ)^(5/8:ℝ) →
      2*(q.divisors.card:ℝ)^2≤(burgessShiftLength q N:ℝ) := by
  obtain ⟨A,hA,hDiv⟩ := card_divisors_le_rpow (show (0:ℝ)<1/32 by norm_num)
  have hqGrowth : Tendsto (fun q : ℕ => (q:ℝ)^(1/16:ℝ)) atTop atTop :=
    (tendsto_rpow_atTop (show (0:ℝ)<1/16 by norm_num)).comp tendsto_natCast_atTop_atTop
  filter_upwards [eventually_ge_atTop (65536:ℕ),hqGrowth.eventually_ge_atTop (8*A^2)]
    with q hq hPow N hNlo hNhi
  obtain ⟨_,_,_,_,_,_,_,hV⟩ := burgess_middle_scale hq hNlo hNhi
  have hq0 : (0:ℝ)<q := by exact_mod_cast (show 0<q by omega)
  have hqne : q≠0 := by omega
  have hConv1 : ((q:ℝ)^(1/32:ℝ))^2=(q:ℝ)^(1/16:ℝ) := by
    rw [←Real.rpow_mul_natCast hq0.le]; norm_num
  have hConv2 : ((q:ℝ)^(1/16:ℝ))^2=(q:ℝ)^(1/8:ℝ) := by
    rw [←Real.rpow_mul_natCast hq0.le]; norm_num
  calc
    _ ≤ 2*(A*(q:ℝ)^(1/32:ℝ))^2 :=
      mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (Nat.cast_nonneg _) (hDiv q hqne) 2) (by norm_num)
    _ = 2*A^2*(q:ℝ)^(1/16:ℝ) := by rw [mul_pow,hConv1]; ring
    _ ≤ (q:ℝ)^(1/8:ℝ)/4 := by
      rw [←hConv2]
      have hh := mul_le_mul_of_nonneg_right hPow (Real.rpow_nonneg hq0.le (1/16:ℝ))
      nlinarith only [hh]
    _ ≤ _ := hV

end

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgessPrefix

open Complex Filter GoldbachGrhGrowth GoldbachHybridGrowth
open scoped Topology

noncomputable section

private theorem one_add_log_pow_le {Q d : ℝ} (hQ : 1≤Q) (hd : 0<d) :
    1+Real.log Q≤(1+1/d)*Q^d := by
  have h1 := Real.one_le_rpow hQ hd.le
  have h2 := Real.log_le_rpow_div (zero_le_one.trans hQ) hd
  calc
    _ ≤ Q^d+Q^d/d := add_le_add h1 h2
    _ = _ := by ring

private theorem direct_prefix_factor_bound {Q C A d τ : ℝ} (hQ : 1≤Q)
    (hC : 0<C) (hA : 0<A) (hd : 0<d) (hτ : 0≤τ) (hτQ : τ≤A*Q^(d/2)) :
    1+(256*C*τ^2*Q^(2*d)*(1+Real.log Q))^(1/4:ℝ) ≤
      (1+(256*C*A^2*(1+1/d))^(1/4:ℝ))*Q^d := by
  let G : ℝ := 256*C*A^2*(1+1/d)
  have hQ0 : 0<Q := zero_lt_one.trans_le hQ
  have hG : 0<G := by unfold G; positivity
  have hLog : 0≤1+Real.log Q := add_nonneg zero_le_one (Real.log_nonneg hQ)
  have hτ2 : τ^2≤A^2*Q^d := by
    calc
      _ ≤ (A*Q^(d/2))^2 := pow_le_pow_left₀ hτ hτQ 2
      _ = _ := by
        rw [mul_pow,←Real.rpow_mul_natCast hQ0.le]
        norm_num only [Nat.cast_ofNat]
        rw [show d/2*2=d by ring]
  have hB : 256*C*τ^2*Q^(2*d)*(1+Real.log Q)≤G*Q^(4*d) := calc
    _ ≤ 256*C*(A^2*Q^d)*Q^(2*d)*((1+1/d)*Q^d) := by
      have h := one_add_log_pow_le hQ hd
      gcongr
    _ = G*(Q^d*Q^(2*d)*Q^d) := by unfold G; ring
    _ = _ := by
      rw [←Real.rpow_add hQ0,←Real.rpow_add hQ0,show d+2*d+d=4*d by ring]
  have hC' : (256*C*τ^2*Q^(2*d)*(1+Real.log Q))^(1/4:ℝ)≤G^(1/4:ℝ)*Q^d := calc
    _ ≤ (G*Q^(4*d))^(1/4:ℝ) := Real.rpow_le_rpow (by positivity) hB (by norm_num)
    _ = _ := by
      rw [Real.mul_rpow hG.le (Real.rpow_nonneg hQ0.le _),←Real.rpow_mul hQ0.le]
      rw [show 4*d*(1/4)=d by ring]
  calc
    _ ≤ Q^d+G^(1/4:ℝ)*Q^d := add_le_add (Real.one_le_rpow hQ hd.le) hC'
    _ = _ := by unfold G; ring

set_option maxHeartbeats 1850000 in
/-- A full fourth-moment family bound yields the unconditional direct
Burgess initial segment exponent in that family once the moment is supplied. -/
theorem nonprincipal_prefix_of_fourth_moment
    (family : ∀ q : ℕ, DirichletCharacter ℂ q→Prop)
    (hMoment : ∀ e : ℝ, 0<e → ∃ C : ℝ, 0<C ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), family q χ →
      ∀ B : ℕ, (∑ x : ZMod q,‖shortSum χ B x‖^4)≤
        C*(q:ℝ)^e*((q:ℝ)*(B:ℝ)^2+Real.sqrt q*(B:ℝ)^4))
    {δ : ℝ} (hδ : 0<δ) :
    ∃ A : ℝ, 1≤A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → family q χ → ∀ N : ℕ,
      ‖charPartialSum χ N‖≤A*(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) := by
  obtain ⟨C,hC,hCmoment⟩ := hMoment (2*δ) (by positivity)
  obtain ⟨D,hD,hDdiv⟩ := card_divisors_le_rpow (show 0<δ/2 by positivity)
  obtain ⟨q₀,hq₀⟩ := eventually_atTop.mp eventual_burgess_unit_budget
  let M : ℕ := max 65536 q₀
  let G : ℝ := 1+(256*C*D^2*(1+1/δ))^(1/4:ℝ)
  let P : ℝ := 2*(1+1/δ)
  let W : ℝ := 2*Real.sqrt M*(1+Real.log M)
  let A : ℝ := max 1 (max G (max P W))
  have hA1 : 1≤A := le_max_left _ _
  have hAG : G≤A := (le_max_left _ _).trans (le_max_right _ _)
  have hAP : P≤A := (le_max_left _ _).trans ((le_max_right _ _).trans (le_max_right _ _))
  have hAW : W≤A := (le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _))
  refine ⟨A,hA1,?_⟩
  intro q _ χ hχ hF N
  by_cases hN : N=0
  · subst N
    simp [charPartialSum,Real.zero_rpow (show (3/5:ℝ)≠0 by norm_num)]
  have hq1 : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hq0 : (0:ℝ)<q := zero_lt_one.trans_le hq1
  have hN1 : (1:ℝ)≤N := by exact_mod_cast Nat.pos_of_ne_zero hN
  have hN0 : (0:ℝ)<N := zero_lt_one.trans_le hN1
  have h1N := Real.one_le_rpow hN1 (show (0:ℝ)≤3/5 by norm_num)
  have h1q := Real.one_le_rpow hq1 (show (0:ℝ)≤3/20+δ by positivity)
  by_cases hqM : M≤q
  · by_cases hSmall : (N:ℝ)≤(q:ℝ)^(3/8:ℝ)
    · have hNum : (N:ℝ)≤(N:ℝ)^(3/5:ℝ)*(q:ℝ)^(3/20:ℝ) := calc
        _ = (N:ℝ)^(3/5:ℝ)*(N:ℝ)^(2/5:ℝ) := by
          rw [←Real.rpow_add hN0,show (3/5:ℝ)+2/5=1 by norm_num,Real.rpow_one]
        _ ≤ (N:ℝ)^(3/5:ℝ)*((q:ℝ)^(3/8:ℝ))^(2/5:ℝ) :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hN0.le hSmall (by norm_num)) (by positivity)
        _ = _ := by rw [←Real.rpow_mul hq0.le]; norm_num
      refine (norm_charPartialSum_le χ N).trans (hNum.trans ?_)
      calc
        _ ≤ (N:ℝ)^(3/5:ℝ)*(q:ℝ)^(3/20+δ:ℝ) :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hq1 (by linarith only [hδ])) (by positivity)
        _ ≤ _ := by
          have h := mul_le_mul_of_nonneg_right hA1 (show 0≤(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) by positivity)
          simpa only [one_mul,mul_assoc,mul_comm ((q:ℝ)^(3/20+δ:ℝ)) ((N:ℝ)^(3/5:ℝ))] using h
    · by_cases hLarge : (q:ℝ)^(5/8:ℝ)≤N
      · have hNum : (q:ℝ)^(3/8:ℝ)≤(N:ℝ)^(3/5:ℝ) := calc
          _ = ((q:ℝ)^(5/8:ℝ))^(3/5:ℝ) := by rw [←Real.rpow_mul hq0.le]; norm_num
          _ ≤ _ := Real.rpow_le_rpow (by positivity) hLarge (by norm_num)
        have hSc : (q:ℝ)^(1/2+δ:ℝ)≤(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) := calc
          _ ≤ (q:ℝ)^(3/20+δ+3/8:ℝ) :=
            Real.rpow_le_rpow_of_exponent_le hq1 (by linarith)
          _ = (q:ℝ)^(3/20+δ:ℝ)*(q:ℝ)^(3/8:ℝ) := Real.rpow_add hq0 _ _
          _ ≤ _ := mul_le_mul_of_nonneg_left hNum (by positivity)
        refine (charPartialSum_nonprincipal_bound χ hχ N).trans ?_
        calc
          _ ≤ 2*Real.sqrt q*((1+1/δ)*(q:ℝ)^δ) :=
            mul_le_mul_of_nonneg_left (one_add_log_pow_le hq1 hδ) (by positivity)
          _ = P*(q:ℝ)^(1/2+δ:ℝ) := by
            unfold P
            rw [Real.sqrt_eq_rpow,Real.rpow_add hq0]
            ring
          _ ≤ P*((q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ)) :=
            mul_le_mul_of_nonneg_left hSc (by unfold P; positivity)
          _ ≤ _ := by
            have h := mul_le_mul_of_nonneg_right hAP (show 0≤(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) by positivity)
            simpa only [mul_assoc] using h
      · have hLo := (lt_of_not_ge hSmall).le
        have hHi := (lt_of_not_ge hLarge).le
        have hmid := direct_burgess_prefix_mid_of_moment (C:=C) (e:=2*δ) χ
          ((le_max_left _ _).trans hqM) hLo hHi
          (hq₀ q ((le_max_right _ _).trans hqM) N hLo hHi) hC.le
          (by simpa only [Real.sqrt_eq_rpow] using hCmoment q χ hF (burgessBlockLength q))
        have hFactor := direct_prefix_factor_bound hq1 hC hD hδ
          (show (0:ℝ)≤q.divisors.card by positivity) (hDdiv q (NeZero.ne q))
        change ‖charPartialSum χ N‖≤_ at hmid
        refine hmid.trans ?_
        calc
          _ ≤ (G*(q:ℝ)^δ)*((N:ℝ)^(3/5:ℝ)*(q:ℝ)^(3/20:ℝ)) :=
            mul_le_mul_of_nonneg_right hFactor (by positivity)
          _ = G*((q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ)) := by
            rw [Real.rpow_add hq0]
            ring
          _ ≤ _ := by
            have h := mul_le_mul_of_nonneg_right hAG (show 0≤(q:ℝ)^(3/20+δ:ℝ)*(N:ℝ)^(3/5:ℝ) by positivity)
            simpa only [mul_assoc] using h
  · have hqM' : (q:ℝ)≤M := by exact_mod_cast (le_of_lt (lt_of_not_ge hqM))
    have hLog := Real.log_le_log hq0 hqM'
    refine (charPartialSum_nonprincipal_bound χ hχ N).trans ?_
    calc
      _ ≤ W := by
        unfold W
        exact mul_le_mul (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hqM') (by norm_num))
          (add_le_add_right hLog 1) (by positivity) (by positivity)
      _ ≤ A := hAW
      _ ≤ _ := by
        have h := mul_le_mul_of_nonneg_left (one_le_mul_of_one_le_of_one_le h1q h1N) (zero_le_one.trans hA1)
        simpa only [mul_one,mul_assoc] using h

end

end GoldbachBurgessPrefix
