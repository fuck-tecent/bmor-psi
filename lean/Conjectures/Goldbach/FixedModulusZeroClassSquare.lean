set_option maxHeartbeats 800000 in
theorem diskZeroFactor_analyticAt {R : ℝ} (hR : 0<R)
    {a : ℂ} (ha : ‖a‖<R) {z : ℂ} (hz : ‖z‖≤R) :
    AnalyticAt ℂ (diskZeroFactor R a) z := by
  have hn : AnalyticAt ℂ (fun w : ℂ => (R:ℂ)*(w-a)) z := by fun_prop
  have hd : AnalyticAt ℂ (fun w : ℂ => (R:ℂ)^2-conj a*w) z := by fun_prop
  exact hn.fun_div hd (diskZeroFactor_denom_ne hR ha hz)

private theorem inv_canonicalFactor_eq (R : ℝ) (a z : ℂ) :
    (canonicalFactor R a z)⁻¹=diskZeroFactor R a z := by
  rw [canonicalFactor_apply,diskZeroFactor,inv_div]

set_option maxHeartbeats 1100000 in
/-- Remove all analytic zeros from a closed disk whose boundary is zero-free.
The finite factorization is pointwise and records the exact analytic orders. -/
theorem exists_disk_factorization {f : ℂ→ℂ} {R : ℝ} (hR : 0<R)
    (hf : AnalyticOnNhd ℂ f (closedBall 0 R)) (hf0 : f 0≠0)
    (hfb : ∀ z∈sphere (0:ℂ) R, f z≠0) :
    ∃ Z : Finset ℂ, ∃ G : ℂ→ℂ, AnalyticOnNhd ℂ G (closedBall 0 R) ∧
      (∀ z∈closedBall (0:ℂ) R, G z≠0) ∧
      (∀ a : ℂ, a∈Z ↔ a∈ball (0:ℂ) R ∧ f a=0) ∧
      (∀ z∈closedBall (0:ℂ) R,
        f z = G z*(∏ a∈Z,diskZeroFactor R a z^analyticOrderNatAt f a)) := by
  have hm : MeromorphicOn f (closedBall (0:ℂ) R) := hf.meromorphicOn
  have hmB : MeromorphicOn f (ball (0:ℂ) R) := fun z hz => hm z (ball_subset_closedBall hz)
  have hmS : MeromorphicOn f (sphere (0:ℂ) R) := fun z hz => hm z (sphere_subset_closedBall hz)
  have h0 : (0:ℂ)∈closedBall (0:ℂ) R := mem_closedBall_self hR.le
  have hd0 := (hf 0 h0).meromorphicNFAt.meromorphicOrderAt_eq_zero_iff.mpr hf0
  have hmord : ∀ u : closedBall (0:ℂ) R, meromorphicOrderAt f u ≠ ⊤ :=
    (hm.exists_meromorphicOrderAt_ne_top_iff_forall (Metric.isConnected_closedBall hR.le)).mp
      ⟨⟨0,h0⟩,by simp [hd0]⟩
  obtain ⟨G,H⟩ := hm.exists_ecanonicalDecomp hmord
  let d := MeromorphicOn.divisor f (ball (0:ℂ) R)
  have hdf : d.support.Finite := hm.divisor_ball_support_finite
  let Z : Finset ℂ := hdf.toFinset
  have hZ (a : ℂ) : a∈Z ↔ a∈ball (0:ℂ) R ∧ f a=0 := by
    rw [Set.Finite.mem_toFinset]
    change d a≠0 ↔ _
    constructor
    · intro hh
      have ha : a∈ball (0:ℂ) R := d.supportWithinDomain hh
      refine ⟨ha,?_⟩
      by_contra hn
      have hz := (hf a (ball_subset_closedBall ha)).meromorphicNFAt.meromorphicOrderAt_eq_zero_iff.mpr hn
      exact hh (by simp [d,MeromorphicOn.divisor_apply hmB ha,hz])
    · rintro ⟨ha,hfa⟩ hh
      have ht := hmord ⟨a,ball_subset_closedBall ha⟩
      have hz : meromorphicOrderAt f a = 0 := by
        simpa only [d,MeromorphicOn.divisor_apply hmB ha,
          WithTop.untop₀_eq_zero,ht,or_false] using hh
      exact ((hf a (ball_subset_closedBall ha)).meromorphicNFAt.meromorphicOrderAt_eq_zero_iff.mp hz) hfa
  have hInto (a : ℂ) (ha : a∈Z) : d a=(analyticOrderNatAt f a:ℤ) := by
    have hb := (hZ a).mp ha |>.1
    have hcl := ball_subset_closedBall hb
    have ht : analyticOrderAt f a≠⊤ := by
      intro he
      apply hmord ⟨a,hcl⟩
      rw [(hf a hcl).meromorphicOrderAt_eq,he,ENat.map_top]
    change (MeromorphicOn.divisor f (ball (0:ℂ) R)) a = _
    rw [MeromorphicOn.divisor_apply hmB hb,
      (hf a hcl).meromorphicOrderAt_eq,←Nat.cast_analyticOrderNatAt ht,ENat.map_natCast]
    rfl
  have hsb : MeromorphicOn.divisor f (sphere (0:ℂ) R)=0 := by
    ext a
    by_cases ha : a∈sphere (0:ℂ) R
    · have hz := (hf a (sphere_subset_closedBall ha)).meromorphicNFAt.meromorphicOrderAt_eq_zero_iff.mpr (hfb a ha)
      simp [MeromorphicOn.divisor_apply hmS ha,hz]
    · exact (MeromorphicOn.divisor f (sphere (0:ℂ) R)).apply_eq_zero_of_notMem ha
  let P : ℂ→ℂ := fun z => ∏ a∈Z,diskZeroFactor R a z^analyticOrderNatAt f a
  have hP : (∏ᶠ a, canonicalFactor R a ^ (-d a))=P := by
    have hSupp : Function.mulSupport (fun a => canonicalFactor R a ^ (-d a)) ⊆ d.support := by
      intro a ha
      by_contra h
      have hz : d a=0 := not_not.mp h
      exact ha (by simp [hz])
    rw [finprod_eq_prod_of_mulSupport_subset_of_finite _ hSupp hdf]
    funext z
    change (∏ a∈Z, canonicalFactor R a ^ (-d a)) z = _
    rw [Finset.prod_apply]
    apply Finset.prod_congr rfl
    intro a ha
    simp only [Pi.pow_apply,hInto a ha,zpow_neg,zpow_natCast,←inv_pow,inv_canonicalFactor_eq]
  have Hsame : f =ᶠ[codiscreteWithin (closedBall (0:ℂ) R)] (fun z=>G z*P z) := by
    filter_upwards [H.eventuallyEq] with z hz
    rw [hsb] at hz
    simpa [← hP, d, Pi.mul_apply, Pi.smul_apply', smul_eq_mul, mul_comm] using hz
  have hPana : AnalyticOnNhd ℂ (fun z => G z*P z) (closedBall (0:ℂ) R) := by
    intro z hz
    apply (H.analyticOnNhd z hz).mul
    change AnalyticAt ℂ (fun z=>∏ a∈Z,diskZeroFactor R a z^analyticOrderNatAt f a) z
    apply Finset.analyticAt_fun_prod
    intro a ha
    apply AnalyticAt.pow
    apply diskZeroFactor_analyticAt hR (mem_ball_zero_iff.mp ((hZ a).mp ha).1)
    exact mem_closedBall_zero_iff.mp hz
  have Hnear : f =ᶠ[𝓝[≠] (0:ℂ)] (fun z=>G z*P z) := by
    have Hsmall := Hsame.filter_mono (codiscreteWithin_mono ball_subset_closedBall)
    have Hlocal := mem_codiscreteWithin_iff_forall_mem_nhdsNE.mp Hsmall 0 (mem_ball_self hR)
    have Hball : ∀ᶠ z in 𝓝[≠] (0:ℂ), z∈ball (0:ℂ) R :=
      nhdsWithin_le_nhds (ball_mem_nhds (0:ℂ) hR)
    filter_upwards [Hlocal,Hball] with z hz hz'
    exact hz.resolve_right (not_not_intro hz')
  have Hball := (hf.mono ball_subset_closedBall).eqOn_of_preconnected_of_frequently_eq
    (hPana.mono ball_subset_closedBall) (Metric.isConnected_ball hR).isPreconnected
    (mem_ball_self hR) Hnear.frequently
  refine ⟨Z,G,H.analyticOnNhd,H.ne_zero,hZ,?_⟩
  apply Hball.of_subset_closure hf.continuousOn hPana.continuousOn ball_subset_closedBall
  rw [closure_ball (0:ℂ) hR.ne']

end

end GoldbachPintzWeightedFormula
