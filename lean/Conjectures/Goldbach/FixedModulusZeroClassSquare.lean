/-- Principal rational prime test with its exact zeta pole. The remaining
zeros can be discarded when they lie to the left of the evaluation line. -/
theorem rational_prime_test_principal_one_upper {b : ℝ} (hb : 0<b) :
    ∃ C : ℝ, 0<C ∧ ∀ {L : ℝ} {s : ℂ}, 1≤L →
      1<s.re+b/L → s.re+b/L≤1+1/8 →
      (∀ ρ : ℂ, regularizedL (1:DirichletCharacter ℂ 1) ρ=0 →
        |ρ.im-s.im|≤2 → ρ.re≤ s.re) →
      (rationalPrimeTest (1:DirichletCharacter ℂ 1) b L s).re ≤
        L*(rationalZeroKernel b ((L:ℂ)*(s-1))).re + C*logHeight 1 s.im := by
  obtain ⟨A,hA,hAux⟩ := local_analytic_remainder_with_principal_pole
  let R : ℝ := 1/8
  let C : ℝ := A*(1+b/R+(2/3:ℝ)*b^2/R^2)
  have hR : 0<R := by norm_num [R]
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro L s hL hslo hshi hZeros
  let χ : DirichletCharacter ℂ 1 := 1
  let w := s+((b/L:ℝ):ℂ)
  let c : ℂ := ((b/L:ℝ):ℂ)
  let t := s.im
  let M := A*logHeight 1 t
  have hL0 : 0<L := zero_lt_one.trans_le hL
  have hwRe : w.re=s.re+b/L := by simp [w]
  have hwIm : w.im=t := by simp [w,t]
  have hw : 1<w.re := by rwa [hwRe]
  have hwd : ‖w-line 1 t‖≤R := by
    have he : w-line 1 t=((w.re-1:ℝ):ℂ) := by
      apply Complex.ext <;> simp [hwIm,line,Complex.sub_re,Complex.sub_im,Complex.mul_re,Complex.mul_im]
    rw [he,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (sub_pos.mpr hw),hwRe]
    dsimp [R]
    linarith only [hshi]
  have hball : w∈ball (line 1 t) (1/4) :=
    mem_ball_iff_norm.mpr (hwd.trans_lt (by norm_num [R]))
  have hsub : closedBall w R ⊆ closedBall (line 1 t) (1/4) := by
    intro z hz
    apply mem_closedBall_iff_norm.mpr
    have h := norm_add_le (z-w) (w-line 1 t)
    rw [sub_add_sub_cancel] at h
    have h' := mem_closedBall_iff_norm.mp hz
    norm_num [R] at h' hwd
    linarith only [h,h',hwd]
  obtain ⟨Z,G,hZ,_,hGa,hGb,hGe,_⟩ := hAux 1 χ t
  have hM : 0≤M := mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one 1 t))
  have hOne : (1:ℂ)∉Z := fun h=>regularizedL_ne_zero_at_one χ (hZ 1 h).1
  let m := analyticOrderNatAt (regularizedL χ)
  let m' (ρ : ℂ) : ℂ := if ρ=1 then -1 else (m ρ:ℂ)
  let V := insert 1 Z
  have hFlag : principalFlag χ=1 := by simp [principalFlag,χ]
  have hSum (P : ℂ→ℂ) :
      (∑ ρ∈V,m' ρ*P ρ) = -P 1+∑ ρ∈Z,(m ρ:ℂ)*P ρ := by
    unfold V
    rw [Finset.sum_insert hOne]
    unfold m'
    simp only [ite_true,neg_mul,one_mul]
    congr 1
    apply Finset.sum_congr rfl
    intro ρ hρ
    have hn : ρ≠1 := fun he=>hOne (he ▸ hρ)
    rw [ite_eq_right hn]
  have hEq : (fun z=>-logDeriv χ.LFunction z) =ᶠ[𝓝 w]
      (fun z=>G z-∑ ρ∈V,m' ρ*(1/(z-ρ))) := by
    have hw' : w∈{z : ℂ|1<z.re} := hw
    have hO : IsOpen {z : ℂ|1<z.re} := isOpen_lt continuous_const Complex.continuous_re
    filter_upwards [isOpen_ball.mem_nhds hball,hO.mem_nhds hw'] with z hz hz'
    rw [hGe z (ball_subset_closedBall hz) hz',hFlag,hSum]
    simp only [div_eq_mul_inv,one_mul]
    ring
  have hNe (ρ : ℂ) (hρ : ρ∈V) : w≠ρ := by
    have hρRe : ρ.re≤1 := by
      rcases Finset.mem_insert.mp hρ with rfl|hρ
      · simp
      · exact (hZ ρ hρ).2.1
    intro he
    rw [←he] at hρRe
    exact (not_lt_of_ge hρRe) hw
  have hJet := rationalLogJet_of_partial_fractions (hGa w (ball_subset_closedBall hball)) V m' hNe hEq c
  let P := fun ρ : ℂ=>1/(w-ρ)+c/(w-ρ)^2+(2*c^2/3)/(w-ρ)^3
  change _ = rationalLogJet G c w-∑ ρ∈V,m' ρ*P ρ at hJet
  rw [hSum] at hJet
  have hP (ρ : ℂ) (hρ : ρ∈V) : (P ρ).re=L*(rationalZeroKernel b ((L:ℂ)*(s-ρ))).re := by
    have hh := congrArg Complex.re (rational_pole_scale (s:=s) (b:=b) hL0.ne'
      (hNe ρ hρ) (by simp [w,Complex.ofReal_div]))
    simpa [P,c,Complex.ofReal_div,Complex.ofReal_mul,Complex.ofReal_pow,Complex.mul_re,
      rationalZeroKernel] using hh
  have hZnonneg : 0≤(∑ ρ∈Z,(m ρ:ℂ)*P ρ).re := by
    change 0≤Complex.reAddGroupHom (∑ ρ∈Z,(m ρ:ℂ)*P ρ)
    rw [map_sum]
    apply Finset.sum_nonneg
    intro ρ hρZ
    have hρ : ρ∈V := Finset.mem_insert_of_mem hρZ
    have hRe : 0≤((L:ℂ)*(s-ρ)).re := by
      simpa [Complex.mul_re,Complex.sub_re] using mul_nonneg hL0.le
        (sub_nonneg.mpr (hZeros ρ (hZ ρ hρZ).1 (by simpa [t] using (hZ ρ hρZ).2.2)))
    have hPos : 0≤(rationalZeroKernel b ((L:ℂ)*(s-ρ))).re := by
      exact (Complex.re_add_im ((L:ℂ)*(s-ρ))) ▸ rationalZeroKernel_re_nonneg hb hRe
    change 0≤((m ρ:ℂ)*P ρ).re
    rw [←Complex.ofReal_natCast]
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero,hP ρ hρ]
    exact mul_nonneg (Nat.cast_nonneg _) (mul_nonneg hL0.le hPos)
  have hNormc : ‖c‖=b/L := by simp [c,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hb,abs_of_pos hL0]
  have hc : ‖c‖≤b := by rw [hNormc]; exact div_le_self hb.le hL
  have hG' := rationalLogJet_analytic_error hR (hGa.mono hsub) (fun z hz=>hGb z (hsub hz)) c
  have hGa' : (rationalLogJet G c w).re ≤ C*logHeight 1 t := by
    have hRe := (Complex.re_le_norm (rationalLogJet G c w-G w)).trans hG'
    rw [Complex.sub_re] at hRe
    have hGb' := (Complex.re_le_norm (G w)).trans (hGb w (ball_subset_closedBall hball))
    have h1 : ‖c‖*M/R≤b*M/R :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hc hM) hR.le
    have h2 : (2/3:ℝ)*‖c‖^2*M/R^2≤(2/3:ℝ)*b^2*M/R^2 := by
      gcongr
    have h3 : M+b*M/R+(2/3:ℝ)*b^2*M/R^2=C*logHeight 1 t := by unfold M C; ring
    change _ ≤ ‖c‖*M/R+(2/3:ℝ)*‖c‖^2*M/R^2 at hRe
    change _≤M at hGb'
    linarith only [hRe,hGb',h1,h2,h3]
  change (rationalPrimeTest χ b L s).re≤_
  rw [rationalPrimeTest_eq_logJet χ b L s hw,hJet,Complex.sub_re,Complex.add_re,Complex.neg_re,hP 1 (Finset.mem_insert_self _ _)]
  change _≤C*logHeight 1 s.im at hGa'
  linarith only [hGa',hZnonneg]

end

end GoldbachPintzWeightedFormula
