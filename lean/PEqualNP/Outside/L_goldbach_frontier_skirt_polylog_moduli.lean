    rw [show g=(fun s => ∑ z∈S,C z*(s-z)⁻¹) from rfl,
      V19h S hterm,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro z hz
    rw [V8r,
      Vd3 z a b c d (hinside z hz).1
        (hinside z hz).2.1 (hinside z hz).2.2.1 (hinside z hz).2.2.2]
    ring
  have hzero := V9p hF
  rw [hfg,V99 hfi hg,hgvalue] at hzero
