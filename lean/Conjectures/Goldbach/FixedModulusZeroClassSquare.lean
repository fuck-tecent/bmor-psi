/-- Positive spectral averaging supplies the compact Laplace row from a local
right-line resolvent estimate and a uniform tail bound. -/
theorem sinh_laplace_sum_le_of_spectral_bounds {ι : Type*} (S : Finset ι) (m : ι→ℕ)
    (z : ι→ℂ) {ω ell H R A B P : ℝ} (hω : 0 < ω) (hell : 0 < ell) (hH : ell ≤ H)
    (hR : 0 < R) (hA : 0 ≤ A) (hB : 0 ≤ B) (hz : ∀ i∈S,0 < (z i).re)
    (G : ℝ→ℝ) (hG : Integrable (fun t=>sinhSpectrumWeight ω ell t*G t))
    (hPrime : (∫ t : ℝ,sinhSpectrumWeight ω ell t*G t) ≤ P)
    (hLocal : ∀ t∈Set.Icc (-R) R,
      (∑ i∈S,(m i:ℝ)*((scaledSpectrumDenominator (z i) t)⁻¹).re)≤A+G t)
    (hGlobal : ∀ t∉Set.Icc (-R) R,
      (∑ i∈S,(m i:ℝ)*((scaledSpectrumDenominator (z i) t)⁻¹).re)≤B+G t) :
    (∑ i∈S,(m i:ℝ)*(laplace (sinhTest ω ell) (z i)).re) ≤
      A*sinhTest ω ell 0+P+B*(2*(4*ell*Real.exp (H*ω))/R) := by
  let K := sinhSpectrumWeight ω ell
  let Arow (t : ℝ) := ∑ i∈S,(m i:ℝ)*((scaledSpectrumDenominator (z i) t)⁻¹).re
  let F (i : ι) (t : ℝ) := K t*((scaledSpectrumDenominator (z i) t)⁻¹).re
  have hF (i : ι) (hi : i∈S) : Integrable (F i) := sinhSpectrum_integrable_resolvent hω hell (hz i hi)
  have hF' (i : ι) (hi : i∈S) : Integrable (fun t => (m i:ℝ)*F i t) :=
    (hF i hi).const_mul _
  have hEq (t : ℝ) : K t*Arow t=∑ i∈S,(m i:ℝ)*F i t := by
    simp only [Arow,mul_sum,F,mul_left_comm]
  have hKRow : Integrable (fun t=>K t*Arow t) := by
    simpa only [hEq] using integrable_finsetSum S hF'
  have hI : (∫ t : ℝ,K t*Arow t)=∑ i∈S,(m i:ℝ)*(laplace (sinhTest ω ell) (z i)).re := by
    simp only [hEq]
    rw [integral_finsetSum S hF']
    apply sum_congr rfl
    intro i hi
    rw [integral_const_mul]
    exact congrArg (fun x : ℝ=>(m i:ℝ)*x) (sinhSpectrum_weighted_resolvent_eq hω hell (hz i hi))
  have h := weighted_integral_le_of_local_bound measurableSet_Icc
    (sinhSpectrumWeight_integrable hω hell) (sinhSpectrumWeight_nonneg hω hell)
    hKRow hG hA hLocal hGlobal
  rw [hI,sinhSpectrumWeight_integral hω hell] at h
  exact h.trans (add_le_add (add_le_add le_rfl hPrime)
    (mul_le_mul_of_nonneg_left (sinhSpectrumWeight_tail_le hω hell hH hR) hB))

end
end GoldbachPintzWeightedFormula
