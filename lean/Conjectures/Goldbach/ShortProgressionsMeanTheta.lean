namespace ShortAPShortenedBox
open ShortAPSmoothedFactor ShortAPDualSplit ShortAPDyadicPartition ShortAPLogWeight
noncomputable section

/-- The long smooth zeta/log factor in the actual Heath--Brown box admits
the squared shortened bound used in Section 4. No estimate for a Dirichlet
polynomial is assumed. The constant works for both log degrees. -/
theorem shortened_box_second_moment (δ : ℝ) (hδ : 0 < δ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q),
      1 < q → χ.IsPrimitive → ∀ Q T t : ℝ, (q:ℝ) ≤ Q → 2 ≤ T → |t| ≤ T →
      ∀ H j i b : ℕ, i < j+1 → 1 ≤ scale b →
      ‖boxPolynomial H j i b χ (1/2+(t:ℂ)*Complex.I)‖^2 ≤
        K * (Real.log (2*scale b))^(2*logDegree i) *
        ShortAPDualMoment.moment χ t (dualCutoff δ Q T (scale b)) := by
  obtain ⟨C,hC,h⟩ := smooth_box_shortening δ (ShortAPShortening.unweighted δ hδ)
  refine ⟨C^2 * Real.pi, by positivity, ?_⟩
  intro q χ hq hp Q T t hQ hT ht H j i b hi hb
  let L := Real.log (2*scale b)
  let M := dualCutoff δ Q T (scale b)
  let V := L^(logDegree i)
  have h₁ := h χ hq hp Q T t hQ hT ht H j i b hi hb
  have h₂ := ShortAPDualMoment.dualMass_sq_le χ t M
  calc
    _ ≤ (C*V*dualMass χ t M)^2 := pow_le_pow_left₀ (norm_nonneg _) h₁ 2
    _ = (C^2 * V^2) * (dualMass χ t M)^2 := by ring
    _ ≤ (C^2 * V^2) * (Real.pi * ShortAPDualMoment.moment χ t M) :=
      mul_le_mul_of_nonneg_left h₂ (by positivity)
    _ = _ := by dsimp only [V,L,M]; rw [mul_comm 2 (logDegree i), pow_mul]; ring

end
end ShortAPShortenedBox

end


