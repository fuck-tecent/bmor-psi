noncomputable section

/-- The strip and local leading bounds at one character and ordinate. -/
structure PrimeTestWindow {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (t σ T B L K φ : ℝ) : Prop where
  nonprincipal : χ≠1
  height : |t|+1/4≤T
  logHeight_le : logHeight q t≤K*L
  strip : ∀ z : ℂ, 3/4≤z.re → z.re≤3/2 → |z.im|≤T →
    ‖χ.LFunction z‖≤B*(q:ℝ)^(φ*max 0 (1-z.re))
  leading : ∀ ρ : ℂ, regularizedL χ ρ=0 → |ρ.im-t|≤1 → ρ.re≤ σ

private theorem same_ordinate_difference (σ β t : ℝ) :
    line σ t-line β t=((σ-β:ℝ):ℂ) := by
  apply Complex.ext <;> simp [line,Complex.sub_re,Complex.sub_im]

private theorem normalized_gap_window {β t L r H : ℝ}
    (hL : 0<L) (hβ : β≤1) (hH : (1-β)*L≤H) (hr : H≤2*r*L) :
    ‖line β t-line 1 t‖≤2*r := by
  rw [same_ordinate_difference,Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (sub_nonpos.mpr hβ)]
  refine le_of_mul_le_mul_right ?_ hL
  nlinarith only [hH,hr]

set_option maxHeartbeats 1500000 in
/-- Rival zeros of different, nonconjugate characters are strictly beyond
.60 when the leading gap is at most .31. -/
theorem cross_secondary_gap_of_strip_at {K D b g H : ℝ} (hK : 0<K) (hD : 0≤D)
    (hg : 0≤g) (hgH : g≤H) (hbg : 1+g≤b)
    (hMargin : anchorRationalKernelReal b (-g)-anchorRationalKernelReal b 0+
      (141/250:ℝ)+1/1000 < anchorRationalKernelReal b (H-g)) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (χ ψ : DirichletCharacter ℂ q)
      (σ β s t B T : ℝ), Real.log (q:ℝ)≤L → β≤σ → σ≤1 → (1-σ)*L≤ g →
      1≤B → Real.log B≤D*Real.log L →
      PrimeTestWindow χ s σ T B L K (47/125) → PrimeTestWindow ψ t σ T B L K (47/125) →
      PrimeTestWindow (χ*ψ) (s+t) σ T B L K (47/125) →
      PrimeTestWindow (χ*ψ⁻¹) (s-t) σ T B L K (47/125) →
      regularizedL χ (line σ s)=0 → regularizedL ψ (line β t)=0 →
      H<(1-β)*L := by
  let ε : ℝ := 1/4000
  have hb : 0<b := by linarith only [hg,hbg]
  have hε : 0<ε := by norm_num [ε]
  obtain ⟨r,L₀,hr,hr32,hL₀,hN⟩ := anchor_prime_nonprincipal_upper
    (κ:=1) (C:=b) hε (by norm_num) hb hK hD hb.le
  have hP := anchor_prime_principal_upper_eventually hb hε
  filter_upwards [hP,eventually_ge_atTop (max L₀ (H/(2*r)))]
    with L hP hL q _ χ ψ σ β s t B T hq hβ hσ hlam hB hBL hχ hψ hprod hinv hzχ hzψ
  by_contra! hmu
  have hL' : L₀≤L := (le_max_left _ _).trans hL
  have hL0 : 0<L := zero_lt_one.trans_le (hL₀.trans hL')
  have hQ1 : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hR := (div_le_iff₀ (show 0<2*r by positivity)).mp ((le_max_right _ _).trans hL)
  have hR' : H≤2*r*L := by linarith only [hR,mul_comm L (2*r)]
  have hShift : 1+1/L≤σ+b/L := by
    refine le_of_mul_le_mul_left ?_ hL0
    simp only [mul_add,mul_one,mul_div_cancel₀ _ hL0.ne']
    nlinarith only [hlam,hbg]
  have hShift' : 1<σ+b/L := (lt_add_of_pos_right _ (div_pos one_pos hL0)).trans_le hShift
  have hPrincipal := hP q hσ hShift'
  have hLocal (η : DirichletCharacter ℂ q) (u : ℝ)
      (hη : PrimeTestWindow η u σ T B L K (47/125)) :
      ∃ V : Finset ℂ,
      (∀ ρ : ℂ, ‖ρ-line 1 u‖≤2*r → regularizedL η ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V →
        (anchorPrimeTest η b L (line σ u)).re≤(47/125:ℝ)*L/2+ε*L-
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL η) ρ:ℝ)*
            (anchorRationalKernel b ((L:ℂ)*(line σ u-ρ))).re := by
    obtain ⟨V,hV,hCov,hEst⟩ := hN q η hη.nonprincipal (s:=line σ u) (Q:=(q:ℝ)) hL'
      (by simpa [line] using hShift) (by simpa [line] using add_le_add_left hσ (b/L))
      (by simpa [line] using hη.height) (by simpa [line] using hη.logHeight_le)
      (by norm_num) hB hQ1 hBL hη.strip
    refine ⟨V,(by simpa [line] using hCov),?_⟩
    intro U hU
    have hDiscard (ρ : ℂ) (hρ : ρ∈V) (_ : ρ∉U) : ρ.re≤ (line σ u).re := by
      have hp := (Complex.abs_im_le_norm (ρ-line 1 u)).trans
        (show ‖ρ-line 1 u‖≤2*r by simpa [line] using (hV ρ hρ).2.2)
      have hi : |ρ.im-u|≤1 :=
        (show |ρ.im-u|≤2*r by simpa [line,Complex.sub_im] using hp).trans (by linarith only [hr32])
      simpa [line] using hη.leading ρ (hV ρ hρ).1 hi
    have hh := hEst U hU hDiscard
    have hq' := mul_le_mul_of_nonneg_left hq (show (0:ℝ)≤47/125 by norm_num)
    linarith only [hh,hq']
  obtain ⟨Vχ,hcovχ,hUpχ⟩ := hLocal χ s hχ
  obtain ⟨Vψ,hcovψ,hUpψ⟩ := hLocal ψ t hψ
  obtain ⟨Vprod,_,hUpProd⟩ := hLocal (χ*ψ) (s+t) hprod
  obtain ⟨Vinv,_,hUpInv⟩ := hLocal (χ*ψ⁻¹) (s-t) hinv
  have hχMem := hcovχ _ (normalized_gap_window hL0 hσ
    (hlam.trans hgH) hR') hzχ
  have hψMem := hcovψ _ (normalized_gap_window hL0 (hβ.trans hσ) hmu hR') hzψ
  have hχEst := hUpχ {line σ s} (Finset.singleton_subset_iff.mpr hχMem)
  have hψEst := hUpψ {line β t} (Finset.singleton_subset_iff.mpr hψMem)
  have hPEst := hUpProd ∅ (Finset.empty_subset Vprod)
  have hIEst := hUpInv ∅ (Finset.empty_subset Vinv)
  have hZero : (anchorRationalKernel b 0).re=anchorRationalKernelReal b 0 := by
    simpa only [Complex.ofReal_zero] using anchorRationalKernel_ofReal_re b 0
  simp only [Finset.sum_singleton,sub_self,mul_zero,hZero] at hχEst
  simp only [Finset.sum_singleton,same_ordinate_difference,←Complex.ofReal_mul,
    anchorRationalKernel_ofReal_re] at hψEst
  simp only [Finset.sum_empty,mul_zero,sub_zero] at hPEst hIEst
  have hχm : (1:ℝ)≤analyticOrderNatAt (regularizedL χ) (line σ s) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff χ _).mpr hzχ
  have hψm : (1:ℝ)≤analyticOrderNatAt (regularizedL ψ) (line β t) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff ψ _).mpr hzψ
  have hf0 : 0≤anchorRationalKernelReal b 0 := by unfold anchorRationalKernelReal; positivity
  have hδ : 0≤L*(σ-β) := mul_nonneg hL0.le (sub_nonneg.mpr hβ)
  have hfδ : 0≤anchorRationalKernelReal b (L*(σ-β)) := by unfold anchorRationalKernelReal; positivity
  have hχm' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hχm hf0) hL0.le
  have hψm' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hψm hfδ) hL0.le
  have hPos := pair_anchor_primeTest_nonneg χ ψ (s:=s) (t:=t) hb hL0 hShift'
  have hBound : anchorRationalKernelReal b (L*(σ-β))≤
      anchorRationalKernelReal b (L*(σ-1))-anchorRationalKernelReal b 0+141/250+4*ε := by
    refine le_of_mul_le_mul_left ?_ hL0
    have hUχ : (anchorPrimeTest χ b L (line σ s)).re≤
        (47/125:ℝ)*L/2+ε*L-L*anchorRationalKernelReal b 0 := by
      linarith only [hχEst,hχm']
    have hUψ : (anchorPrimeTest ψ b L (line σ t)).re≤
        (47/125:ℝ)*L/2+ε*L-L*anchorRationalKernelReal b (L*(σ-β)) := by
      linarith only [hψEst,hψm']
    have hs := add_le_add (add_le_add (add_le_add hPrincipal hUχ) hUψ)
      (mul_le_mul_of_nonneg_left (add_le_add hPEst hIEst) (by norm_num : (0:ℝ)≤1/2))
    have hh := hPos.trans hs
    nlinarith only [hh]
  have hAux : anchorRationalKernelReal b ((1-β)*L-(1-σ)*L)≤
      anchorRationalKernelReal b (-((1-σ)*L))-anchorRationalKernelReal b 0+141/250+4*ε := by
    rwa [show (1-β)*L-(1-σ)*L=L*(σ-β) by ring,show -((1-σ)*L)=L*(σ-1) by ring]
  have hBnd : anchorRationalKernelReal b ((1-β)*L-(1-σ)*L)≤
      anchorRationalKernelReal b (-((1-σ)*L))-anchorRationalKernelReal b 0+((141/250:ℝ)+1/1000) := by
    norm_num [ε] at hAux ⊢
    linarith only [hAux]
  exact (not_lt_of_ge hmu) (anchor_gap_certificate_of_margin hb (by linarith only [hbg])
    (hg.trans hgH) (by linarith only [hMargin]) hlam
    (mul_le_mul_of_nonneg_right (show 1-σ≤1-β by linarith only [hβ]) hL0.le) hBnd)


theorem cross_secondary_gap_53_of_strip {K D : ℝ} (hK : 0<K) (hD : 0≤D) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (χ ψ : DirichletCharacter ℂ q)
      (σ β s t B T : ℝ), Real.log (q:ℝ)≤L → β≤σ → σ≤1 → (1-σ)*L≤19/50 →
      1≤B → Real.log B≤D*Real.log L →
      PrimeTestWindow χ s σ T B L K (47/125) → PrimeTestWindow ψ t σ T B L K (47/125) →
      PrimeTestWindow (χ*ψ) (s+t) σ T B L K (47/125) →
      PrimeTestWindow (χ*ψ⁻¹) (s-t) σ T B L K (47/125) →
      regularizedL χ (line σ s)=0 → regularizedL ψ (line β t)=0 →
      (53/100:ℝ)<(1-β)*L :=
  cross_secondary_gap_of_strip_at (b:=277/100) hK hD (by norm_num) (by norm_num)
    (by norm_num) (by norm_num [anchorRationalKernelReal])

end

