      rw [hz] at h
      linarith only [h]
    have he : (a*z).re=a.re*z.re := by simp [Complex.mul_re,ha]
    rw [MulChar.one_apply hu]
    simp only [ofReal_zero,neg_zero,zero_mul,cpow_zero,mul_one,one_re,MulChar.mul_apply]
    rw [mul_assoc (ξ (n:ZMod q)) (χ (n:ZMod q))]
    change 0≤c+c*a.re+c*z.re+c*(a*z).re
    rw [he]
    convert mul_nonneg hcz (mul_nonneg ha0 hz0) using 1
    ring
  · simp [MulChar.map_nonunit _ hu]

