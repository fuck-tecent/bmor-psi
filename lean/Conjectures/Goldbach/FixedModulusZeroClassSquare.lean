theorem rational_376_low_complex_clipped_le {ι : Type*} (S : Finset ι) (level : ι→ℝ)
    (h0 : ((S.filter (fun i => level i≤0.99)).card:ℝ)≤6)
    (h1 : ((S.filter (fun i => level i≤1.06)).card:ℝ)≤6)
