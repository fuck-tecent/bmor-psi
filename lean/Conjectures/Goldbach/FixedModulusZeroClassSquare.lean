noncomputable section

set_option maxHeartbeats 1000000 in
/-- The exact spectral prime term is bounded by the corresponding untwisted
compact harmonic Mangoldt sum, with an error linear in the sinh scale. -/
theorem sinh_prime_sum_norm_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {ω ell A L : ℝ} (hω : 0 < ω) (hell : 0 < ell) (hA : ell ≤ A) (hL : 0 < L)
    {s : ℂ} (hs : 1 ≤ s.re) :
    ‖∑ n∈Finset.Icc 1 ⌊Real.exp (ω*L)⌋₊,
       LSeries.term (twistedCoefficient χ) s n*(sinhTest ω ell (Real.log (n:ℝ)/L):ℂ)‖ ≤
       L*(laplace (sinhTest ω ell) 0).re+(Real.log 4+4)*ω*ell*Real.cosh (A*ω) := by
  let F (u : ℝ) := Real.sinh (ell*(ω-u))
  let F' (u : ℝ) := -ell*Real.cosh (ell*(ω-u))
  let Y := Real.exp (ω*L)
  let S := Finset.Icc 1 ⌊Y⌋₊
  have hF (u : ℝ) : HasDerivAt F (F' u) u := by
    have hh := ((hasDerivAt_const u ω).sub (hasDerivAt_id u)).const_mul ell
    convert hh.sinh using 1 <;> dsimp [F,F'] <;> ring
  have hF' : Continuous F' := by unfold F'; fun_prop
  have hFω : F ω=0 := by simp [F]
  have hVar : |(∫ u in (0:ℝ)..ω,|F' u|)|≤ell*Real.cosh (A*ω)*ω := by
    rw [←Real.norm_eq_abs]
    have hh := intervalIntegral.norm_integral_le_of_norm_le_const (a:=0) (b:=ω)
      (f:=fun u=>|F' u|) (C:=ell*Real.cosh (A*ω)) (fun u hu => by
        rw [uIoc_of_le hω.le] at hu
        have hz : 0≤ell*(ω-u) := mul_nonneg hell.le (sub_nonneg.mpr hu.2)
        have hZ : ell*(ω-u)≤A*ω :=
          (mul_le_mul_of_nonneg_left (sub_le_self _ hu.1.le) hell.le).trans
            (mul_le_mul_of_nonneg_right hA hω.le)
        rw [Real.norm_eq_abs,abs_abs]
        dsimp only [F']
        rw [abs_mul,abs_neg,abs_of_pos hell,abs_of_nonneg (Real.cosh_pos _).le]
        exact mul_le_mul_of_nonneg_left (Real.cosh_le_cosh.mpr (by
          rw [abs_of_nonneg hz,abs_of_nonneg (mul_nonneg (hell.le.trans hA) hω.le)]
          exact hZ)) hell.le)
    simpa only [sub_zero,abs_of_pos hω] using hh
  have hLap : (∫ u in (0:ℝ)..ω,F u)=(laplace (sinhTest ω ell) 0).re := by
    rw [Admissible.laplace_eq_intervalIntegral_of hω (fun _ => sinhTest_vanish)]
    have hC : (∫ u in (0:ℝ)..ω,(sinhTest ω ell u:ℂ)*Complex.exp (-((0:ℂ)*(u:ℂ)))) =
        ∫ u in (0:ℝ)..ω,(F u:ℂ) := by
      apply intervalIntegral.integral_congr
      intro u hu
      rw [uIcc_of_le hω.le] at hu
      simp [F,sinhTest,ite_eq_left hu.2]
    rw [hC,intervalIntegral.integral_ofReal,Complex.ofReal_re]
  have hAbel := mangoldt_rescaled_abel hL hω.le hF hF' hFω
  have hI (n : ℕ) : n∈Finset.Ioc 0 ⌊Y⌋₊ ↔ n∈S := by simp [S,Finset.mem_Ioc,Finset.mem_Icc,Nat.succ_le_iff]
  have hSi : Finset.Ioc 0 ⌊Y⌋₊=S := Finset.ext hI
  have hAbel' : (∑ n∈S,(ArithmeticFunction.vonMangoldt n/(n:ℝ))*F (Real.log (n:ℝ)/L)) ≤
      L*(laplace (sinhTest ω ell) 0).re+(Real.log 4+4)*ω*ell*Real.cosh (A*ω) := by
    change |(∑ n∈Finset.Ioc 0 ⌊Y⌋₊,(ArithmeticFunction.vonMangoldt n/(n:ℝ))*F (Real.log (n:ℝ)/L))-
      L*(∫ u in (0:ℝ)..ω,F u)|≤(Real.log 4+4)*(∫ u in (0:ℝ)..ω,|F' u|) at hAbel
    rw [hSi,hLap] at hAbel
    have hAbs := (le_abs_self _).trans hAbel
    have hM := mul_le_mul_of_nonneg_left ((le_abs_self _).trans hVar)
      (show 0≤Real.log 4+4 by positivity)
    nlinarith only [hM,hAbs]
  refine (norm_sum_le _ _).trans ((sum_le_sum (fun n hn=>?_)).trans hAbel')
  have hn₁ : 1≤n := (Finset.mem_Icc.mp hn).1
  have hn₀ : 0<n := Nat.zero_lt_one.trans_le hn₁
  have hnR₁ : (1:ℝ)≤n := by exact_mod_cast hn₁
  have hny : (n:ℝ)≤Y := (Nat.cast_le.mpr (Finset.mem_Icc.mp hn).2).trans (Nat.floor_le (Real.exp_nonneg _))
  have hlog : Real.log (n:ℝ)/L≤ω := by
    apply (div_le_iff₀ hL).mpr
    simpa only [Y,Real.log_exp] using Real.log_le_log (by positivity : (0:ℝ)<n) hny
  have hF₀ : 0≤F (Real.log (n:ℝ)/L) := by
    unfold F
    exact Real.sinh_nonneg_iff.mpr (mul_nonneg hell.le (sub_nonneg.mpr hlog))
  have hEq : sinhTest ω ell (Real.log (n:ℝ)/L)=F (Real.log (n:ℝ)/L) := by
    simp only [F,sinhTest,ite_eq_left hlog]
  rw [hEq,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hF₀]
  apply mul_le_mul_of_nonneg_right _ hF₀
  rw [LSeries.norm_term_eq,ite_eq_right hn₀.ne']
  have hΛ : 0≤ArithmeticFunction.vonMangoldt n := ArithmeticFunction.vonMangoldt_nonneg
  have hN : ‖twistedCoefficient χ n‖≤ArithmeticFunction.vonMangoldt n := by
    rw [twistedCoefficient,Pi.mul_apply,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hΛ]
    exact mul_le_of_le_one_left hΛ (χ.norm_le_one _)
  have hp : (n:ℝ)≤(n:ℝ)^s.re := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hnR₁ hs
  exact div_le_div₀ hΛ hN (by positivity) hp

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex MeasureTheory Set Filter Finset GradedNear Goldbach GoldbachSmoothing GoldbachTwistedMellin
open scoped FourierTransform
noncomputable section

/-- The prime average on the displaced right line is integrable, with a
uniform normalized linear-resolvent bound at every ordinate. -/
theorem cd_rightLog_bounds :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ≠1 →
      ∀ {b L γ : ℝ}, 0<b → 1≤L → b≤L →
      ∀ u : ℝ, ‖logDeriv χ.LFunction (cdRightLine b L γ u)‖/L≤C+2/b := by
  obtain ⟨C,hC,hBound⟩ := GoldbachLinnik.norm_logDeriv_regularized_at_right
  refine ⟨C,hC,?_⟩
  intro q _ χ hχ b L γ hb hL hBL u
  have hL₀ := zero_lt_one.trans_le hL
  let σ := 1+b/L
  let τ := γ+2*Real.pi*u/L
  have hσ : 1<σ := lt_add_of_pos_right _ (div_pos hb hL₀)
  have hσ' : σ≤2 := by
    have h := (div_le_one hL₀).mpr hBL
    dsimp only [σ]
    linarith only [h]
  have h := hBound q χ σ τ hσ hσ'
  rw [regularizedL,ite_eq_right hχ] at h
  change ‖logDeriv χ.LFunction (cdRightLine b L γ u)‖≤C+2*(σ-1)⁻¹ at h
  have hinv : (σ-1)⁻¹=L/b := by dsimp only [σ]; rw [add_sub_cancel_left,inv_div]
  rw [hinv] at h
  apply (div_le_iff₀ hL₀).mpr
  have hC' := mul_le_mul_of_nonneg_left hL hC.le
  calc
    _≤C+2*(L/b) := h
    _≤C*L+2*(L/b) := by linarith only [hC']
    _=(C+2/b)*L := by ring

private theorem cd_rightLine_continuous (b L γ : ℝ) :
    Continuous (cdRightLine b L γ) := by
  have he : cdRightLine b L γ = fun u : ℝ =>
      ((1+b/L:ℝ):ℂ)+((γ+2*Real.pi*u/L:ℝ):ℂ)*I := by
    funext u
    apply Complex.ext <;> simp [cdRightLine,Complex.mul_re,Complex.mul_im]
  rw [he]
  have hright : Continuous (fun u : ℝ => γ+2*Real.pi*u/L) :=
    continuous_const.add ((continuous_const.mul continuous_id).div_const L)
  exact continuous_const.add ((Complex.continuous_ofReal.comp hright).mul_const I)

private theorem cd_continuousAt_logDeriv {f : ℂ → ℂ} {z : ℂ}
    (hf : AnalyticAt ℂ f z) (hf₀ : f z ≠ 0) : ContinuousAt (logDeriv f) z := by
  change ContinuousAt (fun v : ℂ => deriv f v / f v) z
  exact hf.deriv.continuousAt.div hf.continuousAt hf₀

private theorem cd_rightLog_continuous {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχ : χ ≠ 1) {b L γ : ℝ} (hb : 0<b) (hL : 0<L) :
    Continuous (fun u : ℝ=>logDeriv χ.LFunction (cdRightLine b L γ u)) := by
  refine continuous_iff_continuousAt.mpr fun u => ?_
  have hz : 1 < (cdRightLine b L γ u).re := lt_add_of_pos_right _ (div_pos hb hL)
  have hz' : cdRightLine b L γ u ≠ 1 := fun h => hz.not_ge (by rw [h]; norm_num)
  have hnz : χ.LFunction (cdRightLine b L γ u) ≠ 0 :=
    χ.LFunction_ne_zero_of_one_le_re (Or.inr hz') hz.le
  have hA : AnalyticAt ℂ χ.LFunction (cdRightLine b L γ u) :=
    (χ.differentiable_LFunction hχ).analyticAt _
  have hD := cd_continuousAt_logDeriv hA hnz
  exact hD.comp (cd_rightLine_continuous b L γ).continuousAt

set_option maxHeartbeats 1050000 in
/-- The actual positive Fourier average of the log derivative satisfies
the sharp prime-term upper bound, normalized by the scale. -/
theorem cd_prime_average_le {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (hχ : χ≠1)
    {b L γ ω ell H : ℝ} (hb : 0<b) (hL₁ : 1≤L) (hBL : b≤L)
    (hω : 0<ω) (hell : 0<ell) (hH : ell≤H) :
    let G (u : ℝ) := (logDeriv χ.LFunction (cdRightLine b L γ u)).re/L
    Integrable (fun u=>sinhSpectrumWeight ω ell u*G u) ∧
    (∫ u : ℝ,sinhSpectrumWeight ω ell u*G u)≤
      (laplace (sinhTest ω ell) 0).re+((Real.log 4+4)*ω*ell*Real.cosh (H*ω))/L := by
  let w := cdRightLine b L γ
  let F (u : ℝ) := logDeriv χ.LFunction (w u)
  let G (u : ℝ) := (F u).re/L
  let W := 𝓕 (sinhEvenTest ω ell)
  let K := sinhSpectrumWeight ω ell
  have hL := zero_lt_one.trans_le hL₁
  obtain ⟨C,hC,hCapp⟩ := cd_rightLog_bounds
  have hN (u : ℝ) : ‖F u‖≤(C+2/b)*L :=
    (div_le_iff₀ hL).mp (hCapp q χ hχ hb hL₁ hBL u)
  have hF : Continuous F := cd_rightLog_continuous hχ hb hL
  have hW := sinhEvenTest_fourier_integrable hω hell
  have hWF : Integrable (fun u => (-F u)*W u) := by
    refine (hW.norm.const_mul ((C+2/b)*L)).mono' ?_ ?_
    · exact hF.neg.aestronglyMeasurable.mul hW.aestronglyMeasurable
    · filter_upwards with u
      rw [norm_mul,norm_neg]
      exact mul_le_mul_of_nonneg_right (hN u) (norm_nonneg _)
  have hWreal (u : ℝ) : (K u:ℂ)=W u := by
    dsimp only [W,K,sinhSpectrumWeight]
    rw [sinhEvenTest_fourier_eq,Complex.ofReal_re]
  have hExact (u : ℝ) : ((-F u)*W u).re=(-L)*(K u*G u) := by
    rw [←hWreal,Complex.mul_re,Complex.neg_re,Complex.ofReal_re,Complex.ofReal_im,mul_zero,sub_zero]
    dsimp only [G]
    field_simp [hL.ne']
  have hKG : Integrable (fun u=>K u*G u) := by
    have he : (fun u => K u*G u)=(fun u => (-L)⁻¹*((-F u)*W u).re) := by
      funext u
      rw [hExact,←mul_assoc,inv_mul_cancel₀ (neg_ne_zero.mpr hL.ne'),one_mul]
    rw [he]
    exact hWF.re.const_mul _
  refine ⟨hKG,?_⟩
  let s := w 0
  have hs : 1<s.re := lt_add_of_pos_right _ (div_pos hb hL)
  let P := ∑ n∈Finset.Icc 1 ⌊Real.exp (ω*L)⌋₊,
    LSeries.term (twistedCoefficient χ) s n*(sinhTest ω ell (Real.log (n:ℝ)/L):ℂ)
  have hEqLine (u : ℝ) : s+((2*Real.pi*u/L:ℝ):ℂ)*I=w u := by
    apply Complex.ext <;> simp [s,w,cdRightLine,Complex.mul_re,Complex.mul_im]
  have hp := sinh_spectrum_prime_identity χ hω hell hL hs
  change (∫ u : ℝ,(-logDeriv χ.LFunction (s+((2*Real.pi*u/L:ℝ):ℂ)*I))*W u)=P at hp
  simp_rw [hEqLine] at hp
  have hPr : (-L)*(∫ u : ℝ,K u*G u)=P.re := by
    rw [←integral_const_mul]
    simp_rw [←hExact]
    calc
      _=(∫ u : ℝ,(-F u)*W u).re := integral_re hWF
      _=_ := congrArg Complex.re hp
  have hPn : ‖P‖≤L*(laplace (sinhTest ω ell) 0).re+
      (Real.log 4+4)*ω*ell*Real.cosh (H*ω) := sinh_prime_sum_norm_le χ hω hell hH hL hs.le
  have hPRe : -P.re≤‖P‖ := (neg_le_abs _).trans (Complex.abs_re_le_norm _)
  apply le_of_mul_le_mul_right _ hL
  have hRS :
      ((laplace (sinhTest ω ell) 0).re+((Real.log 4+4)*ω*ell*Real.cosh (H*ω))/L)*L =
      L*(laplace (sinhTest ω ell) 0).re+(Real.log 4+4)*ω*ell*Real.cosh (H*ω) := by field_simp [hL.ne']
  rw [hRS]
  change (∫ u : ℝ,K u*G u)*L≤_
  linarith only [hPr,hPRe,hPn]

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachCubicRiesz

open Complex Filter Finset GoldbachPintzNumerics GoldbachSieveSeries
open scoped Topology

set_option maxHeartbeats 1150000 in
/-- The actual principal Gram term is its compact residue with an error
tending to zero uniformly on the moving short cutoff. -/
theorem principal_gram_eventually_residue {w u₀ κ H T ε : ℝ}
    (hw : 0 < w) (hUW : 2*w < u₀) (hκ : 0 ≤ κ) (hH : 0 ≤ H) (hT : 0 ≤ T) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ ρ : ℂ, ρ.re < 1 → (1-ρ.re)*L ≤ H → |ρ.im| ≤ T →
      ∀ η∈Set.Icc 0 κ, ∀ θ : ℕ→ℝ, (∀ d, |θ d|≤1) →
        let U := Real.exp ((u₀+η)*L)
        let W := Real.exp (w*L)
        let χ : DirichletCharacter ℂ q := 1
        let D := Icc 1 ⌊W⌋₊
        let u := fun d => (θ d:ℂ)
        let R := sieveProductPolynomial χ D D u u 1*principalResidueFactor q
        ∀ Y≥U,
        ‖cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) Y-
          cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) U-
          R*gramRieszDifference Y U (1-ρ)‖ ≤ ε := by
  let φ := (u₀-2*w)/2
  let m := (u₀-2*w)/2
  have hφ : 0 < φ := by dsimp only [φ]; positivity [sub_pos.mpr hUW]
  have hm : 0 < m := by dsimp only [m]; positivity [sub_pos.mpr hUW]
  let e := φ/2
  have he : 0<e := by dsimp only [e]; positivity
  obtain ⟨C,hC,hBound⟩ := principal_gram_sub_residue_norm_le he
  let ymax := u₀+κ
  let K := C*(1+T)^(1/2:ℝ)*Real.exp (ymax*H)
  have hK := eventually_scaled_contour_error (K:=K) (c:=m/2) (by positivity) hε
  filter_upwards [hK,eventually_ge_atTop (max 1 (4*H))] with L hSmall hL
  intro q _ hq ρ hρ hGap him η hη θ hθ U W χ D wt R Y hUY
  have hL₁ : 1≤L := (le_max_left _ _).trans hL
  have hL₀ := zero_lt_one.trans_le hL₁
  have hLL : 4*H≤L := (le_max_right _ _).trans hL
  have hRe : 3/4≤ρ.re := by
    have hA := (le_div_iff₀ hL₀).mpr hGap
    have hB : H/L≤1/4 := (div_le_iff₀ hL₀).mpr (by linarith only [hLL])
    linarith only [hA,hB]
  let u := u₀+η
  have hu : 0 < u := by dsimp only [u]; linarith only [hw,hUW,hη.1]
  have hU : 1≤U := Real.one_le_exp (mul_nonneg hu.le hL₀.le)
  have hW : 0≤W := Real.exp_nonneg _
  have hRaw := hBound q hRe hρ him hW hU hUY θ hθ
  have hEq : R*gramRieszDifference Y U (1-ρ)=
      gramRieszDifference Y U (1-ρ)*sieveProductPolynomial χ D D wt wt 1*principalResidueFactor q := by
    dsimp only [R]
    ring
  rw [hEq]
  refine hRaw.trans ?_
  have hx : u≤ymax := by dsimp only [u,ymax]; linarith only [hη.2]
  have hmarg : φ+w+w+m≤u := by dsimp only [φ,m,u]; linarith only [hη.1]
  have hSc := compact_left_scale_le hL₀ (by norm_num : (0:ℝ)≤1/2) hH hu.le hx hGap hmarg
  have hq₀ : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  have hqE : (q:ℝ)^e≤Real.exp (e*L) := by
    rw [Real.rpow_def_of_pos hq₀]
    apply Real.exp_le_exp.mpr
    have hh := mul_le_mul_of_nonneg_right hq he.le
    linarith only [hh]
  have hScale : W*U^(1/2-ρ.re)*(q:ℝ)^e≤Real.exp (ymax*H)*Real.exp (-(m/2)*L) := by
    calc
      _≤W*U^(1/2-ρ.re)*Real.exp (e*L) :=
        mul_le_mul_of_nonneg_left hqE (by positivity)
      _=Real.exp (u*L)^((1-ρ.re)-1/2)*Real.exp ((φ+w+w)*(1/2:ℝ)*L) := by
        dsimp only [U,W,e]
        rw [show (1/2:ℝ)-ρ.re=(1-ρ.re)-1/2 by ring,
          show (φ+w+w)*(1/2:ℝ)*L=w*L+φ/2*L by ring,Real.exp_add]
        ring
      _≤_ := by simpa only [show -m*(1/2:ℝ)=-(m/2) by ring] using hSc
  have hP : 1≤(1+L)^4 := one_le_pow₀ (le_add_of_nonneg_right hL₀.le)
  calc
    _=(C*(1+T)^(1/2:ℝ))*(W*U^(1/2-ρ.re)*(q:ℝ)^e) := by ring
    _≤(C*(1+T)^(1/2:ℝ))*(Real.exp (ymax*H)*Real.exp (-(m/2)*L)) :=
      mul_le_mul_of_nonneg_left hScale (by positivity)
    _=K*Real.exp (-(m/2)*L) := by dsimp only [K]; ring
    _≤K*(1+L)^4*Real.exp (-(m/2)*L) :=
      mul_le_mul_of_nonneg_right (le_mul_of_one_le_right (by positivity) hP) (Real.exp_nonneg _)
    _≤_ := hSmall

end GoldbachCubicRiesz
end

