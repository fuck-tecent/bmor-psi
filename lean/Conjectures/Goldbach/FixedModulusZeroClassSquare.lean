namespace GoldbachSieveSeries

open Finset

theorem lcm_inverse_sqrt_mass (D E : ℕ) :
    (∑ d ∈ Icc 1 D, ∑ e ∈ Icc 1 E, 1 / Real.sqrt (d.lcm e : ℝ)) ≤
      12 * Real.sqrt (D : ℝ) * Real.sqrt (E : ℝ) := by
  let S := Icc 1 D ×ˢ Icc 1 E
  let G := Icc 1 (min D E)
  let gcd (p : ℕ × ℕ) := p.1.gcd p.2
  let f (p : ℕ × ℕ) := (1 : ℝ) / Real.sqrt (p.1.lcm p.2 : ℝ)
  have hmap : (S : Set (ℕ×ℕ)).MapsTo gcd G := by
    intro p hp
    obtain ⟨h1,h2⟩ := mem_product.mp hp
    obtain ⟨hd,hD⟩ := mem_Icc.mp h1
    obtain ⟨he,hE⟩ := mem_Icc.mp h2
    exact mem_Icc.mpr ⟨Nat.gcd_pos_of_pos_left _ hd,
      le_min ((Nat.gcd_le_left _ hd).trans hD) ((Nat.gcd_le_right _ he).trans hE)⟩
  have hsumg (g : ℕ) (hg : g ∈ G) :
      (∑ p ∈ S.filter (fun p => gcd p = g), f p) ≤
        (4*Real.sqrt (D:ℝ)*Real.sqrt (E:ℝ))*(1/((g:ℝ)*Real.sqrt (g:ℝ))) := by
    let F := S.filter (fun p => gcd p = g)
    let R := Icc 1 (D/g) ×ˢ Icc 1 (E/g)
    let h (p : ℕ × ℕ) := (p.1/g,p.2/g)
    let b (p : ℕ × ℕ) := (1/Real.sqrt (g:ℝ))*(1/Real.sqrt (p.1:ℝ))*(1/Real.sqrt (p.2:ℝ))
    have hgp : 0 < g := (mem_Icc.mp hg).1
    have hgR : (0:ℝ) < g := by exact_mod_cast hgp
    have hdiv (p : ℕ × ℕ) (hp : p ∈ F) : g ∣ p.1 ∧ g ∣ p.2 := by
      rw [← (mem_filter.mp hp).2]
      exact ⟨Nat.gcd_dvd_left _ _,Nat.gcd_dvd_right _ _⟩
    have hR : F.image h ⊆ R := by
      intro p hp
      obtain ⟨q,hq,rfl⟩ := mem_image.mp hp
      obtain ⟨h1,h2⟩ := mem_product.mp (mem_filter.mp hq).1
      obtain ⟨ha,hD⟩ := mem_Icc.mp h1
      obtain ⟨hb,hE⟩ := mem_Icc.mp h2
      obtain ⟨ha',hb'⟩ := hdiv q hq
      refine mem_product.mpr ⟨mem_Icc.mpr ⟨?_,Nat.div_le_div_right hD⟩,
        mem_Icc.mpr ⟨?_,Nat.div_le_div_right hE⟩⟩
      · exact (Nat.le_div_iff_mul_le hgp).mpr (by simp [Nat.le_of_dvd ha ha'])
      · exact (Nat.le_div_iff_mul_le hgp).mpr (by simp [Nat.le_of_dvd hb hb'])
    have hinj : Set.InjOn h F := by
      intro p hp q hq heq
      apply Prod.ext
      · have hh := congrArg (fun z : ℕ×ℕ => z.1 * g) heq
        simpa only [h,Nat.div_mul_cancel (hdiv p hp).1,Nat.div_mul_cancel (hdiv q hq).1] using hh
      · have hh := congrArg (fun z : ℕ×ℕ => z.2 * g) heq
        simpa only [h,Nat.div_mul_cancel (hdiv p hp).2,Nat.div_mul_cancel (hdiv q hq).2] using hh
    have hlcm (p : ℕ×ℕ) (hp : p ∈ F) : p.1.lcm p.2 = g*(p.1/g)*(p.2/g) := by
      have hgcd : p.1.gcd p.2 = g := (mem_filter.mp hp).2
      apply Nat.eq_of_mul_eq_mul_right hgp
      calc
        p.1.lcm p.2 * g = p.1 * p.2 := by rw [← hgcd,Nat.lcm_mul_gcd]
        _ = ((p.1/g)*g)*((p.2/g)*g) := by
          rw [Nat.div_mul_cancel (hdiv p hp).1,Nat.div_mul_cancel (hdiv p hp).2]
        _ = _ := by ring
    have heq (p : ℕ×ℕ) (hp : p ∈ F) : f p = b (h p) := by
      unfold f b h
      rw [hlcm p hp]
      push_cast
      rw [Real.sqrt_mul (by positivity), Real.sqrt_mul (by positivity)]
      ring
    have hDg : ((D/g:ℕ):ℝ) ≤ (D:ℝ)/(g:ℝ) :=
      (le_div_iff₀ hgR).mpr (by exact_mod_cast Nat.div_mul_le_self D g)
    have hEg : ((E/g:ℕ):ℝ) ≤ (E:ℝ)/(g:ℝ) :=
      (le_div_iff₀ hgR).mpr (by exact_mod_cast Nat.div_mul_le_self E g)
    let u (n : ℕ) := (1:ℝ)/Real.sqrt (n:ℝ)
    have hgS : 0 < Real.sqrt (g:ℝ) := Real.sqrt_pos.2 hgR
    have hA : (∑ d ∈ Icc 1 (D/g), u d) ≤ 2*(Real.sqrt (D:ℝ)/Real.sqrt (g:ℝ)) := by
      exact (sum_inverse_sqrt_le _).trans (mul_le_mul_of_nonneg_left
        ((Real.sqrt_le_sqrt hDg).trans_eq (Real.sqrt_div (Nat.cast_nonneg D) _)) (by norm_num))
    have hB : (∑ e ∈ Icc 1 (E/g), u e) ≤ 2*(Real.sqrt (E:ℝ)/Real.sqrt (g:ℝ)) := by
      exact (sum_inverse_sqrt_le _).trans (mul_le_mul_of_nonneg_left
        ((Real.sqrt_le_sqrt hEg).trans_eq (Real.sqrt_div (Nat.cast_nonneg E) _)) (by norm_num))
    change (∑ p ∈ F, f p) ≤ _
    calc
      _ = ∑ p ∈ F, b (h p) := sum_congr rfl heq
      _ = ∑ p ∈ F.image h, b p := (sum_image hinj).symm
      _ ≤ ∑ p ∈ R, b p := sum_le_sum_of_subset_of_nonneg hR (fun _ _ _ => by dsimp [b]; positivity)
      _ = (1/Real.sqrt (g:ℝ))*(∑ d ∈ Icc 1 (D/g), u d)*(∑ e ∈ Icc 1 (E/g), u e) := by
        unfold R
        rw [sum_product]
        simp only [Finset.mul_sum,Finset.sum_mul]
        rw [sum_comm]
      _ ≤ (1/Real.sqrt (g:ℝ))*(2*(Real.sqrt (D:ℝ)/Real.sqrt (g:ℝ)))*
          (2*(Real.sqrt (E:ℝ)/Real.sqrt (g:ℝ))) :=
        mul_le_mul (mul_le_mul_of_nonneg_left hA (by positivity)) hB
          (sum_nonneg (fun _ _ => by dsimp [u]; positivity)) (by positivity)
      _ = _ := by
        have hsq : (Real.sqrt (g:ℝ))^2 = g := Real.sq_sqrt hgR.le
        calc
          _ = (4*Real.sqrt (D:ℝ)*Real.sqrt (E:ℝ)) / ((Real.sqrt (g:ℝ))^2*Real.sqrt (g:ℝ)) := by ring
          _ = _ := by rw [hsq]; ring
  change (∑ d ∈ Icc 1 D, ∑ e ∈ Icc 1 E, f (d,e)) ≤ _
  rw [← sum_product]
  change (∑ p ∈ S, f p) ≤ _
  rw [← sum_fiberwise_of_maps_to hmap]
  refine (sum_le_sum hsumg).trans ?_
  rw [← mul_sum]
  exact (mul_le_mul_of_nonneg_left (sum_inverse_mul_sqrt_le (min D E)) (by positivity)).trans_eq
    (by ring)

end GoldbachSieveSeries

end

