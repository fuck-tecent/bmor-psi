{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "problem": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "parent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^L-[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "statement_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "statement_sha256"
      ],
      "additionalProperties": false
    },
    "motivation": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^L-[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "plain_statement": {
            "type": "object",
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "zh",
              "en"
            ],
            "additionalProperties": false
          },
          "brief": {
            "type": "object",
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "zh",
              "en"
            ],
            "additionalProperties": false
          },
          "source": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "program": {
            "type": "string",
            "minLength": 1
          },
          "reductions": {
            "type": "boolean"
          },
          "parallel": {
            "type": "boolean"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L-[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "uniqueItems": true
          },
          "route": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "plain_statement",
          "brief",
          "source",
          "program",
          "parallel",
          "assumptions",
          "depends_on",
          "route"
        ],
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "input",
              "exploration",
              "sufficient_reduction"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L-[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "output": {
            "type": "string",
            "pattern": "^L-[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "explanation": {
            "type": "object",
            "properties": {
              "zh": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "zh",
              "en"
            ],
            "additionalProperties": false
          },
          "bridge": {
            "type": "string",
            "pattern": "^L-[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "required": [
          "kind",
          "inputs",
          "output",
          "explanation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "sufficient_reduction"
                }
              }
            },
            "then": {
              "required": [
                "bridge"
              ]
            }
          }
        ]
      }
    },
    "route_note": {
      "type": "object",
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "zh",
        "en"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "problem",
    "base_revision",
    "request_id",
    "parent",
    "motivation",
    "tasks",
    "links",
    "route_note"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
