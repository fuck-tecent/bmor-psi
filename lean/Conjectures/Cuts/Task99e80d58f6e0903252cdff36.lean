      (fun t : ℝ => (1 + t ^ d / Real.log D) ^ (t - 1)) (Icc s σ) :=
    hbase.rpow (continuousOn_id.sub continuousOn_const)
      (fun t ht => Or.inl (ne_of_gt (hbasePos t ht)))
