FROM docker.m.daocloud.io/jenkins/jenkins@sha256:4d85f6cf5a8939647921564952d12a5a761f32a3bc520c2f4e5c3cafa7ea660f
USER root
ARG DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
ARG DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
RUN sed -i -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
    -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::https::Timeout=20 -o Acquire::Retries=2 update \
    && apt-get install -y --no-install-recommends nodejs python3 python3-venv \
    && python3 -m venv /opt/site-python \
    && /opt/site-python/bin/pip install --no-cache-dir 'Pillow>=12,<13' \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/site-python/bin:${PATH}"
USER jenkins
ENTRYPOINT []
