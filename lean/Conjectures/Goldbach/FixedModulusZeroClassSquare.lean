noncomputable section

private theorem logHeight_le_in_polylog_window {q : ℕ} [NeZero q] {L p t : ℝ}
    (hL : 1≤L) (hp : 0≤p) (hq : Real.log (q:ℝ)≤L) (ht : |t|≤2*L^p) :
    logHeight q t≤(p+9)*L := by
  have hL₀ := zero_lt_one.trans_le hL
  have hLp := Real.one_le_rpow hL hp
  have hq₀ : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  change Real.log ((2:ℝ)*(q:ℝ)*(2+|t|))≤(p+9)*L
  have hSize : (2:ℝ)*(q:ℝ)*(2+|t|)≤8*(q:ℝ)*L^p := by
    have := mul_le_mul_of_nonneg_left (show 2+|t|≤4*L^p by linarith only [ht,hLp])
      (show 0≤(2:ℝ)*(q:ℝ) by positivity)
    nlinarith only [this]
  have hlog : Real.log ((2:ℝ)*(q:ℝ)*(2+|t|))≤Real.log (8*(q:ℝ)*L^p) :=
    Real.log_le_log (by positivity) hSize
  rw [Real.log_mul (by positivity) (Real.rpow_pos_of_pos hL₀ _).ne',
    Real.log_mul (by norm_num) hq₀.ne',Real.log_rpow hL₀] at hlog
  have h8 : Real.log 8≤7 := by
    have h := Real.log_le_sub_one_of_pos (show (0:ℝ)<8 by norm_num)
    norm_num at h
    exact h
  have hLL : Real.log L≤L :=
    (Real.log_le_sub_one_of_pos hL₀).trans (sub_le_self _ (by norm_num))
  have hpL := mul_le_mul_of_nonneg_left hLL hp
  linarith only [hlog,h8,hq,hpL,hL]

private theorem double_polylog_height_le_next {L p : ℝ} (hL : 2≤L) :
    2*L^p≤L^(p+1) := by
  have hL₀ : 0<L := by linarith only [hL]
  rw [Real.rpow_add hL₀,Real.rpow_one,mul_comm 2]
  exact mul_le_mul_of_nonneg_left hL (Real.rpow_nonneg hL₀.le _)

/-- The actual sharp nonprincipal test, packaged at the common Gram anchor
and with a window wide enough for all differences of selected ordinates. -/
theorem rational_nonprincipal_test_eventually_at_gram_anchor
    {η b anchor p φ D : ℝ} (hη : 0<η) (hb : 0<b) (hba : anchor<b)
    (hp : 0≤p) (hφ : 0≤φ) (hD : 0≤D) :
    ∃ r : ℝ, 0<r ∧ r≤1/32 ∧
      ∀ᶠ L : ℝ in atTop,
      ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
        ∀ (χ : DirichletCharacter ℂ q), χ≠1 →
        ∀ {t Q : ℝ}, |t|≤2*L^p → 1≤Q →
        (∀ z : ℂ, 3/4 ≤ z.re → z.re ≤ 3/2 → |z.im| ≤ L^(p+1)+1 →
          ‖χ.LFunction z‖≤L^D*Q^(φ*max 0 (1-z.re))) →
        (∀ ρ : ℂ, regularizedL χ ρ=0 → |ρ.im-t| ≤ 1 → ρ.re ≤ 1-anchor/L) →
        ∃ V : Finset ℂ,
          (∀ ρ : ℂ, ‖ρ-line 1 t‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
          ∀ U : Finset ℂ, U⊆V →
            (rationalPrimeTest χ b L (line (1-anchor/L) t)).re ≤
              φ*Real.log Q/2+η*L-L*∑ ρ∈U,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
                (rationalZeroKernel b ((L:ℂ)*(line (1-anchor/L) t-ρ))).re := by
  have hκ := sub_pos.mpr hba
  obtain ⟨r,L₀,hr,hrBound,hL₀,hTest⟩ :=
    rational_prime_test_sharp_with_window (K:=p+9) (D:=D) (κ:=b-anchor) (C:=b-anchor)
      hη hκ hb (by positivity) hD hκ.le
  refine ⟨r,hr,hrBound,?_⟩
  filter_upwards [eventually_ge_atTop (max 2 L₀)] with L hL q _ hq χ hχ t Q ht hQ hStrip hNoRight
  have hL₂ : 2≤L := (le_max_left _ _).trans hL
  have hL₀' : L₀≤L := (le_max_right _ _).trans hL
  have hL₁ : 1≤L := hL₀.trans hL₀'
  have hLpos := zero_lt_one.trans_le hL₁
  let s := line (1-anchor/L) t
  let B := L^D
  let T := L^(p+1)+1
  have hsRe : s.re=1-anchor/L := by simp [s,line]
  have hsIm : s.im=t := by simp [s,line]
  have hShift : s.re+b/L=1+(b-anchor)/L := by rw [hsRe,sub_div]; ring
  have hLarge := double_polylog_height_le_next (p:=p) hL₂
  have htT : |s.im|+1/4≤T := by rw [hsIm]; unfold T; linarith only [ht,hLarge]
  have hHeight : logHeight q s.im≤(p+9)*L := by
    rw [hsIm]
    exact logHeight_le_in_polylog_window hL₁ hp hq ht
  have hB : 1≤B := Real.one_le_rpow hL₁ hD
  have hBlog : Real.log B≤D*Real.log L := by unfold B; rw [Real.log_rpow hLpos]
  obtain ⟨V,hV,hCover,hResult⟩ :=
    hTest q χ hχ hL₀' hShift.ge hShift.le htT hHeight hφ hB hQ hBlog hStrip
  refine ⟨V,by simpa only [hsIm] using hCover,?_⟩
  intro U hU
  apply hResult U hU
  intro ρ hρ _
  obtain ⟨hZ,_,hDist⟩ := hV ρ hρ
  have hRho : |ρ.im-t|≤2*r := by
    have hz := Complex.abs_im_le_norm (ρ-line 1 s.im)
    simpa [line,hsIm,Complex.mul_im] using hz.trans hDist
  rw [hsRe]
  exact hNoRight ρ hZ (hRho.trans (by linarith only [hrBound]))

/-- The principal test at the Gram anchor, including the full complex
pole and a uniform positive error after normalization. -/
theorem rational_principal_test_eventually_at_gram_anchor
    {δ b anchor p : ℝ} (hδ : 0<δ) (hb : 0<b) (hba : anchor<b)
    (ha : 0≤anchor) (hp : 0≤p) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
      ∀ t : ℝ, |t|≤2*L^p →
        (rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line (1-anchor/L) t)).re ≤
          L*realRationalZeroKernel b (-anchor)*
            (principalRationalPair b anchor (L*t)+δ) := by
  let F := realRationalZeroKernel b (-anchor)
  have hF : 0<F := realRationalZeroKernel_pos hb (by linarith only [hba])
  filter_upwards [eventually_ge_atTop (2:ℝ),
    rational_prime_test_principal_upper_eventually (ε:=δ*F) (K:=anchor) (p:=p+1)
      (mul_pos hδ hF) hb ha (by positivity)] with L hL hTest q _ hq t ht
  have hL₀ : 0<L := by linarith only [hL]
  let s := line (1-anchor/L) t
  have hsRe : s.re=1-anchor/L := by simp [s,line]
  have hsIm : s.im=t := by simp [s,line]
  have hLo : 1-anchor/L≤ s.re := hsRe.ge
  have hHi : s.re≤1+anchor/L := by
    rw [hsRe]
    linarith only [div_nonneg ha hL₀.le]
  have hTime : |s.im|≤L^(p+1) := by rw [hsIm]; exact ht.trans (double_polylog_height_le_next hL)
  have hShift : 1 < s.re+b/L := by
    rw [hsRe]
    have := div_pos (sub_pos.mpr hba) hL₀
    rw [sub_div] at this
    linarith
  have h := hTest q s hq hLo hHi hTime hShift
  have hShiftK : (L:ℂ)*(s-1)=(((-anchor:ℝ):ℂ))+((L*t:ℝ):ℂ)*I := by
    dsimp only [s]
    rw [zeroKernel_shift_eq hL₀.ne']
    simp [zeroLossAt]
  rw [hShiftK] at h
  refine h.trans_eq ?_
  let K := (rationalZeroKernel b (((-anchor:ℝ):ℂ)+((L*t:ℝ):ℂ)*I)).re
  change L*K+δ*F*L=L*F*(K/F+δ)
  field_simp [hF.ne']

end
end GoldbachPintzWeightedGram
