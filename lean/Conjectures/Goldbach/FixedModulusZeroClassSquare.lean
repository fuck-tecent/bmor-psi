/-- The real Gram quadratic form for fixed real coefficients is nonnegative. -/
theorem fixed_coeff_real_gram_nonneg {α ι : Type*} (S : Finset α) (I : Finset ι)
    (w : α → ℝ) (b : ι → α → ℂ) (c : ι → ℝ) (hw : ∀ x∈S, 0≤w x) :
    0≤(∑ i∈I,∑ j∈I,(c i:ℂ)*(c j:ℂ)*weightedDot S w (b i) (b j)).re := by
  let v (x : α) := ∑ i∈I,(c i:ℂ)*b i x
  have hRight (u : α → ℂ) :
      weightedDot S w u v=∑ i∈I,(c i:ℂ)*weightedDot S w u (b i) := by
    simp only [weightedDot,v,map_sum,map_mul,Complex.conj_ofReal,mul_sum]
    rw [sum_comm]
    exact sum_congr rfl (fun i _ => sum_congr rfl (fun _ _ => by ring))
  have hLeft (u : α → ℂ) :
      weightedDot S w v u=∑ i∈I,(c i:ℂ)*weightedDot S w (b i) u := by
    simp only [weightedDot,v,mul_sum,sum_mul]
    rw [sum_comm]
    exact sum_congr rfl (fun i _ => sum_congr rfl (fun _ _ => by ring))
  have hGram : weightedDot S w v v=∑ i∈I, ∑ j∈I,(c i:ℂ)*(c j:ℂ)*weightedDot S w (b i) (b j) := by
    rw [hLeft]
    apply sum_congr rfl
    intro i _
    simp only [hRight,mul_sum,mul_assoc]
  rw [←hGram,weightedDot_self,Complex.ofReal_re]
  exact sum_nonneg fun x hx => mul_nonneg (hw x hx) (sq_nonneg _)

private theorem norm_fixed_weighted_detector_lower {ι : Type*} (I : Finset ι)
    (c : ι → ℝ) (hc : ∀ i∈I,0≤c i) (d : ι → ℂ) {ε : ℝ}
    (hD : ∀ i∈I, ‖d i+1‖≤ε) :
    (1-ε)*(∑ i∈I,c i)≤‖∑ i∈I,(c i:ℂ)*d i‖ := by
  let W := ∑ i∈I,c i
  let X := ∑ i∈I,(c i:ℂ)*d i
  let Y := ∑ i∈I,(c i:ℂ)*(d i+1)
  have hY : Y = X+(W:ℂ) := by
    simp only [Y,X,W,mul_add,mul_one,sum_add_distrib,Complex.ofReal_sum]
  have hNorm : ‖Y‖≤ε*W := by
    refine (norm_sum_le _ _).trans ?_
    rw [mul_sum]
    refine sum_le_sum fun i hi => ?_
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (hc i hi)]
    exact (mul_le_mul_of_nonneg_left (hD i hi) (hc i hi)).trans_eq (mul_comm _ _)
  have hW : (0:ℝ)≤W := sum_nonneg hc
  have hT : W≤‖Y‖+‖X‖ := by
    have hSub : Y-X=(W:ℂ) := by rw [hY]; ring
    have hd := norm_sub_le Y X
    rw [hSub,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hW] at hd
    exact hd
  change (1-ε)*W≤‖X‖
  linarith only [hT,hNorm]

set_option maxHeartbeats 850000 in
/-- Finite averaging preserves one fixed complex Halász quadratic form. -/
theorem fixed_coeff_gram_finite_average {α ι τ : Type*} (E : Finset τ) (I : Finset ι)
    (S : τ → Finset α) (μ : τ → ℝ) (w : τ → α → ℝ) (a : τ → α → ℂ)
    (b : τ → ι → α → ℂ) (c : ι → ℝ) {ε C : ℝ}
    (hε : ε≤1) (hμ : ∀ k∈E,0≤μ k) (hμ₁ : ∑ k∈E,μ k=1)
    (hw : ∀ k∈E,∀ x∈S k,0≤w k x) (hc : ∀ i∈I,0≤c i)
    (hLow : ∀ k∈E,∀ i∈I,‖weightedDot (S k) (w k) (a k) (b k i)+1‖≤ε)
    (hEnergy : ∀ k∈E,weightedSquare (S k) (w k) (a k)≤C) :
    ((1-ε)*(∑ i∈I,c i))^2≤
      C*(∑ i∈I,∑ j∈I,(c i:ℂ)*(c j:ℂ)*
        (∑ k∈E,(μ k:ℂ)*weightedDot (S k) (w k) (b k i) (b k j))).re := by
  let Gram (k : τ) := ∑ i∈I,∑ j∈I,(c i:ℂ)*(c j:ℂ)*weightedDot (S k) (w k) (b k i) (b k j)
  let D := ((1-ε)*(∑ i∈I,c i))^2
  have hW : 0≤(∑ i∈I,c i) := sum_nonneg hc
  have hPoint (k : τ) (hk : k∈E) : D≤C*(Gram k).re := by
    have hD := norm_fixed_weighted_detector_lower I c hc _ (hLow k hk)
    have hD₀ : 0≤(1-ε)*(∑ i∈I,c i) := mul_nonneg (sub_nonneg.mpr hε) hW
    have hSq := pow_le_pow_left₀ hD₀ hD 2
    have hG := fixed_coeff_gram (S k) I (w k) (a k) (b k) c (hw k hk)
    apply hSq.trans (hG.trans _)
    exact mul_le_mul_of_nonneg_right (hEnergy k hk)
      (fixed_coeff_real_gram_nonneg (S k) I (w k) (b k) c (hw k hk))
  have hA : D≤C*(∑ k∈E, μ k*(Gram k).re) := by
    calc
      D=(∑ k∈E,μ k)*D := by rw [hμ₁,one_mul]
      _=∑ k∈E,μ k*D := by rw [sum_mul]
      _≤∑ k∈E,μ k*(C*(Gram k).re) := sum_le_sum fun k hk =>
        mul_le_mul_of_nonneg_left (hPoint k hk) (hμ k hk)
      _=_ := by simp only [mul_sum]; exact sum_congr rfl fun _ _ => by ring
  refine hA.trans_eq ?_
  congr 1
  have hComplex : (∑ k∈E,(μ k:ℂ)*Gram k)=∑ i∈I,∑ j∈I,(c i:ℂ)*(c j:ℂ)*
      (∑ k∈E,(μ k:ℂ)*weightedDot (S k) (w k) (b k i) (b k j)) := by
    simp only [Gram,mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro i _
    rw [sum_comm]
    exact sum_congr rfl fun j _ => sum_congr rfl fun k _ => by ring
  rw [←hComplex,Complex.re_sum]
  exact sum_congr rfl fun k _ => by simp [Complex.mul_re]

end GoldbachHalasz
end

section
namespace GoldbachPintzNumerics

open Set MeasureTheory
open scoped Interval

private noncomputable def laplaceWindow (ω y : ℝ) : ℝ := (1-Real.exp (-ω*y))/y

private theorem laplaceWindow_integral {ω y : ℝ} (hy : 0 < y) :
    laplaceWindow ω y = ∫ t in (0:ℝ)..ω, Real.exp (-y*t) := by
  have hP (t : ℝ) : HasDerivAt (fun v : ℝ => Real.exp (-y*v)/(-y)) (Real.exp (-y*t)) t := by
    convert ((hasDerivAt_id t).const_mul (-y)).exp.div_const (-y) using 1
    · rfl
    · rw [id_eq,mul_one,mul_div_cancel_right₀ _ (neg_ne_zero.mpr hy.ne')]
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hP t)
    (Continuous.intervalIntegrable (by fun_prop) _ _)]
  simp only [laplaceWindow,mul_zero,Real.exp_zero]
  rw [mul_comm (-y) ω]
  ring

private theorem laplaceWindow_nonneg {ω y : ℝ} (hω : 0 ≤ ω) (hy : 0 < y) :
    0 ≤ laplaceWindow ω y := by
  rw [laplaceWindow_integral hy]
  exact intervalIntegral.integral_nonneg hω fun t _ => Real.exp_nonneg _

private theorem laplaceWindow_antitone {ω y z : ℝ} (hω : 0 ≤ ω) (hy : 0 < y) (hyz : y ≤ z) :
    laplaceWindow ω z ≤ laplaceWindow ω y := by
  rw [laplaceWindow_integral hy,laplaceWindow_integral (hy.trans_le hyz)]
  refine intervalIntegral.integral_mono_on hω (Continuous.intervalIntegrable (by fun_prop) _ _)
    (Continuous.intervalIntegrable (by fun_prop) _ _) fun t ht => Real.exp_le_exp.mpr ?_
  have h := mul_le_mul_of_nonneg_right hyz ht.1
  linarith only [h]

private theorem centeredWindow_integral {ω y : ℝ} (hy : 0 < y) :
    Real.exp (ω*y/2)*laplaceWindow ω y = ∫ t in (0:ℝ)..(ω/2), 2*Real.cosh (y*t) := by
  have hP (t : ℝ) : HasDerivAt (fun v : ℝ => 2*Real.sinh (y*v)/y) (2*Real.cosh (y*t)) t := by
    convert ((((hasDerivAt_id t).const_mul y).sinh).const_mul 2).div_const y using 1
    · rfl
    · simp only [id_eq,mul_one]
      field_simp [hy.ne']
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hP t)
    (Continuous.intervalIntegrable (by fun_prop) _ _)]
  simp only [mul_zero,Real.sinh_zero,zero_div,sub_zero,laplaceWindow]
  rw [Real.sinh_eq, show y*(ω/2)=ω*y/2 by ring]
  rw [← mul_div_assoc,mul_sub,mul_one,← Real.exp_add,show ω*y/2 + -ω*y = -(ω*y/2) by ring]
  ring

private theorem centeredWindow_mono {ω y z : ℝ} (hω : 0 ≤ ω) (hy : 0 < y) (hyz : y ≤ z) :
    Real.exp (ω*y/2)*laplaceWindow ω y ≤ Real.exp (ω*z/2)*laplaceWindow ω z := by
  rw [centeredWindow_integral hy,centeredWindow_integral (hy.trans_le hyz)]
  refine intervalIntegral.integral_mono_on (by positivity)
    (Continuous.intervalIntegrable (by fun_prop) _ _) (Continuous.intervalIntegrable (by fun_prop) _ _)
    fun t ht => mul_le_mul_of_nonneg_left (Real.cosh_le_cosh.mpr ?_) (by norm_num)
  rw [abs_of_nonneg (mul_nonneg hy.le ht.1),abs_of_nonneg (mul_nonneg (hy.le.trans hyz) ht.1)]
  exact mul_le_mul_of_nonneg_right hyz ht.1

private theorem densityMomentScalar_eq (φ ω y : ℝ) :
    densityMomentScalar φ ω y = (φ/2)*laplaceWindow (2*ω) y+(laplaceWindow ω y)^2 := by
  simp only [densityMomentScalar,laplaceWindow]
  rw [neg_mul]

private theorem densityMomentScalar_antitone {φ ω y z : ℝ} (hφ : 0 ≤ φ) (hω : 0 ≤ ω)
    (hy : 0 < y) (hyz : y ≤ z) : densityMomentScalar φ ω z ≤ densityMomentScalar φ ω y := by
  rw [densityMomentScalar_eq,densityMomentScalar_eq]
  exact add_le_add (mul_le_mul_of_nonneg_left (laplaceWindow_antitone (by positivity) hy hyz) (by positivity))
    (pow_le_pow_left₀ (laplaceWindow_nonneg hω (hy.trans_le hyz)) (laplaceWindow_antitone hω hy hyz) 2)

private theorem centered_densityMomentScalar_eq (φ ω y : ℝ) :
    Real.exp (ω*y)*densityMomentScalar φ ω y =
      (φ/2)*(Real.exp ((2*ω)*y/2)*laplaceWindow (2*ω) y)+
        (Real.exp (ω*y/2)*laplaceWindow ω y)^2 := by
  rw [densityMomentScalar_eq,show 2*ω*y/2=ω*y by ring,mul_pow,pow_two (Real.exp _),← Real.exp_add,
    show ω*y/2+ω*y/2=ω*y by ring]
  ring

private theorem centered_densityMomentScalar_mono {φ ω y z : ℝ} (hφ : 0 ≤ φ) (hω : 0 ≤ ω)
    (hy : 0 < y) (hyz : y ≤ z) :
    Real.exp (ω*y)*densityMomentScalar φ ω y ≤ Real.exp (ω*z)*densityMomentScalar φ ω z := by
  rw [centered_densityMomentScalar_eq,centered_densityMomentScalar_eq]
  exact add_le_add (mul_le_mul_of_nonneg_left (centeredWindow_mono (by positivity) hy hyz) (by positivity))
    (pow_le_pow_left₀ (mul_nonneg (Real.exp_nonneg _) (laplaceWindow_nonneg hω hy))
      (centeredWindow_mono hω hy hyz) 2)

/-- The deficit damping puts every same-character row on one common reference
level. It combines Pintz's inequalities (5.32) and (5.34). -/
theorem damped_densityMomentScalar_le {φ ω y Λ ε : ℝ} (hφ : 0 ≤ φ) (hω : 0 ≤ ω)
    (hy : 0 < y) (hΛ : 0 < Λ) (hε : 0 ≤ ε) :
    Real.exp (-ω*max 0 (Λ-y))*(densityMomentScalar φ ω y+ε) ≤ densityMomentScalar φ ω Λ+ε := by
  have hd : Real.exp (-ω*max 0 (Λ-y))*ε ≤ ε :=
    mul_le_of_le_one_left hε (Real.exp_le_one_iff.mpr (by
      have := mul_nonneg hω (le_max_left 0 (Λ-y)); linarith))
  rw [mul_add]
  refine add_le_add ?_ hd
  rcases le_total Λ y with h|h
  · rw [max_eq_left (sub_nonpos.mpr h),mul_zero,Real.exp_zero,one_mul]
    exact densityMomentScalar_antitone hφ hω hΛ h
  · rw [max_eq_right (sub_nonneg.mpr h),show -ω*(Λ-y)= -ω*Λ+ω*y by ring,
      Real.exp_add,mul_assoc]
    calc
      _ ≤ Real.exp (-ω*Λ)*(Real.exp (ω*Λ)*densityMomentScalar φ ω Λ) :=
        mul_le_mul_of_nonneg_left (centered_densityMomentScalar_mono hφ hω hy h) (Real.exp_nonneg _)
      _ = _ := by rw [← mul_assoc, ← Real.exp_add,show -ω*Λ+ω*Λ=0 by ring,Real.exp_zero,one_mul]

end GoldbachPintzNumerics
end

section
namespace GoldbachPintzNumerics

open Finset

/-- The exact deficit-damped spectral weight in the C/D moment. -/
noncomputable def cdMomentWeight (x r κ Λ ell : ℝ) : ℝ :=
  Real.exp (-(2*x)*ell-(r+κ)/2*max 0 (Λ-ell))

set_option maxHeartbeats 1000000 in
/-- Combine the fixed-coefficient averaged Gram bound with its two explicit
formula rows, keeping the detector and discarded Gram errors visible. -/
theorem cdMoment_le_of_averaged_gram {ι : Type*} (S : Finset ι) (ell : ι→ℝ)
    (F G : ι→ι→ℝ) {x r κ Λ φ C B δ τ ε : ℝ}
    (hr : 0≤r) (hκ : 0≤κ) (hΛ : 0<Λ) (hφ : 0≤φ)
    (hC : 0≤C) (hB : 0≤B) (hδ : δ<1) (hε : 0≤ε)
    (hAbsorb : C*τ/(1-δ)^2<1) (hell : ∀ i∈S,0<ell i)
    (hF : ∀ i j,0≤F i j) (hG : ∀ i j,0≤G i j)
    (hFs : ∀ i j,F i j=F j i) (hGs : ∀ i j,G i j=G j i)
    (hRowF : ∀ i∈S, ∑ j∈S,F i j≤densityMomentScalar φ κ (ell i)+ε)
    (hRowG : ∀ i∈S, ∑ j∈S,G i j≤densityMomentScalar φ r (ell i)+ε)
    (hGram :
      let w i := cdMomentWeight x r κ Λ (ell i)
      let a i := w i*Real.exp (x*ell i)
      ((1-δ)*(∑ i∈S,w i))^2≤
        C*(B*(∑ i∈S,∑ j∈S,a i*a j*Real.sqrt (F i j*G i j))+τ*(∑ i∈S,w i)^2)) :
    (∑ i∈S,cdMomentWeight x r κ Λ (ell i))≤
      (C*B/(1-δ)^2)*Real.sqrt (densityMomentScalar φ κ Λ+ε)*
        Real.sqrt (densityMomentScalar φ r Λ+ε)/(1-C*τ/(1-δ)^2) := by
  let w (i : ι) := cdMomentWeight x r κ Λ (ell i)
  let a (i : ι) := w i*Real.exp (x*ell i)
  let d (i : ι) := max 0 (Λ-ell i)
  let d₁ (i : ι) := Real.exp (-κ/2*d i)
  let d₂ (i : ι) := Real.exp (-r/2*d i)
  have hDelta : 0<(1-δ)^2 := pow_pos (sub_pos.mpr hδ) 2
  have hA (i : ι) : (a i)^2=w i*(d₁ i*d₂ i) := by
    dsimp only [a,w,cdMomentWeight,d₁,d₂,d]
    rw [mul_pow,←Real.exp_nat_mul,←Real.exp_nat_mul,←Real.exp_add,
      ←Real.exp_add,←Real.exp_add]
    congr 1
    push_cast
    ring
  have hD₁ (i : ι) : (d₁ i)^2=Real.exp (-κ*max 0 (Λ-ell i)) := by
    dsimp only [d₁,d]
    rw [←Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hD₂ (i : ι) : (d₂ i)^2=Real.exp (-r*max 0 (Λ-ell i)) := by
    dsimp only [d₂,d]
    rw [←Real.exp_nat_mul]
    congr 1
    push_cast
    ring
  have hRF (i : ι) (hi : i∈S) :
      (d₁ i)^2*(∑ j∈S,F i j)≤densityMomentScalar φ κ Λ+ε := by
    rw [hD₁]
    exact (mul_le_mul_of_nonneg_left (hRowF i hi) (Real.exp_nonneg _)).trans
      (damped_densityMomentScalar_le hφ hκ (hell i hi) hΛ hε)
  have hRG (i : ι) (hi : i∈S) :
      (d₂ i)^2*(∑ j∈S,G i j)≤densityMomentScalar φ r Λ+ε := by
    rw [hD₂]
    exact (mul_le_mul_of_nonneg_left (hRowG i hi) (Real.exp_nonneg _)).trans
      (damped_densityMomentScalar_le hφ hr (hell i hi) hΛ hε)
  have hGram' : (∑ i∈S,w i)^2≤
      (C*B/(1-δ)^2)*(∑ i∈S,∑ j∈S,a i*a j*Real.sqrt (F i j*G i j))+
        (C*τ/(1-δ)^2)*(∑ i∈S,w i)^2 := by
    let X := ∑ i∈S,w i
    let Y := ∑ i∈S,∑ j∈S,a i*a j*Real.sqrt (F i j*G i j)
    change ((1-δ)*X)^2≤C*(B*Y+τ*X^2) at hGram
    change X^2≤C*B/(1-δ)^2*Y+C*τ/(1-δ)^2*X^2
    calc
      _ ≤ (C*(B*Y+τ*X^2))/(1-δ)^2 := by
        apply (le_div_iff₀ hDelta).mpr
        nlinarith only [hGram]
      _ = _ := by ring
  exact weighted_moment_of_averaged_gram S w a d₁ d₂ F G
    (div_nonneg (mul_nonneg hC hB) hDelta.le) hAbsorb
    (fun _ _=>Real.exp_nonneg _) hF hG hFs hGs
    (fun _ _=>Real.exp_nonneg _) (fun _ _=>Real.exp_nonneg _)
    (fun i _=>hA i) hRF hRG hGram'

end GoldbachPintzNumerics
end

section
namespace GoldbachPintzNumerics

open Complex Finset GoldbachHalasz
noncomputable section

/-- Replace every averaged complex Gram entry by its positive window bound
with one uniform error on the original fixed coefficient family. -/
theorem real_gram_le_of_window_bounds {ι : Type*} (S : Finset ι)
    (w a : ι→ℝ) (G : ι→ι→ℂ) (F : ι→ι→ℝ) {B τ : ℝ}
    (hw : ∀ i∈S,0 ≤ w i)
    (hG : ∀ i∈S,∀ j∈S,w i*w j*‖G i j‖ ≤ B*(a i*a j*F i j)+τ*(w i*w j)) :
    (∑ i∈S,∑ j∈S,(w i:ℂ)*(w j:ℂ)*G i j).re ≤
      B*(∑ i∈S,∑ j∈S,a i*a j*F i j)+τ*(∑ i∈S,w i)^2 := by
  simp only [Complex.re_sum]
  calc
    _ ≤ ∑ i∈S,∑ j∈S,(B*(a i*a j*F i j)+τ*(w i*w j)) := by
      apply sum_le_sum
      intro i hi
      apply sum_le_sum
      intro j hj
      have hE : ((w i:ℂ)*(w j:ℂ)*G i j).re=w i*w j*(G i j).re := by
        simp only [Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,mul_zero,zero_mul,
          sub_zero,add_zero]
      rw [hE]
      exact (mul_le_mul_of_nonneg_left (Complex.re_le_norm _) (mul_nonneg (hw i hi) (hw j hj))).trans
        (hG i hi j hj)
    _ = _ := by
      simp only [sum_add_distrib,mul_sum,pow_two,sum_mul,mul_assoc]
      congr 1
      exact sum_congr rfl fun i _=>sum_congr rfl fun j _=>by ring

set_option maxHeartbeats 900000 in
/-- The actual finite complex detector Gram reduces to Pintz's two row
bounds with its exact deficit-damped target weight. -/
theorem cdMoment_of_finite_detector_gram {α ι τI : Type*} (P : Finset τI) (I : Finset ι)
    (S : τI → Finset α) (μ : τI → ℝ) (w : τI→α→ℝ) (a : τI→α→ℂ)
    (b : τI→ι→α→ℂ) (ell : ι→ℝ) (F G : ι→ι→ℝ) {x r κ Λ φ C B δ τ ε : ℝ}
    (hr : 0 ≤ r) (hκ : 0 ≤ κ) (hΛ : 0 < Λ) (hφ : 0 ≤ φ)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hδ : δ < 1) (hε : 0 ≤ ε) (hAbsorb : C*τ/(1-δ)^2 < 1)
    (hμ : ∀ k∈P,0 ≤ μ k) (hμ₁ : ∑ k∈P,μ k=1)
    (hw : ∀ k∈P,∀ n∈S k,0 ≤ w k n)
    (hLow : ∀ k∈P,∀ i∈I,‖weightedDot (S k) (w k) (a k) (b k i)+1‖ ≤ δ)
    (hEnergy : ∀ k∈P,weightedSquare (S k) (w k) (a k) ≤ C)
    (hEll : ∀ i∈I,0 < ell i)
    (hF : ∀ i j,0 ≤ F i j) (hG : ∀ i j,0 ≤ G i j)
    (hFs : ∀ i j,F i j=F j i) (hGs : ∀ i j,G i j=G j i)
    (hRowF : ∀ i∈I, ∑ j∈I,F i j≤densityMomentScalar φ κ (ell i)+ε)
    (hRowG : ∀ i∈I, ∑ j∈I,G i j≤densityMomentScalar φ r (ell i)+ε)
    (hEntry : ∀ i∈I,∀ j∈I,
      ‖∑ k∈P,(μ k:ℂ)*weightedDot (S k) (w k) (b k i) (b k j)‖ ≤
      B*Real.exp (x*(ell i+ell j))*Real.sqrt (F i j*G i j)+τ) :
    (∑ i∈I,cdMomentWeight x r κ Λ (ell i)) ≤
      (C*B/(1-δ)^2)*Real.sqrt (densityMomentScalar φ κ Λ+ε)*
        Real.sqrt (densityMomentScalar φ r Λ+ε)/(1-C*τ/(1-δ)^2) := by
  let c (i : ι) := cdMomentWeight x r κ Λ (ell i)
  let A (i : ι) := c i*Real.exp (x*ell i)
  let K (i j : ι) := ∑ k∈P,(μ k:ℂ)*weightedDot (S k) (w k) (b k i) (b k j)
  have hc (i : ι) : 0 ≤ c i := Real.exp_nonneg _
  have hFixed := fixed_coeff_gram_finite_average P I S μ w a b c hδ.le hμ hμ₁ hw
    (fun i _=>hc i) hLow hEnergy
  have hNorm (i : ι) (hi : i∈I) (j : ι) (hj : j∈I) :
      c i*c j*‖K i j‖ ≤ B*(A i*A j*Real.sqrt (F i j*G i j))+τ*(c i*c j) := by
    refine (mul_le_mul_of_nonneg_left (hEntry i hi j hj) (mul_nonneg (hc i) (hc j))).trans_eq ?_
    rw [show x*(ell i+ell j)=x*ell i+x*ell j by ring,Real.exp_add]
    dsimp only [A]
    ring
  have hBnd := real_gram_le_of_window_bounds I c A K (fun i j=>Real.sqrt (F i j*G i j))
    (fun i _=>hc i) hNorm
  exact cdMoment_le_of_averaged_gram I ell F G hr hκ hΛ hφ hC hB hδ hε hAbsorb hEll
    hF hG hFs hGs hRowF hRowG (hFixed.trans (mul_le_mul_of_nonneg_left hBnd hC))

end
end GoldbachPintzNumerics
end

section
namespace GoldbachPintzWeightedFormula

open Complex Finset GoldbachPintzHalasz GoldbachPintzDetector GoldbachPintzTheta
open GoldbachHalasz GoldbachPintzNumerics GoldbachCubicRiesz
open scoped ComplexConjugate Classical

noncomputable section

def cdMeshCutoff (L x κ : ℝ) (N k : ℕ) : ℝ :=
  Real.exp ((x+(k:ℝ)*(κ/N))*L)

def cdGramPoint (L : ℝ) (ρ ζ : ℂ) : ℂ :=
  (L:ℂ)*(2-conj ρ-ζ)

def cdWindowKernel {ι : Type*} {q : ℕ} (L ω : ℝ)
    (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ) (i j : ι) : ℝ :=
  if χ i=χ j then ‖windowLaplace ω (cdGramPoint L (ρ i) (ρ j))‖^2 else 0

theorem cdGramPoint_re (L : ℝ) (ρ ζ : ℂ) :
    (cdGramPoint L ρ ζ).re=(1-ρ.re)*L+(1-ζ.re)*L := by
  unfold cdGramPoint
  simp [Complex.mul_re]
  ring

theorem norm_windowLaplace_conj (ω : ℝ) (z : ℂ) :
    ‖windowLaplace ω (conj z)‖=‖windowLaplace ω z‖ := by
  have h : windowLaplace ω (conj z)=conj (windowLaplace ω z) := by
    simp [windowLaplace,map_div₀,←Complex.exp_conj]
  rw [h,Complex.norm_conj]

theorem cdWindowKernel_symm {ι : Type*} {q : ℕ} (L ω : ℝ)
    (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ) (i j : ι) :
    cdWindowKernel L ω χ ρ i j=cdWindowKernel L ω χ ρ j i := by
  by_cases h : χ i=χ j
  · rw [cdWindowKernel,cdWindowKernel,if_pos h,if_pos h.symm]
    have hz : cdGramPoint L (ρ j) (ρ i)=conj (cdGramPoint L (ρ i) (ρ j)) := by
      simp only [cdGramPoint,map_mul,map_sub,Complex.conj_ofReal,Complex.conj_conj]
      rw [show conj (2:ℂ)=2 from (map_ofNat (starRingEnd ℂ) 2)]
      ring
    rw [hz,norm_windowLaplace_conj]
  · simp only [cdWindowKernel,if_neg h,if_neg (Ne.symm h)]

set_option maxHeartbeats 1800000 in
/-- Normalize the actual compact detector, the fixed-modulus Gram matrix,
and the two kernel rows on one finite cutoff mesh. -/
theorem cdMoment_of_actual_compact_mesh {ι : Type*} {q : ℕ}
    (I : Finset ι) (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ)
    {L u v x w κ H Λ φ C δ τ₀ ε : ℝ} {N : ℕ}
    (hL : 0 < L) (hN : 0 < N) (hκ : 0 < κ) (hw : 0 < w) (hux : u ≤ x)
    (hxκ : 0 ≤ x+κ) (hΛ : 0 < Λ) (hφ : 0 ≤ φ) (hC : 0 ≤ C)
    (hδ : δ < 1) (hε : 0 ≤ ε)
    (hEll : ∀ i∈I,0 < (1-(ρ i).re)*L ∧ (1-(ρ i).re)*L ≤ H)
    (hAbsorb : C*((2/w)*Real.exp ((x+κ)*(2*H))*κ/N+τ₀)/(1-δ)^2 < 1)
    (θ : ℕ→ℝ) (R : ℂ) (hR : ‖R‖ ≤ 1/(w*L))
    (hDet : ∀ k∈range N,∀ i∈I,
      let U := cdMeshCutoff L u κ N k
      let V := cdMeshCutoff L v κ N k
      let W := Real.exp (w*L)
      let Y := cdMeshCutoff L x κ N k
      ‖(∑ n∈support Y,LSeries.term (coefficient (χ i) U V W θ) (ρ i) n*
        (differenceWeight Y U n:ℂ))+1‖ ≤ δ)
    (hEnergy : ∀ k∈range N,
      let U := cdMeshCutoff L u κ N k
      let V := cdMeshCutoff L v κ N k
      let Y := cdMeshCutoff L x κ N k
      (∑ n∈support Y,(realDivisorWeight (support V) (barbanVehov U V) n)^2*
         differenceWeight Y U n/(n:ℝ)) ≤ C)
    (hPrincipal : ∀ k∈range N,∀ i∈I,∀ j∈I,χ i=χ j →
      let U := cdMeshCutoff L u κ N k
      let Y := cdMeshCutoff L x κ N k
      let W := Real.exp (w*L)
      let s := conj (ρ i)+ρ j-1
      ‖(cutoffSum (LSeries.term (gramCoefficient (cdQuotient (χ i) (χ j)) W θ) s) Y-
        cutoffSum (LSeries.term (gramCoefficient (cdQuotient (χ i) (χ j)) W θ) s) U)-
        R*gramRieszDifference Y U (cdGramPoint L (ρ i) (ρ j)/(L:ℂ))‖ ≤ τ₀)
    (hOff : ∀ k∈range N,∀ i∈I,∀ j∈I,χ i≠χ j →
      let U := cdMeshCutoff L u κ N k
      let Y := cdMeshCutoff L x κ N k
      let W := Real.exp (w*L)
      let s := conj (ρ i)+ρ j-1
      ‖cutoffSum (LSeries.term (gramCoefficient (cdQuotient (χ i) (χ j)) W θ) s) Y-
        cutoffSum (LSeries.term (gramCoefficient (cdQuotient (χ i) (χ j)) W θ) s) U‖ ≤ τ₀)
    (hRow₁ : ∀ i∈I, ∑ j∈I,cdWindowKernel L κ χ ρ i j ≤
      densityMomentScalar φ κ ((1-(ρ i).re)*L)+ε)
    (hRow₂ : ∀ i∈I, ∑ j∈I,cdWindowKernel L (x-u) χ ρ i j ≤
      densityMomentScalar φ (x-u) ((1-(ρ i).re)*L)+ε) :
    (∑ i∈I,cdMomentWeight (x+κ) (x-u) κ Λ ((1-(ρ i).re)*L)) ≤
      (C*(1/(w*κ))/(1-δ)^2)*Real.sqrt (densityMomentScalar φ κ Λ+ε)*
        Real.sqrt (densityMomentScalar φ (x-u) Λ+ε)/
          (1-C*((2/w)*Real.exp ((x+κ)*(2*H))*κ/N+τ₀)/(1-δ)^2) := by
  let U (k : ℕ) := cdMeshCutoff L u κ N k
  let V (k : ℕ) := cdMeshCutoff L v κ N k
  let Y (k : ℕ) := cdMeshCutoff L x κ N k
  let W := Real.exp (w*L)
  let S (k : ℕ) := support (Y k)
  let Wt (k n : ℕ) := differenceWeight (Y k) (U k) n/(n:ℝ)
  let a (k n : ℕ) := (realDivisorWeight (support (V k)) (barbanVehov (U k) (V k)) n:ℂ)
  let b (k : ℕ) (i : ι) :=
    detectorVector (realDivisorWeight (support W) θ) (fun n=>χ i (n:ZMod q)) (ρ i)
  let ell (i : ι) := (1-(ρ i).re)*L
  let F := cdWindowKernel L κ χ ρ
  let G := cdWindowKernel L (x-u) χ ρ
  let μ (_ : ℕ) : ℝ := 1/N
  let τ := (2/w)*Real.exp ((x+κ)*(2*H))*κ/N+τ₀
  have hN₀ : (0:ℝ)<N := by exact_mod_cast hN
  have hU (k : ℕ) : 0<U k := Real.exp_pos _
  have hUY (k : ℕ) : U k≤Y k := Real.exp_le_exp.mpr
    (mul_le_mul_of_nonneg_right (add_le_add hux le_rfl) hL.le)
  have hμ (k : ℕ) : 0≤μ k := by dsimp only [μ]; positivity
  have hμSum : ∑ k∈range N,μ k=1 := by
    simp only [μ,sum_const,card_range,nsmul_eq_mul]
    field_simp [hN₀.ne']
  have hWpos (k n : ℕ) : 0≤Wt k n := div_nonneg
    (differenceWeight_bounds (hU k) (hUY k) n).1 (Nat.cast_nonneg _)
  have hD (k : ℕ) (hk : k∈range N) (i : ι) (hi : i∈I) :
      ‖weightedDot (S k) (Wt k) (a k) (b k i)+1‖≤δ := by
    dsimp only [S,Wt,a,b]
    rw [cd_weightedDot_detector_eq]
    exact hDet k hk i hi
  have hE (k : ℕ) (hk : k∈range N) : weightedSquare (S k) (Wt k) (a k)≤C := by
    dsimp only [S,Wt,a]
    rw [weightedSquare_detector]
    exact hEnergy k hk
  have hNN (ω : ℝ) (i j : ι) : 0≤cdWindowKernel L ω χ ρ i j := by
    unfold cdWindowKernel
    split <;> positivity
  have hEntry (i : ι) (hi : i∈I) (j : ι) (hj : j∈I) :
      ‖∑ k∈range N,(μ k:ℂ)*weightedDot (S k) (Wt k) (b k i) (b k j)‖≤
        (1/(w*κ))*Real.exp ((x+κ)*(ell i+ell j))*Real.sqrt (F i j*G i j)+τ := by
    let M (k : ℕ) := weightedDot (S k) (Wt k) (b k i) (b k j)
    let z := cdGramPoint L (ρ i) (ρ j)
    have hzR : z.re=ell i+ell j := cdGramPoint_re L (ρ i) (ρ j)
    have hzp : 0<z.re := by rw [hzR]; exact add_pos (hEll i hi).1 (hEll j hj).1
    have hz₀ : z≠0 := fun e=>hzp.ne' (by rw [e,Complex.zero_re])
    have hzCap : z.re≤2*H := by rw [hzR]; linarith only [(hEll i hi).2,(hEll j hj).2]
    have hExp := Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hzCap hxκ)
    have hMean : (∑ k∈range N,(μ k:ℂ)*M k)=(∑ k∈range N,M k)/(N:ℂ) := by
      rw [div_eq_mul_inv, mul_comm, mul_sum]
      apply sum_congr rfl
      intro k hk
      dsimp only [μ]
      rw [one_div, Complex.ofReal_inv, Complex.ofReal_natCast]
    change ‖∑ k∈range N,(μ k:ℂ)*M k‖≤_
    rw [hMean]
    by_cases hch : χ i=χ j
    · have hap (k : ℕ) (hk : k∈range N) :
          ‖M k-R*gramRieszDifference (Y k) (U k) (z/(L:ℂ))‖≤τ₀ := by
        dsimp only [M,S,Wt,b]
        rw [cd_weightedDot_gram_eq (χ i) (χ j) (ρ i) (ρ j) (hU k) (hUY k)]
        exact hPrincipal k hk i hi j hj hch
      have hh := norm_gram_mean_le_of_residue_approx hL hκ hw hux hz₀ hzp.le hN R hR M hap
      refine hh.trans ?_
      dsimp only [F,G,τ,cdWindowKernel]
      rw [if_pos hch,if_pos hch,Real.sqrt_mul (sq_nonneg _),Real.sqrt_sq (norm_nonneg _),
        Real.sqrt_sq (norm_nonneg _),←hzR]
      change 1/(w*κ)*Real.exp ((x+κ)*z.re)*‖windowLaplace (x-u) z‖*‖windowLaplace κ z‖+
          2/w*Real.exp ((x+κ)*z.re)*κ/N+τ₀ ≤ _
      have hbnd : (2/w)*Real.exp ((x+κ)*z.re)*κ/N≤(2/w)*Real.exp ((x+κ)*(2*H))*κ/N :=
        div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hExp
          (show 0≤2/w by positivity)) hκ.le) hN₀.le
      change _ ≤ 1/(w*κ)*Real.exp ((x+κ)*z.re)*
        (‖windowLaplace κ z‖*‖windowLaplace (x-u) z‖)+
        ((2/w)*Real.exp ((x+κ)*(2*H))*κ/N+τ₀)
      calc
        _ = (1/(w*κ)*Real.exp ((x+κ)*z.re)*
            (‖windowLaplace κ z‖*‖windowLaplace (x-u) z‖))+
            ((2/w)*Real.exp ((x+κ)*z.re)*κ/N+τ₀) := by ring
        _ ≤ _ := add_le_add le_rfl (add_le_add hbnd le_rfl)
    · have hap (k : ℕ) (hk : k∈range N) : ‖M k‖≤τ₀ := by
        dsimp only [M,S,Wt,b]
        rw [cd_weightedDot_gram_eq (χ i) (χ j) (ρ i) (ρ j) (hU k) (hUY k)]
        exact hOff k hk i hi j hj hch
      refine (norm_nonprincipal_gram_mean_le hN M hap).trans ?_
      dsimp only [F,G,τ,cdWindowKernel]
      rw [if_neg hch,if_neg hch,mul_zero,Real.sqrt_zero,mul_zero,zero_add]
      exact le_add_of_nonneg_left (by positivity)
  exact cdMoment_of_finite_detector_gram (range N) I S μ Wt a b ell F G
    (sub_nonneg.mpr hux) hκ.le hΛ hφ hC (by positivity) hδ hε hAbsorb
    (fun k _=>hμ k) hμSum (fun k _ n _=>hWpos k n) hD hE
    (fun i hi=>(hEll i hi).1) (hNN κ) (hNN (x-u))
    (cdWindowKernel_symm L κ χ ρ) (cdWindowKernel_symm L (x-u) χ ρ)
    hRow₁ hRow₂ hEntry

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachSieveSeries

open Finset Complex

/-- Near-one size of a finite LCM polynomial with coefficients bounded by one. -/
theorem norm_lcmPolynomial_near_one_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {D E : ℕ} {H : ℝ} (hH : 1≤H) (hDE : ((D*E:ℕ):ℝ)≤H)
    (u v : ℕ → ℂ) (hu : ∀ d∈Icc 1 D, ‖u d‖≤1) (hv : ∀ e∈Icc 1 E, ‖v e‖≤1)
    (s : ℂ) :
    ‖lcmPolynomial χ (Icc 1 D) (Icc 1 E) u v s‖≤
      H^(max 0 (1-s.re))*(1+Real.log (D+E+1:ℝ))^3 := by
  let p := max 0 (1-s.re)
  have hp : 0≤p := le_max_left _ _
  have hpow : 0≤H^p := Real.rpow_nonneg (zero_le_one.trans hH) _
  change ‖lcmPolynomial χ (Icc 1 D) (Icc 1 E) u v s‖≤H^p*(1+Real.log _ )^3
  unfold lcmPolynomial
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ d∈Icc 1 D, ∑ e∈Icc 1 E, H^p*(1/(d.lcm e:ℝ)) := by
      refine sum_le_sum fun d hd => (norm_sum_le _ _).trans (sum_le_sum fun e he => ?_)
      have hd₀ : 0<d := (mem_Icc.mp hd).1
      have he₀ : 0<e := (mem_Icc.mp he).1
      have hL₀ : 0<d.lcm e := Nat.lcm_pos hd₀ he₀
      have hL₁ : (1:ℝ)≤d.lcm e := by exact_mod_cast hL₀
      have hL : (0:ℝ)<d.lcm e := by exact_mod_cast hL₀
      have hLH : (d.lcm e:ℝ)≤H := by
        have h := (Nat.le_of_dvd (Nat.mul_pos hd₀ he₀) (Nat.lcm_dvd_mul d e)).trans
          (Nat.mul_le_mul (mem_Icc.mp hd).2 (mem_Icc.mp he).2)
        exact (show (d.lcm e:ℝ)≤((D*E:ℕ):ℝ) by exact_mod_cast h).trans hDE
      rw [norm_mul,norm_mul]
      have hprod : ‖u d‖*‖v e‖≤1 := by
        simpa only [mul_one] using mul_le_mul (hu d hd) (hv e he) (norm_nonneg _) (zero_le_one : (0:ℝ)≤1)
      refine (mul_le_of_le_one_left (norm_nonneg _) hprod).trans ?_
      rw [LSeries.norm_term_eq,ite_eq_right hL₀.ne']
      refine (div_le_div_of_nonneg_right (χ.norm_le_one _) (Real.rpow_nonneg hL.le _)).trans ?_
      have heq : 1/(d.lcm e:ℝ)^s.re=(d.lcm e:ℝ)^(1-s.re)*(1/(d.lcm e:ℝ)) := by
        simp only [one_div,←Real.rpow_neg hL.le]
        rw [show ((d.lcm e:ℕ):ℝ)⁻¹=(d.lcm e:ℝ)^(-1:ℝ) by rw [Real.rpow_neg_one],
          ←Real.rpow_add hL]
        congr 1
        ring
      rw [heq]
      exact mul_le_mul_of_nonneg_right
        ((Real.rpow_le_rpow_of_exponent_le hL₁ (le_max_right 0 (1-s.re))).trans
          (Real.rpow_le_rpow hL.le hLH hp)) (by positivity)
    _ = H^p*(∑ d∈Icc 1 D, ∑ e∈Icc 1 E, 1/(d.lcm e:ℝ)) := by
      simp only [mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left (lcm_inverse_mass D E) hpow

end GoldbachSieveSeries
end

section
namespace GoldbachPintzNumerics

open Complex Finset Filter
open GoldbachSieveSeries

open scoped Topology

/-- Margin between the left contour cutoff and the conductor times the LCM scale. -/
theorem compact_left_scale_le {L h φ d e y A Y δ : ℝ}
    (hL : 0<L) (hh : 0≤h) (hA : 0≤A) (hy : 0≤y) (hyY : y≤Y)
    (hδ : δ*L≤A) {m : ℝ} (hm : φ+d+e+m≤y) :
    (Real.exp (y*L))^(δ-h)*Real.exp ((φ+d+e)*h*L)≤Real.exp (Y*A)*Real.exp (-m*h*L) := by
  rw [Real.rpow_def_of_pos (Real.exp_pos _),Real.log_exp,←Real.exp_add,←Real.exp_add]
  apply Real.exp_le_exp.mpr
  have hOne := mul_le_mul_of_nonneg_left hδ hy
  have hTwo := mul_le_mul_of_nonneg_right hyY hA
  have hMargin := mul_le_mul_of_nonneg_right hm (mul_nonneg hh hL.le)
  nlinarith only [hOne,hTwo,hMargin]

/-- A fixed exponential margin absorbs all powers of the logarithmic scale. -/
theorem eventually_scaled_contour_error {K c ε : ℝ} (hc : 0<c) (hε : 0<ε) :
    ∀ᶠ L : ℝ in atTop, K*(1+L)^4*Real.exp (-c*L)≤ε := by
  have h := tendsto_rpow_mul_exp_neg_mul_atTop_nhds_zero (4:ℝ) c hc
  have hShift : Tendsto (fun L : ℝ => 1+L) atTop atTop :=
    tendsto_atTop_add_const_left _ 1 tendsto_id
  have hh := (tendsto_const_nhds (x:=K*Real.exp c)).mul (h.comp hShift)
  change Tendsto (fun L : ℝ => (K*Real.exp c)*((1+L)^(4:ℝ)*Real.exp (-c*(1+L)))) atTop (𝓝 ((K*Real.exp c)*0)) at hh
  rw [mul_zero] at hh
  have hI (L : ℝ) : (K*Real.exp c)*((1+L)^(4:ℝ)*Real.exp (-c*(1+L))) =
      K*(1+L)^4*Real.exp (-c*L) := by
    rw [Real.rpow_ofNat,show -c*(1+L)=-c+(-c*L) by ring,Real.exp_add,Real.exp_neg]
    field_simp [Real.exp_ne_zero c]
  have hLim := hh.congr hI
  filter_upwards [(Metric.tendsto_nhds.1 hLim) ε hε] with L hL
  rw [Real.dist_eq,sub_zero] at hL
  exact (le_abs_self _).trans hL.le

set_option maxHeartbeats 1200000 in
/-- Combine a near-one L-function bound with the finite LCM polynomial. -/
theorem sieve_product_left_line_le' {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {L h φ d e B T : ℝ} (hL : 0≤L) (hh : 0≤h) (hφ : 0≤φ)
    (hd : 0≤d) (he : 0≤e) (hB : 0≤B) (hT : 0≤T) (hq : Real.log (q:ℝ)≤L)
    {ρ : ℂ} {a : ℝ} (ha : ρ.re+a=1-h) (him : |ρ.im|≤T)
    (u v : ℕ → ℂ)
    (hu : ∀ k∈Icc 1 ⌊Real.exp (d*L)⌋₊, ‖u k‖≤1)
    (hv : ∀ k∈Icc 1 ⌊Real.exp (e*L)⌋₊, ‖v k‖≤1)
    (hFun : ∀ t : ℝ, ‖χ.LFunction (ρ+((a:ℂ)+t*I))‖≤
      B*(1+|ρ.im+t|)*(1+L)*(q:ℝ)^(φ*h))
    (t : ℝ) :
    let s := ρ+((a:ℂ)+t*I)
    ‖lcmPolynomial χ (Icc 1 ⌊Real.exp (d*L)⌋₊) (Icc 1 ⌊Real.exp (e*L)⌋₊) u v s*
      χ.LFunction s‖ ≤
      (B*(1+T)*(1+Real.log 3+d+e)^3)*(1+L)^4*Real.exp ((φ+d+e)*h*L)*(1+|t|) := by
  let s := ρ+((a:ℂ)+t*I)
  let D := ⌊Real.exp (d*L)⌋₊
  let E := ⌊Real.exp (e*L)⌋₊
  let H := Real.exp ((d+e)*L)
  let cap := 1+Real.log 3+d+e
  have hq₀ : (0:ℝ)<q := by exact_mod_cast NeZero.pos q
  have hq₁ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hlogQ : 0≤Real.log (q:ℝ) := Real.log_nonneg hq₁
  have hH : 1≤H := Real.one_le_exp_iff.mpr (by positivity)
  have hD : (D:ℝ)≤Real.exp (d*L) := Nat.floor_le (Real.exp_nonneg _)
  have hE : (E:ℝ)≤Real.exp (e*L) := Nat.floor_le (Real.exp_nonneg _)
  have hDE : ((D*E:ℕ):ℝ)≤H := by
    rw [Nat.cast_mul]
    exact (mul_le_mul hD hE (Nat.cast_nonneg _) (Real.exp_nonneg _)).trans_eq
      (by dsimp only [H]; rw [←Real.exp_add]; congr 1; ring)
  have hS : 1-s.re=h := by
    simp only [s,add_re,ofReal_re,mul_re,I_re,I_im,mul_zero,ofReal_im,mul_one,sub_zero,add_zero]
    linarith only [ha]
  have hP := GoldbachSieveSeries.norm_lcmPolynomial_near_one_le χ hH hDE u v hu hv s
  rw [hS,max_eq_right hh,Real.rpow_def_of_pos (Real.exp_pos _),Real.log_exp] at hP
  have hLRE : (D+E+1:ℝ)≤3*H := by
    have hD' : (D:ℝ)≤H := hD.trans (Real.exp_le_exp.mpr (by nlinarith only [mul_nonneg he hL]))
    have hE' : (E:ℝ)≤H := hE.trans (Real.exp_le_exp.mpr (by nlinarith only [mul_nonneg hd hL]))
    linarith only [hD',hE',hH]
  have hLog := Real.log_le_log (by positivity : (0:ℝ)<D+E+1) hLRE
  have h3 : 0≤Real.log 3 := Real.log_nonneg (by norm_num)
  have hFactor : 1+Real.log (D+E+1:ℝ)≤cap*(1+L) := by
    change Real.log (D+E+1:ℝ)≤Real.log (3*Real.exp ((d+e)*L)) at hLog
    rw [Real.log_mul (by norm_num) (Real.exp_ne_zero _),Real.log_exp] at hLog
    dsimp only [cap]
    nlinarith only [hLog,h3,hd,he,hL,mul_nonneg h3 hL]
  have hP' : ‖lcmPolynomial χ (Icc 1 D) (Icc 1 E) u v s‖≤
      Real.exp ((d+e)*L*h)*(cap*(1+L))^3 := by
    refine hP.trans (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ ?_ hFactor 3) (Real.exp_nonneg _))
    exact add_nonneg zero_le_one (Real.log_nonneg (le_add_of_nonneg_left (by positivity)))
  have hQ' : (q:ℝ)^(φ*h)≤Real.exp (φ*h*L) := by
    rw [Real.rpow_def_of_pos hq₀]
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hq (mul_nonneg hφ hh)
    linarith only [h]
  have hHt : 1+|ρ.im+t|≤(1+T)*(1+|t|) := by
    have hab := abs_add_le ρ.im t
    have hN := mul_nonneg hT (abs_nonneg t)
    nlinarith only [hab,him,hN]
  have hLFun : ‖χ.LFunction s‖≤B*((1+T)*(1+|t|))*(1+L)*Real.exp (φ*h*L) := by
    refine (hFun t).trans ?_
    gcongr
  change ‖lcmPolynomial χ (Icc 1 D) (Icc 1 E) u v s*χ.LFunction s‖≤_
  rw [norm_mul]
  calc
    _ ≤ (Real.exp ((d+e)*L*h)*(cap*(1+L))^3)*
      (B*((1+T)*(1+|t|))*(1+L)*Real.exp (φ*h*L)) :=
      mul_le_mul hP' hLFun (norm_nonneg _) (by positivity)
    _ = _ := by
      rw [show (φ+d+e)*h*L=((d+e)*L*h)+(φ*h*L) by ring,Real.exp_add]
      dsimp only [cap]
      ring
set_option maxHeartbeats 1200000 in
/-- Combine a near-one L-function bound with the finite LCM polynomial. -/
theorem sieve_product_left_line_le {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {L h φ d e B T : ℝ} (hL : 0≤L) (hh : 0≤h) (hφ : 0≤φ)
    (hd : 0≤d) (he : 0≤e) (hB : 0≤B) (hT : 0≤T) (hq : Real.log (q:ℝ)≤L)
    {ρ : ℂ} {a : ℝ} (ha : ρ.re+a=1-h) (him : |ρ.im|≤T)
    (u v : ℕ → ℂ)
    (hu : ∀ k∈Icc 1 ⌊Real.exp (d*L)⌋₊, ‖u k‖≤1)
    (hv : ∀ k∈Icc 1 ⌊Real.exp (e*L)⌋₊, ‖v k‖≤1)
    (hFun : ∀ t : ℝ, ‖χ.LFunction (ρ+((a:ℂ)+t*I))‖≤
      B*(1+|ρ.im+t|)*(1+Real.log (q:ℝ))*(q:ℝ)^(φ*h))
    (t : ℝ) :
    let s := ρ+((a:ℂ)+t*I)
    ‖lcmPolynomial χ (Icc 1 ⌊Real.exp (d*L)⌋₊) (Icc 1 ⌊Real.exp (e*L)⌋₊) u v s*
      χ.LFunction s‖ ≤
      (B*(1+T)*(1+Real.log 3+d+e)^3)*(1+L)^4*Real.exp ((φ+d+e)*h*L)*(1+|t|) := by
  have hGrowth (t : ℝ) :
      ‖χ.LFunction (ρ+((a:ℂ)+t*I))‖≤B*(1+|ρ.im+t|)*(1+L)*(q:ℝ)^(φ*h) := by
    refine (hFun t).trans ?_
    gcongr
  exact sieve_product_left_line_le' χ hL hh hφ hd he hB hT hq ha him u v hu hv hGrowth t

end GoldbachPintzNumerics
end

section
namespace GoldbachTypeII

open Complex GoldbachCubicRiesz

/-- Uniform cubic Riesz decay on a left line at distance at least `h` from zero. -/
theorem symbol_left_bound_at {a t h : ℝ} (hh : 0<h) (hh' : h≤1/2)
    (ha₀ : -(1/2:ℝ)≤a) (ha₁ : a≤ -h) :
    ‖symbol ((a:ℂ)+t*I)‖≤(2*(1+h⁻¹)^3)/(1+|t|)^3 := by
  let w : ℂ := (a : ℂ) + t * I
  have hwRe : w.re = a := by simp [w, Complex.mul_re]
  have hwIm : w.im = t := by simp [w, Complex.mul_im]
  have h0 : h ≤ ‖w‖ := by
    have h := Complex.abs_re_le_norm w
    rw [hwRe, abs_of_nonpos (by linarith : a ≤ 0)] at h
    linarith
  have h1 : h ≤ ‖w + 1‖ := by
    have h := Complex.re_le_norm (w + 1)
    simp only [Complex.add_re, Complex.one_re, hwRe] at h
    linarith
  have h2 : h ≤ ‖w + 2‖ := by
    have h := Complex.re_le_norm (w + 2)
    norm_num [Complex.add_re, hwRe] at h
    linarith
  have hi₀ : |t| ≤ ‖w‖ := by simpa [hwIm] using Complex.abs_im_le_norm w
  have hi₁ : |t| ≤ ‖w + 1‖ := by simpa [hwIm] using Complex.abs_im_le_norm (w + 1)
  have hi₂ : |t| ≤ ‖w + 2‖ := by simpa [hwIm] using Complex.abs_im_le_norm (w + 2)
  let C := 1+h⁻¹
  have hN {x : ℝ} (hx : h≤x) (hxt : |t|≤x) : 1+|t|≤C*x := by
    have hInv : 1≤h⁻¹*x := by
      rw [inv_mul_eq_div]
      exact (le_div_iff₀ hh).mpr (by simpa only [one_mul] using hx)
    dsimp only [C]
    linarith only [hInv,hxt]
  have hn₀ := hN h0 hi₀
  have hn₁ := hN h1 hi₁
  have hn₂ := hN h2 hi₂
  have hp : (1+|t|)^3≤C^3*(‖w‖*‖w+1‖*‖w+2‖) := by
    rw [pow_succ,pow_two]
    have hC : 0≤C := by dsimp only [C]; positivity
    exact (mul_le_mul (mul_le_mul hn₀ hn₁ (by positivity) (by positivity)) hn₂
      (by positivity) (by positivity)).trans_eq (by ring)
  have hp₀ : 0 < ‖w‖ * ‖w + 1‖ * ‖w + 2‖ := by
    exact mul_pos (mul_pos (hh.trans_le h0) (hh.trans_le h1)) (hh.trans_le h2)
  change ‖symbol w‖ ≤ _
  rw [symbol, norm_div, norm_mul, norm_mul, Complex.norm_ofNat]
  change 2/(‖w‖*‖w+1‖*‖w+2‖) ≤ (2*C^3)/(1+|t|)^3
  apply (div_le_div_iff₀ hp₀ (by positivity)).mpr
  linarith only [hp]

end GoldbachTypeII
end

section
namespace GoldbachCubicRiesz

open Complex MeasureTheory Filter
noncomputable section

/-- On a fixed left line, cubic Riesz smoothing absorbs linear ordinate growth. -/
theorem norm_left_cubic_integral_le {a h M : ℝ} (hh : 0<h) (hh' : h≤1/2)
    (ha₀ : -(1/2:ℝ)≤a) (ha₁ : a≤ -h) (hM : 0≤M)
    (F : ℝ → ℂ) (hF : ∀ t, ‖F t‖≤M*(1+|t|)) :
    ‖((1/(2*Real.pi):ℝ):ℂ) * ∫ t : ℝ, symbol ((a:ℂ)+t*I)*F t‖≤(1+h⁻¹)^3*M := by
  let C := (1+h⁻¹)^3*M
  let G (t : ℝ) := symbol ((a:ℂ)+t*I)*F t
  have hC : 0≤C := by unfold C; positivity
  have hDom : Integrable (fun t : ℝ => (2*C)*(1+t^2)⁻¹) :=
    integrable_inv_one_add_sq.const_mul _
  have hPoint (t : ℝ) : ‖G t‖≤(2*C)*(1+t^2)⁻¹ := by
    have hT : 0<1+|t| := by positivity
    have hS : 1+t^2≤(1+|t|)^2 := by nlinarith only [sq_abs t,abs_nonneg t]
    calc
      _ ≤ ((2*(1+h⁻¹)^3)/(1+|t|)^3)*(M*(1+|t|)) := by
        dsimp only [G]
        rw [norm_mul]
        exact mul_le_mul (GoldbachTypeII.symbol_left_bound_at hh hh' ha₀ ha₁) (hF t)
          (norm_nonneg _) (by positivity)
      _ = (2*C)*((1+|t|)^2)⁻¹ := by
        dsimp only [C]
        field_simp [hT.ne']
      _ ≤ _ := mul_le_mul_of_nonneg_left (inv_anti₀ (by positivity) hS) (by positivity)
  have hN := norm_integral_le_of_norm_le hDom (Eventually.of_forall hPoint)
  rw [integral_const_mul,integral_univ_inv_one_add_sq] at hN
  change ‖((1/(2*Real.pi):ℝ):ℂ)*(∫ t : ℝ,G t)‖≤C
  rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (by positivity)]
  calc
    _ ≤ (1/(2*Real.pi))*(2*C*Real.pi) :=
      mul_le_mul_of_nonneg_left hN (by positivity)
    _ = _ := by field_simp [Real.pi_ne_zero]

end
end GoldbachCubicRiesz
end

section
namespace GoldbachPintzDetector

open Finset Complex MeasureTheory Filter
open GoldbachPintzTheta GoldbachSieveSeries GoldbachCubicRiesz GoldbachTypeII

noncomputable section

/-- Compact Pintz detector contour on an arbitrary negative Riesz line. -/
theorem cutoff_eq_mellinInv_left {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1)
    {ρ : ℂ} (hρ : χ.LFunction ρ = 0) {a : ℝ} (ha₀ : -(1/2:ℝ)≤a)
    (ha₁ : a<0) (hlo : 1/2≤ρ.re+a) (_hhi : ρ.re≤1)
    (U V W : ℝ) (θ : ℕ → ℝ) {Y B : ℝ} (hY : 1 ≤ Y) (hB : 0 ≤ B)
    (hpoly : ∀ s : ℂ, (1/2 : ℝ) ≤ s.re → ‖polynomial χ U V W θ s‖ ≤ B) :
    cutoffSum (LSeries.term (coefficient χ U V W θ) ρ) Y =
      mellinInv a (fun w => (polynomial χ U V W θ (ρ+w) *
        χ.LFunction (ρ+w)) * symbol w) (1/Y) := by
  let A := Y * (6*(q : ℝ)*(1+‖ρ‖+1)*B)
  let H (w : ℂ) := polynomial χ U V W θ (ρ+w) * χ.LFunction (ρ+w)
  have hshift : Differentiable ℂ (fun w : ℂ => ρ+w) := by fun_prop
  have hH : Differentiable ℂ H := ((differentiable_polynomial χ U V W θ).comp hshift).mul
    ((DirichletCharacter.differentiable_LFunction hχ).comp hshift)
  have hz : H 0 = 0 := by simp [H,hρ]
  have hYS : 0 < Y := zero_lt_one.trans_le hY
  have hA : 0 ≤ A := by unfold A; positivity
  have hb : LSeriesSummable (coefficient χ U V W θ) (ρ+1) := by
    apply sieveProduct_summable
    simp only [add_re,one_re]
    linarith
  have hg (x : ℝ) (hx : x ∈ Set.Icc a 1) (t : ℝ) (_ : 1 ≤ |t|) :
      ‖(Y : ℂ)^((x : ℂ)+t*I) * H ((x : ℂ)+t*I)‖ ≤ A*(1+|t|) := by
    have hxa : a ≤ x := hx.1
    have hx' : |x| ≤ 1 := abs_le.mpr ⟨by linarith, hx.2⟩
    have hr : (1/2 : ℝ) ≤ ρ.re+x := by linarith
    have hm := shifted_product_linear_growth hχ ρ (polynomial χ U V W θ)
      hB (show (0:ℝ) ≤ 1 by norm_num) hpoly hx' hr (t := t)
    have hyPow : ‖(Y : ℂ)^((x : ℂ)+t*I)‖ ≤ Y := by
      rw [norm_cpow_eq_rpow_re_of_pos hYS, show (((x : ℂ)+t*I) : ℂ).re = x by simp [mul_re]]
      simpa using Real.rpow_le_rpow_of_exponent_le hY hx.2
    rw [norm_mul]
    calc
      _ ≤ Y * ((6*(q : ℝ)*(1+‖ρ‖+1)*B)*(1+|t|)) :=
        mul_le_mul hyPow (by simpa [H,mul_comm] using hm) (norm_nonneg _) hYS.le
      _ = _ := by dsimp [A]; ring
  have hright (t : ℝ) :
      H ((1 : ℂ)+t*I) = LSeries (coefficient χ U V W θ) (ρ+((1 : ℂ)+t*I)) := by
    have hs : 1 < (ρ+((1 : ℂ)+t*I)).re := by simp [add_re,mul_re]; linarith
    exact (sieveProduct_LSeries χ (support V) (support W) _ _ hs).symm
  exact (compact_riesz_shift hH hz (by linarith only [ha₀]) ha₁ hYS hA hg _ ρ hb hright).symm


set_option maxHeartbeats 1100000 in
/-- A linear bound for the product on the chosen left line gives the
normalized finite detector estimate. -/
theorem compact_detector_error_left {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχ : χ≠1) {ρ : ℂ} (hρ : χ.LFunction ρ=0)
    {a h : ℝ} (hh : 0<h) (hh' : h≤1/2) (ha₀ : -(1/2:ℝ)≤a) (ha₁ : a≤ -h)
    (hlo : 1/2≤ρ.re+a) (hhi : ρ.re≤1)
    {U V W Y Z B M : ℝ} {θ : ℕ → ℝ}
    (hZ : 1≤Z) (hZU : Z≤U) (hUV : U<V) (hW : 1≤W) (hθ : θ 1=1)
    (hZY : Z≤Y) (hB : 0≤B) (hM : 0≤M)
    (hpoly : ∀ s : ℂ, (1/2:ℝ)≤ s.re → ‖polynomial χ U V W θ s‖≤B)
    (hLeft : ∀ t : ℝ, let s := ρ+((a:ℂ)+t*I)
      ‖polynomial χ U V W θ s*χ.LFunction s‖≤M*(1+|t|)) :
    ‖(∑ n∈support Y,LSeries.term (coefficient χ U V W θ) ρ n*
      (differenceWeight Y Z n:ℂ))+1‖≤(1+h⁻¹)^3*Y^a*M+2/Z := by
  have hY := hZ.trans hZY
  have hY₀ := zero_lt_one.trans_le hY
  have hZ₀ := zero_lt_one.trans_le hZ
  have ha : a<0 := ha₁.trans_lt (neg_neg_of_pos hh)
  let H (t : ℝ) := polynomial χ U V W θ (ρ+((a:ℂ)+t*I)) *
    χ.LFunction (ρ+((a:ℂ)+t*I))
  let F (t : ℝ) := (Y:ℂ)^((a:ℂ)+t*I)*H t
  have hF (t : ℝ) : ‖F t‖≤(Y^a*M)*(1+|t|) := by
    dsimp only [F]
    rw [norm_mul,norm_cpow_eq_rpow_re_of_pos hY₀]
    simp only [add_re,ofReal_re,mul_re,I_re,I_im,mul_zero,ofReal_im,mul_one,sub_zero,add_zero]
    calc
      _ ≤ Y^a*(M*(1+|t|)) := mul_le_mul_of_nonneg_left (hLeft t) (Real.rpow_nonneg hY₀.le _)
      _ = _ := by ring
  have hNI := norm_left_cubic_integral_le hh hh' ha₀ ha₁ (by positivity : 0≤Y^a*M) F hF
  let Ileft := mellinInv a (fun w => (polynomial χ U V W θ (ρ+w)*χ.LFunction (ρ+w))*symbol w) (1/Y)
  have hMellin : ‖Ileft‖≤(1+h⁻¹)^3*Y^a*M := by
    have hpow (w : ℂ) : ((1/Y:ℝ):ℂ)^(-w)=(Y:ℂ)^w := by
      rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (one_div_pos.mpr hY₀).ne'),
        Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hY₀.ne'),
        ←Complex.ofReal_log (one_div_pos.mpr hY₀).le,←Complex.ofReal_log hY₀.le,
        Real.log_div one_ne_zero hY₀.ne',Real.log_one,zero_sub,Complex.ofReal_neg]
      congr 1
      ring
    have he : Ileft=((1/(2*Real.pi):ℝ):ℂ)*(∫ t : ℝ,symbol ((a:ℂ)+t*I)*F t) := by
      simp only [Ileft,mellinInv,smul_eq_mul,Complex.real_smul]
      apply congrArg (fun z : ℂ => ((1/(2*Real.pi):ℝ):ℂ)*z)
      apply integral_congr_ae
      filter_upwards [] with t
      rw [hpow]
      dsimp only [F,H]
      ring
    rw [he]
    exact hNI.trans_eq (by ring)
  have hUnit : ‖1-(1-1/(Z:ℂ))^2‖≤2/Z := by
    have hE : 1-(1-1/(Z:ℂ))^2=((1-(1-1/Z)^2:ℝ):ℂ) := by
      simp only [Complex.ofReal_sub,Complex.ofReal_one,Complex.ofReal_div,Complex.ofReal_pow]
    rw [hE,Complex.norm_real,Real.norm_eq_abs]
    have hInv : 1/Z≤1 := (div_le_one hZ₀).mpr hZ
    have hInv₀ : 0≤1/Z := by positivity
    rw [abs_of_nonneg (by nlinarith only [hInv,hInv₀,mul_nonneg hInv₀ (sub_nonneg.mpr hInv)])]
    rw [show (2:ℝ)/Z=2*(1/Z) by ring]
    nlinarith only [sq_nonneg (1/Z)]
  rw [←cutoff_sub_eq_difference _ hZ₀ hZY,cutoff_short χ hZ hZU hUV hW hθ ρ,
    cutoff_eq_mellinInv_left hχ hρ ha₀ ha hlo hhi U V W θ hY hB hpoly]
  change ‖Ileft-(1-1/(Z:ℂ))^2+1‖≤_
  rw [show Ileft-(1-1/(Z:ℂ))^2+1=Ileft+(1-(1-1/(Z:ℂ))^2) by ring]
  exact (norm_add_le _ _).trans (add_le_add hMellin hUnit)

end
end GoldbachPintzDetector
end

section
namespace GoldbachPintzDetector

open Complex Finset Filter GoldbachHybridGrowth GoldbachSieveSeries GoldbachPintzTheta
open GoldbachPintzNumerics
open scoped Topology

set_option maxHeartbeats 1750000 in
/-- Uniform normalized compact detector on the moving Pintz cutoffs. -/
theorem compact_detector_eventually_near_neg_one
    {φ w u₀ c₂ r κ m A T ε : ℝ} (hφ : 3/8 < φ) (hw : 0 < w) (hu : 0 < u₀)
    (hc : 0 < c₂) (hκ : 0 ≤ κ) (hm : 0 < m) (hA : 0 ≤ A) (hT : 0 ≤ T) (hε : 0 < ε)
    (hMargin : φ+c₂+w+m ≤ r) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ (χ : DirichletCharacter ℂ q), χ≠1 →
      ∀ ρ : ℂ, χ.LFunction ρ=0 → ρ.re ≤ 1 → (1-ρ.re)*L ≤ A → |ρ.im| ≤ T →
      ∀ η∈Set.Icc 0 κ, ∀ θ : ℕ→ℝ, θ 1=1 → (∀ d, |θ d| ≤ 1) →
        let U := Real.exp ((u₀+η)*L)
        let V := Real.exp ((u₀+η+c₂)*L)
        let W := Real.exp (w*L)
        let Y := Real.exp ((u₀+η+r)*L)
        ‖(∑ n∈support Y,LSeries.term (coefficient χ U V W θ) ρ n*(differenceWeight Y U n:ℂ))+1‖ ≤ ε := by
  obtain ⟨B,hB,hBurgess⟩ := nonprincipal_LFunction_uniform_burgess_strip_linear_height hφ
  let ymax := u₀+κ+r
  let cap := 1+Real.log 3+u₀+κ+c₂+w
  let K := 17^3*(B*(1+T)*cap^3)*Real.exp (ymax*A)
  have hφ₀ : 0 ≤ φ := by linarith only [hφ]
  have hr : 0 < r := by linarith only [hMargin,hφ₀,hc,hw,hm]
  have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num)
  have hcap : 0 ≤ cap := by dsimp only [cap]; positivity
  have hK := eventually_scaled_contour_error (K:=K) (c:=m*(1/8:ℝ)) (by positivity) (by positivity : 0 < ε/2)
  have hShort := eventually_scaled_contour_error (K:=2) (c:=u₀) hu (by positivity : 0 < ε/2)
  filter_upwards [eventually_ge_atTop (max 1 (16*A)),hK,hShort] with L hL hK' hU'
  intro q _ hq χ hχ ρ hρ hhi hδ him η hη θ hθ₁ hθ
  have hL₁ : 1 ≤ L := (le_max_left _ _).trans hL
  have hL₀ : 0 < L := zero_lt_one.trans_le hL₁
  have hDev : 1-ρ.re ≤ 1/16 := by
    apply (le_div_iff₀ (by norm_num : (0:ℝ) < 16)).mpr
    have hLarge := (le_max_right 1 (16*A)).trans hL
    have hh : 1-ρ.re ≤ A/L := (le_div_iff₀ hL₀).mpr hδ
    have hh' : A/L ≤ 1/16 := (div_le_iff₀ hL₀).mpr (by linarith only [hLarge])
    linarith only [hh,hh']
  let u := u₀+η
  let d := u+c₂
  let y := u+r
  let U := Real.exp (u*L)
  let V := Real.exp (d*L)
  let W := Real.exp (w*L)
  let Y := Real.exp (y*L)
  let a := 7/8-ρ.re
  let M := (B*(1+T)*(1+Real.log 3+d+w)^3)*(1+L)^4*
    Real.exp ((φ+d+w)*(1/8:ℝ)*L)
  have hu' : 0 < u := add_pos_of_pos_of_nonneg hu hη.1
  have hd' : 0 < d := add_pos hu' hc
  have hy' : 0 < y := add_pos hu' hr
  have hUZ : 1 ≤ U := Real.one_le_exp_iff.mpr (mul_nonneg hu'.le hL₀.le)
  have hUV : U < V := Real.exp_lt_exp.mpr
    (mul_lt_mul_of_pos_right (lt_add_of_pos_right _ hc) hL₀)
  have hWY : 1 ≤ W := Real.one_le_exp_iff.mpr (mul_nonneg hw.le hL₀.le)
  have hUY : U ≤ Y := Real.exp_le_exp.mpr
    (mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hr.le) hL₀.le)
  have ha₀ : -(1/2:ℝ) ≤ a := by dsimp only [a]; linarith only [hhi]
  have ha₁ : a ≤  -(1/16:ℝ) := by dsimp only [a]; linarith only [hDev]
  have hline : ρ.re+a=1-1/8 := by dsimp only [a]; ring
  have hHalt : ∀ t : ℝ, let s := ρ+((a:ℂ)+t*I)
      ‖χ.LFunction s‖ ≤ B*(1+|ρ.im+t|)*(1+Real.log (q:ℝ))*(q:ℝ)^(φ*(1/8:ℝ)) := by
    intro t
    let s := ρ+((a:ℂ)+t*I)
    have hs : s.re=7/8 := by simp [s,Complex.mul_re,a]
    have hsI : s.im=ρ.im+t := by simp [s,Complex.mul_im]
    have hG := hBurgess q χ hχ (abs_nonneg s.im) s (by norm_num [hs])
      (by norm_num [hs]) le_rfl
    rw [hs,hsI] at hG
    norm_num at hG
    exact hG
  have hψ (k : ℕ) : ‖(barbanVehov U V k:ℂ)‖ ≤ 1 := by
    rw [Complex.norm_real,Real.norm_eq_abs]
    exact abs_barbanVehov_le_one (Real.exp_pos _) hUV k
  have hθ' (k : ℕ) : ‖(θ k:ℂ)‖ ≤ 1 := by rw [Complex.norm_real,Real.norm_eq_abs]; exact hθ k
  have hPL (t : ℝ) : let s := ρ+((a:ℂ)+t*I)
      ‖polynomial χ U V W θ s*χ.LFunction s‖ ≤ M*(1+|t|) := by
    intro s
    have hb := sieve_product_left_line_le χ hL₀.le (by norm_num : (0:ℝ) ≤ 1/8) hφ₀ hd'.le hw.le
      (zero_le_one.trans hB) hT hq hline him (fun k => (barbanVehov U V k:ℂ)) (fun k => (θ k:ℂ))
      (fun k _=>hψ k) (fun k _=>hθ' k) hHalt t
    simpa only [M,polynomial,support,lcmPolynomial_eq,V,W] using hb
  have hM : 0 ≤ M := by dsimp only [M]; positivity
  have hRaw := compact_detector_error_left hχ hρ (by norm_num : (0:ℝ) < 1/16)
    (by norm_num) ha₀ ha₁ (by linarith only [hline]) hhi hUZ le_rfl hUV hWY hθ₁ hUY
    (polynomialBound_nonneg χ U V W θ) hM (fun _ hs=>norm_polynomial_le_bound χ U V W θ hs) hPL
  refine hRaw.trans ?_
  have hMax : y ≤ ymax := by dsimp only [y,u,ymax]; linarith only [hη.2]
  have hmarg : φ+d+w+m ≤ y := by dsimp only [d,y]; linarith only [hMargin]
  have hScale := compact_left_scale_le hL₀ (by norm_num : (0:ℝ) ≤ 1/8) hA hy'.le hMax hδ hmarg
  have hScale' : Y^a*Real.exp ((φ+d+w)*(1/8:ℝ)*L) ≤ Real.exp (ymax*A)*Real.exp (-(m*(1/8:ℝ))*L) := by
    simpa only [Y,a,show (7/8:ℝ)-ρ.re=(1-ρ.re)-1/8 by ring,neg_mul] using hScale
  have hCap : 1+Real.log 3+d+w ≤ cap := by dsimp only [d,u,cap]; linarith only [hη.2]
  have hAmp : B*(1+T)*(1+Real.log 3+d+w)^3 ≤ B*(1+T)*cap^3 := by
    apply mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (by positivity) hCap 3) (by positivity)
  have hMain : (1+((1/16:ℝ))⁻¹)^3*Y^a*M ≤ ε/2 := by
    calc
      _=17^3*(B*(1+T)*(1+Real.log 3+d+w)^3)*(1+L)^4*
        (Y^a*Real.exp ((φ+d+w)*(1/8:ℝ)*L)) := by dsimp only [M]; norm_num; ring
      _ ≤ 17^3*(B*(1+T)*cap^3)*(1+L)^4*(Real.exp (ymax*A)*Real.exp (-(m*(1/8:ℝ))*L)) := by
        gcongr
      _=K*(1+L)^4*Real.exp (-(m*(1/8:ℝ))*L) := by dsimp only [K]; ring
      _ ≤ _ := hK'
  have hShort' : 2/U ≤ ε/2 := by
    have hPow : 1 ≤ (1+L)^4 := one_le_pow₀ (le_add_of_nonneg_right hL₀.le)
    have hExp : Real.exp (-u*L) ≤ Real.exp (-u₀*L) :=
      Real.exp_le_exp.mpr (by dsimp only [u]; nlinarith only [mul_nonneg hη.1 hL₀.le])
    calc
      _=2*Real.exp (-u*L) := by dsimp only [U]; rw [neg_mul,Real.exp_neg,div_eq_mul_inv]
      _ ≤ 2*(1+L)^4*Real.exp (-u₀*L) := by
        exact mul_le_mul (by linarith only [hPow]) hExp (Real.exp_nonneg _) (by positivity)
      _ ≤ _ := hU'
  linarith only [hMain,hShort']

end GoldbachPintzDetector
end

section
namespace GoldbachHybridGrowth

open Complex Filter Finset
open scoped Topology Classical

noncomputable section

private theorem sum_primeFactors_log_le {q : ℕ} (hq : q≠0) :
    ∑ p∈q.primeFactors, Real.log (p:ℝ)≤Real.log (q:ℝ) := by
  have hN : ∏ p∈q.primeFactors,p≤q := Nat.le_of_dvd (Nat.pos_of_ne_zero hq) (Nat.prod_primeFactors_dvd q)
  have hR : (∏ p∈q.primeFactors,(p:ℝ))≤q := by
    rw [←Nat.cast_prod]
    exact_mod_cast hN
  rw [←Real.log_prod (fun p hp => by
    exact_mod_cast (Nat.prime_of_mem_primeFactors hp).ne_zero)]
  exact Real.log_le_log (prod_pos (fun p hp => by
    exact_mod_cast (Nat.prime_of_mem_primeFactors hp).pos)) hR

private theorem small_sum_recip_le {L : ℝ} (hL : 1≤L) (S : Finset ℕ)
    (hS : ∀ p∈S, 1≤p ∧ (p:ℝ)≤L) :
    ∑ p∈S, (p:ℝ)⁻¹≤1+Real.log L := by
  let N := ⌊L⌋₊
  have hL0 : 0≤L := zero_le_one.trans hL
  have hN1 : 1≤N := (Nat.le_floor_iff hL0).mpr (by simpa using hL)
  have hsub : S⊆Icc 1 N := fun p hp=>mem_Icc.mpr ⟨(hS p hp).1,
    (Nat.le_floor_iff hL0).mpr (hS p hp).2⟩
  have hH : (∑ p∈Icc 1 N,(p:ℝ)⁻¹)=(harmonic N:ℝ) := by
    simp only [harmonic,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast]
    rw [←Finset.Ico_succ_right_eq_Icc]
    change (∑ p∈Ico 1 (N+1),(p:ℝ)⁻¹)=_
    exact (by simpa only [Nat.Ico_zero_eq_range,zero_add,Nat.add_comm] using
      (Finset.sum_Ico_add (fun p : ℕ => (p:ℝ)⁻¹) 0 N 1).symm)
  have hN0 : (0:ℝ)<N := by exact_mod_cast (Nat.lt_of_lt_of_le Nat.zero_lt_one hN1)
  calc
    _ ≤ ∑ p∈Icc 1 N,(p:ℝ)⁻¹ := Finset.sum_le_sum_of_subset_of_nonneg hsub
      (fun p _ _=>by positivity)
    _ ≤ 1+Real.log (N:ℝ) := hH ▸ harmonic_le_one_add_log N
    _ ≤ _ := add_le_add_right (Real.log_le_log hN0 (Nat.floor_le hL0)) 1

private theorem sum_primeFactors_recip_le {q : ℕ} (hq : q≠0) {L : ℝ}
    (hL : 1≤L) (hlog : Real.log (q:ℝ)≤L) :
    ∑ p∈q.primeFactors, (p:ℝ)⁻¹≤3+Real.log L := by
  have hL0 : 0<L := zero_lt_one.trans_le hL
  have hsm := small_sum_recip_le hL (q.primeFactors.filter fun p : ℕ => (p:ℝ)≤L)
    (fun p hp=>⟨(Nat.prime_of_mem_primeFactors (Finset.mem_filter.mp hp).1).one_lt.le,
      (Finset.mem_filter.mp hp).2⟩)
  have hLg : ∑ p∈q.primeFactors.filter (fun p : ℕ => ¬(p:ℝ)≤L), (p:ℝ)⁻¹≤2 := calc
    _ ≤ ∑ p∈q.primeFactors.filter (fun p : ℕ => ¬(p:ℝ)≤L), (2/L)*Real.log (p:ℝ) := by
      apply sum_le_sum
      intro p hp
      have hpP := Nat.prime_of_mem_primeFactors (mem_filter.mp hp).1
      have hpL := lt_of_not_ge (mem_filter.mp hp).2
      have hp2 : (2:ℝ)≤p := by exact_mod_cast hpP.two_le
      have hpLog := Real.log_le_log (by norm_num : (0:ℝ)<2) hp2
      have hh : (1/2:ℝ)≤Real.log (p:ℝ) := by linarith only [hpLog,Real.log_two_gt_d9]
      calc
        _ ≤ L⁻¹ := inv_anti₀ hL0 hpL.le
        _ ≤ _ := by
          calc
            _ = 1*L⁻¹ := by rw [one_mul]
            _ ≤ (2*Real.log (p:ℝ))*L⁻¹ :=
              mul_le_mul_of_nonneg_right (by linarith only [hh]) (inv_nonneg.mpr hL0.le)
            _ = _ := by rw [div_eq_mul_inv]; ring
    _ ≤ (2/L)*L := by
      rw [←mul_sum]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      refine (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) ?_).trans
        ((sum_primeFactors_log_le hq).trans hlog)
      intro p hp _
      exact Real.log_natCast_nonneg _
    _ = _ := div_mul_cancel₀ _ hL0.ne'
  have hPart := Finset.sum_filter_add_sum_filter_not q.primeFactors
    (fun p : ℕ => (p:ℝ)≤L) (fun p => (p:ℝ)⁻¹)
  linarith only [hsm,hLg,hPart]

private theorem prime_rpow_linear {p δ : ℝ} (hp : 1≤p) (hδ : 0≤δ) (hδ' : δ≤1/4) :
    p^(-1+δ:ℝ)≤p⁻¹+δ*(Real.log p*p^(-(3/4):ℝ)) := by
  have hp0 := zero_lt_one.trans_le hp
  have ht := Real.add_one_le_exp (-(δ*Real.log p))
  have he := Real.exp_neg (δ*Real.log p)
  rw [he] at ht
  have hExp := mul_le_mul_of_nonneg_right ht (Real.exp_nonneg (δ*Real.log p))
  rw [inv_mul_cancel₀ (Real.exp_pos _).ne'] at hExp
  have hh : Real.exp (δ*Real.log p)≤1+δ*Real.log p*Real.exp (δ*Real.log p) := by
    linarith only [hExp,show (-(δ*Real.log p)+1)*Real.exp (δ*Real.log p)=
      Real.exp (δ*Real.log p)-δ*Real.log p*Real.exp (δ*Real.log p) by ring]
  have hM := mul_le_mul_of_nonneg_left hh (inv_nonneg.mpr hp0.le)
  rw [show δ*Real.log p=Real.log p*δ by ring,←Real.rpow_def_of_pos hp0,mul_add,mul_one] at hM
  have hP : p⁻¹*p^δ=p^(-1+δ:ℝ) := by rw [←Real.rpow_neg_one,←Real.rpow_add hp0]
  rw [hP,show p⁻¹*(Real.log p*δ*p^δ)=δ*(Real.log p*(p⁻¹*p^δ)) by ring,hP] at hM
  refine hM.trans (add_le_add_right (mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_left ?_ (Real.log_nonneg hp)) hδ) p⁻¹)
  exact Real.rpow_le_rpow_of_exponent_le hp (by linarith only [hδ'])

theorem uniform_euler_deletion_bound {e : ℝ} (he : 0<e) :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ), q≠0 → ∀ {L δ : ℝ},
      1≤L → Real.log (q:ℝ)≤L → 0≤δ → δ≤1/4 →
      (∏ p∈q.primeFactors, (1+(p:ℝ)^(-1+δ:ℝ)))≤C*L*(q:ℝ)^(e*δ) := by
  obtain ⟨M,hM⟩ : ∃ M : ℕ, 2≤M ∧ (M:ℝ)^(-(3/4):ℝ)≤e := by
    have hh := tendsto_rpow_neg_atTop (show (0:ℝ)<3/4 by norm_num)
    have hh' := (hh.comp tendsto_natCast_atTop_atTop).eventually (eventually_lt_nhds he)
    obtain ⟨n,hn⟩ := Filter.Eventually.exists (hh'.and (eventually_ge_atTop (2:ℕ)))
    exact ⟨n,hn.2,hn.1.le⟩
  let C := Real.exp (3+(M:ℝ)^2)
  refine ⟨C,Real.exp_pos _,?_⟩
  intro q hq L δ hL hLog hδ hδ'
  have hL0 : 0<L := zero_lt_one.trans_le hL
  have hq0 : (0:ℝ)<q := by exact_mod_cast Nat.pos_of_ne_zero hq
  have hA : ∑ p∈q.primeFactors.filter (fun p => p≤M), Real.log (p:ℝ)*(p:ℝ)^(-(3/4):ℝ)≤(M:ℝ)^2 := calc
    _ ≤ ∑ p∈Icc 1 M, Real.log (p:ℝ)*(p:ℝ)^(-(3/4):ℝ) :=
      sum_le_sum_of_subset_of_nonneg
        (fun p hp=>mem_Icc.mpr ⟨(Nat.prime_of_mem_primeFactors (mem_filter.mp hp).1).one_lt.le,
          (mem_filter.mp hp).2⟩)
        (fun p hp h => mul_nonneg (Real.log_natCast_nonneg _) (by positivity))
    _ ≤ ∑ _p∈Icc 1 M,(M:ℝ) := by
      apply sum_le_sum
      intro p hp
      have hp1 : (1:ℝ)≤p := by exact_mod_cast (mem_Icc.mp hp).1
      have hpM : (p:ℝ)≤M := by exact_mod_cast (mem_Icc.mp hp).2
      have hp0 := zero_lt_one.trans_le hp1
      refine (mul_le_of_le_one_right (Real.log_nonneg hp1)
        (Real.rpow_le_one_of_one_le_of_nonpos hp1 (by norm_num))).trans ?_
      linarith only [Real.log_le_sub_one_of_pos hp0,hpM]
    _ = _ := by simp [Nat.card_Icc,pow_two]
  have hB : ∑ p∈q.primeFactors.filter (fun p => ¬p≤M), Real.log (p:ℝ)*(p:ℝ)^(-(3/4):ℝ)≤
      e*Real.log (q:ℝ) := calc
    _ ≤ ∑ p∈q.primeFactors.filter (fun p => ¬p≤M), e*Real.log (p:ℝ) := by
      apply sum_le_sum
      intro p hp
      have hMp : (M:ℝ)≤p := by exact_mod_cast (le_of_lt (lt_of_not_ge (mem_filter.mp hp).2))
      have hM0 : (0:ℝ)<M := by have := hM.1; exact_mod_cast (by omega : 0<M)
      have hw := (Real.rpow_le_rpow_of_nonpos hM0 hMp (by norm_num : -(3/4:ℝ)≤0)).trans hM.2
      simpa only [mul_comm e (Real.log (p:ℝ))] using
        mul_le_mul_of_nonneg_left hw (Real.log_natCast_nonneg p)
    _ ≤ _ := by
      rw [←mul_sum]
      apply mul_le_mul_of_nonneg_left _ he.le
      exact (sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun p _ _ =>
        Real.log_natCast_nonneg p)).trans (sum_primeFactors_log_le hq)
  have hPart := sum_filter_add_sum_filter_not q.primeFactors (fun p=>p≤M)
    (fun p=>Real.log (p:ℝ)*(p:ℝ)^(-(3/4):ℝ))
  have hWeighted : ∑ p∈q.primeFactors,Real.log (p:ℝ)*(p:ℝ)^(-(3/4):ℝ)≤
      (M:ℝ)^2+e*Real.log (q:ℝ) := by linarith only [hA,hB,hPart]
  have hSum := sum_le_sum (s:=q.primeFactors) (fun p hp =>
    prime_rpow_linear (show (1:ℝ)≤p by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_lt.le)
      hδ hδ')
  rw [sum_add_distrib,←mul_sum] at hSum
  have hFinal : ∑ p∈q.primeFactors,(p:ℝ)^(-1+δ:ℝ)≤
      3+(M:ℝ)^2+Real.log L+(e*δ)*Real.log (q:ℝ) := by
    nlinarith only [hSum,sum_primeFactors_recip_le hq hL hLog,
      mul_le_mul_of_nonneg_left hWeighted hδ,
      mul_nonneg (sq_nonneg (M:ℝ)) (show 0≤1-δ by linarith only [hδ'])]
  calc
    _ ≤ ∏ p∈q.primeFactors,Real.exp ((p:ℝ)^(-1+δ:ℝ)) := by
      exact Finset.prod_le_prod₀ (fun p _=>by positivity) (fun p _=>by simpa only [add_comm] using Real.add_one_le_exp ((p:ℝ)^(-1+δ:ℝ)))
    _ = Real.exp (∑ p∈q.primeFactors,(p:ℝ)^(-1+δ:ℝ)) := by rw [Real.exp_sum]
    _ ≤ Real.exp (3+(M:ℝ)^2+Real.log L+(e*δ)*Real.log (q:ℝ)) := Real.exp_le_exp.mpr hFinal
    _ = _ := by rw [Real.exp_add,Real.exp_add,Real.exp_log hL0,Real.rpow_def_of_pos hq0,mul_comm (e*δ)]

end

end GoldbachHybridGrowth
end

section
namespace GoldbachHybridGrowth

open Complex Filter Finset DirichletCharacter
open scoped Classical

set_option maxHeartbeats 1000000 in
/-- Bounded primitive conductor retains linear ordinate growth after induction. -/
theorem bounded_conductor_strip_linear_height {e : ℝ} (he : 0 < e)
    (Q₀ : ℕ) (hQ₀ : 1 ≤ Q₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q], ∀ {L : ℝ}, 1 ≤ L → Real.log (q:ℝ) ≤ L →
      ∀ (χ : DirichletCharacter ℂ q), χ≠1 → χ.conductor ≤ Q₀ →
      ∀ s : ℂ, 3/4 ≤  s.re → s.re ≤ 3/2 →
      ‖χ.LFunction s‖ ≤ C*(1+|s.im|)*L*(q:ℝ)^(e*max 0 (1-s.re)) := by
  obtain ⟨B,hB,hE⟩ := uniform_euler_deletion_bound he
  have hQ₀₀ : (0:ℝ) < Q₀ := by exact_mod_cast (zero_lt_one.trans_le hQ₀)
  refine ⟨12*(Q₀:ℝ)*B,by positivity,?_⟩
  intro q _ L hL hq χ hχ hQ s hs hs'
  let δ := max 0 (1-s.re)
  have hδ : 0 ≤ δ := le_max_left _ _
  have hδ' : δ ≤ 1/4 := max_le (by norm_num) (by linarith only [hs])
  let ψ := χ.primitiveCharacter
  have : NeZero χ.conductor := ⟨χ.conductor_ne_zero⟩
  have hψ : ψ≠1 := by
    intro h
    apply hχ
    rw [←χ.changeLevel_primitiveCharacter]
    change DirichletCharacter.changeLevel χ.conductor_dvd_level ψ=1
    rw [h,map_one]
  have hsN : ‖s‖ ≤ 2*(1+|s.im|) := by
    calc
      _=‖(s.re:ℂ)+(s.im:ℂ)*I‖ := congrArg norm (Complex.re_add_im s).symm
      _ ≤ ‖(s.re:ℂ)‖+‖(s.im:ℂ)*I‖ := norm_add_le _ _
      _ ≤ _ := by
        rw [norm_mul,norm_I,mul_one,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,
          Real.norm_eq_abs,abs_of_nonneg (by linarith only [hs] : 0 ≤  s.re)]
        linarith only [hs',abs_nonneg s.im]
  have hP : ‖ψ.LFunction s‖ ≤ 12*(Q₀:ℝ)*(1+|s.im|) := by
    have hh := GoldbachCubicRiesz.nonprincipal_LFunction_norm_le hψ (by linarith only [hs] : 1/2 ≤  s.re)
    have hScale : (χ.conductor:ℝ) ≤ Q₀ := by exact_mod_cast hQ
    refine hh.trans ?_
    calc
      _ ≤ 6*(Q₀:ℝ)*(2*(1+|s.im|)) := by gcongr
      _=_ := by ring
  have hEq : χ.LFunction s=ψ.LFunction s*
      ∏ f∈q.primeFactors, (1-ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s)) := by
    exact (congrArg (fun η : DirichletCharacter ℂ q=>η.LFunction s)
      χ.changeLevel_primitiveCharacter.symm).trans
        (LFunction_changeLevel χ.conductor_dvd_level ψ (Or.inl hψ))
  have hProd : ‖∏ f∈q.primeFactors, (1-ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s))‖ ≤
      B*L*(q:ℝ)^(e*δ) := by
    refine (Finset.norm_prod_le _ _).trans ((Finset.prod_le_prod₀ (fun f _=>by positivity) ?_).trans
      (hE q (NeZero.ne q) hL hq hδ hδ'))
    intro f hf
    have hfP := Nat.prime_of_mem_primeFactors hf
    have hf1 : (1:ℝ) ≤ f := by exact_mod_cast hfP.one_lt.le
    calc
      _  ≤  1+‖ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s)‖ := by
        have hh := norm_sub_le (1:ℂ) (ψ (f:ZMod χ.conductor)*(f:ℂ)^(-s))
        simpa only [norm_one] using hh
      _  ≤  1+(f:ℝ)^(-s.re) := by
        rw [norm_mul,Complex.norm_natCast_cpow_of_pos hfP.pos,Complex.neg_re]
        exact add_le_add_right (mul_le_of_le_one_left (by positivity) (ψ.norm_le_one _)) 1
      _  ≤  1+(f:ℝ)^(-1+δ:ℝ) := by
        have hd : -s.re ≤  -1+δ := by
          unfold δ
          linarith only [le_max_right 0 (1-s.re)]
        exact add_le_add_right (Real.rpow_le_rpow_of_exponent_le hf1 hd) 1
  rw [hEq,norm_mul]
  exact (mul_le_mul hP hProd (norm_nonneg _) (by positivity)).trans_eq (by ring)

end GoldbachHybridGrowth
end

