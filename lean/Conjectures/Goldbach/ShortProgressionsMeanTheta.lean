private theorem integrable_right_tail {T : ℝ} (hT : 0 < T) :
    IntegrableOn (fun v : ℝ => (v ^ 2)⁻¹) (Ioi T) := by
  apply (integrableOn_Ioi_rpow_of_lt (a := -2) (by norm_num) hT).congr_fun _ measurableSet_Ioi
  intro v hv
  change v ^ (-2 : ℝ) = (v ^ (2 : ℕ))⁻¹
  rw [Real.rpow_neg (hT.trans (mem_Ioi.mp hv)).le, Real.rpow_two]

