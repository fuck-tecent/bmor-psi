/-- Uniform Burgess growth with a linear height factor, suitable for
absolute integration against a cubic Riesz denominator. -/
theorem nonprincipal_LFunction_uniform_strip_linear_height_of_primitive_fourth_moment
    (hMoment : HasPrimitiveBurgessFourthMoment) {φ : ℝ} (hφ : 3/8 < φ) :
    ∃ B : ℝ, 1≤B ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → ∀ {T : ℝ}, 0≤T → ∀ s : ℂ,
      3/4 ≤ s.re → s.re ≤ 3/2 → |s.im| ≤ T →
      ‖χ.LFunction s‖≤B*(1+T)*(1+Real.log (q:ℝ))*
        (q:ℝ)^(φ*max 0 (1-s.re)) := by
  have hφ₀ : 0≤φ := by linarith only [hφ]
  obtain ⟨A,hA,hStrip⟩ :=
    nonprincipal_LFunction_uniform_strip_sharp_height_of_primitive_fourth_moment hMoment hφ
  let C₀ := prefixGrowthScale A 0
  let K := 2+Real.log C₀+12+φ
  let B := C₀*K
  have hC₀₁ : 1≤C₀ := by
    unfold C₀ prefixGrowthScale
    norm_num only [add_zero,mul_one]
    have h : 1≤24*A := by linarith only [hA]
    linarith only [one_le_pow₀ (n:=3) h]
  have hC₀ := zero_lt_one.trans_le hC₀₁
  have hLogC₀ := Real.log_nonneg hC₀₁
  have hK : 1≤K := by unfold K; linarith only [hLogC₀,hφ₀]
  refine ⟨B,one_le_mul_of_one_le_of_one_le hC₀₁ hK,?_⟩
  intro q _ χ hχ T hT s hlo hhi him
  let C := prefixGrowthScale A T
  let u := 1+T
  let p := max 0 (1-s.re)
  let Z := u^(1/4:ℝ)
  let W := 1+Real.log (q:ℝ)
  have hp : 0≤p := le_max_left _ _
  have hp₁ : p≤1/4 := max_le (by norm_num) (by linarith only [hlo])
  have hu₁ : 1≤u := le_add_of_nonneg_right hT
  have hu := zero_lt_one.trans_le hu₁
  have hZ : 1≤Z := Real.one_le_rpow hu₁ (by norm_num)
  have hq : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hLogq := Real.log_nonneg hq
  have hW : 1≤W := le_add_of_nonneg_right hLogq
  have hCp : C=C₀*u^3 := by unfold C C₀ u prefixGrowthScale; ring
  have hC₁ : 1≤C := by
    rw [hCp]
    exact one_le_mul_of_one_le_of_one_le hC₀₁ (one_le_pow₀ hu₁)
  have hPower : C^p≤C₀*u^(3/4:ℝ) := calc
    _ = C₀^p*u^(3*p) := by
      rw [hCp,Real.mul_rpow hC₀.le (by positivity),←Real.rpow_natCast_mul hu.le]
      norm_num
    _ ≤ _ := by
      apply mul_le_mul _ _ (by positivity) hC₀.le
      · simpa only [Real.rpow_one] using
          Real.rpow_le_rpow_of_exponent_le hC₀₁ (hp₁.trans (by norm_num : (1/4:ℝ)≤1))
      · exact Real.rpow_le_rpow_of_exponent_le hu₁ (by linarith only [hp₁])
  have hlogC : Real.log C≤Real.log C₀+12*Z := by
    rw [hCp,Real.log_mul hC₀.ne' (pow_ne_zero _ hu.ne'),Real.log_pow]
    have h := Real.log_le_rpow_div hu.le (show (0:ℝ)<1/4 by norm_num)
    unfold Z
    linarith only [h]
  have hLogFactor : 2+Real.log C+φ*Real.log (q:ℝ)≤K*Z*W := by
    have h1 : 1≤Z*W := one_le_mul_of_one_le_of_one_le hZ hW
    have h2 : Z≤Z*W := le_mul_of_one_le_right (by positivity) hW
    have h3 : Real.log (q:ℝ)≤Z*W := by
      exact (show Real.log (q:ℝ)≤W by unfold W; linarith).trans
        (le_mul_of_one_le_left (by positivity) hZ)
    have h1' := mul_le_mul_of_nonneg_left h1 (show 0≤2+Real.log C₀ by linarith only [hLogC₀])
    have h2' := mul_le_mul_of_nonneg_left h2 (show (0:ℝ)≤12 by norm_num)
    have h3' := mul_le_mul_of_nonneg_left h3 hφ₀
    unfold K
    linarith only [hlogC,h1',h2',h3']
  have hNN : 0≤2+Real.log C+φ*Real.log (q:ℝ) :=
    (add_nonneg) (add_nonneg (by norm_num) (Real.log_nonneg hC₁)) (mul_nonneg hφ₀ hLogq)
  have hPrefactor : C^p*(2+Real.log C+φ*Real.log (q:ℝ))≤B*u*W := calc
    _ ≤ (C₀*u^(3/4:ℝ))*(K*Z*W) := mul_le_mul hPower hLogFactor hNN (by positivity)
    _ = B*(u^(3/4:ℝ)*Z)*W := by unfold B; ring
    _ = _ := by
      unfold Z
      rw [←Real.rpow_add hu,show (3/4:ℝ)+1/4=1 by norm_num,Real.rpow_one]
  exact (hStrip q χ hχ hT s hlo hhi him).trans
    (mul_le_mul_of_nonneg_right hPrefactor (by positivity))

end GoldbachHybridGrowth
