/- Arc geometry adapted from ChiyodaMomo01 PR #1923, b0820ebb68754bebd52ee5512cbdf2ebd85677dd, and wzhxzkk 93d33090fdfc93fb272dde08cb463f3bff3c64ce, Apache-2.0. -/
namespace WaveGeom
open Finset Set MeasureTheory
theorem arcDisjoint :
    ∀ (a b q r Q B n : ℕ) (t : ℝ), 0<q → 0<r → q≤B → r≤B → 2*Q*B<n → a*r ≠ b*q → |t-(a:ℝ)/(q:ℝ)|≤(Q:ℝ)/((q:ℝ)*n) → (Q:ℝ)/((r:ℝ)*n) < |t-(b:ℝ)/(r:ℝ)| := by
  intro a b q r Q B n t hq hr hqQ hrQ hn hdistinct ha
  have hqr : 0 < (q : ℝ) := by exact_mod_cast hq
  have hrr : 0 < (r : ℝ) := by exact_mod_cast hr
  have hnr : 0 < (n : ℝ) := by exact_mod_cast (show 0 < n by omega)
  have hsmall : Q * r + Q * q < n := by
    nlinarith [Nat.mul_le_mul_left Q hrQ, Nat.mul_le_mul_left Q hqQ]
  have hradii : (Q : ℝ) / (q * n) + Q / (r * n) < 1 / (q * r) := calc
    _ = ((Q : ℝ) * r + Q * q) / (q * r * n) := by field_simp
    _ < (n : ℝ) / (q * r * n) :=
      (div_lt_div_iff_of_pos_right (by positivity)).mpr (by exact_mod_cast hsmall)
    _ = 1 / (q * r) := by field_simp
  have hsep : 1 / ((q : ℝ) * r) ≤ |(a : ℝ) / q - b / r| := by
    have hdiff : (a : ℝ) / q - b / r = (a * r - b * q) / (q * r) := by
      field_simp
    rw [hdiff, abs_div, abs_of_pos (mul_pos hqr hrr)]
    apply (div_le_div_iff_of_pos_right (mul_pos hqr hrr)).mpr
    rcases lt_or_gt_of_ne hdistinct with hab | hba
    · have hgap : (a : ℝ) * r + 1 ≤ b * q := by exact_mod_cast Nat.succ_le_of_lt hab
      linarith [neg_le_abs ((a : ℝ) * r - b * q)]
    · have hgap : (b : ℝ) * q + 1 ≤ a * r := by exact_mod_cast Nat.succ_le_of_lt hba
      linarith [le_abs_self ((a : ℝ) * r - b * q)]
  have htriangle := abs_sub_le ((a : ℝ) / q) t ((b : ℝ) / r)
  rw [abs_sub_comm ((a : ℝ) / q) t] at htriangle
  linarith

def arcs (Q n A B : ℕ) : Set ℝ := {t | ∃ q a : ℕ, A<q ∧ q≤B ∧ a≤q ∧ a.Coprime q ∧ |t-(a:ℝ)/q| ≤ (Q:ℝ)/((q:ℝ)*n)}
noncomputable def Radius (Q n q : ℕ) : ℝ := (Q : ℝ) / ((q : ℝ) * n)
noncomputable def Cell (Q n q a : ℕ) : Set ℝ :=
  Icc ((a:ℝ)/q - Radius Q n q) ((a:ℝ)/q + Radius Q n q)
theorem In_cell {Q n q a : ℕ} {t : ℝ} :
    t ∈ Cell Q n q a ↔ |t - (a:ℝ)/q| ≤ Radius Q n q := by
  rw [abs_le]
  change (_ ≤ t ∧ t ≤ _) ↔ _
  constructor <;> rintro ⟨h₁,h₂⟩ <;> constructor <;> linarith
theorem Same_center {a b q r : ℕ} (hq : 0 < q) (hr : 0 < r)
    (ha : a.Coprime q) (hb : b.Coprime r) (he : a*r=b*q) : q=r ∧ a=b := by
  have h₁ : q ∣ a*r := he ▸ Nat.dvd_mul_left q b
  have h₂ : r ∣ b*q := he.symm ▸ Nat.dvd_mul_left r a
  have eq := Nat.dvd_antisymm (ha.symm.dvd_of_dvd_mul_left h₁) (hb.symm.dvd_of_dvd_mul_left h₂)
  subst r
  exact ⟨rfl, Nat.eq_of_mul_eq_mul_right hq he⟩
theorem Unique_cell {a b q r Q n A B : ℕ} {t : ℝ}
    (hq : q ∈ Finset.Ioc A B) (hr : r ∈ Finset.Ioc A B)
    (ha : a.Coprime q) (hb : b.Coprime r) (hscale : 2*Q*B<n)
    (ht₁ : t ∈ Cell Q n q a) (ht₂ : t ∈ Cell Q n r b) : q=r ∧ a=b := by
  obtain ⟨hq₁,hq₂⟩ := Finset.mem_Ioc.mp hq
  obtain ⟨hr₁,hr₂⟩ := Finset.mem_Ioc.mp hr
  apply Same_center (by omega) (by omega) ha hb
  by_contra h
  have hsep := arcDisjoint a b q r Q B n t (by omega) (by omega) hq₂ hr₂ hscale h
    (In_cell.mp ht₁)
  exact (not_lt_of_ge (In_cell.mp ht₂)) hsep
def Numerators (q : ℕ) : Finset ℕ := ((range (q+1)).filter (·.Coprime q))
theorem Split_indicator (f : ℝ → ℂ) (Q n A B : ℕ) (hscale : 2*Q*B<n) (t : ℝ) :
    (arcs Q n A B).indicator f t = ∑ q ∈ Finset.Ioc A B, ∑ a ∈ Numerators q,
      (Cell Q n q a).indicator f t := by
  classical
  by_cases ht : t ∈ arcs Q n A B
  · obtain ⟨q,a,hq,hqQ,ha,hca,hm⟩ := ht
    have hqr : q ∈ Finset.Ioc A B := Finset.mem_Ioc.mpr ⟨hq,hqQ⟩
    have har : a ∈ Numerators q := mem_filter.mpr ⟨mem_range.mpr (by omega),hca⟩
    have he : t ∈ Cell Q n q a := In_cell.mpr hm
    rw [Set.indicator_of_mem (show t ∈ arcs Q n A B from ⟨q,a,hq,hqQ,ha,hca,hm⟩)]
    rw [sum_eq_single_of_mem q hqr]
    · rw [sum_eq_single_of_mem a har, Set.indicator_of_mem he]
      intro b hb hba
      apply Set.indicator_of_notMem
      exact fun h => hba (Unique_cell hqr hqr (mem_filter.mp hb).2 hca hscale h he).2
    · intro r hr hrq
      apply sum_eq_zero
      intro b hb
      apply Set.indicator_of_notMem
      exact fun h => hrq (Unique_cell hr hqr (mem_filter.mp hb).2 hca hscale h he).1
  · rw [Set.indicator_of_notMem ht]
    symm
    apply sum_eq_zero
    intro q hq
    apply sum_eq_zero
    intro a ha
    apply Set.indicator_of_notMem
    intro h
    exact ht ⟨q,a,(Finset.mem_Ioc.mp hq).1,(Finset.mem_Ioc.mp hq).2,
      by have := mem_range.mp (mem_filter.mp ha).1; omega,(mem_filter.mp ha).2,In_cell.mp h⟩
noncomputable def Clipped (x R : ℝ) (f : ℝ → ℂ) : ℂ :=
  ∫ t in (Icc 0 1 ∩ Icc (x-R) (x+R)), f t
theorem Major_clipped (Q n A B : ℕ) (hscale : 2*Q*B<n)
    (f : ℝ → ℂ) (hf : Continuous f) :
    (∫ t in (0:ℝ)..1, (arcs Q n A B).indicator f t) =
    ∑ q ∈ Finset.Ioc A B, ∑ a ∈ Numerators q, Clipped ((a:ℝ)/q) (Radius Q n q) f := by
  have hi (q a : ℕ) : IntegrableOn ((Cell Q n q a).indicator f) (Icc (0:ℝ) 1) :=
    hf.integrableOn_Icc.indicator measurableSet_Icc
  rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
  simp_rw [Split_indicator f Q n A B hscale]
  rw [integral_finsetSum _ (fun q _ => integrable_finsetSum _ (fun a _ => hi q a))]
  apply sum_congr rfl
  intro q _
  rw [integral_finsetSum _ (fun a _ => hi q a)]
  apply sum_congr rfl
  intro a _
  exact setIntegral_indicator measurableSet_Icc
theorem Integral_closed {l u : ℝ} (h : l ≤ u) (f : ℝ → ℂ) :
    (∫ t in Icc l u, f t) = ∫ t in l..u, f t := by
  rw [intervalIntegral.integral_of_le h, integral_Icc_eq_integral_Ioc]
theorem Interior (f : ℝ → ℂ) {x R : ℝ} (hR : 0 ≤ R) (hl : 0 ≤ x-R)
    (hu : x+R ≤ 1) : Clipped x R f = ∫ t in (x-R)..(x+R), f t := by
  unfold Clipped
  rw [Set.inter_eq_right.mpr (Icc_subset_Icc hl hu), Integral_closed (by linarith)]

theorem integral_eq_sum (Q n A B : ℕ) (hA : 1≤A) (hQ : Q≤n) (hscale : 2*Q*B<n)
    (f : ℝ → ℂ) (hf : Continuous f) :
    (∫ t in (0:ℝ)..1, (arcs Q n A B).indicator f t) =
      ∑ q ∈ Finset.Ioc A B, ∑ a ∈ Numerators q,
        ∫ t in ((a:ℝ)/q-Radius Q n q)..((a:ℝ)/q+Radius Q n q), f t := by
  rw [Major_clipped Q n A B hscale f hf]
  apply sum_congr rfl
  intro q hq
  obtain ⟨haq,_⟩ := Finset.mem_Ioc.mp hq
  apply sum_congr rfl
  intro a ha
  obtain ⟨har,hcop⟩ := Finset.mem_filter.mp ha
  have har' := mem_range.mp har
  have hlt : a<q := by
    by_contra! h
    have he : a=q := by omega
    simp [he] at hcop
    omega
  have hapos : 1≤a := by
    by_contra! h
    have he : a=0 := by omega
    simp [he] at hcop
    omega
  have hr : 0<(q:ℝ) := by exact_mod_cast (by omega : 0<q)
  have hn : 0<(n:ℝ) := by exact_mod_cast (by omega : 0<n)
  have hR : Radius Q n q ≤ 1/(q:ℝ) := by
    unfold Radius
    rw [div_le_div_iff₀ (by positivity) hr]
    have h := mul_le_mul_of_nonneg_left (show (Q:ℝ)≤n by exact_mod_cast hQ) hr.le
    nlinarith
  have h1 : (1:ℝ)≤a := by exact_mod_cast hapos
  have h2 : (a:ℝ)+1≤q := by exact_mod_cast hlt
  have hl := div_le_div_of_nonneg_right h1 hr.le
  have hu : (a:ℝ)/q + 1/q ≤ 1 := by rw [←add_div,div_le_one hr]; exact h2
  exact Interior f (by unfold Radius; positivity) (by linarith) (by linarith)
end WaveGeom

open Finset Filter MeasureTheory
open scoped Topology
namespace WaveSW
noncomputable section
def errorEnvelope (M : ℝ) (n : ℕ) : ℝ :=
  M * 2 ^ 40 * n / (Real.log n) ^ 40 + 2 * (Real.log n) ^ 9 +
    2 * Real.sqrt n * Real.log n + 1 + (Real.log 4 + 1) * (Real.sqrt n + 1)

theorem uniform_prefix_error :
    ∃ M : ℝ, 0 < M ∧ ∀ᶠ n : ℕ in atTop, ∀ q a : ℕ, 0 < q → (q:ℝ) ≤ (Real.log n)^8 →
      prefixError n ((a : ℝ) / q) (unitMean q a) ≤ q * errorEnvelope M n := by
  obtain ⟨M, hM, x₀, hx₀, hAP⟩ := all_class_error 40 9 (by norm_num) (by norm_num)
  refine ⟨M, hM, ?_⟩
  have hlim := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hroot := Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [eventually_ge_atTop (2 : ℕ), hlim.eventually_ge_atTop 512,
    hroot.eventually_ge_atTop x₀] with n hn hL hrootN
  change (512 : ℝ) ≤ Real.log n at hL
  change x₀ ≤ Real.sqrt n at hrootN
  intro q a hq hQ
  have hnL : 0 < Real.log n := by linarith
  have hconst : 0 < Real.log 4 + 1 := by positivity
  have henv : 0 ≤ errorEnvelope M n := by unfold errorEnvelope; positivity
  unfold prefixError
  apply Finset.sup'_le
  intro m hm
  refine (center_prefix_bound hq a m).trans ?_
  calc
    _ ≤ ∑ _b ∈ range q, errorEnvelope M n := by
      apply sum_le_sum
      intro b hb
      cases m with
      | zero => simpa [classError, classMass] using henv
      | succ u =>
        have hun : u ≤ n := by have := mem_range.mp hm; omega
        have hun' : (u : ℝ) ≤ n := by exact_mod_cast hun
        by_cases hs : (u : ℝ) < Real.sqrt n
        · refine (class_error_trivial u q b hq).trans ?_
          have hsmall := mul_le_mul_of_nonneg_left (add_le_add hs.le (le_refl (1 : ℝ))) hconst.le
          unfold errorEnvelope
          linarith [show 0 ≤ M * 2 ^ 40 * n / (Real.log n) ^ 40 by positivity,
            show 0 ≤ 2 * (Real.log n) ^ 9 by positivity, show 0 ≤ 2 * Real.sqrt n * Real.log n by positivity]
        · have hsu := le_of_not_gt hs
          have hux : x₀ ≤ (u : ℝ) := hrootN.trans hsu
          have hu1 : (1 : ℝ) < u := hx₀.trans_le hux
          have huL := Real.log_pos hu1
          have hhalf := Real.log_le_log (by linarith : 0 < Real.sqrt n) hsu
          rw [Real.log_sqrt (Nat.cast_nonneg n)] at hhalf
          have hupper := Real.log_le_log (by linarith : 0 < (u : ℝ)) hun'
          have hu256 : 256 ≤ Real.log u := by linarith
          have hl8 := pow_le_pow_left₀ hnL.le (show Real.log n ≤ 2 * Real.log u by linarith) 8
          have h4 : (q : ℝ) ≤ (Real.log u) ^ (9 : ℕ) := by
            calc
              _ ≤ (Real.log n)^8 := hQ
              _ ≤ (2*Real.log u)^8 := hl8
              _ ≤ _ := by rw [mul_pow, pow_succ (Real.log u) 8]; nlinarith only [mul_le_mul_of_nonneg_right hu256 (pow_nonneg huL.le 8)]
          have hraw := hAP u q b hux hq (by simpa using h4) (mem_range.mp hb)
          have hrpow : (Real.log u) ^ (-(40 : ℝ)) = 1 / (Real.log u) ^ (40 : ℕ) := by
            rw [Real.rpow_neg huL.le]; norm_num [one_div]
          rw [hrpow, ← div_eq_mul_one_div] at hraw
          have hpow := pow_le_pow_left₀ hnL.le (show Real.log n ≤ 2 * Real.log u by linarith) 40
          rw [mul_pow] at hpow
          have hmain : M * (u : ℝ) / (Real.log u) ^ 40 ≤ M * 2 ^ 40 * n / (Real.log n) ^ 40 := by
            apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
            calc
              _ ≤ (M * n) * (2 ^ 40 * (Real.log u) ^ 40) :=
                mul_le_mul (mul_le_mul_of_nonneg_left hun' hM.le) hpow (by positivity) (by positivity)
              _ = _ := by ring
          have hNat := (nat_log_two_le (u := u) (by exact_mod_cast hu1.le)).trans
            (mul_le_mul_of_nonneg_left hupper (by norm_num : (0 : ℝ) ≤ 2))
          have hlogq : Real.log q ≤ (Real.log n) ^ 8 :=
            (Real.log_le_self (Nat.cast_nonneg q)).trans hQ
          have hlogq0 : 0 ≤ Real.log q := Real.log_nonneg (by exact_mod_cast hq)
          have herr := mul_le_mul hNat hlogq hlogq0 (by positivity)
          have hsqrt := mul_le_mul (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hun') (by norm_num : (0 : ℝ) ≤ 2))
            hupper huL.le (by positivity)
          unfold errorEnvelope
          nlinarith only [hraw, hmain, herr, hsqrt,
            mul_nonneg hconst.le (show 0 ≤ Real.sqrt n + 1 by positivity)]
    _ = _ := by simp

private theorem log_power_over_power (k : ℕ) {s : ℝ} (hs : 0 < s) :
    Tendsto (fun n : ℕ => (Real.log n) ^ k / (n : ℝ) ^ s) atTop (𝓝 0) := by
  simpa only [Function.comp_def, Real.rpow_natCast] using
    ((isLittleO_log_rpow_rpow_atTop (k : ℝ) hs).tendsto_div_nhds_zero.comp
      (tendsto_natCast_atTop_atTop (R := ℝ)))

/-- The errors for a single residue class save more than ten powers of the logarithm,
even after taking the maximum over prefixes and the growing range of moduli. -/
theorem envelope_saving (M : ℝ) :
    Tendsto (fun n : ℕ => (Real.log n) ^ 24 * errorEnvelope M n / n) atTop (𝓝 0) := by
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hmain : Tendsto (fun n : ℕ => M * 2 ^ 40 / (Real.log n) ^ 16) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop ((tendsto_pow_atTop (α := ℝ) (by decide : 16 ≠ 0)).comp hlog)
  have hself (k : ℕ) : Tendsto (fun n : ℕ => (Real.log n) ^ k / (n : ℝ)) atTop (𝓝 0) := by
    simpa only [Real.rpow_one] using log_power_over_power k (show (0:ℝ) < 1 by norm_num)
  have hsqrt (k : ℕ) : Tendsto (fun n : ℕ => (Real.log n) ^ k / Real.sqrt n) atTop (𝓝 0) := by
    simpa only [Real.sqrt_eq_rpow] using log_power_over_power k (show (0:ℝ) < 1 / 2 by norm_num)
  have hsum := (((hmain.add ((hself 33).const_mul 2)).add ((hsqrt 25).const_mul 2)).add
    (hself 24)).add (((hsqrt 24).add (hself 24)).const_mul (Real.log 4 + 1))
  simp only [mul_zero, add_zero] at hsum
  apply hsum.congr'
  filter_upwards [eventually_ge_atTop (2 : ℕ)] with n hn
  have hn' : (1 : ℝ) < n := by exact_mod_cast (show 1 < n by omega)
  have hL := (Real.log_pos hn').ne'
  have hv := (Real.sqrt_pos.mpr (zero_lt_one.trans hn')).ne'
  have alg (L v : ℝ) (hL : L ≠ 0) (hv : v ≠ 0) :
      M * 2 ^ 40 / L ^ 16 + 2 * (L ^ 33 / v ^ 2) + 2 * (L ^ 25 / v) + L ^ 24 / v ^ 2 +
        (Real.log 4 + 1) * (L ^ 24 / v + L ^ 24 / v ^ 2) =
      L ^ 24 * (M * 2 ^ 40 * v ^ 2 / L ^ 40 + 2 * L ^ 9 + 2 * v * L + 1 +
        (Real.log 4 + 1) * (v + 1)) / v ^ 2 := by
    field_simp
  have h := alg (Real.log n) (Real.sqrt n) hL hv
  rw [Real.sq_sqrt (Nat.cast_nonneg n)] at h
  simpa [errorEnvelope] using h

end
end WaveSW


namespace WaveSW
open Finset Filter MeasureTheory
open scoped Topology
noncomputable section

def datum (n q a : ℕ) (t : ℝ) : ℂ :=
  (unitMean q a * kernel n (t-(a:ℝ)/q))^2 * phase (-(n:ℝ)*t)

def arcPiece (Q n q a : ℕ) (f : ℝ → ℂ) : ℂ :=
  ∫ t in ((a:ℝ)/q-WaveGeom.Radius Q n q)..((a:ℝ)/q+WaveGeom.Radius Q n q), f t

def model (Q n A B : ℕ) : ℂ := ∑ q ∈ Ioc A B, ∑ a ∈ WaveGeom.Numerators q,
    arcPiece Q n q a (datum n q a)
def actual (Q n A B : ℕ) : ℂ := ∫ t in (0:ℝ)..1, (WaveGeom.arcs Q n A B).indicator (integrand n) t

def D : ℝ := 2*(1+2*Real.pi)*(Real.log 4+2)
theorem D_pos : 0<D := by unfold D; positivity

private theorem unitBound (q a : ℕ) (hq : 0 < q) : ‖unitMean q a‖ ≤ 1 := by
  let U := (range q).filter (fun r => r.Coprime q)
  have hcard : U.card = q.totient := by
    rw [Nat.totient_eq_card_coprime]
    have h : U = (range q).filter (fun r => q.Coprime r) := by ext k; simp [U, Nat.coprime_comm]
    rw [h]
  have hφ : 0 < (q.totient : ℝ) := by exact_mod_cast Nat.totient_pos.mpr hq
  unfold unitMean
  rw [norm_div, Complex.norm_natCast, div_le_one hφ]
  refine (norm_sum_le _ _).trans ?_
  change ∑ r ∈ U, ‖phase ((r : ℝ) * ((a : ℝ) / q))‖ ≤ _
  simp only [phase, Complex.norm_exp_ofReal_mul_I, sum_const, nsmul_eq_mul, mul_one, hcard, le_refl]

theorem piece_bound {n q a : ℕ} (hn : 1 ≤ n) (hq : 0<q) (hQ : cutoff n ≤ q) (E : ℝ) (hE : 0≤E)
    (hp : prefixError n ((a:ℝ)/q) (unitMean q a) ≤ (q:ℝ)*E) :
    ‖arcPiece (cutoff n) n q a (integrand n) - arcPiece (cutoff n) n q a (datum n q a)‖ ≤ D*(q:ℝ)*E := by
  let r := (a:ℝ)/q
  let R := WaveGeom.Radius (cutoff n) n q
  let P := (q:ℝ)*E*(1+2*Real.pi)*((Real.log 4+2)*n)
  have hnR : (1:ℝ) ≤ n := by exact_mod_cast hn
  have hnpos : 0<(n:ℝ) := by linarith
  have hqpos : 0<(q:ℝ) := by exact_mod_cast hq
  have hR : 0≤R := by dsimp [R, WaveGeom.Radius]; positivity
  have h1 : (cutoff n:ℝ)/q ≤ 1 := (div_le_one hqpos).mpr (by exact_mod_cast hQ)
  have hRn : R ≤ 1/(n:ℝ) := by
    dsimp [R, WaveGeom.Radius]
    rw [←div_div]
    exact div_le_div_of_nonneg_right h1 hnpos.le
  have hcap : Chebyshev.theta n + ‖unitMean q a‖*(n+1:ℕ) ≤ (Real.log 4+2)*(n:ℝ) := by
    have h := mul_le_mul_of_nonneg_right (unitBound q a hq) (show 0≤(n:ℝ)+1 by positivity)
    push_cast
    linarith [Chebyshev.theta_le_log4_mul_x (Nat.cast_nonneg n)]
  have hi : Continuous (datum n q a) := by unfold datum kernel phase; fun_prop
  have hb (t : ℝ) (ht : t ∈ Set.uIoc (r-R) (r+R)) : ‖integrand n t - datum n q a t‖ ≤ P := by
    rw [Set.uIoc_of_le (by linarith)] at ht
    have hβ : |t-r| ≤ R := by rw [abs_le]; exact ⟨by linarith [ht.1], by linarith [ht.2]⟩
    have h := squared_arc_error (a:=a) hn hq hβ
    dsimp only at h
    change ‖integrand n (r+(t-r)) - (unitMean q a * kernel n (t-r))^2 * phase (-(n:ℝ)*(r+(t-r)))‖ ≤ _ at h
    rw [show r+(t-r)=t by ring] at h
    refine h.trans ?_
    dsimp only [P]
    apply mul_le_mul _ hcap (by positivity) (by positivity)
    exact mul_le_mul hp (by nlinarith only [mul_le_mul_of_nonneg_left h1 (show 0≤2*Real.pi by positivity)]) (by positivity) (by positivity)
  unfold arcPiece
  rw [← intervalIntegral.integral_sub ((continuous_integrand n).intervalIntegrable ..) (hi.intervalIntegrable ..)]
  have H := intervalIntegral.norm_integral_le_of_norm_le_const hb
  have ha : |r + R - (r-R)|=2*R := by rw [abs_of_nonneg (by linarith)]; ring
  rw [ha] at H
  refine H.trans ?_
  calc
    P * (2*R) ≤ P * (2*(1/n)) := by gcongr
    _ = _ := by dsimp [P,D]; field_simp <;> ring

def splitAt (n : ℕ) : ℕ := ⌊(Real.log (n:ℝ))^8⌋₊

theorem band_bound (M : ℝ) (hM : 0<M) (n T : ℕ) (hn : 2≤n) (hL : 1≤Real.log (n:ℝ))
    (hT : (T:ℝ) ≤ (Real.log n)^8) (hQ : 1≤cutoff n) (hQn : cutoff n≤n) (hs : 2*cutoff n*T<n)
    (hp : ∀ q a : ℕ, 0<q → (q:ℝ)≤(Real.log n)^8 →
       prefixError n ((a:ℝ)/q) (unitMean q a) ≤ q * errorEnvelope M n) :
    ‖actual (cutoff n) n (cutoff n) T - model (cutoff n) n (cutoff n) T‖ ≤
      2*D*(Real.log n)^24*errorEnvelope M n := by
  let E := errorEnvelope M n
  have hE : 0≤E := by dsimp [E,errorEnvelope]; positivity
  have hD := D_pos
  have split := WaveGeom.integral_eq_sum (cutoff n) n (cutoff n) T hQ hQn hs (integrand n) (continuous_integrand n)
  unfold actual model
  rw [split, ← Finset.sum_sub_distrib]
  simp_rw [← Finset.sum_sub_distrib]
  have hR : (1:ℝ) ≤ (Real.log n)^8 := one_le_pow₀ hL
  let L := (Real.log n)^8
  have hqBound (q : ℕ) (hq : q ∈ Finset.Ioc (cutoff n) T) : (q:ℝ) ≤ L :=
    le_trans (by exact_mod_cast (Finset.mem_Ioc.mp hq).2) hT
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ _q ∈ Ioc (cutoff n) T, (2*L)*(D*L*E) := by
      apply sum_le_sum
      intro q hq
      refine (norm_sum_le _ _).trans ?_
      have hq' := (Finset.mem_Ioc.mp hq).1
      have hqr := hqBound q hq
      calc
        _ ≤ ∑ _a ∈ WaveGeom.Numerators q, D*L*E := by
          apply sum_le_sum
          intro a _
          exact (piece_bound (a:=a) (by omega) (by omega) (by omega) E hE (hp q a (by omega) hqr)).trans
            (by gcongr)
        _ = ((WaveGeom.Numerators q).card:ℝ)*(D*L*E) := by simp
        _ ≤ _ := by
          have hc : (WaveGeom.Numerators q).card ≤ q+1 :=
            (Finset.card_le_card (Finset.filter_subset _ _)).trans_eq (Finset.card_range _)
          have hc' : ((WaveGeom.Numerators q).card:ℝ) ≤ (q:ℝ)+1 := by exact_mod_cast hc
          gcongr
          change (1:ℝ)≤L at hR
          linarith
    _ = ((Ioc (cutoff n) T).card:ℝ)*((2*L)*(D*L*E)) := by simp
    _ ≤ L*((2*L)*(D*L*E)) := by
      gcongr
      have hc : (Ioc (cutoff n) T).card ≤ T := by simp
      exact (show ((Ioc (cutoff n) T).card:ℝ) ≤ T by exact_mod_cast hc).trans hT
    _ = _ := by dsimp [L,E]; ring
end
end WaveSW

namespace WaveSW
open Filter
open scoped Topology
noncomputable section
def upper (n : ℕ) : ℕ := ⌊Real.exp (Real.sqrt (Real.log (n:ℝ)))⌋₊

theorem eventual_scales : ∀ᶠ n : ℕ in atTop, 2≤n ∧ 1≤Real.log (n:ℝ) ∧
    1≤cutoff n ∧ cutoff n≤ splitAt n ∧ splitAt n≤upper n ∧ 2*(upper n)^2<n ∧
    (Real.log (n:ℝ))^8 / 2 ≤ (splitAt n:ℝ) := by
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hs := Real.tendsto_sqrt_atTop.comp hlog
  filter_upwards [eventually_ge_atTop (2:ℕ),hlog.eventually_ge_atTop 16,
    hs.eventually_ge_atTop (Nat.factorial 17 : ℝ)] with n hn hL hfac
  change 16≤Real.log (n:ℝ) at hL
  change (Nat.factorial 17:ℝ)≤Real.sqrt (Real.log (n:ℝ)) at hfac
  let L := Real.log (n:ℝ)
  let x := Real.sqrt L
  change 16≤L at hL
  change _≤x at hfac
  have hx : 0≤x := Real.sqrt_nonneg _
  have hxsq : x^2=L := Real.sq_sqrt (by linarith)
  have hL1 : 1≤L := by linarith
  have hL16 : 16≤L^6 :=
    (show (16:ℝ) ≤ 16^6 by norm_num).trans (pow_le_pow_left₀ (by norm_num) hL 6)
  have hQ : (cutoff n:ℝ) ≤ L^8 := (cutoff_le_log_sq hn).trans (by
    have hh := mul_le_mul_of_nonneg_right hL16 (sq_nonneg L)
    nlinarith only [hh])
  have hQT : cutoff n ≤ splitAt n := Nat.le_floor hQ
  have hpow : x^16 ≤ Real.exp x := by
    refine le_trans ?_ (Real.pow_div_factorial_le_exp x hx 17)
    apply (le_div_iff₀ (by positivity)).mpr
    rw [pow_succ]
    exact mul_le_mul_of_nonneg_left hfac (pow_nonneg hx 16)
  have hTB : splitAt n ≤ upper n := by
    apply Nat.floor_le_floor
    have hLx : L^8 = x^16 := by rw [← hxsq,←pow_mul]
    exact hLx ▸ hpow
  have hB : (upper n:ℝ) ≤ Real.exp x := Nat.floor_le (Real.exp_pos _).le
  have hx4 : 4 ≤ x := by nlinarith [sq_nonneg (x-4)]
  have hsmall : 2*x+1 ≤ L := by nlinarith [mul_nonneg (show 0≤x-4 by linarith) (show 0≤x+2 by linarith)]
  have htwo : (2:ℝ)<Real.exp 1 := by linarith [Real.exp_one_gt_d9]
  have hBN : 2*(upper n)^2 < n := by
    have hnpos : 0<(n:ℝ) := by exact_mod_cast (by omega : 0<n)
    have he : 2*(upper n:ℝ)^2 < (n:ℝ) := calc
      _ ≤ 2*(Real.exp x)^2 := by gcongr
      _ < Real.exp 1 * (Real.exp x)^2 := by gcongr
      _ = Real.exp (2*x+1) := by rw [Real.exp_add,show 2*x = x+x by ring,Real.exp_add]; ring
      _ ≤ Real.exp L := Real.exp_le_exp.mpr hsmall
      _ = _ := Real.exp_log hnpos
    exact_mod_cast he
  have hQ1 : 1≤cutoff n := by
    have h := Nat.le_log_of_pow_le (by norm_num : 1<2) (show 2^1 ≤ n+2 by omega)
    unfold cutoff
    simpa using Nat.pow_le_pow_left h 2
  have ht0 := Nat.lt_floor_add_one (L^8)
  have hbig : 2≤L^8 := (show (2:ℝ) ≤ 16^8 by norm_num).trans (pow_le_pow_left₀ (by norm_num) hL 8)
  exact ⟨hn,hL1,hQ1,hQT,hTB,hBN,by change L^8/2 ≤ (⌊L^8⌋₊:ℝ); linarith⟩

theorem scaleRatio (n : ℕ) (hn : 2≤n) (hL : 1≤Real.log (n:ℝ))
    (hT : (Real.log (n:ℝ))^8/2 ≤ (splitAt n:ℝ)) (C : ℝ) (hC : 0≤C) :
    C*(cutoff n:ℝ)*(1+Real.log n)^2/(splitAt n:ℝ) ≤ 128*C/(Real.log n)^4 := by
  let L := Real.log (n:ℝ)
  change 1 ≤ L at hL
  have hp : 0<L := by linarith
  have h₂ : (1+L)^2 ≤ (2*L)^2 := pow_le_pow_left₀ (by positivity) (by linarith) 2
  change C*(cutoff n:ℝ)*(1+L)^2/(splitAt n:ℝ) ≤ 128*C/L^4
  calc
    _ ≤ (C*(16*L^2)*(2*L)^2)/(L^8/2) := by
      apply div_le_div₀ (by positivity) _ (by positivity) hT
      exact mul_le_mul (mul_le_mul_of_nonneg_left (cutoff_le_log_sq hn) hC) h₂ (sq_nonneg _) (by positivity)
    _ = _ := by field_simp <;> ring
end
end WaveSW

namespace WaveSW
open Finset Filter MeasureTheory
open scoped Topology
noncomputable section

private theorem splitSum {A T B : ℕ} (hAT : A≤T) (hTB : T≤B) (g : ℕ → ℂ) :
    ∑ q ∈ Ioc A B, g q = (∑ q ∈ Ioc A T, g q) + ∑ q ∈ Ioc T B, g q := by
  rw [← Ioc_union_Ioc_eq_Ioc hAT hTB, Finset.sum_union (Ioc_disjoint_Ioc_of_le le_rfl)]

theorem deltas_split (Q n A T B : ℕ) (hA : 1≤A) (hAT : A≤T) (hTB : T≤B)
    (hQn : Q≤n) (hs : 2*Q*B<n) :
    actual Q n A B-model Q n A B =
        (actual Q n A T-model Q n A T) + (actual Q n T B-model Q n T B) := by
  have hsT : 2*Q*T<n := lt_of_le_of_lt (Nat.mul_le_mul_left _ hTB) hs
  have eq1 := WaveGeom.integral_eq_sum Q n A B hA hQn hs (integrand n) (continuous_integrand n)
  have eq2 := WaveGeom.integral_eq_sum Q n A T hA hQn hsT (integrand n) (continuous_integrand n)
  have eq3 := WaveGeom.integral_eq_sum Q n T B (by omega) hQn hs (integrand n) (continuous_integrand n)
  unfold actual model
  rw [eq1,eq2,eq3, splitSum hAT hTB (fun q => ∑ a ∈ WaveGeom.Numerators q,
        ∫ t in ((a:ℝ)/q-WaveGeom.Radius Q n q)..((a:ℝ)/q+WaveGeom.Radius Q n q), integrand n t),
      splitSum hAT hTB (fun q => ∑ a ∈ WaveGeom.Numerators q, arcPiece Q n q a (datum n q a))]
  abel

theorem whole (bound : ∀ Q n A B : ℕ, 1≤A → 0<B → B^2≤n → 2≤n →
      ‖actual Q n A B - model Q n A B‖ ≤ 40*(n:ℝ)*Q*(1+Real.log n)^2/A) :
    ∀ e : ℝ, 0<e → ∀ᶠ n : ℕ in atTop,
      ‖actual (cutoff n) n (cutoff n) (upper n) - model (cutoff n) n (cutoff n) (upper n)‖ ≤ e*n := by
  intro e he
  obtain ⟨M,hM,hpref⟩ := uniform_prefix_error
  have hl := (envelope_saving M).const_mul (2*D)
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hh : Tendsto (fun n : ℕ => (128*40:ℝ)/(Real.log n)^4) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop ((tendsto_pow_atTop (α:=ℝ) (by decide : 4≠0)).comp hlog)
  simp only [mul_zero] at hl
  have he0 : (0:ℝ) < e/2 := by linarith
  filter_upwards [eventual_scales,hpref,hl.eventually_lt_const he0,hh.eventually_lt_const he0] with n hn hp hsmall hlarge
  obtain ⟨hn,hL,hQ,hQT,hTB,hB2,hTlog⟩ := hn
  have hnR : 0<(n:ℝ) := by exact_mod_cast (by omega : 0<n)
  have hQB := hQT.trans hTB
  have hs : 2*cutoff n*upper n<n :=
    (show 2*cutoff n*upper n ≤ 2*(upper n)^2 by nlinarith [Nat.mul_le_mul_right (upper n) hQB]).trans_lt hB2
  have hQn : cutoff n≤n := by nlinarith [Nat.pow_le_pow_left hQB 2, Nat.one_le_pow 2 _ (by omega : 0<cutoff n), Nat.mul_self_le_mul_self hQB]
  have hT := Nat.floor_le (show 0≤(Real.log (n:ℝ))^8 by positivity)
  have low := band_bound M hM n (splitAt n) hn hL hT hQ hQn ((Nat.mul_le_mul_left _ hTB).trans_lt hs) hp
  have hlow : 2*D*(Real.log n)^24*errorEnvelope M n ≤ e/2*(n:ℝ) := by
    apply (div_le_iff₀ hnR).mp
    have hs := hsmall.le
    change 2*D*((Real.log n)^24*errorEnvelope M n/n) ≤ e/2 at hs
    convert hs using 1 <;> ring
  have high := bound (cutoff n) n (splitAt n) (upper n) (by omega) (by omega) (by omega) hn
  have hhRat := scaleRatio n hn hL hTlog 40 (by norm_num)
  have hhigh : 40*(n:ℝ)*(cutoff n:ℝ)*(1+Real.log n)^2/(splitAt n:ℝ) ≤ e/2*(n:ℝ) := by
    have h := mul_le_mul_of_nonneg_right (hhRat.trans hlarge.le) hnR.le
    convert h using 1 <;> ring
  rw [deltas_split _ _ _ _ _ hQ hQT hTB hQn hs]
  exact (norm_add_le _ _).trans ((add_le_add (low.trans hlow) (high.trans hhigh)).trans_eq (by ring))
end
end WaveSW


/- The large-sieve, separation and reciprocal-totient steps adapt the documented sources from muxkin, goldbach-proofs contribution 1708, c56bb450d43259dd871d29020d53facb6e5de557 (Apache-2.0). Separation adapts wzhxzkk’s frontier calculation; the sharp kernel is from OpenAI, openai/math, 3344da59991ed94f9ba711217b29c1d760badfa6. -/
section

namespace GoldbachEstermann
open Finset

/-- Each divisor has totient at most that of the ambient integer. Summing over
divisors and using Gauss's identity gives a divisor-count majorant. -/
private theorem inv_totient_le_pairs (q : ℕ) (hq : 0 < q) :
    1 / (q.totient : ℝ) ≤ ∑ ab ∈ q.divisorsAntidiagonal, ((ab.1:ℝ)⁻¹ * (ab.2:ℝ)⁻¹) := by
  have hφ := Nat.totient_pos.mpr hq
  have hcount : q ≤ q.divisors.card * q.totient := by
    calc
      _ = ∑ d ∈ q.divisors, d.totient := (Nat.sum_totient q).symm
      _ ≤ ∑ _ ∈ q.divisors, q.totient := sum_le_sum (fun d hd =>
        Nat.le_of_dvd hφ (Nat.totient_dvd_of_dvd (Nat.dvd_of_mem_divisors hd)))
      _ = _ := by simp
  calc
    _ ≤ (q.divisors.card : ℝ) / q := (div_le_div_iff₀ (by exact_mod_cast hφ) (by exact_mod_cast hq)).mpr
      (by rw [one_mul]; exact_mod_cast hcount)
    _ = ∑ _ ∈ q.divisorsAntidiagonal, (q:ℝ)⁻¹ := by
      rw [Nat.sum_divisorsAntidiagonal (fun _ _ => (q:ℝ)⁻¹)]; simp [div_eq_mul_inv]
    _ = _ := by
      apply sum_congr rfl
      intro ab hab
      rw [← (Nat.mem_divisorsAntidiagonal.mp hab).1, Nat.cast_mul, mul_inv]

/-- A finite reciprocal-totient bound with constant one. -/
theorem sum_inv_totient_le (Q : ℕ) :
    (∑ q ∈ Icc 1 Q, 1 / (q.totient : ℝ)) ≤ (1 + Real.log Q)^2 := by
  let S := Icc 1 Q
  let w := fun ab : ℕ × ℕ => (ab.1:ℝ)⁻¹ * (ab.2:ℝ)⁻¹
  have hf (q : ℕ) (hq : q ∈ S) :
      q.divisorsAntidiagonal = (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q) := by
    obtain ⟨hq0,hqQ⟩ := mem_Icc.mp hq
    ext ab
    constructor
    · intro hab
      have hf := Nat.fst_mem_divisors_of_mem_antidiagonal hab
      have hs := Nat.snd_mem_divisors_of_mem_antidiagonal hab
      have hm (a : ℕ) (ha : a ∈ q.divisors) : a ∈ S :=
        mem_Icc.mpr ⟨Nat.pos_of_mem_divisors ha,(Nat.le_of_dvd hq0 (Nat.dvd_of_mem_divisors ha)).trans hqQ⟩
      exact mem_filter.mpr ⟨mem_product.mpr ⟨hm _ hf,hm _ hs⟩,(Nat.mem_divisorsAntidiagonal.mp hab).1⟩
    · intro hab
      exact Nat.mem_divisorsAntidiagonal.mpr ⟨(mem_filter.mp hab).2,by omega⟩
  have hsum : (∑ i ∈ S, (i:ℝ)⁻¹) ≤ 1+Real.log Q := by
    simpa only [S,harmonic_eq_sum_Icc,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast] using harmonic_le_one_add_log Q
  calc
    _ ≤ ∑ q ∈ S, ∑ ab ∈ q.divisorsAntidiagonal, w ab :=
      sum_le_sum (fun q hq => inv_totient_le_pairs q (mem_Icc.mp hq).1)
    _ = ∑ q ∈ S, ∑ ab ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q), w ab :=
      sum_congr rfl (fun q hq => by rw [hf q hq])
    _ = ∑ ab ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2 ∈ S), w ab :=
      sum_fiberwise_eq_sum_filter _ _ _ _
    _ ≤ ∑ ab ∈ S ×ˢ S, w ab := sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun _ _ _ => by dsimp [w]; positivity)
    _ = (∑ i ∈ S, (i:ℝ)⁻¹)^2 := by rw [sq,sum_product,sum_mul_sum]
    _ ≤ _ := pow_le_pow_left₀ (sum_nonneg fun _ _ => by positivity) hsum 2

end GoldbachEstermann

