theorem oneConductorClass_of_filter {q K : ℕ} (T : Finset (ModulusTag q))
    (c : DirichletCharacter ℂ q ⧸ boundedConductorSubgroup q K) :
    OneConductorClass K (T.filter fun t=>conductorClass K t.1.1=c) :=
  fun _ ht _ hu=>(mem_filter.mp ht).2.trans (mem_filter.mp hu).2.symm

private theorem class_image_mem_of_classical {q K : ℕ} (T : Finset (ModulusTag q))
    (c : DirichletCharacter ℂ q ⧸ boundedConductorSubgroup q K)
    (hc : c∈@Finset.image _ _ (Classical.decEq _) (fun t=>conductorClass K t.1.1) T) :
    c∈T.image (fun t=>conductorClass K t.1.1) := by
  obtain ⟨t,ht,he⟩ : ∃ t∈T, conductorClass K t.1.1=c := by
    letI : DecidableEq (DirichletCharacter ℂ q ⧸ boundedConductorSubgroup q K) := Classical.decEq _
    exact mem_image.mp hc
  exact mem_image.mpr ⟨t,ht,he⟩

private theorem class_tail_clipped {q K : ℕ} (T : Finset (ModulusTag q))
    (c : DirichletCharacter ℂ q ⧸ boundedConductorSubgroup q K) {B y C : ℝ} (hBy : B≤y)
    (hTail : (∑ t∈(T.filter (fun t=>conductorClass K t.1.1=c)).filter
      (fun t=>y < modulusGap q t.1.2),gapWeight (modulusGap q t.1.2))≤C) :
    (∑ t∈(@Finset.filter _ (fun t=>conductorClass K t.1.1=c) (Classical.decPred _) T).filter
      (fun t=>y < modulusGap q t.1.2),clippedGapWeight B (modulusGap q t.1.2))≤C := by
  rw [Finset.filter_congr_decidable T (fun t=>conductorClass K t.1.1=c) (Classical.decPred _)]
  calc
    _ = ∑ t∈(T.filter (fun t=>conductorClass K t.1.1=c)).filter
        (fun t=>y < modulusGap q t.1.2),gapWeight (modulusGap q t.1.2) := by
      apply sum_congr rfl
      intro t ht
      exact congrArg gapWeight (max_eq_left (hBy.trans (mem_filter.mp ht).2.le))
    _ ≤ _ := hTail

theorem census_376_low_class_square_eventually {H U : ℝ} (K : ℕ) (hH : (0.226:ℝ)≤H) :
