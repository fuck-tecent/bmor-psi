/-- Assemble the rational prime test rows and the principal/different-character
Gram entries for actual zeros with their analytic multiplicities. -/
theorem rational_zero_gram_of_tests {q : ℕ} [NeZero q]
    (S : Finset (DirichletCharacter ℂ q × ℂ)) {b anchor high L r ξrow ξpair δ : ℝ}
    (hb : 0<b) (hAnchor : 0≤anchor) (hba : anchor<b) (hL : 0<L)
    (hr : 0≤r) (hR : 1≤L*r) (hδ : 0≤δ) (hξrow : 0≤ξrow) (hξpair : 0≤ξpair)
    (hHigh : high≤L*r) (hGap : ξrow≤rationalPsi b anchor high)
    (hFar : 1+b+2*b^2/3 ≤ (δ/2)*realRationalZeroKernel b (-anchor)*(L*r))
    (hZero : ∀ i∈S, regularizedL i.1 i.2=0)
    (hRange : ∀ i∈S, anchor≤zeroLossAt L i.2 ∧ zeroLossAt L i.2≤high)
    (hLocal : ∀ j∈S, ∃ V : Finset ℂ,
      (∀ ρ : ℂ, ‖ρ-line 1 j.2.im‖≤2*r → regularizedL j.1 ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V →
        (rationalPrimeTest j.1 b L (line (1-anchor/L) j.2.im)).re ≤
          L*realRationalZeroKernel b (-anchor)*ξrow -
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL j.1) ρ:ℝ)*
            (rationalZeroKernel b ((L:ℂ)*(line (1-anchor/L) j.2.im-ρ))).re)
    (hP : rationalGramTest (1:DirichletCharacter ℂ 1) b L (1-anchor/L) 0 ≤
      L*realRationalZeroKernel b (-anchor)*(1+δ))
    (hPr : ∀ i∈S, ∀ j∈S, i.1=j.1 →
      rationalGramTest (1:DirichletCharacter ℂ q) b L (1-anchor/L) (j.2.im-i.2.im) ≤
        L*realRationalZeroKernel b (-anchor)*
          (principalRationalPair b anchor (L*(j.2.im-i.2.im))+δ/2))
    (hOff : ∀ i∈S, ∀ j∈S, i.1≠j.1 →
      rationalGramTest (j.1*i.1⁻¹) b L (1-anchor/L) (j.2.im-i.2.im) ≤
        L*realRationalZeroKernel b (-anchor)*(ξpair+δ)) :
    let m := zeroGramMultiplicity (q:=q)
    let a := rationalSameZeroWeight (q:=q) b anchor L r
    let ψ (i : DirichletCharacter ℂ q × ℂ) := rationalPsi b anchor (zeroLossAt L i.2)
    let H := weightedCount S m a
    let N := ordinaryCount S m
    let D := excess S m ψ (rationalPsi b anchor high)
    N≤H ∧ 0≤D ∧
      (H*(rationalPsi b anchor high-ξrow)+D)^2≤
        H+ξpair*(H^2-H)+δ*(2+ξpair+δ)*H^2 := by
  classical
  dsimp only
  let I := DirichletCharacter ℂ q × ℂ
  let m := zeroGramMultiplicity (q:=q)
  let a := rationalSameZeroWeight (q:=q) b anchor L r
  let ψ (i : I) := rationalPsi b anchor (zeroLossAt L i.2)
  let σ := 1-anchor/L
  let C := L*realRationalZeroKernel b (-anchor)
  let P := rationalGramTest (1:DirichletCharacter ℂ 1) b L σ 0 / C
  let u (i : I) := -(rationalGramTest i.1 b L σ i.2.im)/C
  let g (i j : I) := rationalGramTest (j.1*i.1⁻¹) b L σ (j.2.im-i.2.im)/C
  have hC : 0<C := mul_pos hL (realRationalZeroKernel_pos hb (by linarith only [hba]))
  have hσ : 1<σ+b/L := by
    unfold σ
    have := div_pos (sub_pos.mpr hba) hL
    rw [sub_div] at this
    linarith
  obtain ⟨hP₀,hG₀,hCS⟩ := rational_prime_series_gram_cauchy S m
    (fun i=>i.1) (fun i=>i.2.im) hb.le hL.le hσ hC
  have hP' : P≤1+δ := by
    apply (div_le_iff₀ hC).mpr
    change _ ≤ (1+δ)*C
    rw [mul_comm]
    exact hP
  have hRows (j : I) (hj : j∈S) : (∑ i∈S,(m i:ℝ)*a i j*ψ i)-ξrow≤u j := by
    obtain ⟨V,hV,hTest⟩ := hLocal j hj
    have h := rational_zero_row_of_local_test S j hb hba hAnchor hL hr hHigh hZero hRange V hV hTest
    simpa only [m,a,ψ,u,C,σ,rationalGramTest,line_real_add_imag] using h
  have hG (i : I) (hi : i∈S) (j : I) (hj : j∈S) :
      g i j≤a i j+(if i.1=j.1 then 0 else ξpair)+δ := by
    by_cases h : i.1=j.1
    · rw [ite_eq_left h,add_zero]
      let t := L*(j.2.im-i.2.im)
      have hTime : |t|≤L*r ↔ |j.2.im-i.2.im|≤r := by
        dsimp only [t]
        rw [abs_mul,abs_of_pos hL]
        exact ⟨fun h=>le_of_mul_le_mul_left h hL,fun h=>mul_le_mul_of_nonneg_left h hL.le⟩
      have hLow : (if |t|≤L*r then rationalPair b anchor (zeroLossAt L i.2) t else 0)=a i j := by
        simp only [hTime,a,rationalSameZeroWeight,rationalNearZeroPair,h,true_and,t]
      have hTail := principalRationalPair_le_near_mask (t:=t) hb hAnchor hba (hRange i hi).1
        hR (by positivity : (0:ℝ)≤δ/2) hFar
      rw [hLow] at hTail
      have hMain : g i j≤principalRationalPair b anchor t+δ/2 := by
        unfold g
        rw [←h,mul_inv_cancel]
        apply (div_le_iff₀ hC).mpr
        simpa only [C,t,σ,mul_comm C] using hPr i hi j hj h
      linarith only [hTail,hMain]
    · rw [ite_eq_right h]
      have hA : a i j=0 := by simp [a,rationalSameZeroWeight,rationalNearZeroPair,h]
      rw [hA,zero_add]
      apply (div_le_iff₀ hC).mpr
      simpa only [C,σ,mul_comm C] using hOff i hi j hj h
  exact cauchy_to_weighted_gram S m a g (fun i j=>i.1=j.1) u ψ
    (fun i hi=>zeroGramMultiplicity_pos (hZero i hi))
    (fun i hi j _=>rationalSameZeroWeight_nonneg hb (hRange i hi).1)
    (fun i hi=>le_of_eq (rationalSameZeroWeight_diag hb hr (hRange i hi).1).symm)
    (fun _=>rfl) (fun i hi=>rationalPsi_ge_cut hb hba (hRange i hi).1 (hRange i hi).2)
    hξrow hξpair hδ hGap hP₀ hP' hRows
    (fun i hi j hj => by
      by_cases h : i.1=j.1
      · simpa only [h,ite_true] using hG i hi j hj
      · simpa only [h,ite_false] using hG i hi j hj)
    hG₀ hCS

end
end GoldbachPintzWeightedGram
end

