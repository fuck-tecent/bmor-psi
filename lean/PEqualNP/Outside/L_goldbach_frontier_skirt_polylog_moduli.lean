  have hs : (∑z∈R,(analyticOrderNatAt riemannZeta z:ℝ))+
      (∑z∈L,(analyticOrderNatAt riemannZeta z:ℝ))=
      ∑z∈S,(analyticOrderNatAt riemannZeta z:ℝ) :=
    Finset.sum_filter_add_sum_filter_not S (fun z=>1/2≤z.re) _
