open scoped BigOperators Classical FourierTransform SchwartzMap
open MeasureTheory

namespace ShortAPDualPolynomial

/-! A Poisson form of the primitive-character duality used in the analysis of
Koukoulopoulos, *Primes in short arithmetic progressions*, §3, Lemma 3.3
(arXiv:1405.6592v2). -/

private def residueEquiv (q : ℕ) [NeZero q] : (ZMod q × ℤ) ≃ ℤ where
  toFun p := (p.1.val : ℤ) + (q : ℤ) * p.2
  invFun n := ((n : ZMod q), n / (q : ℤ))
  left_inv := by
    rintro ⟨a, j⟩
    apply Prod.ext
    · exact (ZMod.intCast_eq_iff q _ a).mpr ⟨j, rfl⟩
    · change ((a.val : ℤ) + (q : ℤ) * j) / (q : ℤ) = j
      have hq : 0 < (q : ℤ) := by exact_mod_cast NeZero.pos q
      have ha : (a.val : ℤ) < (q : ℤ) := by exact_mod_cast ZMod.val_lt a
      rw [Int.add_mul_ediv_left _ _ hq.ne', Int.ediv_eq_zero_of_lt (by positivity) ha, zero_add]
  right_inv n := by
    change ((n : ZMod q).val : ℤ) + (q : ℤ) * (n / (q : ℤ)) = n
    rw [ZMod.val_intCast, Int.emod_add_mul_ediv]

private theorem summable_schwartz_int (f : 𝓢(ℝ, ℂ)) :
    Summable (fun n : ℤ => ‖f (n : ℝ)‖) := by
  have h := (f.isBigO_cocompact_rpow (-2)).norm_left.comp_tendsto Int.tendsto_coe_cofinite
  exact summable_of_isBigO (Real.summable_abs_int_rpow (by norm_num : (1 : ℝ) < 2)) h

private theorem summable_schwartz_add (f : 𝓢(ℝ, ℂ)) (x : ℝ) :
    Summable (fun n : ℤ => ‖f (x + (n : ℝ))‖) := by
  simpa only [SchwartzMap.compSubConstCLM_apply, sub_neg_eq_add, add_comm] using
    summable_schwartz_int (f.compSubConstCLM ℂ (-x))

private theorem fourier_residue (q : ℕ) [NeZero q] (a : ZMod q) (k : ℤ) :
    fourier k (((a.val : ℝ) / (q : ℝ) : ℝ) : UnitAddCircle) =
      ZMod.stdAddChar ((k : ZMod q) * a) := by
  have ha : ((a.val : ℤ) : ZMod q) = a := by rw [Int.cast_natCast, ZMod.natCast_zmod_val]
  conv_rhs => rw [← ha, ← Int.cast_mul, ZMod.stdAddChar_coe]
  rw [fourier_coe_apply]
  push_cast
  simp only [div_one]
  congr 1
  ring

private theorem norm_fourier_circle (x : UnitAddCircle) (k : ℤ) :
    ‖fourier k x‖ = 1 := by
  rw [fourier_apply, Circle.norm_coe]

/-- Exact Poisson duality, with the test function already in units of the
modulus. In particular, a physical test function `W` is represented by
`f x = W (q * x)`. No truncation or uniformity in the test function is asserted. -/
theorem primitive_poisson (q : ℕ) [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχ : χ.IsPrimitive) (f : 𝓢(ℝ, ℂ)) :
    (∑' n : ℤ, χ (n : ZMod q) * f ((n : ℝ) / (q : ℝ))) =
      gaussSum χ ZMod.stdAddChar * ∑' k : ℤ, χ⁻¹ (k : ZMod q) * (𝓕 f) (k : ℝ) := by
  let x (a : ZMod q) := (a.val : ℝ) / (q : ℝ)
  let A : ZMod q × ℤ → ℂ := fun p => χ p.1 * f (x p.1 + (p.2 : ℝ))
  let B : ZMod q × ℤ → ℂ := fun p =>
    χ p.1 * ((𝓕 f) (p.2 : ℝ) * fourier p.2 (x p.1 : UnitAddCircle))
  have hA : Summable A := by
    apply Summable.of_norm
    refine (summable_prod_of_nonneg (fun p => norm_nonneg (A p))).mpr
      ⟨fun a => ?_, Summable.of_finite⟩
    simpa only [A, norm_mul] using (summable_schwartz_add f (x a)).mul_left ‖χ a‖
  have hB : Summable B := by
    apply Summable.of_norm
    refine (summable_prod_of_nonneg (fun p => norm_nonneg (B p))).mpr
      ⟨fun a => ?_, Summable.of_finite⟩
    simpa only [B, norm_mul, norm_fourier_circle, mul_one] using
      (summable_schwartz_int (𝓕 f)).mul_left ‖χ a‖
  have hexpand (p : ZMod q × ℤ) :
      χ ((residueEquiv q p : ℤ) : ZMod q) *
        f ((residueEquiv q p : ℝ) / (q : ℝ)) = A p := by
    have hres : ((residueEquiv q p : ℤ) : ZMod q) = p.1 :=
      (ZMod.intCast_eq_iff q _ _).mpr ⟨p.2, rfl⟩
    rw [hres]
    congr 2
    have hq : (q : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne q
    change (((((p.1.val : ℤ) + (q : ℤ) * p.2) : ℤ) : ℝ) / (q : ℝ)) =
      (p.1.val : ℝ) / (q : ℝ) + (p.2 : ℝ)
    push_cast
    field_simp
  calc
    _ = ∑' p : ZMod q × ℤ, A p := by
      rw [← (residueEquiv q).tsum_eq]
      exact tsum_congr hexpand
    _ = ∑ a : ZMod q, χ a * ∑' j : ℤ, f (x a + (j : ℝ)) := by
      rw [hA.tsum_prod, tsum_fintype]
      simp only [A, tsum_mul_left]
    _ = ∑ a : ZMod q, ∑' k : ℤ, B (a, k) := by
      apply Finset.sum_congr rfl
      intro a _
      rw [f.tsum_eq_tsum_fourier (x a), ← tsum_mul_left]
    _ = ∑' k : ℤ, ∑ a : ZMod q, B (a, k) := by
      calc
        _ = ∑' a : ZMod q, ∑' k : ℤ, B (a, k) :=
          (tsum_fintype (fun a : ZMod q => ∑' k : ℤ, B (a, k))).symm
        _ = ∑' p : ZMod q × ℤ, B p := hB.tsum_prod.symm
        _ = ∑' p : ℤ × ZMod q, B (p.2, p.1) :=
          ((Equiv.prodComm ℤ (ZMod q)).tsum_eq B).symm
        _ = _ := by
          change (∑' p : ℤ × ZMod q, B p.swap) = _
          rw [hB.prod_symm.tsum_prod]
          simp only [tsum_fintype]
          rfl
    _ = ∑' k : ℤ, (𝓕 f) (k : ℝ) * gaussSum χ (ZMod.stdAddChar.mulShift (k : ZMod q)) := by
      apply tsum_congr
      intro k
      rw [gaussSum, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a _
      simp only [B, x, fourier_residue, AddChar.mulShift_apply]
      ring
    _ = _ := by
      rw [← tsum_mul_left]
      apply tsum_congr
      intro k
      rw [gaussSum_mulShift_of_isPrimitive _ hχ]
      ring

/-- A smooth compactly supported weight may be passed directly to the exact
duality. The compact support condition is on the full test function, including
any Dirichlet polynomial powers and logarithms. -/
theorem primitive_poisson_of_smooth_compact (q : ℕ) [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχ : χ.IsPrimitive) {f : ℝ → ℂ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hc : HasCompactSupport f) :
    (∑' n : ℤ, χ (n : ZMod q) * f ((n : ℝ) / (q : ℝ))) =
      gaussSum χ ZMod.stdAddChar * ∑' k : ℤ, χ⁻¹ (k : ZMod q) * (𝓕 f) (k : ℝ) := by
  exact primitive_poisson q hχ (hc.toSchwartzMap hf)

/-- Exact Poisson duality in the original units: the dual samples are at
`k / q`, and the Gauss normalization has modulus `√q / q`. -/
theorem primitive_poisson_scaled (q : ℕ) [NeZero q] {χ : DirichletCharacter ℂ q}
    (hχ : χ.IsPrimitive) (f : 𝓢(ℝ, ℂ)) :
    (∑' n : ℤ, χ (n : ZMod q) * f (n : ℝ)) =
      (gaussSum χ ZMod.stdAddChar / (q : ℂ)) *
        ∑' k : ℤ, χ⁻¹ (k : ZMod q) * (𝓕 f) ((k : ℝ) / (q : ℝ)) := by
  have hq : 0 < (q : ℝ) := by exact_mod_cast NeZero.pos q
  let E : ℝ ≃L[ℝ] ℝ := ContinuousLinearEquiv.smulLeft (Units.mk0 (q : ℝ) hq.ne')
  let F := SchwartzMap.compCLMOfContinuousLinearEquiv ℂ E f
  have hF (x : ℝ) : F x = f ((q : ℝ) * x) := rfl
  have hFourier (ξ : ℝ) : (𝓕 F) ξ = (q : ℂ)⁻¹ * (𝓕 f) (ξ / (q : ℝ)) := by
    simp only [SchwartzMap.fourier_coe, Real.fourier_real_eq_integral_exp_smul, hF]
    let g (y : ℝ) :=
      Complex.exp (↑(-2 * Real.pi * y * (ξ / (q : ℝ))) * Complex.I) • f y
    have he (x : ℝ) :
        Complex.exp (↑(-2 * Real.pi * x * ξ) * Complex.I) • f ((q : ℝ) * x) =
          g ((q : ℝ) * x) := by
      have he' : -2 * Real.pi * x * ξ = -2 * Real.pi * ((q : ℝ) * x) * (ξ / (q : ℝ)) := by
        field_simp
      simp only [g, ← he']
    simp_rw [he]
    rw [Measure.integral_comp_mul_left, abs_of_nonneg (inv_nonneg.mpr hq.le), Complex.real_smul,
      Complex.ofReal_inv, Complex.ofReal_natCast]
  calc
    _ = ∑' n : ℤ, χ (n : ZMod q) * F ((n : ℝ) / (q : ℝ)) := by
      apply tsum_congr
      intro n
      rw [hF]
      congr 2
      field_simp
    _ = _ := by
      rw [primitive_poisson q hχ F]
      simp_rw [hFourier]
      have hswap (k : ℤ) :
          χ⁻¹ (k : ZMod q) * ((q : ℂ)⁻¹ * (𝓕 f) ((k : ℝ) / (q : ℝ))) =
            (q : ℂ)⁻¹ * (χ⁻¹ (k : ZMod q) * (𝓕 f) ((k : ℝ) / (q : ℝ))) := by ring
      simp_rw [hswap]
      rw [tsum_mul_left, div_eq_mul_inv, mul_assoc]

private theorem inverse_even_iff (q : ℕ) (χ : DirichletCharacter ℂ q) :
    χ⁻¹.Even ↔ χ.Even := by
  change χ⁻¹ (-1) = 1 ↔ χ (-1) = 1
  rw [← MulChar.star_apply']
  constructor
  · intro h
    simpa only [star_star, star_one] using congrArg star h
  · intro h
    rw [h, star_one]

/-- The ratio of archimedean factors in the primitive Dirichlet functional
equation has norm one on the critical line. This uses conjugation, not
vertical-strip asymptotics. -/
theorem norm_gamma_ratio (q : ℕ) {χ : DirichletCharacter ℂ q} {s : ℂ}
    (hs : s.re = 1 / 2) :
    ‖DirichletCharacter.gammaFactor χ⁻¹ s / DirichletCharacter.gammaFactor χ (1 - s)‖ = 1 := by
  have hconj : 1 - s = star s := by
    apply Complex.ext
    · simp [hs]
      norm_num
    · simp
  have h Γ (hΓ : Γ = s ∨ Γ = s + 1) : 0 < (Γ : ℂ).re := by
    rcases hΓ with rfl | rfl <;> norm_num [hs]
  unfold DirichletCharacter.gammaFactor
  rw [propext (inverse_even_iff q χ), hconj]
  split_ifs with hχ
  · rw [Complex.star_def, Complex.Gammaℝ_conj, norm_div, Complex.norm_conj,
      div_self (norm_ne_zero_iff.mpr (Complex.Gammaℝ_ne_zero_of_re_pos (h s (Or.inl rfl))))]
  · have h' : star s + (1 : ℂ) = star (s + 1) := by rw [star_add, star_one]
    rw [h', Complex.star_def, Complex.Gammaℝ_conj,
      norm_div, Complex.norm_conj,
      div_self (norm_ne_zero_iff.mpr (Complex.Gammaℝ_ne_zero_of_re_pos (h _ (Or.inr rfl))))]

/-- On the critical line the *full* multiplier taking `L(s, χ⁻¹)` to
`L(1 - s, χ)` has modulus one, and its explicit form contains the
conductor, root number, and archimedean factors. -/
theorem primitive_functional_equation_critical (q : ℕ) [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ.IsPrimitive) {s : ℂ} (hs : s.re = 1 / 2) :
    ∃ a : ℂ, ‖a‖ = 1 ∧ χ.LFunction (1 - s) = a * χ⁻¹.LFunction s := by
  let r := χ.gammaFactor (1 - s)
  let g := χ⁻¹.gammaFactor s
  let w := (q : ℂ) ^ (s - 1 / 2) * χ.rootNumber
  have hg : g ≠ 0 := by
    intro hg
    have h := norm_gamma_ratio q (χ := χ) hs
    change ‖g / r‖ = 1 at h
    rw [hg, zero_div, norm_zero] at h
    norm_num at h
  have hr : r ≠ 0 := by
    intro hr
    have h := norm_gamma_ratio q (χ := χ) hs
    change ‖g / r‖ = 1 at h
    rw [hr, div_zero, norm_zero] at h
    norm_num at h
  have hs₁ : 1 - s ≠ 0 := by
    intro h
    have : (1 - s).re = 0 := congrArg Complex.re h
    simp only [Complex.sub_re, Complex.one_re, hs] at this
    norm_num at this
  have hs₂ : s ≠ 0 := by
    intro h
    rw [h, Complex.zero_re] at hs
    norm_num at hs
  have hw : ‖w‖ = 1 := by
    have hre : (s - 1 / 2).re = 0 := by
      rw [Complex.sub_re, hs]
      norm_num
    dsimp only [w]
    rw [norm_mul, Complex.norm_natCast_cpow_of_pos (NeZero.pos q), hre,
      Real.rpow_zero, DirichletCharacter.norm_rootNumber hχ, mul_one]
  refine ⟨w * (g / r), by rw [norm_mul, hw, one_mul]; exact norm_gamma_ratio q hs, ?_⟩
  rw [DirichletCharacter.LFunction_eq_completed_div_gammaFactor _ _ (Or.inl hs₁),
    DirichletCharacter.LFunction_eq_completed_div_gammaFactor _ _ (Or.inl hs₂),
    hχ.completedLFunction_one_sub]
  change w * χ⁻¹.completedLFunction s / r = w * (g / r) * (χ⁻¹.completedLFunction s / g)
  field_simp

private theorem norm_linear_vertical (r t : ℝ) :
    ‖(r : ℂ) + (t : ℂ) * Complex.I‖ ≤ (1 + |r|) * (1 + |t|) := by
  have h := norm_add_le (r : ℂ) ((t : ℂ) * Complex.I)
  rw [norm_mul, Complex.norm_real, Complex.norm_real, Complex.norm_I, mul_one,
    Real.norm_eq_abs, Real.norm_eq_abs] at h
  exact h.trans (by nlinarith [mul_nonneg (abs_nonneg r) (abs_nonneg t)])

/-- The functional-equation Gamma ratio has the right polynomial growth on
lines `Re(s) = 1/2 + 2m`. This is sufficient for the right-hand line of the
tail contour; the recurrence avoids invoking a complex Stirling estimate. -/
theorem gamma_ratio_vertical_growth (a : ℝ) (ha : a ∈ Set.Icc (0 : ℝ) 1) (m : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ,
      let s : ℂ := ((1 / 2 + 2 * (m : ℝ) : ℝ) : ℂ) + (t : ℂ) * Complex.I
      ‖Complex.Gammaℝ (s + (a : ℂ)) / Complex.Gammaℝ (1 - s + (a : ℂ))‖ ≤
        C * (1 + |t|) ^ (2 * m) := by
  let z (n : ℕ) (t : ℝ) : ℂ := ((1 / 2 + 2 * (n : ℝ) : ℝ) : ℂ) + (t : ℂ) * Complex.I
  let R (n : ℕ) (t : ℝ) := Complex.Gammaℝ (z n t + (a : ℂ)) /
    Complex.Gammaℝ (1 - z n t + (a : ℂ))
  let x (n : ℕ) (t : ℝ) := z n t + (a : ℂ)
  let y (n : ℕ) (t : ℝ) := 1 - z (n + 1) t + (a : ℂ)
  let p : ℂ := 2 * (Real.pi : ℂ)
  have hp : p ≠ 0 := mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
  have hp' : ‖p‖ = 2 * Real.pi := by
    dsimp only [p]
    rw [← Complex.ofReal_ofNat, ← Complex.ofReal_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (by positivity)]
  have hz (n : ℕ) (t : ℝ) : z (n + 1) t = z n t + 2 := by
    dsimp only [z]
    push_cast
    ring
  have hx (n : ℕ) (t : ℝ) :
      x n t = ((1 / 2 + 2 * (n : ℝ) + a : ℝ) : ℂ) + (t : ℂ) * Complex.I := by
    dsimp only [x, z]
    push_cast
    ring
  have hy (n : ℕ) (t : ℝ) :
      y n t = ((1 / 2 - 2 * ((n : ℝ) + 1) + a : ℝ) : ℂ) + ((-t : ℝ) : ℂ) * Complex.I := by
    dsimp only [y, z]
    push_cast
    ring
  have hrec (n : ℕ) (t : ℝ) : R (n + 1) t = R n t * (x n t / p) * (y n t / p) := by
    have hx₀ : x n t ≠ 0 := by
      intro h
      have hre := congrArg Complex.re h
      rw [hx] at hre
      simp at hre
      linarith [ha.1, Nat.cast_nonneg (α := ℝ) n]
    have hy₀ : y n t ≠ 0 := by
      intro h
      have hre := congrArg Complex.re h
      rw [hy] at hre
      simp at hre
      linarith [ha.2, Nat.cast_nonneg (α := ℝ) n]
    have h₁ : x n t + 2 = z (n + 1) t + (a : ℂ) := by
      dsimp only [x]
      rw [hz]
      ring
    have h₂ : y n t + 2 = 1 - z n t + (a : ℂ) := by
      dsimp only [y]
      rw [hz]
      ring
    change Complex.Gammaℝ (z (n + 1) t + (a : ℂ)) / Complex.Gammaℝ (y n t) =
      Complex.Gammaℝ (x n t) / Complex.Gammaℝ (1 - z n t + (a : ℂ)) *
        (x n t / p) * (y n t / p)
    rw [← h₁, ← h₂, Complex.Gammaℝ_add_two hx₀, Complex.Gammaℝ_add_two hy₀]
    by_cases h : Complex.Gammaℝ (y n t) = 0
    · simp [h]
    · dsimp only [p]
      have hπ := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
      field_simp
  change ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ, ‖R m t‖ ≤ C * (1 + |t|) ^ (2 * m)
  induction m with
  | zero =>
      refine ⟨1, zero_le_one, fun t => ?_⟩
      have he : 1 - z 0 t + (a : ℂ) = star (z 0 t + (a : ℂ)) := by
        dsimp only [z]
        apply Complex.ext <;> norm_num
      have hΓ : Complex.Gammaℝ (z 0 t + (a : ℂ)) ≠ 0 := by
        apply Complex.Gammaℝ_ne_zero_of_re_pos
        dsimp only [z]
        simp
        linarith [ha.1]
      dsimp only [R]
      rw [he, Complex.star_def, Complex.Gammaℝ_conj, norm_div, Complex.norm_conj,
        div_self (norm_ne_zero_iff.mpr hΓ)]
      simp
  | succ n ih =>
      obtain ⟨C, hC, hbound⟩ := ih
      let A := (1 + |(1 / 2 + 2 * (n : ℝ) + a : ℝ)|) / (2 * Real.pi)
      let B := (1 + |(1 / 2 - 2 * ((n : ℝ) + 1) + a : ℝ)|) / (2 * Real.pi)
      refine ⟨C * A * B, by dsimp only [A, B]; positivity, fun t => ?_⟩
      have hA : ‖x n t / p‖ ≤ A * (1 + |t|) := by
        rw [norm_div, hp', hx, div_mul_eq_mul_div]
        exact div_le_div_of_nonneg_right (norm_linear_vertical _ _) (by positivity)
      have hB : ‖y n t / p‖ ≤ B * (1 + |t|) := by
        rw [norm_div, hp', hy, div_mul_eq_mul_div]
        simpa only [abs_neg] using div_le_div_of_nonneg_right
          (norm_linear_vertical (1 / 2 - 2 * ((n : ℝ) + 1) + a) (-t)) (by positivity : 0 ≤ 2 * Real.pi)
      rw [hrec, norm_mul, norm_mul]
      calc
        _ ≤ (C * (1 + |t|) ^ (2 * n)) * (A * (1 + |t|)) * (B * (1 + |t|)) := by
          exact mul_le_mul (mul_le_mul (hbound t) hA (norm_nonneg _) (by positivity))
            hB (norm_nonneg _) (by dsimp only [A]; positivity)
        _ = _ := by
          rw [show 2 * (n + 1) = 2 * n + 2 by omega, pow_add, pow_two]
          ring

/-- On any fixed vertical line, a smooth test function supported in `[1,4]`
has Mellin transform decaying faster than any fixed inverse power. -/
theorem mellin_vertical_decay (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hsupp : ∀ x ∉ Set.Icc (1 : ℝ) 4, g x = 0) (σ : ℝ) (j : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ t : ℝ,
      ‖mellin g ((σ : ℂ) + (t : ℂ) * Complex.I)‖ ≤ C / (1 + |t| ^ j) := by
  let G (x : ℝ) := Real.exp (-σ * x) • g (Real.exp (-x))
  have hG : ContDiff ℝ (⊤ : ℕ∞) G := by
    unfold G
    fun_prop
  have hGc : HasCompactSupport G := by
    apply HasCompactSupport.of_support_subset_isCompact (K := Set.Icc (-Real.log 4) 0)
      isCompact_Icc
    intro x hx
    have hnon := Function.mem_support.mp hx
    have he : Real.exp (-x) ∈ Set.Icc (1 : ℝ) 4 := by
      by_contra hn
      exact hnon (by simp [G, hsupp _ hn])
    constructor
    · have h := (Real.le_log_iff_exp_le (by norm_num : (0 : ℝ) < 4)).mpr he.2
      linarith
    · have h : (0 : ℝ) ≤ -x :=
        Real.exp_le_exp.mp (by simpa only [Real.exp_zero] using he.1)
      linarith
  let F := 𝓕 (hGc.toSchwartzMap hG)
  let C := (SchwartzMap.seminorm ℂ 0 0 F) +
    (2 * Real.pi) ^ j * (SchwartzMap.seminorm ℂ j 0 F)
  refine ⟨C, by dsimp only [C]; positivity, fun t => ?_⟩
  have hπ : 0 < 2 * Real.pi := by positivity
  have hM : mellin g ((σ : ℂ) + (t : ℂ) * Complex.I) = F (t / (2 * Real.pi)) := by
    rw [mellin_eq_fourier]
    simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re, mul_zero,
      Complex.ofReal_im, Complex.I_im, sub_zero, add_zero, Complex.add_im,
      Complex.mul_im, mul_one, zero_add]
    rfl
  rw [hM]
  set w := t / (2 * Real.pi) with hw
  have h₀ := SchwartzMap.norm_le_seminorm ℂ F w
  have hj := SchwartzMap.norm_pow_mul_le_seminorm ℂ F j w
  have ht : |t| = (2 * Real.pi) * ‖w‖ := by
    rw [hw, Real.norm_eq_abs, abs_div, abs_of_pos hπ]
    field_simp
  apply (le_div_iff₀ (by positivity)).mpr
  rw [ht, mul_pow, mul_comm ‖F w‖, add_mul, one_mul, mul_assoc]
  exact add_le_add h₀ (mul_le_mul_of_nonneg_left hj (by positivity))

private noncomputable def phase (x w : ℝ) : ℂ := Complex.exp (↑(-2 * Real.pi * x * w) * Complex.I)

private theorem norm_phase (x w : ℝ) : ‖phase x w‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

/-- A fixed spectral gap isolates the constant coefficient under a Cauchy
weight. The constant is uniform in the size, coefficients, and other
frequencies of the polynomial. -/
theorem cauchy_weight_constant_coefficient (δ : ℝ) (hδ : 0 < δ) :
    ∃ C : ℝ, 0 < C ∧ ∀ {ι : Type} [DecidableEq ι] (s : Finset ι) (j : ι)
      (a : ι → ℂ) (w : ι → ℝ), j ∈ s → w j = 0 →
      (∀ k ∈ s, k ≠ j → δ ≤ |w k|) →
      ‖a j‖ ≤ C * ∫ x : ℝ,
        ‖∑ k ∈ s, a k * Complex.exp (↑(-2 * Real.pi * x * w k) * Complex.I)‖ /
          (1 + x ^ 2) := by
  let b : ContDiffBump (0 : ℝ) := ⟨δ / 2, δ, by linarith, by linarith⟩
  let v (x : ℝ) : ℂ := (b x : ℝ)
  have hv₁ : HasCompactSupport v := b.hasCompactSupport.comp_left Complex.ofReal_zero
  have hv₂ : ContDiff ℝ (⊤ : ℕ∞) v :=
    Complex.ofRealCLM.contDiff.comp b.contDiff
  let V := hv₁.toSchwartzMap hv₂
  let K : 𝓢(ℝ, ℂ) := 𝓕⁻ V
  let C := 1 + SchwartzMap.seminorm ℂ 0 0 K + SchwartzMap.seminorm ℂ 2 0 K
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro ι _ s j a w hj hw hg
  let P x := ∑ k ∈ s, a k * phase x (w k)
  have hK (x : ℝ) : ‖K x‖ ≤ C / (1 + x ^ 2) := by
    have h₀ := SchwartzMap.norm_le_seminorm ℂ K x
    have h₂ := SchwartzMap.norm_pow_mul_le_seminorm ℂ K 2 x
    rw [Real.norm_eq_abs, sq_abs] at h₂
    apply (le_div_iff₀ (by positivity)).mpr
    dsimp only [C]
    nlinarith
  have hV (k : ι) (hk : k ∈ s) : V (w k) = if k = j then 1 else 0 := by
    change v (w k) = _
    by_cases he : k = j
    · have hb0 : b 0 = 1 :=
        b.one_of_mem_closedBall (by simp [b]; positivity)
      simp [he, hw, v, hb0]
    · have hbk : b (w k) = 0 := b.zero_of_le_dist (by
        simpa [b, Real.dist_eq] using hg k hk he)
      simp [he, v, hbk]
  have hi (k : ι) : Integrable (fun x : ℝ => phase x (w k) * K x) := by
    apply K.integrable.norm.mono'
    · apply Continuous.aestronglyMeasurable
      unfold phase
      fun_prop
    · exact Filter.Eventually.of_forall fun x => by simp [norm_phase]
  have hFourier (k : ι) :
      (∫ x : ℝ, phase x (w k) * K x) = V (w k) := by
    calc
      _ = (𝓕 K) (w k) := by
        rw [SchwartzMap.fourier_coe, Real.fourier_real_eq_integral_exp_smul]
        rfl
      _ = _ := congrArg (fun F : 𝓢(ℝ, ℂ) => F (w k)) (FourierTransform.fourier_fourierInv_eq V)
  have hcoeff : (∫ x : ℝ, P x * K x) = a j := by
    simp only [P, Finset.sum_mul, mul_assoc]
    rw [integral_finsetSum s (fun k _ => (hi k).const_mul (a k))]
    simp only [integral_const_mul, hFourier]
    calc
      _ = ∑ k ∈ s, a k * (if k = j then 1 else 0) :=
        Finset.sum_congr rfl (fun k hk => by rw [hV k hk])
      _ = _ := by simp [mul_ite, hj]
  have hcont : Continuous P := by
    unfold P phase
    fun_prop
  have hP (x : ℝ) : ‖P x‖ ≤ ∑ k ∈ s, ‖a k‖ := by
    simpa only [P, norm_mul, norm_phase, mul_one] using
      norm_sum_le s (fun k => a k * phase x (w k))
  have hIntegrable : Integrable (fun x : ℝ => ‖P x‖ / (1 + x ^ 2)) := by
    apply (integrable_inv_one_add_sq.const_mul (∑ k ∈ s, ‖a k‖)).mono'
    · exact (hcont.norm.div (by fun_prop) (fun x => by positivity)).aestronglyMeasurable
    · exact Filter.Eventually.of_forall fun x => by
        rw [Real.norm_of_nonneg (by positivity), div_eq_mul_inv]
        exact mul_le_mul_of_nonneg_right (hP x) (by positivity)
  calc
    ‖a j‖ = ‖∫ x : ℝ, P x * K x‖ := congrArg norm hcoeff.symm
    _ ≤ ∫ x : ℝ, C * (‖P x‖ / (1 + x ^ 2)) := by
      refine norm_integral_le_of_norm_le (hIntegrable.const_mul C)
        (Filter.Eventually.of_forall fun x => ?_)
      rw [norm_mul]
      calc
        _ ≤ ‖P x‖ * (C / (1 + x ^ 2)) := mul_le_mul_of_nonneg_left (hK x) (norm_nonneg _)
        _ = _ := by ring
    _ = _ := by rw [integral_const_mul]; rfl

/-- The short Dirichlet polynomial on the right of Koukoulopoulos's bound has
a uniform positive weighted L¹ mass, since its n = 1 coefficient is 1. -/
theorem cauchy_weight_dirichlet_polynomial :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ), 1 ≤ M →
      1 ≤ C * ∫ u : ℝ,
        ‖∑ n ∈ Finset.Icc 1 M, χ (n : ZMod q) /
          (n : ℂ) ^ (1 / 2 + ((t + u : ℝ) : ℂ) * Complex.I)‖ / (1 + u ^ 2) := by
  let δ := Real.log 2 / (2 * Real.pi)
  have hδ : 0 < δ :=
    div_pos (Real.log_pos (by norm_num)) (by positivity)
  obtain ⟨C, hC, hCauchy⟩ := cauchy_weight_constant_coefficient δ hδ
  refine ⟨C, hC, fun q χ t M hM => ?_⟩
  let a (n : ℕ) := χ (n : ZMod q) / (n : ℂ) ^ (1 / 2 + (t : ℂ) * Complex.I)
  let w (n : ℕ) := Real.log n / (2 * Real.pi)
  have hgap (n : ℕ) (hn : n ∈ Finset.Icc 1 M) (hne : n ≠ 1) : δ ≤ |w n| := by
    have hn₂ : (2 : ℝ) ≤ n := by
      exact_mod_cast (show 2 ≤ n by have := (Finset.mem_Icc.mp hn).1; omega)
    have hlog := Real.log_le_log (by norm_num) hn₂
    exact (div_le_div_of_nonneg_right hlog (by positivity)).trans (le_abs_self _)
  have hh := hCauchy (Finset.Icc 1 M) 1 a w (by simp [hM]) (by simp [w]) hgap
  have hnorm : ‖a 1‖ = 1 := by simp [a]
  rw [hnorm] at hh
  have hterm (n : ℕ) (hn : n ∈ Finset.Icc 1 M) (u : ℝ) :
      a n * phase u (w n) = χ (n : ZMod q) /
        (n : ℂ) ^ (1 / 2 + ((t + u : ℝ) : ℂ) * Complex.I) := by
    have hn₀ : (n : ℂ) ≠ 0 := by
      exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
    have harg : (1 / 2 + ((t + u : ℝ) : ℂ) * Complex.I : ℂ) =
        (1 / 2 + (t : ℂ) * Complex.I) + (u : ℂ) * Complex.I := by
      push_cast
      ring
    have hphase : phase u (w n) = ((n : ℂ) ^ ((u : ℂ) * Complex.I))⁻¹ := by
      rw [Complex.cpow_def_of_ne_zero hn₀, ← Complex.exp_neg, ← Complex.natCast_log]
      unfold phase w
      congr 1
      push_cast
      field_simp [Real.pi_ne_zero]
    dsimp only [a]
    rw [harg, Complex.cpow_add (1 / 2 + (t : ℂ) * Complex.I)
      ((u : ℂ) * Complex.I) hn₀, hphase, div_mul_eq_div_div]
    exact (div_eq_mul_inv _ _).symm
  have heq (u : ℝ) :
      (∑ n ∈ Finset.Icc 1 M, χ (n : ZMod q) /
        (n : ℂ) ^ (1 / 2 + ((t + u : ℝ) : ℂ) * Complex.I)) =
      ∑ n ∈ Finset.Icc 1 M, a n * Complex.exp (↑(-2 * Real.pi * u * w n) * Complex.I) :=
    Finset.sum_congr rfl fun n hn => (hterm n hn u).symm
  simpa only [heq] using hh

end ShortAPDualPolynomial

end

section

open scoped BigOperators
open MeasureTheory

namespace ShortAPDualTruncation

/-- Integral-test bound for the tail strictly beyond a real cutoff. -/
theorem rpow_tail_le (M A : ℝ) (hM : 1 ≤ M) (hA : 1 < A) :
    (∑' j : ℕ, ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A)) ≤
      ((2 : ℝ) ^ (A - 1) / (A - 1)) * M ^ (1 - A) := by
  let K := ⌊M⌋₊
  have hK : (1 : ℝ) ≤ K := by
    exact_mod_cast (Nat.le_floor hM : 1 ≤ ⌊M⌋₊)
  have hK₀ : (0 : ℝ) < K := zero_lt_one.trans_le hK
  have hhalf : M / 2 ≤ (K : ℝ) := by
    have h := Nat.lt_floor_add_one M
    change M < (K : ℝ) + 1 at h
    linarith
  have hneg : -A < -1 := by linarith
  have h := AntitoneOn.tsum_comp_add_le_integral K
    (f := fun x : ℝ => x ^ (-A))
    (fun _ hx _ _ hxy => Real.rpow_le_rpow_of_nonpos (hK₀.trans_le hx) hxy
      (hneg.le.trans (by norm_num)))
    (integrableOn_Ioi_rpow_of_lt hneg hK₀)
    (fun x hx => Real.rpow_nonneg ((hK₀.trans hx).le) _)
  rw [integral_Ioi_rpow_of_lt hneg hK₀] at h
  have h' : (∑' j : ℕ, ((j + K + 1 : ℕ) : ℝ) ^ (-A)) ≤
      (K : ℝ) ^ (1 - A) / (A - 1) := by
    have he : -A + 1 = 1 - A := by ring
    rw [he] at h
    convert h using 1
    rw [show A - 1 = -(1 - A) by ring, div_neg, neg_div]
  refine h'.trans ?_
  calc
    _ ≤ (M / 2) ^ (1 - A) / (A - 1) :=
      div_le_div_of_nonneg_right
        (Real.rpow_le_rpow_of_nonpos (by positivity) hhalf (by linarith)) (by linarith)
    _ = _ := by
      rw [Real.div_rpow (by positivity) (by norm_num : (0 : ℝ) ≤ 2),
        show 1 - A = -(A - 1) by ring, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), div_inv_eq_mul]
      ring

/-- The numerical tail for the right contour at `A = 1/2 + 2m`. Write
`R = qT/N`, `S = QT/N`; then the Gauss and vertical-height normalization
supply exactly the factor `R^(2m)`. No contour shift is used here. -/
theorem dual_cutoff_tail (R S δ : ℝ) (m : ℕ)
    (hR : 0 ≤ R) (hRS : R ≤ S) (hδ : 0 < δ) (hm : 1 ≤ m) :
    let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
    let M := max 1 (S ^ ((1 : ℝ) + δ))
    R ^ (2 * m) * (∑' j : ℕ, ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A)) ≤
      ((2 : ℝ) ^ (A - 1) / (A - 1)) * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ)) := by
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let M := max 1 (S ^ ((1 : ℝ) + δ))
  let C := (2 : ℝ) ^ (A - 1) / (A - 1)
  change R ^ (2 * m) * (∑' j : ℕ, ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A)) ≤
    C * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ))
  have hA : 1 < A := by
    have hm' : (1 : ℝ) ≤ m := by exact_mod_cast hm
    dsimp only [A]
    linarith
  have hM : 1 ≤ M := le_max_left _ _
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  have hS : 0 ≤ S := hR.trans hRS
  have hδ₁ : 0 < 1 + δ := by linarith
  have hE : R ^ (2 * m) ≤ M ^ ((2 * (m : ℝ)) / (1 + δ)) := by
    calc
      _ ≤ S ^ (2 * m) := pow_le_pow_left₀ hR hRS _
      _ = (S ^ (1 + δ)) ^ ((2 * (m : ℝ)) / (1 + δ)) := by
        rw [← Real.rpow_mul hS]
        have he : (1 + δ) * (2 * (m : ℝ) / (1 + δ)) = ((2 * m : ℕ) : ℝ) := by
          push_cast
          field_simp
        rw [he, Real.rpow_natCast]
      _ ≤ _ := Real.rpow_le_rpow (Real.rpow_nonneg hS _) (le_max_right _ _) (by positivity)
  calc
    _ ≤ R ^ (2 * m) * (C * M ^ (1 - A)) :=
      mul_le_mul_of_nonneg_left (rpow_tail_le M A hM hA) (by positivity)
    _ ≤ M ^ ((2 * (m : ℝ)) / (1 + δ)) * (C * M ^ (1 - A)) :=
      mul_le_mul_of_nonneg_right hE (by positivity)
    _ = _ := by
      rw [mul_left_comm, ← Real.rpow_add (zero_lt_one.trans_le hM)]
      congr 2
      dsimp only [A]
      field_simp
      ring

/-- With the contour chosen sufficiently far right, the standardized tail
is bounded by any fixed negative power of the actual cutoff. -/
theorem dual_cutoff_tail_arbitrary_power (δ B : ℝ) (hδ : 0 < δ) :
    ∃ (m : ℕ) (C : ℝ), 1 ≤ m ∧ 0 ≤ C ∧ ∀ R S : ℝ, 0 ≤ R → R ≤ S →
      let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
      let M := max 1 (S ^ ((1 : ℝ) + δ))
      R ^ (2 * m) * (∑' j : ℕ, ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A)) ≤ C * M ^ (-B) := by
  have hd : 0 < 2 * δ := by positivity
  obtain ⟨m, hm⟩ := exists_nat_gt (max (1 : ℝ) ((B + 1 / 2) * (1 + δ) / (2 * δ)))
  have hm₁ : 1 ≤ m := by
    exact_mod_cast (le_of_lt ((le_max_left _ _).trans_lt hm) : (1 : ℝ) ≤ (m : ℝ))
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let C := (2 : ℝ) ^ (A - 1) / (A - 1)
  have hA : 1 < A := by
    dsimp only [A]
    linarith [(le_max_left _ _).trans_lt hm]
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  have hpow : 1 / 2 - 2 * (m : ℝ) * δ / (1 + δ) ≤ -B := by
    have hd' : 0 < 1 + δ := by linarith
    have h := (div_lt_iff₀ hd).mp ((le_max_right _ _).trans_lt hm)
    have h' : B + 1 / 2 < 2 * (m : ℝ) * δ / (1 + δ) :=
      (lt_div_iff₀ hd').mpr (by nlinarith)
    linarith
  refine ⟨m, C, hm₁, hC, fun R S hR hRS => ?_⟩
  exact (dual_cutoff_tail R S δ m hR hRS hδ hm₁).trans
    (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hpow) hC)

private theorem bracket_power_bound (k : ℕ) (x : ℝ) (hx : 0 ≤ x) :
    (1 + x) ^ k * (1 + x ^ 2) ≤ (2 : ℝ) ^ (k + 1) * (1 + x ^ (k + 2)) := by
  by_cases h : x ≤ 1
  · have hp : (1 + x) ^ k ≤ (2 : ℝ) ^ k := pow_le_pow_left₀ (by positivity) (by linarith) _
    have hs : x ^ 2 ≤ (1 : ℝ) := by simpa using pow_le_pow_left₀ hx h 2
    calc
      _ ≤ (2 : ℝ) ^ k * 2 := mul_le_mul hp (by linarith) (by positivity) (by positivity)
      _ = (2 : ℝ) ^ (k + 1) := by rw [pow_succ]
      _ ≤ _ := le_mul_of_one_le_right (by positivity) (le_add_of_nonneg_right (pow_nonneg hx _))
  · have h' : 1 ≤ x := (lt_of_not_ge h).le
    have hp : (1 + x) ^ k ≤ (2 * x) ^ k := pow_le_pow_left₀ (by positivity) (by linarith) _
    have hs : (1 : ℝ) ≤ x ^ 2 := one_le_pow₀ h'
    calc
      _ ≤ (2 * x) ^ k * (2 * x ^ 2) :=
        mul_le_mul hp (by linarith) (by positivity) (by positivity)
      _ = (2 : ℝ) ^ (k + 1) * x ^ (k + 2) := by
        rw [mul_pow, pow_succ (a := (2 : ℝ)), pow_add]
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_add_of_nonneg_left zero_le_one) (by positivity)

/-- Integrate a polynomially growing Gamma factor against a rapidly decreasing
Mellin factor on the same vertical line. Frequencies are centered at the
original height `t`; the bound is explicit in the height cap `T`. -/
theorem vertical_kernel_integral (k : ℕ) (t T CΓ CM : ℝ) (hT : 1 ≤ T) (ht : |t| ≤ T)
    (hCΓ : 0 ≤ CΓ) (hCM : 0 ≤ CM) (f g : ℝ → ℂ)
    (hf : ∀ v, ‖f v‖ ≤ CΓ * (1 + |v|) ^ k)
    (hg : ∀ u, ‖g u‖ ≤ CM / (1 + |u| ^ (k + 2))) :
    ‖∫ u : ℝ, f (t + u) * g u‖ ≤
      (CΓ * CM * (2 : ℝ) ^ (2 * k + 1) * Real.pi) * T ^ k := by
  let D := CΓ * CM * (2 * T) ^ k * (2 : ℝ) ^ (k + 1)
  have hD : 0 ≤ D := by dsimp only [D]; positivity
  have hu (u : ℝ) : 1 + |t + u| ≤ (2 * T) * (1 + |u|) := by
    calc
      _ ≤ 1 + |t| + |u| := by linarith [abs_add_le t u]
      _ ≤ (1 + |t|) * (1 + |u|) := by nlinarith [mul_nonneg (abs_nonneg t) (abs_nonneg u)]
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
  have hdecay (u : ℝ) : (1 + |u|) ^ k / (1 + |u| ^ (k + 2)) ≤
      (2 : ℝ) ^ (k + 1) / (1 + u ^ 2) := by
    apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    simpa only [sq_abs] using bracket_power_bound k |u| (abs_nonneg u)
  have hpoint (u : ℝ) : ‖f (t + u) * g u‖ ≤ D * (1 + u ^ 2)⁻¹ := by
    rw [norm_mul]
    calc
      _ ≤ (CΓ * (1 + |t + u|) ^ k) * (CM / (1 + |u| ^ (k + 2))) :=
        mul_le_mul (hf _) (hg _) (norm_nonneg _) (by positivity)
      _ ≤ (CΓ * ((2 * T) * (1 + |u|)) ^ k) * (CM / (1 + |u| ^ (k + 2))) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) (hu u) _) hCΓ)
          (by positivity)
      _ = (CΓ * CM * (2 * T) ^ k) * ((1 + |u|) ^ k / (1 + |u| ^ (k + 2))) := by
        rw [mul_pow]
        ring
      _ ≤ _ := by
        refine (mul_le_mul_of_nonneg_left (hdecay u) (by positivity)).trans_eq ?_
        dsimp only [D]
        ring
  calc
    _ ≤ ∫ u : ℝ, D * (1 + u ^ 2)⁻¹ :=
      norm_integral_le_of_norm_le (integrable_inv_one_add_sq.const_mul D) (Filter.Eventually.of_forall hpoint)
    _ = _ := by
      rw [integral_const_mul, integral_univ_inv_one_add_sq]
      dsimp only [D]
      rw [mul_pow, show 2 * k + 1 = k + (k + 1) by omega, pow_add]
      ring

/-- Removing the phases from the conductor and length powers in the
functional equation produces exactly the scale used by the right-line tail. -/
theorem functional_equation_prefactor_norm (m : ℕ) (q N n t v : ℝ)
    (hq : 0 < q) (hN : 0 < N) (hn : 0 < n) :
    let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
    let z : ℂ := (A : ℂ) + (v : ℂ) * Complex.I
    let s₀ : ℂ := 1 / 2 + (t : ℂ) * Complex.I
    ‖(N : ℂ) ^ s₀ * (q : ℂ) ^ (z - 1 / 2) * (N : ℂ) ^ (-z) * (n : ℂ) ^ (-z)‖ =
      (q / N) ^ (2 * m) * n ^ (-A) := by
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let z : ℂ := (A : ℂ) + (v : ℂ) * Complex.I
  let s₀ : ℂ := 1 / 2 + (t : ℂ) * Complex.I
  change ‖(N : ℂ) ^ s₀ * (q : ℂ) ^ (z - 1 / 2) * (N : ℂ) ^ (-z) * (n : ℂ) ^ (-z)‖ =
    (q / N) ^ (2 * m) * n ^ (-A)
  have hs₀ : s₀.re = 1 / 2 := by dsimp only [s₀]; norm_num
  have hz : z.re = A := by dsimp only [z]; norm_num
  have hz' : (z - 1 / 2).re = ((2 * m : ℕ) : ℝ) := by
    rw [Complex.sub_re, hz]
    have hhalf : (1 / 2 : ℂ).re = (1 / 2 : ℝ) := by norm_num
    rw [hhalf]
    dsimp only [A]
    push_cast
    ring
  have he : (1 / 2 : ℝ) + -A = -((2 * m : ℕ) : ℝ) := by
    dsimp only [A]
    push_cast
    ring
  simp only [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hq,
    Complex.norm_cpow_eq_rpow_re_of_pos hN, Complex.norm_cpow_eq_rpow_re_of_pos hn,
    hs₀, hz', Complex.neg_re, hz]
  congr 1
  calc
    _ = q ^ ((2 * m : ℕ) : ℝ) * (N ^ (1 / 2 : ℝ) * N ^ (-A)) := by ring
    _ = _ := by
      rw [← Real.rpow_add hN, he, Real.rpow_neg hN.le, ← div_eq_mul_inv,
        ← Real.div_rpow hq.le hN.le, Real.rpow_natCast]

/-- Sum the right-line contour kernels beyond the actual cutoff. The phase may
depend on the summation index; phases of modulus at most one do not affect
the bound. This estimates right-line integrals, not their equality with
integrals on another vertical line. -/
theorem dual_vertical_tail (m : ℕ) (hm : 1 ≤ m) (q Q N T t δ CΓ CM : ℝ)
    (hq : 0 ≤ q) (hqQ : q ≤ Q) (hN : 0 < N) (hT : 1 ≤ T) (ht : |t| ≤ T)
    (hδ : 0 < δ) (hCΓ : 0 ≤ CΓ) (hCM : 0 ≤ CM)
    (f g : ℝ → ℂ) (phase : ℕ → ℝ → ℂ)
    (hf : ∀ v, ‖f v‖ ≤ CΓ * (1 + |v|) ^ (2 * m))
    (hg : ∀ u, ‖g u‖ ≤ CM / (1 + |u| ^ (2 * m + 2)))
    (hp : ∀ n u, ‖phase n u‖ ≤ 1) :
    let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
    let M := max 1 ((Q * T / N) ^ ((1 : ℝ) + δ))
    let E (n : ℕ) : ℂ :=
      ((q / N) ^ (2 * m) * (n : ℝ) ^ (-A)) •
        ∫ u : ℝ, f (t + u) * (g u * phase n u)
    (Summable fun j : ℕ => ‖E (j + ⌊M⌋₊ + 1)‖) ∧
      ‖∑' j : ℕ, E (j + ⌊M⌋₊ + 1)‖ ≤
        (CΓ * CM * (2 : ℝ) ^ (2 * (2 * m) + 1) * Real.pi) *
          ((2 : ℝ) ^ (A - 1) / (A - 1)) * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ)) := by
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let R := q * T / N
  let S := Q * T / N
  let M := max 1 (S ^ ((1 : ℝ) + δ))
  let K := CΓ * CM * (2 : ℝ) ^ (2 * (2 * m) + 1) * Real.pi
  let E (n : ℕ) : ℂ :=
    ((q / N) ^ (2 * m) * (n : ℝ) ^ (-A)) • ∫ u : ℝ, f (t + u) * (g u * phase n u)
  change (Summable fun j : ℕ => ‖E (j + ⌊M⌋₊ + 1)‖) ∧
    ‖∑' j : ℕ, E (j + ⌊M⌋₊ + 1)‖ ≤
      K * ((2 : ℝ) ^ (A - 1) / (A - 1)) * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ))
  have hR : 0 ≤ R := by dsimp only [R]; positivity
  have hRS : R ≤ S :=
    div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hqQ (zero_le_one.trans hT)) hN.le
  have hK : 0 ≤ K := by dsimp only [K]; positivity
  have hA : 1 < A := by
    have hm' : (1 : ℝ) ≤ m := by exact_mod_cast hm
    dsimp only [A]
    linarith
  have hterm (n : ℕ) : ‖E n‖ ≤ (K * R ^ (2 * m)) * (n : ℝ) ^ (-A) := by
    have hg' (u : ℝ) : ‖g u * phase n u‖ ≤ CM / (1 + |u| ^ (2 * m + 2)) := by
      rw [norm_mul]
      exact (mul_le_of_le_one_right (norm_nonneg _) (hp _ _)).trans (hg _)
    have h := vertical_kernel_integral (2 * m) t T CΓ CM hT ht hCΓ hCM f
      (fun u => g u * phase n u) hf hg'
    dsimp only [E]
    rw [norm_smul, Real.norm_of_nonneg (by positivity)]
    calc
      _ ≤ ((q / N) ^ (2 * m) * (n : ℝ) ^ (-A)) * (K * T ^ (2 * m)) :=
        mul_le_mul_of_nonneg_left h (by positivity)
      _ = _ := by
        have he : (q / N) ^ (2 * m) * T ^ (2 * m) = R ^ (2 * m) := by
          rw [← mul_pow]
          congr 1
          dsimp only [R]
          ring
        rw [← he]
        ring
  have hrpow : Summable (fun j : ℕ => ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A)) := by
    simpa only [Nat.add_assoc] using
      (summable_nat_add_iff (f := fun n : ℕ => (n : ℝ) ^ (-A)) (⌊M⌋₊ + 1)).mpr
        (Real.summable_nat_rpow.mpr (by linarith))
  have hnorm : Summable (fun j : ℕ => ‖E (j + ⌊M⌋₊ + 1)‖) :=
    (hrpow.mul_left (K * R ^ (2 * m))).of_norm_bounded (fun j => by
      simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hterm (j + ⌊M⌋₊ + 1))
  refine ⟨hnorm, (norm_tsum_le_tsum_norm hnorm).trans ?_⟩
  calc
    _ ≤ ∑' j : ℕ, (K * R ^ (2 * m)) * ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A) :=
      hnorm.tsum_le_tsum (fun j => hterm _) (hrpow.mul_left _)
    _ ≤ _ := by
      rw [tsum_mul_left]
      calc
        _ = K * (R ^ (2 * m) * ∑' j : ℕ, ((j + ⌊M⌋₊ + 1 : ℕ) : ℝ) ^ (-A)) :=
          mul_assoc _ _ _
        _ ≤ K * (((2 : ℝ) ^ (A - 1) / (A - 1)) * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ))) :=
          mul_le_mul_of_nonneg_left (dual_cutoff_tail R S δ m hR hRS hδ hm) hK
        _ = _ := (mul_assoc _ _ _).symm

end ShortAPDualTruncation

end

section

open Filter Real
open scoped BigOperators

namespace ShortAPFourthSection

private theorem log_pow_eventually_le (n : ℕ) (a : ℝ) (ha : 0 < a) (C : ℝ) (hC : 0 < C) :
    ∀ᶠ x : ℝ in atTop, C * (Real.log x)^n ≤ x^a := by
  have ho := (isLittleO_log_rpow_rpow_atTop (n : ℝ) ha).bound (inv_pos.mpr hC)
  filter_upwards [eventually_ge_atTop (1 : ℝ), ho] with x hx h
  rw [Real.rpow_natCast, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (Real.log_nonneg hx) _),
    Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (by positivity) _)] at h
  exact (le_inv_mul_iff₀ hC).mp h

/-- The modulus bound in the frozen statement implies the exact conductor
normalization (4.1), with a uniform half of the original `1/16` margin. -/
theorem exists_conductor_exponent : ∀ᶠ x : ℝ in atTop, ∀ (θ D : ℝ),
    1 ≤ D → D^2 * x^((1-θ)/3 + 1/16) ≤ x^θ → ∃ β : ℝ,
      (1-θ)/3 + 1/32 ≤ β ∧ β ≤ θ ∧ D^2 * x^β * (Real.log x)^19 = x^θ := by
  have ho := log_pow_eventually_le 19 (1/32) (by norm_num) 1 (by norm_num)
  filter_upwards [eventually_gt_atTop (1 : ℝ), eventually_ge_atTop (Real.exp 1), ho]
    with x hx hxLog ho
  intro θ D hD hDQ
  let L := Real.log x
  have hx0 : 0 < x := by linarith
  have hL : 1 ≤ L := by
    change 1 ≤ Real.log x
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hxLog
  have hLp : 0 < L := by linarith
  have hl : L^19 ≤ x^((1 : ℝ)/32) := by simpa only [one_mul] using ho
  have hp : 0 < D^2 * L^19 := mul_pos (sq_pos_of_pos (by linarith)) (pow_pos hLp _)
  let Z := x^θ / (D^2 * L^19)
  have hZ : 0 < Z := div_pos (Real.rpow_pos_of_pos hx0 _) hp
  let β := Real.log Z / L
  have hxβ : x^β = Z := by
    rw [Real.rpow_def_of_pos hx0]
    have he : Real.log x * β = Real.log Z := by
      change L * (Real.log Z / L) = Real.log Z
      rw [mul_comm, div_mul_cancel₀ _ hLp.ne']
    rw [he, Real.exp_log hZ]
  have hId : D^2 * x^β * L^19 = x^θ := by
    rw [hxβ]
    calc
      D^2 * Z * L^19 = Z * (D^2 * L^19) := by ring
      _ = x^θ := div_mul_cancel₀ _ hp.ne'
  have hlo : x^((1-θ)/3 + 1/32) ≤ x^β := by
    rw [hxβ]
    refine (le_div_iff₀ hp).mpr ?_
    calc
      x^((1-θ)/3 + 1/32) * (D^2 * L^19) ≤
          x^((1-θ)/3 + 1/32) * (D^2 * x^((1 : ℝ)/32)) := by gcongr
      _ = D^2 * x^((1-θ)/3 + 1/16) := by
        rw [show ((1-θ)/3 + 1/16) = ((1-θ)/3 + 1/32) + 1/32 by ring,
          Real.rpow_add hx0 ((1-θ)/3 + 1/32) (1/32)]
        ring
      _ ≤ x^θ := hDQ
  have hu : x^β ≤ x^θ := calc
    x^β ≤ D^2 * x^β * L^19 :=
      (le_mul_of_one_le_left (Real.rpow_nonneg hx0.le _) (one_le_pow₀ hD)).trans
        (le_mul_of_one_le_right (by positivity) (one_le_pow₀ hL))
    _ = x^θ := hId
  exact ⟨β, le_of_not_gt (fun h => (not_lt_of_ge hlo) (Real.rpow_lt_rpow_of_exponent_lt hx h)),
    le_of_not_gt (fun h => (not_lt_of_ge hu) (Real.rpow_lt_rpow_of_exponent_lt hx h)), hId⟩

/-- In the dyadic lower bound with `‖F‖ + 1`, the lowest bin need not bound
`‖F‖` away from zero. Remove those factors before taking a product. -/
theorem norm_active_product_lower {ι : Type*} (s : Finset ι) (U : ι → ℝ) (F : ι → ℂ)
    (hU : ∀ j ∈ s, 1 ≤ U j) (hF : ∀ j ∈ s, U j ≤ ‖F j‖ + 1) :
    (∏ j ∈ s, U j) ≤ (2 : ℝ)^s.card * ‖∏ j ∈ s.filter (fun j => 2 ≤ U j), F j‖ := by
  rw [norm_prod, Finset.prod_filter, ← Finset.prod_const, ← Finset.prod_mul_distrib]
  refine Finset.prod_le_prod₀ (fun j hj => zero_le_one.trans (hU j hj)) fun j hj => ?_
  split_ifs with h
  · linarith [hF j hj]
  · linarith

/-- The loss in support length when discarding an arbitrary subset of factors
of original scales at least `1/4` is at most `4^s.card`. -/
theorem active_product_length_le {ι : Type*} [DecidableEq ι] {s t : Finset ι}
    {N : ι → ℝ} {j : ι} (hj : j ∈ s) (ht : t ⊆ s.erase j)
    (hN : ∀ i ∈ s, (1 : ℝ)/4 ≤ N i) :
    N j * (∏ i ∈ t, N i) ≤ (4 : ℝ)^s.card * (∏ i ∈ s, N i) := by
  have hprod (s' : Finset ι) : ∏ i ∈ s', (4 * N i) = (4 : ℝ)^s'.card * ∏ i ∈ s', N i := by
    rw [Finset.prod_mul_distrib, Finset.prod_const]
  have hle := Finset.prod_le_prod_of_subset_of_one_le₀ (f := fun i => 4 * N i) ht
    (fun i hi => by linarith [hN i (Finset.erase_subset _ _ (ht hi))])
    (fun i hi _ => by linarith [hN i (Finset.erase_subset _ _ hi)])
  rw [hprod, hprod] at hle
  have hnonneg : 0 ≤ ∏ i ∈ t, N i := Finset.prod_nonneg fun i hi => by
    linarith [hN i (Finset.erase_subset _ _ (ht hi))]
  have hnonneg' : 0 ≤ ∏ i ∈ s.erase j, N i := Finset.prod_nonneg fun i hi => by
    linarith [hN i (Finset.erase_subset _ _ hi)]
  have hleft : ∏ i ∈ t, N i ≤ (4 : ℝ)^s.card * ∏ i ∈ s.erase j, N i := calc
    ∏ i ∈ t, N i ≤ (4 : ℝ)^t.card * ∏ i ∈ t, N i :=
      le_mul_of_one_le_left hnonneg (one_le_pow₀ (by norm_num))
    _ ≤ (4 : ℝ)^(s.erase j).card * ∏ i ∈ s.erase j, N i := hle
    _ ≤ (4 : ℝ)^s.card * ∏ i ∈ s.erase j, N i :=
      mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num)
        (Finset.card_le_card (Finset.erase_subset _ _))) hnonneg'
  have hj0 : 0 ≤ N j := by linarith [hN j hj]
  calc
    N j * (∏ i ∈ t, N i) ≤ N j * ((4 : ℝ)^s.card * ∏ i ∈ s.erase j, N i) :=
      mul_le_mul_of_nonneg_left hleft hj0
    _ = (4 : ℝ)^s.card * (∏ i ∈ s, N i) := by rw [← Finset.mul_prod_erase s N hj]; ring

/-- If there are at most eight factors, all of the indicated short length, then
at least four have length exceeding `x ^ (1/1024)` when the total length is ≍ x. -/
theorem long_factor_count {ι : Type*} {K : ℝ} (hK : 0 < K) :
    ∀ᶠ x : ℝ in atTop, ∀ (s : Finset ι) (N : ι → ℝ), s.card ≤ 8 →
      (∀ j ∈ s, 0 ≤ N j ∧ N j ≤ x^((1 : ℝ)/3 - 1/256)) →
      x ≤ K * ∏ j ∈ s, N j →
      4 ≤ (s.filter (fun j => x^((1 : ℝ)/1024) < N j)).card := by
  classical
  have he := log_pow_eventually_le 0 (1/512) (by norm_num) K hK
  filter_upwards [eventually_gt_atTop (1 : ℝ), he] with x hx hk
  intro s N hcard hN hprod
  let J := s.filter (fun j => x^((1 : ℝ)/1024) < N j)
  change 4 ≤ J.card
  by_contra! hj
  have hj' : (J.card : ℝ) ≤ 3 := by exact_mod_cast (show J.card ≤ 3 by omega)
  have hs' : (s.card : ℝ) ≤ 8 := by exact_mod_cast hcard
  let e (j : ι) : ℝ := if j ∈ J then 1/3 - 1/256 else 1/1024
  have heSum : ∑ j ∈ s, e j ≤ 1 - (1 : ℝ)/256 := by
    have hePoint (j : ι) : e j ≤ (if j ∈ J then 1/3 - 1/256 else (0 : ℝ)) + 1/1024 := by
      dsimp [e]
      split_ifs <;> norm_num
    calc
      ∑ j ∈ s, e j ≤ ∑ j ∈ s, ((if j ∈ J then 1/3 - 1/256 else (0 : ℝ)) + 1/1024) :=
        Finset.sum_le_sum fun j _ => hePoint j
      _ = (J.card : ℝ) * (1/3 - 1/256) + (s.card : ℝ) * (1/1024) := by
        rw [Finset.sum_add_distrib, ← Finset.sum_filter]
        have hf : s.filter (fun a => a ∈ J) = J := by
          ext j
          exact ⟨fun h => (Finset.mem_filter.mp h).2, fun h =>
            Finset.mem_filter.mpr ⟨Finset.filter_subset _ _ h, h⟩⟩
        rw [hf]
        simp
        ring
      _ ≤ 1 - (1 : ℝ)/256 := by linarith
  have hp : ∏ j ∈ s, N j ≤ x^(1 - (1 : ℝ)/256) := calc
    ∏ j ∈ s, N j ≤ ∏ j ∈ s, x^(e j) := by
      refine Finset.prod_le_prod₀ (fun j hj => (hN j hj).1) fun j hj => ?_
      dsimp [e]
      split_ifs with h
      · exact (hN j hj).2
      · exact le_of_not_gt (fun hlt => h (Finset.mem_filter.mpr ⟨hj, hlt⟩))
    _ = x^(∑ j ∈ s, e j) := (Real.rpow_sum_of_pos (by linarith) _ _).symm
    _ ≤ x^(1 - (1 : ℝ)/256) := Real.rpow_le_rpow_of_exponent_le hx.le heSum
  have hk' : K ≤ x^((1 : ℝ)/512) := by simpa using hk
  have hx0 : 0 < x := by linarith
  have hp' := (hprod.trans (mul_le_mul_of_nonneg_left hp hK.le)).trans
    (mul_le_mul_of_nonneg_right hk' (Real.rpow_nonneg hx0.le _))
  rw [← Real.rpow_add hx0] at hp'
  have hlt := Real.rpow_lt_rpow_of_exponent_lt hx
    (show (1 : ℝ)/512 + (1 - 1/256) < 1 by norm_num)
  rw [Real.rpow_one] at hlt
  exact (not_lt_of_ge hp') hlt

/-- Case 1, multiplied by the square of the amplitude and the target log power. -/
theorem case_one {R V x H N v L K : ℝ} {r p B C A : ℕ}
    (hV : 0 ≤ V) (hv : 0 < v) (hL : 1 ≤ L) (hK : 0 ≤ K)
    (hN : 0 ≤ N) (hH : H ≤ N^r) (hbig : N ≤ v * L^(2*B))
    (hcap : V * L^C ≤ x) (hcover : p + 2*B*r + A ≤ C)
    (hpower : R * v^r ≤ K * (N^r + H) * L^p) :
    R * V * L^A ≤ (2*K) * x := by
  have hvr : 0 < v^r := pow_pos hv _
  have hNp := pow_le_pow_left₀ hN hbig r
  rw [mul_pow, ← pow_mul] at hNp
  have hbound : R ≤ (2*K) * L^(p + 2*B*r) := by
    apply (le_of_mul_le_mul_right · hvr)
    refine hpower.trans ?_
    calc
      K * (N^r + H) * L^p ≤ K * (2 * (v^r * L^(2*B*r))) * L^p := by
        gcongr
        linarith
      _ = ((2*K) * L^(p + 2*B*r)) * v^r := by rw [pow_add]; ring
  calc
    R * V * L^A ≤ ((2*K) * L^(p + 2*B*r)) * V * L^A := by gcongr
    _ = (2*K) * (V * L^(p + 2*B*r + A)) := by rw [pow_add]; ring
    _ ≤ (2*K) * (V * L^C) := by gcongr
    _ ≤ (2*K) * x := by gcongr

/-- Case 2, allowing the complementary polynomial's length bound to be absorbed
in the constant of its large-values estimate. -/
theorem case_two {R V x H N v L K X : ℝ} {B p q A : ℕ}
    (hR : 0 ≤ R) (hV : 0 ≤ V) (hx : 0 ≤ x) (hN : 0 < N)
    (hH : 0 ≤ H) (hL : 1 ≤ L) (hK : 0 ≤ K)
    (hheight : H * X ≤ x * L^q) (hshort : v * L^B ≤ N) (hsmall : v * L^B ≤ X)
    (hcover : p + q + A ≤ B)
    (hcomp : R * V ≤ K * (x / N + H) * v * L^p) : R * V * L^A ≤ (2*K) * x := by
  have hLp : 0 < L := by linarith
  have hdiv : x/N * (v * L^B) ≤ x := calc
    x/N * (v * L^B) ≤ x/N * N := mul_le_mul_of_nonneg_left hshort (by positivity)
    _ = x := div_mul_cancel₀ _ hN.ne'
  have hheight' := (mul_le_mul_of_nonneg_left hsmall hH).trans hheight
  have hLT : 1 ≤ L^q := one_le_pow₀ hL
  have hbudget : (x/N + H) * (v * L^B) ≤ 2 * (x * L^q) := by
    rw [add_mul]
    have := mul_le_mul_of_nonneg_left hLT hx
    linarith
  have hmain : R * V * L^B ≤ (2*K) * (x * L^(p+q)) := calc
     R * V * L^B ≤ (K * (x/N + H) * v * L^p) * L^B := by gcongr
     _ = K * L^p * ((x/N + H) * (v * L^B)) := by ring
     _ ≤ K * L^p * (2 * (x * L^q)) := by gcongr
     _ = (2*K) * (x * L^(p+q)) := by rw [pow_add]; ring
  apply (le_of_mul_le_mul_right · (pow_pos hLp (p+q)))
  calc
    R * V * L^A * L^(p+q) = R * V * L^(p+q+A) := by rw [pow_add]; ring
    _ ≤ R * V * L^B := by gcongr
    _ ≤ (2*K) * (x * L^(p+q)) := hmain
    _ = (2*K) * x * L^(p+q) := by ring

/-- Four lower bounds for factor amplitudes suffice for the high-exponent
contradiction. Amplitudes in this lemma are already squared. -/
theorem four_factor_lower {ι : Type*} {s J : Finset ι} {v : ι → ℝ} {X L : ℝ} {b : ℕ}
    (hsub : J ⊆ s) (hcard : 4 ≤ J.card) (hv : ∀ j ∈ s, 1 ≤ v j)
    (hL : 0 < L) (hX : L^b ≤ X) (hlarge : ∀ j ∈ J, X ≤ v j * L^b) :
    X^4 ≤ (∏ j ∈ s, v j) * L^(b * 4) := by
  have hLb : 0 < L^b := pow_pos hL _
  have hbase : 1 ≤ X / L^b := (one_le_div hLb).mpr hX
  have hp : (X / L^b)^4 ≤ ∏ j ∈ s, v j := calc
    (X / L^b)^4 ≤ (X / L^b)^J.card := pow_le_pow_right₀ hbase hcard
    _ = ∏ _ ∈ J, X / L^b := (Finset.prod_const _).symm
    _ ≤ ∏ j ∈ J, v j := Finset.prod_le_prod₀ (fun _ _ => by linarith) fun j hj =>
      (div_le_iff₀ hLb).mpr (hlarge j hj)
    _ ≤ ∏ j ∈ s, v j := Finset.prod_le_prod_of_subset_of_one_le₀ hsub
      (fun j hj => by linarith [hv j (hsub hj)]) (fun j hj _ => hv j hj)
  rw [div_pow, ← pow_mul] at hp
  exact (div_le_iff₀ (pow_pos hL _)).mp hp

/-- Case 4 uses the exact dyadic-conductor identity (4.1). -/
theorem no_fourth_case {x θ β L V D : ℝ} {B : ℕ} (hx : 1 < x) (hL : 1 ≤ L)
    (hD : 0 < D) (hβ : (1-θ)/3 + 1/32 ≤ β)
    (hlog : L^(5*B+19) ≤ x^((1 : ℝ)/16))
    (hid : D^2 * x^β * L^19 = x^θ) (hcap : V * D^2 ≤ L^B * x)
    (hfour : (x^β)^4 ≤ V * L^(B*4)) : False := by
  have hx0 : 0 < x := by linarith
  have hLp : 0 < L := by linarith
  have hX : 0 < x^β := Real.rpow_pos_of_pos hx0 _
  have hp : (x^β)^3 * x^θ ≤ L^(5*B+19) * x := calc
    (x^β)^3 * x^θ = (x^β)^4 * (D^2 * L^19) := by rw [← hid]; ring
    _ ≤ (V * L^(B*4)) * (D^2 * L^19) := by gcongr
    _ = (V * D^2) * (L^(B*4) * L^19) := by ring
    _ ≤ (L^B * x) * (L^(B*4) * L^19) := by gcongr
    _ = L^(5*B+19) * x := by
      rw [show 5*B+19 = B+B*4+19 by omega, pow_add, pow_add]
      ring
  have hp' := hp.trans (mul_le_mul_of_nonneg_right hlog hx0.le)
  rw [← Real.rpow_mul_natCast hx0.le, ← Real.rpow_add hx0, ← Real.rpow_add_one hx0.ne'] at hp'
  exact (not_lt_of_ge hp') (Real.rpow_lt_rpow_of_exponent_lt hx (by push_cast; linarith))

set_option maxRecDepth 8192 in
/-- High-exponent version of (4.11), in cross-multiplied form. The inputs `hpower`
and `hcomp` are respectively the first large-values estimate on one factor's
fixed power and on the complementary product. No Huxley estimate is required. -/
theorem high_branch_card_bound {ι : Type*} (p : ℕ) {K CLen : ℝ}
    (hK : 0 ≤ K) (hCLen : 0 < CLen) :
    ∀ᶠ x : ℝ in atTop, ∀ (s : Finset ι) (N v : ι → ℝ) (R H D θ β : ℝ),
    let L := Real.log x
    let V := ∏ j ∈ s, v j
    5/8 ≤ θ → θ ≤ 1 → (1-θ)/3 + 1/32 ≤ β →
    0 ≤ R → 0 ≤ H → 0 < D → s.card ≤ 8 →
    (∀ j ∈ s, 0 ≤ N j ∧ N j ≤ x^((1 : ℝ)/3 - 1/256)) →
    x ≤ CLen * ∏ j ∈ s, N j →
    (∀ j ∈ s, 1 ≤ v j) →
    D^2 * x^β * L^19 = x^θ → H * x^β ≤ x * L^120 →
    V * D^2 ≤ L^512 * x → V * L^(p + 512*2048 + 77) ≤ x →
    (∀ j ∈ s, x^((1 : ℝ)/1024) < N j → 4 ≤ v j →
      R * (v j)^2048 ≤ K * ((N j)^2048 + H) * L^p) →
    (∀ j ∈ s, x^((1 : ℝ)/1024) < N j →
      R * V ≤ K * (x / N j + H) * v j * L^216) →
    R * V * L^77 ≤ (2*K) * x := by
  classical
  have hlog512 := log_pow_eventually_le 512 (1/1024) (by norm_num) 4 (by norm_num)
  have hlog120 := log_pow_eventually_le 120 1 (by norm_num) 1 (by norm_num)
  have hloglarge := log_pow_eventually_le (5*512+19) (1/16) (by norm_num) 1 (by norm_num)
  filter_upwards [eventually_gt_atTop (1 : ℝ), eventually_ge_atTop (Real.exp 1),
    hlog512, hlog120, hloglarge, long_factor_count (ι := ι) hCLen]
      with x hx hxlog ha hb hc hcount
  intro s N v R H D θ β L V hθ hθ' hβ hR hH hD hcard hN hprod hv hid hheight hcap hcap'
    hpower hcomp
  let J := s.filter (fun j => x^((1 : ℝ)/1024) < N j)
  change R * V * L^77 ≤ (2*K) * x
  have hx0 : 0 < x := by linarith
  have hL : 1 ≤ L := by
    change 1 ≤ Real.log x
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hxlog
  have hLp : 0 < L := by linarith
  have hV : 0 ≤ V := Finset.prod_nonneg fun j hj => zero_le_one.trans (hv j hj)
  have hJ : J ⊆ s := Finset.filter_subset _ _
  have hJcard : 4 ≤ J.card := hcount s N hcard hN hprod
  have hβ0 : (1 : ℝ)/32 ≤ β := by linarith
  have hβ1 : 1 ≤ x^β := Real.one_le_rpow hx.le (by linarith)
  have hH' : H ≤ x^2 := calc
    H ≤ H * x^β := le_mul_of_one_le_right hH hβ1
    _ ≤ x * Real.log x^120 := hheight
    _ ≤ x^2 := by rw [pow_two]; gcongr; simpa using hb
  by_cases hfirst : ∃ j ∈ J, N j < v j * L^512
  · obtain ⟨j, hj, hbig⟩ := hfirst
    have hjN := (Finset.mem_filter.mp hj).2
    have hNj : 0 ≤ N j := (hN j (hJ hj)).1
    have hvj : 0 < v j := zero_lt_one.trans_le (hv j (hJ hj))
    have hv4 : 4 ≤ v j := by
      apply (le_of_mul_le_mul_right · (pow_pos hLp 512))
      exact ha.trans (hjN.le.trans hbig.le)
    have hxx : (x^((1 : ℝ)/1024))^2048 = x^2 := by
      rw [← Real.rpow_mul_natCast hx0.le]
      norm_num [Real.rpow_natCast]
    have hHr : H ≤ (N j)^2048 := calc
      H ≤ x^2 := hH'
      _ = (x^((1 : ℝ)/1024))^2048 := hxx.symm
      _ ≤ (N j)^2048 := pow_le_pow_left₀ (Real.rpow_nonneg hx0.le _) hjN.le 2048
    exact case_one (B := 256) hV hvj hL hK hNj hHr hbig.le hcap' (by omega)
      (hpower j (hJ hj) hjN hv4)
  · have hu : ∀ j ∈ J, v j * L^512 ≤ N j := fun j hj =>
      le_of_not_gt fun hlt => hfirst ⟨j, hj, hlt⟩
    by_cases hsecond : ∃ j ∈ J, v j * L^512 ≤ x^β
    · obtain ⟨j, hj, hsmall⟩ := hsecond
      have hjN := (Finset.mem_filter.mp hj).2
      exact case_two hR hV hx0.le ((Real.rpow_pos_of_pos hx0 _).trans hjN)
        hH hL hK hheight (hu j hj) hsmall (by decide)
        (hcomp j (hJ hj) hjN)
    · exfalso
      have hX : L^512 ≤ x^β := calc
        L^512 ≤ 4 * L^512 := by nlinarith only [pow_nonneg hLp.le 512]
        _ ≤ x^((1 : ℝ)/1024) := ha
        _ ≤ x^β := Real.rpow_le_rpow_of_exponent_le hx.le (by linarith)
      exact no_fourth_case hx hL hD hβ (by simpa using hc) hid hcap
        (four_factor_lower hJ hJcard hv hLp hX fun j hj =>
          le_of_lt (lt_of_not_ge fun hle => hsecond ⟨j, hj, hle⟩))

/-- A factor that does not trigger the functional-equation shortening is short
enough for `long_factor_count`, uniformly in the high-exponent parameters. -/
theorem short_length_cutoff : ∀ᶠ x : ℝ in atTop, ∀ (θ β D T N : ℝ),
    let L := Real.log x
    5/8 ≤ θ → (1-θ)/3 + 1/32 ≤ β → 0 < D → 0 ≤ T →
    D^2 * x^β * L^19 = x^θ → D^2 * T * x^β ≤ x * L^120 →
    N ≤ (D*T)^((33 : ℝ)/64) * L^256 → N ≤ x^((1 : ℝ)/3 - 1/256) := by
  have hlog := log_pow_eventually_le 324 (1/128) (by norm_num) 1 (by norm_num)
  filter_upwards [eventually_gt_atTop (1 : ℝ), eventually_ge_atTop (Real.exp 1), hlog]
    with x hx hxLog ho
  intro θ β D T N
  dsimp only
  intro hθ hβ hD hT hId hHt hN
  let L := Real.log x
  have hx0 : 0 < x := by linarith
  have hL : 1 ≤ L := by
    change 1 ≤ Real.log x
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hxLog
  have hLp : 0 < L := by linarith
  have hSum : (25 : ℝ)/32 ≤ θ + β := by linarith
  have hDT : 0 ≤ D*T := mul_nonneg hD.le hT
  have hSquare : (D*T)^2 ≤ x^((39 : ℝ)/32) * L^259 := by
    apply (le_of_mul_le_mul_right · (Real.rpow_pos_of_pos hx0 (β+θ)))
    calc
      (D*T)^2 * x^(β+θ) = (D^2*T*x^β)^2 * L^19 := by
        rw [Real.rpow_add hx0, ← hId]
        ring
      _ ≤ (x * L^120)^2 * L^19 := by gcongr
      _ = x^2 * L^259 := by ring
      _ ≤ (x^((39 : ℝ)/32) * L^259) * x^(β+θ) := by
        have hxp : (x:ℝ)^2 ≤ x^((39 : ℝ)/32) * x^(β+θ) := by
          rw [← Real.rpow_add hx0, ← Real.rpow_natCast]
          exact Real.rpow_le_rpow_of_exponent_le hx.le (by push_cast; linarith)
        calc
          x^2 * L^259 ≤ (x^((39 : ℝ)/32) * x^(β+θ)) * L^259 := by gcongr
          _ = _ := by ring
  have hPower : (D*T)^((33 : ℝ)/64) ≤ x^((1287 : ℝ)/4096) * L^((8547 : ℝ)/128) := calc
    (D*T)^((33 : ℝ)/64) = ((D*T)^2)^((33 : ℝ)/128) := by
      rw [← Real.rpow_natCast_mul hDT]
      norm_num
    _ ≤ (x^((39 : ℝ)/32) * L^259)^((33 : ℝ)/128) :=
      Real.rpow_le_rpow (sq_nonneg _) hSquare (by norm_num)
    _ = x^((1287 : ℝ)/4096) * L^((8547 : ℝ)/128) := by
      rw [Real.mul_rpow (Real.rpow_nonneg hx0.le _) (pow_nonneg hLp.le _),
        ← Real.rpow_mul hx0.le, ← Real.rpow_natCast_mul hLp.le]
      norm_num
  calc
    N ≤ (D*T)^((33 : ℝ)/64) * L^256 := hN
    _ ≤ (x^((1287 : ℝ)/4096) * L^((8547 : ℝ)/128)) * L^256 := by gcongr
    _ = x^((1287 : ℝ)/4096) * L^((41315 : ℝ)/128) := by
      rw [mul_assoc, ← Real.rpow_natCast L 256, ← Real.rpow_add hLp]
      norm_num
    _ ≤ x^((1287 : ℝ)/4096) * L^324 := by
      apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hx0.le _)
      rw [← Real.rpow_natCast L 324]
      exact Real.rpow_le_rpow_of_exponent_le hL (by norm_num)
    _ ≤ x^((1287 : ℝ)/4096) * x^((1 : ℝ)/128) := by gcongr; simpa using ho
    _ ≤ x^((1 : ℝ)/3 - 1/256) := by
      rw [← Real.rpow_add hx0]
      exact Real.rpow_le_rpow_of_exponent_le hx.le (by norm_num)

/-- The `k₀=4` Möbius factors already satisfy the same short-length cap. -/
theorem mobius_length_cutoff : ∀ᶠ x : ℝ in atTop, ∀ N : ℝ,
    N ≤ 4 * x^((1 : ℝ)/4) → N ≤ x^((1 : ℝ)/3 - 1/256) := by
  have hlog := log_pow_eventually_le 0 (1/16) (by norm_num) 4 (by norm_num)
  filter_upwards [eventually_ge_atTop (1 : ℝ), hlog] with x hx ho
  intro N hN
  have hx0 : 0 < x := by linarith
  have h4 : 4 ≤ x^((1 : ℝ)/16) := by simpa using ho
  calc
    N ≤ 4 * x^((1 : ℝ)/4) := hN
    _ ≤ x^((1 : ℝ)/16) * x^((1 : ℝ)/4) :=
      mul_le_mul_of_nonneg_right h4 (Real.rpow_nonneg hx0.le _)
    _ ≤ x^((1 : ℝ)/3 - 1/256) := by
      rw [← Real.rpow_add hx0]
      exact Real.rpow_le_rpow_of_exponent_le hx (by norm_num)

/-- Product support after replacing one long factor by its dual. Here
`X = D*T` and the shortened factor has length `max 1 ((4*X/N)^(33/31))`. -/
theorem shortening_support {X N L : ℝ} (hX : 1 ≤ X) (hN : 0 < N) (hL : 1 ≤ L)
    (hlong : X^((33 : ℝ)/64) * L^256 ≤ N) :
    max 1 ((4*X/N)^((33 : ℝ)/31)) * L^256 ≤ (4 : ℝ)^((33 : ℝ)/31) * N := by
  have hX0 : 0 ≤ X := by linarith
  have hL0 : 0 ≤ L := by linarith
  have hLp : 0 ≤ L^256 := pow_nonneg hL0 _
  have h4 : (1 : ℝ) ≤ (4 : ℝ)^((33 : ℝ)/31) :=
    Real.one_le_rpow (by norm_num) (by norm_num)
  have hLn : L^256 ≤ N := calc
    L^256 ≤ X^((33 : ℝ)/64) * L^256 :=
      le_mul_of_one_le_left hLp (Real.one_le_rpow hX (by norm_num))
    _ ≤ N := hlong
  obtain h | h := max_cases (1 : ℝ) ((4*X/N)^((33 : ℝ)/31))
  · rw [h.1, one_mul]
    exact hLn.trans (le_mul_of_one_le_left hN.le h4)
  · rw [h.1]
    have hbig : X^((33 : ℝ)/31) * L^256 ≤ N^((64 : ℝ)/31) := calc
      X^((33 : ℝ)/31) * L^256 ≤ X^((33 : ℝ)/31) * (L^256)^((64 : ℝ)/31) := by
        apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hX0 _)
        exact Real.self_le_rpow_of_one_le (one_le_pow₀ hL) (by norm_num)
      _ = (X^((33 : ℝ)/64) * L^256)^((64 : ℝ)/31) := by
        rw [Real.mul_rpow (Real.rpow_nonneg hX0 _) hLp, ← Real.rpow_mul hX0]
        norm_num
      _ ≤ N^((64 : ℝ)/31) :=
        Real.rpow_le_rpow (by positivity) hlong (by norm_num)
    have hbig' : X^((33 : ℝ)/31) / N^((33 : ℝ)/31) * L^256 ≤ N := by
      rw [div_mul_eq_mul_div, div_le_iff₀ (Real.rpow_pos_of_pos hN _), mul_comm N,
        ← Real.rpow_add_one hN.ne']
      convert hbig using 2; norm_num
    rw [Real.div_rpow (by positivity) hN.le, Real.mul_rpow (by norm_num) hX0,
      mul_div_assoc, mul_assoc]
    exact mul_le_mul_of_nonneg_left hbig' (Real.rpow_nonneg (by norm_num) _)

/-- The large-frequency range of (4.9), writing `Y = η*T`. The conductor
identity supplies `H*x^β ≤ x*Y`, not just `H ≤ x*Y`. -/
theorem large_frequency_bound (E : ℕ) (hE : E + 77 ≤ 240) :
    ∀ᶠ x : ℝ in atTop, ∀ (S K H Y β : ℝ),
    let L := Real.log x
    0 ≤ K → 0 ≤ H → (1 : ℝ)/32 ≤ β → L^120 ≤ Y → H * x^β ≤ x*Y →
    S ≤ K * (x+H) * L^E → S * L^77 ≤ (2*K) * x * Y^2 := by
  have ho := log_pow_eventually_le (E+77) (1/32) (by norm_num) 1 (by norm_num)
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.exp 1), ho]
    with x hx hxLog ho
  intro S K H Y β L hK hH hβ hY hHeight hS
  have hL : 1 ≤ L := by
    change 1 ≤ Real.log x
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hxLog
  have hY1 : 1 ≤ Y := (one_le_pow₀ hL).trans hY
  have hx0 : 0 ≤ x := by linarith
  have hL0 : 0 ≤ L := by linarith
  have hX : L^(E+77) ≤ x^β := (by simpa only [one_mul] using ho :
    L^(E+77) ≤ x^((1 : ℝ)/32)).trans (Real.rpow_le_rpow_of_exponent_le hx hβ)
  have hLY : L^(E+77) ≤ Y^2 := calc
    L^(E+77) ≤ L^240 := pow_le_pow_right₀ hL hE
    _ = (L^120)^2 := by rw [← pow_mul]
    _ ≤ Y^2 := pow_le_pow_left₀ (pow_nonneg hL0 _) hY _
  have hHL : H * L^(E+77) ≤ x * Y^2 := calc
    H * L^(E+77) ≤ H * x^β := mul_le_mul_of_nonneg_left hX hH
    _ ≤ x * Y := hHeight
    _ ≤ x * Y^2 := by
      gcongr
      rw [pow_two]
      exact le_mul_of_one_le_right (by linarith) hY1
  calc
    S * L^77 ≤ (K * (x+H) * L^E) * L^77 := mul_le_mul_of_nonneg_right hS (pow_nonneg hL0 _)
    _ = K * (x * L^(E+77) + H * L^(E+77)) := by rw [pow_add]; ring
    _ ≤ K * (x * Y^2 + x * Y^2) := mul_le_mul_of_nonneg_left
      (add_le_add (mul_le_mul_of_nonneg_left hLY hx0) hHL) hK
    _ = (2*K) * x * Y^2 := by ring

end ShortAPFourthSection

