noncomputable section

local instance (priority := 2000) tagDecidableEq (q : ℕ) : DecidableEq (ModulusTag q) :=
  Classical.decEq _

local instance (priority := 2000) conductorClassDecidableEq (q K : ℕ) :
    DecidableEq ((DirichletCharacter ℂ q) ⧸ boundedConductorSubgroup q K) := Classical.decEq _

/-- Sharp clipped mass estimates for arbitrary selected tags. The
condition identifies subclasses for the bounded-conductor Gram estimate. -/
def CensusClippedBound (q : ℕ) [NeZero q] (H R h c : ℝ)
    (condition : Finset (ModulusTag q) → Prop) : Prop :=
  ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
    condition T → (∑ t∈T,clippedGapWeight h (modulusGap q t.1.2))≤c

theorem clippedGapWeight_eq_of_le {h x : ℝ} (hh : h≤x) :
    clippedGapWeight h x=gapWeight x := by
  rw [clippedGapWeight,max_eq_left hh]

theorem CensusClippedBound.of_minimum {q : ℕ} [NeZero q] {H R h c : ℝ}
    {condition : Finset (ModulusTag q) → Prop}
    (hMass : CensusClippedBound q H R h c condition) {T : Finset (ModulusTag q)}
    (hT : T⊆repeatTags (modulusZeros q H R) modulusOrder) (hClass : condition T)
    (hMin : ∀ t∈T,h≤ modulusGap q t.1.2) :
    (∑ t∈T,gapWeight (modulusGap q t.1.2))≤c := by
  have he := sum_congr (f:=fun t : ModulusTag q=>clippedGapWeight h (modulusGap q t.1.2))
    (g:=fun t=>gapWeight (modulusGap q t.1.2)) (rfl : T=T)
    (fun t ht=>clippedGapWeight_eq_of_le (hMin t ht))
  exact he.symm.trans_le (hMass T hT hClass)

theorem class_filter_is_one_class {q K : ℕ} {T : Finset (ModulusTag q)}
    (c : (DirichletCharacter ℂ q) ⧸ boundedConductorSubgroup q K) :
    OneConductorClass K (T.filter (fun t=>conductorClass K t.1.1=c)) :=
  fun _ ht _ hu=>(mem_filter.mp ht).2.trans (mem_filter.mp hu).2.symm

theorem erased_tag_mem_modulusRivals {q K : ℕ} [NeZero q] {H R : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hSimple : modulusOrder p=1)
    {t : ModulusTag q} (ht : t∈(repeatTags (modulusZeros q H R) modulusOrder).erase ⟨p,0⟩)
    {same : Bool} (hClass : same=true → conductorClass K t.1.1=conductorClass K p.1) :
    t.1∈modulusRivals K same H R p := by
  obtain ⟨hne,hTag⟩ := mem_erase.mp ht
  exact mem_modulusRivals_iff.mpr
    ⟨(repeatTags_ne_zero_iff_fst_ne hSimple hTag).mp hne,(mem_sigma.mp hTag).1,hClass⟩

set_option maxHeartbeats 1000000 in
theorem modulus_moderate_class_square {q K : ℕ} [NeZero q] {H R a₀ g s C D D₀ : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R)
    (hA : a₀≤ modulusGap q p.2) (hSimple : modulusOrder p=1)
    (hGlobal : ∀ r∈modulusRivals K false H R p,g< modulusGap q r.2)
    (hClass : ∀ r∈modulusRivals K true H R p,s< modulusGap q r.2)
    (hC : CensusClippedBound q H R g C (fun _=>True))
    (hD : ∀ T : Finset (ModulusTag q),
      T⊆(repeatTags (modulusZeros q H R) modulusOrder).erase ⟨p,0⟩ →
      OneConductorClass K T → (∑ t∈T,gapWeight (modulusGap q t.1.2))≤D)
    (hD₀ : CensusClippedBound q H R s D₀ (OneConductorClass K))
    (hDpos : 0≤D) (hD₀pos : 0≤D₀)
    (hNum : (Real.exp (-4.93*a₀))^2+2*Real.exp (-4.93*a₀)*D₀+D*C≤0.994) :
    modulusClassMassSquare q K H R≤0.994 := by
  rw [modulusClassMassSquare_of_repeatTags]
  let S : Finset (ModulusTag q) := repeatTags (modulusZeros q H R) modulusOrder
  let lead : ModulusTag q := ⟨p,0⟩
  let key (t : ModulusTag q) := conductorClass K t.1.1
  let gap (t : ModulusTag q) := modulusGap q t.1.2
  have hLead : lead∈S := repeatTags_mem_zero hp (modulusOrder_pos_of_mem hp)
  have hE : S.erase lead⊆S := erase_subset _ _
  have hM : ∀ t∈S.erase lead,g≤gap t := fun t ht =>
    (hGlobal t.1 (erased_tag_mem_modulusRivals hSimple ht (by simp))).le
  refine classMassSq_single_le S key (fun t=>gapWeight (gap t)) hLead rfl hA
    (fun _ _=>Real.exp_nonneg _) hDpos hD₀pos ?_ ?_ (hC.of_minimum hE trivial hM) hNum
  · intro c _
    exact hD _ (filter_subset _ _) (class_filter_is_one_class c)
  · let T := (S.erase lead).filter (fun t=>key t=key lead)
    refine hD₀.of_minimum ((filter_subset _ _).trans hE) (class_filter_is_one_class (key lead)) ?_
    intro t ht
    have ht' := mem_filter.mp ht
    exact (hClass t.1 (erased_tag_mem_modulusRivals hSimple ht'.1 (fun _=>ht'.2))).le

theorem modulus_moderate_class_square_uniform {q K : ℕ} [NeZero q] {H R a₀ g C D : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R)
    (hA : a₀≤ modulusGap q p.2) (hSimple : modulusOrder p=1)
    (hGlobal : ∀ r∈modulusRivals K false H R p,g< modulusGap q r.2)
    (hC : CensusClippedBound q H R g C (fun _=>True))
    (hD : ∀ T : Finset (ModulusTag q),
      T⊆(repeatTags (modulusZeros q H R) modulusOrder).erase ⟨p,0⟩ →
      OneConductorClass K T → (∑ t∈T,gapWeight (modulusGap q t.1.2))≤D)
    (hDpos : 0≤D)
    (hNum : (Real.exp (-4.93*a₀))^2+2*Real.exp (-4.93*a₀)*D+D*C≤0.994) :
    modulusClassMassSquare q K H R≤0.994 := by
  rw [modulusClassMassSquare_of_repeatTags]
  let S : Finset (ModulusTag q) := repeatTags (modulusZeros q H R) modulusOrder
  let lead : ModulusTag q := ⟨p,0⟩
  let key (t : ModulusTag q) := conductorClass K t.1.1
  let gap (t : ModulusTag q) := modulusGap q t.1.2
  have hLead : lead∈S := repeatTags_mem_zero hp (modulusOrder_pos_of_mem hp)
  have hE : S.erase lead⊆S := erase_subset _ _
  have hM : ∀ t∈S.erase lead,g≤gap t := fun t ht =>
    (hGlobal t.1 (erased_tag_mem_modulusRivals hSimple ht (by simp))).le
  refine classMassSq_single_le S key (fun t=>gapWeight (gap t)) hLead rfl hA
    (fun _ _=>Real.exp_nonneg _) hDpos hDpos ?_ ?_ (hC.of_minimum hE trivial hM) hNum
  · intro c _
    exact hD _ (filter_subset _ _) (class_filter_is_one_class c)
  · exact hD _ (filter_subset _ _) (class_filter_is_one_class (key lead))

end
