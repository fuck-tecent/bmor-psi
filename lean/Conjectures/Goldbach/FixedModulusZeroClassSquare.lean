namespace GoldbachPintzWeightedFormula

open Complex Finset GoldbachCubicRiesz
noncomputable section

private theorem norm_mesh_mean_le {N : ℕ} (hN : 0<N) (f : ℕ→ℂ) {C : ℝ}
    (hC : ∀ k∈range N, ‖f k‖≤C) :
    ‖(∑ k∈range N,f k)/(N:ℂ)‖≤C := by
  have hN₀ : (0:ℝ)<N := by exact_mod_cast hN
  rw [norm_div,Complex.norm_natCast]
  apply (div_le_iff₀ hN₀).mpr
  calc
    _≤∑ k∈range N,‖f k‖ := norm_sum_le _ _
    _≤∑ k∈range N,C := sum_le_sum hC
    _=_ := by rw [sum_const,card_range,nsmul_eq_mul,mul_comm]

/-- A fixed principal residue coefficient may be factored out of the
complex mesh before taking absolute values. -/
theorem norm_gram_mean_le_of_residue_approx {L κ w u x : ℝ}
    (hL : 0<L) (hκ : 0<κ) (hw : 0<w) (hux : u≤x) {z : ℂ} (hz : z≠0)
    (hZ : 0≤z.re) {N : ℕ} (hN : 0<N) {τ : ℝ}
    (R : ℂ) (hR : ‖R‖≤1/(w*L)) (G : ℕ→ℂ)
    (hApprox : ∀ k∈range N, ‖G k-R*
      gramRieszDifference (Real.exp ((x+(k:ℝ)*(κ/N))*L))
        (Real.exp ((u+(k:ℝ)*(κ/N))*L)) (z/(L:ℂ))‖≤τ) :
    ‖(∑ k∈range N,G k)/(N:ℂ)‖≤
      (1/(w*κ))*Real.exp ((x+κ)*z.re)*
        ‖windowLaplace (x-u) z‖*‖windowLaplace κ z‖+
      (2/w)*Real.exp ((x+κ)*z.re)*κ/N+τ := by
  let F (k : ℕ) :=
    gramRieszDifference (Real.exp ((x+(k:ℝ)*(κ/N))*L))
      (Real.exp ((u+(k:ℝ)*(κ/N))*L)) (z/(L:ℂ))
  let A := (∑ k∈range N,F k)/(N:ℂ)
  let B := (∑ k∈range N,(G k-R*F k))/(N:ℂ)
  have hB : ‖B‖≤τ := norm_mesh_mean_le hN _ hApprox
  have hA := averaged_cubicResidue_norm_le hκ hL hux hz hZ hN
  change ‖A/(L:ℂ)‖≤_ at hA
  have he : (∑ k∈range N,G k)/(N:ℂ)=R*A+B := by
    dsimp only [A,B]
    rw [sum_sub_distrib,←mul_sum]
    ring
  have hR' : ‖R*(L:ℂ)‖≤w⁻¹ := by
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hL]
    exact (mul_le_mul_of_nonneg_right hR hL.le).trans_eq (by field_simp [hL.ne',hw.ne'])
  have hA' : R*A=(R*(L:ℂ))*(A/(L:ℂ)) := by
    field_simp [Complex.ofReal_ne_zero.mpr hL.ne']
  rw [he,hA']
  refine (norm_add_le _ _).trans ?_
  rw [norm_mul]
  refine (add_le_add (mul_le_mul hR' hA (norm_nonneg _) (inv_nonneg.mpr hw.le)) hB).trans_eq ?_
  field_simp [hw.ne',hκ.ne']

/-- On a nonprincipal pair, averaging cannot increase a uniform entry error. -/
theorem norm_nonprincipal_gram_mean_le {N : ℕ} (hN : 0<N) (G : ℕ→ℂ)
    {τ : ℝ} (hG : ∀ k∈range N, ‖G k‖≤τ) : ‖(∑ k∈range N,G k)/(N:ℂ)‖≤τ :=
  norm_mesh_mean_le hN G hG

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzNumerics

open Finset

/-- Symmetry and Cauchy–Schwarz bound the quadratic form of the geometric mean
of two nonnegative kernels by the geometric means of their row sums. -/
theorem geometric_kernel_form_le {ι : Type*} (S : Finset ι) (a : ι → ℝ)
    (F G : ι → ι → ℝ) (hF : ∀ i j, 0 ≤ F i j) (hG : ∀ i j, 0 ≤ G i j)
    (hFs : ∀ i j, F i j = F j i) (hGs : ∀ i j, G i j = G j i) :
    (∑ i ∈ S, ∑ j ∈ S, a i*a j*Real.sqrt (F i j*G i j)) ≤
      ∑ i ∈ S, a i^2*(Real.sqrt (∑ j ∈ S, F i j)*Real.sqrt (∑ j ∈ S, G i j)) := by
  let H i j := Real.sqrt (F i j*G i j)
  have hH (i j : ι) : 0 ≤ H i j := Real.sqrt_nonneg _
  have hHs (i j : ι) : H i j = H j i := by dsimp [H]; rw [hFs i j,hGs i j]
  have hSwap : (∑ i ∈ S, ∑ j ∈ S, a j^2*H i j) = ∑ i ∈ S, ∑ j ∈ S, a i^2*H i j := by
    rw [sum_comm]
    apply sum_congr rfl
    intro i _
    apply sum_congr rfl
    intro j _
    rw [hHs j i]
  have hRow (i : ι) : ∑ j ∈ S, H i j ≤ Real.sqrt (∑ j ∈ S, F i j)*Real.sqrt (∑ j ∈ S, G i j) := by
    simpa only [H, Real.sqrt_mul (hF i _)] using Real.sum_sqrt_mul_sqrt_le S (hF i) (hG i)
  calc
    _ ≤ ∑ i ∈ S, ∑ j ∈ S, ((a i^2*H i j + a j^2*H i j)/2) := by
      refine sum_le_sum fun i _ => sum_le_sum fun j _ => ?_
      calc
        _ ≤ ((a i^2+a j^2)/2)*H i j := mul_le_mul_of_nonneg_right (by nlinarith [sq_nonneg (a i-a j)]) (hH i j)
        _ = _ := by ring
    _ = ∑ i ∈ S, ∑ j ∈ S, a i^2*H i j := by
      simp_rw [← sum_div, sum_add_distrib]
      rw [hSwap]
      ring
    _ = ∑ i ∈ S, a i^2*(∑ j ∈ S, H i j) := by simp only [mul_sum]
    _ ≤ _ := sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (hRow i) (sq_nonneg _)

/-- The weighted moment follows from the averaged Gram inequality and the
two damped row bounds. Multiplicities can be represented by separate tags. -/
theorem weighted_moment_of_averaged_gram {ι : Type*} (S : Finset ι)
    (w a d₁ d₂ : ι → ℝ) (F G : ι → ι → ℝ) {C E R₁ R₂ : ℝ}
    (hC : 0 ≤ C) (hE : E < 1) (hw : ∀ i ∈ S, 0 ≤ w i)
    (hF : ∀ i j, 0 ≤ F i j) (hG : ∀ i j, 0 ≤ G i j)
    (hFs : ∀ i j, F i j = F j i) (hGs : ∀ i j, G i j = G j i)
    (hD₁ : ∀ i ∈ S, 0 ≤ d₁ i) (hD₂ : ∀ i ∈ S, 0 ≤ d₂ i)
    (ha : ∀ i ∈ S, a i^2 = w i*(d₁ i*d₂ i))
    (hRow₁ : ∀ i ∈ S, d₁ i^2*(∑ j ∈ S, F i j) ≤ R₁)
    (hRow₂ : ∀ i ∈ S, d₂ i^2*(∑ j ∈ S, G i j) ≤ R₂)
    (hGram : (∑ i ∈ S, w i)^2 ≤
      C*(∑ i ∈ S, ∑ j ∈ S, a i*a j*Real.sqrt (F i j*G i j)) + E*(∑ i ∈ S, w i)^2) :
    (∑ i ∈ S, w i) ≤ C*Real.sqrt R₁*Real.sqrt R₂/(1-E) := by
  let W := ∑ i ∈ S, w i
  have hW : 0 ≤ W := sum_nonneg hw
  have hR₁ (i : ι) (hi : i ∈ S) : d₁ i*Real.sqrt (∑ j ∈ S, F i j) ≤ Real.sqrt R₁ := by
    rw [← Real.sqrt_sq (hD₁ i hi),← Real.sqrt_mul (sq_nonneg (d₁ i))]
    exact Real.sqrt_le_sqrt (hRow₁ i hi)
  have hR₂ (i : ι) (hi : i ∈ S) : d₂ i*Real.sqrt (∑ j ∈ S, G i j) ≤ Real.sqrt R₂ := by
    rw [← Real.sqrt_sq (hD₂ i hi),← Real.sqrt_mul (sq_nonneg (d₂ i))]
    exact Real.sqrt_le_sqrt (hRow₂ i hi)
  have hsum : (∑ i ∈ S, ∑ j ∈ S, a i*a j*Real.sqrt (F i j*G i j)) ≤
      W*(Real.sqrt R₁*Real.sqrt R₂) := by
    refine (geometric_kernel_form_le S a F G hF hG hFs hGs).trans ?_
    dsimp only [W]
    rw [sum_mul]
    refine sum_le_sum fun i hi => ?_
    rw [ha i hi]
    calc
      _ = w i*((d₁ i*Real.sqrt (∑ j ∈ S, F i j))*(d₂ i*Real.sqrt (∑ j ∈ S, G i j))) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (mul_le_mul (hR₁ i hi) (hR₂ i hi)
        (mul_nonneg (hD₂ i hi) (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)) (hw i hi)
  change W ≤ _
  rcases hW.eq_or_lt with hW₀ | hW₀
  · rw [← hW₀]; positivity
  · apply (le_div_iff₀ (sub_pos.mpr hE)).2
    apply le_of_mul_le_mul_right _ hW₀
    have h := mul_le_mul_of_nonneg_left hsum hC
    change W^2 ≤ _ + E*W^2 at hGram
    nlinarith only [hGram,h]

end GoldbachPintzNumerics


namespace GoldbachHalasz

open Finset Complex
open scoped ComplexConjugate

/-- With one real coefficient family fixed for all values of a cutoff parameter,
the complex Gram sum can be averaged before taking absolute values. -/
theorem fixed_coeff_gram {α ι : Type*} (S : Finset α) (I : Finset ι) (w : α → ℝ)
    (a : α → ℂ) (b : ι → α → ℂ) (c : ι → ℝ) (hw : ∀ x ∈ S, 0 ≤ w x) :
    ‖∑ i ∈ I, (c i:ℂ)*weightedDot S w a (b i)‖^2 ≤
      weightedSquare S w a * (∑ i ∈ I, ∑ j ∈ I, (c i:ℂ)*(c j:ℂ)*weightedDot S w (b i) (b j)).re := by
  let v (x : α) := ∑ i ∈ I, (c i:ℂ)*b i x
  have hRight (u : α → ℂ) : weightedDot S w u v = ∑ i ∈ I, (c i:ℂ)*weightedDot S w u (b i) := by
    simp only [weightedDot,v,map_sum,map_mul,Complex.conj_ofReal,mul_sum]
    rw [sum_comm]
    exact sum_congr rfl (fun i _ => sum_congr rfl (fun _ _ => by ring))
  have hLeft (u : α → ℂ) : weightedDot S w v u = ∑ i ∈ I, (c i:ℂ)*weightedDot S w (b i) u := by
    simp only [weightedDot,v,mul_sum,sum_mul]
    rw [sum_comm]
    exact sum_congr rfl (fun i _ => sum_congr rfl (fun _ _ => by ring))
  have hGram : weightedDot S w v v = ∑ i ∈ I, ∑ j ∈ I,
      (c i:ℂ)*(c j:ℂ)*weightedDot S w (b i) (b j) := by
    rw [hLeft]
    apply sum_congr rfl
    intro i _
    simp only [hRight,mul_sum,mul_assoc]
  have h := weightedDot_cauchy S w a v hw
  rw [hRight a] at h
  rw [← hGram,weightedDot_self,Complex.ofReal_re]
  exact h

end GoldbachHalasz
end

