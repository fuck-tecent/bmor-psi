/-- Keep the quotient on the original fixed modulus, so its conductor
cost is the one relevant to the C/D comparison. -/
noncomputable def cdQuotient {q : ℕ} (χ ψ : DirichletCharacter ℂ q) : DirichletCharacter ℂ q := χ⁻¹*ψ

theorem cdQuotient_apply {q : ℕ} (χ ψ : DirichletCharacter ℂ q) (n : ℕ) :
    cdQuotient χ ψ (n:ZMod q)=conj (χ (n:ZMod q))*ψ (n:ZMod q) := by
  unfold cdQuotient
  rw [MulChar.mul_apply,←MulChar.star_apply']
  rfl

theorem cdQuotient_eq_one_iff {q : ℕ} (χ ψ : DirichletCharacter ℂ q) :
    cdQuotient χ ψ=1 ↔ χ=ψ := by
  unfold cdQuotient
  constructor
  · intro h
    exact inv_mul_eq_one.mp h
  · rintro rfl
    exact inv_mul_cancel _

private theorem mem_positive_support {Y : ℝ} (n : ℕ) (hn : n∈support Y) : n≠0 :=
  Nat.ne_zero_of_lt (Finset.mem_Icc.mp hn).1

/-- Exact correspondence between the actual compact divisor detector and the
linear form used in the fixed-coefficient Gram average. -/
theorem cd_weightedDot_detector_eq {q : ℕ} (χ : DirichletCharacter ℂ q) (ρ : ℂ)
    (U V W Y : ℝ) (θ : ℕ→ℝ) :
    GoldbachHalasz.weightedDot (support Y) (fun n=>differenceWeight Y U n/(n:ℝ))
      (fun n => (realDivisorWeight (support V) (GoldbachPintzTheta.barbanVehov U V) n:ℂ))
      (detectorVector (realDivisorWeight (support W) θ) (fun n=>χ (n:ZMod q)) ρ) =
      ∑ n∈support Y,LSeries.term (coefficient χ U V W θ) ρ n*(differenceWeight Y U n:ℂ) := by
  rw [←detectorSum_eq_weightedDot (support Y) mem_positive_support]
  exact detectorSum_eq_sieveProduct (support Y) (support V) (support W)
    (differenceWeight Y U) (GoldbachPintzTheta.barbanVehov U V) θ
    (fun n=>χ (n:ZMod q)) ρ

/-- The exact Gram entry is the signed Riesz cutoff at the common fixed
modulus, including the principal contribution when the two columns agree. -/
theorem cd_weightedDot_gram_eq {q : ℕ} (χ ψ : DirichletCharacter ℂ q) (ρ ζ : ℂ)
    {U Y : ℝ} (hU : 0<U) (hUY : U≤Y) (W : ℝ) (θ : ℕ→ℝ) :
    GoldbachHalasz.weightedDot (support Y) (fun n=>differenceWeight Y U n/(n:ℝ))
      (detectorVector (realDivisorWeight (support W) θ) (fun n=>χ (n:ZMod q)) ρ)
      (detectorVector (realDivisorWeight (support W) θ) (fun n=>ψ (n:ZMod q)) ζ) =
      cutoffSum (LSeries.term (gramCoefficient (cdQuotient χ ψ) W θ) (conj ρ+ζ-1)) Y-
      cutoffSum (LSeries.term (gramCoefficient (cdQuotient χ ψ) W θ) (conj ρ+ζ-1)) U := by
  rw [←gramSum_eq_weightedDot (support Y) mem_positive_support,
    cutoff_sub_eq_difference _ hU hUY,gramSum_eq_sieveSquare]
  have hcoeff :
      ((fun n : ℕ=>conj (χ (n:ZMod q))*ψ (n:ZMod q))*
        sieveProduct (support W) (support W) (fun d=>(θ d:ℂ)) (fun d=>(θ d:ℂ))) =
      gramCoefficient (cdQuotient χ ψ) W θ := by
    funext n
    simp only [Pi.mul_apply,gramCoefficient]
    rw [cdQuotient_apply]
    rfl
  rw [hcoeff]

end GoldbachPintzHalasz
end

