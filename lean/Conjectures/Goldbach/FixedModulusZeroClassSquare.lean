    intro h
    have hq₃ : χ^3=1 := h ▸ pow_orderOf_eq_one χ
    exact (not_le_of_gt (hSmall p (modulusZeros_subset le_rfl hRU hp)))
      ((GoldbachZeroFree.order_three_conductor_le_square χ hq₃).trans hd)
  have hW (j : ℕ) (hj : j∈Icc (1:ℕ) 4) (hjn : χ^j≠1) :
      PrimeTestWindow (χ^j) ((j:ℝ)*t) σ (L^(2:ℝ)+1) (L^(8:ℝ)) L 2 (47/125) := by
    refine leading_case_window hRU hR G hClean hp hP hjn ?_
    rw [abs_mul,abs_of_nonneg (Nat.cast_nonneg _)]
    have hJ : (j:ℝ)≤4 := by exact_mod_cast (mem_Icc.mp hj).2
    exact mul_le_mul hJ ht (abs_nonneg _) (by norm_num)
  by_cases h₄ : orderOf χ=4
  · have hQP : χ^4=1 := h₄ ▸ pow_orderOf_eq_one χ
    have hNP (j) (hj : j∈Icc (1:ℕ) 4) (hj₄ : j≠4) : χ^j≠1 :=
      order_power_ne_one χ (mem_Icc.mp hj).1 (by have := (mem_Icc.mp hj).2; omega)
    have htL : |t|≤L^(2:ℝ) := by
      have hL₁ := Real.rpow_le_rpow_of_exponent_le G.log_one (by norm_num : (1:ℝ)≤2)
      rw [Real.rpow_one] at hL₁
      exact ht.trans (hRU.trans ((by linarith only [hR,hRU,G.large_log] : U≤L).trans hL₁))
    have hh := hFour q χ σ t le_rfl hσ htL hQP hNP
      (fun j hj he=>⟨(hW j hj (hNP j hj he)).height,(hW j hj (hNP j hj he)).logHeight_le⟩) hd
      (fun j hj he _=>(hW j hj (hNP j hj he)).strip)
      (fun j hj he=>(hW j hj (hNP j hj he)).leading) hz'
    change (1-σ)*L≤0.30 at hA
    linarith only [hh,hA]
  · have hNP (j) (hj : j∈Icc (1:ℕ) 4) : χ^j≠1 :=
      order_power_ne_one χ (mem_Icc.mp hj).1 (by have := (mem_Icc.mp hj).2; omega)
    have hh := hFive q χ σ t le_rfl hσ hNP
      (fun j hj=>⟨(hW j hj (hNP j hj)).height,(hW j hj (hNP j hj)).logHeight_le⟩) hd
      (fun j hj _=>(hW j hj (hNP j hj)).strip)
      (fun j hj=>(hW j hj (hNP j hj)).leading) hz'
    change (1-σ)*L≤0.30 at hA
    linarith only [hh,hA]

end
end GoldbachSignedPairs
