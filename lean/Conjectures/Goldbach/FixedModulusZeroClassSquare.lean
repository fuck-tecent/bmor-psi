namespace GoldbachCubicRiesz

open Complex Filter MeasureTheory Set
open scoped BigOperators Topology

noncomputable def gramRieszDifference (Y U : ℝ) (w : ℂ) : ℂ :=
  ((Y:ℂ)^w-(U:ℂ)^w)*symbol w

noncomputable def principalResidueFactor (q : ℕ) : ℂ :=
  ∏ r ∈ q.primeFactors, (1-(r:ℂ)⁻¹)

private theorem integrable_continuous_tail {f : ℝ → ℂ} (hf : Continuous f) {A C : ℝ}
    (hbound : ∀ t, A ≤ |t| → ‖f t‖ ≤ C/(1+t^2)) : Integrable f := by
  let S : Set ℝ := Icc (-A) A
  have hcomp : IntegrableOn f S := hf.continuousOn.integrableOn_Icc
  have htail : IntegrableOn f Sᶜ := by
    have hmaj : IntegrableOn (fun t : ℝ => C / (1 + t ^ 2)) Sᶜ := by
      simpa only [div_eq_mul_inv] using (integrable_inv_one_add_sq.const_mul C).integrableOn
    apply hmaj.mono' hf.aestronglyMeasurable
    filter_upwards [ae_restrict_mem (measurableSet_Icc.compl : MeasurableSet Sᶜ)] with t ht
    exact hbound t (le_of_not_ge fun hs => ht (abs_le.mp hs))
  have h := hcomp.union htail
  rwa [Set.union_compl_self, integrableOn_univ] at h

set_option maxHeartbeats 1800000 in
/-- The exact principal contribution in the signed difference of two compact
Riesz kernels. The only crossed pole comes from the L-function at one. -/
theorem principal_gram_vertical_residue {q : ℕ} [NeZero q] (ρ : ℂ)
    (hρlo : 1/2<ρ.re) (hρhi : ρ.re≤1) (hρ : ρ≠1)
    (P : ℂ → ℂ) (hP : Differentiable ℂ P) {Y U A E : ℝ}
    (hY : 0<Y) (hU : 0<U) (hA : 0≤A) (hE : 1≤E)
    (hbound : ∀ x ∈ Icc (1/2-ρ.re) 1, ∀ t : ℝ, E≤|t| →
      let w : ℂ := (x:ℂ)+t*I
      ‖((Y:ℂ)^w-(U:ℂ)^w)*((1:DirichletCharacter ℂ q).LFunction (ρ+w)*P (ρ+w))‖ ≤
        A*(1+|t|)) :
    let a : ℝ := 1/2-ρ.re
    let p : ℂ := 1-ρ
    let W : ℂ → ℂ := fun w =>
      gramRieszDifference Y U w*((1:DirichletCharacter ℂ q).LFunction (ρ+w)*P (ρ+w))
    (∫ t : ℝ, W ((1:ℂ)+t*I)) =
      (∫ t : ℝ, W ((a:ℂ)+t*I)) +
        (2*(Real.pi:ℂ))*(gramRieszDifference Y U p*P 1*principalResidueFactor q) := by
  let a : ℝ := 1/2-ρ.re
  let p : ℂ := 1-ρ
  let S (w : ℂ) := (Y:ℂ)^w-(U:ℂ)^w
  let χ : DirichletCharacter ℂ q := 1
  let F (w : ℂ) := S w*(χ.LFunction (ρ+w)*P (ρ+w))
  let H (w : ℂ) := S w*(DirichletCharacter.LFunctionTrivChar₁ q (ρ+w)*P (ρ+w))
  let R := regularizedKernel H
  let f (w : ℂ) := R w/(w-p)
  let g := dslope R p
  let W : ℂ → ℂ := fun w => gramRieszDifference Y U w*(χ.LFunction (ρ+w)*P (ρ+w))
  have hp₀ : p≠0 := sub_ne_zero.mpr hρ.symm
  have hpRe : p.re=1-ρ.re := by simp [p]
  have ha : a<p.re := by rw [hpRe]; dsimp [a]; linarith
  have hb : p.re<1 := by rw [hpRe]; linarith only [hρlo]
  have hab : a≤1 := (ha.trans hb).le
  have ha₀ : -1<a := by dsimp [a]; linarith only [hρhi]
  have ha_ne : a≠0 := by dsimp [a]; intro he; linarith only [hρlo,he]
  have hF0 : F 0=0 := by simp [F,S]
  have hH0 : H 0=0 := by simp [H,S]
  have hSd : Differentiable ℂ S := (differentiable_id.const_cpow
    (Or.inl (Complex.ofReal_ne_zero.mpr hY.ne'))).sub
    (differentiable_id.const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr hU.ne')))
  have hH : Differentiable ℂ H := hSd.mul
    (((DirichletCharacter.differentiable_LFunctionTrivChar₁ q).comp
      (differentiable_id.const_add ρ)).mul (hP.comp (differentiable_id.const_add ρ)))
  have hR : DifferentiableOn ℂ R {w : ℂ | -1<w.re} := differentiableOn_regularizedKernel hH
  have hR_at (w : ℂ) (hw : -1<w.re) : AnalyticAt ℂ R w :=
    hR.analyticAt ((isOpen_lt continuous_const Complex.continuous_re).mem_nhds hw)
  have hR_p : R p=gramRieszDifference Y U p*P 1*principalResidueFactor q := by
    have hsum : ρ+p=1 := by dsimp [p]; ring
    dsimp only [R]
    rw [regularizedKernel_eq hH0 hp₀]
    dsimp only [H]
    rw [hsum]
    simp only [DirichletCharacter.LFunctionTrivChar₁,Function.update_self,principalResidueFactor]
    unfold gramRieszDifference symbol
    dsimp only [S]
    ring
  have hH_eq (w : ℂ) (hw : w≠p) : H w=(w-p)*F w := by
    have hz : ρ+w≠1 := by
      intro he
      apply hw
      dsimp [p]
      linear_combination he
    dsimp only [H,F,χ]
    rw [DirichletCharacter.LFunctionTrivChar₁,Function.update_of_ne hz]
    dsimp [DirichletCharacter.LFunctionTrivChar,p]
    ring
  have hf_eq (w : ℂ) (hw₀ : w≠0) (hwp : w≠p) : f w=regularizedKernel F w := by
    dsimp only [f,R]
    rw [regularizedKernel_eq hH0 hw₀,regularizedKernel_eq hF0 hw₀,hH_eq w hwp]
    rw [show 2*((w-p)*F w)/(w*(w+1)*(w+2)) =
      (w-p)*(2*F w/(w*(w+1)*(w+2))) by ring]
    exact mul_div_cancel_left₀ _ (sub_ne_zero.mpr hwp)
  have hLineRe (x t : ℝ) : (((x:ℂ)+t*I):ℂ).re=x := by simp
  have hLineIm (x t : ℝ) : (((x:ℂ)+t*I):ℂ).im=t := by simp
  let B : ℝ := max E (|p.im|+1)
  have hdecay (x : ℝ) (hx : x∈Icc a 1) (t : ℝ) (ht : B≤|t|) :
      ‖f ((x:ℂ)+t*I)‖≤(8*A)/(1+t^2) := by
    let w := (x:ℂ)+t*I
    have ht₁ : 1≤|t| := hE.trans ((le_max_left _ _).trans ht)
    have hw₀ : w≠0 := by
      intro h
      have h' := congrArg Complex.im h
      rw [show w.im=t from hLineIm x t,Complex.zero_im] at h'
      norm_num [h'] at ht₁
    have hwp : w≠p := by
      intro h
      have h' := congrArg Complex.im h
      rw [show w.im=t from hLineIm x t] at h'
      have hB : |p.im|+1≤|t| := (le_max_right _ _).trans ht
      rw [h'] at hB
      linarith only [hB]
    rw [hf_eq w hw₀ hwp]
    have hh : ‖F w‖≤A*(1+|t|) := hbound x hx t ((le_max_left _ _).trans ht)
    simpa only [w,hLineIm] using regularizedKernel_decay hF0 hA (w:=w)
      (by simpa only [w,hLineIm] using ht₁) (by simpa only [w,hLineIm] using hh)
  have hVertical {x : ℝ} (hx : x∈Icc a 1) (hxP : x≠p.re) :
      Integrable (fun t : ℝ => f ((x:ℂ)+t*I)) := by
    have hRc : Continuous (fun t : ℝ => R ((x:ℂ)+t*I)) := by
      apply continuousOn_univ.mp
      apply hR.continuousOn.comp (by fun_prop)
      intro t _
      show -1<(((x:ℂ)+t*I):ℂ).re
      exact (hLineRe x t).symm ▸ ha₀.trans_le hx.1
    have hc : Continuous (fun t : ℝ => f ((x:ℂ)+t*I)) := by
      dsimp only [f]
      apply hRc.div (by fun_prop)
      intro t h
      exact hxP (by simpa only [hLineRe] using congrArg Complex.re (sub_eq_zero.mp h))
    exact integrable_continuous_tail hc (hdecay x hx)
  have hshift := vertical_integral_eq_of_simplePole (f:=f) (g:=g) (r:=R p)
    ha hb (show 0≤8*A by positivity) (A:=B)
    (fun w hw => ((hR_at w (ha₀.trans_le hw.1)).dslope p).continuousAt.continuousWithinAt)
    (fun w hw _ _ => ((hR_at w (ha₀.trans hw)).dslope p).differentiableAt)
    (fun w _ _ hw => by
      dsimp only [f,g]
      rw [dslope_of_ne R hw,slope_def_field]
      field_simp [sub_ne_zero.mpr hw]
      ring)
    (hVertical (left_mem_Icc.mpr hab) ha.ne)
    (hVertical (right_mem_Icc.mpr hab) hb.ne') hdecay
  have hline (x : ℝ) (hx₀ : x≠0) (hxP : x≠p.re) :
      (∫ t : ℝ, W ((x:ℂ)+t*I)) = ∫ t : ℝ, f ((x:ℂ)+t*I) := by
    apply integral_congr_ae
    filter_upwards [] with t
    let w := (x:ℂ)+t*I
    have hw₀ : w≠0 := fun h => hx₀ (by simpa only [w,hLineRe,Complex.zero_re] using congrArg Complex.re h)
    have hwp : w≠p := fun h => hxP (by simpa only [w,hLineRe] using congrArg Complex.re h)
    change W w=f w
    rw [hf_eq w hw₀ hwp,regularizedKernel_eq hF0 hw₀]
    dsimp only [W,F,S,gramRieszDifference,symbol]
    ring
  change (∫ t : ℝ, W ((1:ℂ)+t*I)) = (∫ t : ℝ, W ((a:ℂ)+t*I))+_
  rw [show (1:ℂ)=((1:ℝ):ℂ) by norm_num,hline 1 one_ne_zero hb.ne',
    hline a ha_ne ha.ne,hshift,hR_p]
  simp only [p,Complex.ofReal_one]

end GoldbachCubicRiesz


namespace GoldbachCubicRiesz

open Complex Filter MeasureTheory Set
open scoped BigOperators Topology

private theorem inverse_scale_cpow {Y : ℝ} (hY : 0<Y) (w : ℂ) :
    ((1/Y:ℝ):ℂ)^(-w)=(Y:ℂ)^w := by
  rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (one_div_pos.mpr hY).ne'),
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hY.ne'),
    ← Complex.ofReal_log (one_div_pos.mpr hY).le, ← Complex.ofReal_log hY.le,
    Real.log_div one_ne_zero hY.ne',Real.log_one,zero_sub,Complex.ofReal_neg]
  congr 1
  ring

/-- The signed difference of compact cutoff sums on the absolutely
convergent line. -/
theorem right_gram_riesz_difference (b : ℕ → ℂ) (ρ : ℂ)
    (hb : LSeriesSummable b (ρ+1)) {Y U : ℝ} (hY : 0<Y) (hU : 0<U) :
    ((1/(2*Real.pi):ℝ):ℂ) *
      (∫ t : ℝ, gramRieszDifference Y U ((1:ℂ)+t*I) *
        LSeries b (ρ+((1:ℂ)+t*I))) =
      cutoffSum (LSeries.term b ρ) Y-cutoffSum (LSeries.term b ρ) U := by
  let c := LSeries.term b ρ
  have hc : Summable (fun n => ‖LSeries.term c (1:ℂ) n‖) := by
    simpa only [c,term_shift] using hb.norm
  have he (w : ℂ) : LSeries c w=LSeries b (ρ+w) := by simp only [LSeries,c,term_shift]
  let z (t : ℝ) : ℂ := 1+t*I
  have hInt {V : ℝ} (hV : 0<V) :
      Integrable (fun t : ℝ => (V:ℂ)^(z t)*(LSeries b (ρ+z t)*symbol (z t))) := by
    have hsym : Integrable (fun t : ℝ => symbol (z t)) := by
      simpa only [VerticalIntegrable,z,Complex.ofReal_one] using (symbol_verticalIntegrable (show (1:ℝ)≤1 by rfl))
    have hp : Continuous (fun t : ℝ => (V:ℂ)^(z t)) :=
      (show Continuous z by fun_prop).const_cpow (.inl (Complex.ofReal_ne_zero.mpr hV.ne'))
    have hK : Integrable (fun t : ℝ => (V:ℂ)^(z t)*symbol (z t)) := by
      apply (hsym.norm.const_mul V).mono' (hp.aestronglyMeasurable.mul hsym.aestronglyMeasurable)
      filter_upwards [] with t
      change ‖(V:ℂ)^(z t)*symbol (z t)‖≤V*‖symbol (z t)‖
      simp only [norm_mul,Complex.norm_cpow_eq_rpow_re_of_pos hV,
        show (z t).re=1 by simp [z],Real.rpow_one,le_refl]
    have hJ := GoldbachTwistedMellin.integrable_series_transform c
      (fun w => (V:ℂ)^w*symbol w) (σ:=1) (by simpa only [z,Complex.ofReal_one] using hK)
      (by simpa only [Complex.ofReal_one] using hc)
    apply hJ.congr
    filter_upwards [] with t
    change LSeries c (z t)*((V:ℂ)^(z t)*symbol (z t))=_
    rw [he]
    ring
  rw [← shifted_cutoff_mellinInv (σ:=1) le_rfl hY b ρ (by simpa only [Complex.ofReal_one] using hb),
    ← shifted_cutoff_mellinInv (σ:=1) le_rfl hU b ρ (by simpa only [Complex.ofReal_one] using hb)]
  simp only [mellinInv,smul_eq_mul,Complex.real_smul,Complex.ofReal_one,inverse_scale_cpow hY,
    inverse_scale_cpow hU]
  rw [← mul_sub]
  apply congrArg (fun v : ℂ => ((1/(2*Real.pi):ℝ):ℂ)*v)
  rw [← integral_sub (hInt hY) (hInt hU)]
  apply integral_congr_ae
  filter_upwards [] with t
  simp only [z,gramRieszDifference]
  ring

/-- The normalized signed Gram cutoff on the left line, plus its one
principal residue. -/
theorem principal_gram_cutoff_eq {q : ℕ} [NeZero q] (ρ : ℂ)
    (hρlo : 1/2<ρ.re) (hρhi : ρ.re≤1) (hρ : ρ≠1)
    (P : ℂ → ℂ) (hP : Differentiable ℂ P) (b : ℕ → ℂ)
    (hb : LSeriesSummable b (ρ+1)) {Y U A E : ℝ}
    (hY : 0<Y) (hU : 0<U) (hA : 0≤A) (hE : 1≤E)
    (hRight : ∀t : ℝ, let w : ℂ := (1:ℂ)+t*I
      LSeries b (ρ+w)=((1:DirichletCharacter ℂ q).LFunction (ρ+w))*P (ρ+w))
    (hbound : ∀ x ∈ Icc (1/2-ρ.re) 1, ∀ t : ℝ, E≤|t| →
      let w : ℂ := (x:ℂ)+t*I
      ‖((Y:ℂ)^w-(U:ℂ)^w)*((1:DirichletCharacter ℂ q).LFunction (ρ+w)*P (ρ+w))‖ ≤
        A*(1+|t|)) :
    let a : ℝ := 1/2-ρ.re
    let p : ℂ := 1-ρ
    cutoffSum (LSeries.term b ρ) Y-cutoffSum (LSeries.term b ρ) U =
      ((1/(2*Real.pi):ℝ):ℂ) *
        (∫ t : ℝ, let w : ℂ := (a:ℂ)+t*I
          gramRieszDifference Y U w*((1:DirichletCharacter ℂ q).LFunction (ρ+w)*P (ρ+w))) +
      gramRieszDifference Y U p*P 1*principalResidueFactor q := by
  let c : ℂ := ((1/(2*Real.pi):ℝ):ℂ)
  have hc : c*(2*(Real.pi:ℂ))=1 := by
    dsimp [c]
    norm_cast
    field_simp [Real.pi_ne_zero]
  have hcut := right_gram_riesz_difference b ρ hb hY hU
  simp_rw [hRight] at hcut
  rw [← hcut]
  have hshift := principal_gram_vertical_residue ρ hρlo hρhi hρ P hP hY hU hA hE hbound
  dsimp only at hshift ⊢
  rw [hshift,mul_add,← mul_assoc,hc,one_mul]

end GoldbachCubicRiesz

