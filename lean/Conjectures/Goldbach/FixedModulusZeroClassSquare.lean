namespace GoldbachSignedPairs

open Finset GoldbachPintzNumerics
open scoped Classical

noncomputable section

theorem classMassSq_le_of_split_bounds {ι κ : Type*} (S : Finset ι)
    (key : ι→κ) (A B : ι→ℝ) {a a₀ b b₀ : ℝ}
    (ha₀ : 0≤a₀) (hb₀ : 0≤b₀)
    (hA : ∀ i∈S, 0≤A i) (hB : ∀ i∈S, 0≤B i)
    (ha : (∑ i∈S,A i)≤a) (hb : (∑ i∈S,B i)≤b)
    (hAc : ∀ c∈S.image key, (∑ i∈S.filter (fun i=>key i=c),A i)≤a₀)
    (hBc : ∀ c∈S.image key, (∑ i∈S.filter (fun i=>key i=c),B i)≤b₀) :
    classMassSq S key (fun i => A i+B i)≤a₀*a+b₀*(2*a+b) := by
  let W := S.image key
  let a' (c : κ) := ∑ i∈S.filter (fun i=>key i=c),A i
  let b' (c : κ) := ∑ i∈S.filter (fun i=>key i=c),B i
  have hm : (S : Set ι).MapsTo key W := fun i hi=>mem_image_of_mem _ hi
  rw [classMassSq]
  simp only [sum_add_distrib]
  change (∑ c∈W,(a' c+b' c)^2)≤_
  apply sum_class_squares_le W a' b' ha₀ hb₀
  · exact fun c hc => ⟨sum_nonneg (fun i hi => hA i (mem_filter.mp hi).1),hAc c hc⟩
  · exact fun c hc => ⟨sum_nonneg (fun i hi => hB i (mem_filter.mp hi).1),hBc c hc⟩
  · rwa [sum_fiberwise_of_maps_to hm A]
  · rwa [sum_fiberwise_of_maps_to hm B]

def repeatTags {ι : Type*} (S : Finset ι) (m : ι→ℕ) : Finset (Σ _ : ι, ℕ) :=
  S.sigma (fun i => range (m i))

theorem repeatTags_sum {ι : Type*} (S : Finset ι) (m : ι→ℕ) (a : ι→ℝ) :
    (∑ j∈repeatTags S m,a j.1)=∑ i∈S,(m i:ℝ)*a i := by
  simp only [repeatTags,sum_sigma,sum_const,card_range,nsmul_eq_mul]

theorem repeatTags_filter {ι : Type*} (S : Finset ι) (m : ι→ℕ) (P : ι→Prop) :
    (repeatTags S m).filter (fun (j : Σ _ : ι, ℕ)=>P j.1) = repeatTags (S.filter P) m := by
  ext j
  simp only [repeatTags,mem_filter,mem_sigma]
  tauto

theorem repeatTags_image {ι κ : Type*} (S : Finset ι) (m : ι→ℕ) (key : ι→κ)
    (hm : ∀ i∈S, 0 < m i) :
    (repeatTags S m).image (fun (j : Σ _ : ι, ℕ)=>key j.1) = S.image key := by
  ext c
  constructor
  · rintro (hc : c∈_)
    obtain ⟨j,hj,rfl⟩ := mem_image.mp hc
    exact mem_image_of_mem _ (mem_sigma.mp hj).1
  · intro hc
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hc
    exact mem_image.mpr ⟨⟨i,0⟩,mem_sigma.mpr ⟨hi,mem_range.mpr (hm i hi)⟩,rfl⟩

theorem repeatTags_classMassEq {ι κ : Type*} (S : Finset ι) (m : ι→ℕ)
    (key : ι→κ) (a : ι→ℝ) (hm : ∀ i∈S, 0 < m i) :
    classMassSq (repeatTags S m) (fun j=>key j.1) (fun j=>a j.1) =
      classMassSq S key (fun i=>(m i:ℝ)*a i) := by
  rw [classMassSq,classMassSq,repeatTags_image S m key hm]
  apply sum_congr rfl
  intro c _
  rw [repeatTags_filter S m (fun i => key i=c),repeatTags_sum]

theorem classMassSq_single_le {ι κ : Type*} (S : Finset ι) (key : ι→κ) (a : ι→ℝ)
    {i : ι} (hi : i∈S) {x x₀ C D D₀ θ : ℝ}
    (hw : a i=Real.exp (-4.93*x)) (hx : x₀≤x)
    (ha : ∀ j∈S, 0≤a j)
    (hD : 0≤D) (hD₀ : 0≤D₀)
    (hBc : ∀ c∈S.image key, (∑ j∈(S.erase i).filter (fun j=>key j=c),a j)≤D)
    (hB₀ : (∑ j∈(S.erase i).filter (fun j=>key j=key i),a j)≤D₀)
    (hB : (∑ j∈S.erase i,a j)≤C)
    (hN : (Real.exp (-4.93*x₀))^2+2*Real.exp (-4.93*x₀)*D₀+D*C≤θ) :
    classMassSq S key a≤θ := by
  let W := S.image key
  let b (c : κ) := ∑ j∈(S.erase i).filter (fun j=>key j=c),a j
  have hEq (c : κ) : (∑ j∈S.filter (fun j=>key j=c),a j) =
      (if c=key i then Real.exp (-4.93*x) else 0)+b c := by
    by_cases hkey : c=key i
    · subst c
      have hMem : i∈S.filter (fun j=>key j=key i) := mem_filter.mpr ⟨hi,rfl⟩
      have he : (S.filter (fun j=>key j=key i)).erase i =
          (S.erase i).filter (fun j=>key j=key i) := by
        ext j
        simp only [mem_filter,mem_erase]
        tauto
      rw [ite_eq_left rfl,←hw,←sum_erase_add _ a hMem,he]
      dsimp only [b]
      ring
    · have he : S.filter (fun j=>key j=c) = (S.erase i).filter (fun j=>key j=c) := by
        ext j
        simp only [mem_filter,mem_erase]
        constructor
        · rintro ⟨hj,hjc⟩
          exact ⟨⟨fun e => hkey (e ▸ hjc).symm,hj⟩,hjc⟩
        · exact fun h => ⟨h.1.2,h.2⟩
      rw [he,ite_eq_right hkey,zero_add]
  rw [classMassSq]
  simp only [hEq]
  change (∑ c∈W,((if c=key i then Real.exp (-4.93*x) else 0)+b c)^2)≤θ
  apply moderate_real_class_squares_le W (key i) b hx _ hD hD₀ (fun _=>hB₀) _ hN
  · intro c hc
    exact ⟨sum_nonneg (fun j hj => ha j (mem_erase.mp (mem_filter.mp hj).1).2),hBc c hc⟩
  · have hm : ((S.erase i) : Set ι).MapsTo key W := fun j hj =>
      mem_image_of_mem _ (mem_erase.mp hj).2
    rwa [sum_fiberwise_of_maps_to hm a]

end
