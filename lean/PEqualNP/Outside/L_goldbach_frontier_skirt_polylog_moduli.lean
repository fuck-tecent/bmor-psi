      1 ≤ T → 0 < c → c ≤ 1 → ∀ S : Finset ℕ, S ⊆ Finset.Icc 1 N →
      ∀ F : Finset PrimitiveComplexCharacter, (∀ χ ∈ F, χ.modulus ≤ Q) →
