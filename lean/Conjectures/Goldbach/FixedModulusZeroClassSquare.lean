namespace GoldbachPintzWeightedFormula

open Real Set MeasureTheory intervalIntegral Finset
open WeightedTorusJets.Mertens

noncomputable section

private def mangoldtHarmonic (n : ℕ) : ℝ := ArithmeticFunction.vonMangoldt n / (n:ℝ)

private theorem harmonicSum_floor_eq (x : ℝ) :
    ∑ n ∈ Finset.Icc 0 ⌊x⌋₊, mangoldtHarmonic n =
      ∑ n ∈ Finset.Ioc 0 ⌊x⌋₊, mangoldtHarmonic n := by
  rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le _),Finset.sum_cons]
  simp [mangoldtHarmonic]

set_option maxHeartbeats 1000000 in
/-- Mertens' harmonic Mangoldt estimate under a rescaled real test,
with error controlled by the total variation on the fixed support. -/
theorem mangoldt_rescaled_abel {L B : ℝ} (hL : 0<L) (hB : 0≤B)
    {F F' : ℝ→ℝ} (hF : ∀ u : ℝ, HasDerivAt F (F' u) u)
    (hF' : Continuous F') (hzero : F B=0) :
    let Y := Real.exp (B*L)
    |(∑ n ∈ Finset.Ioc 0 ⌊Y⌋₊, mangoldtHarmonic n*F (Real.log (n:ℝ)/L))-
      L*(∫ u in 0..B,F u)| ≤
      (Real.log 4+4)*(∫ u in 0..B,|F' u|) := by
  intro Y
  let v (x : ℝ) := Real.log x / L
  let vp (x : ℝ) := x⁻¹/L
  let W (x : ℝ) := F (v x)
  let Wp (x : ℝ) := F' (v x)*vp x
  let A (x : ℝ) := ∑ n ∈ Finset.Icc 0 ⌊x⌋₊, mangoldtHarmonic n
  let C : ℝ := Real.log 4+4
  have hY : 1≤Y := Real.one_le_exp_iff.mpr (mul_nonneg hB hL.le)
  have hv₁ : v 1=0 := by simp [v]
  have hvY : v Y=B := by dsimp only [v,Y]; rw [Real.log_exp,mul_div_cancel_right₀ _ hL.ne']
  have hWY : W Y=0 := by unfold W; rw [hvY,hzero]
  have hLinv {x : ℝ} (hx : 0<x) : HasDerivAt v (vp x) x :=
    (Real.hasDerivAt_log hx.ne').div_const _
  have hWD {x : ℝ} (hx : 0<x) : HasDerivAt W (Wp x) x :=
    (hF (v x)).comp x (hLinv hx)
  have hVp : ContinuousOn vp (Set.Icc 1 Y) := by
    intro x hx
    exact (((continuousAt_id.inv₀ (zero_lt_one.trans_le hx.1).ne').div_const L)).continuousWithinAt
  have hV : ContinuousOn v (Set.Icc 1 Y) := fun x hx =>
    (hLinv (zero_lt_one.trans_le hx.1)).continuousAt.continuousWithinAt
  have hW : ContinuousOn W (Set.Icc 1 Y) := fun x hx =>
    (hWD (zero_lt_one.trans_le hx.1)).continuousAt.continuousWithinAt
  have hWp : ContinuousOn Wp (Set.Icc 1 Y) :=
    (hF'.comp_continuousOn hV).mul hVp
  have hWpInt : IntegrableOn Wp (Set.Icc 1 Y) := hWp.integrableOn_compact isCompact_Icc
  have hWdInt : IntegrableOn (deriv W) (Set.Icc 1 Y) :=
    hWpInt.congr_fun (fun x hx => (hWD (zero_lt_one.trans_le hx.1)).deriv.symm) measurableSet_Icc
  have hAbel := sum_mul_eq_sub_integral_mul₀ (c:=mangoldtHarmonic) (f:=W)
    (by simp [mangoldtHarmonic]) Y
    (fun x hx => (hWD (zero_lt_one.trans_le hx.1)).differentiableAt) hWdInt
  have hSum :
      (∑ n ∈ Finset.Ioc 0 ⌊Y⌋₊, mangoldtHarmonic n*F (Real.log (n:ℝ)/L)) =
        -(∫ x in 1..Y, Wp x*A x) := by
    rw [hWY,zero_mul,zero_sub] at hAbel
    have he : (∑ n ∈ Finset.Ioc 0 ⌊Y⌋₊, mangoldtHarmonic n*F (Real.log (n:ℝ)/L)) =
        ∑ n ∈ Finset.Icc 0 ⌊Y⌋₊, W n*mangoldtHarmonic n := by
      rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le _),Finset.sum_cons]
      simp only [mangoldtHarmonic, Nat.cast_zero, div_zero,mul_zero,zero_add]
      exact Finset.sum_congr rfl (fun n _ => mul_comm _ _)
    rw [he,hAbel,intervalIntegral.integral_of_le hY]
    congr 1
    apply setIntegral_congr_fun measurableSet_Ioc
    intro x hx
    change deriv W x*A x = Wp x*A x
    rw [(hWD (zero_lt_one.trans hx.1)).deriv]
  have hLog : ContinuousOn Real.log (Set.Icc 1 Y) :=
    fun x hx => (Real.continuousAt_log (zero_lt_one.trans_le hx.1).ne').continuousWithinAt
  have hInv : ContinuousOn (fun x : ℝ => x⁻¹) (Set.Icc 1 Y) :=
    fun x hx => (continuousAt_id.inv₀ (zero_lt_one.trans_le hx.1).ne').continuousWithinAt
  have hSplit : (∫ x in 1..Y, Wp x*Real.log x) = -(∫ x in 1..Y, W x*x⁻¹) := by
    have hi := intervalIntegral.integral_mul_deriv_eq_deriv_mul_of_hasDerivAt
      (a:=1) (b:=Y) (u:=Real.log) (u':=fun x => x⁻¹) (v:=W) (v':=Wp)
      (by simpa only [uIcc_of_le hY] using hLog) (by simpa only [uIcc_of_le hY] using hW)
      (fun x hx => Real.hasDerivAt_log (zero_lt_one.trans (lt_of_le_of_lt (min_eq_left hY).symm.le hx.1)).ne')
      (fun x hx => hWD (zero_lt_one.trans (lt_of_le_of_lt (min_eq_left hY).symm.le hx.1)))
      ((by simpa only [uIcc_of_le hY] using hInv : ContinuousOn (fun x : ℝ => x⁻¹) (Set.uIcc (1:ℝ) Y)).intervalIntegrable)
      ((by simpa only [uIcc_of_le hY] using hWp : ContinuousOn Wp (Set.uIcc (1:ℝ) Y)).intervalIntegrable)
    simp only [hWY,mul_zero,Real.log_one,zero_mul,sub_zero,zero_sub] at hi
    calc
      _ = ∫ x in 1..Y, Real.log x*Wp x := intervalIntegral.integral_congr (fun x _ => mul_comm _ _)
      _ = -(∫ x in 1..Y, x⁻¹*W x) := hi
      _ = _ := congrArg Neg.neg (intervalIntegral.integral_congr (fun x _ => mul_comm _ _))
  have hMain : (∫ x in 1..Y, W x*x⁻¹)=L*(∫ u in 0..B,F u) := by
    have hi := intervalIntegral.integral_comp_mul_deriv
      (f:=v) (f':=vp) (g:=F) (a:=1) (b:=Y)
      (by
        rw [uIcc_of_le hY]
        exact fun x hx => hLinv (zero_lt_one.trans_le hx.1))
      (by simpa only [uIcc_of_le hY] using hVp)
      (continuous_iff_continuousAt.mpr (fun u => (hF u).continuousAt))
    rw [hv₁,hvY] at hi
    rw [← hi,← intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro x _
    change W x*x⁻¹=L*(W x*vp x)
    unfold vp
    field_simp [hL.ne']
  have hVariation : (∫ x in 1..Y, |Wp x|) = ∫ u in 0..B, |F' u| := by
    have hi := intervalIntegral.integral_comp_mul_deriv
      (f:=v) (f':=vp) (g:=fun u => |F' u|) (a:=1) (b:=Y)
      (by
        rw [uIcc_of_le hY]
        exact fun x hx => hLinv (zero_lt_one.trans_le hx.1))
      (by simpa only [uIcc_of_le hY] using hVp) hF'.abs
    rw [hv₁,hvY] at hi
    rw [← hi]
    apply intervalIntegral.integral_congr
    intro x hx
    rw [uIcc_of_le hY] at hx
    change |F' (v x)*vp x|=|F' (v x)| * vp x
    rw [abs_mul,abs_of_nonneg (show 0≤vp x by unfold vp; positivity [zero_lt_one.trans_le hx.1])]
  have hAI : IntegrableOn (fun x => Wp x*A x) (Set.Icc 1 Y) :=
    integrableOn_mul_sum_Icc mangoldtHarmonic (by norm_num) hWpInt
  have hLI : IntegrableOn (fun x => Wp x*Real.log x) (Set.Icc 1 Y) :=
    (hWp.mul hLog).integrableOn_compact isCompact_Icc
  have hAD : IntervalIntegrable (fun x => Wp x*A x) volume 1 Y :=
    (intervalIntegrable_iff_integrableOn_Icc_of_le hY).mpr hAI
  have hLD : IntervalIntegrable (fun x => Wp x*Real.log x) volume 1 Y :=
    (intervalIntegrable_iff_integrableOn_Icc_of_le hY).mpr hLI
  have hE (x : ℝ) (hx : 1≤x) : |A x-Real.log x|≤C := by
    change |(∑ n ∈ Finset.Icc 0 ⌊x⌋₊, mangoldtHarmonic n)-Real.log x|≤C
    rw [harmonicSum_floor_eq]
    change |E₁Λ x|≤C
    exact abs_le.mpr ⟨(by
      have hh := Real.log_nonneg (by norm_num : (1:ℝ)≤4)
      exact (by dsimp only [C]; linarith only [hh] : -C≤-2).trans (E₁Λ.ge hx)), E₁Λ.le hx⟩
  have hInt : IntervalIntegrable (fun x => Wp x*A x-Wp x*Real.log x) volume 1 Y := hAD.sub hLD
  have hEst : |∫ x in 1..Y, Wp x*A x-Wp x*Real.log x| ≤ C*(∫ x in 1..Y,|Wp x|) := by
    rw [← intervalIntegral.integral_const_mul]
    have hMajor : IntervalIntegrable (fun x => C * |Wp x|) volume 1 Y :=
      ((by rw [uIcc_of_le hY]; exact hWp.abs.const_mul C :
        ContinuousOn (fun x=>C * |Wp x|) (Set.uIcc (1:ℝ) Y)).intervalIntegrable)
    have hBound := intervalIntegral.norm_integral_le_of_norm_le hY
      (f:=fun x => Wp x*A x-Wp x*Real.log x) (g:=fun x => C * |Wp x|)
      (Filter.Eventually.of_forall fun x hx => by
        rw [Real.norm_eq_abs,←mul_sub,abs_mul,mul_comm C]
        exact mul_le_mul_of_nonneg_left (hE x hx.1.le) (abs_nonneg _))
      hMajor
    simpa only [Real.norm_eq_abs] using hBound
  rw [hVariation] at hEst
  rw [intervalIntegral.integral_sub hAD hLD,hSplit,hMain] at hEst
  rw [hSum,← abs_neg (-(∫ x in 1..Y, Wp x*A x)-L*(∫ u in 0..B,F u))]
  have he : -( -(∫ x in 1..Y, Wp x*A x)-L*(∫ u in 0..B,F u)) =
      (∫ x in 1..Y, Wp x*A x)- -(L*(∫ u in 0..B,F u)) := by ring
  rw [he]
  exact hEst

end
end GoldbachPintzWeightedFormula
