namespace GoldbachPintzNumerics


noncomputable def densityMomentScalar (φ κ y : ℝ) : ℝ :=
  (φ/2)*((1-Real.exp (-2*κ*y))/y)+((1-Real.exp (-κ*y))/y)^2


end GoldbachPintzNumerics
end

section
namespace GoldbachPintzWeightedFormula

open Complex Finset GradedNear GoldbachPintzNumerics
open scoped Interval

noncomputable section

private theorem norm_windowLaplace_real {ω ell : ℝ} (hω : 0 < ω) (hell : 0 < ell) :
    ‖windowLaplace ω (ell:ℂ)‖ = (1-Real.exp (-ω*ell))/ell := by
  rw [windowLaplace, show -((ell:ℂ)*(ω:ℂ)) = ((-ω*ell:ℝ):ℂ) by push_cast; ring,
    ← Complex.ofReal_exp,← Complex.ofReal_one,← Complex.ofReal_sub,← Complex.ofReal_div,
    Complex.norm_real,Real.norm_eq_abs]
  have h : -ω*ell ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hω.le) hell.le
  exact abs_of_nonneg (div_nonneg (sub_nonneg.mpr (Real.exp_le_one_iff.mpr h)) hell.le)

/-- The conversion from the explicit-formula sinh sum in (5.28) to the kernel
row of (5.29), with the analytical estimate stated as a separate input. -/
theorem sinh_row_le_of_explicit_formula {ι : Type*} (S : Finset ι) (m : ι → ℕ) (z : ι → ℂ)
    {φ ω ell ε : ℝ} (hω : 0 < ω) (hell : 0 < ell) (hz : ∀ i ∈ S, 0 ≤ (z i).re)
    (hEF : (∑ i ∈ S, (m i:ℝ)*(laplace (sinhTest ω ell) (z i)).re) ≤
      (φ/2)*sinhTest ω ell 0+(laplace (sinhTest ω ell) 0).re+ε) :
    (∑ i ∈ S, (m i:ℝ)*‖windowLaplace ω (z i+(ell:ℂ))‖^2) ≤
      densityMomentScalar φ ω ell+ε/(ell*Real.exp (ell*ω)/2) := by
  let c := ell*Real.exp (ell*ω)/2
  have hc : 0 < c := by dsimp [c]; positivity
  have h0 : (laplace (sinhTest ω ell) 0).re = c*‖windowLaplace ω (ell:ℂ)‖^2 := by
    simpa only [Complex.ofReal_zero,zero_mul,zero_add,c] using sinhTest_boundary hω hell 0
  have hφ : (φ/2)*sinhTest ω ell 0 = c*((φ/2)*((1-Real.exp (-2*ω*ell))/ell)) := by
    rw [sinhTest,ite_eq_left hω.le,sub_zero,Real.sinh_eq]
    have hex : Real.exp (ell*ω)*Real.exp (-2*ω*ell)=Real.exp (-(ell*ω)) := by
      rw [←Real.exp_add]
      congr 1
      ring
    dsimp only [c]
    field_simp [hell.ne']
    rw [show -(2*ell*ω)=-2*ω*ell by ring]
    linear_combination φ*hex
  apply le_of_mul_le_mul_left _ hc
  calc
    c*(∑ i ∈ S, (m i:ℝ)*‖windowLaplace ω (z i+(ell:ℂ))‖^2) ≤
        ∑ i ∈ S, (m i:ℝ)*(laplace (sinhTest ω ell) (z i)).re := by
      rw [mul_sum]
      refine sum_le_sum fun i hi => ?_
      rw [mul_left_comm]
      exact mul_le_mul_of_nonneg_left (sinh_window_majorization hω hell (hz i hi)) (Nat.cast_nonneg _)
    _ ≤ _ := hEF.trans_eq (by
      rw [hφ,h0,norm_windowLaplace_real hω hell,densityMomentScalar,mul_add,mul_add,
        mul_div_cancel₀ _ hc.ne'])

/-- Averaging the complex Gram residue over the common moving cutoff produces
the two distinct window factors of (5.22). -/
theorem average_residue_window_eq {x u κ : ℝ} {z : ℂ} (hz : z ≠ 0) :
    (∫ η in (0:ℝ)..κ, (Complex.exp ((↑(x+η):ℂ)*z)-Complex.exp ((↑(u+η):ℂ)*z))/z) =
      Complex.exp ((↑(x+κ):ℂ)*z)*windowLaplace (x-u) z*windowLaplace κ z := by
  have hFactor (η : ℝ) :
      (Complex.exp ((↑(x+η):ℂ)*z)-Complex.exp ((↑(u+η):ℂ)*z))/z =
      ((Complex.exp ((x:ℂ)*z)-Complex.exp ((u:ℂ)*z))/z)*Complex.exp (z*(η:ℂ)) := by
    simp only [Complex.ofReal_add,add_mul,Complex.exp_add,mul_comm (η:ℂ) z]
    ring
  simp_rw [hFactor]
  rw [intervalIntegral.integral_const_mul,integral_exp_mul_complex hz]
  simp only [ofReal_zero,mul_zero,Complex.exp_zero,windowLaplace]
  have hA : Complex.exp ((↑(x+κ):ℂ)*z)*Complex.exp (-(z*(↑(x-u):ℂ))) = Complex.exp ((↑(u+κ):ℂ)*z) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hB : Complex.exp ((↑(x+κ):ℂ)*z)*Complex.exp (-(z*(κ:ℂ))) = Complex.exp ((x:ℂ)*z) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hC : Complex.exp ((↑(u+κ):ℂ)*z)*Complex.exp (-(z*(κ:ℂ))) = Complex.exp ((u:ℂ)*z) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  have hD (v : ℝ) : Complex.exp ((↑(v+κ):ℂ)*z) = Complex.exp ((v:ℂ)*z)*Complex.exp (z*(κ:ℂ)) := by
    rw [Complex.ofReal_add,add_mul,Complex.exp_add,mul_comm (κ:ℂ) z]
  have hRec : Complex.exp ((↑(x+κ):ℂ)*z)*(1-Complex.exp (-(z*(↑(x-u):ℂ))))*
        (1-Complex.exp (-(z*(κ:ℂ)))) =
      (Complex.exp ((↑(x+κ):ℂ)*z)-Complex.exp ((↑(u+κ):ℂ)*z))-
        (Complex.exp ((x:ℂ)*z)-Complex.exp ((u:ℂ)*z)) := by
    rw [mul_sub, mul_one, mul_sub, mul_one, hA, sub_mul, hB, hC]
  calc
    _ = ((Complex.exp ((↑(x+κ):ℂ)*z)-Complex.exp ((↑(u+κ):ℂ)*z))-
        (Complex.exp ((x:ℂ)*z)-Complex.exp ((u:ℂ)*z)))/(z*z) := by
      rw [hD x,hD u]
      ring
    _ = _ := by rw [← hRec]; ring

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Finset MeasureTheory Set
open scoped Interval
noncomputable section

/-- The first-point average on a uniform finite mesh approximates the integral
average with an explicit Lipschitz error. -/
theorem norm_mesh_average_sub_integral_le {κ C : ℝ} (hκ : 0<κ) (hC : 0≤C)
    {N : ℕ} (hN : 0<N) (f : ℝ→ℂ) (hf : Continuous f)
    (hLip : ∀ x y, 0≤x → x≤y → y≤κ → ‖f y-f x‖≤C*(y-x)) :
    ‖(∑ k∈range N,f ((k:ℝ)*(κ/N)))/(N:ℂ)-
      (∫ x in (0:ℝ)..κ,f x)/(κ:ℂ)‖≤C*κ/N := by
  let Δ := κ/(N:ℝ)
  let p (k : ℕ) := (k:ℝ)*Δ
  have hn : (0:ℝ)<N := by exact_mod_cast hN
  have hd : 0<Δ := div_pos hκ hn
  have hp0 : p 0=0 := by simp [p]
  have hpN : p N=κ := by dsimp only [p,Δ]; field_simp
  have hP (k : ℕ) : p (k+1)-p k=Δ := by simp only [p,Nat.cast_add,Nat.cast_one]; ring
  have hMono : Monotone p := fun k l hkl =>
    mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hkl) hd.le
  have hParts : (∑ k∈range N,∫ x in p k..p (k+1),f x)=∫ x in (0:ℝ)..κ,f x := by
    rw [intervalIntegral.sum_integral_adjacent_intervals (fun k _=>hf.intervalIntegrable (p k) (p (k+1))),hp0,hpN]
  have hDiff (k : ℕ) (hk : k∈range N) :
      ‖((Δ:ℝ):ℂ)*f (p k)-(∫ x in p k..p (k+1),f x)‖≤C*Δ^2 := by
    let a := p k
    let b := p (k+1)
    have hab : a≤b := hMono (Nat.le_succ k)
    have hB : b≤κ := (hMono (Nat.succ_le_of_lt (mem_range.mp hk))).trans_eq hpN
    have ha : 0≤a := hp0.symm.trans_le (hMono (Nat.zero_le k))
    have he : ((Δ:ℝ):ℂ)*f a-(∫ x in a..b,f x) = ∫ x in a..b,f a-f x := by
      rw [intervalIntegral.integral_sub (continuous_const.intervalIntegrable _ _) (hf.intervalIntegrable _ _),
        intervalIntegral.integral_const,Complex.real_smul,show b-a=Δ from hP k]
    rw [he]
    have hb : |b-a|=Δ := by rw [abs_of_nonneg (sub_nonneg.mpr hab),show b-a=Δ from hP k]
    calc
      _≤(C*Δ)*|b-a| := intervalIntegral.norm_integral_le_of_norm_le_const fun x hx => by
        rw [uIoc_of_le hab] at hx
        rw [norm_sub_rev]
        exact (hLip a x ha hx.1.le (hx.2.trans hB)).trans
          (mul_le_mul_of_nonneg_left ((sub_le_sub_right hx.2 a).trans_eq (hP k)) hC)
      _=_ := by rw [hb]; ring
  have hScaled : (∑ k∈range N,f (p k))/(N:ℂ)-(∫ x in (0:ℝ)..κ,f x)/(κ:ℂ)=
      (∑ k∈range N,(((Δ:ℝ):ℂ)*f (p k)-(∫ x in p k..p (k+1),f x)))/(κ:ℂ) := by
    rw [sum_sub_distrib,←mul_sum,hParts]
    have hD : ((Δ:ℝ):ℂ)=(κ:ℂ)/(N:ℂ) := by simp [Δ,ofReal_div]
    rw [hD]
    field_simp [ofReal_ne_zero.mpr hκ.ne',Nat.cast_ne_zero.mpr hN.ne']
  change ‖(∑ k∈range N,f (p k))/(N:ℂ)-(∫ x in (0:ℝ)..κ,f x)/(κ:ℂ)‖≤_
  rw [hScaled,norm_div,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hκ]
  refine div_le_div_of_nonneg_right ((norm_sum_le _ _).trans (sum_le_sum hDiff)) hκ.le |>.trans_eq ?_
  rw [sum_const,card_range,nsmul_eq_mul]
  dsimp only [Δ]
  field_simp [hn.ne',hκ.ne']

/-- The normalized Gram residue has a uniformly bounded derivative in the
cutoff parameter even at unbounded normalized ordinate separation. -/
theorem moving_residue_lipschitz {x u κ : ℝ} (hux : u≤x) (hκ : 0≤κ)
    {z : ℂ} (hz : z≠0) (hzR : 0≤z.re) :
    ∀ a b : ℝ, 0≤a → a≤b → b≤κ →
      ‖((Complex.exp ((↑(x+b):ℂ)*z)-Complex.exp ((↑(u+b):ℂ)*z))/z)-
        ((Complex.exp ((↑(x+a):ℂ)*z)-Complex.exp ((↑(u+a):ℂ)*z))/z)‖
      ≤(2*Real.exp ((x+κ)*z.re))*(b-a) := by
  intro a b ha hab hb
  let f (t : ℝ) := (Complex.exp ((↑(x+t):ℂ)*z)-Complex.exp ((↑(u+t):ℂ)*z))/z
  let f' (t : ℝ) := Complex.exp ((↑(x+t):ℂ)*z)-Complex.exp ((↑(u+t):ℂ)*z)
  have hExp (c t : ℝ) : HasDerivAt (fun t : ℝ=>Complex.exp ((↑(c+t):ℂ)*z))
      (Complex.exp ((↑(c+t):ℂ)*z)*z) t := by
    have h := (((hasDerivAt_id t).const_add c).ofReal_comp).mul_const z
    simpa only [id_eq,Complex.ofReal_one,one_mul] using h.cexp
  have hD (t : ℝ) : HasDerivAt f (f' t) t := by
    have hh := ((hExp x t).sub (hExp u t)).div_const z
    refine hh.congr_deriv ?_
    dsimp only [f']
    field_simp [hz]
  change ‖f b-f a‖≤_
  apply norm_image_sub_le_of_norm_deriv_le_segment' (fun t _=>(hD t).hasDerivWithinAt) _ b
    (right_mem_Icc.mpr hab)
  intro t ht
  have ht' : t≤κ := ht.2.le.trans hb
  dsimp only [f']
  refine (norm_sub_le _ _).trans ?_
  rw [Complex.norm_exp,Complex.norm_exp]
  simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
  have hEx : Real.exp ((x+t)*z.re)≤Real.exp ((x+κ)*z.re) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (add_le_add le_rfl ht') hzR)
  have hEu : Real.exp ((u+t)*z.re)≤Real.exp ((x+κ)*z.re) :=
    Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (add_le_add hux ht') hzR)
  linarith only [hEx,hEu]

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Finset MeasureTheory GoldbachCubicRiesz
open scoped Interval
noncomputable section

/-- The regular factor in the compact quadratic Riesz symbol has norm at most one. -/
theorem cubicResidueCorrection_norm_le {z : ℂ} (hz : 0 ≤ z.re) :
    ‖(2:ℂ)/((z+1)*(z+2))‖ ≤ 1 := by
  have hz₁ : (1:ℝ) ≤ ‖z+1‖ := by
    have h := Complex.re_le_norm (z+1)
    simp only [add_re,one_re] at h
    linarith only [h,hz]
  have hz₂ : (2:ℝ) ≤ ‖z+2‖ := by
    have h := Complex.re_le_norm (z+2)
    norm_num [add_re] at h
    linarith only [h,hz]
  rw [norm_div,norm_mul,Complex.norm_ofNat]
  have hprod := mul_le_mul hz₁ hz₂ (by norm_num : (0:ℝ)≤2) (norm_nonneg _)
  exact (div_le_one (by positivity : 0<‖z+1‖*‖z+2‖)).mpr (by norm_num at hprod ⊢; exact hprod)

set_option maxHeartbeats 850000 in
/-- The principal compact Riesz residue on a finite moving mesh has the
continuous average with both window factors, up to the Lipschitz error. -/
theorem averaged_cubicResidue_norm_le {κ x u L : ℝ} (hκ : 0<κ) (hL : 0<L) (hux : u≤x)
    {z : ℂ} (hz : z≠0) (hR : 0≤z.re) {N : ℕ} (hN : 0<N) :
    ‖(∑ k∈range N,
        gramRieszDifference (Real.exp ((x+(k:ℝ)*(κ/N))*L))
          (Real.exp ((u+(k:ℝ)*(κ/N))*L)) (z/(L:ℂ)))/(N:ℂ)/(L:ℂ)‖ ≤
      Real.exp ((x+κ)*z.re)*‖windowLaplace (x-u) z‖*‖windowLaplace κ z‖/κ+
        2*Real.exp ((x+κ)*z.re)*κ/N := by
  let w := z/(L:ℂ)
  let f (η : ℝ) := (Complex.exp ((↑(x+η):ℂ)*z)-Complex.exp ((↑(u+η):ℂ)*z))/z
  let C := 2*Real.exp ((x+κ)*z.re)
  let R := (2:ℂ)/((w+1)*(w+2))
  have hL₀ := Complex.ofReal_ne_zero.mpr hL.ne'
  have hw : w≠0 := div_ne_zero hz hL₀
  have hz₁ : w+1≠0 := by
    intro h
    have hr := congrArg Complex.re h
    have hx : 0≤w.re := by dsimp only [w]; rw [Complex.div_ofReal_re]; positivity
    simp only [add_re,one_re,zero_re] at hr
    linarith only [hx,hr]
  have hz₂ : w+2≠0 := by
    intro h
    have hr := congrArg Complex.re h
    have hx : 0≤w.re := by dsimp only [w]; rw [Complex.div_ofReal_re]; positivity
    norm_num [add_re] at hr
    linarith only [hx,hr]
  have hPow (v η : ℝ) : ((Real.exp ((v+η)*L):ℝ):ℂ)^w=Complex.exp ((↑(v+η):ℂ)*z) := by
    rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (Real.exp_ne_zero _)),
      ←Complex.ofReal_log (Real.exp_nonneg _),Real.log_exp]
    congr 1
    dsimp only [w]
    push_cast
    field_simp [hL₀]
  have hExact (η : ℝ) :
      gramRieszDifference (Real.exp ((x+η)*L)) (Real.exp ((u+η)*L)) w /(L:ℂ)=R*f η := by
    have hh : w*(L:ℂ)=z := by dsimp only [w]; exact div_mul_cancel₀ _ hL₀
    have hSym : symbol w/(L:ℂ)=R/z := by
      dsimp only [symbol,R]
      rw [div_div,div_div]
      congr 1
      calc
        w*(w+1)*(w+2)*(L:ℂ)=(w*(L:ℂ))*((w+1)*(w+2)) := by ring
        _=((w+1)*(w+2))*z := by rw [hh]; ring
    rw [gramRieszDifference,hPow,hPow,mul_div_assoc,hSym]
    dsimp only [f]
    ring
  have hAvg :
      (∑ k∈range N,
        gramRieszDifference (Real.exp ((x+(k:ℝ)*(κ/N))*L)) (Real.exp ((u+(k:ℝ)*(κ/N))*L)) w)/(N:ℂ)/(L:ℂ)=
      R*((∑ k∈range N,f ((k:ℝ)*(κ/N)))/(N:ℂ)) := by
    rw [div_right_comm,sum_div]
    simp only [hExact,←mul_sum]
    ring
  rw [hAvg,norm_mul]
  have hR' : ‖R‖≤1 := cubicResidueCorrection_norm_le (z:=w)
    (by dsimp only [w]; rw [Complex.div_ofReal_re]; positivity)
  refine (mul_le_of_le_one_left (norm_nonneg _) hR').trans ?_
  let Fav := (∫ η in (0:ℝ)..κ,f η)/(κ:ℂ)
  have hLip := norm_mesh_average_sub_integral_le (C:=C) hκ (by dsimp only [C]; positivity) hN f
    (by unfold f; fun_prop) (moving_residue_lipschitz hux hκ.le hz hR)
  have hAvgTriangle (P : ℂ) : ‖P‖≤‖P-Fav‖+‖Fav‖ := by
    have h := norm_add_le (P-Fav) Fav
    rw [sub_add_cancel] at h
    exact h
  refine (hAvgTriangle _).trans ?_
  have hFav : ‖Fav‖=Real.exp ((x+κ)*z.re)*‖windowLaplace (x-u) z‖*‖windowLaplace κ z‖/κ := by
    rw [show Fav=(∫ η in (0:ℝ)..κ,f η)/(κ:ℂ) from rfl,
      show (∫ η in (0:ℝ)..κ,f η)=_ from average_residue_window_eq hz,
      norm_div,norm_mul,norm_mul,Complex.norm_exp,Complex.mul_re,Complex.ofReal_re,
      Complex.ofReal_im,zero_mul,sub_zero,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hκ]
  rw [hFav]
  have h := add_le_add hLip (le_refl (Real.exp ((x+κ)*z.re)*‖windowLaplace (x-u) z‖*‖windowLaplace κ z‖/κ))
  exact h.trans_eq (by dsimp only [C]; ring)

end
end GoldbachPintzWeightedFormula
end

