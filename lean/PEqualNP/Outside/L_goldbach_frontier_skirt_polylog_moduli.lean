    nlinarith
  have hl0 : 0 ≤ Real.log (Q * (Real.exp s + 2)) := Real.log_nonneg (by nlinarith)
  calc
    _ ≤ ((S.filter (fun i => h i ≤ Real.exp s)).card : ℝ) := by
      exact_mod_cast Finset.card_le_card hsub
    _ ≤ K * (Real.exp s + 1) * Real.log (Q * (Real.exp s + 2)) :=
