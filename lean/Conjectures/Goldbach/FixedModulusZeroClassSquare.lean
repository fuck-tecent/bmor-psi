private theorem triangle_as_indicator (c : ℝ) (k : ℝ→ℝ) :
    (fun t => k t*max (c-t) 0)=(Iic c).indicator (fun t=> k t*(c-t)) := by
  funext t
  by_cases ht : t≤c
  · simp [Set.indicator_of_mem (Set.mem_Iic.mpr ht),max_eq_left (sub_nonneg.mpr ht)]
  · simp [Set.indicator_of_notMem (fun h=>ht (Set.mem_Iic.mp h)),max_eq_right (sub_nonpos.mpr (le_of_not_ge ht))]

private theorem triangle_integrable {k : ℝ→ℝ} (hk : Continuous k) (c : ℝ) :
    IntegrableOn (fun t=>k t*max (c-t) 0) (Ioi 0) := by
  rw [triangle_as_indicator c k]
  unfold IntegrableOn
  rw [integrable_indicator_iff measurableSet_Iic,IntegrableOn,Measure.restrict_restrict measurableSet_Iic,inter_comm,
    show Ioi (0:ℝ)∩Iic c=Ioc 0 c by rfl]
  exact ((hk.mul (continuous_const.sub continuous_id)).intervalIntegrable 0 c).1

private theorem triangle_integral {c : ℝ} (hc : 0≤c) :
    (∫ t : ℝ in Ioi 0,max (c-t) 0)=c^2/2 := by
  have he := triangle_as_indicator c (fun _=>1)
  simp only [one_mul] at he
  rw [he,integral_indicator measurableSet_Iic,Measure.restrict_restrict measurableSet_Iic,
    inter_comm,show Ioi (0:ℝ)∩Iic c=Ioc 0 c by rfl,←intervalIntegral.integral_of_le hc]
  have hf : IntervalIntegrable (fun _ : ℝ=>c) volume 0 c := continuous_const.intervalIntegrable _ _
  have hg : IntervalIntegrable (fun x : ℝ=>x) volume 0 c := continuous_id.intervalIntegrable _ _
  rw [intervalIntegral.integral_sub hf hg,intervalIntegral.integral_const,integral_id]
  simp only [sub_zero,zero_pow (by decide : 2≠0),smul_eq_mul]
  ring

private theorem triangle_first_moment {c : ℝ} (hc : 0≤c) :
    (∫ t : ℝ in Ioi 0,t*max (c-t) 0)=c^3/6 := by
  have he : (fun t : ℝ=>t*max (c-t) 0)=(Iic c).indicator (fun t=>t*(c-t)) :=
    triangle_as_indicator c id
  rw [he,integral_indicator measurableSet_Iic,
    Measure.restrict_restrict measurableSet_Iic,inter_comm,
    show Ioi (0:ℝ)∩Iic c=Ioc 0 c by rfl,←intervalIntegral.integral_of_le hc]
  simp only [id_eq,mul_sub]
  have hf : IntervalIntegrable (fun x : ℝ=>x*c) volume 0 c :=
    ((continuous_id : Continuous (fun x : ℝ=>x)).mul continuous_const).intervalIntegrable _ _
  have hg : IntervalIntegrable (fun x : ℝ=>x*x) volume 0 c :=
    ((continuous_id : Continuous (fun x : ℝ=>x)).mul continuous_id).intervalIntegrable _ _
  rw [intervalIntegral.integral_sub hf hg,intervalIntegral.integral_mul_const,integral_id]
  simp_rw [←pow_two]
  rw [integral_pow]
  ring

private theorem exp_first_moment {B : ℝ} (hB : 0<B) :
    (∫ t : ℝ in Ioi 0,t*Real.exp (-B*t))=(1/B)^2 := by
  have h := Real.integral_rpow_mul_exp_neg_mul_Ioi (a:=2) (by norm_num) hB
  have hΓ : Real.Gamma 2=1 := by norm_num [show (2:ℝ)=1+1 by norm_num,Real.Gamma_add_one,Real.Gamma_one]
  rw [hΓ,mul_one,Real.rpow_ofNat] at h
  norm_num only [show (2:ℝ)-1=1 by norm_num,Real.rpow_one,neg_mul] at h
  simpa only [neg_mul] using h

private theorem auto_scalar_integrable {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S,0<b i) :
    IntegrableOn (exponentialAutoWeight S a b) (Ioi 0) := by
  unfold exponentialAutoWeight exponentialPulse
  exact integrable_finsetSum _ (fun i hi=>
    (integrableOn_exp_mul_Ioi (neg_lt_zero.mpr (hb i hi)) 0).const_mul _)

private theorem auto_integral_eq_re {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S,0<b i) :
    (exponentialAutoTransform S a b 0).re=∫ t : ℝ in Ioi 0,exponentialAutoWeight S a b t := by
  rw [exponentialAutoTransform_eq_integral S a b 0 (by simpa using hb)]
  simp only [neg_zero,zero_mul,Complex.exp_zero,mul_one]
  rw [integral_complex_ofReal,Complex.ofReal_re]

set_option maxHeartbeats 1550000 in
/-- A nonnegative exponential pulse whose autocorrelation has the
quantitative parabolic-test margins needed at every height up to H. -/
theorem exists_exponential_repulsion_kernel {H : ℝ} (hH : 0≤ H) :
    ∃ (S : Finset ℕ) (a b : ℕ→ℝ), (∀ i∈S,H+1≤ b i) ∧
      (∀ t≥0,0≤ exponentialPulse S a b t) ∧
      0<exponentialAutoWeight S a b 0 ∧
