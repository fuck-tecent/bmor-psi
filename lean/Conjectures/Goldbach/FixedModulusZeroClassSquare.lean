open Complex

/-- When both resolvent denominators are at least b in norm, the
rational-kernel defect has a uniform quadratic bound. -/
theorem rational_kernel_defect_le_five_inverse_sq {b a : ℝ} (hb : 0<b) (ha : 0≤ a)
    {z : ℂ} (hV : b≤ ‖(b:ℂ)+z‖) (hW : b≤ ‖(b:ℂ)+z+(a:ℂ)‖) :
    (rationalZeroKernel b z-rationalZeroKernel b (z+(a:ℂ))).re≤ 5*a/b^2 := by
  let v : ℂ := (b:ℂ)+z
  let w : ℂ := v+(a:ℂ)
  let p := v⁻¹
  let q := w⁻¹
  let x : ℝ := b⁻¹
  have hv0 : v≠0 := norm_pos_iff.mp (hb.trans_le hV)
  have hw0 : w≠0 := norm_pos_iff.mp (hb.trans_le hW)
  have hp : ‖p‖≤ x := by rw [norm_inv]; exact inv_anti₀ hb hV
  have hq : ‖q‖≤ x := by rw [norm_inv]; exact inv_anti₀ hb hW
  have hx : 0≤ x := (inv_pos.mpr hb).le
  have hd₁ : ‖p-q‖≤ a*(x*x) := calc
    _ = ‖(a:ℂ)*(p*q)‖ := by
      congr 1
      change v⁻¹-w⁻¹=(a:ℂ)*(v⁻¹*w⁻¹)
      field_simp [hv0,hw0]
      change v+(a:ℂ)-v=(a:ℂ)
      ring
    _ ≤ a*(x*x) := by
      rw [norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg ha]
      exact mul_le_mul_of_nonneg_left (mul_le_mul hp hq (norm_nonneg _) hx) ha
  have hx1 : 0≤ a*(x*x) := by positivity
  have hd₂ : ‖p^2-q^2‖≤ (a*(x*x))*(x+x) := calc
    _ = ‖(p-q)*(p+q)‖ := by congr 1; ring
    _ ≤ _ := by
      rw [norm_mul]
      exact mul_le_mul hd₁ ((norm_add_le _ _).trans (add_le_add hp hq))
        (norm_nonneg _) hx1
  have hd₃ : ‖p^3-q^3‖≤ (a*(x*x))*(x^2+x*x+x^2) := calc
    _ = ‖(p-q)*(p^2+p*q+q^2)‖ := by congr 1; ring
    _ ≤ _ := by
      rw [norm_mul]
      refine mul_le_mul hd₁ ?_ (norm_nonneg _) hx1
      refine (norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add ?_ ?_)) ?_)
      · rw [norm_pow]; exact pow_le_pow_left₀ (norm_nonneg _) hp _
      · rw [norm_mul]; exact mul_le_mul hp hq (norm_nonneg _) hx
      · rw [norm_pow]; exact pow_le_pow_left₀ (norm_nonneg _) hq _
  have hK : rationalZeroKernel b z-rationalZeroKernel b (z+(a:ℂ))=
      (p-q)+(b:ℂ)*(p^2-q^2)+((2*b^2/3:ℝ):ℂ)*(p^3-q^3) := by
    unfold rationalZeroKernel p q w v
    rw [←add_assoc]
    simp only [div_eq_mul_inv,←inv_pow,one_mul]
    ring
  rw [hK]
  calc
    _ ≤ ‖(p-q)+(b:ℂ)*(p^2-q^2)+((2*b^2/3:ℝ):ℂ)*(p^3-q^3)‖ := Complex.re_le_norm _
    _ ≤ a*(x*x)+b*((a*(x*x))*(x+x))+(2*b^2/3)*((a*(x*x))*(x^2+x*x+x^2)) := by
      refine (norm_add_le _ _).trans (add_le_add ((norm_add_le _ _).trans (add_le_add hd₁ ?_)) ?_)
      · rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hb.le]
        exact mul_le_mul_of_nonneg_left hd₂ hb.le
      · rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (by positivity)]
        exact mul_le_mul_of_nonneg_left hd₃ (by positivity)
    _ = _ := by
      unfold x
      field_simp [hb.ne']
      ring

end GoldbachPintzNumerics
end

section
namespace GoldbachPintzNumerics

open Complex

noncomputable section

private theorem rational_phase_formula {b x t : ℝ} (h : 0 < b+x) :
    let u := b+x
    let v := t^2
    (rationalZeroKernel b ((x:ℂ)+(t:ℂ)*I)).re =
      (u^5+b*u^4+(2*b^2/3)*u^3+2*u*(u^2-b^2)*v+(u-b)*v^2)/(u^2+v)^3 := by
  dsimp only
  let u := b+x
  let w : ℂ := (u:ℂ)+(t:ℂ)*I
  have hw₁ : (b:ℂ)+((x:ℂ)+(t:ℂ)*I)=w := by simp only [w,u,Complex.ofReal_add]; ring
  have hwR : w.re=u := by simp [w,Complex.mul_re]
  have hwI : w.im=t := by simp [w,Complex.mul_im]
  have hwN : Complex.normSq w = u^2+t^2 := by rw [Complex.normSq_apply,hwR,hwI]; ring
  have hd : u^2+t^2 ≠ 0 := (add_pos_of_pos_of_nonneg (sq_pos_of_pos h) (sq_nonneg _)).ne'
  have hwSum : w⁻¹ = (((u/(u^2+t^2)):ℝ):ℂ)+(((-t/(u^2+t^2)):ℝ):ℂ)*I := by
    apply Complex.ext
    · rw [Complex.inv_re,hwR,hwN]
      simp only [Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
        Complex.I_re,Complex.I_im,mul_zero,zero_mul,sub_zero,add_zero]
    · rw [Complex.inv_im,hwI,hwN]
      simp only [Complex.add_im,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,
        Complex.I_re,Complex.I_im,mul_zero,zero_mul,mul_one,zero_add,add_zero]
  change _ = (u^5+b*u^4+(2*b^2/3)*u^3+2*u*(u^2-b^2)*t^2+(u-b)*(t^2)^2)/(u^2+t^2)^3
  simp only [rationalZeroKernel,hw₁,div_eq_mul_inv,one_mul,← inv_pow,hwSum]
  simp only [pow_succ,pow_zero,one_mul,Complex.add_re,Complex.add_im,Complex.mul_re,Complex.mul_im,
    Complex.ofReal_re,Complex.ofReal_im,Complex.I_re,Complex.I_im,
    zero_mul,mul_zero,zero_add,add_zero,sub_zero,mul_one]
  field_simp [hd]
  ring

private theorem rational_phase_lower_at_two {t : ℝ} (ht : |t|≤ 2) :
    ((8/3:ℝ)*(7/2)^5)/(((7/2:ℝ)^2+16)^3)≤
      (rationalZeroKernel (7/2) (((2*t:ℝ):ℂ)*I)).re := by
  have h := rational_phase_formula (b:=7/2) (x:=0) (t:=2*t) (by norm_num)
  simp only [Complex.ofReal_zero,zero_add,add_zero,sub_self,mul_zero] at h
  rw [h]
  have hAbs : |2*t|≤4 := by
    rw [abs_mul,abs_of_nonneg (by norm_num : (0:ℝ)≤2)]
    linarith only [ht]
  have hSq : (2*t)^2≤16 := by
    have he : (2*t)^2≤(4:ℝ)^2 := sq_le_sq.mpr
      (by simpa only [abs_of_nonneg (by norm_num : (0:ℝ)≤4)] using hAbs)
    exact he.trans_eq (by norm_num)
  have hNum :
      (7/2:ℝ)^5+(7/2)*(7/2)^4+(2*(7/2)^2/3)*(7/2)^3=((8/3)*(7/2)^5:ℝ) := by norm_num
  simp only [zero_mul,add_zero]
  rw [hNum]
  have hInner : (7/2:ℝ)^2+(2*t)^2≤(7/2:ℝ)^2+16 :=
    (add_le_add_right) hSq ((7/2:ℝ)^2)
  apply div_le_div_of_nonneg_left (by norm_num)
    (pow_pos (show 0<(7/2:ℝ)^2+(2*t)^2 by positivity) 3)
  exact pow_le_pow_left₀ (by positivity) hInner 3

private theorem rational_nozero_norm_moderate {x t : ℝ} (hx : -(53/100:ℝ)≤ x) (ht : 2≤ |t|) :
    (7/2:ℝ)≤ ‖((7/2:ℝ):ℂ)+((x:ℂ)+(t:ℂ)*I)‖ := by
  let z := ((7/2:ℝ):ℂ)+((x:ℂ)+(t:ℂ)*I)
  have h1 : z.re=(7/2:ℝ)+x := by simp [z,Complex.add_re,Complex.mul_re]
  have h2 : z.im=t := by simp [z,Complex.add_im,Complex.mul_im]
  have hSq : ‖z‖^2=((7/2:ℝ)+x)^2+t^2 := by
    rw [←Complex.normSq_eq_norm_sq,Complex.normSq_apply,h1,h2]; ring
  have hT : (2:ℝ)^2≤ t^2 := sq_le_sq.mpr (by simpa using ht)
  have hX : ((7/2:ℝ)-(53/100))^2≤ ((7/2:ℝ)+x)^2 :=
    pow_le_pow_left₀ (by norm_num) (by linarith only [hx]) 2
  by_contra! hh
  change ‖z‖<7/2 at hh
  have hZ := pow_lt_pow_left₀ hh (norm_nonneg z) (by norm_num : (2:ℕ)≠0)
  nlinarith only [hSq,hT,hX,hZ]

set_option maxHeartbeats 850000 in
/-- A nonreal rival of a real leading zero cannot satisfy the second-root
test in the .38 by .53 rectangle, once its conjugate is retained when close. -/
theorem same_moderate_rival_false {a μ y C : ℝ}
    (ha : 0≤ a) (ha' : a≤ 19/50) (hμ : μ≤ 53/100) (hC : C≤ 377/1000)
    (hTest : realRationalZeroKernel (7/2) 0≤
      (realRationalZeroKernel (7/2) (-μ)-realRationalZeroKernel (7/2) (a-μ))+
      ((rationalZeroKernel (7/2) (((-μ:ℝ):ℂ)+(y:ℂ)*I)).re-
        (rationalZeroKernel (7/2) (((a-μ:ℝ):ℂ)+(y:ℂ)*I)).re)-
      (if |y|≤ 2 then (rationalZeroKernel (7/2) (((2*y:ℝ):ℂ)*I)).re else 0)+C) :
    False := by
  let b : ℝ := 7/2
  let Δ := realRationalZeroKernel b (-(53/100))-realRationalZeroKernel b (19/50-53/100)
  let z : ℂ := ((-μ:ℝ):ℂ)+(y:ℂ)*I
  have hN : z.re= -μ := by simp [z,Complex.add_re,Complex.mul_re]
  have hb : 0<b := by norm_num [b]
  have hBR : 0<b+z.re := by rw [hN]; unfold b; linarith only [hμ]
  have hΔ : realRationalZeroKernel b (-μ)-realRationalZeroKernel b (a-μ)≤ Δ := by
    have h1 := rational_kernel_increment_antitone (b:=b) (x:=-(53/100:ℝ)) (y:=-μ) (m:=a)
      hb (by norm_num [b]) (by linarith only [hμ]) ha
    have hf : realRationalZeroKernel b (19/50-53/100)≤ realRationalZeroKernel b (-(53/100)+a) :=
      realRationalZeroKernel_antitone hb (by unfold b; linarith only [ha])
        (by linarith only [ha'])
    rw [show -μ+a=a-μ by ring] at h1
    unfold Δ
    linarith only [h1,hf]
  have he : z+(a:ℂ)=((a-μ:ℝ):ℂ)+(y:ℂ)*I := by unfold z; push_cast; ring
  by_cases hy : |y|≤ 2
  · rw [ite_eq_left hy] at hTest
    have h1 := rational_kernel_defect_le_real hb.le ha hBR
    rw [he,Complex.sub_re,hN,show -μ+a=a-μ by ring] at h1
    have h2 := rational_phase_lower_at_two hy
    have hNum : 2*Δ-((8/3:ℝ)*(7/2)^5)/(((7/2:ℝ)^2+16)^3)+377/1000<
        realRationalZeroKernel b 0 := by norm_num [Δ,b,realRationalZeroKernel]
    change realRationalZeroKernel b 0≤ _ at hTest
    have hf : (0:ℝ)<0 := by linear_combination hTest+2*hΔ+h1+h2+hNum+hC
    exact (lt_irrefl (0:ℝ)) hf
  · rw [ite_eq_right hy,sub_zero] at hTest
    have hV : b≤ ‖(b:ℂ)+z‖ := rational_nozero_norm_moderate (x:=-μ) (by linarith only [hμ]) (le_of_lt (lt_of_not_ge hy))
    have hW : b≤ ‖(b:ℂ)+z+(a:ℂ)‖ := by
      rw [add_assoc,he]
      exact rational_nozero_norm_moderate (x:=a-μ) (by linarith only [hμ,ha]) (le_of_lt (lt_of_not_ge hy))
    have h1 := rational_kernel_defect_le_five_inverse_sq hb ha hV hW
    rw [he,Complex.sub_re] at h1
    have hA : 5*a/b^2≤5*(19/50)/b^2 :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left ha' (by norm_num)) (sq_nonneg _)
    have hNum : Δ+5*(19/50)/b^2+377/1000<realRationalZeroKernel b 0 := by
      norm_num [Δ,b,realRationalZeroKernel]
    change realRationalZeroKernel b 0≤ _ at hTest
    have hf : (0:ℝ)<0 := by linear_combination hTest+hΔ+h1+hA+hNum+hC
    exact (lt_irrefl (0:ℝ)) hf

end

end GoldbachPintzNumerics
end

