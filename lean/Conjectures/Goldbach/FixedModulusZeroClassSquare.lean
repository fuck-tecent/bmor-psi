namespace GoldbachSieveSeries

open Finset

theorem sum_inverse_sqrt_le (N : ℕ) :
    (∑ n ∈ Icc 1 N, 1 / Real.sqrt (n:ℝ)) ≤ 2 * Real.sqrt (N:ℝ) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ N+1)]
    push_cast
    let a := Real.sqrt ((N:ℝ)+1)
    let b := Real.sqrt (N:ℝ)
    have ha : 0 < a := Real.sqrt_pos.2 (by positivity)
    have hba : b ≤ a := Real.sqrt_le_sqrt (show (N:ℝ) ≤ N+1 by linarith)
    have ha2 : a^2 = (N:ℝ)+1 := Real.sq_sqrt (by positivity)
    have hb2 : b^2 = (N:ℝ) := Real.sq_sqrt (by positivity)
    have hab : (a-b)*(a+b) = 1 := by nlinarith only [ha2,hb2]
    have ht : 1/a ≤ 2*(a-b) := by
      apply (div_le_iff₀ ha).mpr
      nlinarith only [hab,sq_nonneg (a-b)]
    change (∑ n ∈ Icc 1 N, 1 / Real.sqrt (n:ℝ)) + 1/a ≤ 2*a
    change _ ≤ 2*b at ih
    linarith only [ih,ht]

private theorem inverse_sqrt_step {x : ℝ} (hx : 1 ≤ x) :
    1/((x+1)*Real.sqrt (x+1)) ≤
      2 * (1/Real.sqrt x - 1/Real.sqrt (x+1)) := by
  let a := Real.sqrt (x+1)
  let b := Real.sqrt x
  have hx0 := zero_lt_one.trans_le hx
  have ha : 0 < a := Real.sqrt_pos.2 (by positivity)
  have hb : 0 < b := Real.sqrt_pos.2 hx0
  have hba : b ≤ a := Real.sqrt_le_sqrt (by linarith)
  have ha2 : a^2 = x+1 := Real.sq_sqrt (by positivity)
  have hb2 : b^2 = x := Real.sq_sqrt hx0.le
  have hdiff : (a-b)*(a+b) = 1 := by nlinarith only [ha2,hb2]
  have he : 1/b - 1/a = 1/(a*b*(a+b)) := by
    have hsum : 0 < a+b := by positivity
    field_simp
    convert hdiff using 1
  change 1/((x+1)*a) ≤ 2*(1/b-1/a)
  rw [he,← ha2,show a^2*a=a^3 by ring]
  have h2 : a*b*(a+b) ≤ 2*a^3 := by
    nlinarith only [mul_nonneg (sub_nonneg.mpr hba) (show 0 ≤ a*(2*a+b) by positivity)]
  have hq := (one_div_le_one_div_of_le (by positivity : 0 < a*b*(a+b)) h2)
  rw [show 1/(2*a^3) = (1/2)*(1/a^3) by ring] at hq
  linarith only [hq]

theorem sum_inverse_mul_sqrt_le (N : ℕ) :
    (∑ n ∈ Icc 1 N, 1 / ((n:ℝ)*Real.sqrt (n:ℝ))) ≤ 3 := by
  have hN (N : ℕ) (h : 1 ≤ N) :
      (∑ n ∈ Icc 1 N, 1 / ((n:ℝ)*Real.sqrt (n:ℝ))) ≤ 3-2/Real.sqrt (N:ℝ) := by
    induction N, h using Nat.le_induction with
    | base => norm_num
    | succ n hn ih =>
      rw [Finset.sum_Icc_succ_top (by omega : 1 ≤ n+1)]
      push_cast
      have hnR : (1:ℝ) ≤ n := by exact_mod_cast hn
      have ht := inverse_sqrt_step hnR
      simp only [div_eq_mul_inv, one_mul] at ih ht ⊢
      linarith only [ih,ht]
  by_cases h0 : N = 0
  · simp [h0]
  · exact (hN N (by omega)).trans (sub_le_self _ (by positivity))

end GoldbachSieveSeries

end

section

namespace GoldbachSieveSeries

open Finset

theorem lcm_inverse_mass (D E : ℕ) :
    (∑ d ∈ Icc 1 D, ∑ e ∈ Icc 1 E, 1 / (d.lcm e : ℝ)) ≤
      (1 + Real.log (D+E+1 : ℝ))^3 := by
  let L : ℝ := 1 + Real.log (D+E+1 : ℝ)
  have hL : 0 ≤ L := by
    dsimp [L]
    exact add_nonneg zero_le_one (Real.log_nonneg (by linarith [Nat.cast_nonneg (α:=ℝ) D, Nat.cast_nonneg (α:=ℝ) E]))
  let u (n : ℕ) := (1:ℝ)/n
  have hH (n : ℕ) (hn : n ≤ D+E+1) : (∑ d ∈ Icc 1 n, u d) ≤ L := by
    have hsum : ∑ d ∈ Icc 1 n, u d = (harmonic n : ℝ) := by
      simp [u, harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast, one_div]
    rw [hsum]
    by_cases h0 : n = 0
    · subst n
      simpa using hL
    refine (harmonic_le_one_add_log n).trans (add_le_add_right ?_ 1)
    apply Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero h0)
    exact_mod_cast hn
  let S := Icc 1 D ×ˢ Icc 1 E
  let G := Icc 1 (min D E)
  let gcd (p : ℕ × ℕ) := p.1.gcd p.2
  let f (p : ℕ × ℕ) := (1 : ℝ) / (p.1.lcm p.2 : ℝ)
  have hmap : (S : Set (ℕ×ℕ)).MapsTo gcd G := by
    intro p hp
    obtain ⟨h1,h2⟩ := mem_product.mp hp
    obtain ⟨hd,hD⟩ := mem_Icc.mp h1
    obtain ⟨he,hE⟩ := mem_Icc.mp h2
    exact mem_Icc.mpr ⟨Nat.gcd_pos_of_pos_left _ hd,
      le_min ((Nat.gcd_le_left _ hd).trans hD) ((Nat.gcd_le_right _ he).trans hE)⟩
  have hsumg (g : ℕ) (hg : g ∈ G) :
      (∑ p ∈ S.filter (fun p => gcd p = g), f p) ≤
        L^2 * u g := by
    let F := S.filter (fun p => gcd p = g)
    let R := Icc 1 (D/g) ×ˢ Icc 1 (E/g)
    let h (p : ℕ × ℕ) := (p.1/g,p.2/g)
    let b (p : ℕ × ℕ) := u g * u p.1 * u p.2
    have hgp : 0 < g := (mem_Icc.mp hg).1
    have hgR : (0:ℝ) < g := by exact_mod_cast hgp
    have hdiv (p : ℕ × ℕ) (hp : p ∈ F) : g ∣ p.1 ∧ g ∣ p.2 := by
      rw [← (mem_filter.mp hp).2]
      exact ⟨Nat.gcd_dvd_left _ _,Nat.gcd_dvd_right _ _⟩
    have hR : F.image h ⊆ R := by
      intro p hp
      obtain ⟨q,hq,rfl⟩ := mem_image.mp hp
      obtain ⟨h1,h2⟩ := mem_product.mp (mem_filter.mp hq).1
      obtain ⟨ha,hD⟩ := mem_Icc.mp h1
      obtain ⟨hb,hE⟩ := mem_Icc.mp h2
      obtain ⟨ha',hb'⟩ := hdiv q hq
      refine mem_product.mpr ⟨mem_Icc.mpr ⟨?_,Nat.div_le_div_right hD⟩,
        mem_Icc.mpr ⟨?_,Nat.div_le_div_right hE⟩⟩
      · exact (Nat.le_div_iff_mul_le hgp).mpr (by simp [Nat.le_of_dvd ha ha'])
      · exact (Nat.le_div_iff_mul_le hgp).mpr (by simp [Nat.le_of_dvd hb hb'])
    have hinj : Set.InjOn h F := by
      intro p hp q hq heq
      apply Prod.ext
      · have hh := congrArg (fun z : ℕ×ℕ => z.1 * g) heq
        simpa only [h,Nat.div_mul_cancel (hdiv p hp).1,Nat.div_mul_cancel (hdiv q hq).1] using hh
      · have hh := congrArg (fun z : ℕ×ℕ => z.2 * g) heq
        simpa only [h,Nat.div_mul_cancel (hdiv p hp).2,Nat.div_mul_cancel (hdiv q hq).2] using hh
    have hlcm (p : ℕ×ℕ) (hp : p ∈ F) : p.1.lcm p.2 = g*(p.1/g)*(p.2/g) := by
      have hgcd : p.1.gcd p.2 = g := (mem_filter.mp hp).2
      apply Nat.eq_of_mul_eq_mul_right hgp
      calc
        p.1.lcm p.2 * g = p.1 * p.2 := by rw [← hgcd,Nat.lcm_mul_gcd]
        _ = ((p.1/g)*g)*((p.2/g)*g) := by
          rw [Nat.div_mul_cancel (hdiv p hp).1,Nat.div_mul_cancel (hdiv p hp).2]
        _ = _ := by ring
    have heq (p : ℕ×ℕ) (hp : p ∈ F) : f p = b (h p) := by
      unfold f b h u
      rw [hlcm p hp]
      push_cast
      simp only [one_div, mul_inv_rev]
      ring
    have hA := hH (D/g) ((Nat.div_le_self D g).trans (by omega))
    have hB := hH (E/g) ((Nat.div_le_self E g).trans (by omega))
    change (∑ p ∈ F, f p) ≤ _
    calc
      _ = ∑ p ∈ F, b (h p) := sum_congr rfl heq
      _ = ∑ p ∈ F.image h, b p := (sum_image hinj).symm
      _ ≤ ∑ p ∈ R, b p := sum_le_sum_of_subset_of_nonneg hR (fun _ _ _ => by dsimp [b,u]; positivity)
      _ = u g*(∑ d ∈ Icc 1 (D/g), u d)*(∑ e ∈ Icc 1 (E/g), u e) := by
        unfold R
        rw [sum_product]
        simp only [Finset.mul_sum,Finset.sum_mul]
        rw [sum_comm]
      _ ≤ u g * L * L :=
        mul_le_mul (mul_le_mul_of_nonneg_left hA (by dsimp [u]; positivity)) hB
          (sum_nonneg (fun _ _ => by dsimp [u]; positivity)) (by dsimp [u]; positivity)
      _ = L^2 * u g := by ring
  change (∑ d ∈ Icc 1 D, ∑ e ∈ Icc 1 E, f (d,e)) ≤ _
  rw [← sum_product]
  change (∑ p ∈ S, f p) ≤ _
  rw [← sum_fiberwise_of_maps_to hmap]
  refine (sum_le_sum hsumg).trans ?_
  rw [← mul_sum]
  change L^2 * (∑ g ∈ G, u g) ≤ L^3
  exact (mul_le_mul_of_nonneg_left (hH (min D E) (by omega)) (sq_nonneg L)).trans_eq (by ring)

end GoldbachSieveSeries

end

section

namespace GoldbachSieveSeries

open Finset

noncomputable section

def divisorWeight (D : Finset ℕ) (u : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ d ∈ D, if d ∣ n then u d else 0

def lcmWeight (D E : Finset ℕ) (u v : ℕ → ℂ) (r : ℕ) : ℂ :=
  ∑ d ∈ D, ∑ e ∈ E, if d.lcm e = r then u d * v e else 0

def lcmSupport (D E : Finset ℕ) : Finset ℕ :=
  (D ×ˢ E).image fun p => p.1.lcm p.2

theorem lcmWeight_eq_zero_of_not_mem {D E : Finset ℕ} (u v : ℕ → ℂ) {r : ℕ}
    (hr : r ∉ lcmSupport D E) : lcmWeight D E u v r = 0 := by
  apply sum_eq_zero
  intro d hd
  apply sum_eq_zero
  intro e he
  exact ite_eq_right (fun h => hr (mem_image.mpr ⟨(d,e), mem_product.mpr ⟨hd,he⟩,h⟩))

theorem divisorWeight_mul (D E : Finset ℕ) (u v : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    divisorWeight D u n * divisorWeight E v n =
      ∑ r ∈ n.divisors, lcmWeight D E u v r := by
  unfold divisorWeight lcmWeight
  rw [sum_mul_sum]
  symm
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  rw [sum_comm]
  apply sum_congr rfl
  intro e _
  rw [sum_ite_eq]
  simp only [Nat.mem_divisors,Nat.lcm_dvd_iff]
  by_cases hd : d ∣ n <;> by_cases he : e ∣ n <;> simp [hd,he,hn]

def sieveProduct (D E : Finset ℕ) (u v : ℕ → ℂ) (n : ℕ) : ℂ :=
  divisorWeight D u n * divisorWeight E v n

theorem twisted_sieveProduct_convolution {q : ℕ} (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    χ (n : ZMod q) * sieveProduct D E u v n =
      (LSeries.convolution ((fun n : ℕ => χ n) * lcmWeight D E u v) (fun n : ℕ => χ n)) n := by
  have htwist := DirichletCharacter.mul_convolution_distrib χ (lcmWeight D E u v) (1 : ℕ → ℂ)
  simp only [mul_one] at htwist
  rw [htwist]
  simp only [sieveProduct, divisorWeight_mul D E u v hn, LSeries.convolution_def,
    Pi.mul_apply, Pi.one_apply, mul_one]
  rw [Nat.sum_divisorsAntidiagonal (fun a _ => lcmWeight D E u v a)]

private theorem lcm_polynomial_summable {q : ℕ} (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) (s : ℂ) :
    LSeriesSummable ((fun n : ℕ => χ n) * lcmWeight D E u v) s := by
  apply summable_of_hasFiniteSupport
  apply (lcmSupport D E).finite_toSet.subset
  intro n hn
  by_contra h
  exact hn (by simp [LSeries.term,lcmWeight_eq_zero_of_not_mem u v h])

theorem sieveProduct_summable {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) {s : ℂ} (hs : 1 < s.re) :
    LSeriesSummable ((fun n : ℕ => χ n) * sieveProduct D E u v) s := by
  have ht : LSeries.term ((fun n : ℕ => χ n) * sieveProduct D E u v) s =
      LSeries.term (LSeries.convolution ((fun n : ℕ => χ n) * lcmWeight D E u v) (fun n : ℕ => χ n)) s :=
    funext (LSeries.term_congr (fun hn => twisted_sieveProduct_convolution χ D E u v hn) s)
  unfold LSeriesSummable
  rw [ht]
  exact (lcm_polynomial_summable χ D E u v s).convolution
    (χ.LSeriesSummable_of_one_lt_re hs)

/-- Factor the Dirichlet series of two divisor weights into one L-function and
a finite polynomial on the least common multiples. -/
theorem sieveProduct_LSeries {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) {s : ℂ} (hs : 1 < s.re) :
    LSeries ((fun n : ℕ => χ n) * sieveProduct D E u v) s =
      (∑ r ∈ lcmSupport D E, LSeries.term ((fun n : ℕ => χ n) * lcmWeight D E u v) s r) *
        χ.LFunction s := by
  let G : ℕ → ℂ := (fun n : ℕ => χ n) * lcmWeight D E u v
  have hg (n : ℕ) (h : n ∉ lcmSupport D E) : LSeries.term G s n = 0 := by
    simp [LSeries.term, G, lcmWeight_eq_zero_of_not_mem u v h]
  have hG : LSeriesSummable G s := lcm_polynomial_summable χ D E u v s
  have hEq : LSeries ((fun n : ℕ => χ n) * sieveProduct D E u v) s =
      LSeries (LSeries.convolution G (fun n : ℕ => χ n)) s :=
    LSeries_congr (fun hn => twisted_sieveProduct_convolution χ D E u v hn) s
  rw [hEq, LSeries_convolution' hG (χ.LSeriesSummable_of_one_lt_re hs),
    DirichletCharacter.LFunction_eq_LSeries χ hs]
  unfold LSeries
  rw [tsum_eq_sum hg]

end
end GoldbachSieveSeries

