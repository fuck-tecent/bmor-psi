section
open MeasureTheory
open scoped Interval
namespace Vl2
theorem V1gz (f : ℝ → ℂ) (a b : ℝ) (hab : a≤b)
    (hf : ContinuousOn f (Set.Icc a b)) :
    ‖∫ u in a..b, f u‖^2 ≤ (b-a)*(∫ u in a..b, ‖f u‖^2) := by
  rcases eq_or_lt_of_le hab with heq | hlt
  · subst b
    simp
  let I : ℝ := ∫ u in a..b, ‖f u‖
  let J : ℝ := ∫ u in a..b, ‖f u‖^2
  let d : ℝ := b-a
  have hd : 0<d := sub_pos.mpr hlt
  have hi : IntervalIntegrable (fun u => ‖f u‖) volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab hf.norm
  have hj : IntervalIntegrable (fun u => ‖f u‖^2) volume a b :=
    ContinuousOn.intervalIntegrable_of_Icc hab (hf.norm.pow 2)
  have hvar : 0≤∫ u in a..b, (d*‖f u‖-I)^2 :=
    intervalIntegral.integral_nonneg_of_forall hab (fun _ => sq_nonneg _)
  have hexpand : (∫ u in a..b, (d*‖f u‖-I)^2)=d^2*J-d*I^2 := by
    calc
      _ = ∫ u in a..b, d^2*‖f u‖^2-2*d*I*‖f u‖+I^2 := by
        apply intervalIntegral.integral_congr
        intro u hu
        dsimp only
        ring
      _ = d^2*J-2*d*I*I+d*I^2 := by
        rw [intervalIntegral.integral_add ((hj.const_mul _).sub (hi.const_mul _))
          intervalIntegrable_const,
          intervalIntegral.integral_sub (hj.const_mul _) (hi.const_mul _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
          intervalIntegral.integral_const]
        rfl
      _ = _ := by ring
  rw [hexpand] at hvar
  have hcs : I^2≤d*J := by nlinarith
  have hI : 0≤I := intervalIntegral.integral_nonneg_of_forall hab (fun _ => norm_nonneg _)
  have hnorm : ‖∫ u in a..b, f u‖≤I :=
    intervalIntegral.norm_integral_le_integral_norm hab
  exact ((sq_le_sq₀ (norm_nonneg _) hI).2 hnorm).trans hcs
end Vl2
end

section
open MeasureTheory
open scoped Interval
namespace V6i
noncomputable def V3q (f : ℝ → ℂ) (δ y : ℝ) : ℂ :=
  (δ : ℂ)⁻¹*(∫ u in y-δ..y,f u)
theorem V16e (f : ℝ → ℝ) (X δ : ℝ)
    (hX : 0≤X) (hδ : 0≤δ)
    (hf : ContinuousOn f (Set.Icc (X-δ) (2*X)))
    (hf0 : ∀ u∈Set.Icc (X-δ) (2*X),0≤f u) :
    IntervalIntegrable (fun y => ∫ u in y-δ..y,f u) volume X (2*X) ∧
      (∫ y in X..2*X,∫ u in y-δ..y,f u)≤δ*(∫ u in X-δ..2*X,f u) := by
  have hXX : X≤2*X := by linarith
  have hrect : ContinuousOn (fun p : ℝ×ℝ => f (p.1-p.2))
      ((Set.Icc X (2*X)) ×ˢ (Set.Icc 0 δ)) := by
    apply hf.comp ((continuous_fst.sub continuous_snd).continuousOn)
    intro p hp
    change X-δ≤p.1-p.2 ∧ p.1-p.2≤2*X
    exact ⟨by linarith [hp.1.1,hp.2.2],by linarith [hp.1.2,hp.2.1]⟩
  have hprod : Integrable (fun p : ℝ×ℝ => f (p.1-p.2))
      ((volume.restrict (Set.Icc X (2*X))).prod (volume.restrict (Set.Icc 0 δ))) := by
    rw [Measure.prod_restrict]
    exact hrect.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  have heq : (fun y => ∫ u in y-δ..y,f u)=(fun y => ∫ t in 0..δ,f (y-t)) := by
    funext y
    rw [intervalIntegral.integral_comp_sub_left f y]
    simp only [sub_zero]
  have houter : IntervalIntegrable (fun y => ∫ t in 0..δ,f (y-t)) volume X (2*X) := by
    apply (intervalIntegrable_iff_integrableOn_Icc_of_le hXX).2
    simp_rw [intervalIntegral.integral_of_le hδ,← integral_Icc_eq_integral_Ioc]
    exact hprod.integral_prod_left
  have hswap : (∫ y in X..2*X,∫ t in 0..δ,f (y-t))=
      ∫ t in 0..δ,∫ y in X..2*X,f (y-t) := by
    simp_rw [intervalIntegral.integral_of_le hXX,intervalIntegral.integral_of_le hδ,
      ← integral_Icc_eq_integral_Ioc]
    exact integral_integral_swap hprod
  have hinner : IntervalIntegrable (fun t => ∫ y in X..2*X,f (y-t)) volume 0 δ := by
    apply (intervalIntegrable_iff_integrableOn_Icc_of_le hδ).2
    simp_rw [intervalIntegral.integral_of_le hXX,← integral_Icc_eq_integral_Ioc]
    exact hprod.integral_prod_right
  have hpoint : ∀ t∈Set.Icc 0 δ,
      (∫ y in X..2*X,f (y-t))≤∫ u in X-δ..2*X,f u := by
    intro t ht
    rw [intervalIntegral.integral_comp_sub_right f t]
    apply intervalIntegral.integral_mono_interval
      (by linarith [ht.2] : X-δ≤X-t) (by linarith : X-t≤2*X-t)
      (by linarith [ht.1] : 2*X-t≤2*X)
    · filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
      exact hf0 u ⟨hu.1.le,hu.2⟩
    · exact ContinuousOn.intervalIntegrable_of_Icc (by linarith) hf
  rw [heq]
  refine ⟨houter,?_⟩
  rw [hswap]
  calc
    _ ≤ ∫ _t in 0..δ,(∫ u in X-δ..2*X,f u) :=
      intervalIntegral.integral_mono_on hδ hinner intervalIntegrable_const hpoint
    _ = _ := by simp only [intervalIntegral.integral_const,sub_zero,smul_eq_mul]
theorem V1qh (f : ℝ → ℂ) (X δ : ℝ)
    (hX : 0≤X) (hδ : 0<δ)
    (hf : ContinuousOn f (Set.Icc (X-δ) (2*X))) :
    (∫ y in X..2*X,‖V3q f δ y‖^2)≤
      ∫ u in X-δ..2*X,‖f u‖^2 := by
  have hXX : X≤2*X := by linarith
  obtain ⟨hQ,hFubini⟩ := V16e (fun u => ‖f u‖^2) X δ hX hδ.le
    (hf.norm.pow 2) (fun _ _ => sq_nonneg _)
  have hp : ∀ y∈Set.Icc X (2*X),
      ‖V3q f δ y‖^2≤(1/δ)*(∫ u in y-δ..y,‖f u‖^2) := by
    intro y hy
    have hcont : ContinuousOn f (Set.Icc (y-δ) y) := hf.mono (by
      intro u hu
      exact ⟨by linarith [hy.1,hu.1],by linarith [hy.2,hu.2]⟩)
    have hc := Vl2.V1gz f (y-δ) y (by linarith) hcont
    have hn : ‖V3q f δ y‖^2=
        (δ⁻¹)^2*‖∫ u in y-δ..y,f u‖^2 := by
      rw [V3q,norm_mul,norm_inv,Complex.norm_real,Real.norm_of_nonneg hδ.le,mul_pow]
    rw [hn]
    apply (mul_le_mul_of_nonneg_left hc (sq_nonneg (δ⁻¹))).trans_eq
    field_simp
    <;> ring
  have hmean : (∫ y in X..2*X,‖V3q f δ y‖^2)≤
      (1/δ)*(∫ y in X..2*X,∫ u in y-δ..y,‖f u‖^2) := by
    have he : (∫ y in X..2*X,‖V3q f δ y‖^2)≤
        ∫ y in X..2*X,(1/δ)*(∫ u in y-δ..y,‖f u‖^2) := by
      rw [intervalIntegral.integral_of_le hXX,intervalIntegral.integral_of_le hXX]
      apply integral_mono_of_nonneg (Filter.Eventually.of_forall (fun _ => sq_nonneg _))
        (hQ.const_mul (1/δ)).1
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
      exact hp y ⟨hy.1.le,hy.2⟩
    simpa only [intervalIntegral.integral_const_mul] using he
  calc
    _ ≤ (1/δ)*(∫ y in X..2*X,∫ u in y-δ..y,‖f u‖^2) := hmean
    _ ≤ (1/δ)*(δ*(∫ u in X-δ..2*X,‖f u‖^2)) :=
      mul_le_mul_of_nonneg_left hFubini (by positivity)
    _ = _ := by field_simp
end V6i
end

section
open MeasureTheory Finset
open scoped Interval BigOperators Classical
namespace Vg1
open V6i
theorem Vp7 (f : ℝ → ℂ) (X δ : ℝ)
    (hX : 0≤X) (hδ : 0≤δ)
    (hf : ContinuousOn f (Set.Icc (X-δ) (2*X))) :
    ContinuousOn (V3q f δ) (Set.Icc X (2*X)) := by
  have hbig : X-δ≤2*X := by linarith
  have hi : IntervalIntegrable f volume (X-δ) (2*X) :=
    ContinuousOn.intervalIntegrable_of_Icc hbig hf
  let P (y : ℝ) := ∫ u in X-δ..y,f u
  have hp : ContinuousOn P (Set.Icc (X-δ) (2*X)) := by
    simpa only [Set.uIcc_of_le hbig] using
      (intervalIntegral.continuousOn_primitive_interval' hi
        (Set.left_mem_uIcc : X-δ∈Set.uIcc (X-δ) (2*X)))
  have hp0 : ContinuousOn P (Set.Icc X (2*X)) := hp.mono (by
    intro y hy; exact ⟨by linarith [hy.1],hy.2⟩)
  have hps : ContinuousOn (fun y : ℝ => P (y-δ)) (Set.Icc X (2*X)) := by
    apply hp.comp (continuousOn_id.sub continuousOn_const)
    intro y hy
    change X-δ≤y-δ ∧ y-δ≤2*X
    exact ⟨by linarith [hy.1],by linarith [hy.2]⟩
  have hc : ContinuousOn (fun y => (δ : ℂ)⁻¹*(P y-P (y-δ))) (Set.Icc X (2*X)) :=
    continuousOn_const.mul (hp0.sub hps)
  apply hc.congr
  intro y hy
  have hiy : IntervalIntegrable f volume (X-δ) y :=
    hi.mono_set (by
      rw [Set.uIcc_of_le hbig,Set.uIcc_of_le (show X-δ≤y by linarith [hy.1])]
      exact Set.Icc_subset_Icc le_rfl hy.2)
  have hiyδ : IntervalIntegrable f volume (X-δ) (y-δ) :=
    hi.mono_set (by
      rw [Set.uIcc_of_le hbig,Set.uIcc_of_le (show X-δ≤y-δ by linarith [hy.1])]
      exact Set.Icc_subset_Icc le_rfl (by linarith [hy.2]))
  dsimp [P,V3q]
  rw [intervalIntegral.integral_interval_sub_left hiy hiyδ]
theorem Vul (f : ℝ → ℂ) (X δ M : ℝ)
    (hX : 0≤X) (hδ : 0<δ) (hM : 0≤M)
    (hf : ContinuousOn f (Set.Icc (X-δ) (2*X)))
    (hedge : ∀ y∈Set.Icc (X-δ) X,‖f y‖≤M) :
    (∫ y in X..2*X,‖V3q f δ y‖^2)≤
      (∫ y in X..2*X,‖f y‖^2)+δ*M^2 := by
  have hc := hf.norm.pow 2
  have hi0 : IntervalIntegrable (fun y => ‖f y‖^2) volume (X-δ) X :=
    ContinuousOn.intervalIntegrable_of_Icc (by linarith) (hc.mono (by
      intro y hy; exact ⟨hy.1,by linarith [hy.2]⟩))
  have hi1 : IntervalIntegrable (fun y => ‖f y‖^2) volume X (2*X) :=
    ContinuousOn.intervalIntegrable_of_Icc (by linarith) (hc.mono (by
      intro y hy; exact ⟨by linarith [hy.1],hy.2⟩))
  have he : (∫ y in X-δ..X,‖f y‖^2)≤δ*M^2 := by
    have hm : (∫ y in X-δ..X,‖f y‖^2)≤∫ _y in X-δ..X,M^2 :=
      intervalIntegral.integral_mono_on (by linarith) hi0 intervalIntegrable_const
        (fun y hy => (sq_le_sq₀ (norm_nonneg _) hM).2 (hedge y hy))
    simpa only [intervalIntegral.integral_const,sub_sub_cancel,smul_eq_mul] using hm
  have hb := V1qh f X δ hX hδ hf
  rw [← intervalIntegral.integral_add_adjacent_intervals hi0 hi1] at hb
  linarith
theorem V1dt (f g : ℝ → ℂ) (X E : ℝ)
    (hX : 0≤X) (hE : 0≤E) (hg : ContinuousOn g (Set.Icc X (2*X)))
    (hfg : ∀ y∈Set.Icc X (2*X),‖f y+g y‖≤E) :
    (∫ y in X..2*X,‖f y‖^2)≤2*(∫ y in X..2*X,‖g y‖^2)+2*E^2*X := by
  have hXX : X≤2*X := by linarith
  have hig : IntervalIntegrable (fun y => ‖g y‖^2) volume X (2*X) :=
    ContinuousOn.intervalIntegrable_of_Icc hXX (hg.norm.pow 2)
  have hi : IntervalIntegrable (fun y => 2*‖g y‖^2+2*E^2) volume X (2*X) :=
    (hig.const_mul 2).add intervalIntegrable_const
  have hp : ∀ y∈Set.Icc X (2*X),‖f y‖^2≤2*‖g y‖^2+2*E^2 := by
    intro y hy
    have hn : ‖f y‖≤E+‖g y‖ := by
      calc
        _ = ‖(f y+g y)-g y‖ := by rw [add_sub_cancel_right]
        _ ≤ ‖f y+g y‖+‖g y‖ := norm_sub_le _ _
        _ ≤ E+‖g y‖ := by gcongr; exact hfg y hy
    have hs := (sq_le_sq₀ (norm_nonneg _) (by positivity : 0≤E+‖g y‖)).2 hn
    nlinarith [sq_nonneg (E-‖g y‖)]
