namespace Vbt
theorem V1zq (X : ℝ) (hX : 2≤X) :
    Real.log (3*X)≤3*Real.log X := by
  have hXp : 0<X := by linarith
  have hs : 3≤X^2 := by nlinarith
  have hp := mul_le_mul_of_nonneg_right hs hXp.le
  have hpow : 3*X≤X^3 := by nlinarith
  have he := Real.log_le_log (by positivity : 0<3*X) hpow
  simpa only [Real.log_pow,Nat.cast_ofNat] using he
theorem Vts (X : ℝ) (hX : 2≤X) :
    1≤Nat.ceil (3*X)+1 ∧
      3*X<((Nat.ceil (3*X)+1 : ℕ) : ℝ) ∧
      ((Nat.ceil (3*X)+1 : ℕ) : ℝ)≤4*X ∧
      Real.log ((Nat.ceil (3*X)+1 : ℕ) : ℝ)≤3*Real.log X := by
  have hlo := Nat.le_ceil (3*X)
  have hhi := Nat.ceil_lt_add_one (by linarith : 0≤3*X)
  have hnlo : 3*X<((Nat.ceil (3*X)+1 : ℕ) : ℝ) := by
    rw [Nat.cast_add,Nat.cast_one]
    linarith
  have hnhi : ((Nat.ceil (3*X)+1 : ℕ) : ℝ)≤4*X := by
    rw [Nat.cast_add,Nat.cast_one]
    linarith
  refine ⟨by omega,hnlo,hnhi,?_⟩
  have hNp : 0<((Nat.ceil (3*X)+1 : ℕ) : ℝ) := by positivity
  have hs : 4≤X^2 := by nlinarith
  have hp := mul_le_mul_of_nonneg_right hs (by linarith : 0≤X)
  have hpow : ((Nat.ceil (3*X)+1 : ℕ) : ℝ)≤X^3 := by nlinarith
  have he := Real.log_le_log hNp hpow
  simpa only [Real.log_pow,Nat.cast_ofNat] using he
theorem V14r (Q U : ℝ) (hQ : 1≤Q) (hU : 2≤U) :
    Real.log (Q*(U+2))≤2*Real.log (Q*U) := by
  have hQp : 0<Q := by linarith
  have hUp : 0<U := by linarith
  have hbase : 2≤Q*U := by nlinarith
  have hlo := Real.log_le_log (by norm_num : (0 : ℝ)<2) hbase
  have hinside : Q*(U+2)≤2*(Q*U) := by nlinarith
  have hhi := Real.log_le_log (by positivity : 0<Q*(U+2)) hinside
  have he : Real.log (2*(Q*U))=Real.log 2+Real.log (Q*U) :=
    Real.log_mul (by norm_num) (by positivity)
  rw [he] at hhi
  linarith
theorem V1mq (X q Q u : ℝ)
    (hX : 4≤X) (hq : 1≤q) (hqQ : q≤Q) (hQX : Q≤2*(Real.log X)^24)
    (hu : 1≤u) (huX : u≤3*X) :
    Real.sqrt u*(1+Real.log q)≤52*Real.sqrt X*Real.log X := by
  have hXp : 0<X := by linarith
  have hqp : 0<q := by linarith
  have hLp : 0<Real.log X := Real.log_pos (by linarith)
  have hL : 1≤Real.log X := by
    apply (Real.le_log_iff_exp_le hXp).2
    exact Real.exp_one_lt_three.le.trans (by linarith)
  have hloglog : Real.log (Real.log X)≤Real.log X := by
    have hh := Real.log_le_sub_one_of_pos hLp
    linarith
  have hlog2 : Real.log 2≤Real.log X :=
    Real.log_le_log (by norm_num) (by linarith)
  have hqlog : Real.log q≤Real.log 2+24*Real.log (Real.log X) := by
    have hh := Real.log_le_log hqp (hqQ.trans hQX)
    have he : Real.log (2*(Real.log X)^24)=
        Real.log 2+24*Real.log (Real.log X) := by
      rw [Real.log_mul (by norm_num) (by positivity),Real.log_pow]
      norm_num
    rwa [he] at hh
  have hfactor : 1+Real.log q≤26*Real.log X := by linarith
  have hfactor0 : 0≤1+Real.log q := by linarith [Real.log_nonneg hq]
  have hsqrt : Real.sqrt u≤2*Real.sqrt X := by
    calc
      _ ≤ Real.sqrt (4*X) := Real.sqrt_le_sqrt (by linarith)
      _ = _ := by rw [Real.sqrt_mul (by norm_num)]; norm_num
  have hm := mul_le_mul hsqrt hfactor hfactor0 (by positivity)
  exact hm.trans_eq (by ring)
end Vbt
