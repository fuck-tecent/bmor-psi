open Finset

noncomputable section

theorem exists_empty_dilated_height_interval {ι : Type*} (S : Finset ι)
    (height : ι→ℝ) {B : ℕ} (hB : S.card≤B) {A : ℝ} (hA : 2≤A) :
    ∃ R : ℝ, A≤R ∧ R≤A*5^B ∧ ∀ j∈S, height j≤R ∨ 4*R+2<height j := by
  classical
  let rad (i : ℕ) : ℝ := A*5^i
  have hA₀ : 0<A := by linarith only [hA]
  have hRAD : Monotone rad := by
    intro i j h
    exact mul_le_mul_of_nonneg_left (pow_le_pow_right₀ (by norm_num : (1:ℝ)≤5) h) hA₀.le
  have hLo (i : ℕ) : A≤rad i := by
    have h := hRAD (Nat.zero_le i)
    simpa only [rad,pow_zero,mul_one] using h
  by_contra! h
  have hbad (i : Fin (B+1)) : ∃ j∈S, rad i<height j ∧ height j≤4*rad i+2 :=
    h (rad i) (hLo i) (hRAD (by omega : (i:ℕ)≤B))
  choose f hf hfBounds using hbad
  have hDis (i j : Fin (B+1)) (h : i<j) : f i≠f j := by
    intro he
    have hStep : rad (i+1:ℕ)≤rad j := hRAD (by omega)
    have hrad : rad (i+1:ℕ)=5*rad i := by simp only [rad,pow_succ]; ring
    have h₁ := (hfBounds i).2
    have h₂ := (hfBounds j).1
    have hAi := hLo i
    rw [he] at h₁
    rw [hrad] at hStep
    linarith only [hStep,hAi,hA,h₁,h₂]
  have hInj : Function.Injective f := by
    intro i j he
    rcases lt_trichotomy i j with hi|hEq|hj
    · exact (hDis i j hi he).elim
    · exact hEq
    · exact (hDis j i hj he.symm).elim
  have hMap : (univ : Finset (Fin (B+1))).image f ⊆ S := by
    intro x hx
    obtain ⟨i,_,rfl⟩ := mem_image.mp hx
    exact hf i
  have hSize := (card_le_card hMap).trans hB
  rw [card_image_of_injective _ hInj,card_univ,Fintype.card_fin] at hSize
  omega

end
end GoldbachSignedPairs
end

