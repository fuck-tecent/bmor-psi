private theorem changeLevel_cast {r s q : ℕ} (h : r = s) (hr : r ∣ q) (hs : s ∣ q)
    (χ : DirichletCharacter ℂ r) :
    changeLevel hs (cast (congrArg (DirichletCharacter ℂ) h) χ) = changeLevel hr χ := by
  subst s
  rfl

theorem primitiveCharacter_sigma_changeLevel {r q : ℕ} [NeZero q] (h : r ∣ q)
    (ψ : DirichletCharacter ℂ r) (hp : ψ.IsPrimitive) :
    (⟨(changeLevel h ψ).conductor, (changeLevel h ψ).primitiveCharacter⟩ :
      Σ r : ℕ, DirichletCharacter ℂ r) = ⟨r, ψ⟩ := by
  let χ := changeLevel h ψ
  have hc : χ.conductor = r := (conductor_changeLevel ψ h).trans hp
  refine Sigma.ext hc ?_
  have hh : cast (congrArg (DirichletCharacter ℂ) hc) χ.primitiveCharacter = ψ := by
    apply changeLevel_injective (R := ℂ) h
    calc
      _ = changeLevel χ.conductor_dvd_level χ.primitiveCharacter :=
        changeLevel_cast hc χ.conductor_dvd_level h χ.primitiveCharacter
      _ = χ := changeLevel_primitiveCharacter χ
      _ = _ := rfl
  exact (cast_heq (congrArg (DirichletCharacter ℂ) hc) χ.primitiveCharacter).symm.trans (heq_of_eq hh)


end GoldbachConductorRegroup


