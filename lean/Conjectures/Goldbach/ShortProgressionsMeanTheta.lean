open Finset Filter ShortAPDyadicPartition ShortAPBoxedHB ShortAPSmoothedFactor
open scoped BigOperators

namespace ShortAPSmallConductorBlocks
noncomputable section

/-- The second cap of (4.8), with no analytic hypothesis, on every active box
with a long smooth factor in its subquadratic frequency range. -/
theorem active_smooth_cap {η ε : ℝ} (hη : 0 < η) (hη' : η ≤ 1) (hε : 0 < ε) (P : ℕ) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H j q : ℕ} (χ : DirichletCharacter ℂ q),
    1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice j),
    j < 4 → H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → z ≤ 4*x → b ∈ activeChoices X H j a z →
    (∃ k : {i // i ∈ blockIndices j}, k.val < j+1 ∧ x^ε ≤ scale (b k.val k.property) ∧
      (q:ℝ)*max 2 |t| ≤ (scale (b k.val k.property))^(2-η)) →
    ∀ U : {i // i ∈ blockIndices j} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H j k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices j).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [ShortAPSmallConductorProduct.active_box_cap P,
    ShortAPSmallConductorSmooth.box_subquadratic_active_cap_eventually η ε hη hη' hε (P+17),
    eventually_ge_atTop (1:ℝ)] with x hc hs hx
  intro X H j q χ hq hp t a z b hj hH hHX hX hz hb ⟨k, hki, hkN, hkf⟩ U hu
  let _ : NeZero q := ⟨by omega⟩
  apply hc χ t a z b hj hH hHX hX hz hb U hu
  exact ⟨k, (mul_le_mul_of_nonneg_right (hu k).2 (pow_nonneg (Real.log_nonneg hx) _)).trans
    (hs χ hq hp t H j k.val (b k.val k.property) hki hkN hkf)⟩

/-- For the first three blocks of the order-four identity the long smooth
factor exists automatically. The conductor and frequency may both grow. -/
theorem first_three_cap (P : ℕ) : ∀ᶠ x : ℝ in atTop, ∀ {X H j q : ℕ}
    (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice j),
    j < 3 → H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → (H : ℝ) ≤ (4*x)^((1:ℝ)/4) →
    x ≤ a → z ≤ 4*x → b ∈ activeChoices X H j a z → (q:ℝ)*max 2 |t| ≤ x^((3:ℝ)/64) →
    ∀ U : {i // i ∈ blockIndices j} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H j k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices j).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [ShortAPSmallConductorProduct.first_three_long_smooth,
    active_smooth_cap (η := 1/2) (ε := 1/32) (by norm_num) (by norm_num) (by norm_num) P,
    eventually_ge_atTop (1:ℝ)] with x hlong hcap hx
  intro X H j q χ hq hp t a z b hj hH hHX hX hHr ha hz hb hf
  obtain ⟨k, hki, hkN⟩ := hlong hb hH hHX hj hHr ha
  apply hcap χ hq hp t a z b (by omega) hH hHX hX hz hb
  refine ⟨k, hki, hkN.le, hf.trans ?_⟩
  have he : x^((3:ℝ)/64) = (x^((1:ℝ)/32))^(2-(1:ℝ)/2) := by
    rw [← Real.rpow_mul (show 0 ≤ x by linarith)]; norm_num
  rw [he]
  exact Real.rpow_le_rpow (Real.rpow_nonneg (by linarith) _) hkN.le (by norm_num)

end
end ShortAPSmallConductorBlocks

