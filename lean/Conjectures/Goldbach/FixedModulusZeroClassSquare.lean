noncomputable section

def classMassSq {ι κ : Type*} (S : Finset ι) (key : ι → κ) (a : ι → ℝ) : ℝ :=
  ∑ c ∈ S.image key,(∑ i ∈ S.filter (fun j => key j=c),a i)^2

theorem classMassSq_le_of_injection {ι ι' κ : Type*} {S : Finset ι} {D : Finset ι'}
    {f : ι → ι'} {key : ι → κ} {key' : ι' → κ} {a : ι → ℝ} {b : ι' → ℝ}
    (hmap : Set.MapsTo f (S:Set ι) D) (hinj : Set.InjOn f (S:Set ι))
    (hkey : ∀ i ∈ S, key' (f i) = key i)
    (ha : ∀ i ∈ S, 0 ≤ a i) (hb : ∀ i ∈ D, 0 ≤ b i)
    (hab : ∀ i ∈ S, a i ≤ b (f i)) :
    classMassSq S key a ≤ classMassSq D key' b := by
  unfold classMassSq
  let B (c : κ) := ∑ j ∈ D.filter (fun j => key' j=c),b j
  let A (c : κ) := ∑ i ∈ S.filter (fun i => key i=c),a i
  have hClasses : S.image key ⊆ D.image key' := by
    intro c hc
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hc
    exact mem_image.mpr ⟨f i,hmap hi,hkey i hi⟩
  have hFiber (c : κ) :
      ((S.filter (fun i => key i=c)).image f) ⊆ D.filter (fun j => key' j=c) := by
    intro j hj
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hj
    obtain ⟨hiS,hiC⟩ := mem_filter.mp hi
    exact mem_filter.mpr ⟨hmap hiS,(hkey i hiS).trans hiC⟩
  have hA0 (c : κ) : 0 ≤ A c :=
    sum_nonneg (fun i hi => ha i (mem_filter.mp hi).1)
  have hAB (c : κ) : A c ≤ B c := by
    change (∑ i ∈ S.filter (fun i => key i=c),a i) ≤ _
    calc
      _ ≤ ∑ i ∈ S.filter (fun i => key i=c),b (f i) :=
        sum_le_sum (fun i hi => hab _ (mem_filter.mp hi).1)
      _ = ∑ j ∈ (S.filter (fun i => key i=c)).image f,b j :=
        (sum_image (hinj.mono (fun _ hi => (mem_filter.mp hi).1))).symm
      _ ≤ _ := sum_le_sum_of_subset_of_nonneg (hFiber c) (fun j hj _ => hb j (mem_filter.mp hj).1)
  change (∑ c ∈ S.image key,(A c)^2) ≤ ∑ c ∈ D.image key',(B c)^2
  calc
    _ ≤ ∑ c ∈ S.image key,(B c)^2 :=
      sum_le_sum (fun c _ => pow_le_pow_left₀ (hA0 _) (hAB _) 2)
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hClasses (fun c _ _ => sq_nonneg (B c))

end
end GoldbachSignedPairs

