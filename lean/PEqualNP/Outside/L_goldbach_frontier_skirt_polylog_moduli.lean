    intro z hz
    obtain ⟨hzlo,hzhi⟩ := mem_Icc.mp hz
    rcases le_total 0 z with hpos | hneg
    · apply mem_union_right
      apply mem_image.mpr
      refine ⟨z.toNat, mem_range.mpr (by omega), ?_⟩
      exact Int.toNat_of_nonneg hpos
    · apply mem_union_left
      apply mem_image.mpr
      have he : (((-z).toNat : ℕ) : ℤ) = -z := Int.toNat_of_nonneg (by omega)
      exact ⟨(-z).toNat, mem_range.mpr (by omega), by omega⟩
