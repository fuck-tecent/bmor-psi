    exact le_of_tendsto ((hGa w hwU).continuousAt.norm.continuousWithinAt) hv
  have hlog900 : Real.log 900≤10*Real.log 2 := by
    calc
      _ ≤ Real.log ((2:ℝ)^(10:ℕ)) := Real.log_le_log (by norm_num) (by norm_num)
      _ = _ := by rw [Real.log_pow]; norm_num
  have hBL : Real.log B≤13*logHeight q t := by
    change Real.log (900*(q:ℝ)*K^2) ≤ 13*Real.log (2*(q:ℝ)*K)
    rw [Real.log_mul (by positivity) (pow_ne_zero _ hK0.ne'),
      Real.log_mul (by norm_num) hq0.ne',Real.log_pow,
      Real.log_mul (by positivity) hK0.ne',Real.log_mul (by norm_num) hq0.ne']
    norm_num
    linarith only [hlog900,Real.log_nonneg hq1,Real.log_nonneg hK1,
      Real.log_nonneg (by norm_num : (1:ℝ)≤2)]
  have hL : 0≤logHeight q t := zero_le_one.trans (logHeight_ge_one q t)
  refine ⟨Z,-G,?_,?_,(hGa.mono (fun w hw=>hsubset (hInside w hw))).neg,?_,?_,?_⟩
  · intro ρ hρ
    obtain ⟨hρU,hρ⟩ := (hZU ρ).mp hρ
    refine ⟨hρ,le_of_not_gt (fun h=>regularizedL_ne_zero_right χ h hρ),?_⟩
    have h1 : |ρ.im-t|≤‖ρ-c‖ := by simpa [c,line,Complex.sub_im] using Complex.abs_im_le_norm (ρ-c)
    exact h1.trans ((mem_closedBall_iff_norm.mp hρU).trans (by norm_num [R]))
  · have hc : (∑ p∈Z,(analyticOrderNatAt f p:ℝ))≤D*Real.log B := by
      simpa only [D,div_eq_inv_mul] using hCount
