def sharpWindow (S : Finset ℕ) (c : ℕ → ℂ) (η y : ℝ) : ℂ :=
  ∑ n ∈ S.filter (fun n : ℕ => y < (n:ℝ) ∧ (n:ℝ) ≤ y*(1+η)), c n
