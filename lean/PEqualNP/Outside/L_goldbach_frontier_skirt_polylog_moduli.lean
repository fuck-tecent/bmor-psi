      (ContinuousOn.intervalIntegrable_of_Icc (μ := volume) (by linarith) (hcP.norm.pow 2))
  rw [hid]
  calc
    _ ≤ h^2*(∫ u in X..3*X, ‖f u‖^2) := hm
    _ ≤ h^2*((1/X)^2*(∫ u in X..3*X, ‖P u‖^2)) :=
      mul_le_mul_of_nonneg_left hi (sq_nonneg h)
    _ ≤ h^2*((1/X)^2*(∫ u in X..4*X, ‖P u‖^2)) := by
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left hbig (sq_nonneg _)) (sq_nonneg h)
    _ = _ := by ring
end V1e
end

section
open Finset MeasureTheory
