pipeline {
    agent { label 'goldbach-isolated-site' }
    options {
        skipDefaultCheckout()
        timeout(time: 15, unit: 'MINUTES')
    }
    stages {
        stage('Isolated website verification') {
            steps {
                sh '''
                    python3 - <<'PY'
import os
import re
import socket

sha = os.environ["CI_HEAD"]
if not re.fullmatch(r"[0-9a-f]{40}", sha):
    raise SystemExit("Invalid commit SHA")
with socket.socket(socket.AF_UNIX) as connection:
    connection.settimeout(800)
    connection.connect("/runner/runner.sock")
    connection.sendall((sha + "\\n").encode())
    with connection.makefile("rb") as response:
        status = response.readline(8)
if status != bytes([48, 10]):
    raise SystemExit("Isolated website check failed: " + repr(status))
print("Isolated website check passed for " + sha)
PY
                '''
            }
        }
    }
}
