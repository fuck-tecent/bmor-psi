private theorem integral_right_tail {T : ℝ} (hT : 0 < T) :
    (∫ v : ℝ in Ioi T, (v ^ 2)⁻¹) = T⁻¹ := by
  have h := integral_Ioi_rpow_of_lt (a := -2) (by norm_num) hT
  rw [show (-2 : ℝ) + 1 = -1 by norm_num, Real.rpow_neg_one] at h
  simp only [div_neg, div_one, neg_neg] at h
  rw [← h]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro v hv
  change (v ^ (2 : ℕ))⁻¹ = v ^ (-2 : ℝ)
  rw [Real.rpow_neg (hT.trans (mem_Ioi.mp hv)).le, Real.rpow_two]
