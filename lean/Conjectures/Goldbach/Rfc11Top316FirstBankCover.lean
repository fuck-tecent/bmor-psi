import Mathlib

namespace Rfc11SmallPrime

def trialPrimeProduct : ℕ :=
  256041159035492609053110100510385311995538591998443060216114576417920917800321526504084465112487730

private def trialPrimes : List ℕ :=
  (List.range 246).filter (fun p => decide p.Prime)

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem product_eq : trialPrimes.prod = trialPrimeProduct := by decide +kernel

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem dvd_trial_product {p : ℕ} (hp : p.Prime) (hCap : p ≤ 245) :
    p ∣ trialPrimeProduct := by
  rw [← product_eq]
  exact List.dvd_prod (List.mem_filter.mpr ⟨List.mem_range.mpr (by omega), decide_eq_true hp⟩)

theorem prime_of_coprime {n : ℕ} (hTwo : 2 ≤ n) (hCap : n ≤ 60269)
    (hGcd : n.gcd trialPrimeProduct = 1) : n.Prime := by
  by_contra hNot
  have hMin := Nat.minFac_sq_le_self (by omega : 0 < n) hNot
  have hMinPrime := Nat.minFac_prime (by omega : n ≠ 1)
  have hMinLe : n.minFac ≤ 245 := by
    by_contra! h
    have hLarge := (Nat.pow_le_pow_left (show 246 ≤ n.minFac by omega) 2).trans hMin
    norm_num at hLarge
    omega
  have hDiv := Nat.dvd_gcd (Nat.minFac_dvd n) (dvd_trial_product hMinPrime hMinLe)
  rw [hGcd] at hDiv
  exact hMinPrime.ne_one (Nat.dvd_one.mp hDiv)

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem gcd_one_of_prime {n : ℕ} (hLarge : 245 < n) (hp : n.Prime) :
    n.gcd trialPrimeProduct = 1 := by
  apply hp.coprime_iff_not_dvd.mpr
  rw [← product_eq]
  intro hDiv
  obtain ⟨d, hd, hnd⟩ := hp.prime.dvd_prod_iff.mp hDiv
  obtain ⟨hRange, hPrime⟩ := List.mem_filter.mp hd
  have hLess := List.mem_range.mp hRange
  have he := (Nat.prime_dvd_prime_iff_eq hp (of_decide_eq_true hPrime)).mp hnd
  omega

def check (n : ℕ) : Bool :=
  if n ≤ 245 then decide n.Prime else decide (n.gcd trialPrimeProduct = 1)

theorem check_correct {n : ℕ} (hCap : n ≤ 60269) : check n = true ↔ n.Prime := by
  unfold check
  split
  · simp only [decide_eq_true_eq]
  · rw [decide_eq_true_eq]
    exact ⟨prime_of_coprime (by omega) hCap, gcd_one_of_prime (by omega)⟩


end Rfc11SmallPrime

