/-- Exponentially weighted first moment of the one-sided autocorrelation. -/
def exponentialAutoMoment {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (μ : ℝ) : ℝ :=
  ∫ t : ℝ in Ioi 0,t*exponentialAutoWeight S a b t*Real.exp (μ*t)

private theorem auto_complex_integrable {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (z : ℂ)
    (hb : ∀ i∈S, 0<b i+z.re) :
    IntegrableOn (fun t : ℝ=>(exponentialAutoWeight S a b t:ℂ)*Complex.exp (-z*(t:ℂ))) (Ioi 0) := by
  unfold exponentialAutoWeight exponentialPulse
  simp_rw [Complex.ofReal_sum,Finset.sum_mul]
  refine integrable_finsetSum _ fun i hi => ?_
  have hI := (integrableOn_exp_mul_complex_Ioi
    (a:=-((b i:ℂ)+z)) (by simpa [Complex.add_re] using neg_lt_zero.mpr (hb i hi)) 0).const_mul
      (exponentialAutoCoeff S a b i:ℂ)
  convert hI using 1
  ext t
  push_cast
  rw [mul_assoc,←Complex.exp_add]
  congr 2
  ring

theorem auto_moment_integrable {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (μ : ℝ)
    (hb : ∀ i∈S, μ<b i) :
    IntegrableOn (fun t : ℝ=>t*exponentialAutoWeight S a b t*Real.exp (μ*t)) (Ioi 0) := by
  unfold exponentialAutoWeight exponentialPulse
  simp_rw [Finset.mul_sum,Finset.sum_mul]
  refine integrable_finsetSum _ fun i hi => ?_
  have hI := (integrableOn_rpow_mul_exp_neg_mul_rpow (s:=1) (p:=1) (b:=b i-μ)
    (by norm_num) (by norm_num) (sub_pos.mpr (hb i hi))).const_mul (exponentialAutoCoeff S a b i)
  convert hI using 1
  ext t
  simp only [Real.rpow_one]
  rw [show t*(exponentialAutoCoeff S a b i*Real.exp (-b i*t))*Real.exp (μ*t)=
    exponentialAutoCoeff S a b i*(t*(Real.exp (-b i*t)*Real.exp (μ*t))) by ring,←Real.exp_add]
  congr 3
  ring

set_option maxHeartbeats 1100000 in
/-- The pole deficit is bounded uniformly in height by the first moment
when the time weight is nonnegative. -/
theorem exponentialAutoTransform_defect_le {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S, 0<b i) (ha : ∀ t≥0, 0≤exponentialPulse S a b t)
    {z : ℂ} (hz : ∀ i∈S, 0<b i+z.re) {d : ℝ} (hd : 0≤d) :
    (exponentialAutoTransform S a b z - exponentialAutoTransform S a b (z+(d:ℂ))).re≤
      d*exponentialAutoMoment S a b (-z.re) := by
  let f (t : ℝ) := exponentialAutoWeight S a b t
  let G (t : ℝ) : ℂ := (f t:ℂ)*Complex.exp (-z*(t:ℂ))
  let W (t : ℝ) : ℂ := (f t:ℂ)*Complex.exp (-(z+(d:ℂ))*(t:ℂ))
  have hzz (i : ι) (hi : i∈S) : 0<b i+(z+(d:ℂ)).re := by
    rw [Complex.add_re,Complex.ofReal_re]
    linarith only [hz i hi,hd]
  have hG : IntegrableOn G (Ioi 0) := auto_complex_integrable S a b z hz
  have hW : IntegrableOn W (Ioi 0) := auto_complex_integrable S a b (z+(d:ℂ)) hzz
  have hSub : IntegrableOn (fun t=>G t-W t) (Ioi 0) := hG.sub hW
  have hRight : IntegrableOn (fun t : ℝ=> d*(t*f t*Real.exp (-z.re*t))) (Ioi 0) :=
    (auto_moment_integrable S a b (-z.re) (fun i hi=>by linarith only [hz i hi])).const_mul d
  have hPoint (t : ℝ) (ht : t∈Ioi (0:ℝ)) :
      ‖G t-W t‖≤d*(t*f t*Real.exp (-z.re*t)) := by
    have ht0 : 0≤t := (mem_Ioi.mp ht).le
    have hf : 0≤f t := exponentialAutoWeight_nonneg S a b hb ha ht0
    have htD := mul_nonneg hd ht0
    have hOne : 0≤1-Real.exp (-d*t) :=
      sub_nonneg.mpr (Real.exp_le_one_iff.mpr (by nlinarith only [htD]))
    have hh : 1-Real.exp (-d*t)≤d*t := by
      have h := Real.add_one_le_exp (-d*t)
      nlinarith only [h]
    have hFact : G t-W t=G t*((1:ℂ)-(Real.exp (-d*t):ℂ)) := by
      unfold G W
      rw [show -(z+(d:ℂ))*(t:ℂ)=-z*(t:ℂ)+(((-d*t:ℝ):ℂ)) by push_cast; ring,
        Complex.exp_add,←Complex.ofReal_exp]
      ring
    have hNorm : ‖G t‖=f t*Real.exp (-z.re*t) := by
      unfold G
      rw [norm_mul,Complex.norm_exp,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hf]
      congr 2
      simp [Complex.mul_re,Complex.neg_re]
    rw [hFact,norm_mul,hNorm,←Complex.ofReal_one,←Complex.ofReal_sub,Complex.norm_real,
      Real.norm_eq_abs,abs_of_nonneg hOne]
    have hProd := mul_le_mul_of_nonneg_left hh (by positivity : 0≤f t*Real.exp (-z.re*t))
    exact hProd.trans_eq (by ring)
  rw [exponentialAutoTransform_eq_integral S a b z hz,
    exponentialAutoTransform_eq_integral S a b (z+(d:ℂ)) hzz]
  change ((∫ t in Ioi 0,G t)-(∫ t in Ioi 0,W t)).re≤_
  rw [←integral_sub hG hW]
  calc
    _ ≤ ‖∫ t in Ioi 0,G t-W t‖ := Complex.re_le_norm _
    _ ≤ ∫ t in Ioi 0,‖G t-W t‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ t in Ioi 0,d*(t*f t*Real.exp (-z.re*t)) := by
      apply integral_mono_ae hSub.norm hRight
      change ∀ᵐ t : ℝ ∂volume.restrict (Ioi (0:ℝ)), ‖G t-W t‖≤d*(t*f t*Real.exp (-z.re*t))
      rw [ae_restrict_iff' measurableSet_Ioi]
      exact Filter.Eventually.of_forall hPoint
    _ = _ := by rw [integral_const_mul]; rfl

end

end GoldbachPintzNumerics
end

