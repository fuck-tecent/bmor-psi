    Vse χ (Nat.prime_of_mem_primeFactors hp) s hs)).trans
  exact V1k4 _ hN (fun _ hp => Nat.prime_of_mem_primeFactors hp)
    (fun _ hp => Nat.dvd_of_mem_primeFactors hp)
