namespace GoldbachZeroFree

open Complex Goldbach GoldbachGrhGrowth Set Metric MeasureTheory
open scoped Classical ComplexConjugate BigOperators

theorem regularizedL_ne_zero_ge_one {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {s : ℂ} (hs : 1 ≤ s.re) : regularizedL χ s ≠ 0 := by
  by_cases hs1 : s=1
  · subst s
    exact regularizedL_ne_zero_at_one χ
  have hL := χ.LFunction_ne_zero_of_one_le_re (Or.inr hs1) hs
  by_cases hχ : χ=1
  · subst χ
    simpa only [regularizedL,ite_true,DirichletCharacter.LFunctionTrivChar₁,
      Function.update_of_ne hs1] using mul_ne_zero (sub_ne_zero.mpr hs1) hL
  · simpa only [regularizedL,hχ,ite_false] using hL

theorem principal_compact_zero_free : ∃ b : ℝ, 0 < b ∧
    ∀ z : ℂ, 1-b < z.re → |z.im| ≤ 1 →
      regularizedL (1:DirichletCharacter ℂ 1) z ≠ 0 := by
  let K := (fun t : ℝ => (⟨1,t⟩:ℂ)) '' Icc (-1) 1
  let U := {z : ℂ | regularizedL (1:DirichletCharacter ℂ 1) z ≠ 0}
  have hf : Continuous (fun t : ℝ => (⟨1,t⟩:ℂ)) := by
    have he : (fun t : ℝ => (⟨1,t⟩:ℂ)) = fun t : ℝ => (1:ℂ)+(t:ℂ)*I := by
      funext t
      apply Complex.ext <;> simp [Complex.mul_re,Complex.mul_im]
    rw [he]
    exact continuous_const.add (Complex.continuous_ofReal.mul continuous_const)
  have hK : IsCompact K := isCompact_Icc.image hf
  have hU : IsOpen U := by
    apply isOpen_ne_fun _ continuous_const
    apply continuous_iff_continuousAt.mpr
    intro s
    exact (analytic_regularizedL (1:DirichletCharacter ℂ 1) s (mem_univ _)).continuousAt
  have hKU : K ⊆ U := by
    rintro _ ⟨t,_,rfl⟩
    exact regularizedL_ne_zero_ge_one _ (by norm_num : (1:ℝ) ≤ 1)
  obtain ⟨b,hb,hBU⟩ := hK.exists_thickening_subset_open hU hKU
  refine ⟨b,hb,?_⟩
  intro z hz ht
  by_cases hre : (1:ℝ) ≤ z.re
  · exact regularizedL_ne_zero_ge_one _ hre
  apply hBU
  refine mem_thickening_iff.mpr ⟨(⟨1,z.im⟩:ℂ),⟨z.im,abs_le.mp ht,rfl⟩,?_⟩
  rw [dist_eq_norm,show z-(⟨1,z.im⟩:ℂ)=((z.re-1:ℝ):ℂ) by
      apply Complex.ext <;> simp,
    Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (sub_nonpos.mpr (le_of_not_ge hre))]
  linarith only [hz]

theorem logHeight_zero_le {q : ℕ} [NeZero q] (t : ℝ) : logHeight q 0 ≤ logHeight q t := by
  unfold logHeight
  have hq0 : (0:ℝ) < q := by exact_mod_cast NeZero.pos q
  apply Real.log_le_log (by positivity)
  simp only [abs_zero,add_zero]
  exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (abs_nonneg t)) (by positivity)

theorem logHeight_two_mul_le {q : ℕ} [NeZero q] (t : ℝ) :
    logHeight q (2*t) ≤ 2*logHeight q t := by
  have hq : (1:ℝ) ≤ q := by exact_mod_cast NeZero.pos q
  have hq0 : (0:ℝ) < q := zero_lt_one.trans_le hq
  unfold logHeight
  rw [abs_mul,abs_of_pos (by norm_num : (0:ℝ)<2),show (2:ℝ)*Real.log (2*(q:ℝ)*(2+|t|)) =
    Real.log ((2*(q:ℝ)*(2+|t|))^2) by rw [Real.log_pow]; norm_num]
  apply Real.log_le_log (by positivity)
  have hh := abs_nonneg t
  calc
    _ ≤ 2*(2*(q:ℝ)*(2+|t|)) := by nlinarith only [mul_nonneg hq0.le hh,hq0]
    _ ≤ (2*(q:ℝ)*(2+|t|))^2 := by
      have hb : (2:ℝ) ≤ 2*(q:ℝ)*(2+|t|) := by nlinarith only [hq,hh,mul_nonneg hq0.le hh]
      exact (mul_le_mul_of_nonneg_right hb (by positivity)).trans_eq (by ring)

/-- A logarithmic gap excludes the near-one window throughout the
corresponding conductor-height range. -/
theorem log_gap_of_height_le {c K X H β : ℝ}
    (hK : 0<K) (hX : 0<Real.log X) (hXX : 0<Real.log (Real.log X))
    (hH : 0<H) (hscale : H ≤ c*Real.log X/(K*Real.log (Real.log X)))
    (hgap : c/H ≤ 1-β) : K*Real.log (Real.log X)/Real.log X ≤ 1-β := by
  have h₀ := (le_div_iff₀ (mul_pos hK hXX)).mp hscale
  exact (div_le_div_iff₀ hX hH).mpr (by nlinarith only [h₀]) |>.trans hgap

end GoldbachZeroFree

