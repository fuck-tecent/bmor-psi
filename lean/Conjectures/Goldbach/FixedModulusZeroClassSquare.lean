theorem runner_up_gap_of_endpoints {a a₁ μ c b K : ℝ}
    (ha : 0≤a) (ha₁ : a≤a₁) (hb : 0<b) (hbc : 0<b-c)
    (hEdges : realRationalZeroKernel b (-c)-realRationalZeroKernel b (a₁-c)+K <
      realRationalZeroKernel b 0)
    (hRun : realRationalZeroKernel b 0≤
      realRationalZeroKernel b (-μ)-realRationalZeroKernel b (a-μ)+K) :
    c<μ := by
  by_contra! h
  have hKer : realRationalZeroKernel b (a₁-μ)≤realRationalZeroKernel b (a-μ) :=
    realRationalZeroKernel_antitone hb (by linarith only [ha,hbc,h]) (by linarith only [ha₁])
  have hInc := rational_kernel_increment_antitone (b:=b) (x:=-c) (y:=-μ) (m:=a₁)
    hb (by linarith only [hbc]) (neg_le_neg h) (ha.trans ha₁)
  rw [show -μ+a₁=a₁-μ by ring,show -c+a₁=a₁-c by ring] at hInc
  linarith only [hKer,hInc,hEdges,hRun]


theorem moderate_real_class_squares_le {ι : Type*} (S : Finset ι) (j : ι) (B : ι→ℝ)
    {a a₀ C D D₀ θ : ℝ} (ha : a₀≤a)
    (hB : ∀ i∈S, 0≤B i ∧ B i≤D)
    (hD : 0≤D) (hD₀ : 0≤D₀)
    (hB₀ : j∈S → B j≤D₀) (hC : (∑ i∈S,B i)≤C)
    (hNumbers : (Real.exp (-4.93*a₀))^2+2*Real.exp (-4.93*a₀)*D₀+D*C≤θ) :
    (∑ i∈S,((if i=j then Real.exp (-4.93*a) else 0)+B i)^2)≤θ := by
  let w := Real.exp (-4.93*a)
  let w₀ := Real.exp (-4.93*a₀)
  have hw : 0≤w := Real.exp_nonneg _
  have hw₀ : 0≤w₀ := Real.exp_nonneg _
  have hwle : w≤w₀ := Real.exp_le_exp.mpr (mul_le_mul_of_nonpos_left ha (by norm_num))
  have hT : (∑ i∈S,(B i)^2)≤D*C := by
    calc
      _ ≤ ∑ i∈S,D*B i := sum_le_sum (fun i hi => by
        rw [pow_two]; exact mul_le_mul_of_nonneg_right (hB i hi).2 (hB i hi).1)
      _ ≤ _ := by rw [←mul_sum]; exact mul_le_mul_of_nonneg_left hC hD
  change (∑ i∈S,((if i=j then w else 0)+B i)^2)≤_
  have he (i : ι) : ((if i=j then w else 0)+B i)^2 =
      (if i=j then w^2+2*w*B j else 0)+(B i)^2 := by
    by_cases h : i=j
    · subst i
      rw [ite_eq_left rfl,ite_eq_left rfl]
      ring
    · rw [ite_eq_right h,ite_eq_right h,zero_add,zero_add]
  simp only [he,sum_add_distrib,sum_ite_eq']
  have h₀ : (if j∈S then w^2+2*w*B j else 0) ≤ w₀^2+2*w₀*D₀ := by
    by_cases h : j∈S
    · rw [ite_eq_left h]
      exact add_le_add (pow_le_pow_left₀ hw hwle 2)
        (mul_le_mul (mul_le_mul_of_nonneg_left hwle (by norm_num)) (hB₀ h)
          (hB j h).1 (by positivity))
    · rw [ite_eq_right h]
      positivity
  exact (add_le_add h₀ hT).trans hNumbers


end GoldbachPintzNumerics
