section
namespace GoldbachSignedPairs

open Filter GoldbachPintzNumerics
open scoped Topology

noncomputable section

def densityPhi : ℝ := 47/125

def densityOffDiagonal (same : Bool) (η : ℝ) : ℝ :=
  if same then η else densityPhi

def densityStart (same : Bool) (w η : ℝ) : ℝ :=
  densityOffDiagonal same η+2*w+η

def densitySpan (w c η : ℝ) : ℝ :=
  densityPhi+w+c+η

def densityRemaining (same : Bool) (w c k η : ℝ) : ℝ :=
  4.93-2*(densityStart same w η+densitySpan w c η+k)

def densityIdeal (same : Bool) (w c k h η : ℝ) : ℝ :=
  let r := densitySpan w c η
  ((2*r-c)/(2*c))*(1/(w*k))*Real.sqrt (densityMomentScalar densityPhi k h)*
    Real.sqrt (densityMomentScalar densityPhi r h)*
    Real.exp (-densityRemaining same w c k η*h)

private theorem densityMomentScalar_nonneg {φ k y : ℝ} (hφ : 0≤φ) (hk : 0≤k) (hy : 0<y) :
    0≤densityMomentScalar φ k y := by
  have hh : 0≤1-Real.exp (-2*k*y) := sub_nonneg.mpr (Real.exp_le_one_iff.mpr (by
    exact mul_nonpos_of_nonpos_of_nonneg (by nlinarith only [hk]) hy.le))
  exact add_nonneg (mul_nonneg (div_nonneg hφ (by norm_num)) (div_nonneg hh hy.le)) (sq_nonneg _)

set_option maxHeartbeats 1100000 in
/-- Choose positive margins in the detector and Gram contours, preserving
a strict numerical estimate at their limiting parameters. -/
theorem exists_census_density_parameters (same : Bool) {w c k h b σ₀ : ℝ}
    (hw : 0<w) (hc : 0<c) (hk : 0<k) (hh : 0<h)
    (hσ : σ₀<densityRemaining same w c k 0)
    (hB : rawDensity376 (if same then 1 else 2) w c k h < b) :
    ∃ η : ℝ, 0<η ∧ σ₀<densityRemaining same w c k η ∧
      densityIdeal same w c k h η<b := by
  let r := (47:ℝ)/125+w+c
  have hr : densitySpan w c 0=r := by simp [r,densitySpan,densityPhi]
  have hφ : 0≤densityPhi := by norm_num [densityPhi]
  have hR : 0≤r := by unfold r; positivity
  have hC : densityIdeal same w c k h 0≤rawDensity376 (if same then 1 else 2) w c k h := by
    unfold densityIdeal rawDensity376
    dsimp only
    have hExp : densityRemaining same w c k 0=
        493/100-2*((if same then 1 else 2)*densityPhi+3*w+c+k) := by
      cases same <;> simp [densityRemaining,densityStart,densityOffDiagonal,densitySpan] <;> ring
    rw [hExp,hr]
    change ((2*r-c)/(2*c))*(1/(w*k))*Real.sqrt (densityMomentScalar densityPhi k h)*
      Real.sqrt (densityMomentScalar densityPhi r h)*Real.exp (-(493/100-
        2*((if same then 1 else 2)*densityPhi+3*w+c+k))*h)≤_
    have hA : 0≤densityMomentScalar densityPhi k h := densityMomentScalar_nonneg hφ hk.le hh
    have hSq : Real.sqrt (densityMomentScalar densityPhi k h)*
        Real.sqrt (densityMomentScalar densityPhi r h)=
        Real.sqrt (densityMomentScalar densityPhi k h*densityMomentScalar densityPhi r h) :=
      (Real.sqrt_mul hA _).symm
    have hCoeff : (2*r-c)/(2*c)*(1/(w*k)) ≤ r/(w*c)/k := by
      have hE : (2*r-c)/(2*c)*(1/(w*k))=r/(w*c)/k-1/(2*w*k) := by
        field_simp [hw.ne',hc.ne',hk.ne']
      rw [hE]
      exact sub_le_self _ (by positivity)
    rw [mul_assoc (((2*r-c)/(2*c))*(1/(w*k))),hSq]
    have hRearr : (r/(w*c))*Real.sqrt (densityMomentScalar densityPhi k h*
        densityMomentScalar densityPhi r h)/k=(r/(w*c)/k)*
        Real.sqrt (densityMomentScalar densityPhi k h*densityMomentScalar densityPhi r h) := by ring
    change _≤ (r/(w*c))*Real.sqrt (densityMomentScalar densityPhi k h*
      densityMomentScalar densityPhi r h)/k*_
    rw [hRearr]
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hCoeff (Real.sqrt_nonneg _)) (by positivity)
  have hcR : Continuous (densityRemaining same w c k) := by
    cases same <;> unfold densityRemaining densityStart densityOffDiagonal densitySpan <;>
      simp only [Bool.false_eq_true,ite_false,ite_true] <;> fun_prop
  have hcI : Continuous (densityIdeal same w c k h) := by
    cases same <;> unfold densityIdeal densityRemaining densityStart densityOffDiagonal densitySpan
      densityMomentScalar <;> simp only [Bool.false_eq_true,ite_false,ite_true] <;> fun_prop
  have h0 : densityIdeal same w c k h 0<b := hC.trans_lt hB
  have hTC : Tendsto (densityIdeal same w c k h) (𝓝 0)
      (𝓝 (densityIdeal same w c k h 0)) := hcI.continuousAt
  have hTR : Tendsto (densityRemaining same w c k) (𝓝 0)
      (𝓝 (densityRemaining same w c k 0)) := hcR.continuousAt
  have he : ∀ᶠ η : ℝ in 𝓝 0,
      σ₀<densityRemaining same w c k η ∧ densityIdeal same w c k h η<b :=
    (hTR.eventually (Ioi_mem_nhds hσ)).and (hTC.eventually (Iio_mem_nhds h0))
  obtain ⟨ε,hε,hεB⟩ := Metric.eventually_nhds_iff.mp he
  have hD : dist (ε/2) 0<ε := by rw [Real.dist_eq,sub_zero,abs_of_pos (by positivity)]; linarith only [hε]
  exact ⟨ε/2,by positivity,(hεB hD).1,(hεB hD).2⟩

end
end GoldbachSignedPairs
end

section
namespace GoldbachPintzWeightedGram

open Finset
open scoped Classical

noncomputable section

/-- Multiplicities and the normalized same-character row weights. -/
def rowWeight {ι : Type*} (S : Finset ι) (m : ι → ℕ) (a : ι → ι → ℝ) (i : ι) : ℝ :=
  ∑ j ∈ S, (m j:ℝ)*a i j

def weightedCount {ι : Type*} (S : Finset ι) (m : ι → ℕ) (a : ι → ι → ℝ) : ℝ :=
  ∑ i ∈ S, (m i:ℝ)*rowWeight S m a i

def ordinaryCount {ι : Type*} (S : Finset ι) (m : ι → ℕ) : ℝ :=
  ∑ i ∈ S, (m i:ℝ)

def excess {ι : Type*} (S : Finset ι) (m : ι → ℕ) (ψ : ι → ℝ) (ψ₀ : ℝ) : ℝ :=
  ∑ i ∈ S, (m i:ℝ)*(ψ i-ψ₀)

private theorem off_diagonal_sum_le {ι : Type*} (S : Finset ι) (v : ι → ℝ)
    (hv : ∀ i∈S, 1≤v i) :
    (∑ i∈S,∑ j∈S, if i=j then 0 else v i*v j) ≤
      (∑ i∈S,v i)^2-(∑ i∈S,v i) := by
  classical
  let H := ∑ i∈S,v i
  have hRow (i : ι) (hi : i∈S) :
      (∑ j∈S, if i=j then 0 else v i*v j)=v i*H-(v i)^2 := by
    rw [←sum_erase_add S _ hi,show (if i=i then (0:ℝ) else v i*v i)=0 by simp,add_zero]
    calc
      _ = ∑ j∈S.erase i,v i*v j := by
        apply sum_congr rfl
        intro j hj
        simp only [ite_eq_right (Ne.symm (mem_erase.mp hj).1)]
      _ = v i*(H-v i) := by
        rw [←mul_sum,←eq_sub_iff_add_eq.mpr (sum_erase_add S v hi)]
      _ = _ := by ring
  calc
    _ = ∑ i∈S,(v i*H-(v i)^2) := sum_congr rfl fun i hi=>hRow i hi
    _ ≤ _ := by
      change (∑ i∈S,(v i*H-(v i)^2))≤H^2-H
      rw [sum_sub_distrib,←sum_mul,←pow_two]
      apply sub_le_sub_left
      apply sum_le_sum
      intro i hi
      have hv₀ := zero_le_one.trans (hv i hi)
      simpa only [one_mul,pow_two] using mul_le_mul_of_nonneg_right (hv i hi) hv₀

private theorem reorder_weighted_rows {ι : Type*} (S : Finset ι) (m : ι → ℕ)
    (a : ι → ι → ℝ) (ψ : ι → ℝ) :
    (∑ j∈S,(m j:ℝ)*∑ i∈S,(m i:ℝ)*a i j*ψ i) =
      ∑ i∈S,(m i:ℝ)*rowWeight S m a i*ψ i := by
  calc
    _ = ∑ j∈S,∑ i∈S,(m j:ℝ)*((m i:ℝ)*a i j*ψ i) := by simp only [mul_sum]
    _ = ∑ i∈S,∑ j∈S,(m j:ℝ)*((m i:ℝ)*a i j*ψ i) := sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro i _
      simp only [rowWeight,mul_sum,sum_mul]
      exact sum_congr rfl (fun _ _ => by ring)

set_option maxHeartbeats 1100000 in
/-- Weighted form of Pintz II (7.20)–(8.2). Near pairs enter the
same-character weights; an error bounded for every pair is quadratic in the
weighted count and requires no prior bound on its size. -/
theorem cauchy_to_weighted_gram {ι : Type*} (S : Finset ι) (m : ι → ℕ)
    (a gram : ι → ι → ℝ) (same : ι → ι → Prop) (u ψ : ι → ℝ)
    {ψ₀ ξrow ξpair δ P : ℝ}
    (hm : ∀ i∈S, 1 ≤ m i)
    (ha : ∀ i∈S,∀ j∈S, 0≤a i j)
    (hd : ∀ i∈S, 1≤a i i) (hSame : ∀ i, same i i)
    (hψ : ∀ i∈S, ψ₀≤ψ i)
    (hξrow : 0≤ξrow) (hξpair : 0≤ξpair) (hδ : 0≤δ) (hGap : ξrow≤ψ₀)
    (_hP : 0≤P) (hPcap : P≤1+δ)
    (hRow : ∀ j∈S,(∑ i∈S,(m i:ℝ)*a i j*ψ i)-ξrow≤u j)
    (hGram : ∀ i∈S,∀ j∈S, gram i j≤a i j+(if same i j then 0 else ξpair)+δ)
    (hGnonneg : 0≤∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*gram i j)
    (hCauchy : (∑ i∈S,(m i:ℝ)*u i)^2≤P*(∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*gram i j)) :
    let H := weightedCount S m a
    let N := ordinaryCount S m
    let D := excess S m ψ ψ₀
    N≤H ∧ 0≤D ∧
      (H*(ψ₀-ξrow)+D)^2≤H+ξpair*(H^2-H)+δ*(2+ξpair+δ)*H^2 := by
  classical
  dsimp only
  let A := rowWeight S m a
  let v (i : ι) := (m i:ℝ)*A i
  let H := weightedCount S m a
  let N := ordinaryCount S m
  let D := excess S m ψ ψ₀
  let G := ∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*gram i j
  have hm₀ (i : ι) : 0≤(m i:ℝ) := Nat.cast_nonneg _
  have hm₁ (i : ι) (hi : i∈S) : 1≤(m i:ℝ) := by exact_mod_cast hm i hi
  have hA (i : ι) (hi : i∈S) : 1≤A i := by
    apply (one_le_mul_of_one_le_of_one_le (hm₁ i hi) (hd i hi)).trans
    exact single_le_sum (fun j hj=>mul_nonneg (hm₀ j) (ha i hi j hj)) hi
  have hv (i : ι) (hi : i∈S) : 1≤v i := one_le_mul_of_one_le_of_one_le (hm₁ i hi) (hA i hi)
  have hmv (i : ι) (hi : i∈S) : (m i:ℝ)≤v i := le_mul_of_one_le_right (hm₀ i) (hA i hi)
  have hHN : N≤H := sum_le_sum hmv
  have hN : 0≤N := sum_nonneg (fun i _=>hm₀ i)
  have hH : 0≤H := hN.trans hHN
  have hD : 0≤D := sum_nonneg (fun i hi=>mul_nonneg (hm₀ i) (sub_nonneg.mpr (hψ i hi)))
  have hHsq : H≤H^2 := by
    by_cases hS : S.Nonempty
    · obtain ⟨i,hi⟩ := hS
      have h₁ : 1≤H := (hv i hi).trans (single_le_sum (fun j hj=>zero_le_one.trans (hv j hj)) hi)
      simpa only [pow_two,one_mul] using mul_le_mul_of_nonneg_right h₁ hH
    · simp [H,weightedCount,not_nonempty_iff_eq_empty.mp hS]
  have hR0 : 0≤H*(ψ₀-ξrow)+D := add_nonneg (mul_nonneg hH (sub_nonneg.mpr hGap)) hD
  have hRi : (∑ j∈S,(m j:ℝ)*((∑ i∈S,(m i:ℝ)*a i j*ψ i)-ξrow)) ≤
      ∑ j∈S,(m j:ℝ)*u j :=
    sum_le_sum (fun j hj=>mul_le_mul_of_nonneg_left (hRow j hj) (hm₀ j))
  have hD' : D≤∑ i∈S,(m i:ℝ)*A i*(ψ i-ψ₀) := by
    apply sum_le_sum
    intro i hi
    exact mul_le_mul_of_nonneg_right (hmv i hi) (sub_nonneg.mpr (hψ i hi))
  have hSplit : (∑ i∈S,(m i:ℝ)*A i*ψ i) =
      H*ψ₀+∑ i∈S,(m i:ℝ)*A i*(ψ i-ψ₀) := by
    change _ = (∑ i∈S,v i)*ψ₀+_
    rw [sum_mul,←sum_add_distrib]
    exact sum_congr rfl (fun i _=>by dsimp only [v]; ring)
  have hR : H*(ψ₀-ξrow)+D≤∑ j∈S,(m j:ℝ)*u j := by
    simp only [mul_sub,sum_sub_distrib,reorder_weighted_rows,←sum_mul] at hRi
    change (∑ i∈S,(m i:ℝ)*A i*ψ i)-N*ξrow ≤ _ at hRi
    rw [hSplit] at hRi
    have hcost := mul_le_mul_of_nonneg_right hHN hξrow
    linarith only [hRi,hD',hcost]
  have hOff :
      (∑ i∈S,∑ j∈S, if same i j then 0 else (m i:ℝ)*(m j:ℝ))≤H^2-H := by
    refine (sum_le_sum (fun i hi=>sum_le_sum (fun j hj=>?_))).trans (off_diagonal_sum_le S v hv)
    split
    · split
      · exact le_rfl
      · exact mul_nonneg (zero_le_one.trans (hv i hi)) (zero_le_one.trans (hv j hj))
    · rename_i hne
      have hn : i≠j := fun h=>hne (h ▸ hSame i)
      rw [ite_eq_right hn]
      exact mul_le_mul (hmv i hi) (hmv j hj) (hm₀ j) (zero_le_one.trans (hv i hi))
  have hNSq : N^2≤H^2 := pow_le_pow_left₀ hN hHN _
  have hG : G≤H+ξpair*(H^2-H)+δ*H^2 := by
    let W := ∑ i∈S,∑ j∈S, if same i j then 0 else (m i:ℝ)*(m j:ℝ)
    have hG' : G≤∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*(a i j+(if same i j then 0 else ξpair)+δ) :=
      sum_le_sum (fun i hi=>sum_le_sum (fun j hj=>
        mul_le_mul_of_nonneg_left (hGram i hi j hj) (mul_nonneg (hm₀ i) (hm₀ j))))
    refine hG'.trans ?_
    have hTerm (i j : ι) : (m i:ℝ)*(m j:ℝ)*(a i j+(if same i j then 0 else ξpair)+δ) =
        ((m i:ℝ)*(m j:ℝ)*a i j)+ξpair*(if same i j then 0 else (m i:ℝ)*(m j:ℝ))+
          δ*((m i:ℝ)*(m j:ℝ)) := by split <;> ring
    simp_rw [hTerm]
    simp only [sum_add_distrib,←mul_sum]
    have hSumA : (∑ i∈S,∑ j∈S,(m i:ℝ)*(m j:ℝ)*a i j)=H := by
      unfold H weightedCount rowWeight
      apply sum_congr rfl
      intro i _
      rw [mul_sum]
      exact sum_congr rfl (fun j _=>mul_assoc _ _ _)
    rw [hSumA,←sum_mul]
    change H+ξpair*W+δ*(N*N) ≤ _
    rw [←pow_two]
    exact add_le_add (add_le_add_right (mul_le_mul_of_nonneg_left hOff hξpair) _) (mul_le_mul_of_nonneg_left hNSq hδ)
  have hPow := pow_le_pow_left₀ hR0 hR 2
  refine ⟨hHN,hD,hPow.trans (hCauchy.trans ?_)⟩
  have hGE := mul_le_mul hPcap hG hGnonneg (by positivity : 0≤1+δ)
  refine hGE.trans ?_
  have e₁ := mul_le_mul_of_nonneg_left hHsq hδ
  have e₂ := mul_nonneg (mul_nonneg hδ hξpair) hH
  nlinarith only [e₁,e₂]

/-- Scalar consequences of the weighted Gram inequality, retaining the
full square of the excess as in Pintz II (8.2). -/
theorem gram_count_and_excess {N H D Δ ξ ε : ℝ}
    (hN : 0≤N) (hNH : N≤H) (hD : 0≤D)
    (hΔ : 0<Δ) (hξ : ξ≤1) (hε : ξ+ε<Δ^2)
    (hGram : (H*Δ+D)^2≤H+ξ*(H^2-H)+ε*H^2) :
    N≤(1-ξ)/(Δ^2-ξ-ε) ∧
      D≤(1-ξ)/(2*(Δ+Real.sqrt (Δ^2-ξ-ε))) := by
  let x := Δ^2-ξ-ε
  let t := Real.sqrt x
  have hx : 0<x := by unfold x; linarith only [hε]
  have ht : 0≤t := Real.sqrt_nonneg _
  have htSq : t^2=x := Real.sq_sqrt hx.le
  have hH := hN.trans hNH
  have hξ₀ := sub_nonneg.mpr hξ
  by_cases he : H=0
  · have hN₀ : N=0 := le_antisymm (he ▸ hNH) hN
    have hD₀ : D=0 := by rw [he] at hGram; nlinarith only [hGram,hD]
    rw [hN₀,hD₀]
    exact ⟨div_nonneg hξ₀ hx.le, div_nonneg hξ₀ (by positivity)⟩
  · have hH₀ : 0<H := lt_of_le_of_ne hH (Ne.symm he)
    have hScale : x*H^2≤(1-ξ)*H := by
      unfold x
      nlinarith only [hGram,mul_nonneg (mul_nonneg hH hΔ.le) hD,sq_nonneg D]
    have hCnt : H≤(1-ξ)/x := (le_div_iff₀ hx).mpr (by
      by_contra! h
      nlinarith only [hScale,mul_pos (sub_pos.mpr h) hH₀])
    have hOrig : (t*H)^2=x*H^2 := by rw [mul_pow,htSq]
    have hE : (2*(Δ+t)*D)*H≤(1-ξ)*H := by
      have h0 := sq_nonneg (D-t*H)
      unfold x at hOrig
      nlinarith only [hGram,hOrig,h0]
    have hEx : 2*(Δ+t)*D≤1-ξ := by
      by_contra! h
      nlinarith only [hE,mul_pos (sub_pos.mpr h) hH₀]
    exact ⟨hNH.trans hCnt,(le_div_iff₀ (by positivity : 0<2*(Δ+t))).mpr (by linarith only [hEx])⟩

end
end GoldbachPintzWeightedGram
end

section
namespace GoldbachPintzWeightedGram

open Filter
open scoped Topology

/-- Choose a positive analytic error and a positive increment of the pair
exponent while keeping strict margins in the ideal count and excess bounds. -/
theorem exists_gram_slack {F Δ ξ count J : ℝ}
    (_hF : 0<F) (hΔ : 0<Δ) (hΔ₁ : Δ≤1) (_hξ : 0≤ξ) (hGap : ξ<Δ^2)
    (hCount : (1-ξ)/(Δ^2-ξ)<count) (hJ : F*(1-ξ)/(2*Δ)<J) :
    ∃ δ : ℝ, 0<δ ∧
      let ξ' := ξ+δ/(2*F)
      let e := δ*(2+ξ'+δ)
      let d := Δ-δ
      0<d ∧ ξ'≤1 ∧ ξ'+e<d^2 ∧
        (1-ξ')/(d^2-ξ'-e)<count ∧ F*(1-ξ')/(2*d)<J := by
  let X (x : ℝ) := ξ+x/(2*F)
  let E (x : ℝ) := x*(2+X x+x)
  let G (x : ℝ) := Δ-x
  let V (x : ℝ) := (G x)^2-X x-E x
  let N (x : ℝ) := (1-X x)/V x
  let W (x : ℝ) := F*(1-X x)/(2*G x)
  have hξ₁ : ξ<1 := hGap.trans_le (by
    simpa only [one_pow] using pow_le_pow_left₀ hΔ.le hΔ₁ 2)
  have hX : Continuous X := by unfold X; fun_prop
  have hG : Continuous G := by unfold G; fun_prop
  have hV : Continuous V := by unfold V E G X; fun_prop
  have hV₀ : 0<V 0 := by simpa [V,G,X,E] using sub_pos.mpr hGap
  have hG₀ : 0<G 0 := by simpa [G] using hΔ
  have hX₀ : X 0<1 := by simpa [X] using hξ₁
  have hN : ContinuousAt N 0 := by
    change ContinuousAt (fun x=>(1-X x)/V x) 0
    exact (continuous_const.sub hX).continuousAt.div hV.continuousAt hV₀.ne'
  have hW : ContinuousAt W 0 := by
    change ContinuousAt (fun x=>F*(1-X x)/(2*G x)) 0
    exact (continuous_const.mul (continuous_const.sub hX)).continuousAt.div
      (continuous_const.mul hG).continuousAt (mul_ne_zero (by norm_num) hG₀.ne')
  have hN₀ : N 0<count := by simpa [N,V,G,X,E] using hCount
  have hW₀ : W 0<J := by simpa [W,G,X] using hJ
  have hNear : ∀ᶠ x : ℝ in 𝓝 0, 0<G x ∧ X x<1 ∧ 0<V x ∧ N x<count ∧ W x<J := by
    have hgn : ∀ᶠ x : ℝ in 𝓝 0, 0<G x :=
      tendsto_const_nhds.eventually_lt hG.continuousAt hG₀
    have hxn : ∀ᶠ x : ℝ in 𝓝 0, X x<1 :=
      hX.continuousAt.eventually_lt tendsto_const_nhds hX₀
    have hvn : ∀ᶠ x : ℝ in 𝓝 0, 0<V x :=
      tendsto_const_nhds.eventually_lt hV.continuousAt hV₀
    have hnn : ∀ᶠ x : ℝ in 𝓝 0, N x<count := hN.eventually_lt tendsto_const_nhds hN₀
    have hwn : ∀ᶠ x : ℝ in 𝓝 0, W x<J := hW.eventually_lt tendsto_const_nhds hW₀
    filter_upwards [hgn,hxn,hvn,hnn,hwn] with x h1 h2 h3 h4 h5
    exact ⟨h1,h2,h3,h4,h5⟩
  obtain ⟨r,hr,hBall⟩ := Metric.eventually_nhds_iff.mp hNear
  let δ := r/2
  have hδ : 0<δ := by dsimp only [δ]; positivity
  have hd : dist δ 0<r := by
    rw [Real.dist_eq,sub_zero,abs_of_pos hδ]
    unfold δ
    linarith only [hr]
  obtain ⟨h1,h2,h3,h4,h5⟩ := hBall hd
  have hv : X δ+E δ<(G δ)^2 := by unfold V at h3; linarith only [h3]
  exact ⟨δ,hδ,h1,h2.le,hv,h4,h5⟩

/-- Count and unscaled excess from the same Gram bound, with the
simpler excess denominator used for the limiting numerical margin. -/
theorem gram_count_and_unscaled_excess {F N H D Δ ξ ε : ℝ}
    (hF : 0<F) (hN : 0≤N) (hNH : N≤H) (hD : 0≤D) (hΔ : 0<Δ)
    (hξ : ξ≤1) (hε : ξ+ε<Δ^2)
    (hGram : (H*Δ+D)^2≤H+ξ*(H^2-H)+ε*H^2) :
    N≤(1-ξ)/(Δ^2-ξ-ε) ∧ F*D≤F*(1-ξ)/(2*Δ) := by
  obtain ⟨hCount,hEx⟩ := gram_count_and_excess hN hNH hD hΔ hξ hε hGram
  refine ⟨hCount,?_⟩
  have hDen : 2*Δ≤2*(Δ+Real.sqrt (Δ^2-ξ-ε)) := by
    linarith only [Real.sqrt_nonneg (Δ^2-ξ-ε)]
  have hLower : (1-ξ)/(2*(Δ+Real.sqrt (Δ^2-ξ-ε)))≤(1-ξ)/(2*Δ) :=
    div_le_div_of_nonneg_left (sub_nonneg.mpr hξ) (by positivity) hDen
  exact (mul_le_mul_of_nonneg_left (hEx.trans hLower) hF.le).trans_eq (by ring)

end GoldbachPintzWeightedGram
end

section
namespace GoldbachPintzWeightedGram

open Complex GoldbachPintzNumerics
open scoped Classical

noncomputable section

def rationalPsi (b anchor loss : ℝ) : ℝ :=
  realRationalZeroKernel b (loss-anchor)/realRationalZeroKernel b (-anchor)

def rationalPair (b anchor loss t : ℝ) : ℝ :=
  (rationalZeroKernel b (((loss-anchor:ℝ):ℂ)+(t:ℂ)*I)).re/
    realRationalZeroKernel b (loss-anchor)

def principalRationalPair (b anchor t : ℝ) : ℝ :=
  (rationalZeroKernel b (((-anchor:ℝ):ℂ)+(t:ℂ)*I)).re/
    realRationalZeroKernel b (-anchor)

theorem realRationalZeroKernel_antitone {b x y : ℝ} (hb : 0≤b)
    (hx : 0<b+x) (hxy : x≤y) :
    realRationalZeroKernel b y≤realRationalZeroKernel b x := by
  have h : b+x≤b+y := by linarith only [hxy]
  unfold realRationalZeroKernel
  exact add_le_add (add_le_add
    (div_le_div_of_nonneg_left (by norm_num) hx h)
    (div_le_div_of_nonneg_left hb (pow_pos hx _) (pow_le_pow_left₀ hx.le h _)))
    (div_le_div_of_nonneg_left (by positivity) (pow_pos hx _) (pow_le_pow_left₀ hx.le h _))

theorem rationalPsi_ge_cut {b anchor loss Λ : ℝ} (hb : 0<b) (hba : anchor<b)
    (hloss : anchor≤loss) (hΛ : loss≤Λ) : rationalPsi b anchor Λ≤rationalPsi b anchor loss := by
  unfold rationalPsi
  exact div_le_div_of_nonneg_right
    (realRationalZeroKernel_antitone hb.le (by linarith only [hb,hloss]) (by linarith only [hΛ]))
    (realRationalZeroKernel_pos hb (by linarith only [hba])).le

theorem rationalPair_nonneg {b anchor loss t : ℝ} (hb : 0<b) (hloss : anchor≤loss) :
    0≤rationalPair b anchor loss t := by
  unfold rationalPair
  exact div_nonneg (rationalZeroKernel_re_nonneg hb (sub_nonneg.mpr hloss))
    (realRationalZeroKernel_pos hb (by linarith only [hb,hloss])).le

theorem rationalZeroKernel_re_ofReal (b x : ℝ) :
    (rationalZeroKernel b (x:ℂ)).re=realRationalZeroKernel b x := by
  have h : rationalZeroKernel b (x:ℂ)=(realRationalZeroKernel b x:ℂ) := by
    unfold rationalZeroKernel realRationalZeroKernel
    push_cast; rfl
  rw [h,Complex.ofReal_re]

theorem rationalPair_zero {b anchor loss : ℝ} (hb : 0<b) (hloss : anchor≤loss) :
    rationalPair b anchor loss 0=1 := by
  unfold rationalPair
  simp only [Complex.ofReal_zero,zero_mul,add_zero,rationalZeroKernel_re_ofReal]
  exact div_self (realRationalZeroKernel_pos hb (by linarith only [hb,hloss])).ne'

theorem principalRationalPair_zero {b anchor : ℝ} (hb : 0<b) (hba : anchor<b) :
    principalRationalPair b anchor 0=1 := by
  unfold principalRationalPair
  simp only [Complex.ofReal_zero,zero_mul,add_zero,rationalZeroKernel_re_ofReal]
  exact div_self (realRationalZeroKernel_pos hb (by linarith only [hba])).ne'

theorem rationalPair_mul_psi {b anchor loss t : ℝ} (hb : 0<b) (hloss : anchor≤loss) :
    rationalPair b anchor loss t * rationalPsi b anchor loss =
      (rationalZeroKernel b (((loss-anchor:ℝ):ℂ)+(t:ℂ)*I)).re/
        realRationalZeroKernel b (-anchor) := by
  let U := realRationalZeroKernel b (loss-anchor)
  let V := realRationalZeroKernel b (-anchor)
  let C := (rationalZeroKernel b (((loss-anchor:ℝ):ℂ)+(t:ℂ)*I)).re
  have h : U≠0 := (realRationalZeroKernel_pos hb (show 0<b+(loss-anchor) by linarith only [hb,hloss])).ne'
  change (C/U)*(U/V)=C/V
  calc
    _ = (C/V)*(U⁻¹*U) := by simp only [div_eq_mul_inv]; ring
    _ = _ := by rw [inv_mul_cancel₀ h,mul_one]

theorem principalRationalPair_le_rationalPair {b anchor loss t : ℝ} (hb : 0<b)
    (hAnchor : 0≤anchor) (hba : anchor<b) (hloss : anchor≤loss) :
    principalRationalPair b anchor t≤rationalPair b anchor loss t :=
  rationalZeroKernel_normalized_comparison hb (sub_nonneg.mpr hloss) (neg_nonpos.mpr hAnchor)
    (by linarith only [hba])

/-- On a distant height separation the normalized principal contribution
is uniformly small per ordered pair. -/
theorem rational_kernel_norm_le_inverse_height {b x t : ℝ} (hb : 0≤b) (ht : 1 ≤ |t|) :
    ‖rationalZeroKernel b ((x:ℂ)+(t:ℂ)*I)‖≤(1+b+2*b^2/3)/|t| := by
  let z : ℂ := (b:ℂ)+((x:ℂ)+(t:ℂ)*I)
  have htz : |t|≤‖z‖ := by
    have h := Complex.abs_im_le_norm z
    simpa only [z,Complex.add_im,Complex.ofReal_im,Complex.mul_im,
      Complex.ofReal_re,Complex.I_im,Complex.I_re,zero_mul,mul_one,add_zero,zero_add] using h
  have hz₁ : 1≤‖z‖ := ht.trans htz
  have hT : 0 < |t| := zero_lt_one.trans_le ht
  have hDom (k : ℕ) (hk : 1≤k) : |t|≤‖z‖^k := by
    refine htz.trans ?_
    simpa only [pow_one] using pow_le_pow_right₀ hz₁ hk
  unfold rationalZeroKernel
  change ‖1/z+(b:ℂ)/z^2+(((2*b^2/3):ℝ):ℂ)/z^3‖≤_
  refine ((norm_add_le _ _).trans (add_le_add (norm_add_le _ _) le_rfl)).trans ?_
  simp only [norm_div,norm_one,norm_pow,Complex.norm_real,Real.norm_of_nonneg hb,
    Real.norm_of_nonneg (show 0≤2*b^2/3 by positivity)]
  rw [add_div,add_div]
  exact add_le_add (add_le_add
    (div_le_div_of_nonneg_left (by norm_num) hT htz)
    (div_le_div_of_nonneg_left hb hT (hDom 2 (by norm_num))))
    (div_le_div_of_nonneg_left (by positivity) hT (hDom 3 (by norm_num)))

theorem principalRationalPair_le_near_mask {b anchor loss t R δ : ℝ} (hb : 0<b)
    (hAnchor : 0≤anchor) (hba : anchor<b) (hloss : anchor≤loss)
    (hR : 1≤R) (hδ : 0≤δ)
    (hFar : 1+b+2*b^2/3 ≤ δ*realRationalZeroKernel b (-anchor)*R) :
    principalRationalPair b anchor t ≤ (if |t|≤R then rationalPair b anchor loss t else 0)+δ := by
  classical
  by_cases h : |t|≤R
  · rw [ite_eq_left h]
    exact (principalRationalPair_le_rationalPair hb hAnchor hba hloss).trans (le_add_of_nonneg_right hδ)
  · rw [ite_eq_right h,zero_add]
    have hlt := lt_of_not_ge h
    have hDen : 0<realRationalZeroKernel b (-anchor) := realRationalZeroKernel_pos hb (by linarith only [hba])
    have hT : 0 < |t| := zero_lt_one.trans_le (hR.trans hlt.le)
    have hUp := rational_kernel_norm_le_inverse_height (x:=-anchor) hb.le (hR.trans hlt.le)
    unfold principalRationalPair
    apply (div_le_iff₀ hDen).mpr
    refine (Complex.re_le_norm _).trans (hUp.trans ?_)
    apply (div_le_iff₀ hT).mpr
    exact hFar.trans (mul_le_mul_of_nonneg_left hlt.le (mul_nonneg hδ hDen.le))

end
end GoldbachPintzWeightedGram
