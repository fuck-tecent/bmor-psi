variable {K E : Type*} [Field K] [Field E] [Algebra K E] [Fintype E]

theorem card_minpoly_fiber [DecidableEq K] (P : K[X]) (hm : P.Monic) (hP : Irreducible P) :
    (univ.filter (fun y : E => minpoly K y=P)).card =
      if P.natDegree ∣ Module.finrank K E then P.natDegree else 0 := by
  classical
  letI : Fact (Irreducible P) := ⟨hP⟩
  let A := AdjoinRoot P
  let e : (A →ₐ[K] E) ≃ {y : E // minpoly K y=P} :=
    (AdjoinRoot.equiv E K P hm.ne_zero).trans
      ((Equiv.refl E).subtypeEquiv fun y => by
        rw [mem_aroots,and_iff_right hm.ne_zero,Equiv.refl_apply]
        exact (minpoly.eq_iff_aeval_eq_zero hP hm).symm.trans eq_comm)
  have hD : Module.finrank K A=P.natDegree := (AdjoinRoot.powerBasis hm.ne_zero).finrank
  rw [← Fintype.card_subtype, Fintype.card_eq_nat_card, ← Nat.card_congr e,← hD]
  split_ifs with h
  · exact FiniteField.natCard_algHom_of_finrank_dvd h
  · have hEmpty : IsEmpty (A →ₐ[K] E) :=
      ⟨fun f => h (FiniteField.nonempty_algHom_iff_finrank_dvd.mp ⟨f⟩)⟩
    exact Nat.card_eq_zero.mpr (Or.inl hEmpty)

omit [Fintype E] in
theorem PowerBasis.norm_algebraMap_sub_gen (pb : PowerBasis K E) (a : K) :
    Algebra.norm K (algebraMap K E a-pb.gen) = (minpoly K pb.gen).eval a := by
  letI : FiniteDimensional K E := pb.finite
  have hChar : (Algebra.lmul K E pb.gen).charpoly = minpoly K pb.gen := by
    rw [← LinearMap.charpoly_toMatrix _ pb.basis,← Algebra.leftMulMatrix_apply]
    exact charpoly_leftMulMatrix pb
  rw [← hChar,LinearMap.eval_charpoly,Algebra.norm_apply,map_sub,Algebra.lmul_algebraMap]
  congr 1

theorem norm_algebraMap_sub_eq_minpoly_eval_pow (y : E) (a : K) :
    Algebra.norm K (algebraMap K E a-y) =
      (minpoly K y).eval a ^ (Module.finrank K E / (minpoly K y).natDegree) := by
  classical
  let P := minpoly K y
  have hy : IsIntegral K y := IsIntegral.of_finite K y
  have hm : P.Monic := minpoly.monic hy
  have hP : Irreducible P := minpoly.irreducible hy
  letI : Fact (Irreducible P) := ⟨hP⟩
  let A := AdjoinRoot P
  let pb := AdjoinRoot.powerBasis hm.ne_zero
  let f : A →ₐ[K] E := AdjoinRoot.liftAlgHom P (Algebra.ofId K E) y (minpoly.aeval K y)
  have hD : Module.finrank K A=P.natDegree := pb.finrank
  have hp0 : 0 < P.natDegree := hP.natDegree_pos
  have hf : f pb.gen=y := by
    change AdjoinRoot.liftAlgHom P (Algebra.ofId K E) y _ (AdjoinRoot.root P)=y
    exact AdjoinRoot.liftAlgHom_root (p:=P) (Algebra.ofId K E) y (minpoly.aeval K y)
  algebraize [f.toRingHom]
  have hFin : Module.finrank A E = Module.finrank K E / P.natDegree := by
    rw [← Module.finrank_mul_finrank K A E,hD,Nat.mul_comm,Nat.mul_div_cancel _ hp0]
  have hTarget : algebraMap A E (algebraMap K A a-pb.gen)=algebraMap K E a-y := by
    change f (algebraMap K A a-pb.gen)=_
    rw [map_sub,f.commutes,hf]
  rw [← hTarget,← Algebra.norm_norm (R:=K) (S:=A),Algebra.norm_algebraMap,map_pow,
    PowerBasis.norm_algebraMap_sub_gen,AdjoinRoot.minpoly_powerBasis_gen_of_monic hm,hFin]

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

noncomputable section

variable {K E : Type*} [Field K] [Field E] [Algebra K E] [Finite E]

def normLift (χ : MulChar K ℂ) : MulChar E ℂ :=
  MulChar.ofUnitHom (χ.toUnitHom.comp (Units.map (Algebra.norm K (S:=E))))

theorem normLift_apply (χ : MulChar K ℂ) (x : E) :
    normLift χ x=χ (Algebra.norm K x) := by
  by_cases hx : x=0
  · rw [hx,MulChar.map_zero,Algebra.norm_zero,χ.map_zero]
  · let u := Units.mk0 x hx
    change normLift χ (u:E)=χ (Algebra.norm K (u:E))
    rw [normLift,MulChar.ofUnitHom_coe]
    simp only [MonoidHom.comp_apply,MulChar.coe_toUnitHom,Units.coe_map]

def normLiftHom : MulChar K ℂ →* MulChar E ℂ where
  toFun := normLift
  map_one' := by
    apply MulChar.ext
    intro x
    rw [normLift_apply, MulChar.one_apply_coe]
    exact MulChar.one_apply_coe (Units.map (Algebra.norm K (S:=E)) x)
  map_mul' χ ψ := by
    apply MulChar.ext
    intro x
    simp only [normLift_apply,MulChar.mul_apply]

theorem normLift_injective : Function.Injective (normLift (K:=K) (E:=E)) := by
  intro χ ψ h
  apply MulChar.ext'
  intro x
  obtain ⟨y,rfl⟩ := FiniteField.norm_surjective K E x
  simpa only [normLift_apply] using congrArg (fun c : MulChar E ℂ => c y) h

theorem orderOf_normLift (χ : MulChar K ℂ) : orderOf (normLift (E:=E) χ)=orderOf χ :=
  orderOf_injective normLiftHom normLift_injective χ

end
end GoldbachBurgess
end

