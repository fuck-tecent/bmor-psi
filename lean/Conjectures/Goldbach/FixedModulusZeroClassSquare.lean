namespace GoldbachHybridGrowth

open Complex Finset MeasureTheory Set
open scoped Classical BigOperators

private theorem nat_product_rpow (S : Finset ℕ) (ε : ℝ) :
    (∏ p ∈ S, (p:ℝ)^ε) = (∏ p ∈ S, (p:ℝ))^ε := by
  induction S using Finset.induction_on with
  | empty => simp
  | @insert p S hp ih =>
    rw [prod_insert hp,prod_insert hp,Real.mul_rpow (Nat.cast_nonneg _)
      (prod_nonneg (fun _ _ => Nat.cast_nonneg _)),ih]

/-- The Euler-factor loss of a principal character is subpower in its modulus. -/
theorem primeFactor_twopow_le_rpow {ε : ℝ} (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ q : ℕ, 0<q →
      (2:ℝ)^q.primeFactors.card ≤ C*(q:ℝ)^ε := by
  let R : ℝ := (2:ℝ)^(1/ε)
  let N : ℕ := ⌈R⌉₊
  refine ⟨2^N,by positivity,?_⟩
  intro q hq
  let S := q.primeFactors
  let H (p : ℕ) : ℝ := if p<N then 2 else 1
  have hRpos : 0<R := by dsimp [R]; positivity
  have hRp : R^ε=2 := by
    dsimp [R]
    rw [← Real.rpow_mul (by norm_num : (0:ℝ)≤2),
      one_div_mul_cancel hε.ne',Real.rpow_one]
  have hH : (∏ p ∈ S, H p)≤(2:ℝ)^N := by
    have hcount : (S.filter (fun p => p<N)).card≤N := by
      have hsubset : S.filter (fun p => p<N)⊆Finset.range N :=
        fun p hp => mem_range.mpr (mem_filter.mp hp).2
      simpa only [card_range] using Finset.card_le_card hsubset
    unfold H
    rw [← Finset.prod_filter,Finset.prod_const]
    exact pow_le_pow_right₀ (by norm_num) hcount
  have hpProd : (∏ p ∈ S, (p:ℝ))≤(q:ℝ) := by
    rw [← Nat.cast_prod]
    exact_mod_cast Nat.le_of_dvd hq (Nat.prod_primeFactors_dvd q)
  have hprod : (∏ p ∈ S, (p:ℝ)^ε)≤(q:ℝ)^ε := by
    rw [nat_product_rpow]
    exact Real.rpow_le_rpow (prod_nonneg (fun _ _ => Nat.cast_nonneg _)) hpProd hε.le
  calc
    _ = ∏ p ∈ S, (2:ℝ) := by simp [S]
    _ ≤ ∏ p ∈ S, H p*(p:ℝ)^ε := by
      apply Finset.prod_le_prod₀ (fun _ _ => by norm_num)
      intro p hp
      by_cases h : p<N
      · rw [show H p=2 by simp [H,h]]
        have h1 : (1:ℝ)≤p := by
          exact_mod_cast (Nat.prime_of_mem_primeFactors hp).pos
        exact le_mul_of_one_le_right (by norm_num) (Real.one_le_rpow h1 hε.le)
      · rw [show H p=1 by simp [H,h],one_mul,← hRp]
        refine Real.rpow_le_rpow hRpos.le ?_ hε.le
        exact (Nat.le_ceil R).trans (by exact_mod_cast (le_of_not_gt h : N≤p))
    _ = (∏ p ∈ S, H p)*(∏ p ∈ S, (p:ℝ)^ε) := Finset.prod_mul_distrib
    _ ≤ _ := mul_le_mul hH hprod (prod_nonneg (fun _ _ => by positivity)) (by positivity)

end GoldbachHybridGrowth

