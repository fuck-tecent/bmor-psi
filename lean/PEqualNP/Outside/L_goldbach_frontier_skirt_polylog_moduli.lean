theorem V1te : ∃ A : ℝ, 1≤ A ∧ ∀ L : ℝ, 100≤ L →
    ∀ a∈Set.Icc (0:ℝ) 1, ∀ s : ℂ, 2/3≤ s.re → s.re≤2 →
