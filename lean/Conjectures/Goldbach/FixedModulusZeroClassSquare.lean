/-- Passing to a clean interval does not increase the bound required for the
original zero set. The lower cutoff 4 holds all the fixed tests. -/
theorem fixedModulusClassBound_of_clean {θ : ℝ}
    (hB : ∀ K : ℕ, ∀ H U : ℝ, 4≤H → 2≤U →
      ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (R : ℝ), 2≤R → R≤U →
      (∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
        1/2<z.re → regularizedL ψ z=0 → modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R) →
      modulusClassMassSquare q K H R≤θ) :
    FixedModulusClassBound θ := by
  intro K L T
  let H := max 4 L
  have hH₀ : 4≤H := le_max_left _ _
  have hH : 0≤H := (by norm_num : (0:ℝ)≤4).trans hH₀
  have hL : L≤H := le_max_right _ _
  obtain ⟨U,hU,_,hClean⟩ := eventually_clean_modulus_height (T:=T) hH
  have h := hB K H U hH₀ hU
  have hFinish : ∀ᶠ q : ℕ in atTop, ∀ _ : NeZero q, modulusClassMassSquare q K L T≤θ := by
    filter_upwards [h,hClean] with q h hClean
    intro inst
    obtain ⟨R,hR,hTR,hRU,hClean'⟩ := hClean
    exact (modulusClassMassSquare_mono (K:=K) hL hTR).trans (h R hR hRU hClean')
  exact eventually_atTop.mp hFinish

end GoldbachSignedPairs
