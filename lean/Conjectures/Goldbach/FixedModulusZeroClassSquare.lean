namespace GoldbachPintzFamily

open Finset Complex Goldbach GoldbachTwistedMellin GoldbachTypeII GoldbachPintzHalasz GoldbachHalasz
open scoped Classical

noncomputable section

private theorem log_card_shift_sq_le_full {J : ℝ} (hJ : 1 ≤ J) :
    (1+Real.log (1+J))^2 ≤ 4*(1+Real.log J)^2 := by
  have hJ₀ := zero_lt_one.trans_le hJ
  have hlogJ := Real.log_nonneg hJ
  have hlog := Real.log_le_log (by positivity : 0 < 1+J) (by linarith only [hJ] : 1+J ≤ 2*J)
  rw [Real.log_mul (by norm_num : (2:ℝ) ≠ 0) hJ₀.ne'] at hlog
  have hlog2 := Real.log_le_sub_one_of_pos (show (0:ℝ) < 2 by norm_num)
  have hb : 1+Real.log (1+J) ≤ 2*(1+Real.log J) := by linarith only [hlog,hlog2,hlogJ]
  have h0 : 0 ≤ 1+Real.log (1+J) := by
    have hh := Real.log_nonneg (show 1 ≤ 1+J by linarith only [hJ])
    linarith only [hh]
  exact (pow_le_pow_left₀ h0 hb 2).trans_eq (by ring)

set_option maxHeartbeats 950000 in
/-- Absorb a uniform error in the full weighted row. -/
theorem count_le_of_multiplicity_full_rows {A B L τ ε : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hL : 0 ≤ L)
    (hτ : 0 < τ) (hε : 0 < ε) : ∃ C : ℝ, 0 < C ∧
      ∀ {ι : Type*} (I : Finset ι) (m : ι → ℕ)
        (d : ι → ℂ) (g : ι → ι → ℂ) (ell e E : ℝ),
        E ≤ L → L*e/τ^2 ≤ 1/2 →
        (∀ i ∈ I, τ ≤ ‖d i‖) →
        ((∑ i ∈ I, (m i:ℝ)*‖d i‖)^2 ≤
          E*∑ i ∈ I, (m i:ℝ)*(∑ j ∈ I, (m j:ℝ)*‖g i j‖)) →
        (∀ i ∈ I, (∑ j ∈ I, (m j:ℝ)*‖g i j‖) ≤
          A*Real.exp (B*ell)*(1+Real.log (1+∑ j ∈ I, (m j:ℝ)))^2+e*(∑ j ∈ I,(m j:ℝ))) →
        (∑ i ∈ I, (m i:ℝ)) ≤ C*Real.exp ((1+ε)*B*ell) := by
  let A' := 4*L*A/τ^2
  have hA' : 0 ≤ A' := by dsimp only [A']; positivity
  obtain ⟨C,hC,hrec⟩ := count_le_of_halasz_recursion A' B ε hA' hB hε
  refine ⟨C,hC,?_⟩
  intro ι I m d g ell e E hE hOffAbsorb hdet hhalasz hrow
  let J : ℝ := ∑ i ∈ I, (m i:ℝ)
  have hJcast : J = ((∑ i ∈ I, m i:ℕ):ℝ) := by simp [J, Nat.cast_sum]
  rcases Nat.eq_zero_or_pos (∑ i ∈ I,m i) with hz | hj
  · change J ≤ _
    rw [hJcast,hz,Nat.cast_zero]
    positivity
  have hJ : 1 ≤ J := by rw [hJcast]; exact_mod_cast hj
  have hJ₀ := zero_le_one.trans hJ
  let row (i : ι) := ∑ j ∈ I, (m j:ℝ)*‖g i j‖
  let K : ℝ := A*Real.exp (B*ell)*(1+Real.log (1+J))^2
  have hg₀ : 0 ≤ ∑ i ∈ I, (m i:ℝ)*row i := by
    exact sum_nonneg (fun i _ => mul_nonneg (Nat.cast_nonneg _)
      (sum_nonneg (fun j _ => mul_nonneg (Nat.cast_nonneg _) (norm_nonneg _))))
  have htotal : (∑ i ∈ I, (m i:ℝ)*row i) ≤ J*(K+e*J) := by
    dsimp only [J]
    rw [sum_mul]
    exact sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left (hrow i hi) (Nat.cast_nonneg _))
  have hdet' : τ*J ≤ ∑ i ∈ I, (m i:ℝ)*‖d i‖ := by
    dsimp only [J]
    rw [mul_comm,sum_mul]
    apply sum_le_sum
    intro i hi
    exact mul_le_mul_of_nonneg_left (hdet i hi) (Nat.cast_nonneg _)
  have hraw : (τ*J)^2 ≤ L*(J*(K+e*J)) := calc
    _ ≤ (∑ i ∈ I, (m i:ℝ)*‖d i‖)^2 := pow_le_pow_left₀ (mul_nonneg hτ.le hJ₀) hdet' 2
    _ ≤ E*(∑ i ∈ I, (m i:ℝ)*row i) := hhalasz
    _ ≤ L*(∑ i ∈ I, (m i:ℝ)*row i) := mul_le_mul_of_nonneg_right hE hg₀
    _ ≤ _ := mul_le_mul_of_nonneg_left htotal hL
  have hK : K ≤ A*Real.exp (B*ell)*(4*(1+Real.log J)^2) :=
    mul_le_mul_of_nonneg_left (log_card_shift_sq_le_full hJ) (by positivity)
  have hmain : J^2 ≤ A'*J*Real.exp (B*ell)*(1+Real.log J)^2+(L*e/τ^2)*J^2 := by
    have hτ₂ : 0 < τ^2 := sq_pos_of_pos hτ
    apply le_of_mul_le_mul_left _ hτ₂
    calc
      τ^2*J^2 = (τ*J)^2 := (mul_pow τ J 2).symm
      _ ≤ L*(J*(K+e*J)) := hraw
      _ ≤ L*(J*(A*Real.exp (B*ell)*(4*(1+Real.log J)^2)+e*J)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (add_le_add hK le_rfl) hJ₀) hL
      _ = _ := by dsimp only [A']; field_simp [hτ.ne']
  exact hrec J ell (L*e/τ^2) hJ hOffAbsorb hmain


/-- Combine a same-column row and uniform errors on and off that column. -/
theorem full_row_of_column_errors {ι κ : Type*} (Z : Finset ι)
    (m : ι → ℕ) (key : ι → κ) (g : ι → ι → ℂ) {a ed eo : ℝ} (heo : 0 ≤ eo)
    {r : ι}
    (hdiag : (∑ s ∈ Z.filter (fun s => key s = key r),(m s:ℝ)*‖g r s‖) ≤
      a+ed*(∑ s ∈ Z,(m s:ℝ)))
    (hoff : ∀ s ∈ Z, key s ≠ key r → ‖g r s‖ ≤ eo) :
    (∑ s ∈ Z,(m s:ℝ)*‖g r s‖) ≤ a+(ed+eo)*(∑ s ∈ Z,(m s:ℝ)) := by
  let J : ℝ := ∑ s ∈ Z,(m s:ℝ)
  let D := Z.filter (fun s => key s = key r)
  let F := Z.filter (fun s => key s ≠ key r)
  let f (s : ι) := (m s:ℝ)*‖g r s‖
  have hfar : (∑ s ∈ F,f s) ≤ eo*J := calc
    _ ≤ ∑ s ∈ F,(m s:ℝ)*eo := by
      apply sum_le_sum
      intro s hs
      obtain ⟨hsZ,hsK⟩ := mem_filter.mp hs
      exact mul_le_mul_of_nonneg_left (hoff s hsZ hsK) (Nat.cast_nonneg _)
    _ ≤ ∑ s ∈ Z,(m s:ℝ)*eo :=
      sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun s _ _ => mul_nonneg (Nat.cast_nonneg _) heo)
    _ = _ := by dsimp only [J]; rw [mul_comm eo,sum_mul]
  calc
    _ = (∑ s ∈ D,f s)+(∑ s ∈ F,f s) := (sum_filter_add_sum_filter_not Z (fun s => key s = key r) f).symm
    _ ≤ (a+ed*J)+eo*J := add_le_add hdiag hfar
    _ = _ := by change _ = a+(ed+eo)*J; ring

set_option maxHeartbeats 900000 in
/-- Apply the finite-table bound to full rows, retaining the uniform Gram error. -/
theorem tagged_count_of_full_height_rows {A K L τ ε : ℝ}
    (hA : 0 ≤ A) (hK : 0 ≤ K) (hL : 0 ≤ L) (hτ : 0 < τ) (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ (Q : ℕ) {δ T Y : ℝ}, 0 ≤ δ → 1 ≤ Y →
      logHeight Q (T+2) ≤ K*Real.log Y →
      ∀ (Z : Finset (TaggedZero Q)) (D E : Finset ℕ) (w ψ θ : ℕ → ℝ) (e : ℝ),
      let S := Icc 1 ⌊Y⌋₊
      L*e/τ^2 ≤ 1/2 → (∀ n ∈ S, 0 ≤ w n) →
      (∑ n ∈ S, (realDivisorWeight D ψ n)^2*w n/(n:ℝ)) ≤ L →
      (∀ r ∈ Z, τ ≤ ‖primitiveDetector S D E w ψ θ r‖) →
      (∀ r ∈ Z, (∑ s ∈ Z, (order s:ℝ)*‖primitiveGram S E w θ r s‖) ≤
        A*Y^(2*δ)*(1+δ*logHeight Q (T+2))*(1+Real.log (1+∑ s ∈ Z,(order s:ℝ)))+
          e*(∑ s ∈ Z,(order s:ℝ))) →
      (∑ r ∈ Z, (order r:ℝ)) ≤ C*Y^(2*δ*(1+ε)) := by
  have hA' : 0 ≤ A*(1+K) := by positivity
  obtain ⟨C,hC,hbound⟩ := count_le_of_multiplicity_full_rows hA' (by norm_num : (0:ℝ) ≤ 1) hL hτ hε
  refine ⟨max 1 C,zero_lt_one.trans_le (le_max_left _ _),?_⟩
  intro Q δ T Y hδ hY hHeight Z D E w ψ θ e S he₂ hw hE hdet hdiag
  let J : ℝ := ∑ s ∈ Z,(order s:ℝ)
  have hJ₀ : 0 ≤ J := sum_nonneg fun r _ => Nat.cast_nonneg (order r)
  have hY₀ := zero_lt_one.trans_le hY
  have hYpow : 0 ≤ Y^(2*δ*(1+ε)) := Real.rpow_nonneg hY₀.le _
  by_cases hsmall : J ≤ Y^(2*δ)
  · calc
      _ ≤ Y^(2*δ) := hsmall
      _ ≤ Y^(2*δ*(1+ε)) := Real.rpow_le_rpow_of_exponent_le hY
        (by nlinarith only [mul_nonneg hδ hε.le])
      _ ≤ _ := by
        simpa only [one_mul] using mul_le_mul_of_nonneg_right (le_max_left (1:ℝ) C) hYpow
  · have hh := heightGap_le_large_countLog hY₀ hδ hK hHeight (lt_of_not_ge hsmall)
    have hlog := Real.log_nonneg (show 1 ≤ 1+J from le_add_of_nonneg_right hJ₀)
    have hlog' : 0 ≤ 1+Real.log (1+J) := by linarith only [hlog]
    have hdiag' (r : TaggedZero Q) (hr : r ∈ Z) :
        (∑ s ∈ Z,(order s:ℝ)*‖primitiveGram S E w θ r s‖) ≤
          (A*(1+K))*Real.exp (1*(2*δ*Real.log Y))*(1+Real.log (1+J))^2+e*J := calc
      _ ≤ A*Y^(2*δ)*(1+δ*logHeight Q (T+2))*(1+Real.log (1+J))+e*J := hdiag r hr
      _ ≤ A*Y^(2*δ)*((1+K)*(1+Real.log (1+J)))*(1+Real.log (1+J))+e*J :=
        (add_le_add) (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hh
          (mul_nonneg hA (Real.rpow_nonneg hY₀.le _))) hlog') le_rfl
      _ = _ := by rw [one_mul,Real.rpow_def_of_pos hY₀,mul_comm (Real.log Y)]; ring
    have hS (n : ℕ) (hn : n ∈ S) : n ≠ 0 := (Nat.zero_lt_one.trans_le (mem_Icc.mp hn).1).ne'
    have hH := primitive_table_halasz S D E hS Z w ψ θ hw
    have h := hbound Z order (primitiveDetector S D E w ψ θ) (primitiveGram S E w θ)
      (2*δ*Real.log Y) e _ hE he₂ hdet hH hdiag'
    have h' : J ≤ C*Y^(2*δ*(1+ε)) := h.trans_eq (by
      rw [mul_one,Real.rpow_def_of_pos hY₀]
      congr 2
      ring)
    exact h'.trans (mul_le_mul_of_nonneg_right (le_max_right (1:ℝ) C) hYpow)

end
end GoldbachPintzFamily

