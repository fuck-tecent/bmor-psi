theorem Vj8 (f : ℕ → ℂ)
    (hf : ∀ n : ℕ, n ≠ 0 → ‖f n‖ ≤ 1) (s : ℂ) (hs : s.re = 2) :
    ‖LSeries f s‖ ≤ Real.pi ^ 2 / 6 := by
  have hsum : LSeriesSummable f s :=
    LSeriesSummable_of_bounded_of_one_lt_re hf (by rw [hs]; norm_num)
