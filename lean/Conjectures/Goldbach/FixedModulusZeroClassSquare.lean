/-- The nonnegative exponentially decaying weight used in the rational test. -/
def rationalPrimeWeight (b u : ℝ) : ℝ :=
  Real.exp (-(b*u))*(1+b*u+(b*u)^2/3)

theorem rationalPrimeWeight_nonneg {b u : ℝ} (hb : 0≤b) (hu : 0≤u) :
    0≤rationalPrimeWeight b u := by
  unfold rationalPrimeWeight
  positivity

/-- The test is defined by its original prime series, even when the
unweighted series at that argument is only conditionally convergent. -/
def rationalPrimeTest {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (b L : ℝ) (s : ℂ) : ℂ :=
  ∑' n : ℕ, term (twistedCoefficient χ) s n *
    (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)

/-- The exponential weight moves the prime series to a point to the right
by b/L while the polynomial gives the second logarithmic jet. -/
theorem rationalPrimeTest_shift {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L : ℝ) (s : ℂ) :
    rationalPrimeTest χ b L s=
      ∑' n : ℕ, term (twistedCoefficient χ) (s+((b/L:ℝ):ℂ)) n *
       (1+((b/L:ℝ):ℂ)*Complex.log (n:ℂ)+(((b/L:ℝ):ℂ)*Complex.log (n:ℂ))^2/3) := by
  unfold rationalPrimeTest
  apply tsum_congr
  intro n
  by_cases hn : n=0
  · subst n
    simp
  have hn' : (0:ℝ)<n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn
  simp only [term_of_ne_zero hn]
  have h0 : (n:ℂ)^(s+((b/L:ℝ):ℂ))=((n:ℂ)^s)*cexp ((Real.log (n:ℝ)*(b/L):ℝ):ℂ) := by
    rw [Complex.cpow_add _ _ hn0,Complex.cpow_def_of_ne_zero hn0 ((_ : ℝ):ℂ)]
    congr 2
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn'.le,Complex.ofReal_mul]
  rw [h0,div_mul_eq_div_div]
  have hlog : Complex.log (n:ℂ)=((Real.log (n:ℝ)):ℂ) := by
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn'.le]
  simp only [hlog,div_eq_mul_inv,←Complex.exp_neg]
  unfold rationalPrimeWeight
  rw [Complex.ofReal_mul,Complex.ofReal_exp]
  push_cast
  have hm : (b:ℂ)*(Complex.log (n:ℂ)*(L:ℂ)⁻¹) =
      Complex.log (n:ℂ)*((b:ℂ)*(L:ℂ)⁻¹) := by ring
  rw [hm]
  ring

theorem rationalPrimeTest_eq_logJet {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L : ℝ) (s : ℂ)
    (hs : 1<(s+((b/L:ℝ):ℂ)).re) :
    rationalPrimeTest χ b L s =
      rationalLogJet (fun z=>-logDeriv χ.LFunction z) ((b/L:ℝ):ℂ) (s+((b/L:ℝ):ℂ)) := by
  rw [rationalPrimeTest_shift,rationalLogJet_eq_prime_series χ hs]

end

end GoldbachPintzWeightedFormula
