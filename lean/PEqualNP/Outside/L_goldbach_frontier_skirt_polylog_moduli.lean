    (S : PrimitiveComplexCharacter → Finset ℕ)
    (hS : ∀ χ∈F, S χ⊆(V1 χ).V14 ((2 : ℝ)^(K+1)))
    (hleft : ∀ χ∈F, ∀ i∈S χ, ((V1 χ).zeros i).re≤1/2) :
    (∑ χ∈F, ‖∑ i∈S χ, Ve y h ((V1 χ).zeros i)‖) ≤
