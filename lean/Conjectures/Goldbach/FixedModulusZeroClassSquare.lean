noncomputable section

set_option maxHeartbeats 1150000 in
/-- Uniform principal rational test in a logarithmic strip at polylogarithmic
height. The complex principal pole retains its exact height. -/
theorem rational_prime_test_principal_upper_eventually {ε b K p : ℝ}
    (hε : 0<ε) (hb : 0<b) (hK : 0≤K) (hp : 0≤p) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (s : ℂ),
    Real.log (q:ℝ)≤L → 1-K/L≤ s.re → s.re≤1+K/L → |s.im|≤L^p →
    1<s.re+b/L →
    (rationalPrimeTest (1:DirichletCharacter ℂ q) b L s).re ≤
      L*(rationalZeroKernel b ((L:ℂ)*(s-1))).re+ε*L := by
  obtain ⟨A,hA,hP⟩ := rational_prime_test_principal_one_upper hb
  let C : ℝ := 4*(1+2*b+(8/3:ℝ)*b^2)
  have hC : 0<C := by dsimp [C]; positivity
  have hdec : Tendsto (fun n : ℕ=>(n:ℝ)^(-(1/2):ℝ)) atTop (𝓝 0) :=
    (tendsto_rpow_neg_atTop (show (0:ℝ)<1/2 by norm_num)).comp
      tendsto_natCast_atTop_atTop
  obtain ⟨L₀,hL₀,hD⟩ := decaying_bad_prime_log_mass_small
    (fun n=>Real.rpow_nonneg (Nat.cast_nonneg n) _) hdec (show 0<ε/(2*C) by positivity)
  have hzeta := Real.tendsto_exp_atTop.eventually
    (GoldbachPrincipalPintz.zeta_near_zero_height_eventually
      (show (0:ℝ)<1 by norm_num) (show 0≤p+2 by positivity))
  have hlog := Real.isLittleO_log_id_atTop.def (show 0<ε/(4*A*(p+1)) by positivity)
  have hlarge := eventually_ge_atTop (max (max 2 L₀) (max (8*(K+b)) (4*A*Real.log 6/ε)))
  have hloglarge := Real.tendsto_log_atTop.eventually_ge_atTop (max 1 K)
  filter_upwards [hzeta,hlog,hlarge,hloglarge] with L hZ hLo hL' hLL q _ s hq hsLo hsHi ht hs
  rw [Real.log_exp] at hZ
  have hL2 : 2≤L := (le_max_left _ _).trans ((le_max_left _ _).trans hL')
  have hL1 : 1≤L := (by norm_num : (1:ℝ)≤2).trans hL2
  have hL : 0<L := zero_lt_one.trans_le hL1
  have hL₀' : L₀≤L := (le_max_right _ _).trans ((le_max_left _ _).trans hL')
  have hW : 8*(K+b)≤L := (le_max_left _ _).trans ((le_max_right _ _).trans hL')
  have hE : 4*A*Real.log 6/ε≤L := (le_max_right _ _).trans ((le_max_right _ _).trans hL')
  have hℓ₁ : 1≤Real.log L := (le_max_left _ _).trans hLL
  have hℓK : K≤Real.log L := (le_max_right _ _).trans hLL
  have hℓ : 0≤Real.log L := zero_le_one.trans hℓ₁
  have hPow : 1≤L^p := Real.one_le_rpow hL1 hp
  have hShift : s.re+b/L≤1+1/8 := by
    have h := (div_le_iff₀ hL).mpr (show K+b≤(1/8:ℝ)*L by linarith only [hW])
    rw [add_div] at h
    linarith only [hsHi,h]
  have hZero (ρ : ℂ) (hρ : regularizedL (1:DirichletCharacter ℂ 1) ρ=0)
      (hρI : |ρ.im-s.im|≤2) : ρ.re≤ s.re := by
    by_contra! hρR
    have hgap : 1-ρ.re < 1*Real.log L/L := by
      rw [one_mul]
      have h := div_le_div_of_nonneg_right hℓK hL.le
      linarith only [hρR,hsLo,h]
    have hAbs : |ρ.im|≤L^p+2 := by
      have hh := abs_add_le (ρ.im-s.im) s.im
      rw [sub_add_cancel] at hh
      linarith only [hh,hρI,ht]
    have hPow2 : L^p+2≤L^(p+2) := by
      rw [Real.rpow_add hL,Real.rpow_ofNat]
      have hh := pow_le_pow_left₀ (by norm_num : (0:ℝ)≤2) hL2 2
      have hh' := mul_le_mul_of_nonneg_left hh (Real.rpow_nonneg hL.le p)
      nlinarith only [hh',hPow]
    exact (not_lt_of_ge (hAbs.trans hPow2)) (hZ ρ hρ hgap)
  have hPrim := hP hL1 hs hShift hZero
  have hLogHeight : logHeight 1 s.im ≤ Real.log 6 + p*Real.log L := by
    change Real.log ((2:ℝ)*(1:ℕ)*(2+|s.im|))≤_
    calc
      _ ≤ Real.log (6*L^p) := by
        apply Real.log_le_log (by positivity)
        norm_num
        nlinarith only [ht,hPow]
      _ = _ := by rw [Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hL p).ne',
        Real.log_rpow hL]
  have hLo' : Real.log L ≤ (ε/(4*A*(p+1)))*L := by
    simpa [id,Real.norm_eq_abs,abs_of_nonneg hℓ,abs_of_pos hL] using hLo
  have hLogError : A*logHeight 1 s.im≤ε*L/2 := by
    have he := (div_le_iff₀ hε).mp hE
    have hP' : A*p*Real.log L≤ε*L/4 := calc
      _ ≤ A*(p+1)*Real.log L := by
        have h1 := mul_nonneg hA.le hℓ
        nlinarith only [h1]
      _ ≤ A*(p+1)*((ε/(4*A*(p+1)))*L) := mul_le_mul_of_nonneg_left hLo' (by positivity)
      _ = _ := by field_simp [hA.ne',show p+1≠0 by positivity]
    have hH' := mul_le_mul_of_nonneg_left hLogHeight hA.le
    nlinarith only [he,hP',hH']
  have hMass := hD q L (NeZero.ne q) hL₀' hq
  have hLevel := rational_prime_test_principal_level_error (q:=q) hb hL1 hs
  have hLevel' : ‖rationalPrimeTest (1:DirichletCharacter ℂ q) b L s -
      rationalPrimeTest (1:DirichletCharacter ℂ 1) b L s‖≤ε*L/2 := calc
    _ ≤ C*∑ p∈q.primeFactors, Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ) := hLevel
    _ ≤ C*((ε/(2*C))*L) := mul_le_mul_of_nonneg_left hMass hC.le
    _ = _ := by field_simp [hC.ne']
  have hRe := (Complex.re_le_norm _).trans hLevel'
  rw [Complex.sub_re] at hRe
  linarith only [hRe,hPrim,hLogError]

end

end GoldbachPintzWeightedFormula
end

