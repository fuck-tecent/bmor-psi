/-- Weighted prime sum as a finite linear combination of right-half-plane
logarithmic derivatives. -/
def exponentialPrimeTest {ι : Type*} (S : Finset ι) (a b : ι→ℝ) {q : ℕ}
    [NeZero q] (χ : DirichletCharacter ℂ q) (L : ℝ) (s : ℂ) : ℂ :=
  ∑ i∈S,(exponentialAutoCoeff S a b i:ℂ)*(-logDeriv χ.LFunction (s+(b i/L:ℝ)))

private theorem shift_recip_scale {L d : ℝ} (hL : 0<L) (s ρ : ℂ) :
    1/(s+(d/L:ℝ)-ρ)=(L:ℂ)/((d:ℂ)+(L:ℂ)*(s-ρ)) := by
  have hLc : (L:ℂ)≠0 := Complex.ofReal_ne_zero.mpr hL.ne'
  rw [show s+(d/L:ℝ)-ρ=((d:ℂ)+(L:ℂ)*(s-ρ))/(L:ℂ) by push_cast; field_simp; ring]
  rw [one_div_div]

set_option maxHeartbeats 1000000 in
/-- The exact local pole identity for any finite set of exponential rates.
All shifts use a single zero window and analytic remainder. -/
theorem exponentialPrimeTest_eq_local {ι : Type*} (S : Finset ι) (a b : ι→ℝ) {q : ℕ}
    [NeZero q] (χ : DirichletCharacter ℂ q) {L : ℝ} (hL : 0<L) (s : ℂ)
    (V : Finset ℂ) (m : ℂ→ℕ) (G : ℂ→ℂ)
    (hD : ∀ i∈S, -logDeriv χ.LFunction (s+(b i/L:ℝ)) =
      G (s+(b i/L:ℝ))-
        ∑ ρ∈V,(m ρ:ℂ)*(1/(s+(b i/L:ℝ)-ρ))) :
    exponentialPrimeTest S a b χ L s =
      (∑ i∈S,(exponentialAutoCoeff S a b i:ℂ)*G (s+(b i/L:ℝ)))-
        (L:ℂ)*∑ ρ∈V,(m ρ:ℂ)*exponentialAutoTransform S a b ((L:ℂ)*(s-ρ)) := by
  unfold exponentialPrimeTest exponentialAutoTransform
  rw [Finset.sum_congr rfl (fun i hi=>congrArg (fun z=>(exponentialAutoCoeff S a b i:ℂ)*z) (hD i hi))]
  simp_rw [mul_sub,Finset.sum_sub_distrib,mul_sum]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ρ hρ=> Finset.sum_congr rfl fun i hi=> ?_
  rw [shift_recip_scale hL]
  ring

/-- Uniform control of the signed finite coefficient combination from one
common analytic remainder. -/
theorem exponential_prime_remainder_re_le {ι : Type*} (S : Finset ι) (c : ι→ℝ)
    (w : ι→ℂ) (G : ℂ→ℂ) {z : ℂ} {M E : ℝ} (hc : 0≤∑ i∈S,c i)
    (hG : (G z).re≤M) (hE : ∀ i∈S, ‖G (w i)-G z‖≤E) :
    (∑ i∈S,(c i:ℂ)*G (w i)).re≤(∑ i∈S,c i)*M+(∑ i∈S,|c i|)*E := by
  have hModel : (∑ i∈S,(c i:ℂ)*G (w i)) =
      ((∑ i∈S,c i:ℝ):ℂ)*G z+
        ∑ i∈S,(c i:ℂ)*(G (w i)-G z) := by
    rw [Complex.ofReal_sum,Finset.sum_mul,←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    ring
  have hB : (∑ i∈S,(c i:ℂ)*(G (w i)-G z)).re≤(∑ i∈S,|c i|)*E := calc
    _ ≤ ‖∑ i∈S,(c i:ℂ)*(G (w i)-G z)‖ := Complex.re_le_norm _
    _ ≤ ∑ i∈S,‖(c i:ℂ)*(G (w i)-G z)‖ := norm_sum_le _ _
    _ ≤ ∑ i∈S,|c i| *E := by
      apply Finset.sum_le_sum
      intro i hi
      rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_left (hE i hi) (abs_nonneg _)
    _ = _ := by rw [Finset.sum_mul]
  rw [hModel,Complex.add_re,Complex.re_ofReal_mul]
  exact add_le_add (mul_le_mul_of_nonneg_left hG hc) hB

end

end GoldbachPintzWeightedFormula
