theorem V19y (ε : ℝ) (hε : 0 < ε) :
    ∃ Q₀ : ℕ, ∀ Q ≥ Q₀, ∀ n : ℕ, Even n → ∀ w : ℕ → ℝ, Monotone w →
      (∀ q, 0 ≤ w q) → w Q ≤ 2 →
      (∀ q ∈ Icc 1 Q, w q ≤ (q:ℝ)/(Q:ℝ)) →
      -ε ≤ ∑ q ∈ Icc 1 Q, (Vm.F n q / (q:ℝ)) * w q := by
