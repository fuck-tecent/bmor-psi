theorem log_power_le_small_power (k : ℕ) {δ : ℝ} (hδ : 0 < δ) :
    ∃ C : ℝ, 0 < C ∧ ∀ x : ℝ, 1 ≤ x → (1 + Real.log x)^k ≤ C*x^δ := by
  by_cases hk : k = 0
  · subst k
    refine ⟨1, by norm_num, fun x hx => ?_⟩
    simpa only [pow_zero, one_mul] using Real.one_le_rpow hx hδ.le
  have hk' : (0:ℝ) < k := by exact_mod_cast Nat.pos_of_ne_zero hk
  let e := δ / (k : ℝ)
  have he : 0 < e := div_pos hδ hk'
  refine ⟨(1+e⁻¹)^k, by positivity, fun x hx => ?_⟩
  have hp : 0 < x := zero_lt_one.trans_le hx
  have hX : 1 ≤ x^e := Real.one_le_rpow hx he.le
  have h := Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hp e)
  rw [Real.log_rpow hp] at h
  have hlog : Real.log x ≤ x^e/e := (le_div_iff₀ he).mpr (by linarith only [h])
  have h₁ : 1+Real.log x ≤ (1+e⁻¹)*x^e := by
    rw [add_mul, one_mul, mul_comm e⁻¹, ← div_eq_mul_inv]
    linarith only [hX, hlog]
  calc
    _ ≤ ((1+e⁻¹)*x^e)^k := pow_le_pow_left₀ (by positivity [Real.log_nonneg hx]) h₁ _
    _ = _ := by
      rw [mul_pow, ← Real.rpow_mul_natCast hp.le, show e*(k:ℝ) = δ by dsimp [e]; field_simp]

