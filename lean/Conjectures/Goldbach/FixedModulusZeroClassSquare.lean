open scoped BigOperators

namespace GoldbachSignedPairs

open Finset
open scoped Classical

private theorem class_squared_eq_pair_sum {ι κ : Type*} (S : Finset ι) (key : ι → κ)
    (a : ι → ℝ) :
    classMassSq S key a =
      ∑ i∈S, ∑ j∈S, if key i=key j then a i*a j else 0 := by
  classical
  let B (c : κ) : ℝ := ∑ i∈S.filter (fun i=>key i=c),a i
  have hRow (i : ι) :
      (∑ j∈S,if key i=key j then a i*a j else 0)=a i*B (key i) := by
    rw [show B (key i)=∑ j∈S.filter (fun j=>key j=key i),a j from rfl,Finset.mul_sum,
      Finset.sum_filter]
    apply sum_congr rfl
    intro j _
    by_cases h : key i=key j
    · rw [ite_eq_left h,ite_eq_left h.symm]
    · rw [ite_eq_right h,ite_eq_right (Ne.symm h)]
  unfold classMassSq
  change (∑ c∈S.image key,(B c)^2)=_
  simp_rw [hRow]
  rw [←Finset.sum_fiberwise_of_maps_to (fun i hi=>Finset.mem_image_of_mem key hi)
    (fun i=>a i*B (key i))]
  apply sum_congr rfl
  intro c _
  calc
    (B c)^2 = (∑ i∈S.filter (fun i=>key i=c),a i*B c) := by
      rw [←sum_mul]
      exact sq _
    _ = _ := by
      apply sum_congr rfl
      intro i hi
      rw [(mem_filter.mp hi).2]

end GoldbachSignedPairs

open GoldbachSignedPairs

set_option maxHeartbeats 1800000 in
/-- For a common modulus, the multiplicity-weighted near-one zero mass squared
within the classes of conductor ratios dividing `K!` has a uniform bound
strictly below one. -/
theorem Conjectures.Goldbach.FixedModulusZeroClassSquare :
    ∃ θ : ℝ, 0 ≤ θ ∧ θ < 1 ∧ ∀ (K : ℕ) (H T : ℝ), ∃ q₀ : ℕ,
      ∀ (q : ℕ), q₀ ≤ q → ∀ [NeZero q] (S : Finset (DirichletCharacter ℂ q × ℂ)),
        (∀ p ∈ S, p.1 ≠ 1 ∧ (1/2 : ℝ) < p.2.re ∧ |p.2.im| ≤ T ∧
          p.1.LFunction p.2 = 0 ∧ (1 - p.2.re) * Real.log (q : ℝ) ≤ H) →
        let a (p : DirichletCharacter ℂ q × ℂ) : ℝ :=
          (analyticOrderNatAt p.1.LFunction p.2 : ℝ) *
            (q : ℝ) ^ ((493/100 : ℝ) * (p.2.re - 1))
        (Finset.sum S fun p => Finset.sum S fun r =>
          if (p.1 / r.1).conductor ∣ K.factorial then a p * a r else 0) ≤ θ := by
  classical
  obtain ⟨θ,hθ₀,hθ₁,hB⟩ := fixedModulusClassBound_of_no_siegel PEqualNP.Outside.L_goldbach_frontier_no_siegel_zero
  refine ⟨θ,hθ₀,hθ₁,?_⟩
  intro K H T
  obtain ⟨q₀,hq₀⟩ := hB K H T
  refine ⟨q₀,?_⟩
  intro q hq _ S hS
  dsimp only
  let a (p : DirichletCharacter ℂ q × ℂ) : ℝ :=
    (analyticOrderNatAt p.1.LFunction p.2 : ℝ) *
      (q : ℝ) ^ ((493/100 : ℝ) * (p.2.re - 1))
  let key (p : DirichletCharacter ℂ q × ℂ) := GoldbachSignedPairs.conductorClass K p.1
  have hSub : S ⊆ GoldbachSignedPairs.modulusZeros q H T := by
    intro p hp
    obtain ⟨hχ,hRe,hIm,hZero,hGap⟩ := hS p hp
    exact GoldbachSignedPairs.mem_fixed_modulus_zeros.mpr ⟨hχ,
      (GoldbachTwistedMellin.mem_exceptionalZeros _ _ _).mpr
        ⟨hRe,hIm,by simpa only [Goldbach.regularizedL,hχ,ite_false] using hZero⟩,hGap⟩
  have hWeights (p : DirichletCharacter ℂ q × ℂ) (hp : p∈S) :
      a p = GoldbachSignedPairs.modulusModeMass q p := by
    simp only [a,GoldbachSignedPairs.modulusModeMass,Goldbach.regularizedL,(hS p hp).1,ite_false]
  have ha (p : DirichletCharacter ℂ q × ℂ) : 0≤a p := by
    dsimp [a]
    positivity
  have hMass : GoldbachSignedPairs.classMassSq S key a ≤
      GoldbachSignedPairs.modulusClassMassSquare q K H T := by
    unfold GoldbachSignedPairs.modulusClassMassSquare
    exact GoldbachSignedPairs.classMassSq_le_of_injection
      (S:=S) (D:=GoldbachSignedPairs.modulusZeros q H T)
      (f:=id) (key:=key) (key':=key) (a:=a) (b:=GoldbachSignedPairs.modulusModeMass q)
      (fun _ hp=>hSub hp) (fun _ _ _ _ h=>h) (fun _ _=>rfl) (fun p _=>ha p)
      (fun p _=>GoldbachSignedPairs.modulusModeMass_nonneg p)
      (fun p hp=>(hWeights p hp).le)
  have hPair := GoldbachSignedPairs.class_squared_eq_pair_sum S key a
  simp only [key,GoldbachSignedPairs.conductorClass_eq_iff] at hPair
  exact hPair.symm.trans_le (hMass.trans (hq₀ q hq inferInstance))


namespace GoldbachSignedPairs

open Finset

set_option maxHeartbeats 1800000 in
/-- Adapt the public weighted pair bound to the fixed-modulus interface
used by the signed major-arc expansion. -/
theorem fixedModulusClassBound_via_public_square
    :
    ∃ θ : ℝ, 0 ≤ θ ∧ θ < 1 ∧ FixedModulusClassBound θ := by
  classical
  obtain ⟨θ,hθ₀,hθ₁,h⟩ := Conjectures.Goldbach.FixedModulusZeroClassSquare
  refine ⟨θ,hθ₀,hθ₁,?_⟩
  intro K H T
  obtain ⟨q₀,hq₀⟩ := h K H T
  refine ⟨q₀,?_⟩
  intro q hq inst
  let _ : NeZero q := inst
  let S := modulusZeros q H T
  let a (p : DirichletCharacter ℂ q × ℂ) : ℝ :=
    (analyticOrderNatAt p.1.LFunction p.2 : ℝ) *
      (q : ℝ) ^ ((493/100 : ℝ) * (p.2.re - 1))
  let key (p : DirichletCharacter ℂ q × ℂ) := conductorClass K p.1
  have hS (p : DirichletCharacter ℂ q × ℂ) (hp : p∈S) :
      p.1 ≠ 1 ∧ (1/2 : ℝ) < p.2.re ∧ |p.2.im| ≤ T ∧ p.1.LFunction p.2 = 0 ∧
        (1 - p.2.re) * Real.log (q : ℝ) ≤ H := by
    obtain ⟨hχ,hz,hgap⟩ := mem_fixed_modulus_zeros.mp hp
    obtain ⟨hRe,hIm,hz⟩ := (GoldbachTwistedMellin.mem_exceptionalZeros _ _ _).mp hz
    exact ⟨hχ,hRe,hIm,by simpa only [Goldbach.regularizedL,hχ,ite_false] using hz,hgap⟩
  have hWeight (p : DirichletCharacter ℂ q × ℂ) (hp : p∈S) : modulusModeMass q p = a p := by
    simp only [modulusModeMass,a,Goldbach.regularizedL,(hS p hp).1,ite_false]
  have hC := class_squared_eq_pair_sum S key (modulusModeMass q)
  simp only [key,conductorClass_eq_iff] at hC
  calc
    _ = ∑ p∈S, ∑ r∈S, if (p.1/r.1).conductor ∣ K.factorial then
        modulusModeMass q p*modulusModeMass q r else 0 := hC
    _ = ∑ p∈S, ∑ r∈S, if (p.1/r.1).conductor ∣ K.factorial then a p*a r else 0 := by
      apply sum_congr rfl
      intro p hp
      apply sum_congr rfl
      intro r hr
      rw [hWeight p hp,hWeight r hr]
    _ ≤ θ := hq₀ q hq S hS

end GoldbachSignedPairs
