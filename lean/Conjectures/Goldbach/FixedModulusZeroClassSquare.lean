noncomputable section

private theorem powerEuler_norm {p : ℕ} (hp : p.Prime) {z : ℂ} (hz : 1/2≤z.re) :
    ‖(p:ℂ)^(-z)‖≤(p:ℝ)^(-(1/2):ℝ) := by
  rw [Complex.norm_natCast_cpow_of_pos hp.pos,Complex.neg_re]
  exact Real.rpow_le_rpow_of_exponent_le (by exact_mod_cast hp.one_lt.le) (neg_le_neg hz)

private theorem powerEuler_bound {p : ℕ} (hp : p.Prime) :
    (p:ℝ)^(-(1/2):ℝ)≤3/4 := by
  have hp2 : (2:ℝ)≤p := by exact_mod_cast hp.two_le
  calc
    _ ≤ (2:ℝ)^(-(1/2):ℝ) :=
      Real.rpow_le_rpow_of_nonpos (by norm_num) hp2 (by norm_num)
    _ = (Real.sqrt 2)⁻¹ := by rw [Real.rpow_neg (by norm_num),Real.sqrt_eq_rpow]
    _ ≤ _ := (inv_le_iff_one_le_mul₀ (Real.sqrt_pos.2 (by norm_num))).2 (by
      have hh := Real.sq_sqrt (show (0:ℝ)≤2 by norm_num)
      nlinarith only [hh,Real.sqrt_nonneg 2])

set_option maxHeartbeats 1100000 in
private theorem powerEuler_hasDeriv {p : ℕ} (hp : p.Prime) (z : ℂ) :
    HasDerivAt (fun w=>1-(p:ℂ)^(-w)) (Complex.log (p:ℂ)*((p:ℂ)^(-z))) z := by
  let a := Complex.log (p:ℂ)
  have hp0 : (p:ℂ)≠0 := by exact_mod_cast hp.ne_zero
  have hcp (w : ℂ) : (p:ℂ)^(-w)=Complex.exp ((-a)*w) := by
    rw [Complex.cpow_def_of_ne_zero hp0]
    congr 1
    unfold a
    ring
  have hd : HasDerivAt (fun w=>1-Complex.exp ((-a)*w))
      (-(Complex.exp ((-a)*z)*((-a)*1))) z :=
    (((hasDerivAt_id' z).const_mul (-a)).cexp).const_sub 1
  have he : -(Complex.exp ((-a)*z)*((-a)*1))=a*Complex.exp ((-a)*z) := by ring
  rw [he] at hd
  simp_rw [hcp]
  exact hd

private theorem powerEuler_ne_zero {p : ℕ} (hp : p.Prime) {z : ℂ} (hz : 1/2≤z.re) :
    1-(p:ℂ)^(-z)≠0 := by
  have h := (powerEuler_norm hp hz).trans (powerEuler_bound hp)
  intro he
  rw [(sub_eq_zero.mp he).symm,norm_one] at h
  norm_num at h

private def deletedEulerLogDeriv (q : ℕ) (z : ℂ) : ℂ :=
    ∑ p∈q.primeFactors, Complex.log (p:ℂ)*((p:ℂ)^(-z))/(1-(p:ℂ)^(-z))

private theorem deletedEulerLogDeriv_eq {q : ℕ} [NeZero q] {z : ℂ} (hz : 1<z.re) :
    -logDeriv (LFunctionTrivChar q) z =
      -logDeriv (LFunctionTrivChar 1) z-deletedEulerLogDeriv q z := by
  let F (p : ℕ) (w : ℂ) := 1-(p:ℂ)^(-w)
  let P (w : ℂ) := ∏ p∈q.primeFactors,F p w
  have hz1 : z≠1 := by intro h; simp [h] at hz
  have hO : IsOpen ({1} : Set ℂ)ᶜ := isClosed_singleton.isOpen_compl
  have he : (LFunctionTrivChar q) =ᶠ[𝓝 z] fun w=>P w*riemannZeta w := by
    have hmem : z∈({1} : Set ℂ)ᶜ := by simpa using hz1
    filter_upwards [hO.mem_nhds hmem] with w hw
    exact LFunctionTrivChar_eq_mul_riemannZeta (by simpa using hw)
  have hF (p : ℕ) (hp : p∈q.primeFactors) : F p z≠0 :=
    powerEuler_ne_zero (Nat.prime_of_mem_primeFactors hp) (by linarith)
  have hFd (p : ℕ) (hp : p∈q.primeFactors) : DifferentiableAt ℂ (F p) z :=
    (powerEuler_hasDeriv (Nat.prime_of_mem_primeFactors hp) z).differentiableAt
  have hP : P z≠0 := Finset.prod_ne_zero_iff.mpr hF
  have hd : DifferentiableAt ℂ P z := DifferentiableAt.fun_finsetProd (fun p hp=>hFd p hp)
  have hLd : logDeriv (LFunctionTrivChar q) z=logDeriv P z+logDeriv riemannZeta z := by
    have hE : logDeriv (LFunctionTrivChar q) z = logDeriv (fun w=>P w*riemannZeta w) z := by
      simp only [logDeriv,Pi.div_apply,he.eq_of_nhds,he.deriv_eq]
    exact hE.trans (logDeriv_mul z hP (riemannZeta_ne_zero_of_one_lt_re hz) hd
      (differentiableAt_riemannZeta hz1))
  have hPF : logDeriv P z=deletedEulerLogDeriv q z := by
    unfold P deletedEulerLogDeriv
    rw [logDeriv_fun_prod hF hFd]
    apply Finset.sum_congr rfl
    intro p hp
    simp only [logDeriv,Pi.div_apply,F,(powerEuler_hasDeriv (Nat.prime_of_mem_primeFactors hp) z).deriv]
  rw [hLd,hPF]
  simp only [LFunctionTrivChar,LFunction_modOne_eq]
  ring

private theorem deletedEulerLogDeriv_analytic {q : ℕ} {z : ℂ} (hz : 1/2≤z.re) :
    AnalyticAt ℂ (deletedEulerLogDeriv q) z := by
  unfold deletedEulerLogDeriv
  apply q.primeFactors.analyticAt_fun_sum
  intro p hp
  have hp' := Nat.prime_of_mem_primeFactors hp
  have hp0 : (p:ℂ)≠0 := by exact_mod_cast hp'.ne_zero
  have hpow : AnalyticAt ℂ (fun w=>(p:ℂ)^(-w)) z := by
    simp_rw [Complex.cpow_def_of_ne_zero hp0]
    fun_prop
  exact (analyticAt_const.fun_mul hpow).fun_div (analyticAt_const.fun_sub hpow)
    (powerEuler_ne_zero hp' hz)

private theorem deletedEulerLogDeriv_norm {q : ℕ} {z : ℂ} (hz : 1/2≤z.re) :
    ‖deletedEulerLogDeriv q z‖ ≤
      4*(∑ p∈q.primeFactors, Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ)) := by
  unfold deletedEulerLogDeriv
  apply (norm_sum_le _ _).trans
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro p hp
  have hp' := Nat.prime_of_mem_primeFactors hp
  have hp0 : (0:ℝ)<p := by exact_mod_cast hp'.pos
  have hp1 : (1:ℝ)≤p := by exact_mod_cast hp'.one_lt.le
  have hlog : ‖Complex.log (p:ℂ)‖=Real.log (p:ℝ) := by
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hp0.le,Complex.norm_real,Real.norm_eq_abs,
      abs_of_nonneg (Real.log_nonneg hp1)]
  have hn1 := powerEuler_norm hp' hz
  have hn2 : 1/4≤‖1-(p:ℂ)^(-z)‖ := by
    have hh := norm_le_norm_sub_add (1:ℂ) ((p:ℂ)^(-z))
    rw [norm_one] at hh
    linarith only [hh,hn1,powerEuler_bound hp']
  rw [norm_div,norm_mul,hlog]
  calc
    _ ≤ (Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ))/‖1-(p:ℂ)^(-z)‖ :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hn1 (Real.log_nonneg hp1)) (norm_nonneg _)
    _ ≤ (Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ))/(1/4:ℝ) :=
      div_le_div_of_nonneg_left (by positivity) (by norm_num) hn2
    _ = _ := by ring

/-- Removing Euler factors at the common level changes the principal
logarithmic derivative by the mass of the excluded primes. -/
theorem principal_logDeriv_level_error {q : ℕ} [NeZero q] {z : ℂ} (hz : 1<z.re) :
    ‖(-logDeriv (LFunctionTrivChar q) z)-(-logDeriv (LFunctionTrivChar 1) z)‖≤
      4*(∑ p∈q.primeFactors, Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ)) := by
  rw [deletedEulerLogDeriv_eq hz,sub_sub_cancel_left,norm_neg]
  exact deletedEulerLogDeriv_norm (by linarith only [hz])

private theorem rationalLogJet_eventually_sub {D E G : ℂ→ℂ} {w c : ℂ}
    (hE : AnalyticAt ℂ E w) (hG : AnalyticAt ℂ G w)
    (he : D =ᶠ[𝓝 w] fun z=>G z-E z) :
    rationalLogJet D c w=rationalLogJet G c w-rationalLogJet E c w := by
  unfold rationalLogJet
  rw [he.eq_of_nhds,he.deriv_eq,he.iteratedDeriv_eq 2]
  rw [deriv_fun_sub hG.differentiableAt hE.differentiableAt,
    iteratedDeriv_fun_sub hG.contDiffAt hE.contDiffAt]
  ring

set_option maxHeartbeats 1200000 in
/-- Raising the principal level from one to q costs only the conductor
prime logarithms with a decaying factor. -/
theorem rational_prime_test_principal_level_error {b : ℝ} (hb : 0<b)
    {q : ℕ} [NeZero q] {L : ℝ} {s : ℂ} (hL : 1≤L) (hs : 1<s.re+b/L) :
    ‖rationalPrimeTest (1:DirichletCharacter ℂ q) b L s -
      rationalPrimeTest (1:DirichletCharacter ℂ 1) b L s‖ ≤
      (4*(1+2*b+(8/3:ℝ)*b^2)) *
      (∑ p∈q.primeFactors, Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ)) := by
  let w := s+((b/L:ℝ):ℂ)
  let c : ℂ := ((b/L:ℝ):ℂ)
  let E := deletedEulerLogDeriv q
  let D := fun z=>-logDeriv (LFunctionTrivChar q) z
  let G := fun z=>-logDeriv (LFunctionTrivChar 1) z
  let M := 4*(∑ p∈q.primeFactors, Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ))
  have hw : 1<w.re := by simpa [w] using hs
  have hLpos : 0<L := zero_lt_one.trans_le hL
  have hM : 0≤M := by
    unfold M
    exact mul_nonneg (by norm_num) (Finset.sum_nonneg fun p _=>mul_nonneg (Real.log_natCast_nonneg p) (by positivity))
  have hE : AnalyticOnNhd ℂ E (closedBall w (1/2)) := by
    intro z hz
    have h := mem_closedBall_iff_norm.mp hz
    have hh := Complex.abs_re_le_norm (z-w)
    rw [Complex.sub_re] at hh
    exact deletedEulerLogDeriv_analytic (by linarith only [h,hh,neg_le_abs (z.re-w.re),hw])
  have hE0 : ∀ z∈closedBall w (1/2), ‖E z‖≤M := by
    intro z hz
    have h := mem_closedBall_iff_norm.mp hz
    have hh := Complex.abs_re_le_norm (z-w)
    rw [Complex.sub_re] at hh
    exact deletedEulerLogDeriv_norm (by linarith only [h,hh,neg_le_abs (z.re-w.re),hw])
  have hG : AnalyticAt ℂ G w := by
    have hw1 : w≠1 := by intro he; simp [he] at hw
    have hζ : AnalyticAt ℂ riemannZeta w := by
      have hD : DifferentiableOn ℂ riemannZeta ({1}:Set ℂ)ᶜ :=
        fun z hz=>(differentiableAt_riemannZeta (by simpa using hz)).differentiableWithinAt
      exact (hD.analyticOnNhd isClosed_singleton.isOpen_compl) w (by simpa using hw1)
    unfold G
    simp only [LFunctionTrivChar,LFunction_modOne_eq]
    exact (hζ.deriv.fun_div hζ (riemannZeta_ne_zero_of_one_lt_re hw)).neg
  have hEq : D =ᶠ[𝓝 w] fun z=>G z-E z := by
    have hO : IsOpen {z : ℂ | 1<z.re} := isOpen_lt continuous_const Complex.continuous_re
    have hmem : w∈{z : ℂ | 1<z.re} := hw
    filter_upwards [hO.mem_nhds hmem] with z hz
    exact deletedEulerLogDeriv_eq hz
  have hJet := rationalLogJet_eventually_sub (hE w (mem_closedBall_self (by norm_num))) hG hEq (c:=c)
  rw [rationalPrimeTest_eq_logJet _ b L s hw,rationalPrimeTest_eq_logJet _ b L s hw]
  change ‖rationalLogJet D c w-rationalLogJet G c w‖ ≤ _
  rw [hJet,sub_right_comm,sub_self,zero_sub,norm_neg]
  have hcNorm : ‖c‖=b/L := by simp [c,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hb,abs_of_pos hLpos]
  have hc : ‖c‖≤b := by rw [hcNorm]; exact div_le_self hb.le hL
  have hC := rationalLogJet_analytic_error (by norm_num : 0<(1/2:ℝ)) hE hE0 c
  have hEW := hE0 w (mem_closedBall_self (by norm_num))
  calc
    ‖rationalLogJet E c w‖ =
        ‖(rationalLogJet E c w-E w)+E w‖ := by rw [sub_add_cancel]
    _ ≤ ‖rationalLogJet E c w-E w‖+‖E w‖ := norm_add_le _ _
    _ ≤ ‖c‖*M/(1/2)+(2/3:ℝ)*‖c‖^2*M/(1/2)^2+M := add_le_add hC hEW
    _ ≤ b*M/(1/2)+(2/3:ℝ)*b^2*M/(1/2)^2+M := by gcongr
    _ = _ := by unfold M; ring

end

end GoldbachPintzWeightedFormula
end

