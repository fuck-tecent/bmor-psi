        (a i*conj (a j))*(y : ℂ)^(ρ i+conj (ρ j))) volume X (4*X) := by
    apply IntervalIntegrable.const_mul
    apply intervalIntegral.intervalIntegrable_cpow
    left
    simp only [Complex.add_re, Complex.conj_re]
    exact add_nonneg (hρ i hi) (hρ j hj)
  calc
    _ = ∫ y in X..4*X, ((‖∑ i∈S, a i*(y : ℂ)^(ρ i)‖^2 : ℝ) : ℂ) :=
      intervalIntegral.integral_ofReal.symm
    _ = ∫ y in X..4*X,
        ∑ i∈S, ∑ j∈S, (a i*conj (a j))*(y : ℂ)^(ρ i+conj (ρ j)) := by
      apply intervalIntegral.integral_congr_Ioo_of_le (by linarith)
      intro y hy
      exact V1xy S a ρ y (hX.trans hy.1)
    _ = ∑ i∈S, ∫ y in X..4*X,
        ∑ j∈S, (a i*conj (a j))*(y : ℂ)^(ρ i+conj (ρ j)) := by
