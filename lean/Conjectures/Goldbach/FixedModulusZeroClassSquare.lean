noncomputable section

private theorem rational_prime_term_shift {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L : ℝ) (s : ℂ) (n : ℕ) :
    term (twistedCoefficient χ) s n*(rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)=
      term (twistedCoefficient χ) (s+((b/L:ℝ):ℂ)) n *
       (1+((b/L:ℝ):ℂ)*Complex.log (n:ℂ)+(((b/L:ℝ):ℂ)*Complex.log (n:ℂ))^2/3) := by
  by_cases hn : n=0
  · subst n
    simp
  have hn' : (0:ℝ)<n := by exact_mod_cast Nat.pos_of_ne_zero hn
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn
  simp only [term_of_ne_zero hn]
  have h0 : (n:ℂ)^(s+((b/L:ℝ):ℂ))=((n:ℂ)^s)*cexp ((Real.log (n:ℝ)*(b/L):ℝ):ℂ) := by
    rw [Complex.cpow_add _ _ hn0,Complex.cpow_def_of_ne_zero hn0 ((_ : ℝ):ℂ)]
    congr 2
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn'.le,Complex.ofReal_mul]
  rw [h0,div_mul_eq_div_div]
  have hlog : Complex.log (n:ℂ)=((Real.log (n:ℝ)):ℂ) := by
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hn'.le]
  simp only [hlog,div_eq_mul_inv,←Complex.exp_neg]
  unfold rationalPrimeWeight
  rw [Complex.ofReal_mul,Complex.ofReal_exp]
  push_cast
  have hm : (b:ℂ)*(Complex.log (n:ℂ)*(L:ℂ)⁻¹) =
      Complex.log (n:ℂ)*((b:ℂ)*(L:ℂ)⁻¹) := by ring
  rw [hm]
  ring

private theorem rational_prime_terms_summable {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L : ℝ) (s : ℂ) (hs : 1<s.re+b/L) :
    Summable (fun n : ℕ => term (twistedCoefficient χ) s n*
      (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)) := by
  let a := twistedCoefficient χ
  let w := s+((b/L:ℝ):ℂ)
  let c : ℂ := ((b/L:ℝ):ℂ)
  have hw : 1<w.re := by simpa [w] using hs
  have hab : abscissaOfAbsConv a ≤ ((1:ℝ):EReal) :=
    abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun z hz=>
      χ.LSeriesSummable_twist_vonMangoldt hz)
  have hσ : abscissaOfAbsConv a < (w.re:EReal) := hab.trans_lt (by exact_mod_cast hw)
  have ha : Summable (term a w) := χ.LSeriesSummable_twist_vonMangoldt hw
  have hb : Summable (term (logMul a) w) := LSeriesSummable_logMul_of_lt_re hσ
  have hk : Summable (term (logMul (logMul a)) w) := LSeriesSummable_logMul_of_lt_re
    (by simpa using hσ : abscissaOfAbsConv (logMul a) < (w.re:EReal))
  refine ((ha.add (hb.mul_left c)).add (hk.mul_left (c^2/3))).congr ?_
  intro n
  rw [rational_prime_term_shift]
  change term a w n+c*term (logMul a) w n+c^2/3*term (logMul (logMul a)) w n=_
  by_cases hn : n=0
  · subst n
    simp
  · simp only [term_of_ne_zero hn,logMul,c,a,w]
    ring

theorem tendsto_rational_primeSum {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L σ t : ℝ) (hs : 1<σ+b/L) :
    Tendsto (fun N : ℕ => primeSum (Finset.range N)
      (fun n=>rationalPrimeWeight b (Real.log (n:ℝ)/L)) χ σ t) atTop
      (𝓝 ((rationalPrimeTest χ b L (line σ t)).re)) := by
  have h := (rational_prime_terms_summable χ b L (line σ t) (by simpa [line,Complex.mul_re] using hs)).hasSum.tendsto_sum_nat
  have hr := Complex.continuous_re.continuousAt.tendsto.comp h
  refine hr.congr (fun N => ?_)
  change (∑ n∈Finset.range N, term (twistedCoefficient χ) (line σ t) n*
      (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)).re = _
  change Complex.reAddGroupHom (∑ n∈Finset.range N, term (twistedCoefficient χ) (line σ t) n*
      (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)) = _
  rw [map_sum]
  unfold primeSum
  apply Finset.sum_congr rfl
  intro n _
  by_cases hn : n=0
  · subst n
    simp
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn
  have he : -(line σ t)=((-σ:ℝ):ℂ)+(-(t:ℂ)*I) := by push_cast; unfold line; ring
  change (term (twistedCoefficient χ) (line σ t) n*(rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ)).re=_
  rw [term_of_ne_zero hn,div_eq_mul_inv,
    ←Complex.cpow_neg,he,Complex.cpow_add _ _ hn0,←Complex.ofReal_natCast,
    ←Complex.ofReal_cpow (Nat.cast_nonneg n)]
  simp only [twistedCoefficient,Pi.mul_apply]
  have hMul : χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)*
       (((n:ℝ)^(-σ):ℝ):ℂ)*((n:ℝ):ℂ)^(-(t:ℂ)*I)*
       (rationalPrimeWeight b (Real.log (n:ℝ)/L):ℂ) =
      (((rationalPrimeWeight b (Real.log (n:ℝ)/L))*ArithmeticFunction.vonMangoldt n*
          (n:ℝ)^(-σ):ℝ):ℂ)*
      (χ (n:ZMod q)*((n:ℝ):ℂ)^(-(t:ℂ)*I)) := by push_cast; ring
  rw [←mul_assoc (χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)),hMul]
  simp [Complex.mul_re]

private theorem rational_primeWeight_nat_nonneg {b L : ℝ} (hb : 0<b) (hL : 0<L) (n : ℕ) :
    0≤rationalPrimeWeight b (Real.log (n:ℝ)/L) :=
  rationalPrimeWeight_nonneg hb.le (div_nonneg (Real.log_natCast_nonneg n) hL.le)

set_option maxHeartbeats 1300000 in
/-- Heath–Brown's degree-four trigonometric test for the actual rational prime sums. -/
theorem heathBrown_rational_primeTest_nonneg {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {b L σ t : ℝ} (hb : 0<b) (hL : 0<L) (hs : 1<σ+b/L) :
    0≤14379*(rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re+
      24480*(rationalPrimeTest χ b L (line σ t)).re+
      14900*(rationalPrimeTest (χ^2) b L (line σ (2*t))).re+
      6000*(rationalPrimeTest (χ^3) b L (line σ (3*t))).re+
      1250*(rationalPrimeTest (χ^4) b L (line σ (4*t))).re := by
  have h0 := tendsto_rational_primeSum (1:DirichletCharacter ℂ q) b L σ 0 hs
  have h1 := tendsto_rational_primeSum χ b L σ t hs
  have h2 := tendsto_rational_primeSum (χ^2) b L σ (2*t) hs
  have h3 := tendsto_rational_primeSum (χ^3) b L σ (3*t) hs
  have h4 := tendsto_rational_primeSum (χ^4) b L σ (4*t) hs
  have h := (((h0.const_mul (14379:ℝ)).add (h1.const_mul 24480)).add
    (h2.const_mul 14900)).add (h3.const_mul 6000) |>.add (h4.const_mul 1250)
  exact ge_of_tendsto' h fun N => heathBrown_primeSum_nonneg χ (Finset.range N) _
    (fun n _=>rational_primeWeight_nat_nonneg hb hL n) σ t


end

end GoldbachPintzWeightedFormula
