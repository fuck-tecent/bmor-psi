section
namespace GoldbachPintzNumerics

open Polynomial Complex Finset Set
open scoped Polynomial

noncomputable section

private theorem exponentialPulse_polynomial (P : ℝ[X]) (B t : ℝ) :
    exponentialPulse ((P^2).support) ((P^2).coeff) (fun i => B+(i:ℝ)) t=
      Real.exp (-B*t)*(P.eval (Real.exp (-t)))^2 := by
  rw [←eval_pow,Polynomial.eval_eq_sum]
  unfold Polynomial.sum exponentialPulse
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun i hi => ?_
  change (P^2).coeff i*Real.exp (-(B+(i:ℝ))*t)=
    Real.exp (-B*t)*((P^2).coeff i*Real.exp (-t)^i)
  rw [←Real.exp_nat_mul,show -(B+(i:ℝ))*t=-B*t+(i:ℝ)*(-t) by ring,Real.exp_add]
  ring

set_option maxHeartbeats 1100000 in
/-- Nonnegative finite exponentials approximate a continuous compact
pulse with an error decaying at any prescribed exponential rate. -/
theorem exists_positive_exponential_pulse_approx {B R ε : ℝ} (hB : 0<B)
    (hR : 0≤R) (hε : 0<ε) (G : ℝ→ℝ) (hG : Continuous G)
    (hG0 : ∀ t≥0, 0≤G t) (hsupp : ∀ t≥R, G t=0) :
    ∃ (S : Finset ℕ) (a b : ℕ→ℝ), (∀ i∈S,B≤b i) ∧
      (∀ t≥0, 0≤exponentialPulse S a b t) ∧
      ∀ t≥0, |exponentialPulse S a b t-G t|≤ε*Real.exp (-B*t) := by
  let X : ℝ := Real.exp (-R)
  let U (x : ℝ) : ℝ := max 0 (-Real.log (max x X))
  let f (x : ℝ) : ℝ := Real.sqrt (Real.exp (B*U x)*G (U x))
  have hX : 0<X := Real.exp_pos _
  have hU : Continuous U := by
    have hh : Continuous (fun x : ℝ=>max x X) := continuous_id.max continuous_const
    exact continuous_const.max ((hh.log (fun x=>ne_of_gt (lt_of_lt_of_le hX (le_max_right _ _)))).neg)
  have hf : Continuous f := (Real.continuous_sqrt.comp
    (((continuous_const.mul hU).rexp).mul (hG.comp hU)))
  obtain ⟨A,hA⟩ : ∃ A : ℝ, ∀ x∈Icc (0:ℝ) 1,f x≤A := by
    obtain ⟨A,hA⟩ := (isCompact_Icc.image_of_continuousOn hf.continuousOn).bddAbove
    exact ⟨A,fun x hx => hA (Set.mem_image_of_mem f hx)⟩
  let D : ℝ := max 1 A
  have hD1 : (1:ℝ)≤D := le_max_left _ _
  have hD0 : 0<D := zero_lt_one.trans_le hD1
  let η : ℝ := min 1 (ε/(2*D+1))
  have hη : 0<η := lt_min one_pos (div_pos hε (by positivity))
  have hη1 : η≤1 := min_le_left _ _
  have hηD : η*(2*D+1)≤ε :=
    (le_div_iff₀ (show 0<2*D+1 by positivity)).mp (min_le_right _ _)
  obtain ⟨P,hP⟩ := exists_polynomial_near_of_continuousOn 0 1 f hf.continuousOn η hη
  refine ⟨(P^2).support,(P^2).coeff,fun i=>B+(i:ℝ),fun i _=>le_add_of_nonneg_right (Nat.cast_nonneg i),?_,?_⟩
  · intro t _
    rw [exponentialPulse_polynomial]
    positivity
  intro t ht
  have hXt : Real.exp (-t)∈Icc (0:ℝ) 1 :=
    ⟨(Real.exp_pos _).le,Real.exp_le_one_iff.mpr (neg_nonpos.mpr ht)⟩
  have hPt := (hP _ hXt).le
  have hUeq : U (Real.exp (-t))=min t R := by
    unfold U X
    by_cases h : t≤R
    · rw [max_eq_left (Real.exp_le_exp.mpr (neg_le_neg h)),Real.log_exp,neg_neg,max_eq_right ht,
        min_eq_left h]
    · have h' := le_of_not_ge h
      rw [max_eq_right (Real.exp_le_exp.mpr (neg_le_neg h')),Real.log_exp,neg_neg,max_eq_right hR,
        min_eq_right h']
  have hf₀ : 0≤f (Real.exp (-t)) := Real.sqrt_nonneg _
  have hfD : f (Real.exp (-t))≤D := (hA _ hXt).trans (le_max_right _ _)
  have hEP : Real.exp (-B*t)*(f (Real.exp (-t)))^2=G t := by
    unfold f
    rw [hUeq,Real.sq_sqrt (mul_nonneg (Real.exp_pos _).le (hG0 _ (le_min ht hR)))]
    by_cases h : t≤R
    · rw [min_eq_left h,←mul_assoc,←Real.exp_add,show -B*t+B*t=0 by ring,Real.exp_zero,one_mul]
    · rw [min_eq_right (le_of_not_ge h),hsupp R le_rfl,hsupp t (le_of_not_ge h),mul_zero,mul_zero]
  have hPabs : |P.eval (Real.exp (-t))|≤D+1 := calc
    _ = |(P.eval (Real.exp (-t))-f (Real.exp (-t)))+f (Real.exp (-t))| := by
      rw [sub_add_cancel]
    _ ≤ |P.eval (Real.exp (-t))-f (Real.exp (-t))|+|f (Real.exp (-t))| := abs_add_le _ _
    _ ≤ _ := by rw [abs_of_nonneg hf₀]; linarith only [hPt,hη1,hfD]
  have hSquare : |(P.eval (Real.exp (-t)))^2-(f (Real.exp (-t)))^2|≤ε := calc
    _ = |P.eval (Real.exp (-t))-f (Real.exp (-t))| *
        |P.eval (Real.exp (-t))+f (Real.exp (-t))| := by
      rw [←abs_mul]
      congr 1
      ring
    _ ≤ _ := by
      apply (mul_le_mul hPt ?_ (abs_nonneg _) hη.le).trans hηD
      exact (abs_add_le _ _).trans (by rw [abs_of_nonneg hf₀]; linarith only [hPabs,hfD])
  rw [exponentialPulse_polynomial,←hEP,←mul_sub,abs_mul,abs_of_nonneg (Real.exp_pos _).le,mul_comm ε]
  exact mul_le_mul_of_nonneg_left hSquare (Real.exp_pos _).le

end

end GoldbachPintzNumerics
end

section
namespace GoldbachPintzNumerics

open Complex Finset MeasureTheory Set

noncomputable section

private def nearBox (c η t : ℝ) : ℝ :=
  max 0 (min 1 ((c-t)/η))

private theorem nearBox_continuous (c η : ℝ) : Continuous (nearBox c η) :=
  continuous_const.max (continuous_const.min ((continuous_const.sub continuous_id).div_const η))

private theorem nearBox_nonneg (c η t : ℝ) : 0≤ nearBox c η t := le_max_left _ _

private theorem nearBox_le_one (c η t : ℝ) : nearBox c η t≤1 :=
  max_le zero_le_one (min_le_left _ _)

private theorem nearBox_eq_one {c η t : ℝ} (hη : 0<η) (ht : t≤c-η) :
    nearBox c η t=1 := by
  unfold nearBox
  rw [min_eq_left ((le_div_iff₀ hη).mpr (by linarith only [ht])),
    max_eq_right zero_le_one]

private theorem nearBox_eq_zero {c η t : ℝ} (hη : 0<η) (ht : c≤t) :
    nearBox c η t=0 := by
  unfold nearBox
  refine max_eq_left ((min_le_right _ _).trans (div_nonpos_of_nonpos_of_nonneg ?_ hη.le))
  linarith only [ht]

private theorem box_integral {x k : ℝ} :
    (∫ t : ℝ in Ioi 0, if t≤x then k else 0)=k*max x 0 := by
  change (∫ t : ℝ in Ioi 0,(Iic x).indicator (fun _ : ℝ=>k) t)=_
  rw [integral_indicator measurableSet_Iic,Measure.restrict_restrict measurableSet_Iic,
    inter_comm,show Ioi (0:ℝ)∩Iic x=Ioc 0 x by rfl,setIntegral_const,smul_eq_mul]
  change (volume (Ioc 0 x)).toReal*k=_
  rw [Real.volume_Ioc,sub_zero]
  by_cases hx : 0≤x
  · rw [ENNReal.toReal_ofReal hx,max_eq_left hx,mul_comm]
  · rw [ENNReal.ofReal_eq_zero.mpr (le_of_not_ge hx),ENNReal.toReal_zero,
      max_eq_right (le_of_not_ge hx),zero_mul,mul_zero]

private theorem box_integrable (x k : ℝ) :
    IntegrableOn (fun t : ℝ=>if t≤x then k else 0) (Ioi 0) := by
  change Integrable ((Iic x).indicator (fun _ : ℝ=>k)) (volume.restrict (Ioi 0))
  rw [integrable_indicator_iff measurableSet_Iic,IntegrableOn,
    Measure.restrict_restrict measurableSet_Iic,inter_comm,show Ioi (0:ℝ)∩Iic x=Ioc 0 x by rfl]
  apply integrable_const

private theorem exp_pulse_product_integrable {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S,0<b i) (u : ℝ) :
    IntegrableOn (fun t : ℝ=>exponentialPulse S a b (t+u)*exponentialPulse S a b t) (Ioi 0) := by
  unfold exponentialPulse
  simp_rw [Finset.sum_mul,Finset.mul_sum]
  refine integrable_finsetSum _ fun i hi=>integrable_finsetSum _ fun j hj=> ?_
  have hInt := (integrableOn_exp_mul_Ioi
    (a:=-(b i+b j)) (neg_lt_zero.mpr (add_pos (hb i hi) (hb j hj))) 0).const_mul
      (a i*a j*Real.exp (-(b i)*u))
  convert hInt using 1
  ext t
  rw [show -(b i)*(t+u)=-(b i)*t+ -(b i)*u by ring,
    show -(b i+b j)*t=-(b i)*t+ -(b j)*t by ring,Real.exp_add,Real.exp_add]
  ring

set_option maxHeartbeats 1250000 in
/-- For a finite pulse approximating the near-box profile, its time weight
lies between two triangular functions with a decaying upper error. -/
theorem exists_exponential_box_envelope {B c η ε : ℝ}
    (hB : 0<B) (hc : 0≤ c) (hη : 0<η) (hε : 0<ε) (hε1 : ε≤1) :
    ∃ (S : Finset ℕ) (a b : ℕ→ℝ), (∀ i∈S,B≤b i) ∧
      (∀ t≥0,0≤exponentialPulse S a b t) ∧
      ∀ u≥0,
      (1-ε)^2*max (c-η-u) 0≤exponentialAutoWeight S a b u ∧
      exponentialAutoWeight S a b u≤
        max (c-u) 0+(ε*(2*Real.exp (B*c)+ε)/(2*B))*Real.exp (-B*u) := by
  let G := nearBox c η
  obtain ⟨S,a,b,hb,hn,hApprox⟩ :=
    exists_positive_exponential_pulse_approx hB hc hε G (nearBox_continuous c η)
      (fun t _=>nearBox_nonneg c η t) (fun t ht=>nearBox_eq_zero hη ht)
  refine ⟨S,a,b,hb,hn,?_⟩
  intro u hu
  let g := exponentialPulse S a b
  let D := Real.exp (B*c)
  let E := ε*(2*D+ε)
  have hD : 0<D := Real.exp_pos _
  have hE : 0≤E := by unfold E; positivity
  have hB2 : 0<2*B := by positivity
  have hB' (i : ℕ) (hi : i∈S) := hB.trans_le (hb i hi)
  have hg0 (t : ℝ) (ht : 0≤t) : 0≤g t := hn t ht
  have hG0 (t : ℝ) : 0≤G t := nearBox_nonneg c η t
  have hG1 (t : ℝ) : G t≤1 := nearBox_le_one c η t
  have hh (t : ℝ) (ht : 0≤t) : |g t-G t|≤ε*Real.exp (-B*t) := hApprox t ht
  have hUp (t : ℝ) (ht : 0≤t) : g t≤G t+ε*Real.exp (-B*t) := by
    have r := le_abs_self (g t-G t)
    linarith only [r,hh t ht]
  have hGL (t : ℝ) : G t≤D*Real.exp (-B*t) := by
    by_cases ht : t≤c
    · refine (hG1 t).trans ?_
      rw [←Real.exp_zero,show (0:ℝ)=0 by rfl]
      unfold D
      rw [←Real.exp_add,Real.exp_le_exp]
      nlinarith only [mul_nonneg hB.le (sub_nonneg.mpr ht)]
    · rw [show G t=0 from nearBox_eq_zero hη (le_of_not_ge ht)]
      positivity
  have hMain (t : ℝ) (ht : t∈Ioi (0:ℝ)) :
      g (t+u)*g t≤(if t≤c-u then 1 else 0)+
        (E*Real.exp (-B*u))*Real.exp (-(2*B)*t) := by
    have ht0 := (mem_Ioi.mp ht).le
    have htU := add_nonneg ht0 hu
    have hA := mul_le_mul (hUp (t+u) htU) (hUp t ht0) (hg0 t ht0)
      (add_nonneg (hG0 _) (by positivity))
    have hCase : G (t+u)*G t≤(if t≤c-u then 1 else 0) := by
      split_ifs with h
      · exact (mul_le_mul_of_nonneg_right (hG1 (t+u)) (hG0 t)).trans
          (by simpa only [one_mul] using hG1 t)
      · rw [show G (t+u)=0 from nearBox_eq_zero hη (by linarith only [lt_of_not_ge h])]
        simp
    have hA₁ := mul_le_mul_of_nonneg_right (hGL (t+u)) (show 0≤ε*Real.exp (-B*t) by positivity)
    have hA₂ := mul_le_mul_of_nonneg_left (hGL t) (show 0≤ε*Real.exp (-B*(t+u)) by positivity)
    have hExp : Real.exp (-B*(t+u))*Real.exp (-B*t)=
        Real.exp (-B*u)*Real.exp (-(2*B)*t) := by
      rw [←Real.exp_add,←Real.exp_add]
      congr 1
      ring
    unfold E
    nlinarith only [hA,hCase,hA₁,hA₂, congrArg (fun x : ℝ=>ε*(2*D+ε)*x) hExp]
  have hLower (t : ℝ) (ht : t∈Ioi (0:ℝ)) :
      (if t≤c-η-u then (1-ε)^2 else 0)≤g (t+u)*g t := by
    have ht0 := (mem_Ioi.mp ht).le
    have htU := add_nonneg ht0 hu
    split_ifs with h
    · have hSmall (v : ℝ) (hv : 0≤v) (hvc : v≤c-η) : 1-ε≤g v := by
        have hOne : G v=1 := nearBox_eq_one hη hvc
        have hE₁ : Real.exp (-B*v)≤1 :=
          Real.exp_le_one_iff.mpr (by nlinarith only [mul_nonneg hB.le hv])
        have hE₂ := mul_le_mul_of_nonneg_left hE₁ hε.le
        have hAbs := neg_le_abs (g v-G v)
        linarith only [hE₂,hAbs,hh v hv,hOne]
      rw [pow_two]
      exact mul_le_mul (hSmall (t+u) htU (by linarith only [h]))
        (hSmall t ht0 (by linarith only [h,hu])) (sub_nonneg.mpr hε1) (hg0 (t+u) htU)
    · exact mul_nonneg (hg0 (t+u) htU) (hg0 t ht0)
  have hgI := exp_pulse_product_integrable S a b hB' u
  have hRight := (integrableOn_exp_mul_Ioi (neg_lt_zero.mpr hB2) 0).const_mul (E*Real.exp (-B*u))
  rw [exponentialAutoWeight_eq_integral S a b hB']
  constructor
  · rw [←box_integral (x:=c-η-u) (k:=(1-ε)^2)]
    exact setIntegral_mono_on (box_integrable _ _) hgI measurableSet_Ioi hLower
  · have h := setIntegral_mono_on hgI ((box_integrable (c-u) 1).add hRight) measurableSet_Ioi hMain
    change _≤(∫ t : ℝ in Ioi 0,(if t≤c-u then 1 else 0)+
      (E*Real.exp (-B*u))*Real.exp (-(2*B)*t)) at h
    rw [integral_add (box_integrable _ _) hRight,box_integral,one_mul,
      integral_const_mul,integral_exp_mul_Ioi (neg_lt_zero.mpr hB2),
      mul_zero,Real.exp_zero,neg_div_neg_eq] at h
    exact h.trans_eq (by unfold E D; ring)

end

end GoldbachPintzNumerics
end

