namespace GoldbachPintzNumerics

private theorem rational_kernel_increment_eq {b x m : ℝ} (hx : 0<b+x)
    (hm : 0≤ m) :
    realRationalZeroKernel b x-realRationalZeroKernel b (x+m) =
      (m/((b+x)*(b+x+m))) *
        (1+b*((b+x)⁻¹+(b+x+m)⁻¹)+
          (2*b^2/3)*((b+x)⁻¹^2+(b+x)⁻¹*(b+x+m)⁻¹+(b+x+m)⁻¹^2)) := by
  have hxm : 0<b+x+m := add_pos_of_pos_of_nonneg hx hm
  unfold realRationalZeroKernel
  rw [←add_assoc b x m]
  field_simp [hx.ne',hxm.ne'] <;> ring

/-- A fixed positive horizontal translation decreases the rational
kernel less when the original point is moved to the right. -/
theorem rational_kernel_increment_antitone {b x y m : ℝ}
    (hb : 0<b) (hx : 0<b+x) (hxy : x≤y) (hm : 0≤ m) :
    realRationalZeroKernel b y-realRationalZeroKernel b (y+m) ≤
      realRationalZeroKernel b x-realRationalZeroKernel b (x+m) := by
  have hXY : b+x≤b+y := by linarith only [hxy]
  have hy := hx.trans_le hXY
  have hxM := add_pos_of_pos_of_nonneg hx hm
  have hyM := add_pos_of_pos_of_nonneg hy hm
  have h1 := (inv_le_inv₀ hy hx).mpr hXY
  have h2 := (inv_le_inv₀ hyM hxM).mpr (add_le_add_left hXY m)
  have hD : m/((b+y)*(b+y+m))≤ m/((b+x)*(b+x+m)) :=
    div_le_div_of_nonneg_left hm (mul_pos hx hxM)
      (mul_le_mul hXY (add_le_add_left hXY m) hxM.le hy.le)
  have hxI := inv_pos.mpr hx
  have hyI := inv_pos.mpr hy
  have hxMI := inv_pos.mpr hxM
  have hyMI := inv_pos.mpr hyM
  rw [rational_kernel_increment_eq hy hm,rational_kernel_increment_eq hx hm]
  gcongr


end GoldbachPintzNumerics
end

