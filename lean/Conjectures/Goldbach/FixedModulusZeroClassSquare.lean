open Complex MeasureTheory Filter Set

theorem nonprincipal_gram_cutoff_eq {H : ℂ → ℂ} (hH : Differentiable ℂ H)
    (b : ℕ → ℂ) (ρ : ℂ) (hb : LSeriesSummable b (ρ+1))
    {Y U a A : ℝ} (hY : 0 < Y) (hU : 0 < U) (ha₀ : -1 < a) (ha₁ : a < 0) (hA : 0 ≤ A)
    (hRight : ∀ t : ℝ, H ((1:ℂ)+t*I) = LSeries b (ρ+((1:ℂ)+t*I)))
    (hgrowth : ∀ x ∈ Icc a 1, ∀ t : ℝ, 1 ≤ |t| →
      let z := (x:ℂ)+t*I
      ‖((Y:ℂ)^z-(U:ℂ)^z)*H z‖ ≤ A*(1+|t|)) :
    cutoffSum (LSeries.term b ρ) Y - cutoffSum (LSeries.term b ρ) U =
      ((1/(2*Real.pi):ℝ):ℂ) * ∫ t : ℝ, gramRieszDifference Y U ((a:ℂ)+t*I) * H ((a:ℂ)+t*I) := by
  let F (w : ℂ) := ((Y:ℂ)^w-(U:ℂ)^w)*H w
  have hF : Differentiable ℂ F := by
    have hy : Differentiable ℂ (fun w : ℂ => (Y:ℂ)^w) :=
      differentiable_id.const_cpow (.inl (Complex.ofReal_ne_zero.mpr hY.ne'))
    have hu : Differentiable ℂ (fun w : ℂ => (U:ℂ)^w) :=
      differentiable_id.const_cpow (.inl (Complex.ofReal_ne_zero.mpr hU.ne'))
    exact (hy.sub hu).mul hH
  have hF0 : F 0 = 0 := by simp [F]
  have hshift := shift_regularized hF hF0 (a:=a) (b:=1) (A:=A)
    ha₀ ha₁.ne one_ne_zero (by linarith) hA hgrowth
  have he (x : ℝ) :
      (∫ t : ℝ, gramRieszDifference Y U ((x:ℂ)+t*I) * H ((x:ℂ)+t*I)) =
        ∫ t : ℝ, 2*F ((x:ℂ)+t*I) / (((x:ℂ)+t*I)*((x:ℂ)+t*I+1)*((x:ℂ)+t*I+2)) := by
    apply integral_congr_ae
    filter_upwards [] with t
    simp only [gramRieszDifference,symbol,F,div_eq_mul_inv]
    ring
  rw [← right_gram_riesz_difference b ρ hb hY hU]
  have hr : (∫ t : ℝ, gramRieszDifference Y U ((1:ℂ)+t*I) *
        LSeries b (ρ+((1:ℂ)+t*I))) =
      ∫ t : ℝ, gramRieszDifference Y U ((1:ℂ)+t*I) * H ((1:ℂ)+t*I) := by
    apply integral_congr_ae
    filter_upwards [] with t
    rw [hRight t]
  rw [hr, ← Complex.ofReal_one, he 1, hshift, ← he a]

end GoldbachCubicRiesz

