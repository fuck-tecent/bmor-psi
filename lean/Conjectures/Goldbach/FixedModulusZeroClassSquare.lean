namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial Classical

noncomputable section

variable {K E : Type*} [Field K] [Fintype K] [DecidableEq K]
  [Field E] [Fintype E] [Algebra K E]

def shiftWeight {s : ℕ} (a : Fin s → K) (e : Fin s → ℕ) (χ : MulChar K ℂ) :
    K[X] →* ℂ :=
  evaluationWeight_mul a (fun i => χ^e i)

theorem normLift_shiftPolynomial_apply {s : ℕ} (a : Fin s → K) (e : Fin s → ℕ)
    (he : ∀ i, e i ≠ 0) (χ : MulChar K ℂ) (y : E) :
    normLift χ ((shiftPolynomial (fun i => algebraMap K E (a i)) e).eval y) =
      (shiftWeight a e χ (minpoly K y))^
        (Module.finrank K E/(minpoly K y).natDegree) := by
  classical
  rw [normLift_apply,eval_shiftPolynomial,map_prod,map_prod]
  change _ = (∏ i, (χ^e i) ((minpoly K y).eval (a i)))^_
  rw [← Finset.prod_pow]
  apply prod_congr rfl
  intro i hi
  change χ (Algebra.norm K ((algebraMap K E (a i)-y)^e i)) =
      ((χ^e i) ((minpoly K y).eval (a i)))^_
  rw [map_pow,norm_algebraMap_sub_eq_minpoly_eval_pow,map_pow,map_pow,
    χ.pow_apply' (he i),← pow_mul,← pow_mul,Nat.mul_comm]

set_option maxHeartbeats 1300000 in
theorem sum_normLift_shiftPolynomial_eq_weightCoeff {s : ℕ} (a : Fin s → K)
    (e : Fin s → ℕ) (he : ∀ i, e i ≠ 0) (χ : MulChar K ℂ) :
    (∑ y : E, normLift χ ((shiftPolynomial (fun i => algebraMap K E (a i)) e).eval y)) =
      primePowerWeightCoeff (shiftWeight a e χ) (Module.finrank K E) := by
  classical
  let N := Module.finrank K E
  let w := shiftWeight a e χ
  let S := (primePowerDegreeLE K N).filter (fun pk => pk.2*pk.1.natDegree=N)
  let d (y : E) := (minpoly K y,N/(minpoly K y).natDegree)
  have hMaps (y : E) (_hy : y∈(univ : Finset E)) : d y∈S := by
    have hi : IsIntegral K y := IsIntegral.of_finite K y
    have hD : (N/(minpoly K y).natDegree)*(minpoly K y).natDegree=N :=
      Nat.div_mul_cancel (minpoly.degree_dvd hi)
    have hN0 : 0<N := Module.finrank_pos
    have hn : 1≤N/(minpoly K y).natDegree :=
      Nat.pos_of_mul_pos_right (hD.symm ▸ hN0)
    exact mem_filter.mpr ⟨mem_primePowerDegreeLE.mpr
      ⟨minpoly.monic hi,minpoly.irreducible hi,hn,hD.le⟩,hD⟩
  rw [← sum_fiberwise_of_maps_to hMaps]
  change (∑ pk∈S, _) = ∑ pk∈S,(pk.1.natDegree:ℂ)*(w pk.1)^pk.2
  apply sum_congr rfl
  intro pk hpk
  obtain ⟨p,k⟩ := pk
  obtain ⟨hm,hi,hk,hB⟩ := mem_primePowerDegreeLE.mp (mem_filter.mp hpk).1
  have heq : k*p.natDegree=N := (mem_filter.mp hpk).2
  have hp : 0<p.natDegree := hi.natDegree_pos
  have hD : p.natDegree ∣ N := ⟨k,heq.symm.trans (mul_comm _ _)⟩
  have hK : N/p.natDegree=k := by rw [← heq,Nat.mul_div_cancel _ hp]
  have hFib : (univ.filter (fun y : E => d y=(p,k))) =
      univ.filter (fun y : E => minpoly K y=p) := by
    ext y
    simp only [mem_filter,mem_univ,true_and,d,Prod.mk.injEq]
    constructor
    · exact And.left
    · intro hy
      exact ⟨hy,by rw [hy,hK]⟩
  rw [hFib]
  have hf : ∀ y ∈ (univ.filter (fun y : E => minpoly K y=p)),
      normLift χ ((shiftPolynomial (fun i => algebraMap K E (a i)) e).eval y) = (w p)^k := by
    intro y hy
    rw [normLift_shiftPolynomial_apply a e he χ,(mem_filter.mp hy).2]
    change (w p)^(N/p.natDegree) = _
    rw [hK]
  rw [sum_congr rfl hf,sum_const,nsmul_eq_mul,card_minpoly_fiber p hm hi,if_pos hD]

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

section

variable {K : Type*} [Field K]

/-- Hasse derivatives detect a root of arbitrary multiplicity in every
characteristic. -/
theorem pow_X_sub_C_dvd_of_hasseDeriv_zero (P : K[X]) (x : K) (M : ℕ)
    (h : ∀ j < M, (hasseDeriv j P).eval x = 0) :
    (X-C x)^M ∣ P := by
  have hD : X^M ∣ taylor x P := X_pow_dvd_iff.mpr (fun j hj => by rw [taylor_coeff,h j hj])
  obtain ⟨Q,hQ⟩ := hD
  refine ⟨taylor (-x) Q,?_⟩
  have he := congrArg (taylor (-x)) hQ
  rw [taylor_taylor,neg_add_cancel,taylor_zero,taylor_mul,taylor_pow] at he
  have hx : taylor (-x) (X:K[X]) = X-C x := by simp [taylor_apply,sub_eq_add_neg]
  rw [hx] at he
  exact he

theorem card_mul_le_degree_of_hasseDeriv_zero {P : K[X]} (hP : P ≠ 0)
    (M : ℕ) (S : Finset K)
    (h : ∀ x ∈ S, ∀ j < M, (hasseDeriv j P).eval x = 0) :
    M*S.card ≤ P.natDegree := by
  classical
  by_cases hM : M=0
  · simp [hM]
  have hm : 0 < M := Nat.pos_of_ne_zero hM
  have hMultiplicity (x : K) (hx : x ∈ S) : M ≤ rootMultiplicity x P :=
    (le_rootMultiplicity_iff hP).mpr (pow_X_sub_C_dvd_of_hasseDeriv_zero P x M (h x hx))
  have hSub : S ⊆ P.roots.toFinset := by
    intro x hx
    rw [Multiset.mem_toFinset,← Multiset.count_pos,count_roots]
    exact hm.trans_le (hMultiplicity x hx)
  calc
    _ = ∑ _x ∈ S,M := by simp [nsmul_eq_mul,mul_comm]
    _ ≤ ∑ x ∈ S,P.roots.count x := by
      apply sum_le_sum
      intro x hx
      rw [count_roots]
      exact hMultiplicity x hx
    _ ≤ ∑ x ∈ P.roots.toFinset,P.roots.count x :=
      sum_le_sum_of_subset_of_nonneg hSub (fun _ _ _ => Nat.zero_le _)
    _ = Multiset.card P.roots := Multiset.toFinset_sum_count_eq _
    _ ≤ _ := card_roots' P

/-- The Frobenius monomial has no nonzero Hasse derivatives below the
cardinality of the field. -/
theorem taylor_X_pow_field_card [Fintype K] (x : K) :
    taylor x ((X:K[X])^(Fintype.card K)) = X^(Fintype.card K)+C x := by
  obtain ⟨p,hChar,n,hp,hcard⟩ := FiniteField.card' K
  letI : CharP K p := hChar
  letI : Fact p.Prime := ⟨hp⟩
  have h : (X+C x : K[X])^(Fintype.card K) = X^(Fintype.card K)+(C x)^(Fintype.card K) := by
    rw [hcard,add_pow_char_pow]
  rw [taylor_apply,pow_comp,X_comp,h,← map_pow,FiniteField.pow_card]


end
end GoldbachBurgess
