noncomputable section

private theorem sinh_le_mul_cosh {x y : ℝ} (hx : 0≤x) (hxy : x≤y) :
    Real.sinh x ≤ x*Real.cosh y := by
  have he : (∫ t in (0:ℝ)..x, Real.cosh t) = Real.sinh x := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => Real.hasDerivAt_sinh t)
      (Real.continuous_cosh.intervalIntegrable _ _),Real.sinh_zero,sub_zero]
  rw [←he,show x*Real.cosh y=(∫ _ in (0:ℝ)..x, Real.cosh y) by simp]
  refine intervalIntegral.integral_mono_on hx (Real.continuous_cosh.intervalIntegrable _ _)
    intervalIntegrable_const fun t ht => ?_
  exact Real.cosh_le_cosh.mpr (by
    rw [abs_of_nonneg ht.1,abs_of_nonneg (hx.trans hxy)]
    exact ht.2.trans hxy)

private theorem exp_shift_difference_norm (z : ℂ) {b t : ℝ} (hz : 0≤z.re) (hb : 0≤b) (ht : 0≤t) :
    ‖Complex.exp (-((z+(b:ℂ))*(t:ℂ))) - Complex.exp (-(z*(t:ℂ)))‖ ≤ b*t := by
  rw [show -((z+(b:ℂ))*(t:ℂ)) = -(z*(t:ℂ))+((-b*t:ℝ):ℂ) by push_cast; ring,
    Complex.exp_add,← Complex.ofReal_exp,← mul_sub_one,norm_mul,Complex.norm_exp,
    ← Complex.ofReal_one,← Complex.ofReal_sub,Complex.norm_real,Real.norm_eq_abs]
  have hExp : Real.exp (-b*t)≤1 := Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg
    (neg_nonpos.mpr hb) ht)
  rw [abs_of_nonpos (sub_nonpos.mpr hExp),neg_sub]
  have hZ : Real.exp (-(z*(t:ℂ))).re ≤ 1 := by
    rw [Real.exp_le_one_iff,Complex.neg_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,mul_zero,sub_zero]
    exact neg_nonpos.mpr (mul_nonneg hz ht)
  calc
    _ ≤ 1-Real.exp (-b*t) := mul_le_of_le_one_left (sub_nonneg.mpr hExp) hZ
    _ ≤ _ := by
      have h := Real.add_one_le_exp (-b*t)
      linarith only [h]

/-- Uniform right-shift error for the normalized compact zero test. -/
theorem sinhTest_laplace_shift_norm_le {ω ell A b : ℝ} (hω : 0<ω) (hell : 0<ell)
    (hA : ell≤A) (hb : 0≤b) {z : ℂ} (hz : 0≤z.re) :
    ‖laplace (sinhTest ω ell) (z+(b:ℂ))-laplace (sinhTest ω ell) z‖ ≤
      (b*ell)*ω^3*Real.cosh (A*ω) := by
  have hCont := sinhTest_continuous ω ell
  have hI₁ : IntervalIntegrable (fun t:ℝ => (sinhTest ω ell t:ℂ)*cexp (-((z+(b:ℂ))*(t:ℂ)))) volume 0 ω :=
    ((Complex.continuous_ofReal.comp hCont).mul (by fun_prop)).intervalIntegrable _ _
  have hI₂ : IntervalIntegrable (fun t:ℝ => (sinhTest ω ell t:ℂ)*cexp (-(z*(t:ℂ)))) volume 0 ω :=
    ((Complex.continuous_ofReal.comp hCont).mul (by fun_prop)).intervalIntegrable _ _
  rw [Admissible.laplace_eq_intervalIntegral_of hω (fun _ => sinhTest_vanish),
    Admissible.laplace_eq_intervalIntegral_of hω (fun _ => sinhTest_vanish),
    ←intervalIntegral.integral_sub hI₁ hI₂]
  have he : (fun t:ℝ => (sinhTest ω ell t:ℂ) * cexp (-((z + ↑b) * ↑t)) -
      (sinhTest ω ell t:ℂ) * cexp (-(z * ↑t))) =
      fun t:ℝ => (sinhTest ω ell t:ℂ) * (cexp (-((z + ↑b) * ↑t)) - cexp (-(z * ↑t))) := by
    funext t
    ring
  rw [he]
  let C := (ell*ω)*Real.cosh (A*ω)*(b*ω)
  have hNorm (t : ℝ) (ht : t∈Ι (0:ℝ) ω) : ‖(sinhTest ω ell t:ℂ) *
      (cexp (-((z + ↑b) * ↑t)) - cexp (-(z * ↑t)))‖≤C := by
    have ht' := (uIoc_of_le hω.le ▸ ht)
    have hT : 0≤ell*(ω-t) := mul_nonneg hell.le (sub_nonneg.mpr ht'.2)
    have hA' : ell*(ω-t)≤A*ω :=
      (mul_le_mul_of_nonneg_left (sub_le_self ω ht'.1.le) hell.le).trans
        (mul_le_mul_of_nonneg_right hA hω.le)
    rw [sinhTest,ite_eq_left ht'.2,norm_mul,Complex.norm_real,Real.norm_eq_abs,
      abs_of_nonneg (Real.sinh_nonneg_iff.mpr hT)]
    refine mul_le_mul ?_ ?_ (norm_nonneg _) (by positivity [Real.cosh_pos (A*ω)])
    · exact (sinh_le_mul_cosh hT hA').trans
        (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (sub_le_self ω ht'.1.le) hell.le)
          (Real.cosh_pos _).le)
    · exact (exp_shift_difference_norm z hz hb ht'.1.le).trans (mul_le_mul_of_nonneg_left ht'.2 hb)
  calc
    _ ≤ C*|ω-0| := intervalIntegral.norm_integral_le_of_norm_le_const hNorm
    _ = _ := by simp only [C,sub_zero,abs_of_pos hω]; ring

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Finset MeasureTheory Set GradedNear
open scoped Interval
noncomputable section

theorem cd_sinhTest_zero_le {ω ell H : ℝ} (hω : 0<ω) (hell : 0<ell) (hH : ell≤H) :
    sinhTest ω ell 0≤ell*ω*Real.cosh (H*ω) := by
  rw [sinhTest,ite_eq_left hω.le,sub_zero]
  have hx := mul_nonneg hell.le hω.le
  have hxy := mul_le_mul_of_nonneg_right hH hω.le
  have he : (∫ t in (0:ℝ)..(ell*ω),Real.cosh t)=Real.sinh (ell*ω) := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _=>Real.hasDerivAt_sinh t)
      (Real.continuous_cosh.intervalIntegrable _ _),Real.sinh_zero,sub_zero]
  rw [←he,show ell*ω*Real.cosh (H*ω)=(∫ _t in (0:ℝ)..(ell*ω),Real.cosh (H*ω)) by simp]
  refine intervalIntegral.integral_mono_on hx (Real.continuous_cosh.intervalIntegrable _ _)
    intervalIntegrable_const fun t ht=>?_
  exact Real.cosh_le_cosh.mpr (by
    rw [abs_of_nonneg ht.1,abs_of_nonneg (hx.trans hxy)]
    exact ht.2.trans hxy)

theorem sinh_laplace_sum_shift_le {ι : Type*} (S : Finset ι) (m : ι→ℕ)
    (z : ι→ℂ) {ω ell H b J : ℝ} (hω : 0<ω) (hell : 0<ell) (hH : ell≤H)
    (hb : 0≤b) (hz : ∀ i∈S,0≤(z i).re) (hJ : (∑ i∈S,(m i:ℝ))≤J) :
    (∑ i∈S,(m i:ℝ)*(laplace (sinhTest ω ell) (z i)).re) ≤
      (∑ i∈S,(m i:ℝ)*(laplace (sinhTest ω ell) (z i+(b:ℂ))).re)+
      J*((b*ell)*ω^3*Real.cosh (H*ω)) := by
  let K := (b*ell)*ω^3*Real.cosh (H*ω)
  have hK : 0≤K := by unfold K; positivity
  calc
    _ ≤ ∑ i∈S,(m i:ℝ)*((laplace (sinhTest ω ell) (z i+(b:ℂ))).re+K) := by
      apply sum_le_sum
      intro i hi
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
      have h := (Complex.abs_re_le_norm
        (laplace (sinhTest ω ell) (z i+(b:ℂ))-laplace (sinhTest ω ell) (z i))).trans
          (sinhTest_laplace_shift_norm_le hω hell hH hb (hz i hi))
      rw [Complex.sub_re] at h
      have hp := (abs_le.mp h).1
      linarith only [hp]
    _ = (∑ i∈S,(m i:ℝ)*(laplace (sinhTest ω ell) (z i+(b:ℂ))).re)+
        (∑ i∈S,(m i:ℝ))*K := by
      simp only [mul_add,sum_add_distrib,sum_mul]
    _≤_ := add_le_add le_rfl (mul_le_mul_of_nonneg_right hJ hK)

theorem norm_windowLaplace_le_of_large_im {ω : ℝ} (hω : 0≤ω)
    {z : ℂ} (hz : 0≤z.re) {R : ℝ} (hR : 0<R) (hRi : R≤|z.im|) :
    ‖windowLaplace ω z‖≤2/R := by
  have hNorm : R≤‖z‖ := hRi.trans (Complex.abs_im_le_norm _)
  have hZ := hR.trans_le hNorm
  have hNum : ‖(1:ℂ)-Complex.exp (-(z*(ω:ℂ)))‖≤2 := by
    refine (norm_sub_le _ _).trans ?_
    rw [norm_one,Complex.norm_exp,Complex.neg_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
      mul_zero,sub_zero]
    have hh := Real.exp_le_one_iff.mpr (neg_nonpos.mpr (mul_nonneg hz hω))
    linarith only [hh]
  rw [windowLaplace,norm_div]
  exact div_le_div₀ (by norm_num) hNum hR hNorm

end
end GoldbachPintzWeightedFormula
end

