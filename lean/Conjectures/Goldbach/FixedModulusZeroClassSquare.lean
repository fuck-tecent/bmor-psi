namespace GoldbachCubicRiesz

open Complex Set MeasureTheory Filter

/-- Contour shift for a finitely sieved L-series at a zero of its numerator. -/
theorem compact_riesz_shift {H : ℂ → ℂ} (hH : Differentiable ℂ H) (hzero : H 0 = 0)
    {a Y A : ℝ} (ha₀ : -1 < a) (ha₁ : a < 0) (hY : 0 < Y) (hA : 0 ≤ A)
    (hbound : ∀ x ∈ Set.Icc a 1, ∀ t : ℝ, 1 ≤ |t| →
      ‖(Y:ℂ)^((x:ℂ)+t*I) * H ((x:ℂ)+t*I)‖ ≤ A*(1+|t|))
    (b : ℕ → ℂ) (ρ : ℂ) (hb : LSeriesSummable b (ρ+1))
    (hRight : ∀ t : ℝ, H ((1:ℂ)+t*I) = LSeries b (ρ+((1:ℂ)+t*I))) :
    mellinInv a (fun w => H w * symbol w) (1/Y) =
      cutoffSum (LSeries.term b ρ) Y := by
  let F (w : ℂ) := (Y:ℂ)^w * H w
  have hF : Differentiable ℂ F := (differentiable_id.const_cpow
    (Or.inl (Complex.ofReal_ne_zero.mpr hY.ne'))).mul hH
  have hF0 : F 0 = 0 := by simp [F,hzero]
  let G (w : ℂ) := 2*F w / (w*(w+1)*(w+2))
  have hshift := shift_regularized hF hF0 (a:=a) (b:=1) (A:=A)
    ha₀ ha₁.ne one_ne_zero (by linarith) hA hbound
  have hpow (w : ℂ) : ((1/Y : ℝ):ℂ)^(-w) = (Y:ℂ)^w := by
    rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr (one_div_pos.mpr hY).ne'),
      Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hY.ne'),
      ← Complex.ofReal_log (one_div_pos.mpr hY).le, ← Complex.ofReal_log hY.le,
      Real.log_div one_ne_zero hY.ne', Real.log_one, zero_sub, Complex.ofReal_neg]
    congr 1
    ring
  have hline (c : ℝ) :
      mellinInv c (fun w => H w * symbol w) (1/Y) =
        ((1/(2*Real.pi):ℝ):ℂ)*∫ t : ℝ, G ((c:ℂ)+t*I) := by
    simp only [mellinInv,smul_eq_mul,Complex.real_smul]
    apply congrArg (fun z : ℂ => ((1/(2*Real.pi):ℝ):ℂ)*z)
    apply integral_congr_ae
    filter_upwards [] with t
    rw [hpow]
    dsimp only [G,F,symbol]
    simp only [div_eq_mul_inv]
    ring
  calc
    _ = mellinInv 1 (fun w => H w * symbol w) (1/Y) := by
      rw [hline a,hline 1]
      exact congrArg (fun z : ℂ => ((1/(2*Real.pi):ℝ):ℂ)*z) hshift.symm
    _ = mellinInv 1 (fun w => LSeries b (ρ+w)*symbol w) (1/Y) := by
      simp only [mellinInv,smul_eq_mul,Complex.real_smul]
      apply congrArg (fun z : ℂ => ((1/(2*Real.pi):ℝ):ℂ)*z)
      apply integral_congr_ae
      filter_upwards [] with t
      rw [show ((1:ℝ):ℂ)=1 by norm_num,hRight t]
    _ = _ := shifted_cutoff_mellinInv (by norm_num) hY b ρ hb

end GoldbachCubicRiesz

end

