namespace V9h
open OAI.Ostmann V1e
theorem V1o4 (X y h : ℝ) (ρ : ℂ)
    (hX : 1≤X) (hy : X≤y) (hh : 0≤h)
    (hρ0 : 0<ρ.re) (hρ : ρ.re≤1/2) :
    ‖Ve y h ρ‖≤h*X^(-1/2 : ℝ) := by
  have hXp : 0<X := by linarith
  rw [Vmc y h ρ hρ0]
  have hb : ∀ u∈Set.uIoc y (y+h), ‖(u : ℂ)^(ρ-1)‖≤X^(-1/2 : ℝ) := by
    intro u hu
    rw [Set.uIoc_of_le (by linarith : y≤y+h)] at hu
    have hXu : X≤u := hy.trans hu.1.le
    have hup : 0<u := hXp.trans_le hXu
    rw [Complex.norm_cpow_eq_rpow_re_of_pos hup]
    calc
      _ ≤ u^(-1/2 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (hX.trans hXu) (by
          simp only [Complex.sub_re,Complex.one_re]
          linarith)
      _ ≤ X^(-1/2 : ℝ) := Real.rpow_le_rpow_of_nonpos hXp hXu (by norm_num)
  have hi := intervalIntegral.norm_integral_le_of_norm_le_const hb
  simpa only [add_sub_cancel_left,abs_of_nonneg hh,mul_comm] using hi
theorem Vk7 (X y h : ℝ) (ρ : ℂ)
    (hX : 1≤X) (hy : X≤y) (hh : 0≤h) (hhX : h≤X)
    (hρ0 : 0<ρ.re) (hρ : ρ.re≤1/2) :
    ‖Ve y h ρ‖≤X^(1/2 : ℝ) := by
  apply (V1o4 X y h ρ hX hy hh hρ0 hρ).trans
  calc
    h*X^(-1/2 : ℝ) ≤ X*X^(-1/2 : ℝ) := mul_le_mul_of_nonneg_right hhX (by positivity)
    _ = X^(1/2 : ℝ) := by
      conv_lhs => lhs; rw [← Real.rpow_one X]
      rw [← Real.rpow_add (by linarith : 0<X)]
      norm_num
theorem Vuu (X y h T : ℝ) (ρ : ℂ)
    (hX : 1≤X) (hy : X≤y) (hy2 : y≤2*X) (hh : 0≤h) (hhX : h≤X)
    (hT : 0<T) (hρ : ρ.re≤1/2) (ht : T/2≤|ρ.im|) :
    ‖Ve y h ρ‖≤12*X^(1/2 : ℝ)/T := by
  have hXp : 0<X := by linarith
