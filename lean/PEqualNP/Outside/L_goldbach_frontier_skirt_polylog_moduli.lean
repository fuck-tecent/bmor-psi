    Vj F (V4l p a) ≤
      (k^k*p^((r+1)*r/2)) * (N^k*V8 s k Q) := by
  have he : Vj F (V4l p a) =
      Vj F (V28 p a) := by
    exact V7u F _ _ (fun x _ y _ =>
      V158 ha y x)
  rw [he]
  exact (Vle hkp hrk a F hF).trans
    (Nat.mul_le_mul_left _ (Voi
      (Fact.out : p.Prime).pos a hN F))
end V2
