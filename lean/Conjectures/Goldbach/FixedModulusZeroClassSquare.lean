theorem moderate_real_near_class_mass_le {ι : Type*} (S : Finset ι) (x : ι→ℝ)
    (hmin : ∀ i∈S, (0.87:ℝ)≤x i)
    (hSmall : ((S.filter (fun i=>x i<1)).card:ℝ)≤6)
    (hClip : (∑ i∈S,clippedGapWeight 1 (x i))≤0.085) :
    (∑ i∈S,gapWeight (x i))≤0.128 := by
  let C := gapWeight 0.87-gapWeight 1
  have hC : 0≤C := by
    apply sub_nonneg.mpr
    apply Real.exp_le_exp.mpr
    norm_num
  have hPoint (i : ι) (hi : i∈S) :
      earlyGapWeight 1 (x i)≤ if x i<1 then C else 0 := by
    unfold earlyGapWeight
    by_cases h : x i<1
    · rw [ite_eq_left h]
      apply max_le hC
      apply sub_le_sub_right
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonpos_left (hmin i hi) (by norm_num)
    · rw [ite_eq_right h]
      apply max_le le_rfl
      apply sub_nonpos.mpr
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonpos_left (not_lt.mp h) (by norm_num)
  have hEarly : (∑ i∈S,earlyGapWeight 1 (x i))≤6*C := by
    refine (sum_le_sum hPoint).trans ?_
    rw [←sum_filter,sum_const,nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right hSmall hC
  have hE (i : ι) : gapWeight (x i)=earlyGapWeight 1 (x i)+clippedGapWeight 1 (x i) :=
    exp_weight_split (by norm_num)
  simp_rw [hE,sum_add_distrib]
  have hh := add_le_add hEarly hClip
  have hc : 0.085+6*C < (0.128:ℝ) := by
    simpa only [C,gapWeight,mul_one] using moderate_real_near_class_number
  linarith only [hh,hc]

private theorem tiny_real_point_square_le {a : ℝ} (ha : 0<a) (hsmall : a≤0.005) :
    (Real.exp (-4.93*a))^2+2*Real.exp (-4.93*a)*(4*a)+(4*a)*0.12≤1-0.9*a := by
  let w := Real.exp (-4.93*a)
  have hw₁ : w≤1 := Real.exp_le_one_iff.mpr (by nlinarith only [ha])
  have h₁ : w^2≤1-9.38*a := by
    have hs : w^2 = Real.exp (-(9.86*a)) := by
      rw [pow_two,←Real.exp_add]
      congr 1
      ring
    rw [hs,Real.exp_neg]
    have h := Real.add_one_le_exp (9.86*a)
    have hPos : (0:ℝ)<1+9.86*a := by positivity
    refine (inv_anti₀ hPos (by linarith only [h])).trans ?_
    rw [←one_div]
    apply (div_le_iff₀ hPos).mpr
    have hSq := mul_le_mul_of_nonneg_right hsmall ha.le
    nlinarith only [hSq,ha]
  have h₂ := mul_le_mul_of_nonneg_right hw₁ (show 0≤8*a by positivity)
  change w^2+2*w*(4*a)+(4*a)*0.12≤_
  nlinarith only [h₁,h₂]

theorem tiny_real_class_square_of_rival_bounds {ι κ : Type*} (S : Finset ι)
    (key : ι→κ) (x : ι→ℝ) {i : ι} (hi : i∈S) {d : ℝ}
    (hd : 0<d) (hδ : d≤x i) (hsmall : x i≤0.005)
    (hC : (∑ j∈S.erase i,gapWeight (x j))≤0.12)
    (hD : ∀ c∈S.image key, (∑ j∈(S.erase i).filter (fun j=>key j=c),
      gapWeight (x j))≤4*x i) :
    classMassSq S key (fun j=>gapWeight (x j))≤1-0.9*d := by
  have hpos := hd.trans_le hδ
  have hMain := classMassSq_single_le S key (fun j=>gapWeight (x j)) hi rfl
    (le_refl (x i)) (fun j _=>Real.exp_nonneg _) (show 0≤4*x i by positivity)
    (show 0≤4*x i by positivity) hD (hD (key i) (mem_image_of_mem _ hi)) hC
    (tiny_real_point_square_le hpos hsmall)
  exact hMain.trans (by linarith only [hδ])

