private theorem Lpartial_harmonic_power_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    (s : ℂ) {N : ℕ} (hN : 1≤N) :
    ‖Lpartial χ N s‖ ≤ (N:ℝ)^(max 0 (1-s.re))*(1+Real.log N) := by
  let p := max 0 (1-s.re)
  have hp : 0≤p := le_max_left _ _
  have hN₁ : (1:ℝ)≤N := by exact_mod_cast hN
  have hsum : (∑ n ∈ Icc 1 N, (n:ℝ)⁻¹) ≤ 1+Real.log N := by
    have he : (∑ n ∈ Icc 1 N, (n:ℝ)⁻¹) = (harmonic N:ℝ) := by
      simp only [harmonic,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast]
      rw [← Finset.Ico_succ_right_eq_Icc]
      change (∑ n ∈ Ico 1 (N+1), (n:ℝ)⁻¹) = _
      exact (by simpa only [Nat.Ico_zero_eq_range,zero_add,Nat.add_comm] using
        (Finset.sum_Ico_add (fun n : ℕ => (n:ℝ)⁻¹) 0 N 1).symm)
    rw [he]
    exact harmonic_le_one_add_log N
  rw [Lpartial]
  calc
    _ ≤ ∑ n ∈ Icc 1 N, ((n:ℝ)^(-s.re)) := by
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro n hn
      rw [norm_mul,Complex.norm_natCast_cpow_of_pos (mem_Icc.mp hn).1,Complex.neg_re]
      exact mul_le_of_le_one_left (by positivity) (χ.norm_le_one _)
    _ ≤ ∑ n ∈ Icc 1 N, (N:ℝ)^p*(n:ℝ)⁻¹ := by
      apply sum_le_sum
      intro n hn
      have hn₁ : (1:ℝ)≤n := by exact_mod_cast (mem_Icc.mp hn).1
      have hn₀ := zero_lt_one.trans_le hn₁
      have hnN : (n:ℝ)≤N := by exact_mod_cast (mem_Icc.mp hn).2
      calc
        _ = (n:ℝ)^(1-s.re)*(n:ℝ)⁻¹ := by
          rw [← Real.rpow_neg_one,←Real.rpow_add hn₀]
          congr 1
          ring
        _ ≤ _ := mul_le_mul_of_nonneg_right
          ((Real.rpow_le_rpow_of_exponent_le hn₁ (le_max_right _ _)).trans
            (Real.rpow_le_rpow hn₀.le hnN hp)) (by positivity)
    _ ≤ _ := by
      rw [← mul_sum]
      exact mul_le_mul_of_nonneg_left hsum (by positivity)

set_option maxHeartbeats 850000 in
/-- A uniform Pólya–Vinogradov strip growth bound, including the line one
and with the exact conductor exponent `(1−σ)₊/2`. -/
theorem nonprincipal_LFunction_uniform_strip {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ≠1) {T : ℝ} (hT : 0≤T)
    {s : ℂ} (hσ : (1/2:ℝ) ≤ s.re) (hσ' : s.re ≤ 3/2) (ht : |s.im| ≤ T) :
    let S := 16*(1+T)
    ‖χ.LFunction s‖ ≤ S*(2+Real.log S)*
      (1+Real.log (q:ℝ))^2*(q:ℝ)^(max 0 (1-s.re)/2) := by
  dsimp only
  let p := max 0 (1-s.re)
  let S := 16*(1+T)
  let J := 1+Real.log (q:ℝ)
  let B := 2*Real.sqrt (q:ℝ)*J
  let Z := 4*(1+T)*B
  let N := ⌈Z⌉₊
  have hp : 0≤p := le_max_left _ _
  have hp₁ : p≤1 := max_le (by norm_num) (by linarith only [hσ])
  have hq₁ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hq₀ := zero_lt_one.trans_le hq₁
  have hJ : 1≤J := le_add_of_nonneg_right (Real.log_nonneg hq₁)
  have hJ₀ := zero_lt_one.trans_le hJ
  have hS : 1≤S := by dsimp only [S]; nlinarith only [hT]
  have hS₀ := zero_lt_one.trans_le hS
  have hsq : 1≤Real.sqrt (q:ℝ) := by
    simpa only [Real.sqrt_one] using Real.sqrt_le_sqrt hq₁
  have hB : 1≤B := by
    dsimp only [B]
    have hh := one_le_mul_of_one_le_of_one_le hsq hJ
    nlinarith only [hh]
  have hZ : 1≤Z := by
    apply one_le_mul_of_one_le_of_one_le _ hB
    nlinarith only [hT]
  have hZ₀ := zero_lt_one.trans_le hZ
  have hN₁ : (1:ℝ)≤N := hZ.trans (Nat.le_ceil Z)
  have hN : 1≤N := by exact_mod_cast hN₁
  have hN₀ := zero_lt_one.trans_le hN₁
  have hZle : Z ≤ (N:ℝ) := Nat.le_ceil Z
  have hNle : (N:ℝ)≤S*Real.sqrt (q:ℝ)*J := calc
    _ ≤ Z+1 := (Nat.ceil_lt_add_one hZ₀.le).le
    _ ≤ 2*Z := by linarith only [hZ]
    _ = _ := by dsimp only [Z,B,S]; ring
  have hσ₀ : 0<s.re := by linarith only [hσ]
  have hsN : ‖s‖≤3/2+T := by
    calc
      _ = ‖(s.re:ℂ)+(s.im:ℂ)*I‖ := congrArg norm (Complex.re_add_im s).symm
      _ ≤ ‖(s.re:ℂ)‖+‖(s.im:ℂ)*I‖ := norm_add_le _ _
      _ ≤ _ := by
        rw [norm_mul,norm_I,mul_one,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,
          Real.norm_eq_abs,abs_of_pos hσ₀]
        linarith only [hσ',ht]
  have hAbel : 1+‖s‖/s.re ≤ 4*(1+T) := by
    have hd : ‖s‖/s.re≤3+2*T := (div_le_iff₀ hσ₀).mpr (by
      have hh := mul_le_mul_of_nonneg_left hσ (show (0:ℝ)≤3+2*T by positivity)
      nlinarith only [hsN,hh])
    linarith only [hd,hT]
  have htail := nonprincipal_truncation_of_partial_sum_bound χ hχ
    (B:=B) (charPartialSum_nonprincipal_bound χ hχ) hσ₀ hN
  have htail' : ‖χ.LFunction s-Lpartial χ N s‖ ≤ (N:ℝ)^p := calc
    _ ≤ B*(1+‖s‖/s.re)*(N:ℝ)^(-s.re) := htail
    _ ≤ Z*(N:ℝ)^(-s.re) := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      rw [mul_comm]
      exact mul_le_mul_of_nonneg_right hAbel (zero_le_one.trans hB)
    _ ≤ (N:ℝ)*(N:ℝ)^(-s.re) := mul_le_mul_of_nonneg_right hZle (by positivity)
    _ = (N:ℝ)^(1-s.re) := by rw [sub_eq_add_neg,Real.rpow_add hN₀,Real.rpow_one]
    _ ≤ (N:ℝ)^p := Real.rpow_le_rpow_of_exponent_le hN₁ (le_max_right _ _)
  have hbound : ‖χ.LFunction s‖ ≤ (N:ℝ)^p*(2+Real.log N) := calc
    _ ≤ ‖χ.LFunction s-Lpartial χ N s‖+‖Lpartial χ N s‖ := by
      simpa only [sub_add_cancel] using norm_add_le (χ.LFunction s-Lpartial χ N s) (Lpartial χ N s)
    _ ≤ (N:ℝ)^p + (N:ℝ)^p*(1+Real.log N) :=
      (add_le_add) htail' (Lpartial_harmonic_power_le χ s hN)
    _ = _ := by ring
  have hpN : (N:ℝ)^p ≤ S*J*(q:ℝ)^(p/2) := calc
    _ ≤ (S*Real.sqrt (q:ℝ)*J)^p := Real.rpow_le_rpow hN₀.le hNle hp
    _ = S^p*J^p*(q:ℝ)^(p/2) := by
      rw [Real.mul_rpow (by positivity : 0≤S*Real.sqrt (q:ℝ)) hJ₀.le,
        Real.mul_rpow hS₀.le (by positivity),Real.sqrt_eq_rpow,← Real.rpow_mul hq₀.le]
      rw [show (1/2:ℝ)*p = p/2 by ring]
      ring
    _ ≤ _ := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      exact mul_le_mul
        (by simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hS hp₁)
        (by simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hJ hp₁)
        (by positivity) hS₀.le
  have hlogN : 2+Real.log (N:ℝ) ≤ (2+Real.log S)*J := by
    have h := Real.log_le_log hN₀ hNle
    rw [Real.log_mul (by positivity) hJ₀.ne',
      Real.log_mul hS₀.ne' (by positivity),Real.sqrt_eq_rpow,Real.log_rpow hq₀] at h
    have he := Real.log_le_sub_one_of_pos hJ₀
    have hh : 0≤Real.log S*Real.log (q:ℝ) :=
      mul_nonneg (Real.log_nonneg hS) (Real.log_nonneg hq₁)
    dsimp only [J] at he ⊢
    nlinarith only [h,he,hh,Real.log_nonneg hq₁]
  have hLogN₀ : 0≤2+Real.log (N:ℝ) := by linarith only [Real.log_nonneg hN₁]
  calc
    _ ≤ (N:ℝ)^p*(2+Real.log N) := hbound
    _ ≤ (S*J*(q:ℝ)^(p/2))*((2+Real.log S)*J) :=
      mul_le_mul hpN hlogN hLogN₀ (by positivity)
    _ = _ := by ring

end
end GoldbachHybridGrowth
