open MeasureTheory
open scoped Interval
namespace Vl1
theorem V1i2 (f : ℝ → ℝ) (X h : ℝ)
    (hX : 0≤X) (hh : 0≤h) (hhX : h≤X)
    (hf : ContinuousOn f (Set.Icc X (3*X))) :
    IntervalIntegrable (fun y => ∫ u in y..y+h, f u) volume X (2*X) := by
  have hrect : ContinuousOn (fun p : ℝ×ℝ => f (p.1+p.2))
      ((Set.Icc X (2*X)) ×ˢ (Set.Icc 0 h)) := by
    apply hf.comp ((continuous_fst.add continuous_snd).continuousOn)
    intro p hp
    change X≤p.1+p.2 ∧ p.1+p.2≤3*X
    exact ⟨by linarith [hp.1.1, hp.2.1], by linarith [hp.1.2, hp.2.2]⟩
  have hprod : Integrable (fun p : ℝ×ℝ => f (p.1+p.2))
      ((volume.restrict (Set.Icc X (2*X))).prod (volume.restrict (Set.Icc 0 h))) := by
    rw [Measure.prod_restrict]
    exact hrect.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  have heq : (fun y => ∫ u in y..y+h, f u)=(fun y => ∫ t in 0..h, f (y+t)) := by
    funext y
    rw [intervalIntegral.integral_comp_add_left f y]
    simp only [add_zero]
  rw [heq]
  apply (intervalIntegrable_iff_integrableOn_Icc_of_le (by linarith : X≤2*X)).2
  simp_rw [intervalIntegral.integral_of_le hh, ← integral_Icc_eq_integral_Ioc]
  exact hprod.integral_prod_left
theorem V1y1 (f : ℝ → ℝ) (X h : ℝ)
    (hX : 0≤X) (hh : 0≤h) (hhX : h≤X)
    (hf : ContinuousOn f (Set.Icc X (3*X)))
    (hf0 : ∀ u∈Set.Icc X (3*X), 0≤f u) :
    (∫ y in X..2*X, ∫ u in y..y+h, f u) ≤
      h*(∫ u in X..3*X, f u) := by
  have hXX : X≤2*X := by linarith
  have hrect : ContinuousOn (fun p : ℝ×ℝ => f (p.1+p.2))
      ((Set.Icc X (2*X)) ×ˢ (Set.Icc 0 h)) := by
    apply hf.comp ((continuous_fst.add continuous_snd).continuousOn)
    intro p hp
    change X≤p.1+p.2 ∧ p.1+p.2≤3*X
    exact ⟨by linarith [hp.1.1, hp.2.1], by linarith [hp.1.2, hp.2.2]⟩
  have hprod : Integrable (fun p : ℝ×ℝ => f (p.1+p.2))
      ((volume.restrict (Set.Icc X (2*X))).prod (volume.restrict (Set.Icc 0 h))) := by
    rw [Measure.prod_restrict]
    exact hrect.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
  have hswap : (∫ y in X..2*X, ∫ t in 0..h, f (y+t)) =
      (∫ t in 0..h, ∫ y in X..2*X, f (y+t)) := by
    simp_rw [intervalIntegral.integral_of_le hXX, intervalIntegral.integral_of_le hh,
      ← integral_Icc_eq_integral_Ioc]
    exact integral_integral_swap hprod
  have hinner : IntervalIntegrable (fun t => ∫ y in X..2*X, f (y+t)) volume 0 h := by
    apply (intervalIntegrable_iff_integrableOn_Icc_of_le hh).2
    simp_rw [intervalIntegral.integral_of_le hXX, ← integral_Icc_eq_integral_Ioc]
    exact hprod.integral_prod_right
  have hpoint : ∀ t∈Set.Icc 0 h,
      (∫ y in X..2*X, f (y+t)) ≤ ∫ u in X..3*X, f u := by
    intro t ht
    rw [intervalIntegral.integral_comp_add_right f t]
    apply intervalIntegral.integral_mono_interval
      (by linarith [ht.1] : X≤X+t) (by linarith : X+t≤2*X+t)
      (by linarith [ht.2] : 2*X+t≤3*X)
    · filter_upwards [ae_restrict_mem measurableSet_Ioc] with u hu
      exact hf0 u ⟨hu.1.le, hu.2⟩
    · exact ContinuousOn.intervalIntegrable_of_Icc (by linarith : X≤3*X) hf
  calc
    _ = ∫ y in X..2*X, ∫ t in 0..h, f (y+t) := by
      apply intervalIntegral.integral_congr
      intro y hy
      dsimp only
      rw [intervalIntegral.integral_comp_add_left f y]
      simp only [add_zero]
    _ = ∫ t in 0..h, ∫ y in X..2*X, f (y+t) := hswap
    _ ≤ ∫ t in 0..h, (∫ u in X..3*X, f u) :=
      intervalIntegral.integral_mono_on hh hinner intervalIntegrable_const hpoint
    _ = _ := by simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul]
end Vl1
end

section
open Finset MeasureTheory
open scoped BigOperators Interval Classical
namespace V1e
theorem V1v5 (f : ℝ → ℂ) (X h : ℝ)
    (hX : 0≤X) (hh : 0≤h) (hhX : h≤X)
    (hf : ContinuousOn f (Set.Icc X (3*X))) :
    (∫ y in X..2*X, ‖∫ u in y..y+h, f u‖^2) ≤
      h^2*(∫ u in X..3*X, ‖f u‖^2) := by
  have hXX : X≤2*X := by linarith
  have hj : IntervalIntegrable (fun y => ∫ u in y..y+h, ‖f u‖^2) volume X (2*X) :=
    Vl1.V1i2 _ X h hX hh hhX (hf.norm.pow 2)
  have hp : ∀ y∈Set.Icc X (2*X),
      ‖∫ u in y..y+h, f u‖^2≤h*(∫ u in y..y+h, ‖f u‖^2) := by
    intro y hy
    have hcont : ContinuousOn f (Set.Icc y (y+h)) := hf.mono (by
      intro u hu
      exact ⟨by linarith [hy.1,hu.1], by linarith [hy.2,hu.2]⟩)
    simpa only [add_sub_cancel_left] using
      Vl2.V1gz f y (y+h) (by linarith) hcont
  have hi : (∫ y in X..2*X, ‖∫ u in y..y+h, f u‖^2) ≤
      ∫ y in X..2*X, h*(∫ u in y..y+h, ‖f u‖^2) := by
    rw [intervalIntegral.integral_of_le hXX, intervalIntegral.integral_of_le hXX]
    apply integral_mono_of_nonneg (Filter.Eventually.of_forall (fun _ => sq_nonneg _))
      (hj.const_mul h).1
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with y hy
    exact hp y ⟨hy.1.le,hy.2⟩
  rw [intervalIntegral.integral_const_mul] at hi
  have hm := Vl1.V1y1 (fun u => ‖f u‖^2)
    X h hX hh hhX (hf.norm.pow 2) (fun _ _ => sq_nonneg _)
  calc
    _ ≤ h*(∫ y in X..2*X, ∫ u in y..y+h, ‖f u‖^2) := hi
    _ ≤ h*(h*(∫ u in X..3*X, ‖f u‖^2)) := mul_le_mul_of_nonneg_left hm hh
    _ = _ := by ring
theorem Vmc (y h : ℝ) (ρ : ℂ) (hρ : 0<ρ.re) :
    Ve y h ρ = ∫ u in y..y+h, (u : ℂ)^(ρ-1) := by
  rw [integral_cpow (Or.inl (by
    simp only [Complex.sub_re, Complex.one_re]
    linarith))]
  simp only [sub_add_cancel]
  rfl
theorem V1tj {ι : Type*} (S : Finset ι) (ρ : ι → ℂ)
    (hr : ∀ i∈S, 0<(ρ i).re) (y h : ℝ) (hy : 0<y) (hh : 0≤h) :
    (∑ i∈S, Ve y h (ρ i)) =
      ∫ u in y..y+h, ∑ i∈S, (u : ℂ)^(ρ i-1) := by
  rw [intervalIntegral.integral_finsetSum]
  · exact sum_congr rfl (fun i hi => Vmc y h (ρ i) (hr i hi))
  · intro i hi
    apply intervalIntegral.intervalIntegrable_cpow (Or.inr ?_)
    rw [Set.uIcc_of_le (by linarith : y≤y+h)]
    intro hz
    linarith [hz.1]
theorem V1o9 {ι : Type*} (S : Finset ι) (ρ : ι → ℂ)
    (u : ℝ) (hu : u≠0) :
    (∑ i∈S, (u : ℂ)^(ρ i-1))=(∑ i∈S, (u : ℂ)^(ρ i))/(u : ℂ) := by
  rw [sum_div]
  apply sum_congr rfl
  intro i hi
  rw [Complex.cpow_sub _ _ (by exact_mod_cast hu), Complex.cpow_one]
theorem V1dq {ι : Type*} (S : Finset ι) (ρ : ι → ℂ)
    (hr : ∀ i∈S, 0<(ρ i).re) (X h : ℝ)
    (hX : 0<X) (hh : 0≤h) (hhX : h≤X) :
    (∫ y in X..2*X, ‖∑ i∈S, Ve y h (ρ i)‖^2) ≤
      (h/X)^2*(∫ u in X..4*X, ‖∑ i∈S, (u : ℂ)^(ρ i)‖^2) := by
  let f : ℝ → ℂ := fun u => ∑ i∈S, (u : ℂ)^(ρ i-1)
  let P : ℝ → ℂ := fun u => ∑ i∈S, (u : ℂ)^(ρ i)
  have hcP : ContinuousOn P (Set.Icc X (4*X)) := by
    simpa only [one_mul] using Vmu S (fun _ => 1) ρ X hX
  have hcf : ContinuousOn f (Set.Icc X (3*X)) := by
    have h4 : ContinuousOn f (Set.Icc X (4*X)) := by
      simpa only [one_mul] using Vmu S (fun _ => 1) (fun i => ρ i-1) X hX
    exact h4.mono (by intro u hu; exact ⟨hu.1,by linarith [hu.2]⟩)
  have hm := V1v5 f X h hX.le hh hhX hcf
  have hid : (∫ y in X..2*X, ‖∑ i∈S, Ve y h (ρ i)‖^2) =
      ∫ y in X..2*X, ‖∫ u in y..y+h, f u‖^2 := by
    apply intervalIntegral.integral_congr
    intro y hy
    rw [Set.uIcc_of_le (by linarith : X≤2*X)] at hy
    dsimp only [f]
    rw [V1tj S ρ hr y h (by linarith [hy.1]) hh]
  have hp : ∀ u∈Set.Icc X (3*X), ‖f u‖^2≤(1/X)^2*‖P u‖^2 := by
    intro u hu
    have hu0 : 0<u := hX.trans_le hu.1
    have heq : ‖f u‖=‖P u‖/u := by
      dsimp only [f,P]
      rw [V1o9 S ρ u hu0.ne', norm_div, Complex.norm_real,
        Real.norm_of_nonneg hu0.le]
    have hdiv := div_le_div_of_nonneg_left (norm_nonneg (P u)) hX hu.1
    rw [heq]
    calc
      _ ≤ (‖P u‖/X)^2 := (sq_le_sq₀ (by positivity) (by positivity)).2 hdiv
      _ = _ := by ring
  have hcp3 : ContinuousOn P (Set.Icc X (3*X)) :=
    hcP.mono (by intro u hu; exact ⟨hu.1,by linarith [hu.2]⟩)
  have hi : (∫ u in X..3*X, ‖f u‖^2) ≤
      (1/X)^2*(∫ u in X..3*X, ‖P u‖^2) := by
    have hif : IntervalIntegrable (fun u => ‖f u‖^2) volume X (3*X) :=
      ContinuousOn.intervalIntegrable_of_Icc (by linarith) (hcf.norm.pow 2)
    have hip : IntervalIntegrable (fun u => (1/X)^2*‖P u‖^2) volume X (3*X) :=
      ContinuousOn.intervalIntegrable_of_Icc (by linarith)
        ((hcp3.norm.pow 2).const_mul ((1/X)^2))
    have he := intervalIntegral.integral_mono_on (by linarith : X≤3*X) hif hip hp
    rw [intervalIntegral.integral_const_mul] at he
    exact he
  have hbig : (∫ u in X..3*X, ‖P u‖^2) ≤ ∫ u in X..4*X, ‖P u‖^2 :=
    intervalIntegral.integral_mono_interval (le_refl X) (by linarith) (by linarith)
