private def recordedBlock (i : ℕ) : ℤ :=
  blockTable[i]?.getD 0

set_option maxHeartbeats 60000000 in
set_option maxRecDepth 8192 in
private theorem checked_block (i : ℕ) (hi : i < 256) :
    blockSum 256 i = recordedBlock i := by
  interval_cases i
  all_goals decide +kernel

set_option maxRecDepth 8192 in
private theorem checked_total (B : ℕ) (hB : B = 256) :
    (1863 : ℤ) * (2 * 200 ^ 15) * polyDenominator <
      2500 * ∑ i ∈ Finset.range B, blockSum B i := by
  subst B
  have htable :
      (∑ i ∈ Finset.range 256, blockSum 256 i) =
        ∑ i ∈ Finset.range 256, recordedBlock i :=
    Finset.sum_congr rfl fun i hi => checked_block i (Finset.mem_range.mp hi)
  rw [htable]
  decide +kernel

