def cdColumnZeros {ι : Type*} {q : ℕ} (I : Finset ι)
    (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ) (i : ι) : Finset ℂ :=
  ((I.filter fun j=>χ i=χ j).image ρ)

theorem cdGramPoint_eq_conj_resolvent (L : ℝ) (ρ ζ : ℂ) :
    cdGramPoint L ρ ζ=conj (cdResolventPoint 0 L ρ.im ζ+(((1-ρ.re)*L:ℝ):ℂ)) := by
  apply Complex.ext <;>
    simp [cdGramPoint,cdResolventPoint,Complex.mul_re,Complex.mul_im] <;> ring

set_option maxHeartbeats 1000000 in
/-- Transport the weighted analytic row to any finite tag family whose
fibers have at most the analytic multiplicities of the actual zeros. -/
theorem cdWindowKernel_row_le_of_analytic_fibers {ι : Type*} {q : ℕ} [NeZero q]
    (I : Finset ι) (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ) (i : ι)
    (L ω : ℝ) (B : ℝ)
    (hMultiplicity : ∀ z∈cdColumnZeros I χ ρ i,
      (((I.filter fun j=>χ i=χ j).filter fun j=>ρ j=z).card)≤
        analyticOrderNatAt (regularizedL (χ i)) z)
    (hAnalytic : (∑ z∈cdColumnZeros I χ ρ i,
      (analyticOrderNatAt (regularizedL (χ i)) z:ℝ)*
      ‖windowLaplace ω (cdResolventPoint 0 L (ρ i).im z+(((1-(ρ i).re)*L:ℝ):ℂ))‖^2) ≤ B) :
    (∑ j∈I,cdWindowKernel L ω χ ρ i j)≤B := by
  classical
  let S := I.filter fun j=>χ i=χ j
  let V := cdColumnZeros I χ ρ i
  let f (z : ℂ) := ‖windowLaplace ω (cdResolventPoint 0 L (ρ i).im z+
                       (((1-(ρ i).re)*L:ℝ):ℂ))‖^2
  have hImage : V=S.image ρ := by
    ext z
    simp only [V,S,cdColumnZeros,mem_image,mem_filter]
  have hV : (S:Set ι).MapsTo ρ V := by
    intro j hj
    rw [hImage]
    exact mem_image_of_mem ρ (mem_coe.mp hj)
  calc
    _ = ∑ j∈S,f (ρ j) := by
      rw [Finset.sum_filter]
      apply sum_congr rfl
      intro j _
      unfold cdWindowKernel
      split_ifs with h
      · dsimp only [f]
        rw [cdGramPoint_eq_conj_resolvent,norm_windowLaplace_conj]
      · rfl
    _ = ∑ z∈V,∑ j∈S.filter (fun j=>ρ j=z),f (ρ j) :=
      (sum_fiberwise_of_maps_to hV (f ∘ ρ)).symm
    _ ≤ _ := by
      refine (sum_le_sum fun z hz=>?_).trans hAnalytic
      have hE : (∑ j∈S.filter (fun j=>ρ j=z),f (ρ j))=
          ((S.filter (fun j=>ρ j=z)).card:ℝ)*f z := by
        calc
          _ = ∑ _j∈S.filter (fun j=>ρ j=z),f z := sum_congr rfl fun j hj => by
            rw [(mem_filter.mp hj).2]
          _ = _ := by rw [sum_const,nsmul_eq_mul]
      rw [hE]
      exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (hMultiplicity z hz)) (sq_nonneg _)

end
end GoldbachPintzWeightedFormula
end

