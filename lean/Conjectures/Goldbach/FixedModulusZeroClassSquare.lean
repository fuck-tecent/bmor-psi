noncomputable section

/-- The first `N` terms of the zeta Dirichlet series. -/
def zetaPartial (N : ℕ) (s : ℂ) : ℂ :=
  ∑ k ∈ Finset.Icc 1 N, (k : ℂ) ^ (-s)

private theorem trivial_mod_one_partial (N : ℕ) :
    charPartialSum (1 : DirichletCharacter ℂ 1) N = N := by
  simp [charPartialSum]

private theorem trivial_mod_one_mean :
    charMean (1 : DirichletCharacter ℂ 1) = 1 := by
  classical
  simp [charMean_eq]

private def zetaRemainderDensity (s : ℂ) (x : ℝ) : ℂ :=
  (x : ℂ) ^ (-s - 1) * ((⌊x⌋₊ : ℂ) - (x : ℂ))

private theorem norm_zeta_remainder_density {s : ℂ} {x : ℝ} (hx : 0 < x) :
    ‖zetaRemainderDensity s x‖ ≤ x ^ (-s.re - 1) := by
  have hf : ‖(⌊x⌋₊ : ℂ) - (x : ℂ)‖ ≤ 1 := by
    rw [← Complex.ofReal_natCast, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonpos (sub_nonpos.mpr (Nat.floor_le hx.le))]
    linarith [Nat.lt_floor_add_one x]
  rw [zetaRemainderDensity, norm_mul, norm_cpow_eq_rpow_re_of_pos hx, sub_re, neg_re, one_re]
  simpa only [mul_one] using
    mul_le_mul_of_nonneg_left hf (Real.rpow_nonneg hx.le (-s.re - 1))

private theorem zeta_remainder_integrable {s : ℂ} (hs : 0 < s.re) {a : ℝ} (ha : 0 < a) :
    IntegrableOn (zetaRemainderDensity s) (Set.Ioi a) := by
  have hMajor := integrableOn_Ioi_rpow_of_lt (show -s.re - 1 < -1 by linarith) ha
  refine Integrable.mono' hMajor ?_ ?_
  · have hF : Measurable (zetaRemainderDensity s) := (measurable_ofReal.pow_const _).mul
        ((measurable_of_countable (fun n : ℕ => (n : ℂ))).comp measurable_id.nat_floor |>.sub
          continuous_ofReal.measurable)
    exact hF.aestronglyMeasurable
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
    exact norm_zeta_remainder_density (ha.trans hx)

theorem zeta_eq_floorMellin {s : ℂ} (hs : 0 < s.re) (hs1 : s ≠ 1) :
    riemannZeta s = s * (∫ x in Set.Ioi (1 : ℝ), zetaRemainderDensity s x) + s / (s - 1) := by
  have hm := LFunctionTrivChar₁_eq_remainderMellin (q := 1) hs
  rw [DirichletCharacter.LFunctionTrivChar₁, Function.update_of_ne hs1] at hm
  change (s - 1) * DirichletCharacter.LFunction (1 : DirichletCharacter ℂ 1) s = _ at hm
  rw [DirichletCharacter.LFunction_modOne_eq, remainderMellin_eq_integral,
    trivial_mod_one_mean, mul_one] at hm
  simp only [trivial_mod_one_partial, mul_one] at hm
  apply mul_left_cancel₀ (sub_ne_zero.mpr hs1)
  unfold zetaRemainderDensity
  rw [hm, mul_add]
  field_simp

private theorem zetaPartial_eq_floorMellin {s : ℂ} (hs : 0 < s.re) (hs1 : s ≠ 1)
    {N : ℕ} (hN : 1 ≤ N) :
    zetaPartial N s = s * (∫ x in Set.Ioc (1 : ℝ) N, zetaRemainderDensity s x) +
      s / (s - 1) - (N : ℂ) ^ (1 - s) / (s - 1) := by
  let c : ℕ → ℂ := fun n => if n = 0 then 0 else 1
  let f : ℝ → ℂ := fun x => (x : ℂ) ^ (-s)
  have hn : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hn0 : (0 : ℝ) < N := zero_lt_one.trans_le hn
  have hs0 : s ≠ 0 := by
    intro he
    simp [he] at hs
  have hdiff {x : ℝ} (hx : 0 < x) :
      HasDerivAt f (-s * (x : ℂ) ^ (-s - 1)) x :=
    hasDerivAt_ofReal_cpow_const hx.ne' (neg_ne_zero.mpr hs0)
  have hcont (p : ℂ) : ContinuousOn (fun x : ℝ => (x : ℂ) ^ p) (Set.Ici 1) := by
    intro x hx
    exact (continuousAt_ofReal_cpow_const x p
      (Or.inr (zero_lt_one.trans_le hx).ne')).continuousWithinAt
  have hder : IntegrableOn (deriv f) (Set.Icc (1 : ℝ) N) := by
    have hcd : ContinuousOn (fun x : ℝ => -s * (x : ℂ) ^ (-s - 1))
        (Set.Icc (1 : ℝ) N) :=
      continuousOn_const.mul ((hcont _).mono Set.Icc_subset_Ici_self)
    exact (hcd.integrableOn_compact isCompact_Icc).congr_fun
      (fun x hx => (hdiff (zero_lt_one.trans_le hx.1)).deriv.symm) measurableSet_Icc
  have hc (M : ℕ) : (∑ k ∈ Finset.Icc 0 M, c k) = (M : ℂ) := by
    rw [← Nat.range_succ_eq_Icc_zero, Finset.sum_range_succ']
    simp [c]
  have habel := sum_mul_eq_sub_integral_mul₀' (c := c) (f := f) (m := N)
    (hc := by simp [c]) (hf_diff := fun x hx => (hdiff (zero_lt_one.trans_le hx.1)).differentiableAt)
    (hf_int := hder)
  have htrunc : (∑ k ∈ Finset.Icc 0 N, f k * c k) = zetaPartial N s := by
    rw [Finset.Icc_eq_cons_Ioc (Nat.zero_le N), Finset.sum_cons]
    simp only [c, ite_true, mul_zero, zero_add, zetaPartial]
    rw [← Finset.Icc_add_one_left_eq_Ioc]
    apply Finset.sum_congr rfl
    intro k hk
    have hpos := (Finset.mem_Icc.mp hk).1
    simp only [ite_eq_right (by omega : k ≠ 0), f, ofReal_natCast, mul_one]
  have hpoint {x : ℝ} (hx : 0 < x) :
      (x : ℂ) ^ (-s - 1) * (x : ℂ) = (x : ℂ) ^ (-s) := by
    simpa only [sub_add_cancel, cpow_one] using
      (cpow_add (-s - 1) 1 (ofReal_ne_zero.mpr hx.ne')).symm
  have hint : (∫ x in Set.Ioc (1 : ℝ) N,
      deriv f x * ∑ k ∈ Finset.Icc 0 ⌊x⌋₊, c k) =
      -s * ((∫ x in Set.Ioc (1 : ℝ) N, zetaRemainderDensity s x) +
        ∫ x in Set.Ioc (1 : ℝ) N, (x : ℂ) ^ (-s)) := by
    rw [← integral_add ((zeta_remainder_integrable hs one_pos).mono_set Set.Ioc_subset_Ioi_self)
      (((hcont _).mono Set.Icc_subset_Ici_self).integrableOn_compact isCompact_Icc |>.mono_set
        Set.Ioc_subset_Icc_self), ← integral_const_mul]
    apply setIntegral_congr_fun measurableSet_Ioc
    intro x hx
    dsimp only
    rw [hc, (hdiff (zero_lt_one.trans hx.1)).deriv, ← hpoint (zero_lt_one.trans hx.1)]
    unfold zetaRemainderDensity
    ring
  have hpowerInt : (∫ x in Set.Ioc (1 : ℝ) N, (x : ℂ) ^ (-s)) =
      ((N : ℂ) ^ (1 - s) - 1) / (1 - s) := by
    rw [← intervalIntegral.integral_of_le hn, integral_cpow]
    · simp only [Complex.ofReal_natCast, Complex.ofReal_one, one_cpow, neg_add_eq_sub]
    · refine Or.inr ⟨?_, ?_⟩
      · exact fun h => hs1 (by linear_combination -h)
      · rw [uIcc_of_le hn]
        exact fun h => zero_lt_one.not_ge h.1
  have hcut : f (N : ℝ) * (N : ℂ) = (N : ℂ) ^ (1 - s) := by
    change ((N : ℝ) : ℂ) ^ (-s) * (N : ℂ) = _
    rw [Complex.ofReal_natCast]
    simpa only [cpow_one, neg_add_eq_sub] using
      (cpow_add (-s) 1 (Nat.cast_ne_zero.mpr (by omega : N ≠ 0))).symm
  rw [← htrunc, habel, hc, hint, hpowerInt, hcut]
  have h1s : 1 - s ≠ 0 := sub_ne_zero.mpr hs1.symm
  field_simp [sub_ne_zero.mpr hs1, h1s]
  ring

/-- The zeta truncation error after subtracting its known pole contribution. -/
theorem zeta_truncation_with_pole {s : ℂ} (hs : 0 < s.re) (hs1 : s ≠ 1)
    {N : ℕ} (hN : 1 ≤ N) :
    ‖riemannZeta s - zetaPartial N s - (N : ℂ) ^ (1 - s) / (s - 1)‖ ≤
      (‖s‖ / s.re) * (N : ℝ) ^ (-s.re) := by
  have hn : (1 : ℝ) ≤ N := by exact_mod_cast hN
  have hn0 : (0 : ℝ) < N := zero_lt_one.trans_le hn
  have hsplit : (∫ x in Set.Ioi (1 : ℝ), zetaRemainderDensity s x) =
      (∫ x in Set.Ioc (1 : ℝ) N, zetaRemainderDensity s x) + ∫ x in Set.Ioi (N : ℝ), zetaRemainderDensity s x := by
    rw [← Set.Ioc_union_Ioi_eq_Ioi hn, setIntegral_union
      Set.Ioc_disjoint_Ioi_same measurableSet_Ioi
      ((zeta_remainder_integrable hs one_pos).mono_set Set.Ioc_subset_Ioi_self)
      (zeta_remainder_integrable hs hn0)]
  have hexact : riemannZeta s - zetaPartial N s - (N : ℂ) ^ (1 - s) / (s - 1) =
      s * ∫ x in Set.Ioi (N : ℝ), zetaRemainderDensity s x := by
    rw [zeta_eq_floorMellin hs hs1, zetaPartial_eq_floorMellin hs hs1 hN, hsplit]
    ring
  have hp : -s.re - 1 < -1 := by linarith
  have htail : ‖∫ x in Set.Ioi (N : ℝ), zetaRemainderDensity s x‖ ≤
      (N : ℝ) ^ (-s.re) / s.re := by
    refine (norm_integral_le_of_norm_le (integrableOn_Ioi_rpow_of_lt hp hn0) ?_).trans_eq ?_
    · filter_upwards [ae_restrict_mem measurableSet_Ioi] with x hx
      exact norm_zeta_remainder_density (hn0.trans hx)
    · rw [integral_Ioi_rpow_of_lt hp hn0, show -s.re - 1 + 1 = -s.re by ring]
      simp only [div_neg, neg_div, neg_neg]
  rw [hexact, norm_mul]
  exact (mul_le_mul_of_nonneg_left htail (norm_nonneg _)).trans_eq (by ring)


end

