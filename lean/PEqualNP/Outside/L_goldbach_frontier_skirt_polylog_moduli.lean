theorem Vwk (a : ℕ → ℂ) (x : ℝ) (N : ℕ)
    (hx : 0<x) (hxN : x≤N) :
    (x : ℂ)*V124 a x=Vor (range N) a x := by
  rw [V224 a x N hx hxN,mul_sum,Vor]
  apply sum_congr rfl
  intro n hn
  calc
    _ = a n*((x : ℂ)*V4t ((n : ℝ)/x)) := by ring
