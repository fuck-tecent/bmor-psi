namespace GoldbachMollifiedHarmonic

open Finset MeasureTheory

noncomputable section

/-- The natural real zeta series. The term at zero is zero for positive exponents. -/
def realZetaSeries (s : ℝ) : ℝ := ∑' n : ℕ, ((n:ℝ)^s)⁻¹

/-- The elementary zeta pole bound from comparison with an integral. -/
theorem real_zeta_one_add_le {ε : ℝ} (hε : 0 < ε) :
    realZetaSeries (1+ε) ≤ 1+ε⁻¹ := by
  let s := 1+ε
  let f (x : ℝ) := x^(-s)
  have hs : 1 < s := by dsimp only [s]; linarith only [hε]
  have hneg : -s < -1 := by linarith only [hs]
  have hs₀ : s ≠ 0 := by linarith only [hs]
  have hanti : AntitoneOn f (Set.Ici 1) := by
    intro x hx y _ hxy
    exact Real.rpow_le_rpow_of_nonpos (zero_lt_one.trans_le hx) hxy (by linarith only [hneg])
  have hint : IntegrableOn f (Set.Ioi 1) := integrableOn_Ioi_rpow_of_lt hneg zero_lt_one
  have hnon : ∀ x ∈ Set.Ioi (1:ℝ), 0 ≤ f x := by
    intro x hx
    exact Real.rpow_nonneg (zero_le_one.trans hx.le) _
  have htail := AntitoneOn.tsum_comp_add_le_integral 1 hanti hint hnon
  have hsum := ((Real.summable_nat_rpow_inv (p:=s)).2 hs).sum_add_tsum_nat_add 2
  have hsplit : realZetaSeries s = 1+∑' n : ℕ, f ((n+1+1:ℕ):ℝ) := by
    unfold realZetaSeries
    rw [← hsum]
    simp only [sum_range_succ, sum_range_zero, Nat.cast_zero, Nat.cast_one,
      Real.zero_rpow hs₀, inv_zero, Real.one_rpow, inv_one, zero_add]
    congr 1
    exact tsum_congr (fun n => by
      rw [show n+2=n+1+1 by omega]
      exact (Real.rpow_neg (Nat.cast_nonneg _) _).symm)
  have heval : (∫ x in Set.Ioi (1:ℝ), f x) = ε⁻¹ := by
    dsimp only [f]
    rw [integral_Ioi_rpow_of_lt hneg zero_lt_one,Real.one_rpow,
      show -s+1 = -ε by dsimp only [s]; ring]
    ring
  change realZetaSeries s ≤ _
  rw [hsplit]
  exact add_le_add le_rfl (htail.trans_eq heval)


end
end GoldbachMollifiedHarmonic

end

