set_option maxHeartbeats 1000000 in
/-- The real part of the first complex Cauchy coefficient is the cosine
moment of the real part on the circle. -/
theorem cauchy_deriv_re_cosine {f : ℂ → ℂ} {R : ℝ} (hR : 0<R)
    (hf : DiffContOnCl ℂ f (ball (0:ℂ) R)) :
    (deriv f 0).re =
      (∫ t in 0..2*Real.pi, Real.cos t*(f (circleMap 0 R t)).re)/(Real.pi*R) := by
  let v (t : ℝ) : ℂ := Complex.exp ((t:ℂ)*I)
  let F (t : ℝ) : ℂ := f (circleMap 0 R t)
  let α : ℂ := (R:ℂ)*I
  let β : ℂ := I/(R:ℂ)
  have hv (t : ℝ) : v t ≠ 0 := Complex.exp_ne_zero _
  have hRc : (R:ℂ) ≠ 0 := by exact_mod_cast hR.ne'
  have hα : α ≠ 0 := mul_ne_zero hRc Complex.I_ne_zero
  have hβ : β ≠ 0 := div_ne_zero Complex.I_ne_zero hRc
  have hc (t : ℝ) : circleMap 0 R t=(R:ℂ)*v t := by simp [circleMap,v]
  have hd (t : ℝ) : deriv (circleMap 0 R) t=α*v t := by
    rw [deriv_circleMap,hc]
    unfold α
    ring
  have hF : ContinuousOn F (Set.uIcc 0 (2*Real.pi)) := by
    apply hf.continuousOn_ball.comp (continuous_circleMap _ _).continuousOn
    intro t _
    exact sphere_subset_closedBall (circleMap_mem_sphere _ hR.le _)
  have hV : Continuous v := by unfold v; fun_prop
  have hVi : Continuous (fun t : ℝ => (v t)⁻¹) := hV.inv₀ hv
  have hA : ∫ t in 0..2*Real.pi, v t*F t=0 := by
    have hCircle := hf.circleIntegral_eq_zero hR.le
    have hEq : circleIntegral f 0 R =
        α*(∫ t in 0..2*Real.pi,v t*F t) := by
      rw [circleIntegral,←intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro t _
      dsimp only
      rw [hd,smul_eq_mul]
      exact mul_assoc _ _ _
    rw [hEq,mul_eq_zero] at hCircle
    exact hCircle.resolve_left hα
  have hB : (∫ t in 0..2*Real.pi, (v t)⁻¹*F t)=(2*(Real.pi:ℂ)*R)*deriv f 0 := by
    have hCircle := hf.deriv_eq_smul_circleIntegral hR
    have hEq : circleIntegral (fun z => (1/(z-(0:ℂ))^2) • f z) 0 R =
        β*(∫ t in 0..2*Real.pi,(v t)⁻¹*F t) := by
      rw [circleIntegral,←intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro t _
      dsimp only
      rw [hd,smul_eq_mul,smul_eq_mul,sub_zero,hc]
      unfold β α F
      rw [hc]
      field_simp [hRc,hv t] <;> ring
    rw [hEq,smul_eq_mul] at hCircle
    apply mul_left_cancel₀ hβ
    rw [hCircle]
    unfold β
    field_simp [hRc] <;> ring
  have hconj (t : ℝ) : conj (v t)=(v t)⁻¹ := by
    unfold v
    rw [← Complex.exp_conj,← Complex.exp_neg]
    simp [map_mul]
  have hAc : (∫ t in 0..2*Real.pi, (v t)⁻¹*conj (F t))=0 := by
    have hI : (∫ t in 0..2*Real.pi, (v t)⁻¹*conj (F t)) =
        conj (∫ t in 0..2*Real.pi, v t*F t) := by
      rw [←intervalIntegral.intervalIntegral_conj]
      apply intervalIntegral.integral_congr
      intro t _
      simp only [map_mul,hconj]
    rw [hI,hA,map_zero]
  have hcontConj : ContinuousOn (fun t => conj (F t)) (Set.uIcc 0 (2*Real.pi)) :=
    Complex.continuous_conj.comp_continuousOn hF
  have hInt₁ : IntervalIntegrable (fun t => (v t)⁻¹*F t) volume 0 (2*Real.pi) :=
    (hVi.continuousOn.mul hF).intervalIntegrable
  have hInt₂ : IntervalIntegrable (fun t => (v t)⁻¹*conj (F t)) volume 0 (2*Real.pi) :=
    (hVi.continuousOn.mul hcontConj).intervalIntegrable
  have hS : (∫ t in 0..2*Real.pi, (v t)⁻¹*F t)+(∫ t in 0..2*Real.pi, (v t)⁻¹*conj (F t)) =
      2*(∫ t in 0..2*Real.pi,(v t)⁻¹*((F t).re:ℂ)) := by
    rw [←intervalIntegral.integral_add hInt₁ hInt₂,←intervalIntegral.integral_const_mul]
    apply intervalIntegral.integral_congr
    intro t _
    change (v t)⁻¹*F t+(v t)⁻¹*conj (F t) = 2*((v t)⁻¹*((F t).re:ℂ))
    rw [←mul_add,show F t+conj (F t)=2*((F t).re:ℂ) by
      apply Complex.ext <;> simp [Complex.mul_re,Complex.mul_im] <;> ring]
    ring
  rw [hAc,add_zero,hB] at hS
  have hreal := congrArg Complex.re hS
  norm_num [Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im] at hreal
  have hInt : IntervalIntegrable (fun t => (v t)⁻¹*((F t).re:ℂ)) volume 0 (2*Real.pi) :=
    (hVi.continuousOn.mul
      (Complex.continuous_ofReal.comp_continuousOn (Complex.continuous_re.comp_continuousOn hF))).intervalIntegrable
  have hr : (∫ t in 0..2*Real.pi,(v t)⁻¹*((F t).re:ℂ)).re =
      ∫ t in 0..2*Real.pi,Real.cos t*(F t).re := by
    rw [←Complex.reCLM_apply,←Complex.reCLM.intervalIntegral_comp_comm hInt]
    apply intervalIntegral.integral_congr
    intro t _
    change ((v t)⁻¹*((F t).re:ℂ)).re = _
    rw [←hconj,Complex.mul_re,Complex.conj_re,Complex.ofReal_re,Complex.ofReal_im,mul_zero,sub_zero]
    have hcos : (Complex.cos (t:ℂ)).re = Real.cos t := by
      rw [← Complex.ofReal_cos, Complex.ofReal_re]
    simp [v, Complex.exp_mul_I, hcos]
  rw [hr] at hreal
  apply (eq_div_iff (by positivity : Real.pi*R ≠ 0)).mpr
  have he : (2:ℝ)*Real.pi*R*(deriv f 0).re = 2*(∫ t in 0..2*Real.pi,Real.cos t*(F t).re) := by
    exact hreal
  dsimp only [F] at he
  linarith only [he]

end
end GoldbachPintzWeightedFormula
end

