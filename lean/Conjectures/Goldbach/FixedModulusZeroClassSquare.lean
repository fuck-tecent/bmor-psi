namespace GoldbachZeroFree

open Complex Metric Set Goldbach GoldbachTwistedMellin
open scoped Classical

def line (σ t : ℝ) : ℂ := ⟨σ,t⟩

theorem re_recip_sub (s ρ : ℂ) :
    ((1:ℂ)/(s-ρ)).re = (s.re-ρ.re) / ((s.re-ρ.re)^2+(s.im-ρ.im)^2) := by
  rw [Complex.div_re, Complex.normSq_apply, Complex.sub_re, Complex.sub_im]
  simp only [Complex.one_re,Complex.one_im,one_mul]
  ring

private theorem zero_recip_nonneg {s ρ : ℂ} (hs : 1 < s.re) (hρ : ρ.re ≤ 1) :
    0 ≤ ((1:ℂ)/(s-ρ)).re := by
  rw [re_recip_sub]
  exact div_nonneg (sub_nonneg.mpr (hρ.trans hs.le)) (by positivity)

theorem order_recip_sub (f : ℂ → ℂ) (s ρ : ℂ) :
    ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re =
      (analyticOrderNatAt f ρ:ℝ)*((1:ℂ)/(s-ρ)).re := by
  rw [show ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)) =
      (analyticOrderNatAt f ρ:ℂ)*((1:ℂ)/(s-ρ)) by ring, ← Complex.ofReal_natCast]
  simp [Complex.mul_re]

set_option maxHeartbeats 1050000 in
/-- The logarithmic derivative near the line one, with any chosen subset
of nearby zeros retained in the real-part upper bound. -/
theorem neg_logDeriv_upper_with_weighted_zeros : ∃ A : ℝ, 0 < A ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) {δ t : ℝ},
      0 < δ → δ ≤ 1 → ∀ V : Finset ℂ,
      (∀ ρ ∈ V, regularizedL χ ρ = 0 ∧ ‖ρ-line 2 t‖ ≤ 3/2) →
      (-logDeriv χ.LFunction (line (1+δ) t)).re ≤
        A*logHeight q t + (principalFlag χ/(line (1+δ) t-1)).re -
          ∑ ρ ∈ V, ((analyticOrderNatAt (regularizedL χ) ρ:ℂ)/(line (1+δ) t-ρ)).re := by
  let R : ℝ := 15/8
  let A : ℝ := 130200/R
  have hR : 0 < R := by norm_num [R]
  have hA : 0 < A := by dsimp [A]; positivity
  refine ⟨13*A,by positivity,?_⟩
  intro q _ χ δ t hδ hδ1 V hV
  let f := regularizedL χ
  let c := line 2 t
  let s := line (1+δ) t
  let K : ℝ := 2+|t|
  let B : ℝ := 900*(q:ℝ)*K^2
  have hq1 : (1:ℝ) ≤ q := by exact_mod_cast NeZero.pos q
  have hq0 : (0:ℝ) < q := zero_lt_one.trans_le hq1
  have hK2 : 2 ≤ K := le_add_of_nonneg_right (abs_nonneg t)
  have hK1 : 1 ≤ K := by linarith only [hK2]
  have hK0 : 0 < K := zero_lt_one.trans_le hK1
  have hB0 : 0 < B := by dsimp [B]; positivity
  have hB2 : 2 ≤ B := by
    calc
      (2:ℝ) ≤ 900*1*1 := by norm_num
      _ ≤ B := mul_le_mul (mul_le_mul_of_nonneg_left hq1 (by norm_num))
        (one_le_pow₀ hK1) zero_le_one (by positivity)
  have hReLower (w : ℂ) (hw : w ∈ closedBall c R) : (1/8:ℝ) ≤ w.re := by
    have hd := mem_closedBall_iff_norm.mp hw
    have hre := Complex.abs_re_le_norm (w-c)
    rw [Complex.sub_re,show c.re=2 by rfl] at hre
    dsimp only [R] at hd
    linarith only [hre,hd,neg_le_abs (w.re-2)]
  have hcform : c = (2:ℂ)+(t:ℂ)*I := by apply Complex.ext <;> simp [c,line,Complex.mul_re,Complex.mul_im]
  have hcnorm : ‖c‖ ≤ K := by
    rw [hcform]
    exact (norm_add_le _ _).trans_eq (by simp [K,Complex.norm_real,Real.norm_eq_abs])
  have hAnchor : (1/4:ℝ) ≤ ‖f c‖ := norm_regularizedL_anchor χ t
  have hf0 : f c ≠ 0 := norm_pos_iff.mp ((by norm_num : (0:ℝ)<1/4).trans_le hAnchor)
  have hf : AnalyticOnNhd ℂ f (closedBall c R) := (analytic_regularizedL χ).mono (subset_univ _)
  have hfB (w : ℂ) (hw : w ∈ closedBall c (24/25*R)) : ‖f w‖ ≤ B*‖f c‖ := by
    have hwBig := closedBall_subset_closedBall (show (24/25:ℝ)*R≤R by norm_num [R]) hw
    have hd := mem_closedBall_iff_norm.mp hwBig
    have hn : 1+‖w‖ ≤ 3*K := by
      dsimp only [R] at hd
      linarith only [norm_le_norm_sub_add w c,hd,hcnorm,hK2]
    have hh : ‖f w‖ ≤ 25*(q:ℝ)*(1+‖w‖)^2 := by
      have hg := GoldbachGrhGrowth.norm_regularizedLFunction_le χ (hReLower w hwBig)
      by_cases hχ : χ=1 <;> simpa [f,regularizedL,hχ] using hg
    calc
      _ ≤ 25*(q:ℝ)*(1+‖w‖)^2 := hh
      _ ≤ 25*(q:ℝ)*(3*K)^2 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hn 2) (by positivity)
      _ = B*(1/4:ℝ) := by dsimp [B]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hAnchor hB0.le
  have hs1 : 1 < s.re := by change 1<1+δ; linarith only [hδ]
  have hs0 : f s ≠ 0 := regularizedL_ne_zero_right χ hs1
  have hsBall : s ∈ closedBall c (83/100*R) := by
    have hsSub : s-c = ((δ-1:ℝ):ℂ) := by apply Complex.ext <;> simp [s,c,line] <;> ring
    rw [mem_closedBall_iff_norm,hsSub,Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (by linarith only [hδ1])]
    dsimp [R]
    linarith only [hδ]
  obtain ⟨Z,hZ,_,hApprox⟩ := GoldbachGrhLogDerivative.logDeriv_partial_fraction_disk hR hf hf0 hB2 hfB
  have hVZ : V ⊆ Z := by
    intro ρ hρ
    change ρ ∈ (↑Z:Set ℂ)
    rw [hZ]
    refine ⟨mem_closedBall_iff_norm.mpr ?_,(hV ρ hρ).1⟩
    exact (hV ρ hρ).2.trans (by norm_num [R])
  have hZmem (ρ : ℂ) (hρ : ρ ∈ Z) : f ρ = 0 := by
    have hz : ρ ∈ (↑Z:Set ℂ) := hρ
    rw [hZ] at hz
    exact hz.2
  have hsmall (ρ : ℂ) (hρ : ρ ∈ Z) : ρ.re ≤ 1 :=
    le_of_not_gt (fun hh => regularizedL_ne_zero_right χ hh (hZmem ρ hρ))
  have hmass : (∑ ρ ∈ V, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re) ≤
      (∑ ρ ∈ Z, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re) := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hVZ
    intro ρ hρ _
    rw [order_recip_sub]
    exact mul_nonneg (Nat.cast_nonneg _) (zero_recip_nonneg hs1 (hsmall ρ hρ))
  have hqlog := Real.log_nonneg hq1
  have hKlog := Real.log_nonneg hK1
  have hlog900 : Real.log 900 ≤ 10 * Real.log 2 := by
    calc
      _ ≤ Real.log ((2:ℝ)^(10:ℕ)) := Real.log_le_log (by norm_num) (by norm_num)
      _ = _ := by rw [Real.log_pow]; norm_num
  have hBL : Real.log B ≤ 13*logHeight q t := by
    change Real.log (900*(q:ℝ)*K^2) ≤ 13*Real.log (2*(q:ℝ)*K)
    rw [Real.log_mul (by positivity) (pow_ne_zero _ hK0.ne'),
      Real.log_mul (by norm_num) hq0.ne',Real.log_pow,
      Real.log_mul (by positivity) hK0.ne',Real.log_mul (by norm_num) hq0.ne']
    norm_num
    linarith only [hlog900,hqlog,hKlog,Real.log_nonneg (by norm_num : (1:ℝ)≤2)]
  have hd := (neg_le_abs ((logDeriv f s -
    ∑ ρ∈Z, (analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re)).trans
    (Complex.abs_re_le_norm _)
  have hb := hd.trans ((hApprox s hsBall hs0).trans (mul_le_mul_of_nonneg_left hBL hA.le))
  have hsne : s ≠ 1 := by intro h; simp [h] at hs1
  have hL := χ.LFunction_ne_zero_of_one_le_re (Or.inr hsne) hs1.le
  rw [Complex.sub_re, show (∑ ρ∈Z, (analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re = _ from
    map_sum Complex.reAddGroupHom _ _,logDeriv_regularizedL_eq χ hsne hL,Complex.add_re] at hb
  change -((logDeriv χ.LFunction s).re + (principalFlag χ/(s-1)).re -
    ∑ ρ ∈ Z, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re) ≤ A*(13*logHeight q t) at hb
  change (-logDeriv χ.LFunction s).re ≤ 13*A*logHeight q t +
    (principalFlag χ/(s-1)).re - ∑ ρ ∈ V, ((analyticOrderNatAt f ρ:ℂ)/(s-ρ)).re
  rw [Complex.neg_re,show 13*A*logHeight q t = A*(13*logHeight q t) by ring]
  linarith only [hb,hmass]

theorem neg_logDeriv_upper_with_zeros : ∃ A : ℝ, 0 < A ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) {δ t : ℝ},
      0 < δ → δ ≤ 1 → ∀ V : Finset ℂ,
      (∀ ρ ∈ V, regularizedL χ ρ = 0 ∧ ‖ρ-line 2 t‖ ≤ 3/2) →
      (-logDeriv χ.LFunction (line (1+δ) t)).re ≤
        A*logHeight q t + (principalFlag χ/(line (1+δ) t-1)).re -
          ∑ ρ ∈ V, ((1:ℂ)/(line (1+δ) t - ρ)).re := by
  obtain ⟨A,hA,h⟩ := neg_logDeriv_upper_with_weighted_zeros
  refine ⟨A,hA,?_⟩
  intro q _ χ δ t hδ hδ1 V hV
  refine (h q χ hδ hδ1 V hV).trans (sub_le_sub_left ?_ _)
  apply Finset.sum_le_sum
  intro ρ hρ
  rw [order_recip_sub]
  have hs : 1 < (line (1+δ) t).re := by change 1<1+δ; linarith only [hδ]
  have hsmall : ρ.re ≤ 1 := le_of_not_gt
    (fun hh => regularizedL_ne_zero_right χ hh (hV ρ hρ).1)
  have horder : (1:ℝ) ≤ analyticOrderNatAt (regularizedL χ) ρ := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff χ ρ).mpr (hV ρ hρ).1
  exact le_mul_of_one_le_left (zero_recip_nonneg hs hsmall) horder

end GoldbachZeroFree

end

section

namespace GoldbachZeroFree

open Complex GoldbachSmoothing
open scoped BigOperators

private theorem quadratic_trig_nonneg (z : ℂ) (hz : ‖z‖ ≤ 1) :
    0 ≤ 3 + 4*z.re + (z^2).re := by
  have hn := sq_le_sq' (by linarith only [norm_nonneg z] : -(1:ℝ) ≤ ‖z‖) hz
  rw [Complex.sq_norm,Complex.normSq_apply] at hn
  rw [pow_two,Complex.mul_re]
  nlinarith only [hn,sq_nonneg (z.re+1)]

private noncomputable def termAt {q : ℕ} (χ : DirichletCharacter ℂ q) (σ t : ℝ) (n : ℕ) : ℝ :=
  (LSeries.term (twistedCoefficient χ) (⟨σ,t⟩:ℂ) n).re

private theorem termAt_factor {q : ℕ} (χ : DirichletCharacter ℂ q)
    (σ t : ℝ) {n : ℕ} (hn : n ≠ 0) :
    termAt χ σ t n =
      ArithmeticFunction.vonMangoldt n * (n:ℝ)^(-σ) *
        (χ (n:ZMod q)*(n:ℂ)^(-(t:ℂ)*I)).re := by
  have hnC : (n:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn
  have hnR : (0:ℝ) ≤ n := by positivity
  have hexp : -(⟨σ,t⟩:ℂ) = ((-σ:ℝ):ℂ)+(-(t:ℂ)*I) := by
    apply Complex.ext <;> simp [Complex.mul_re,Complex.mul_im]
  rw [termAt,LSeries.term_of_ne_zero hn,div_eq_mul_inv,← Complex.cpow_neg,hexp,
    Complex.cpow_add _ _ hnC,← Complex.ofReal_natCast,← Complex.ofReal_cpow hnR,
    Complex.ofReal_natCast]
  simp only [twistedCoefficient,Pi.mul_apply]
  rw [show χ (n:ZMod q) * ↑(ArithmeticFunction.vonMangoldt n) *
      (↑((n:ℝ)^(-σ)) * (n:ℂ)^(-(t:ℂ)*I)) =
      (↑(ArithmeticFunction.vonMangoldt n * (n:ℝ)^(-σ)):ℂ) *
      (χ (n:ZMod q) * (n:ℂ)^(-(t:ℂ)*I)) by push_cast; ring]
  simp [Complex.mul_re]

private theorem positive_terms_three {q : ℕ} (χ : DirichletCharacter ℂ q) (σ t : ℝ)
    (n : ℕ) :
    0 ≤ 3*termAt (1:DirichletCharacter ℂ q) σ 0 n +
      4*termAt χ σ t n + termAt (χ^2) σ (2*t) n := by
  by_cases hn : n = 0
  · subst n
    simp [termAt]
  simp only [termAt_factor _ _ _ hn]
  by_cases hunit : IsUnit (n:ZMod q)
  · let v := (n:ℂ)^(-(t:ℂ)*I)
    let z := χ (n:ZMod q)*v
    let w := ArithmeticFunction.vonMangoldt n * (n:ℝ)^(-σ)
    have he : (n:ℂ)^(-((2*t:ℝ):ℂ)*I) = v^2 := by
      rw [show -((2*t:ℝ):ℂ)*I = (2:ℂ)*(-(t:ℂ)*I) by push_cast; ring]
      exact Complex.cpow_ofNat_mul (n:ℂ) 2 (-(t:ℂ)*I)
    have hv : ‖v‖ = 1 := by
      dsimp only [v]
      rw [Complex.norm_natCast_cpow_of_pos (Nat.pos_of_ne_zero hn)]
      simp [Complex.mul_re]
    have hz : ‖z‖ ≤ 1 := by
      dsimp only [z]
      rw [norm_mul,hv,mul_one]
      exact χ.norm_le_one _
    have hw : 0 ≤ w := by
      exact mul_nonneg ArithmeticFunction.vonMangoldt_nonneg (by positivity)
    rw [MulChar.one_apply hunit,χ.pow_apply' two_ne_zero,he]
    simp only [ofReal_zero,neg_zero,zero_mul,cpow_zero,one_re, mul_one,
      ← mul_pow]
    change 0 ≤ 3*w+4*(w*z.re)+w*(z^2).re
    calc
      _ ≤ w*(3+4*z.re+(z^2).re) := mul_nonneg hw (quadratic_trig_nonneg z hz)
      _ = _ := by ring
  · rw [MulChar.map_nonunit (1:DirichletCharacter ℂ q) hunit,
      MulChar.map_nonunit χ hunit,MulChar.map_nonunit (χ^2) hunit]
    simp

private theorem sum_termAt {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {σ : ℝ} (hσ : 1<σ) (t : ℝ) :
    HasSum (termAt χ σ t) (-logDeriv χ.LFunction (⟨σ,t⟩:ℂ)).re := by
  have hs : 1 < (⟨σ,t⟩:ℂ).re := hσ
  have hχ := χ.LSeriesSummable_twist_vonMangoldt hs
  change LSeriesSummable (twistedCoefficient χ) (⟨σ,t⟩:ℂ) at hχ
  rw [← LSeries_twistedCoefficient_eq χ hs]
  exact Complex.hasSum_re hχ.hasSum

/-- The 3, 4, 1 Euler product inequality in logarithmic derivative form. -/
theorem logDerivative_three_nonneg {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {σ : ℝ} (hσ : 1<σ) (t : ℝ) :
    0 ≤ 3*(-logDeriv (1:DirichletCharacter ℂ q).LFunction (⟨σ,0⟩:ℂ)).re +
      4*(-logDeriv χ.LFunction (⟨σ,t⟩:ℂ)).re +
      (-logDeriv (χ^2).LFunction (⟨σ,2*t⟩:ℂ)).re := by
  have h₀ := (sum_termAt (1:DirichletCharacter ℂ q) hσ 0).mul_left 3
  have h₁ := (sum_termAt χ hσ t).mul_left 4
  have h₂ := sum_termAt (χ^2) hσ (2*t)
  rw [← ((h₀.add h₁).add h₂).tsum_eq]
  exact tsum_nonneg (positive_terms_three χ σ t)

end GoldbachZeroFree

end

