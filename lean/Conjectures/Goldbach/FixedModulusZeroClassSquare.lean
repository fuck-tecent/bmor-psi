set_option maxHeartbeats 900000 in
theorem pair_rational_primeTest_nonneg {q : ℕ} [NeZero q] (χ ψ : DirichletCharacter ℂ q)
    {b L σ s t : ℝ} (hb : 0<b) (hL : 0<L) (hσ : 1<σ+b/L) :
    0≤(rationalPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re+
      (rationalPrimeTest χ b L (line σ s)).re+(rationalPrimeTest ψ b L (line σ t)).re+
      (1/2)*((rationalPrimeTest (χ*ψ) b L (line σ (s+t))).re+
        (rationalPrimeTest (χ*ψ⁻¹) b L (line σ (s-t))).re) := by
  have h0 := tendsto_rational_primeSum (1:DirichletCharacter ℂ q) b L σ 0 hσ
  have h1 := tendsto_rational_primeSum χ b L σ s hσ
  have h2 := tendsto_rational_primeSum ψ b L σ t hσ
  have h3 := tendsto_rational_primeSum (χ*ψ) b L σ (s+t) hσ
  have h4 := tendsto_rational_primeSum (χ*ψ⁻¹) b L σ (s-t) hσ
  exact ge_of_tendsto' (((h0.add h1).add h2).add ((h3.add h4).const_mul (1/2))) fun N=>
    pair_primeSum_nonneg χ ψ (Finset.range N) _ (fun n _=>
      rationalPrimeWeight_nonneg hb.le (div_nonneg (Real.log_natCast_nonneg n) hL.le)) σ s t

set_option maxHeartbeats 900000 in
theorem pair_anchor_primeTest_nonneg {q : ℕ} [NeZero q] (χ ψ : DirichletCharacter ℂ q)
    {b L σ s t : ℝ} (hb : 0<b) (hL : 0<L) (hσ : 1<σ+b/L) :
    0≤(anchorPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re+
      (anchorPrimeTest χ b L (line σ s)).re+(anchorPrimeTest ψ b L (line σ t)).re+
      (1/2)*((anchorPrimeTest (χ*ψ) b L (line σ (s+t))).re+
        (anchorPrimeTest (χ*ψ⁻¹) b L (line σ (s-t))).re) := by
  have h0 := tendsto_anchor_primeSum (1:DirichletCharacter ℂ q) b L σ 0 hσ
  have h1 := tendsto_anchor_primeSum χ b L σ s hσ
  have h2 := tendsto_anchor_primeSum ψ b L σ t hσ
  have h3 := tendsto_anchor_primeSum (χ*ψ) b L σ (s+t) hσ
  have h4 := tendsto_anchor_primeSum (χ*ψ⁻¹) b L σ (s-t) hσ
  exact ge_of_tendsto' (((h0.add h1).add h2).add ((h3.add h4).const_mul (1/2))) fun N=>
    pair_primeSum_nonneg χ ψ (Finset.range N) _ (fun n _=>anchorPrimeWeight_nonneg hb.le hL.le n) (σ+b/L) s t

end GoldbachPintzWeightedFormula
