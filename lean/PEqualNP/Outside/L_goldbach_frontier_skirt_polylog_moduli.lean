private theorem Vmt (p k d : ℕ) (hp : p.Prime)
    (hd : p ≤ d * (p-1)^2) :
    p^(k+1) ≤ d * (p^(k+1)).totient^2 := by
  rw [Nat.totient_prime_pow_succ hp, pow_succ]
  have ha : 1 ≤ p^k := one_le_pow₀ hp.one_lt.le
  have haa : p^k ≤ (p^k)^2 := by nlinarith only [ha]
  calc
    p^k*p ≤ p^k*(d*(p-1)^2) := Nat.mul_le_mul_left _ hd
    _ ≤ (p^k)^2*(d*(p-1)^2) := Nat.mul_le_mul_right _ haa
    _ = d*(p^k*(p-1))^2 := by ring
