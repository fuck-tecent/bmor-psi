  have hUpper (u : ℝ) (hu : 0≤ u) :
      exponentialAutoWeight S a b u≤ max (c-u) 0+δ*Real.exp (-B*u) :=
    (hF u hu).2.trans (add_le_add_right (mul_le_mul_of_nonneg_right hErr (by positivity)) _)
  have hCδ : 0≤ c-δ := by norm_num [c,δ]
  have hF00lo : (1-δ)^2*(c-δ)≤ exponentialAutoWeight S a b 0 := by
    simpa only [sub_zero,max_eq_left hCδ] using hLower 0 (le_refl 0)
  have hF00hi : exponentialAutoWeight S a b 0≤ c+δ := by
    simpa only [sub_zero,max_eq_left hc,mul_zero,Real.exp_zero,mul_one] using hUpper 0 (le_refl 0)
  refine ⟨S,a,b,hb,ha,(by nlinarith only [hF00lo,show 0<(1-δ)^2*(c-δ) by norm_num [δ,c]]),?_,?_⟩
  · have hF := setIntegral_mono_on
      ((triangle_integrable (k:=fun _=>1) continuous_const (c-δ)).const_mul ((1-δ)^2))
      (auto_scalar_integrable S a b hb') measurableSet_Ioi
      (fun t ht=>by simpa using hLower t (mem_Ioi.mp ht).le)
    simp only [one_mul] at hF
    rw [integral_const_mul,triangle_integral hCδ,←auto_integral_eq_re S a b hb'] at hF
    have hNum : (8499/10000:ℝ)*(c+δ)≤(1-δ)^2*((c-δ)^2/2) := by norm_num [c,δ]
    exact (mul_le_mul_of_nonneg_left hF00hi (by norm_num)).trans (hNum.trans hF)
  · intro μ hμ
    have hμ0 := (mem_Icc.mp hμ).1
    have hμH := (mem_Icc.mp hμ).2
    have hBμ : 1≤ B-μ := by unfold B; linarith only [hμH]
    have hBμ0 : 0<B-μ := zero_lt_one.trans_le hBμ
    have hHpow : ∀ i∈S, μ<b i := fun i hi=>
      hμH.trans_lt ((lt_add_of_pos_right H one_pos).trans_le (hb i hi))
    have hTri := (triangle_integrable (k:=id) continuous_id c).const_mul (Real.exp (c*μ))
    have hExp := ((integrableOn_rpow_mul_exp_neg_mul_rpow (s:=1) (p:=1) (b:=B-μ)
