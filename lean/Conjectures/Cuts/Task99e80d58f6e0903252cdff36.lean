private theorem shifted_finite_lower {N : ℕ} (hN : 16 ≤ N) (he : Even N) (D : ℕ)
    (hD : ∀ p ∈ (GoldbachRoughFifth.primorial N).primeFactors, p < D) {k : ℝ}
    (hMain : k * sieveDensity N ≤ (shiftSieve N he).mainSum (lowerRosserWeight (GoldbachRoughFifth.primorial N) D)) :
    k * (shiftSieve N he).totalMass * sieveDensity N -
      (∑ d ∈ (Icc 1 D).filter (fun d => d ∣ GoldbachRoughFifth.primorial N), |(shiftSieve N he).rem d|) ≤
      (shiftSieve N he).siftedSum := by
  let S := shiftSieve N he
  let P := GoldbachRoughFifth.primorial N
  let w := lowerRosserWeight P D
  have hCert := lowerRosserWeight_certificate (primorial_squarefree N)
    (primorial_squarefree N).ne_zero hD
  have hFinite := mainSum_sub_lowerErrSum_le_siftedSum (S := S) D w hCert
    (lowerRosserWeight_hasLowerLevelSupport P D)
  have hSub : P.divisors.filter (fun d => d < D) ⊆ (Icc 1 D).filter (fun d => d ∣ P) := by
    intro d hd
    obtain ⟨hDiv,hLt⟩ := mem_filter.mp hd
    exact mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hDiv,hLt.le⟩,
      Nat.dvd_of_mem_divisors hDiv⟩
  have hError : lowerErrSum S D w ≤ ∑ d ∈ (Icc 1 D).filter (fun d => d ∣ P), |S.rem d| := by
    calc
      _ ≤ ∑ d ∈ P.divisors.filter (fun d => d < D), |S.rem d| :=
        sum_le_sum fun d _ => mul_le_of_le_one_left (abs_nonneg _) (abs_lowerRosserWeight_le_one P D d)
      _ ≤ _ := sum_le_sum_of_subset_of_nonneg hSub (fun _ _ _ => abs_nonneg _)
  have hLength : (N : ℝ)/4 ≤ S.totalMass := central_prefix_length_ge_quarter N hN
  have hMass : 0 ≤ S.totalMass := (by positivity : 0 ≤ (N : ℝ)/4).trans hLength
  have hLow := mul_le_mul_of_nonneg_left hMain hMass
  exact (sub_le_sub (by simpa only [mul_left_comm k, mul_assoc] using hLow) hError).trans hFinite

private theorem shifted_rosser_main :
    ∃ k : ℝ, 0 < k ∧ ∀ᶠ N : ℕ in atTop, ∀ he : Even N,
      k * (shiftSieve N he).totalMass * sieveDensity N -
        (∑ d ∈ (Icc 1 (level N)).filter (fun d => d ∣ GoldbachRoughFifth.primorial N), |(shiftSieve N he).rem d|) ≤
        (shiftSieve N he).siftedSum := by
  obtain ⟨K,hK,hLocal⟩ := short_interval_product_input
  obtain ⟨k,hKpos,D₀,hMain⟩ := RoughFifthSieve.fixedLowerDensity hK
  refine ⟨k,hKpos,?_⟩
  filter_upwards [eventually_ge_atTop (32:ℕ), tendsto_level.eventually (eventually_ge_atTop D₀),
    eventually_fifth_factor_cutoffs] with N hN hD hCuts
  intro he
  let D := level N
  let z := ⌈(D:ℝ) ^ (1/(11/5:ℝ))⌉₊
  have hCut (p : ℕ) (hp : p ∈ (GoldbachRoughFifth.primorial N).primeFactors) : p < z ∧ p < D := by
    rw [primorial_factors] at hp
    exact hCuts p (mem_filter.mp hp).2.2.1
  have hz : 2 ≤ z := (hCuts 2 (by norm_num; omega)).1.le
  obtain ⟨hProd, hTable⟩ := local_sieve_table N he D z (fun p hp => (hCut p hp).1)
  apply shifted_finite_lower (by omega) he D (fun p hp => (hCut p hp).2)
  change k * sieveDensity N ≤ (centralSieve N he).mainSum (lowerRosserWeight (GoldbachRoughFifth.primorial N) D)
  rw [hTable, ← hProd]
  exact hMain D hD (centralSieve N he) (hLocal N he) hz

theorem shifted_dyadic_lower_count :
    ∃ c : ℝ, 0 < c ∧ ∃ N₀ : ℕ, ∀ N ≥ N₀, Even N →
      c * (N : ℝ) ≤ ((hits N).card : ℝ) * (Real.log (N : ℝ))^2 := by
  obtain ⟨k,hk,hRosser⟩ := shifted_rosser_main
  obtain ⟨b,hb,hDensity⟩ := sieveDensity_invlog_lower
  obtain ⟨E,hE,hDist⟩ := shifted_prime_distribution 2 (by norm_num)
  apply rough_count_from_main_minus_error (fun N => (hits N).card)
  refine ⟨k*b/4,E,by positivity,hE.le,?_⟩
  filter_upwards [hRosser,hDist,eventually_ge_atTop (16:ℕ)] with N hR hB hN
  intro he
  have hLog := Real.log_pos (show (1:ℝ) < N by exact_mod_cast (by omega : 1 < N))
  have hLength : (N:ℝ)/4 ≤ (shiftSieve N he).totalMass := central_prefix_length_ge_quarter N hN
  have hTot : 0 ≤ (shiftSieve N he).totalMass :=
    (by positivity : 0 ≤ (N:ℝ)/4).trans hLength
  have hMass : (k*b/4)*N/Real.log N ≤ k*(shiftSieve N he).totalMass*sieveDensity N := by
    calc
      _ = (k*((N:ℝ)/4))*(b/Real.log N) := by ring
      _ ≤ _ := mul_le_mul (mul_le_mul_of_nonneg_left hLength hk.le)
        (hDensity N (by omega) he) (div_nonneg hb.le hLog.le) (mul_nonneg hk.le hTot)
  let D := level N
  have hCut : (D : ℝ) ≤ (N : ℝ)^(9/20:ℝ) := Nat.floor_le (by positivity)
  have hCoprime : (2 : ℕ).Coprime (GoldbachRoughFifth.primorial N) :=
    (primorial_coprime N).symm.coprime_dvd_left (even_iff_two_dvd.mp he)
  have hError := hB D (GoldbachRoughFifth.primorial N) hCut hCoprime
  dsimp only at hError
  rw [Real.rpow_two] at hError
  have hRemainder :
      (∑ d ∈ (Icc 1 D).filter (fun d => d ∣ GoldbachRoughFifth.primorial N), |(shiftSieve N he).rem d|) ≤
        E*N/(Real.log N)^2 := by
    refine le_trans (le_of_eq (sum_congr rfl ?_)) hError
    intro d _
    rw [shifted_rem_bv (by omega : 12 ≤ N) he]
  exact (sub_le_sub hMass hRemainder).trans
    ((hR he).trans (shifted_siftedSum_le_log_count (by omega) he))

theorem reverse_rough_lower_count :
    ∃ c : ℝ, 0 < c ∧ ∃ X₀ : ℕ, ∀ X ≥ X₀,
      c * (X : ℝ) ≤ ((candidates X).card : ℝ) * (Real.log (X : ℝ))^2 := by
  obtain ⟨c,hc,N₀,hLower⟩ := shifted_dyadic_lower_count
  refine ⟨c/2,by positivity,2 * max N₀ 16,?_⟩
  intro X hX
  have h16 : 16 ≤ max N₀ 16 := le_max_right _ _
  have hBase : N₀ ≤ max N₀ 16 := le_max_left _ _
  have hPos : 0 < X := by omega
  obtain ⟨hLe,hLt⟩ := dyadicScale_bounds hPos
  have hScale : 16 ≤ dyadicScale X := by omega
  have hEven := dyadicScale_even (X := X) (by omega)
  have hCard : ((hits (dyadicScale X)).card : ℝ) ≤ ((candidates X).card : ℝ) := by
    exact_mod_cast shifted_hits_card_le_candidates (X := X) (by omega)
  have hnReal : (0 : ℝ) < dyadicScale X := by exact_mod_cast (by omega : 0 < dyadicScale X)
  have hLog : Real.log ((dyadicScale X : ℕ) : ℝ) ≤ Real.log (X : ℝ) :=
    Real.log_le_log hnReal (by exact_mod_cast hLe)
  have hLogNN : 0 ≤ Real.log ((dyadicScale X : ℕ) : ℝ) :=
    Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ dyadicScale X))
  have hXR : (X : ℝ) ≤ 2 * ((dyadicScale X : ℕ) : ℝ) := by exact_mod_cast hLt.le
  have hMul := mul_le_mul_of_nonneg_left hXR hc.le
  calc
    _ ≤ c * (dyadicScale X : ℝ) := by linarith only [hMul]
    _ ≤ ((hits (dyadicScale X)).card : ℝ) * (Real.log (dyadicScale X : ℝ))^2 :=
      hLower _ (by omega) hEven
    _ ≤ _ := mul_le_mul hCard (pow_le_pow_left₀ hLogNN hLog 2) (sq_nonneg _) (by positivity)

theorem reverse_rough_lower_count_frozen :
    have x1 : ℕ → Finset ℕ := fun (x1 : ℕ) => {x2 ∈ Finset.range (x1 + (1 : ℕ)) | (1 : ℕ) < x2 ∧ Nat.Prime (x2 + (2 : ℕ)) ∧ ∀ x3 ∈ x2.divisors, Nat.Prime x3 → x1 ≤ x3 ^ (10 : ℕ)}
    ∃ (x2 : ℝ), (0 : ℝ) < x2 ∧ ∃ (x3 : ℕ), ∀ (x4 : ℕ), x3 ≤ x4 → x2 * ↑x4 ≤ ↑(x1 x4).card * Real.log ↑x4 ^ (2 : ℕ) := by
  simpa only [candidates] using reverse_rough_lower_count


