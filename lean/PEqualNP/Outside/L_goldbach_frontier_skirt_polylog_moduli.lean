      15+((K:ℝ)+1)*C*(L+1)^6 := by
    calc
      _ = ‖(hurwitzZeta (a:UnitAddCircle) s-V29 a s-
          ∑ n∈range N,(((n+1:ℕ):ℝ)+a:ℂ)^(-s))+
          ∑ n∈range N,(((n+1:ℕ):ℝ)+a:ℂ)^(-s)‖ := by congr 1; ring
