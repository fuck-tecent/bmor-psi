namespace GoldbachPintzTheta

open ArithmeticFunction Finset
open Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337
noncomputable section

/-- The logarithmic coordinate with primes in the index excluded. -/
def coprimeLogCoordinate (r : ℕ) (s y : ℝ) : ℝ :=
  ∑ k ∈ (Icc 1 ⌊y/(r:ℝ)⌋₊).filter (fun k => r.Coprime k),
    ((moebius k:ℝ)/(k:ℝ)^s)*Real.log ((y/(r:ℝ))/k)

/-- Eigenvalue for the normalized diagonal coordinate. -/
def normalizedRpowEigen (r : ℕ) (s : ℝ) : ℝ :=
  (∏ p∈r.primeFactors, ((p:ℝ)^s)⁻¹*(1-((p:ℝ)^s)⁻¹))*((r:ℝ)/r.totient)^2

private theorem eig_eq_prod {Y r : ℕ} {s : ℝ} (hs : 0<s) (hr : r∣primorial Y) :
    ((rpowSieve Y s hs).selbergTerms r)⁻¹*((rpowSieve Y s hs).nu r)^2 =
      ∏ p∈r.primeFactors,((p:ℝ)^s)⁻¹*(1-((p:ℝ)^s)⁻¹) := by
  let B := rpowSieve Y s hs
  have hrB : r∣B.prodPrimes := hr
  change (B.selbergTerms r)⁻¹*(B.nu r)^2 = ∏ p∈r.primeFactors,B.nu p*(1-B.nu p)
  rw [BoundingSieve.selbergTerms_apply,mul_inv_rev,←Finset.prod_inv_distrib]
  simp only [inv_inv]
  calc
    _ = B.nu r * ∏ p∈r.primeFactors, (1-B.nu p) := by
      field_simp [(B.nu_pos_of_dvd_prodPrimes hrB).ne']
    _ = _ := by rw [←B.prod_primeFactors_nu hrB,←Finset.prod_mul_distrib]

private theorem rpow_coordinate_of_lt {y : ℝ} {r : ℕ} {s : ℝ}
    (hy : 0≤y) (hr : ⌊y⌋₊<r) : coprimeLogCoordinate r s y = 0 := by
  have hrR : (0:ℝ)<r := by exact_mod_cast Nat.zero_lt_of_lt hr
  have hyR := (Nat.floor_lt hy).1 hr
  unfold coprimeLogCoordinate
  rw [Nat.floor_eq_zero.mpr ((div_lt_iff₀ hrR).mpr (by simpa using hyR))]
  simp

private theorem rpow_coordinate_extend {y V : ℝ} {r : ℕ} {s : ℝ} (hs : 0<s) (hy : 0≤y)
    (hyV : y≤V) (hr : r∣primorial ⌊V⌋₊) :
    (∑ d∈(primorial ⌊V⌋₊).divisors, if r∣d then
        (rpowSieve ⌊V⌋₊ s hs).nu d*mobiusLogWeight y d else 0) =
      (rpowSieve ⌊V⌋₊ s hs).nu r*(moebius r:ℝ)*coprimeLogCoordinate r s y := by
  let P := primorial ⌊V⌋₊
  let B := rpowSieve ⌊V⌋₊ s hs
  have hsub : (primorial ⌊y⌋₊).divisors ⊆ P.divisors := by
    intro d hd
    exact Nat.mem_divisors.mpr ⟨(Nat.dvd_of_mem_divisors hd).trans
      (primorial_dvd_primorial (Nat.floor_mono hyV)),primorial_ne_zero _⟩
  have hsum :
      (∑ d∈(primorial ⌊y⌋₊).divisors, if r∣d then B.nu d*mobiusLogWeight y d else 0) =
      ∑ d∈P.divisors, if r∣d then B.nu d*mobiusLogWeight y d else 0 := by
    refine sum_subset hsub fun d hd hd' => ?_
    have hsq := (squarefree_primorial ⌊V⌋₊).squarefree_of_dvd (Nat.dvd_of_mem_divisors hd)
    have hh : ¬d≤⌊y⌋₊ := fun h => hd' (Nat.mem_divisors.mpr
      ⟨squarefree_dvd_primorial_of_le hsq h,primorial_ne_zero _⟩)
    simp [mobiusLogWeight,hh]
  rw [←hsum]
  by_cases hry : r≤⌊y⌋₊
  · have hrd := squarefree_dvd_primorial_of_le
      ((squarefree_primorial ⌊V⌋₊).squarefree_of_dvd hr) hry
    exact rpow_coordinate y hs hrd
  have hnot := lt_of_not_ge hry
  rw [rpow_coordinate_of_lt hy hnot,mul_zero]
  refine sum_eq_zero fun d hd => ?_
  split_ifs with hrd
  · have hh : ¬d≤⌊y⌋₊ := not_le_of_gt (hnot.trans_le
        (Nat.le_of_dvd (Nat.pos_of_mem_divisors hd) hrd))
    simp [mobiusLogWeight,hh]
  · rfl

set_option maxHeartbeats 1000000 in
/-- The exact Selberg diagonal for the shifted Barbàn–Vehov quadratic form. -/
theorem barbanVehov_diagonal_eq {U V s : ℝ} (hU : 0≤U) (hUV : U≤V) (hs : 0<s) :
    rpowForm (Icc 1 ⌊V⌋₊) (barbanVehov U V) s =
      ∑ r∈(Icc 1 ⌊V⌋₊).filter Squarefree, normalizedRpowEigen r s *
        ((((r.totient:ℝ)/r)*coprimeLogCoordinate r s V-
          ((r.totient:ℝ)/r)*coprimeLogCoordinate r s U)/Real.log (V/U))^2 := by
  classical
  let P := primorial ⌊V⌋₊
  let B := rpowSieve ⌊V⌋₊ s hs
  let D := P.divisors.filter (fun r => r≤⌊V⌋₊)
  let T := (Icc 1 ⌊V⌋₊).filter Squarefree
  let a := barbanVehov U V
  let coord (y : ℝ) (r : ℕ) := ∑ d∈P.divisors, if r∣d then B.nu d*mobiusLogWeight y d else 0
  let combined (r : ℕ) := ∑ d∈P.divisors, if r∣d then B.nu d*a d else 0
  have hDT : D=T := by
    ext r
    constructor
    · intro hr
      obtain ⟨hd,hl⟩ := mem_filter.mp hr
      exact mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hd,hl⟩,
        (squarefree_primorial _).squarefree_of_dvd (Nat.dvd_of_mem_divisors hd)⟩
    · intro hr
      obtain ⟨hi,hq⟩ := mem_filter.mp hr
      exact mem_filter.mpr ⟨Nat.mem_divisors.mpr
        ⟨squarefree_dvd_primorial_of_le hq (mem_Icc.mp hi).2,primorial_ne_zero _⟩,(mem_Icc.mp hi).2⟩
  have hmain : rpowForm (Icc 1 ⌊V⌋₊) a s = B.mainSum (BoundingSieve.lambdaSquared a) := by
    refine rpow_main_of_support hs a ?_
    intro d hd
    rcases hd with hd | hd
    · exact barbanVehov_zero hU hUV ((Nat.floor_lt (hU.trans hUV)).mp hd)
    · simp [a,barbanVehov,mobiusLogWeight,moebius_eq_zero_of_not_squarefree hd]
  have hdiag : rpowForm (Icc 1 ⌊V⌋₊) a s =
      ∑ r∈D, (B.selbergTerms r)⁻¹*(combined r)^2 := by
    rw [hmain,B.mainSum_lambdaSquared_eq_sum_mul_sum_sq]
    change (∑ r∈P.divisors,(B.selbergTerms r)⁻¹*(combined r)^2) = _
    symm
    refine sum_subset (filter_subset _ _) fun r hr hrd => ?_
    have hrV : ⌊V⌋₊<r := lt_of_not_ge fun hh => hrd (mem_filter.mpr ⟨hr,hh⟩)
    have hg : combined r = 0 := by
      refine sum_eq_zero fun d hd => ?_
      split_ifs with hrd
      · have hh := hrV.trans_le (Nat.le_of_dvd (Nat.pos_of_mem_divisors hd) hrd)
        rw [show a d=0 from barbanVehov_zero hU hUV ((Nat.floor_lt (hU.trans hUV)).mp hh),mul_zero]
      · rfl
    simp [hg]
  have hlin (r : ℕ) :
      combined r = (coord V r-coord U r)/Real.log (V/U) := by
    unfold combined coord
    rw [←sum_sub_distrib,sum_div]
    refine sum_congr rfl fun d _ => ?_
    simp only [a,barbanVehov]
    split_ifs <;> ring
  rw [hdiag]
  change (∑ r∈D,(B.selbergTerms r)⁻¹*(combined r)^2) =
    ∑ r∈T, normalizedRpowEigen r s *
      ((((r.totient:ℝ)/r)*coprimeLogCoordinate r s V-
        ((r.totient:ℝ)/r)*coprimeLogCoordinate r s U)/Real.log (V/U))^2
  rw [←hDT]
  refine sum_congr rfl fun r hr => ?_
  obtain ⟨hrD,_⟩ := mem_filter.mp hr
  have hrd := Nat.dvd_of_mem_divisors hrD
  have hPos := Nat.pos_of_mem_divisors hrD
  have hr₀ : (r:ℝ)≠0 := by exact_mod_cast hPos.ne'
  have hφ₀ : (r.totient:ℝ)≠0 := by exact_mod_cast (Nat.totient_pos.mpr hPos).ne'
  have hm : |(moebius r:ℝ)|=1 := by
    exact_mod_cast abs_moebius_eq_one_of_squarefree ((squarefree_primorial _).squarefree_of_dvd hrd)
  have hm' : (moebius r:ℝ)^2=1 := by rw [←sq_abs,hm,one_pow]
  rw [hlin,show coord V r = B.nu r*(moebius r:ℝ)*coprimeLogCoordinate r s V from
    rpow_coordinate_extend hs (hU.trans hUV) le_rfl hrd,
    show coord U r = B.nu r*(moebius r:ℝ)*coprimeLogCoordinate r s U from
    rpow_coordinate_extend hs hU hUV hrd]
  have hh :
      (B.nu r*(moebius r:ℝ)*coprimeLogCoordinate r s V-
        B.nu r*(moebius r:ℝ)*coprimeLogCoordinate r s U)/Real.log (V/U)=
      B.nu r*(moebius r:ℝ)*((coprimeLogCoordinate r s V-coprimeLogCoordinate r s U)/Real.log (V/U)) := by ring
  rw [hh,mul_pow,mul_pow,hm',mul_one,←mul_assoc]
  rw [show (B.selbergTerms r)⁻¹*(B.nu r)^2 = _ from eig_eq_prod hs hrd]
  unfold normalizedRpowEigen
  field_simp [hr₀,hφ₀]

end
end GoldbachPintzTheta


namespace GoldbachPintzTheta

open Finset
open Conjectures.Goldbach.ShiftPairSieve.Foundation
open Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337
open Conjectures.Goldbach.ShiftPairSieve.Foundation.OAI.Problem337.SelbergOptimal

noncomputable section


/-- With all primes through the cutoff available, the dimension-one Selberg
normalizer contains the full harmonic sum. The same optimized weights bound
the principal residue for every modulus. -/
theorem exists_theta_sharp {W : ℝ} (hW : 2 ≤ W) :
    ∃ θ : ℕ → ℝ, θ 1 = 1 ∧ (∀ d, |θ d| ≤ 1) ∧
      (∀ d : ℕ, W < (d:ℝ) → θ d=0) ∧ ∀ q : ℕ, 0 < q →
        ((q.totient:ℝ)/(q:ℝ))*quadratic (Icc 1 ⌊W⌋₊) θ q ≤ 1/Real.log W := by
  let y := ⌊W⌋₊
  let s := ordinarySieve y
  let P := s.prodPrimes
  let T := P.divisors.filter (fun d => d ≤ y)
  let θ := optimalWeight s y
  have hWy : 2≤y := Nat.le_floor hW
  have hy : 1≤y := (by norm_num : (1:ℕ)≤2).trans hWy
  have hW0 : 0<W := by linarith only [hW]
  have hP : 0<P := Nat.pos_of_ne_zero s.prodPrimes_ne_zero
  refine ⟨θ,optimalWeight_one s hy,optimal_abs s hy,?_,?_⟩
  · intro d hd
    apply optimalWeight_eq_zero_of_lt s
    have hbd : (y:ℝ) ≤ W := Nat.floor_le hW0.le
    exact_mod_cast hbd.trans_lt hd
  intro q hq
  have hT : T⊆Icc 1 y := by
    intro d hd
    obtain ⟨hDiv,hY⟩ := mem_filter.mp hd
    exact mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hDiv,hY⟩
  have hout (d : ℕ) (hd : d∉T) : θ d=0 := by
    by_cases hdiv : d∣P
    · have hlt : y<d := lt_of_not_ge fun h => hd
        (mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨hdiv,hP.ne'⟩,h⟩)
      exact optimalWeight_eq_zero_of_lt s hlt
    · change ¬ d∣s.prodPrimes at hdiv
      simp [θ,optimalWeight,hdiv]
  have hqW : quadratic T θ q = quadratic (Icc 1 y) θ q :=
    quadratic_subset hT θ q (fun d _ h => hout d h)
  have hqD : quadratic T θ 1 = quadratic P.divisors θ 1 :=
    quadratic_subset (filter_subset _ _) θ 1 (fun d _ h => hout d h)
  have hunit : quadratic P.divisors θ 1 = 1/normalizer s y := by
    have hfilter : P.divisors.filter (fun d => Nat.Coprime 1 d) = P.divisors :=
      filter_true_of_mem (fun d _ => Nat.coprime_one_left d)
    rw [quadratic,hfilter]
    have hm := mainSum_optimalWeight s hy
    unfold BoundingSieve.mainSum at hm
    rw [SelbergError.sum_lambdaSquared_mul P hP.ne' θ (fun d => s.nu d)] at hm
    simpa only [show ∀ d : ℕ, s.nu d=((d:ℝ)⁻¹) from fun _ => rfl, div_eq_mul_inv] using hm
  have hf := principal_residue_le hP hq T (fun d hd => Nat.dvd_of_mem_divisors (mem_filter.mp hd).1) θ
  rw [hqW,hqD,hunit] at hf
  have hLog : Real.log W ≤ normalizer s y := calc
    _ ≤ Real.log ((y:ℝ)+1) := Real.log_le_log hW0 (Nat.lt_floor_add_one W).le
    _ ≤ (harmonic y:ℝ) := by exact_mod_cast log_add_one_le_harmonic y
    _ = ∑ n ∈ Icc 1 y, (n:ℝ)⁻¹ := by rw [harmonic_eq_sum_Icc]; push_cast; rfl
    _ ≤ normalizer s y := by
      change _ ≤ normalizer (ordinarySieve y) y
      rw [normalizer_as_sum]
      exact harmonic_le_sum_prime_support y
  exact hf.trans (one_div_le_one_div_of_le (Real.log_pos (by linarith only [hW])) hLog)

end
end GoldbachPintzTheta
end

