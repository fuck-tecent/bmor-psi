namespace GoldbachMollifiedHarmonic

open Finset Complex
open GoldbachPintzTheta GoldbachSieveSeries GoldbachPintzHalasz

noncomputable section

/-- The real Dirichlet series of the square of a finite real divisor weight
has a zeta factor and the same finite LCM quadratic form. -/
theorem real_divisor_square_series (D : Finset ℕ) (a : ℕ → ℝ) {s : ℝ} (hs : 1 < s) :
    Summable (fun n : ℕ => (realDivisorWeight D a n)^2/(n : ℝ)^s) ∧
      (∑' n : ℕ, (realDivisorWeight D a n)^2/(n : ℝ)^s) =
        realZetaSeries s * rpowForm D a s := by
  let χ : DirichletCharacter ℂ 1 := 1
  let u := fun n => (a n : ℂ)
  let b : ℕ → ℂ := (fun n : ℕ => χ n) * sieveProduct D D u u
  have hχ (n : ℕ) : χ (n : ZMod 1) = 1 := MulChar.one_apply (isUnit_of_subsingleton _)
  have hsC : 1 < (s : ℂ).re := by simpa using hs
  have hs₀ : s ≠ 0 := (zero_lt_one.trans hs).ne'
  have hterm (n : ℕ) : LSeries.term b (s : ℂ) n =
      (((realDivisorWeight D a n)^2/(n : ℝ)^s : ℝ) : ℂ) := by
    by_cases hn : n = 0
    · subst n
      simp [Real.zero_rpow hs₀]
    rw [LSeries.term_of_ne_zero hn, Complex.ofReal_div, Complex.ofReal_pow,
      Complex.ofReal_cpow (Nat.cast_nonneg n) s, Complex.ofReal_natCast]
    change (χ (n : ZMod 1) * sieveProduct D D u u n) / (n : ℂ)^(s : ℂ) = _
    rw [hχ, one_mul, sieveProduct, ← cast_realDivisorWeight D a n, sq]
  have hZ : χ.LFunction (s : ℂ) = (realZetaSeries s : ℂ) := by
    rw [DirichletCharacter.LFunction_eq_LSeries χ hsC, LSeries, realZetaSeries, Complex.ofReal_tsum]
    apply tsum_congr
    intro n
    by_cases hn : n = 0
    · subst n
      simp [Real.zero_rpow hs₀]
    rw [LSeries.term_of_ne_zero hn, Complex.ofReal_inv,
      Complex.ofReal_cpow (Nat.cast_nonneg n) s, Complex.ofReal_natCast, ← one_div]
    change χ (n : ZMod 1) / (n : ℂ)^(s : ℂ) = _
    rw [hχ]
  have hform : lcmPolynomial χ D D u u (s : ℂ) = (rpowForm D a s : ℂ) := by
    simp only [lcmPolynomial, rpowForm, Complex.ofReal_sum]
    apply sum_congr rfl
    intro d _
    apply sum_congr rfl
    intro e _
    by_cases h : d.lcm e = 0
    · simp [h, Real.zero_rpow hs₀]
    rw [LSeries.term_of_ne_zero h, Complex.ofReal_div, Complex.ofReal_mul,
      Complex.ofReal_cpow (Nat.cast_nonneg (d.lcm e)) s, Complex.ofReal_natCast]
    change _ * (χ (d.lcm e : ZMod 1) / ((d.lcm e : ℕ) : ℂ)^(s : ℂ)) = _
    rw [hχ, mul_one_div]
  have hb : LSeriesSummable b (s : ℂ) := sieveProduct_summable χ D D u u hsC
  unfold LSeriesSummable at hb
  rw [funext hterm] at hb
  refine ⟨Complex.summable_ofReal.mp hb, ?_⟩
  have he := sieveProduct_LSeries χ D D u u hsC
  change LSeries b (s : ℂ) = _ at he
  rw [← lcmPolynomial_eq, hform, hZ] at he
  unfold LSeries at he
  rw [funext hterm] at he
  rw [← Complex.ofReal_tsum, ← Complex.ofReal_mul, Complex.ofReal_inj] at he
  exact he.trans (mul_comm _ _)


end
end GoldbachMollifiedHarmonic

