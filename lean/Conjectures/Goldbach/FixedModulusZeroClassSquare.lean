noncomputable section

def modulusGap (q : ℕ) (z : ℂ) : ℝ :=
  (1-z.re)*Real.log (q:ℝ)

def modulusOrder {q : ℕ} [NeZero q] (p : DirichletCharacter ℂ q × ℂ) : ℕ :=
  analyticOrderNatAt (regularizedL p.1) p.2

theorem modulusZeros_subset {q : ℕ} [NeZero q] {a b T U : ℝ}
    (hab : a≤b) (hTU : T≤U) :
    modulusZeros q a T⊆modulusZeros q b U := by
  intro p hp
  obtain ⟨hχ,hz,hgap⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨hRe,hIm,hZero⟩ := (mem_exceptionalZeros _ _ _).mp hz
  exact mem_fixed_modulus_zeros.mpr
    ⟨hχ,(mem_exceptionalZeros _ _ _).mpr ⟨hRe,hIm.trans hTU,hZero⟩,hgap.trans hab⟩

theorem modulusModeMass_nonneg {q : ℕ} [NeZero q] (p : DirichletCharacter ℂ q × ℂ) :
    0 ≤ modulusModeMass q p := by
  unfold modulusModeMass
  positivity

theorem modulusClassMassSquare_mono {q K : ℕ} [NeZero q] {a b T U : ℝ}
    (hab : a≤b) (hTU : T≤U) :
    modulusClassMassSquare q K a T≤ modulusClassMassSquare q K b U := by
  unfold modulusClassMassSquare
  exact classMassSq_le_of_injection
    (fun _ h => modulusZeros_subset hab hTU h) (fun _ _ _ _ h => h)
    (fun _ _=>rfl) (fun _ _ => modulusModeMass_nonneg _) (fun _ _ => modulusModeMass_nonneg _)
    (fun _ _=>le_rfl)

theorem modulusOrder_pos_of_mem {q : ℕ} [NeZero q] {H R : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R) :
    0 < modulusOrder p :=
  (regularizedL_analyticOrderNatAt_pos_iff p.1 p.2).mpr
    ((mem_exceptionalZeros _ _ _).mp (mem_fixed_modulus_zeros.mp hp).2.1).2.2

theorem modulusGap_nonneg_of_mem {q : ℕ} [NeZero q] {H R : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R) :
    0≤ modulusGap q p.2 := by
  have hz := ((mem_exceptionalZeros _ _ _).mp (mem_fixed_modulus_zeros.mp hp).2.1).2.2
  have hr : p.2.re≤1 := le_of_not_gt (fun h => regularizedL_ne_zero_right p.1 h hz)
  exact mul_nonneg (sub_nonneg.mpr hr) (Real.log_nonneg (by exact_mod_cast (show 1 ≤ q from NeZero.pos q)))

theorem modulusModeMass_exp_eq {q : ℕ} [NeZero q] (p : DirichletCharacter ℂ q × ℂ) :
    modulusModeMass q p=(modulusOrder p:ℝ)*gapWeight (modulusGap q p.2) := by
  unfold modulusModeMass modulusOrder gapWeight modulusGap
  rw [Real.rpow_def_of_pos (by exact_mod_cast NeZero.pos q)]
  congr 2
  ring

theorem modulusClassMassSquare_of_repeatTags {q K : ℕ} [NeZero q] (H R : ℝ) :
    modulusClassMassSquare q K H R =
      classMassSq (repeatTags (modulusZeros q H R) modulusOrder)
        (fun p=>conductorClass K p.1.1) (fun p=>gapWeight (modulusGap q p.1.2)) := by
  have hMass : modulusModeMass q = fun p => (modulusOrder p:ℝ)*gapWeight (modulusGap q p.2) := by
    funext p
    exact modulusModeMass_exp_eq p
  rw [modulusClassMassSquare,hMass]
  exact (repeatTags_classMassEq (modulusZeros q H R) modulusOrder
    (fun p=>conductorClass K p.1) (fun p=>gapWeight (modulusGap q p.2))
    (fun _ hp=>modulusOrder_pos_of_mem hp)).symm

theorem exists_fixed_modulus_leading {q : ℕ} [NeZero q] {H R : ℝ} (hq : 1<(q:ℝ))
    (hN : (modulusZeros q H R).Nonempty) :
    ∃ p∈modulusZeros q H R,
      (∀ r∈modulusZeros q H R, r.2.re≤p.2.re) ∧
      (∀ r∈modulusZeros q H R, modulusGap q p.2≤ modulusGap q r.2) := by
  obtain ⟨p,hp,hle⟩ := exists_max_image (modulusZeros q H R) (fun p=>p.2.re) hN
  refine ⟨p,hp,hle,fun r hr=>?_⟩
  exact mul_le_mul_of_nonneg_right (sub_le_sub_left (hle r hr) _) (Real.log_pos hq).le

end
end GoldbachSignedPairs
end

section
namespace GoldbachSignedPairs

open Complex Finset Filter Goldbach GoldbachTwistedMellin GoldbachPintzNumerics GoldbachPintzWeightedGram
open scoped Topology Classical

noncomputable section

theorem repeatTags_card_eq_weighted_count {ι : Type*} (S : Finset ι) (m : ι→ℕ) :
    ((repeatTags S m).card:ℝ)=ordinaryCount S m := by
  simpa [ordinaryCount,nsmul_eq_mul] using repeatTags_sum S m (fun _=>(1:ℝ))

theorem projected_repeatTags_subset {ι : Type*} [DecidableEq ι] {S : Finset ι} {m : ι→ℕ}
    {T : Finset (Σ _ : ι, ℕ)} (hT : T⊆repeatTags S m) :
    let U := T.image Sigma.fst
    U⊆S ∧ T⊆repeatTags U m := by
  dsimp only
  refine ⟨?_,?_⟩
  · intro i hi
    obtain ⟨t,ht,rfl⟩ := mem_image.mp hi
    exact (mem_sigma.mp (hT ht)).1
  · intro t ht
    exact mem_sigma.mpr ⟨mem_image_of_mem _ ht,(mem_sigma.mp (hT ht)).2⟩

theorem repeatTags_subset_count_and_excess {q : ℕ} [NeZero q]
    {S : Finset (DirichletCharacter ℂ q × ℂ)}
    {T : Finset (Σ _ : DirichletCharacter ℂ q × ℂ, ℕ)} (hT : T⊆repeatTags S zeroGramMultiplicity)
    {b anchor high L : ℝ} (hb : 0<b)
    (hRange : ∀ t∈T, anchor ≤ zeroLossAt L t.1.2 ∧ zeroLossAt L t.1.2≤high) :
    let U := T.image Sigma.fst
    (T.card:ℝ)≤ordinaryCount U zeroGramMultiplicity ∧
    (∑ t∈T,(realRationalZeroKernel b (zeroLossAt L t.1.2-anchor)-
      realRationalZeroKernel b (high-anchor)))≤unscaledZeroExcess U b anchor high L := by
  dsimp only
  let U := T.image Sigma.fst
  let a (i : DirichletCharacter ℂ q × ℂ) :=
    realRationalZeroKernel b (zeroLossAt L i.2-anchor)-realRationalZeroKernel b (high-anchor)
  have hSub : T⊆repeatTags U zeroGramMultiplicity := (projected_repeatTags_subset hT).2
  refine ⟨?_,?_⟩
  · rw [←repeatTags_card_eq_weighted_count U zeroGramMultiplicity]
    exact_mod_cast card_le_card hSub
  · have ha (i : DirichletCharacter ℂ q × ℂ) (hi : i∈U) : 0≤a i := by
      obtain ⟨t,ht,rfl⟩ := mem_image.mp hi
      obtain ⟨hlo,hhi⟩ := hRange t ht
      apply sub_nonneg.mpr
      exact realRationalZeroKernel_antitone hb.le (by linarith only [hb,hlo])
        (by linarith only [hhi])
    change (∑ t∈T,a t.1)≤unscaledZeroExcess U b anchor high L
    refine (sum_le_sum_of_subset_of_nonneg hSub (fun t ht _=>ha t.1 (mem_sigma.mp ht).1)).trans_eq ?_
    exact repeatTags_sum U zeroGramMultiplicity a

/-- The clean census transfers its lower gap to every prime-test window
within the actual pair height. The chosen anchor can be smaller than the
actual leading gap. -/
theorem census_no_right_of_lower_gap {q : ℕ} [NeZero q] {H R anchor : ℝ}
    (hLog : 0<Real.log (q:ℝ)) (hR : 0≤R) (hCap : anchor≤H)
    (hHalf : 1/2 < 1-anchor/Real.log (q:ℝ))
    (hLead : ∀ i∈modulusZeros q H R, anchor ≤ zeroLossAt (Real.log (q:ℝ)) i.2)
    (hClean : ∀ (χ : DirichletCharacter ℂ q) (z : ℂ), χ≠1 →
      1/2 < z.re → regularizedL χ z=0 →
      zeroLossAt (Real.log (q:ℝ)) z≤H → |z.im|≤4*R+2 → |z.im|≤R) :
    ∀ χ : DirichletCharacter ℂ q, χ≠1 → ∀ ρ : ℂ, regularizedL χ ρ=0 →
      |ρ.im| ≤ 2*R+1 → ρ.re ≤ 1-anchor/Real.log (q:ℝ) := by
  intro χ hχ ρ hρ hTime
  let L := Real.log (q:ℝ)
  let σ := 1-anchor/L
  have hSc : (1-σ)*L≤H := by
    calc
      _ = anchor := by
        have hL : L ≠ 0 := hLog.ne'
        dsimp only [σ]
        field_simp [hL]
        <;> ring
      _ ≤ _ := hCap
  have hLead' : ∀ i∈modulusZeros q H R, i.2.re≤σ := by
    intro i hi
    have hh := (div_le_iff₀ hLog).mpr (hLead i hi)
    change anchor/L≤1-i.2.re at hh
    unfold σ
    linarith only [hh]
  exact clean_height_local_leading (χ:=χ) (t:=ρ.im) hχ hHalf hLog.le hSc
    (by linarith only [hTime,hR]) hClean hLead' ρ hρ (by simp)

private theorem census_projected_geometry {q : ℕ} [NeZero q] {H R high anchor : ℝ}
    {T : Finset (Σ _ : DirichletCharacter ℂ q × ℂ, ℕ)}
    (hT : T⊆repeatTags (modulusZeros q H R) zeroGramMultiplicity)
    (hLead : ∀ i∈modulusZeros q H R, anchor ≤ zeroLossAt (Real.log (q:ℝ)) i.2)
    (hCut : ∀ t∈T, zeroLossAt (Real.log (q:ℝ)) t.1.2≤high) :
    let U := T.image Sigma.fst
    (∀ i∈U, i.1≠1) ∧ (∀ i∈U, regularizedL i.1 i.2=0) ∧
    (∀ i∈U, anchor ≤ zeroLossAt (Real.log (q:ℝ)) i.2 ∧ zeroLossAt (Real.log (q:ℝ)) i.2≤high) ∧
    (∀ i∈U, |i.2.im|≤R) := by
  dsimp only
  have hSub := (projected_repeatTags_subset hT).1
  have hData (i : DirichletCharacter ℂ q × ℂ) (hi : i∈T.image Sigma.fst) :=
    mem_fixed_modulus_zeros.mp (hSub hi)
  refine ⟨fun i hi=>(hData i hi).1,fun i hi=>((mem_exceptionalZeros _ _ _).mp (hData i hi).2.1).2.2,?_,
    fun i hi=>((mem_exceptionalZeros _ _ _).mp (hData i hi).2.1).2.1⟩
  intro i hi
  refine ⟨hLead i (hSub hi),?_⟩
  obtain ⟨t,ht,rfl⟩ := mem_image.mp hi
  exact hCut t ht

abbrev ModulusTag (q : ℕ) := Σ _ : DirichletCharacter ℂ q × ℂ, ℕ

/-- A height chosen with a gap surrounding the counted zeros. -/
def CleanCensus (q : ℕ) [NeZero q] (H R : ℝ) : Prop :=
  ∀ (χ : DirichletCharacter ℂ q) (z : ℂ), χ≠1 →
    1/2 < z.re → regularizedL χ z=0 →
    modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R

def censusTagExcess (q : ℕ) (b anchor high : ℝ) (t : ModulusTag q) : ℝ :=
  realRationalZeroKernel b (modulusGap q t.1.2-anchor)-
    realRationalZeroKernel b (high-anchor)

private theorem census_log_bounds {q : ℕ} {U R anchor : ℝ}
    (hL : max 1 (max U (2*anchor+1)) ≤ Real.log (q:ℝ)) (hR : R≤U) :
    let L := Real.log (q:ℝ)
    0<L ∧ R≤L^(1:ℝ) ∧ 1/2<1-anchor/L := by
  dsimp only
  have hOne := (le_max_left _ _).trans hL
  have hBig := (le_max_right U (2*anchor+1)).trans ((le_max_right _ _).trans hL)
  have hPos : 0<Real.log (q:ℝ) := by linarith only [hOne]
  refine ⟨hPos,?_,?_⟩
  · rw [Real.rpow_one]
    exact hR.trans ((le_max_left _ _).trans ((le_max_right _ _).trans hL))
  · have hd : anchor/Real.log (q:ℝ)<1/2 :=
      (div_lt_iff₀ hPos).mpr (by linarith only [hBig])
    linarith only [hd]

/-- Global bounds count multiplicity, including for arbitrary subsets of tags
of the fixed clean census. -/
theorem census_global_tag_bounds_eventually {H U b anchor high φ count J : ℝ}
    (hb : 0<b) (ha : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hCap : anchor≤H) (hφ : 3/8<φ) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φ/(2*F)
    let ξ := φ/(2*F)
    0<Δ → ξ<Δ^2 → (1-ξ)/(Δ^2-ξ)<count → F*(1-ξ)/(2*Δ)<J →
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q], ∀ R : ℝ, 0≤R → R≤U → CleanCensus q H R →
      (∀ i∈modulusZeros q H R, anchor ≤ modulusGap q i.2) →
      ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
      (∀ t∈T, modulusGap q t.1.2≤high) →
      (T.card:ℝ)<count ∧ (∑ t∈T,censusTagExcess q b anchor high t)<J := by
  dsimp only
  intro hΔ hGap hCount hJ
  have hMain := rational_global_zero_count_excess_eventually (p:=1)
    hb ha hba hHigh (by norm_num) hφ hΔ hGap hCount hJ
  have hLog : Tendsto (fun q : ℕ=>Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [hLog.eventually hMain,
    hLog.eventually (eventually_ge_atTop (max 1 (max U (2*anchor+1))))] with q hM hL
  intro _ R hR hRU hClean hLead T hT hCut
  obtain ⟨hPos,hHeight,hHalf⟩ := census_log_bounds (q:=q) hL hRU
  obtain ⟨hNon,hZero,hRange,hTime⟩ := census_projected_geometry hT hLead hCut
  have hNoRight := census_no_right_of_lower_gap hPos hR hCap hHalf hLead hClean
  obtain ⟨hN,hE⟩ :=
    hM q le_rfl R hR hHeight (T.image Sigma.fst) hNon hZero hRange hTime hNoRight
  obtain ⟨hTagN,hTagE⟩ := repeatTags_subset_count_and_excess (S:=modulusZeros q H R) hT hb
    (fun t ht=>⟨hLead t.1 (mem_sigma.mp (hT ht)).1,hCut t ht⟩)
  exact ⟨hTagN.trans_lt hN,hTagE.trans_lt hE⟩

/-- Class bounds for arbitrary subsets of the repeat tags in one bounded
conductor-ratio class. -/
theorem census_class_tag_bounds_eventually {H U b anchor high φ count J : ℝ} (K : ℕ)
    (hb : 0<b) (ha : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hCap : anchor≤H) (hφ : 3/8<φ) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φ/(2*F)
    0<Δ → 1/Δ^2<count → F/(2*Δ)<J →
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q], ∀ R : ℝ, 0≤R → R≤U → CleanCensus q H R →
      (∀ i∈modulusZeros q H R, anchor ≤ modulusGap q i.2) →
      ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
      (∀ t∈T, modulusGap q t.1.2≤high) →
      (∀ t∈T, ∀ u∈T, conductorClass K t.1.1=conductorClass K u.1.1) →
      (T.card:ℝ)<count ∧ (∑ t∈T,censusTagExcess q b anchor high t)<J := by
  dsimp only
  intro hΔ hCount hJ
  have hMain := rational_class_zero_count_excess_eventually (p:=1) K.factorial
    (Nat.factorial_pos K) hb ha hba hHigh (by norm_num) hφ hΔ hCount hJ
  have hLog : Tendsto (fun q : ℕ=>Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [hLog.eventually hMain,
    hLog.eventually (eventually_ge_atTop (max 1 (max U (2*anchor+1))))] with q hM hL
  intro _ R hR hRU hClean hLead T hT hCut hClass
  obtain ⟨hPos,hHeight,hHalf⟩ := census_log_bounds (q:=q) hL hRU
  obtain ⟨hNon,hZero,hRange,hTime⟩ := census_projected_geometry hT hLead hCut
  have hNoRight := census_no_right_of_lower_gap hPos hR hCap hHalf hLead hClean
  have hRatio (i : DirichletCharacter ℂ q × ℂ) (hi : i∈T.image Sigma.fst)
      (j : DirichletCharacter ℂ q × ℂ) (hj : j∈T.image Sigma.fst) :
      (j.1*i.1⁻¹).conductor≤K.factorial := by
    obtain ⟨t,ht,rfl⟩ := mem_image.mp hi
    obtain ⟨u,hu,rfl⟩ := mem_image.mp hj
    simpa only [div_eq_mul_inv] using ratio_conductor_le_factorial_of_conductorClass_eq
      (hClass u hu t ht)
  obtain ⟨hN,hE⟩ :=
    hM q le_rfl R hR hHeight (T.image Sigma.fst) hNon hZero hRange hTime hNoRight
      (fun i hi j hj _=>hRatio i hi j hj)
  obtain ⟨hTagN,hTagE⟩ := repeatTags_subset_count_and_excess (S:=modulusZeros q H R) hT hb
    (fun t ht=>⟨hLead t.1 (mem_sigma.mp (hT ht)).1,hCut t ht⟩)
  exact ⟨hTagN.trans_lt hN,hTagE.trans_lt hE⟩

end
end GoldbachSignedPairs
end

section
namespace GoldbachSignedPairs

open Finset Filter GoldbachPintzNumerics GoldbachPintzWeightedGram
open scoped Classical

noncomputable section

theorem censusTagExcess_pospart_eq_sum_filter {q : ℕ} {b anchor high : ℝ}
    (hb : 0<b) (ha : anchor≤high) (T : Finset (ModulusTag q))
    (hRange : ∀ t∈T, anchor ≤ modulusGap q t.1.2) :
    (∑ t∈T,max 0 (censusTagExcess q b anchor high t))=
      ∑ t∈T.filter (fun t=>modulusGap q t.1.2≤high),censusTagExcess q b anchor high t := by
  rw [sum_filter]
  apply sum_congr rfl
  intro t ht
  unfold censusTagExcess
  split_ifs with h
  · apply max_eq_right
    have hLo := hRange t ht
    exact sub_nonneg.mpr (realRationalZeroKernel_antitone hb.le
      (by linarith only [hb,hLo]) (by linarith only [h]))
  · have h' := le_of_not_ge h
    apply max_eq_left
    exact sub_nonpos.mpr (realRationalZeroKernel_antitone hb.le
      (by linarith only [hb,ha]) (by linarith only [h']))

/-- Positive rational excess over any selected set of repeat tags of a clean census. -/
def CensusExcessBound (q : ℕ) [NeZero q] (H U b anchor high J : ℝ)
    (condition : Finset (ModulusTag q) → Prop) : Prop :=
  ∀ R : ℝ, 0≤R → R≤U → CleanCensus q H R →
    (∀ i∈modulusZeros q H R, anchor ≤ modulusGap q i.2) →
    ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
    condition T → (∑ t∈T,max 0 (censusTagExcess q b anchor high t))≤J

def OneConductorClass {q : ℕ} (K : ℕ) (T : Finset (ModulusTag q)) : Prop :=
  ∀ t∈T, ∀ u∈T, conductorClass K t.1.1=conductorClass K u.1.1

theorem census_global_tag_excess_eventually {H U b anchor high φ J : ℝ}
    (hb : 0<b) (ha : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hCap : anchor≤H) (hφ : 3/8<φ) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φ/(2*F)
    let ξ := φ/(2*F)
    0<Δ → ξ<Δ^2 → F*(1-ξ)/(2*Δ)<J →
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q], CensusExcessBound q H U b anchor high J (fun _=>True) := by
  dsimp only
  intro hd hξ hJ
  obtain ⟨count,hc⟩ := exists_gt ((1-φ/(2*realRationalZeroKernel b (-anchor)))/
    ((rationalPsi b anchor high-φ/(2*realRationalZeroKernel b (-anchor)))^2-
      φ/(2*realRationalZeroKernel b (-anchor))))
  filter_upwards [census_global_tag_bounds_eventually (U:=U) hb ha hba hHigh hCap hφ hd hξ hc hJ]
    with q hM
  intro _ R hR hRU hClean hLead T hT _
  rw [censusTagExcess_pospart_eq_sum_filter hb hHigh T
    (fun t ht=>hLead t.1 (mem_sigma.mp (hT ht)).1)]
  exact (hM R hR hRU hClean hLead _ ((filter_subset _ T).trans hT)
    (fun _ ht=>(mem_filter.mp ht).2)).2.le

theorem census_class_tag_excess_eventually {H U b anchor high φ J : ℝ} (K : ℕ)
    (hb : 0<b) (ha : 0≤anchor) (hba : anchor<b) (hHigh : anchor≤high)
    (hCap : anchor≤H) (hφ : 3/8<φ) :
    let F := realRationalZeroKernel b (-anchor)
    let Δ := rationalPsi b anchor high-φ/(2*F)
    0<Δ → F/(2*Δ)<J →
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q], CensusExcessBound q H U b anchor high J (OneConductorClass K) := by
  dsimp only
  intro hd hJ
  obtain ⟨count,hc⟩ := exists_gt (1/(rationalPsi b anchor high-φ/(2*realRationalZeroKernel b (-anchor)))^2)
  filter_upwards [census_class_tag_bounds_eventually (U:=U) K hb ha hba hHigh hCap hφ hd hc hJ]
    with q hM
  intro _ R hR hRU hClean hLead T hT hClass
  rw [censusTagExcess_pospart_eq_sum_filter hb hHigh T
    (fun t ht=>hLead t.1 (mem_sigma.mp (hT ht)).1)]
  exact (hM R hR hRU hClean hLead _ ((filter_subset _ T).trans hT)
    (fun _ ht=>(mem_filter.mp ht).2)
    (fun t ht u hu=>hClass t (mem_filter.mp ht).1 u (mem_filter.mp hu).1)).2.le

theorem census_376_low_tag_global_excess_eventually {H U : ℝ} (hH : (0.226:ℝ)≤H) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q],
      CensusExcessBound q H U 1.98 0.226 0.99 2.267 (fun _=>True) := by
  refine census_global_tag_excess_eventually (φ:=47/125) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) hH (by norm_num) ?_ ?_ ?_ <;>
    norm_num [rationalPsi,realRationalZeroKernel]

theorem census_376_low_tag_class_excess_eventually {H U : ℝ} (K : ℕ) (hH : (0.226:ℝ)≤H) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q],
      CensusExcessBound q H U 2.60 0.226 0.99 1.627 (OneConductorClass K) := by
  refine census_class_tag_excess_eventually (φ:=47/125) K (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) hH (by norm_num) ?_ ?_ <;>
    norm_num [rationalPsi,realRationalZeroKernel]

theorem census_376_mid_tag_global_excess_eventually {H U : ℝ} (hH : (0.30:ℝ)≤H) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q],
      CensusExcessBound q H U 2.22 0.30 1 2.032 (fun _=>True) := by
  refine census_global_tag_excess_eventually (φ:=47/125) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) hH (by norm_num) ?_ ?_ ?_ <;>
