  rw [mul_sum,←sum_sub_distrib]
  apply (abs_sum_le_sum_abs _ _).trans
  calc
    _ ≤ ∑ j ∈ range (r+1), ((V4f.Vb7 r (X+1)).card:ℝ)*(1+(X:ℝ)/Y) := by
