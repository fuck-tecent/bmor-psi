private theorem scaled_indicator_sum {ι : Type*} (S : Finset ι) (m : ι→ℕ) (p : ι→Prop) (c : ℝ) :
    (∑ i∈S,(m i:ℝ)*(if p i then c else 0))=(∑ i∈S.filter p,(m i:ℝ))*c := by
  rw [sum_mul,sum_filter]
  apply sum_congr rfl
  intro i _
  split_ifs <;> simp

/-- The clipped class mass below 2.60 takes only four cumulative counts.
The final 0.009 term comes from the separate D tail above 2.60. -/
theorem rational_376_class_clipped_le {ι : Type*} (S : Finset ι) (level : ι→ℝ) (m : ι→ℕ)
    (h₁ : (∑ i∈S.filter (fun i => level i≤1.15), (m i:ℝ))≤7)
    (h₂ : (∑ i∈S.filter (fun i => level i≤1.50), (m i:ℝ))≤12)
    (h₃ : (∑ i∈S.filter (fun i => level i≤1.95), (m i:ℝ))≤21)
    (h₄ : (∑ i∈S.filter (fun i => level i≤2.60), (m i:ℝ))≤51)
    (hTail : (∑ i∈S.filter (fun i => 2.60<level i), (m i:ℝ)*Real.exp (-4.93*max (level i) 1))≤0.009) :
    (∑ i∈S,(m i:ℝ)*Real.exp (-4.93*max (level i) 1))≤0.085 := by
  have hA : 0≤Real.exp (-4.93)-Real.exp (-5.6695) :=
    sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num))
  have hB : 0≤Real.exp (-5.6695)-Real.exp (-7.395) :=
    sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num))
  have hC : 0≤Real.exp (-7.395)-Real.exp (-9.6135) :=
    sub_nonneg.mpr (Real.exp_le_exp.mpr (by norm_num))
  have h : (∑ i∈S.filter (fun i => level i≤2.60), (m i:ℝ)*Real.exp (-4.93*max (level i) 1)) ≤
      7*(Real.exp (-4.93)-Real.exp (-5.6695))+12*(Real.exp (-5.6695)-Real.exp (-7.395))+
        21*(Real.exp (-7.395)-Real.exp (-9.6135))+51*Real.exp (-9.6135) := by
    calc
      _ = ∑ i∈S,(m i:ℝ)*(if level i≤2.60 then Real.exp (-4.93*max (level i) 1) else 0) := by
        rw [sum_filter]
        apply sum_congr rfl
        intro i _
        split_ifs <;> simp
      _ ≤ ∑ i∈S,(m i:ℝ)*((if level i≤1.15 then Real.exp (-4.93)-Real.exp (-5.6695) else 0)+
        (if level i≤1.50 then Real.exp (-5.6695)-Real.exp (-7.395) else 0)+
        (if level i≤1.95 then Real.exp (-7.395)-Real.exp (-9.6135) else 0)+
        (if level i≤2.60 then Real.exp (-9.6135) else 0)) :=
          sum_le_sum fun i _ => mul_le_mul_of_nonneg_left (class376_band_pointwise (level i)) (Nat.cast_nonneg _)
      _ ≤ _ := by
        simp only [mul_add,sum_add_distrib,scaled_indicator_sum]
        exact add_le_add (add_le_add (add_le_add (mul_le_mul_of_nonneg_right h₁ hA)
          (mul_le_mul_of_nonneg_right h₂ hB)) (mul_le_mul_of_nonneg_right h₃ hC))
          (mul_le_mul_of_nonneg_right h₄ (Real.exp_nonneg _))
  have hSplit : (∑ i∈S,(m i:ℝ)*Real.exp (-4.93*max (level i) 1)) =
