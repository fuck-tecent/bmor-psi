theorem rational_prime_window_upper {ε b K D : ℝ} (hε : 0<ε) (hb : 0<b)
    (hK : 0<K) (hD : 0≤D) :
    ∃ r L₀ : ℝ, 0<r ∧ r≤1/32 ∧ 1≤L₀ ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (t σ T B L φ : ℝ),
      L₀≤L → Real.log (q:ℝ)≤L → 1+1/L≤σ+b/L → σ≤1 →
      0≤φ → 1≤B → Real.log B≤D*Real.log L → PrimeTestWindow χ t σ T B L K φ →
      ∃ V : Finset ℂ,
      (∀ ρ : ℂ, ‖ρ-line 1 t‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V →
        (rationalPrimeTest χ b L (line σ t)).re≤φ*L/2+ε*L-
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
            (rationalZeroKernel b ((L:ℂ)*(line σ t-ρ))).re := by
  obtain ⟨r,L₀,hr,hr32,hL₀,hN⟩ := rational_prime_test_sharp_with_window
    (κ:=1) (C:=b) hε (by norm_num) hb hK hD hb.le
  refine ⟨r,L₀,hr,hr32,hL₀,?_⟩
  intro q _ χ t σ T B L φ hL hq hShift hσ hφ hB hBL hχ
  have hQ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  obtain ⟨V,hV,hCov,hEst⟩ := hN q χ hχ.nonprincipal (s:=line σ t) (Q:=(q:ℝ)) hL
    (by simpa [line] using hShift) (by simpa [line] using add_le_add_right hσ (b/L))
    (by simpa [line] using hχ.height) (by simpa [line] using hχ.logHeight_le)
    hφ hB hQ hBL hχ.strip
  refine ⟨V,(by simpa [line] using hCov),?_⟩
  intro U hU
  have hDiscard (ρ : ℂ) (hρ : ρ∈V) (_ : ρ∉U) : ρ.re≤(line σ t).re := by
    have hi := (Complex.abs_im_le_norm (ρ-line 1 t)).trans
