set_option maxHeartbeats 2200000 in
/-- The actual weighted C/D moment on a finite bounded fixed-modulus family.
Only the quotient growth differs between the global and the class case. -/
theorem eventually_cd_weighted_moment
    (Allowed : (q : ℕ) → DirichletCharacter ℂ q → Prop)
    {φ φoff u w c r κ H T J Λ B δ ε τ₀ eE : ℝ} {N : ℕ}
    (hφ : 3/8 < φ) (hφoff : 0 ≤ φoff) (hw : 0 < w) (hc : 0 < c) (hκ : 0 < κ)
    (hD : φ+c+w < r) (hG : φoff+2*w < u) (hH : 0 ≤ H) (hT : 0 ≤ T)
    (hJ : 0 ≤ J) (hΛ : 0 < Λ) (hB : 0 ≤ B) (hδ₀ : 0 < δ) (hδ₁ : δ < 1)
    (hε : 0 < ε) (hτ₀ : 0 < τ₀) (hE : 0 < eE) (hN : 0 < N)
    (hGrowth : ∀ (q : ℕ) [NeZero q], ∀ scale : ℝ, 1 ≤ scale → Real.log (q:ℝ) ≤ scale →
      ∀ χ : DirichletCharacter ℂ q, χ≠1 → Allowed q χ →
      ∀ s : ℂ, s.re=7/8 →
      ‖χ.LFunction s‖ ≤ B*(1+|s.im|)*(1+scale)*(q:ℝ)^(φoff*(1/8:ℝ)))
    (hAbsorb :
      ((2*r-c)/(2*c)+eE)*((2/w)*Real.exp ((u+r+κ)*(2*H))*κ/N+τ₀)/(1-δ)^2 < 1) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ {ι : Type} (I : Finset ι) (χ : ι→DirichletCharacter ℂ q) (ρ : ι→ℂ),
      (∀ i∈I,χ i≠1 ∧ regularizedL (χ i) (ρ i)=0 ∧ (ρ i).re < 1 ∧
        (1-(ρ i).re)*L ≤ H ∧ |(ρ i).im| ≤ T) →
      (∀ i∈I,∀ j∈I,χ i≠χ j → Allowed q (cdQuotient (χ i) (χ j))) →
      (∀ i∈I,∀ z∈cdColumnZeros I χ ρ i,
        (((I.filter fun j=>χ i=χ j).filter fun j=>ρ j=z).card)≤
          analyticOrderNatAt (regularizedL (χ i)) z) →
      (∀ i∈I,(∑ z∈cdColumnZeros I χ ρ i,(analyticOrderNatAt (regularizedL (χ i)) z:ℝ)) ≤ J) →
      (∑ i∈I,cdMomentWeight (u+r+κ) r κ Λ ((1-(ρ i).re)*L)) ≤
        (((2*r-c)/(2*c)+eE)*(1/(w*κ))/(1-δ)^2)*
          Real.sqrt (densityMomentScalar φ κ Λ+ε)*Real.sqrt (densityMomentScalar φ r Λ+ε)/
          (1-((2*r-c)/(2*c)+eE)*((2/w)*Real.exp ((u+r+κ)*(2*H))*κ/N+τ₀)/(1-δ)^2) := by
  have hφ₀ : 0 ≤ φ := by linarith only [hφ]
  have hrc : c < r := by linarith only [hφ₀,hw,hD]
  have hr : 0 < r := hc.trans hrc
  have hu : 0 < u := by linarith only [hG,hφoff,hw]
  have hu₂ : 2*w < u := by linarith only [hG,hφoff]
  let η (k : ℕ) := (k:ℝ)*(κ/N)
  let x := u+r
  let v := u+c
  let mD := (r-(φ+c+w))/2
  let mG := (u-(φoff+2*w))/2
  let C := (2*r-c)/(2*c)+eE
  have hmD : 0 < mD := by dsimp only [mD]; positivity [sub_pos.mpr hD]
  have hmG : 0 < mG := by dsimp only [mG]; positivity [sub_pos.mpr hG]
  have hDm : φ+c+w+mD ≤ r := by dsimp only [mD]; linarith only [hD]
  have hGm : φoff+w+w+mG ≤ u := by dsimp only [mG]; linarith only [hG]
  have hCm : 0 ≤ C := by dsimp only [C]; positivity [show 0≤2*r-c by linarith only [hc,hrc]]
  have hη (k : ℕ) (hk : k∈range N) : η k∈Set.Icc 0 κ := by
    have hN₀ : (0:ℝ)<N := by exact_mod_cast hN
    have hkN : (k:ℝ)≤N := by exact_mod_cast (mem_range.mp hk).le
    refine ⟨by dsimp only [η]; positivity,?_⟩
    dsimp only [η]
    have hh := mul_le_mul_of_nonneg_right hkN (div_nonneg hκ.le hN₀.le)
    exact hh.trans_eq (by field_simp [hN₀.ne'])
  have hDE := compact_detector_eventually_near_neg_one hφ hw hu hc hκ.le hmD hH hT hδ₀ hDm
  have hGE := gram_eventually_near_zero_of_linear_height Allowed hφoff hw hu hκ.le hmG
    (show 0≤2*H by positivity) (show 0≤2*T by positivity) hτ₀ hB hGm hGrowth
  have hPE := principal_gram_eventually_residue hw hu₂ hκ.le (show 0≤2*H by positivity)
    (show 0≤2*T by positivity) hτ₀
  have hEE := eventually_compact_graham_energy_on_mesh (range N) η (fun k hk=>(hη k hk).1)
    hu hc hrc.le hE
  have hR₁ := cd_sinh_row_eventually hφ hκ hT hH hJ hε
  have hR₂ := cd_sinh_row_eventually hφ hr hT hH hJ hε
  filter_upwards [hDE,hGE,hPE,hEE,hR₁,hR₂,
    eventually_ge_atTop (max 1 (Real.log 2/w))] with L hDet hGram hPrincipal hEnergy hRow₁ hRow₂ hL
  intro q _ hq ι I χ ρ hI hAllowed hMultiplicity hCount
  have hL₀ := zero_lt_one.trans_le ((le_max_left _ _).trans hL)
  have hWL : 2≤Real.exp (w*L) := by
    apply (Real.log_le_iff_le_exp (by norm_num)).mp
    have hh := (div_le_iff₀ hw).mp ((le_max_right (1:ℝ) (Real.log 2/w)).trans hL)
    linarith only [hh]
  let W := Real.exp (w*L)
  obtain ⟨θ,hΘ₁,hΘ,hR⟩ := exists_theta_with_sharp_residue_coefficient hWL
  let D := Icc 1 ⌊W⌋₊
  let wt := fun d => (θ d:ℂ)
  let R := sieveProductPolynomial (1:DirichletCharacter ℂ q) D D wt wt 1*principalResidueFactor q
  have hR' : ‖R‖≤1/(w*L) := by
    have hh := hR q
    change ‖R‖≤1/Real.log (Real.exp (w*L)) at hh
    rwa [Real.log_exp] at hh
  have hCut (k : ℕ) (hk : k∈range N) :
      1≤cdMeshCutoff L u κ N k ∧ cdMeshCutoff L u κ N k≤cdMeshCutoff L x κ N k := by
    change 1≤Real.exp ((u+η k)*L) ∧ Real.exp ((u+η k)*L)≤Real.exp ((x+η k)*L)
    exact ⟨Real.one_le_exp (mul_nonneg (add_nonneg hu.le (hη k hk).1) hL₀.le),
      Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right
        (add_le_add (le_add_of_nonneg_right hr.le) le_rfl) hL₀.le)⟩
  have hCutU (k : ℕ) : cdMeshCutoff L u κ N k=Real.exp ((u+η k)*L) := rfl
  have hCutV (k : ℕ) : cdMeshCutoff L v κ N k=Real.exp ((u+η k+c)*L) := by
    dsimp only [cdMeshCutoff,v,η]
    congr 1
    ring
  have hCutY (k : ℕ) : cdMeshCutoff L x κ N k=Real.exp ((u+η k+r)*L) := by
    dsimp only [cdMeshCutoff,x,η]
    congr 1
    ring
  have hData (i : ι) (hi : i∈I) : χ i≠1 ∧ (χ i).LFunction (ρ i)=0 ∧
      (ρ i).re < 1 ∧ (1-(ρ i).re)*L≤H ∧ |(ρ i).im|≤T := by
    obtain ⟨hχ,hρ,hβ,hgap,hγ⟩ := hI i hi
    rw [regularizedL,ite_eq_right hχ] at hρ
    exact ⟨hχ,hρ,hβ,hgap,hγ⟩
  have hEll (i : ι) (hi : i∈I) : 0<(1-(ρ i).re)*L ∧ (1-(ρ i).re)*L≤H :=
    ⟨mul_pos (sub_pos.mpr (hI i hi).2.2.1) hL₀,(hI i hi).2.2.2.1⟩
  have hPair (i : ι) (hi : i∈I) (j : ι) (hj : j∈I) :
      let s := conj (ρ i)+ρ j-1
      s.re < 1 ∧ (1-s.re)*L ≤ 2*H ∧ |s.im|≤2*T := by
    intro s
    have hβ (k : ι) (hk : k∈I) : (ρ k).re < 1 := (hI k hk).2.2.1
    have hR : s.re=(ρ i).re+(ρ j).re-1 := by simp [s]
    have hI' : s.im=-(ρ i).im+(ρ j).im := by simp [s]
    have hG : |s.im|≤|(ρ i).im|+|(ρ j).im| := by rw [hI']; simpa only [abs_neg] using
      (abs_add_le (-(ρ i).im) (ρ j).im)
    refine ⟨by rw [hR]; linarith only [hβ i hi,hβ j hj],?_,?_⟩
    · rw [hR]
      nlinarith only [(hEll i hi).2,(hEll j hj).2]
    · linarith only [hG,(hI i hi).2.2.2.2,(hI j hj).2.2.2.2]
  have hWindow (a : ℝ) (ha : ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ)≤L →
       ∀ χ : DirichletCharacter ℂ q, χ≠1 →
       ∀ γ ell : ℝ, |γ|≤T → 0<ell → ell≤H →
       ∀ V : Finset ℂ, (∀ ρ∈V,regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ (1-ρ.re)*L≤H) →
         (∑ z∈V,(analyticOrderNatAt (regularizedL χ) z:ℝ))≤J →
