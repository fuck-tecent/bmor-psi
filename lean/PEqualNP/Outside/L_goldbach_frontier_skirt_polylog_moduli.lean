    rw [hid]
    dsimp [f]
    rw [V1tb hX]
    ring
  rw [sum_congr rfl heq, sum_add_distrib, sum_const, nsmul_eq_mul]
  congr 1
  rw [← intervalIntegral.integral_finsetSum (fun i _ => hi i)]
  apply intervalIntegral.integral_congr
  intro σ hσ
  simp only [f, Set.indicator, Set.mem_Iic]
  rw [← Finset.sum_filter]
  simp [Finset.sum_const, nsmul_eq_mul, mul_comm]
theorem V193 {X A δ σ : ℝ} (hX : 1 ≤ X) (hA : 0 ≤ A)
    (hscale : A ≤ X ^ (5/12 : ℝ)) (hδ : 0 ≤ δ)
    (hσ : σ ≤ 1 - δ) :
    X ^ (2 * σ - 2) * A ^ (4 * (1 - σ)) ≤ X ^ (-δ / 3) := by
  have hXpos : 0 < X := lt_of_lt_of_le zero_lt_one hX
  calc
    _ ≤ X ^ (2 * σ - 2) * (X ^ (5/12 : ℝ)) ^ (4 * (1 - σ)) := by
      exact mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow hA hscale (by linarith)) (Real.rpow_nonneg hXpos.le _)
    _ = X ^ ((σ - 1) / 3) := by
      rw [← Real.rpow_mul hXpos.le, ← Real.rpow_add hXpos]
      congr 1
      ring
    _ ≤ X ^ (-δ / 3) :=
      Real.rpow_le_rpow_of_exponent_le hX (by linarith)
theorem Vry {α : Type*} (F : Finset α) (β : α → ℝ)
    {X A C L δ : ℝ} (hX : 1 ≤ X) (hA : 0 ≤ A) (hC : 0 ≤ C) (hL : 0 ≤ L)
    (hδ : 0 ≤ δ) (hδhalf : δ ≤ 1/2)
    (hscale : A ≤ X ^ (5/12 : ℝ))
    (hβ : ∀ i ∈ F, 1/2 ≤ β i ∧ β i ≤ 1-δ)
    (hdensity : ∀ σ : ℝ, 1/2 ≤ σ → σ ≤ 1-δ →
      ((F.filter (fun i => σ ≤ β i)).card : ℝ) ≤
        C * A ^ (4 * (1-σ)) * L^13) :
    (∑ i ∈ F, X ^ (2 * β i - 2)) ≤
      C * L^13 * (1 + Real.log X) * X ^ (-δ/3) := by
  have hXpos : 0 < X := lt_of_lt_of_le zero_lt_one hX
  have hlog : 0 ≤ Real.log X := Real.log_nonneg hX
  have hab : (1/2 : ℝ) ≤ 1-δ := by linarith
  let f : ℝ → ℝ := fun σ => 2 * Real.log X * X ^ (2 * σ - 2)
  let g : ℝ → ℝ := fun σ => f σ * ((F.filter (fun i => σ ≤ β i)).card : ℝ)
  let K := 2 * Real.log X * C * L^13 * X ^ (-δ/3)
  have hg_eq : g = fun σ => ∑ i ∈ F, (Iic (β i)).indicator f σ := by
    funext σ
    dsimp [g]
    simp only [Set.indicator, Set.mem_Iic]
    rw [← Finset.sum_filter]
    simp [Finset.sum_const, nsmul_eq_mul, mul_comm]
  have hgi : IntervalIntegrable g volume (1/2) (1-δ) := by
    rw [hg_eq]
    have hfi (i : α) : IntervalIntegrable ((Iic (β i)).indicator f)
        volume (1/2) (1-δ) := Vqa hXpos
    convert IntervalIntegrable.sum F (fun i _ => hfi i) using 1
    ext σ
    simp only [Finset.sum_apply]
  have hg_le (σ : ℝ) (hσ : σ ∈ Icc (1/2) (1-δ)) : g σ ≤ K := by
    have hwt := V193 hX hA hscale hδ hσ.2
    have hcount := hdensity σ hσ.1 hσ.2
    dsimp [g,f,K]
    calc
      _ ≤ (2 * Real.log X * X ^ (2*σ-2)) *
          (C * A ^ (4*(1-σ)) * L^13) :=
        mul_le_mul_of_nonneg_left hcount (by positivity)
      _ = (2 * Real.log X * C * L^13) *
          (X ^ (2*σ-2) * A ^ (4*(1-σ))) := by ring
      _ ≤ (2 * Real.log X * C * L^13) * X ^ (-δ/3) :=
        mul_le_mul_of_nonneg_left hwt (by positivity)
  have hint : (∫ σ in (1/2 : ℝ)..(1-δ), g σ) ≤
      Real.log X * C * L^13 * X ^ (-δ/3) := by
    have hi := intervalIntegral.integral_mono_on hab hgi
      (intervalIntegrable_const : IntervalIntegrable (fun _ : ℝ => K) volume (1/2) (1-δ))
      hg_le
    rw [intervalIntegral.integral_const, smul_eq_mul] at hi
    have hK : 0 ≤ K := by dsimp [K]; positivity
    have hmul := mul_le_mul_of_nonneg_right (show 1-δ-(1/2:ℝ) ≤ 1/2 by linarith) hK
    apply hi.trans
    dsimp [K] at hmul ⊢
    nlinarith
  have hF : F.filter (fun i => (1/2 : ℝ) ≤ β i) = F :=
    Finset.filter_eq_self.mpr (fun i hi => (hβ i hi).1)
  have hbase : (F.card : ℝ) * X ^ (2*(1/2:ℝ)-2) ≤
      C * L^13 * X ^ (-δ/3) := by
    have hc := hdensity (1/2) le_rfl hab
    rw [hF] at hc
    calc
      _ ≤ (C * A ^ (4*(1-(1/2:ℝ))) * L^13) * X ^ (2*(1/2:ℝ)-2) :=
        mul_le_mul_of_nonneg_right hc (by positivity)
      _ = (C * L^13) * (X ^ (2*(1/2:ℝ)-2) * A ^ (4*(1-(1/2:ℝ)))) := by ring
      _ ≤ (C * L^13) * X ^ (-δ/3) :=
        mul_le_mul_of_nonneg_left (V193 hX hA hscale hδ hab) (by positivity)
  rw [V19e F β hXpos hβ]
  change (F.card : ℝ) * X ^ (2*(1/2:ℝ)-2) +
    (∫ σ in (1/2:ℝ)..(1-δ), g σ) ≤ _
  nlinarith
end Vmm
end

section
open Finset
open scoped BigOperators Classical
namespace Vmn
theorem V18s {A B Z e : ℝ} (hA : 0 ≤ A) (hB : 1 ≤ B)
    (hZ : 0 ≤ Z) (hAZ : A ≤ Z*B) (he : 0 ≤ e) (he2 : e ≤ 2) :
    A^e ≤ B^2 * Z^e := by
  calc
    _ ≤ (Z*B)^e := Real.rpow_le_rpow hA hAZ he
    _ = Z^e * B^e := Real.mul_rpow hZ (by linarith)
    _ ≤ Z^e * B^(2 : ℝ) :=
      mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow_of_exponent_le hB he2) (Real.rpow_nonneg hZ _)
    _ = _ := by rw [Real.rpow_two]; ring
theorem Vwf :
    ∃ C : ℝ, 0 < C ∧ ∀ (Q : ℕ), 1 ≤ Q → ∀ X T η δ : ℝ,
      1 ≤ X → 2 ≤ T → 0 < η → 0 ≤ δ → δ ≤ 1/2 →
      (Q : ℝ)^2/η ≤ X^(5/12 : ℝ) →
      ∀ F : Finset OAI.Ostmann.PrimitiveComplexCharacter,
      (∀ χ ∈ F, χ.modulus ≤ Q) →
      (∑ χ ∈ F, ∑ i ∈ ((OAI.Ostmann.V1 χ).V14 T).filter
          (fun i => 1/2 ≤ ((OAI.Ostmann.V1 χ).zeros i).re ∧
            ((OAI.Ostmann.V1 χ).zeros i).re ≤ 1-δ),
          X ^ (2*((OAI.Ostmann.V1 χ).zeros i).re-2)) ≤
        C * (Real.log ((Q : ℝ)*T))^13 * (1 + Real.log X) *
          (max 1 (η*T))^2 * X^(-δ/3) := by
  obtain ⟨C,hC,hDensity⟩ := V1eq.V1xi
  refine ⟨C,hC,?_⟩
  intro Q hQ X T η δ hX hT hη hδ hδhalf hscale F hF
  let Z := OAI.Ostmann.V1
  let S : Finset (Σ _ : OAI.Ostmann.PrimitiveComplexCharacter, ℕ) :=
    F.sigma (fun χ => ((Z χ).V14 T).filter
      (fun i => 1/2 ≤ ((Z χ).zeros i).re ∧ ((Z χ).zeros i).re ≤ 1-δ))
  let β : (Σ _ : OAI.Ostmann.PrimitiveComplexCharacter, ℕ) → ℝ :=
    fun i => ((Z i.1).zeros i.2).re
  let B := max 1 (η*T)
  have hB : 1 ≤ B := le_max_left _ _
  have hXpos : 0 < X := lt_of_lt_of_le zero_lt_one hX
  have hpow : 0 ≤ X^(5/12 : ℝ) := Real.rpow_nonneg hXpos.le _
  have hscaleB : (Q : ℝ)^2*T ≤ X^(5/12 : ℝ)*B := by
    have hs := (div_le_iff₀ hη).mp hscale
    calc
      _ ≤ (X^(5/12 : ℝ)*η)*T :=
        mul_le_mul_of_nonneg_right hs (by linarith)
      _ = X^(5/12 : ℝ)*(η*T) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_max_right _ _) hpow
  have hβ : ∀ i ∈ S, (1/2 : ℝ) ≤ β i ∧ β i ≤ 1-δ := by
    intro i hi
    exact (Finset.mem_filter.mp (Finset.mem_sigma.mp hi).2).2
  have hQR : (1 : ℝ) ≤ Q := by exact_mod_cast hQ
  have hL : 0 ≤ Real.log ((Q : ℝ)*T) :=
    Real.log_nonneg (one_le_mul_of_one_le_of_one_le hQR (by linarith))
  have hd (σ : ℝ) (hσ : 1/2 ≤ σ) (hσδ : σ ≤ 1-δ) :
      ((S.filter (fun i => σ ≤ β i)).card : ℝ) ≤
        (C*B^2) * (X^(5/12 : ℝ))^(4*(1-σ)) * (Real.log ((Q : ℝ)*T))^13 := by
    have hsub : S.filter (fun i => σ ≤ β i) ⊆
        F.sigma (fun χ => ((Z χ).V14 T).filter
          (fun i => σ ≤ ((Z χ).zeros i).re)) := by
      intro i hi
      obtain ⟨hiS,hiσ⟩ := Finset.mem_filter.mp hi
      obtain ⟨hiF,hiZ⟩ := Finset.mem_sigma.mp hiS
      exact Finset.mem_sigma.mpr ⟨hiF,
        Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hiZ).1,hiσ⟩⟩
    have hf := V18s
      (show 0 ≤ (Q : ℝ)^2*T by positivity) hB hpow hscaleB
      (show 0 ≤ 4*(1-σ) by linarith) (show 4*(1-σ) ≤ 2 by linarith)
    calc
      _ ≤ ((F.sigma (fun χ => ((Z χ).V14 T).filter
          (fun i => σ ≤ ((Z χ).zeros i).re))).card : ℝ) := by
        exact_mod_cast Finset.card_le_card hsub
      _ = ∑ χ ∈ F, ((Z χ).count σ T : ℝ) := by
        simp only [Finset.card_sigma, Nat.cast_sum, OAI.Ostmann.ComplexZeroEnumeration.count]
      _ ≤ C * ((Q : ℝ)^2*T)^(4*(1-σ)) * (Real.log ((Q : ℝ)*T))^13 :=
        hDensity Q hQ T σ hT hσ (by linarith) F hF
      _ ≤ C * (B^2 * (X^(5/12 : ℝ))^(4*(1-σ))) *
          (Real.log ((Q : ℝ)*T))^13 := by
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hf hC.le) (pow_nonneg hL _)
      _ = _ := by ring
  have hb := Vmm.Vry S β hX hpow
    (show 0 ≤ C*B^2 by positivity) hL hδ hδhalf le_rfl hβ hd
  have hbr : (C*B^2) * (Real.log ((Q : ℝ)*T))^13 *
      (1+Real.log X) * X^(-δ/3) =
      C * (Real.log ((Q : ℝ)*T))^13 * (1+Real.log X) * B^2 * X^(-δ/3) := by ring
  rw [hbr] at hb
  simpa only [S,β,Z,B,Finset.sum_sigma] using hb
end Vmn
end

section
open Filter Finset
open scoped Topology BigOperators Classical
namespace V1l
noncomputable def V2j (A : ℕ) (X : ℝ) : ℝ :=
  3 * (A+14 : ℕ) * Real.log (Real.log X) / Real.log X
theorem V20i (A : ℕ) {X : ℝ} (hX : 1 < X) :
    X ^ (-V2j A X / 3) = ((Real.log X)^(A+14))⁻¹ := by
  have hXp : 0 < X := by linarith
  have hL : 0 < Real.log X := Real.log_pos hX
  calc
    _ = (Real.log X)^(-(A+14 : ℕ) : ℝ) := by
      rw [Real.rpow_def_of_pos hXp, Real.rpow_def_of_pos hL]
      congr 1
      dsimp [V2j]
      field_simp
    _ = _ := by rw [Real.rpow_neg hL.le, Real.rpow_natCast]
theorem Vgn (A : ℕ) :
    ∀ᶠ X : ℝ in atTop, 1 < X ∧ 1 ≤ Real.log X ∧
      0 ≤ V2j A X ∧ V2j A X ≤ 1/2 := by
  have ht : Tendsto (fun X : ℝ => Real.log (Real.log X) / Real.log X)
      atTop (𝓝 0) :=
    Real.isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp Real.tendsto_log_atTop
  have hc : Tendsto (V2j A) atTop (𝓝 0) := by
    have hm := ht.const_mul (3 * (A+14 : ℕ) : ℝ)
    simp only [mul_zero] at hm
    convert hm using 1
    ext X
    simp only [V2j, mul_div_assoc]
  have he := hc.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1/2))
  filter_upwards [he, eventually_gt_atTop (1 : ℝ),
    Real.tendsto_log_atTop.eventually_ge_atTop (1 : ℝ)] with X hδ hX hL
  refine ⟨hX,hL,?_,hδ.le⟩
  dsimp [V2j]
  exact div_nonneg (mul_nonneg (by positivity) (Real.log_nonneg hL)) (by linarith)
theorem V1r8 (A : ℕ) {X L : ℝ} (hX : 1 < X)
    (hlogX : 1 ≤ Real.log X) (hL : 0 ≤ L) (hLup : L ≤ 2*Real.log X) :
    L^13 * (1+Real.log X) * X^(-V2j A X/3) ≤
      16384 / (Real.log X)^A := by
  have hp : 0 < Real.log X := by linarith
  rw [V20i A hX]
  calc
    _ ≤ (2*Real.log X)^13 * (2*Real.log X) * ((Real.log X)^(A+14))⁻¹ := by
      gcongr
      linarith
    _ = 16384 / (Real.log X)^A := by
      rw [pow_add]
      field_simp
      ring
theorem V1gm (A : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∃ X₀ : ℝ,
      ∀ (Q : ℕ), 1 ≤ Q → ∀ X T η : ℝ,
      X₀ ≤ X → 2 ≤ T → 0 < η →
      (Q : ℝ)^2/η ≤ X^(5/12 : ℝ) →
      Real.log ((Q : ℝ)*T) ≤ 2*Real.log X →
      ∀ F : Finset OAI.Ostmann.PrimitiveComplexCharacter,
      (∀ χ ∈ F, χ.modulus ≤ Q) →
      (∑ χ ∈ F, ∑ i ∈ ((OAI.Ostmann.V1 χ).V14 T).filter
          (fun i => 1/2 ≤ ((OAI.Ostmann.V1 χ).zeros i).re ∧
            ((OAI.Ostmann.V1 χ).zeros i).re ≤ 1-V2j A X),
          X ^ (2*((OAI.Ostmann.V1 χ).zeros i).re-2)) ≤
        C * (max 1 (η*T))^2 / (Real.log X)^A := by
  obtain ⟨C,hC,hband⟩ := Vmn.Vwf
  obtain ⟨X₀,hX₀⟩ := eventually_atTop.1 (Vgn A)
  refine ⟨16384*C,by positivity,X₀,?_⟩
  intro Q hQ X T η hXX Tge hη hscale hlogs F hF
  obtain ⟨hX,hlogX,hδ,hδhalf⟩ := hX₀ X hXX
  have hQR : (1 : ℝ) ≤ Q := by exact_mod_cast hQ
  have hL : 0 ≤ Real.log ((Q : ℝ)*T) :=
    Real.log_nonneg (one_le_mul_of_one_le_of_one_le hQR (by linarith))
  have hb := hband Q hQ X T η (V2j A X) hX.le Tge hη hδ hδhalf hscale F hF
  apply hb.trans
  calc
    _ = (C*(max 1 (η*T))^2) *
        ((Real.log ((Q : ℝ)*T))^13 * (1+Real.log X) * X^(-V2j A X/3)) := by ring
    _ ≤ (C*(max 1 (η*T))^2) * (16384/(Real.log X)^A) :=
      mul_le_mul_of_nonneg_left (V1r8 A hX hlogX hL hlogs) (by positivity)
    _ = _ := by ring
end V1l
end

section
open Finset MeasureTheory
open scoped BigOperators Interval Classical
namespace Vda
open OAI.Ostmann
open V1l (V2j)
theorem V1ta (η T : ℝ) (hT : 0<T) :
    min η (1/T) * max 1 (η*T) = η := by
  by_cases h : η*T≤1
  · have hm : η≤1/T := (le_div_iff₀ hT).2 h
    rw [min_eq_left hm, max_eq_left h, mul_one]
  · have hm : 1/T≤η := (div_le_iff₀ hT).2 (le_of_not_ge h)
    rw [min_eq_right hm, max_eq_right (le_of_not_ge h)]
    field_simp
theorem Vjp (B : ℕ) (K L η T : ℝ)
    (hL : 0<L) (hT : 0<T) :
    (K*min η (1/T)*L)^2*(2*L)^2*(max 1 (η*T))^2/L^(B+4) =
      4*K^2*η^2/L^B := by
  calc
    _ = 4*K^2*(min η (1/T)*max 1 (η*T))^2/L^B := by
      rw [pow_add]
      field_simp
      ring
    _ = _ := by rw [V1ta η T hT]
theorem V1gn (B : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∃ X₀ : ℝ,
      ∀ (Q : ℕ), 1≤Q → ∀ X T η K : ℝ,
      X₀≤X → 2≤T → 0<η → 0≤K →
      (Q : ℝ)^2/η≤X^(5/12 : ℝ) →
      Real.log ((Q : ℝ)*T)≤2*Real.log X →
      ∀ F : Finset PrimitiveComplexCharacter,
      (∀ χ∈F, χ.modulus≤Q) →
      ∀ a : PrimitiveComplexCharacter → ℕ → ℂ,
      (∀ χ∈F, ∀ i∈((V1 χ).V14 T).filter
        (fun i => 1/2≤((V1 χ).zeros i).re ∧
          ((V1 χ).zeros i).re≤1-V2j (B+4) X),
        ‖a χ i‖≤K*min η (1/T)*Real.log X) →
      (∑ χ∈F, ∫ y in X..4*X, ‖∑ i∈((V1 χ).V14 T).filter
        (fun i => 1/2≤((V1 χ).zeros i).re ∧
          ((V1 χ).zeros i).re≤1-V2j (B+4) X),
        a χ i*(y : ℂ)^((V1 χ).zeros i)‖^2) ≤
          C*K^2*η^2*X^3/(Real.log X)^B := by
  obtain ⟨C₀,hC₀,X₀,hDensity⟩ :=
    V1l.V1gm (B+4)
  let D : ℝ := 20800/Real.log (14/13)
  have hD : 0<D := by
    dsimp [D]
    exact div_pos (by norm_num) (Real.log_pos (by norm_num : (1 : ℝ)<14/13))
  refine ⟨4*D*C₀, by positivity, max X₀ (Real.exp 1), ?_⟩
  intro Q hQ X T η K hX₀ hT hη hK hscale hlog F hF a ha
  have hXX : X₀≤X := (le_max_left _ _).trans hX₀
  have hXe : Real.exp 1≤X := (le_max_right _ _).trans hX₀
  have hXp : 0<X := (Real.exp_pos 1).trans_le hXe
  have hL1 : 1≤Real.log X := by
    have hh := Real.log_le_log (Real.exp_pos 1) hXe
    simpa only [Real.log_exp] using hh
  have hL : 0<Real.log X := by linarith
  have hTp : 0<T := by linarith
  have hQT : 0≤Real.log ((Q : ℝ)*T) := by
    apply Real.log_nonneg
    have hQR : (1 : ℝ)≤(Q : ℝ) := by exact_mod_cast hQ
    nlinarith
  have hw := hDensity Q hQ X T η hXX hT hη hscale hlog F hF
  have he := Vtb.V18h Q hQ X T
    (K*min η (1/T)*Real.log X) (V2j (B+4) X) hXp hT F hF a ha
  change _ ≤ D*(K*min η (1/T)*Real.log X)^2*X^3*(Real.log ((Q : ℝ)*T))^2 * _ at he
  apply he.trans
  calc
    _ ≤ D*(K*min η (1/T)*Real.log X)^2*X^3*(Real.log ((Q : ℝ)*T))^2 *
        (C₀*(max 1 (η*T))^2/(Real.log X)^(B+4)) :=
      mul_le_mul_of_nonneg_left hw (by positivity)
    _ ≤ D*(K*min η (1/T)*Real.log X)^2*X^3*(2*Real.log X)^2 *
        (C₀*(max 1 (η*T))^2/(Real.log X)^(B+4)) := by
      gcongr
    _ = (D*C₀*X^3)*
        ((K*min η (1/T)*Real.log X)^2*(2*Real.log X)^2*(max 1 (η*T))^2/
          (Real.log X)^(B+4)) := by ring
    _ = (D*C₀*X^3)*(4*K^2*η^2/(Real.log X)^B) := by
      rw [Vjp B K (Real.log X) η T hL hTp]
    _ = (4*D*C₀)*K^2*η^2*X^3/(Real.log X)^B := by ring
theorem Vjq (B : ℕ) :
    ∃ C : ℝ, 0<C ∧ ∃ X₀ : ℝ,
      ∀ (Q : ℕ), 1≤Q → ∀ X T η K : ℝ,
      X₀≤X → 2≤T → 0<η → 0≤K →
      (Q : ℝ)^2/η≤X^(5/12 : ℝ) →
      Real.log ((Q : ℝ)*T)≤2*Real.log X →
      ∀ F : Finset PrimitiveComplexCharacter,
      (∀ χ∈F, χ.modulus≤Q) →
      ∀ S : PrimitiveComplexCharacter → Finset ℕ,
      (∀ χ∈F, S χ⊆((V1 χ).V14 T).filter
        (fun i => 1/2≤((V1 χ).zeros i).re ∧
          ((V1 χ).zeros i).re≤1-V2j (B+4) X)) →
      ∀ a : PrimitiveComplexCharacter → ℕ → ℂ,
      (∀ χ∈F, ∀ i∈S χ, ‖a χ i‖≤K*min η (1/T)*Real.log X) →
      (∑ χ∈F, ∫ y in X..4*X,
        ‖∑ i∈S χ, a χ i*(y : ℂ)^((V1 χ).zeros i)‖^2) ≤
          C*K^2*η^2*X^3/(Real.log X)^B := by
  obtain ⟨C,hC,X₀,hMean⟩ := V1gn B
  refine ⟨C,hC,max X₀ (Real.exp 1),?_⟩
  intro Q hQ X T η K hX₀ hT hη hK hscale hlog F hF S hS a ha
  have hXX : X₀≤X := (le_max_left _ _).trans hX₀
  have hXe : Real.exp 1≤X := (le_max_right _ _).trans hX₀
  have hL : 0≤Real.log X := by
    have hh := Real.log_le_log (Real.exp_pos 1) hXe
    rw [Real.log_exp] at hh
    linarith
  have hTp : 0<T := by linarith
  have hA : 0≤K*min η (1/T)*Real.log X := by positivity
  let b (χ : PrimitiveComplexCharacter) (i : ℕ) : ℂ := if i∈S χ then a χ i else 0
  have hb : ∀ χ∈F, ∀ i∈((V1 χ).V14 T).filter
      (fun i => 1/2≤((V1 χ).zeros i).re ∧
        ((V1 χ).zeros i).re≤1-V2j (B+4) X),
      ‖b χ i‖≤K*min η (1/T)*Real.log X := by
    intro χ hχ i _
    by_cases hi : i∈S χ
    · simpa only [b, ite_eq_left hi] using ha χ hχ i hi
    · simpa only [b, ite_eq_right hi, norm_zero] using hA
  have hseries (χ : PrimitiveComplexCharacter) (hχ : χ∈F) (y : ℝ) :
      (∑ i∈((V1 χ).V14 T).filter
        (fun i => 1/2≤((V1 χ).zeros i).re ∧
          ((V1 χ).zeros i).re≤1-V2j (B+4) X),
        b χ i*(y : ℂ)^((V1 χ).zeros i)) =
      ∑ i∈S χ, a χ i*(y : ℂ)^((V1 χ).zeros i) := by
    calc
      _ = ∑ i∈S χ, b χ i*(y : ℂ)^((V1 χ).zeros i) := by
        exact (sum_subset (hS χ hχ) (by intro i _ hi; simp [b,hi])).symm
      _ = _ := by
        apply sum_congr rfl
        intro i hi
        simp only [b, ite_eq_left hi]
  calc
    _ = ∑ χ∈F, ∫ y in X..4*X,
        ‖∑ i∈((V1 χ).V14 T).filter
          (fun i => 1/2≤((V1 χ).zeros i).re ∧
            ((V1 χ).zeros i).re≤1-V2j (B+4) X),
          b χ i*(y : ℂ)^((V1 χ).zeros i)‖^2 := by
      apply sum_congr rfl
      intro χ hχ
      apply intervalIntegral.integral_congr
      intro y _
      dsimp only
      rw [hseries χ hχ y]
    _ ≤ _ := hMean Q hQ X T η K hXX hT hη hK hscale hlog F hF b hb
end Vda
