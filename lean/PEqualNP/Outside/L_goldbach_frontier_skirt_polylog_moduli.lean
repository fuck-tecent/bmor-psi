      apply sum_congr rfl
      intro i hi
      exact intervalIntegral.integral_finsetSum (hint i hi)
    _ = _ := by simp only [intervalIntegral.integral_const_mul]
theorem V1ko {ι : Type*} (S : Finset ι)
    (a ρ : ι → ℂ) (X R : ℝ) (hX : 0<X)
    (hρ0 : ∀ i∈S, 0≤(ρ i).re) (hρ1 : ∀ i∈S, (ρ i).re≤1)
    (hRow : ∀ i∈S, (∑ j∈S, 1/(1+|(ρ i).im-(ρ j).im|))≤R) :
    (∫ y in X..4*X, ‖∑ i∈S, a i*(y : ℂ)^(ρ i)‖^2) ≤
      130*X^3*R*∑ i∈S, ‖a i‖^2*X^(2*(ρ i).re-2) := by
