namespace GoldbachPintzWeightedFormula

open Complex MeasureTheory Set Filter GradedNear
open scoped ComplexConjugate Interval

noncomputable section


set_option maxHeartbeats 900000 in
/-- The hyperbolic-sine compact kernel used to control a Gram row. -/
def sinhTest (ω ell t : ℝ) : ℝ := if t ≤ ω then Real.sinh (ell*(ω-t)) else 0

set_option maxHeartbeats 900000 in
def windowLaplace (ω : ℝ) (z : ℂ) : ℂ := (1-Complex.exp (-(z*(ω:ℂ))))/z

set_option maxHeartbeats 900000 in
theorem sinhTest_vanish {ω ell t : ℝ} (h : ω ≤ t) : sinhTest ω ell t = 0 := by
  rcases h.eq_or_lt with rfl|h
  · simp [sinhTest]
  · simp [sinhTest,not_le_of_gt h]

set_option maxHeartbeats 900000 in
theorem sinhTest_continuous (ω ell : ℝ) : Continuous (sinhTest ω ell) := by
  have hEq : sinhTest ω ell = fun t => Real.sinh (ell*max (ω-t) 0) := by
    funext t
    rcases le_total t ω with h|h
    · simp [sinhTest,h]
    · rw [sinhTest_vanish h,max_eq_right (sub_nonpos.mpr h),mul_zero,Real.sinh_zero]
  rw [hEq]
  fun_prop

set_option maxHeartbeats 900000 in
theorem windowLaplace_eq_interval {ω : ℝ} {z : ℂ} (hz : z ≠ 0) :
    windowLaplace ω z = ∫ t in (0:ℝ)..ω, Complex.exp (-(z*(t:ℂ))) := by
  simp_rw [← neg_mul]
  rw [integral_exp_mul_complex (neg_ne_zero.mpr hz),windowLaplace]
  simp only [Complex.ofReal_zero,mul_zero,Complex.exp_zero,neg_mul,div_neg]
  ring

set_option maxHeartbeats 900000 in
private theorem sinhTest_laplace_closed {ω ell : ℝ} (hω : 0 < ω) {z : ℂ}
    (h₁ : z+(ell:ℂ) ≠ 0) (h₂ : z-(ell:ℂ) ≠ 0) :
    laplace (sinhTest ω ell) z =
      ((Real.exp (ell*ω):ℂ)*windowLaplace ω (z+(ell:ℂ)) -
        (Real.exp (-ell*ω):ℂ)*windowLaplace ω (z-(ell:ℂ)))/2 := by
  rw [Admissible.laplace_eq_intervalIntegral_of hω (fun _ => sinhTest_vanish),
    windowLaplace_eq_interval h₁,windowLaplace_eq_interval h₂, ← intervalIntegral.integral_const_mul,
    ← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_sub (Continuous.intervalIntegrable (by fun_prop) _ _) (Continuous.intervalIntegrable (by fun_prop) _ _),
    ← intervalIntegral.integral_div]
  apply intervalIntegral.integral_congr
  intro t ht
  have ht' := (uIcc_of_le hω.le ▸ ht).2
  change (↑(sinhTest ω ell t):ℂ)*Complex.exp (-(z*(t:ℂ))) = _
  rw [sinhTest, ite_eq_left ht', Real.sinh_eq]
  simp only [ofReal_div,ofReal_sub,ofReal_mul,ofReal_ofNat,ofReal_exp,ofReal_neg]
  rw [div_mul_eq_mul_div,sub_mul,← Complex.exp_add,← Complex.exp_add,
    ← Complex.exp_add,← Complex.exp_add]
  congr 1 <;> congr 1 <;> congr 1 <;> ring

set_option maxHeartbeats 900000 in
/-- A bounded holomorphic test has nonnegative real part on the right half-plane
if its real part is nonnegative on the imaginary axis. -/
private theorem re_nonneg_of_imag_axis {F : ℂ → ℂ} {M : ℝ}
    (hF : DifferentiableOn ℂ F {z : ℂ | 0 ≤ z.re})
    (hM : ∀ z : ℂ, 0 ≤ z.re → ‖F z‖ ≤ M)
    (hI : ∀ y : ℝ, 0 ≤ (F ((y:ℂ)*I)).re)
    {z : ℂ} (hz : 0 ≤ z.re) : 0 ≤ (F z).re := by
  let g (w : ℂ) := Complex.exp (-F w)
  have hg : DifferentiableOn ℂ g {z : ℂ | 0 ≤ z.re} := hF.neg.cexp
  have hgc : DiffContOnCl ℂ g {z : ℂ | 0 < z.re} := by
    refine DifferentiableOn.diffContOnCl (hg.mono ?_)
    exact closure_minimal (fun (w : ℂ) (h : 0 < w.re) => show 0 ≤ w.re from le_of_lt h)
      (isClosed_le continuous_const Complex.continuous_re)
  have hB (w : ℂ) (hw : 0 ≤ w.re) : ‖g w‖ ≤ Real.exp M := by
    change ‖Complex.exp (-F w)‖ ≤ _
    rw [Complex.norm_exp,Complex.neg_re]
    exact Real.exp_le_exp.mpr ((neg_le_abs _).trans ((Complex.abs_re_le_norm _).trans (hM w hw)))
  have hPL := PhragmenLindelof.right_half_plane_of_bounded_on_real (f := g) (C := 1)
    hgc ?_ ?_ ?_ hz
  · change ‖Complex.exp (-F z)‖ ≤ 1 at hPL
    rw [Complex.norm_exp,Complex.neg_re,Real.exp_le_one_iff] at hPL
    linarith only [hPL]
  · refine ⟨0, by norm_num, 0, Asymptotics.IsBigO.of_bound (Real.exp M) ?_⟩
    refine eventually_inf_principal.2 (Eventually.of_forall fun w hw => ?_)
    simpa [Real.norm_eq_abs,abs_of_pos (Real.exp_pos _)] using hB w (le_of_lt hw)
  · refine ⟨Real.exp M,Filter.eventually_map.2 ?_⟩
    filter_upwards [eventually_ge_atTop 0] with x hx
    exact hB (x:ℂ) (by simpa using hx)
  · intro y
    change ‖Complex.exp (-F ((y:ℂ)*I))‖ ≤ 1
    rw [Complex.norm_exp,Complex.neg_re,Real.exp_le_one_iff]
    linarith only [hI y]

set_option maxHeartbeats 900000 in
private theorem windowLaplace_bound {ω : ℝ} (hω : 0 < ω) {z : ℂ} (hz : 0 < z.re) :
    ‖windowLaplace ω z‖ ≤ ω := by
  have hn : z ≠ 0 := by intro h; simp [h] at hz
  rw [windowLaplace_eq_interval hn]
  convert intervalIntegral.norm_integral_le_of_norm_le_const (a:=0) (b:=ω) (C:=1) ?_ using 1
  · simp [abs_of_pos hω]
  · intro t ht
    have ht' := (uIoc_of_le hω.le ▸ ht).1.le
    rw [Complex.norm_exp,Real.exp_le_one_iff]
    simpa [Complex.mul_re] using neg_nonpos.mpr (mul_nonneg hz.le ht')

set_option maxHeartbeats 900000 in
theorem sinhTest_boundary {ω ell : ℝ} (hω : 0 < ω) (hell : 0 < ell) (y : ℝ) :
    (laplace (sinhTest ω ell) ((y:ℂ)*I)).re =
      (ell*Real.exp (ell*ω)/2)*‖windowLaplace ω ((y:ℂ)*I+(ell:ℂ))‖^2 := by
  let z := (y:ℂ)*I
  let E := Real.exp (ell*ω)
  let e := Real.exp (-ell*ω)
  let B := Complex.exp (-(z*(ω:ℂ)))
  let v := z+(ell:ℂ)
  have hz : z.re=0 := by simp [z,Complex.mul_re]
  have hE : 0 < E := Real.exp_pos _
  have he : 0 < e := Real.exp_pos _
  have hEe : E*e=1 := by
    dsimp only [E,e]
    rw [←Real.exp_add, show ell*ω + -ell*ω=0 by ring,Real.exp_zero]
  have hv : v.re=ell := by simp [v,hz]
  have hne : v ≠ 0 := by intro h; rw [h,Complex.zero_re] at hv; linarith only [hv,hell]
  have hneg : z-(ell:ℂ) = -(conj v) := by apply Complex.ext <;> simp [z,v,Complex.mul_re,Complex.mul_im]
  have hneg' : z-(ell:ℂ) ≠ 0 := by rw [hneg,neg_ne_zero]; exact (map_ne_zero _).mpr hne
  have hExp₁ : Complex.exp (-((z+(ell:ℂ))*(ω:ℂ))) = B*(e:ℂ) := by
    dsimp only [B,e]
    rw [show -((z+(ell:ℂ))*(ω:ℂ))=-(z*(ω:ℂ))+((-ell*ω:ℝ):ℂ) by push_cast; ring,
      Complex.exp_add,Complex.ofReal_exp]
  have hExp₂ : Complex.exp (-((z-(ell:ℂ))*(ω:ℂ))) = B*(E:ℂ) := by
    dsimp only [B,E]
    rw [show -((z-(ell:ℂ))*(ω:ℂ))=-(z*(ω:ℂ))+((ell*ω:ℝ):ℂ) by push_cast; ring,
      Complex.exp_add,Complex.ofReal_exp]
  have hB : Complex.normSq B=1 := by
    dsimp only [B]
    rw [← Complex.sq_norm, Complex.norm_exp]
    simp [Complex.mul_re,hz]
  have hReal : (laplace (sinhTest ω ell) z).re = ((E+e-2*B.re)*ell)/(2*Complex.normSq v) := by
    rw [sinhTest_laplace_closed hω hne hneg',windowLaplace,windowLaplace,hExp₁,hExp₂,hneg]
    have hEec : (E:ℂ)*(e:ℂ)=1 := by exact_mod_cast hEe
    have hAlg : ((E:ℂ)*((1-B*(e:ℂ))/v) - (e:ℂ)*((1-B*(E:ℂ))/(-conj v)))/2 =
        (((E:ℂ)-B)/v + ((e:ℂ)-B)/conj v)/2 := by
      have h₁ : (E:ℂ)*(1-B*(e:ℂ)) = (E:ℂ)-B := by
        rw [show (E:ℂ)*(1-B*(e:ℂ))=(E:ℂ)-B*((E:ℂ)*(e:ℂ)) by ring,hEec,mul_one]
      have h₂ : (e:ℂ)*(1-B*(E:ℂ)) = (e:ℂ)-B := by
        rw [show (e:ℂ)*(1-B*(E:ℂ))=(e:ℂ)-B*((E:ℂ)*(e:ℂ)) by ring,hEec,mul_one]
      rw [div_neg,mul_neg,sub_neg_eq_add,←mul_div_assoc,←mul_div_assoc,h₁,h₂]
    rw [hAlg]
    have hc : (((e:ℂ)-B)/conj v).re = (((e:ℂ)-conj B)/v).re := by
      rw [← Complex.conj_re (((e:ℂ)-B)/conj v),map_div₀,map_sub,Complex.conj_ofReal,starRingEnd_self_apply]
    rw [Complex.div_ofNat_re, Complex.add_re,hc, ← Complex.add_re, ← add_div]
    have hNu : (E:ℂ)-B+((e:ℂ)-conj B) = ((E+e-2*B.re:ℝ):ℂ) := by
      apply Complex.ext <;> simp [Complex.sub_re,Complex.sub_im] <;> ring
    rw [hNu]
    simp only [Complex.div_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,add_zero,hv]
    ring
  change (laplace (sinhTest ω ell) z).re = _*‖windowLaplace ω v‖^2
  rw [hReal,windowLaplace,hExp₁,norm_div,div_pow,Complex.sq_norm,Complex.sq_norm]
  change _ = (ell*E/2)*(Complex.normSq (1-B*(e:ℂ))/Complex.normSq v)
  have hNorm : Complex.normSq (1-B*(e:ℂ)) = 1+e^2-2*e*B.re := by
    have hB' := hB
    rw [Complex.normSq_apply] at hB'
    simp only [Complex.normSq_apply,Complex.sub_re,Complex.sub_im,Complex.one_re,Complex.one_im,
      Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,mul_zero,zero_add,
      sub_zero,zero_sub]
    nlinarith only [congrArg (fun n : ℝ => e^2*n) hB']
  rw [hNorm]
  have hee : E*e^2=e := by rw [pow_two,←mul_assoc,hEe,one_mul]
  have hN : (E+e-2*B.re)*ell = ell*E*(1+e^2-2*e*B.re) := by
    linear_combination -ell*hee + 2*ell*B.re*hEe
  rw [hN]
  ring

set_option maxHeartbeats 900000 in
/-- Pintz's half-plane majorization (5.24), with the exact boundary constant. -/
theorem sinh_window_majorization {ω ell : ℝ} (hω : 0 < ω) (hell : 0 < ell)
    {z : ℂ} (hz : 0 ≤ z.re) :
    (ell*Real.exp (ell*ω)/2)*‖windowLaplace ω (z+(ell:ℂ))‖^2 ≤
      (laplace (sinhTest ω ell) z).re := by
  let c := ell*Real.exp (ell*ω)/2
  let Q (u : ℂ) := windowLaplace ω (u+(ell:ℂ))^2
  have hc : 0 ≤ c := by dsimp [c]; positivity
  have hQ (u : ℂ) (hu : 0 ≤ u.re) : ‖Q u‖ ≤ ω^2 := by
    dsimp only [Q]
    rw [norm_pow]
    apply pow_le_pow_left₀ (norm_nonneg _)
    apply windowLaplace_bound hω
    simp only [Complex.add_re,Complex.ofReal_re]
    linarith only [hu,hell]
  have hQd : DifferentiableOn ℂ Q {u : ℂ | 0 ≤ u.re} := by
    dsimp only [Q,windowLaplace]
    apply DifferentiableOn.pow ?_
    apply DifferentiableOn.div (by fun_prop) (by fun_prop)
    intro u hu he
    have h := congrArg Complex.re he
    simp only [Complex.add_re, Complex.ofReal_re,Complex.zero_re] at h
    exact (add_pos_of_nonneg_of_pos hu hell).ne' h
  let f := sinhTest ω ell
  have hfa : Differentiable ℂ (laplace f) := by
    intro u
    exact (Admissible.laplace_hasDerivAt_of hω (sinhTest_continuous ω ell).continuousOn
      (fun _ => sinhTest_vanish) u).differentiableAt
  let M := ∫ t in (0:ℝ)..ω, |f t|
  have hfB (u : ℂ) (hu : 0 ≤ u.re) : ‖laplace f u‖ ≤ M := by
    refine (Admissible.norm_laplace_le_of hω (sinhTest_continuous ω ell).continuousOn
      (fun _ => sinhTest_vanish) u).trans ?_
    refine intervalIntegral.integral_mono_on hω.le
      (Continuous.intervalIntegrable ((sinhTest_continuous ω ell).abs.mul (by fun_prop)) _ _)
      ((sinhTest_continuous ω ell).abs.intervalIntegrable _ _) ?_
    intro t ht
    exact mul_le_of_le_one_right (abs_nonneg _) (Real.exp_le_one_iff.mpr
      (neg_nonpos.mpr (mul_nonneg hu ht.1)))
  by_cases h0 : Q z=0
  · have hB := re_nonneg_of_imag_axis hfa.differentiableOn hfB
      (fun y => by rw [sinhTest_boundary hω hell]; positivity) hz
    have hNorm : ‖windowLaplace ω (z+(ell:ℂ))‖^2=0 := by
      have hN : ‖Q z‖=0 := by rw [h0,norm_zero]
      change ‖windowLaplace ω (z+(ell:ℂ))^2‖=0 at hN
      rwa [norm_pow] at hN
    simpa only [hNorm,mul_zero] using hB
  · let p := conj (Q z)/(‖Q z‖:ℂ)
    have hqN : (‖Q z‖:ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr h0)
    have hp : ‖p‖ = 1 := by
      simp only [p,norm_div,Complex.norm_conj,Complex.norm_real,Real.norm_eq_abs,
        abs_of_nonneg (norm_nonneg _),div_self (norm_ne_zero_iff.mpr h0)]
    have hpQ : p*Q z = (‖Q z‖:ℂ) := by
      dsimp only [p]
      rw [div_mul_eq_mul_div,mul_comm (conj (Q z)),Complex.mul_conj']
      field_simp
    let F (u : ℂ) := laplace f u-(c:ℂ)*p*Q u
    have hFd : DifferentiableOn ℂ F {u : ℂ | 0 ≤ u.re} :=
      hfa.differentiableOn.sub (hQd.const_mul _)
    have hFm (u : ℂ) (hu : 0 ≤ u.re) : ‖F u‖ ≤ M+c*ω^2 := by
      apply (norm_sub_le _ _).trans
      rw [norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hc,hp,mul_one]
      exact add_le_add (hfB u hu) (mul_le_mul_of_nonneg_left (hQ u hu) hc)
    have hFi (y : ℝ) : 0 ≤ (F ((y:ℂ)*I)).re := by
      change 0 ≤ (laplace f ((y:ℂ)*I)).re - ((c:ℂ)*p*Q ((y:ℂ)*I)).re
      rw [sinhTest_boundary hω hell]
      apply sub_nonneg.mpr
      refine (Complex.re_le_norm _).trans_eq ?_
      rw [norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hc,hp,mul_one]
      dsimp only [Q,c]
      rw [norm_pow]
    have h := re_nonneg_of_imag_axis hFd hFm hFi hz
    change 0 ≤ (laplace f z-(c:ℂ)*p*Q z).re at h
    rw [mul_assoc,hpQ,Complex.sub_re,←Complex.ofReal_mul,Complex.ofReal_re] at h
    dsimp only [Q] at h
    rw [norm_pow] at h
    exact sub_nonneg.mp h

end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzNumerics

open Complex

noncomputable section

def rationalZeroKernel (b : ℝ) (z : ℂ) : ℂ :=
  1/((b:ℂ)+z)+(b:ℂ)/((b:ℂ)+z)^2+(((2*b^2/3):ℝ):ℂ)/((b:ℂ)+z)^3

def realRationalZeroKernel (b x : ℝ) : ℝ :=
  1/(b+x)+b/(b+x)^2+(2*b^2/3)/(b+x)^3

private theorem rationalZeroKernel_re_formula {b x t : ℝ} (h : 0 < b+x) :
    let u := b+x
    let v := t^2
    (rationalZeroKernel b ((x:ℂ)+(t:ℂ)*I)).re =
      (u^5+b*u^4+(2*b^2/3)*u^3+2*u*(u^2-b^2)*v+(u-b)*v^2)/(u^2+v)^3 := by
  dsimp only
  let u := b+x
  let w : ℂ := (u:ℂ)+(t:ℂ)*I
  have hw₁ : (b:ℂ)+((x:ℂ)+(t:ℂ)*I)=w := by simp only [w,u,Complex.ofReal_add]; ring
  have hwR : w.re=u := by simp [w,Complex.mul_re]
  have hwI : w.im=t := by simp [w,Complex.mul_im]
  have hwN : Complex.normSq w = u^2+t^2 := by rw [Complex.normSq_apply,hwR,hwI]; ring
  have hd : u^2+t^2 ≠ 0 := (add_pos_of_pos_of_nonneg (sq_pos_of_pos h) (sq_nonneg _)).ne'
  have hwSum : w⁻¹ = (((u/(u^2+t^2)):ℝ):ℂ)+(((-t/(u^2+t^2)):ℝ):ℂ)*I := by
    apply Complex.ext
    · rw [Complex.inv_re,hwR,hwN]
      simp only [Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
        Complex.I_re,Complex.I_im,mul_zero,zero_mul,sub_zero,add_zero]
    · rw [Complex.inv_im,hwI,hwN]
      simp only [Complex.add_im,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,
        Complex.I_re,Complex.I_im,mul_zero,zero_mul,mul_one,zero_add,add_zero]
  change _ = (u^5+b*u^4+(2*b^2/3)*u^3+2*u*(u^2-b^2)*t^2+(u-b)*(t^2)^2)/(u^2+t^2)^3
  simp only [rationalZeroKernel,hw₁,div_eq_mul_inv,one_mul,← inv_pow,hwSum]
  simp only [pow_succ,pow_zero,one_mul,Complex.add_re,Complex.add_im,Complex.mul_re,Complex.mul_im,
    Complex.ofReal_re,Complex.ofReal_im,Complex.I_re,Complex.I_im,
    zero_mul,mul_zero,zero_add,add_zero,sub_zero,mul_one]
  field_simp [hd]
  ring

theorem realRationalZeroKernel_pos {b x : ℝ} (hb : 0 < b) (hx : 0 < b+x) :
    0 < realRationalZeroKernel b x := by
  unfold realRationalZeroKernel
  positivity

private theorem realRationalZeroKernel_value {b x : ℝ} (h : 0 < b+x) :
    realRationalZeroKernel b x*(b+x)^6 = (b+x)^5+b*(b+x)^4+(2*b^2/3)*(b+x)^3 := by
  unfold realRationalZeroKernel
  field_simp [h.ne'] <;> ring

private theorem rationalZeroKernel_ratio {b x t : ℝ} (hb : 0 < b) (h : 0 < b+x) :
    let u := b+x
    let v := t^2
    (rationalZeroKernel b ((x:ℂ)+(t:ℂ)*I)).re/realRationalZeroKernel b x =
      (u^2/(u^2+v))^3+
        (2*u*(u^2-b^2)*v+(u-b)*v^2)/((u^2+v)^3*realRationalZeroKernel b x) := by
  dsimp only
  rw [rationalZeroKernel_re_formula h,← realRationalZeroKernel_value h]
  have hd : (b+x)^2+t^2 ≠ 0 := (add_pos_of_pos_of_nonneg (sq_pos_of_pos h) (sq_nonneg _)).ne'
  have hF : realRationalZeroKernel b x ≠ 0 := (realRationalZeroKernel_pos hb h).ne'
  field_simp [hd,hF]
  ring

private theorem fraction_sq_mono {a b t : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    (a^2/(a^2+t^2))^3 ≤ (b^2/(b^2+t^2))^3 := by
  have hb := ha.trans_le hab
  have hA := add_pos_of_pos_of_nonneg (sq_pos_of_pos ha) (sq_nonneg t)
  have hB := add_pos_of_pos_of_nonneg (sq_pos_of_pos hb) (sq_nonneg t)
  apply pow_le_pow_left₀ (by positivity) _ 3
  apply (div_le_div_iff₀ hA hB).mpr
  have hh := mul_le_mul_of_nonneg_right (pow_le_pow_left₀ ha.le hab 2) (sq_nonneg t)
  nlinarith only [hh]

/-- Exact normalized transform comparison for a positive and a negative real shift. -/
theorem rationalZeroKernel_normalized_comparison {b a x t : ℝ}
    (hb : 0 < b) (ha : 0 ≤ a) (hx : x ≤ 0) (hbx : 0 < b+x) :
    (rationalZeroKernel b ((x:ℂ)+(t:ℂ)*I)).re/realRationalZeroKernel b x ≤
      (rationalZeroKernel b ((a:ℂ)+(t:ℂ)*I)).re/realRationalZeroKernel b a := by
  have hba : 0 < b+a := add_pos_of_pos_of_nonneg hb ha
  rw [rationalZeroKernel_ratio hb hbx,rationalZeroKernel_ratio hb hba]
  have hL := (realRationalZeroKernel_pos hb hbx).le
  have hR := (realRationalZeroKernel_pos hb hba).le
  have hLeft : (2*(b+x)*((b+x)^2-b^2)*t^2+((b+x)-b)*(t^2)^2) /
      (((b+x)^2+t^2)^3*realRationalZeroKernel b x) ≤ 0 := by
    have hs : (b+x)^2 ≤ b^2 := pow_le_pow_left₀ hbx.le (by linarith only [hx]) 2
    have h1 : 2*(b+x)*((b+x)^2-b^2)*t^2 ≤ 0 :=
      mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos (by positivity) (sub_nonpos.mpr hs)) (sq_nonneg _)
    have h2 : ((b+x)-b)*(t^2)^2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (by linarith only [hx]) (sq_nonneg _)
    exact div_nonpos_of_nonpos_of_nonneg (add_nonpos h1 h2) (by positivity)
  have hRight : 0 ≤ (2*(b+a)*((b+a)^2-b^2)*t^2+((b+a)-b)*(t^2)^2) /
      (((b+a)^2+t^2)^3*realRationalZeroKernel b a) := by
    have hs : b^2 ≤ (b+a)^2 := pow_le_pow_left₀ hb.le (by linarith only [ha]) 2
    have h1 : 0 ≤ 2*(b+a)*((b+a)^2-b^2)*t^2 :=
      mul_nonneg (mul_nonneg (by positivity) (sub_nonneg.mpr hs)) (sq_nonneg _)
    have h2 : 0 ≤ ((b+a)-b)*(t^2)^2 := mul_nonneg (by linarith only [ha]) (sq_nonneg _)
    exact div_nonneg (add_nonneg h1 h2) (by positivity)
  exact (add_le_of_nonpos_right hLeft).trans
    ((fraction_sq_mono hbx (by linarith only [ha,hx])).trans (le_add_of_nonneg_right hRight))

theorem rationalZeroKernel_re_nonneg {b x t : ℝ} (hb : 0 < b) (hx : 0 ≤ x) :
    0 ≤ (rationalZeroKernel b ((x:ℂ)+(t:ℂ)*I)).re := by
  have h := add_pos_of_pos_of_nonneg hb hx
  rw [rationalZeroKernel_re_formula h]
  have hs : (b:ℝ)^2 ≤ (b+x)^2 := pow_le_pow_left₀ hb.le (le_add_of_nonneg_right hx) 2
  have hsub : 0 ≤ (b+x)-b := by linarith only [hx]
  have hsq : 0 ≤ (b+x)^2-b^2 := sub_nonneg.mpr hs
  positivity

end
end GoldbachPintzNumerics
end

