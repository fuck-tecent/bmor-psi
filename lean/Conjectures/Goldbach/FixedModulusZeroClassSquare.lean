namespace GoldbachBurgessPrimePower

open GoldbachBurgess

theorem norm_balanced_odd_prime_power_le_firstCount {p k : ℕ} (hp : p.Prime)
    (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k+1))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ) :
    let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
    ‖completeBalancedCorrelation χ c‖ ≤ (p:ℝ)^k*p*(criticalCount p k k c:ℝ) := by
  let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  have h := @norm_balanced_prime_power_le_criticalCount p (k+1) k hp hk (by omega)
  rw [show k+1+k=k+k+1 by omega] at h
  specialize h χ hχ c
  simpa only [criticalCount_more_digits,Nat.cast_pow,mul_assoc] using h

theorem norm_balanced_even_prime_power_sqrt_gcd {p k : ℕ} [Fact p.Prime]
    (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ)
    (hD : (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)≠0) :
    let _ : NeZero (p^(k+k)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let D := (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)
    ‖completeBalancedCorrelation χ c‖ ≤ 4*Real.sqrt ((p:ℝ)^(k+k))*Real.sqrt (Nat.gcd (p^(k+k)) D.natAbs) := by
  let _ : NeZero (p^(k+k)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  dsimp only
  let D := (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)
  let G := Real.sqrt (Nat.gcd (p^(k+k)) D.natAbs)
  have h := norm_balanced_even_prime_power_discriminant hk χ hχ c hD
  have hv := primePower_pow_min_loss_le (p:=p) (ν:=k+k) (k:=k) (j:=0) (D:=D) (by omega)
  have h' : (p:ℝ)^(min k (padicValInt p D/2+padicValInt p (2:ℤ)))≤2*G := by
    simpa only [G,pow_zero,Real.sqrt_one,mul_one] using hv
  rw [sqrt_primePower_even]
  change ‖completeBalancedCorrelation χ c‖≤4*(p:ℝ)^k*G
  refine h.trans ?_
  calc
    _ ≤ (2*(p:ℝ)^k)*(2*G) := mul_le_mul_of_nonneg_left h' (by positivity)
    _ = _ := by ring

theorem norm_balanced_odd_prime_power_sqrt_gcd {p k : ℕ} [Fact p.Prime]
    (hk : 0<k) (χ : DirichletCharacter ℂ (p^(k+k+1))) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ)
    (hD : (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)≠0) :
    let _ : NeZero (p^(k+k+1)) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let D := (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)
    ‖completeBalancedCorrelation χ c‖≤8*Real.sqrt ((p:ℝ)^(k+k+1))*Real.sqrt (Nat.gcd (p^(k+k+1)) D.natAbs) := by
  let hp : p.Prime := Fact.out
  let q := p^(k+k+1)
  let _ : NeZero q := ⟨pow_ne_zero _ hp.ne_zero⟩
  dsimp only
  let D := (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)
  let G := Real.sqrt (Nat.gcd q D.natAbs)
  have h₁ : (criticalCount p k k c:ℝ)≤4*G := by
    refine (criticalCount_le_discriminant c hD).trans ?_
    have hv := primePower_pow_min_loss_le (p:=p) (ν:=k+k+1) (k:=k) (j:=0) (D:=D) (by omega)
    have hv' : (p:ℝ)^(min k (padicValInt p D/2+padicValInt p (2:ℤ)))≤2*G := by
      simpa only [G,pow_zero,Real.sqrt_one,mul_one] using hv
    simpa only [←mul_assoc,show (2:ℝ)*2=4 by norm_num] using
      mul_le_mul_of_nonneg_left hv' (by norm_num : (0:ℝ)≤2)
  have h₂ : (criticalCount p (k+1) (k+1) c:ℝ)≤4*Real.sqrt p*G := by
    refine (criticalCount_le_discriminant c hD).trans ?_
    have hv := primePower_pow_min_loss_le (p:=p) (ν:=k+k+1) (k:=k+1) (j:=1) (D:=D) (by omega)
    have hv' : (p:ℝ)^(min (k+1) (padicValInt p D/2+padicValInt p (2:ℤ)))≤2*Real.sqrt p*G := by
      simpa only [G,pow_one] using hv
    simpa only [←mul_assoc,show (2:ℝ)*2=4 by norm_num] using
      mul_le_mul_of_nonneg_left hv' (by norm_num : (0:ℝ)≤2)
  rw [sqrt_primePower_odd]
  change ‖completeBalancedCorrelation χ c‖≤8*((p:ℝ)^k*Real.sqrt p)*G
  by_cases hp2 : p=2
  · refine (norm_balanced_odd_prime_power_le_firstCount hp hk χ hχ c).trans ?_
    have hs : (1:ℝ)≤Real.sqrt p := by
      rw [←Real.sqrt_one]
      exact Real.sqrt_le_sqrt (by exact_mod_cast hp.one_lt.le)
    have hpp : (p:ℝ)≤2*Real.sqrt p := by
      simp only [hp2,Nat.cast_ofNat] at hs ⊢
      linarith only [hs]
    calc
      _ ≤ ((p:ℝ)^k*p)*(4*G) := mul_le_mul_of_nonneg_left h₁ (by positivity)
      _ = ((p:ℝ)^k*(4*G))*p := by ring
      _ ≤ ((p:ℝ)^k*(4*G))*(2*Real.sqrt p) := mul_le_mul_of_nonneg_left hpp (by positivity)
      _ = _ := by ring
  · refine (norm_balanced_odd_prime_power_le_supportedCounts hp2 hk χ hχ c).trans ?_
    have h₁' := (show (supportedCriticalCount p q k k c:ℝ)≤criticalCount p k k c by
        exact_mod_cast supportedCriticalCount_le_criticalCount p q k k c).trans h₁
    have h₂' := (show (supportedCriticalCount p q (k+1) (k+1) c:ℝ)≤criticalCount p (k+1) (k+1) c by
        exact_mod_cast supportedCriticalCount_le_criticalCount p q (k+1) (k+1) c).trans h₂
    calc
      _ ≤ (p:ℝ)^k*(Real.sqrt p*(4*G)+(4*Real.sqrt p)*G) :=
        mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left h₁' (Real.sqrt_nonneg _)) h₂') (by positivity)
      _ = _ := by ring

theorem norm_balanced_prime_power_sqrt_gcd {p ν : ℕ} [Fact p.Prime]
    (hν : 2≤ν) (χ : DirichletCharacter ℂ (p^ν)) (hχ : χ.IsPrimitive)
    (c : Fin 4 → ℤ)
    (hD : (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)≠0) :
    let _ : NeZero (p^ν) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
    let D := (c 0-c 2)*(c 0-c 3)*(c 1-c 2)*(c 1-c 3)
    ‖completeBalancedCorrelation χ c‖≤8*Real.sqrt ((p:ℝ)^ν)*Real.sqrt (Nat.gcd (p^ν) D.natAbs) := by
  let _ : NeZero (p^ν) := ⟨pow_ne_zero _ (Fact.out : p.Prime).ne_zero⟩
  dsimp only
  rcases Nat.even_or_odd ν with ⟨k,hk⟩ | ⟨k,hk⟩
  · have hk' : 0<k := by omega
    have he : ν=k+k := by omega
    clear hk
    subst ν
    refine (norm_balanced_even_prime_power_sqrt_gcd hk' χ hχ c hD).trans ?_
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
      (by norm_num : (4:ℝ)≤8) (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)
  · have hk' : 0<k := by omega
    have he : ν=k+k+1 := by omega
    clear hk
    subst ν
    exact norm_balanced_odd_prime_power_sqrt_gcd hk' χ hχ c hD

end GoldbachBurgessPrimePower
end

section
namespace GoldbachBurgess

open Finset GoldbachQuadraticCorrelation
open scoped Classical

/-- The integer differences in the local correlation bound are the natural
displacements in the averaging box, even for the negative offset convention. -/
theorem of_integer_solitary_gcd {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (M : ℝ)
    (hCorr : ∀ a : Fin 4→ℤ, (∃ i : Fin 4, ∀ j : Fin 4,j≠i → a j≠a i) →
      ∃ i : Fin 4, (∀ j : Fin 4,j≠i → a j≠a i) ∧ ‖completeBalancedCorrelation χ a‖ ≤
        M*(q.gcd ((∏ j∈(univ:Finset (Fin 4)).erase i,(a i-a j)).natAbs):ℝ)) :
    ∀ a : Fin 4→ℕ, (∃ i,solitary a i) →
      ∃ i, solitary a i ∧ ‖completeBalancedCorrelation χ (fun j=>-((a j+1:ℕ):ℤ))‖ ≤
        M*(q.gcd (∏ j∈(univ:Finset (Fin 4)).erase i,Nat.dist (a i) (a j)):ℝ) := by
  intro a hA
  let R (i : Fin 4) : ℤ := -((a i+1:ℕ):ℤ)
  have hR (i : Fin 4) : (∀ j : Fin 4,j≠i → R j≠R i) ↔ solitary a i := by
    constructor
    · intro h j hji he
      apply h j hji
      simp only [R,he]
    · intro h j hji he
      apply h j hji
      dsimp only [R] at he
      omega
  obtain ⟨i,hi⟩ := hA
  obtain ⟨i,hi,hCorr⟩ := hCorr R ⟨i,(hR i).mpr hi⟩
  refine ⟨i,(hR i).mp hi,?_⟩
  have he : (∏ j∈(univ:Finset (Fin 4)).erase i, (R i-R j)).natAbs =
      ∏ j∈(univ:Finset (Fin 4)).erase i,Nat.dist (a i) (a j) := by
    have hAbs (S : Finset (Fin 4)) :
        (∏ j∈S, (R i-R j)).natAbs = ∏ j∈S,(R i-R j).natAbs := by
      induction S using Finset.induction_on with
      | empty => simp
      | insert j S hj ih => simp only [prod_insert hj,Int.natAbs_mul,ih]
    exact (hAbs _).trans (prod_congr rfl (fun j _=>natAbs_negative_offsets (a i) (a j)))
  rwa [he] at hCorr

end GoldbachBurgess
end

section
/-!
The divisor estimates are adapted from Eric Naslund, `GradedNear/BurgessReduction.lean`
(https://github.com/enaslund/linniks-constant-3.99/blob/ecdbe3e3e08ad499d2c749ff417cc461f57334c5/GradedNear/BurgessReduction.lean).
-/

namespace GoldbachBurgessPrefix

noncomputable section

/-- One prime-power factor of the divisor bound: `a + 1 ≤ M_p (p^ε)^a`, where `M_p = 1` for
`p ≥ K ≥ 2^{1/ε}` and `M_p = max 1 (1/(2^ε - 1))` for `p < K`. -/
private lemma divisor_factor_le {ε : ℝ} (hε : 0 < ε) {K : ℕ} (hK : (2 : ℝ) ^ (1 / ε) ≤ K)
    {p : ℕ} (hp : p.Prime) (a : ℕ) :
    (a : ℝ) + 1 ≤
      (if p < K then max 1 (1 / ((2 : ℝ) ^ ε - 1)) else 1) * ((p : ℝ) ^ ε) ^ a := by
  have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  split_ifs with hpK
  · set b : ℝ := (2 : ℝ) ^ ε with hb
    have hb1 : 1 < b := Real.one_lt_rpow (by norm_num) hε
    have hbp : b ≤ (p : ℝ) ^ ε := Real.rpow_le_rpow (by norm_num) hp2 hε.le
    set M := max 1 (1 / (b - 1)) with hM
    have hM1 : 1 ≤ M := le_max_left _ _
    have hb' : 0 < b - 1 := by linarith
    have hMb : 1 ≤ M * (b - 1) := by
      have h1 : 1 / (b - 1) ≤ M := le_max_right _ _
      calc (1 : ℝ) = 1 / (b - 1) * (b - 1) := by field_simp
        _ ≤ M * (b - 1) := by gcongr
    have hbern : 1 + (a : ℝ) * (b - 1) ≤ b ^ a := by
      have h := one_add_mul_le_pow (show (-2 : ℝ) ≤ b - 1 by linarith) a
      simpa using h
    have ha : (0 : ℝ) ≤ a := Nat.cast_nonneg a
    calc (a : ℝ) + 1 ≤ M * (1 + a * (b - 1)) := by
          nlinarith [mul_nonneg ha (sub_nonneg.mpr hMb)]
      _ ≤ M * b ^ a := by gcongr
      _ ≤ M * ((p : ℝ) ^ ε) ^ a := by gcongr
  · have hpK' : K ≤ p := not_lt.mp hpK
    have h2 : (2 : ℝ) ≤ (p : ℝ) ^ ε := by
      calc (2 : ℝ) = ((2 : ℝ) ^ (1 / ε)) ^ ε := by
            rw [← Real.rpow_mul (by norm_num), one_div_mul_cancel hε.ne', Real.rpow_one]
        _ ≤ (p : ℝ) ^ ε := by
            apply Real.rpow_le_rpow (by positivity) _ hε.le
            exact hK.trans (by exact_mod_cast hpK')
    calc (a : ℝ) + 1 ≤ 2 ^ a := by
          have h := one_add_mul_le_pow (show (-2 : ℝ) ≤ 1 by norm_num) a
          norm_num at h
          linarith
      _ ≤ ((p : ℝ) ^ ε) ^ a := by gcongr
      _ = 1 * ((p : ℝ) ^ ε) ^ a := (one_mul _).symm

/-- The divisor bound `τ(n) ≪_ε n^ε`. -/
theorem card_divisors_le_rpow {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, n ≠ 0 → (n.divisors.card : ℝ) ≤ C * (n : ℝ) ^ ε := by
  set K : ℕ := ⌈(2 : ℝ) ^ (1 / ε)⌉₊
  have hK : (2 : ℝ) ^ (1 / ε) ≤ K := Nat.le_ceil _
  set M : ℝ := max 1 (1 / ((2 : ℝ) ^ ε - 1)) with hM
  have hM1 : 1 ≤ M := le_max_left _ _
  refine ⟨M ^ K, by positivity, fun n hn => ?_⟩
  set g : ℕ → ℝ := fun p => if p < K then M else 1 with hg
  have hτ : (n.divisors.card : ℝ) = ∏ p ∈ n.primeFactors, ((n.factorization p : ℝ) + 1) := by
    rw [Nat.card_divisors hn]
    push_cast
    rfl
  have hn' : (n : ℝ) ^ ε = ∏ p ∈ n.primeFactors, ((p : ℝ) ^ ε) ^ (n.factorization p) := by
    conv_lhs => rw [Nat.prod_primeFactors_pow_factorization hn]
    push_cast
    rw [← Real.finsetProd_rpow _ _ (fun p _ => by positivity)]
    refine Finset.prod_congr rfl fun p _ => ?_
    rw [Real.rpow_pow_comm (by positivity)]
  have hgK : ∏ p ∈ n.primeFactors, g p ≤ M ^ K := by
    have h1 : ∏ p ∈ n.primeFactors, g p = M ^ (n.primeFactors.filter (· < K)).card := by
      simp only [hg]
      rw [Finset.prod_ite, Finset.prod_const_one, mul_one, Finset.prod_const]
    rw [h1]
    apply pow_le_pow_right₀ hM1
    calc (n.primeFactors.filter (· < K)).card ≤ (Finset.range K).card := by
          apply Finset.card_le_card
          intro p hp
          simp only [Finset.mem_filter] at hp
          simpa using hp.2
      _ = K := Finset.card_range K
  calc (n.divisors.card : ℝ) = ∏ p ∈ n.primeFactors, ((n.factorization p : ℝ) + 1) := hτ
    _ ≤ ∏ p ∈ n.primeFactors, (g p * ((p : ℝ) ^ ε) ^ (n.factorization p)) := by
        apply Finset.prod_le_prod₀ (fun p _ => by positivity)
        intro p hp
        exact divisor_factor_le hε hK (Nat.prime_of_mem_primeFactors hp) _
    _ = (∏ p ∈ n.primeFactors, g p) * (n : ℝ) ^ ε := by rw [Finset.prod_mul_distrib, hn']
    _ ≤ M ^ K * (n : ℝ) ^ ε := by gcongr

end

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgess

open Finset GoldbachQuadraticCorrelation GoldbachBurgessPrefix
open scoped Classical

theorem pow_card_primeFactors_le_card_divisors {q : ℕ} (hq : q≠0) :
    2^q.primeFactors.card≤q.divisors.card := by
  rw [Nat.card_divisors hq,←Finset.prod_const]
  apply prod_le_prod
  intro p hp
  have hn := Nat.Prime.factorization_pos_of_dvd (Nat.prime_of_mem_primeFactors hp) hq (Nat.dvd_of_mem_primeFactors hp)
  omega

/-- Absorb the product of bounded local constants and the three divisor
charges into the usual arbitrary Burgess epsilon. -/
theorem fourthMoment_burgess_le_of_solitary_gcd (K : ℕ)
    (hCorr : ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ.IsPrimitive →
      ∀ a : Fin 4→ℕ, (∃ i,solitary a i) →
      ∃ i, solitary a i ∧ ‖completeBalancedCorrelation χ (fun j=>-((a j+1:ℕ):ℤ))‖ ≤
        (((2:ℝ)^K)^q.primeFactors.card*Real.sqrt q)*
          (q.gcd (∏ j∈(univ:Finset (Fin 4)).erase i,Nat.dist (a i) (a j)):ℝ))
    {ε : ℝ} (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ.IsPrimitive → ∀ B : ℕ,
      (∑ x : ZMod q,‖shortSum χ B x‖^4) ≤ C*(q:ℝ)^ε*
        ((q:ℝ)*(B:ℝ)^2+Real.sqrt q*(B:ℝ)^4) := by
  let m := K+3
  have hm : (0:ℝ) < m := by dsimp only [m]; positivity
  obtain ⟨D,hD,hτ⟩ := card_divisors_le_rpow (div_pos hε hm)
  let C := 3+32*D^m
  refine ⟨C,by dsimp [C]; positivity,?_⟩
  intro q hq χ hχ B
  let _ : NeZero q := hq
  let M := ((2:ℝ)^K)^q.primeFactors.card*Real.sqrt q
  let T : ℝ := q.divisors.card
  let e := (q:ℝ)^ε
  have hMain := fourthMoment_le_of_solitary_gcd χ B (M:=M) (by dsimp only [M]; positivity)
    (hCorr q χ hχ)
  have hR : (2:ℝ)^q.primeFactors.card≤T := by
    have h : ((2^q.primeFactors.card:ℕ):ℝ)≤(q.divisors.card:ℝ) :=
      Nat.cast_le.mpr (pow_card_primeFactors_le_card_divisors (NeZero.ne q))
    simpa only [T,Nat.cast_pow,Nat.cast_ofNat] using h
  have hK : ((2:ℝ)^K)^q.primeFactors.card≤T^K := by
    rw [←pow_mul,mul_comm K,pow_mul]
    exact pow_le_pow_left₀ (by positivity) hR _
  have hKT : ((2:ℝ)^K)^q.primeFactors.card*T^3≤T^m := by
    dsimp only [m]
    rw [pow_add]
    exact mul_le_mul_of_nonneg_right hK (by positivity)
  have hDτ : T^m≤D^m*e := by
    have h := pow_le_pow_left₀ (show 0≤T by exact Nat.cast_nonneg _) (hτ q (NeZero.ne q)) m
    rw [mul_pow,←Real.rpow_mul_natCast (by positivity : 0≤(q:ℝ))] at h
    rw [div_mul_cancel₀ _ hm.ne'] at h
    exact h
  have hBig : 1≤e := Real.one_le_rpow (by exact_mod_cast NeZero.pos q) hε.le
  have h₀ : 3≤C*e := by
    have hC : 3≤C := le_add_of_nonneg_right (by positivity)
    exact hC.trans (le_mul_of_one_le_right (by positivity) hBig)
  have h₁ : 32*(M*T^3)≤C*e*Real.sqrt q := by
    have hx := mul_le_mul_of_nonneg_right (hKT.trans hDτ) (Real.sqrt_nonneg q)
    have h := mul_le_mul_of_nonneg_left hx (by norm_num : (0:ℝ)≤32)
    have hC : 32*D^m≤C := le_add_of_nonneg_left (by norm_num)
    have he := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hC (by positivity : 0≤e))
      (Real.sqrt_nonneg q)
    dsimp only [M]
    nlinarith only [h,he]
  refine hMain.trans ?_
  change 3*(q:ℝ)*(B:ℝ)^2+32*M*T^3*(B:ℝ)^4≤C*e*((q:ℝ)*(B:ℝ)^2+Real.sqrt q*(B:ℝ)^4)
  have ha := mul_le_mul_of_nonneg_right h₀ (show 0≤(q:ℝ)*(B:ℝ)^2 by positivity)
  have hb := mul_le_mul_of_nonneg_right h₁ (show 0≤(B:ℝ)^4 by positivity)
  nlinarith only [ha,hb]

end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Finset GoldbachBurgessPrefix GoldbachBurgessPrimePower
open scoped Classical ArithmeticFunction.omega

private theorem rootDiffProduct_eq_natAbs (a : Fin 4 → ℤ) (i : Fin 4) :
    rootDiffProduct a i=((∏ j ∈ (univ : Finset (Fin 4)).erase i, (a i-a j))).natAbs := by
  have h (S : Finset (Fin 4)) : (∏ j ∈ S,(a i-a j).natAbs)=((∏ j ∈ S,(a i-a j))).natAbs := by
    induction S using Finset.induction_on with
    | empty => simp
    | insert j S hj ih => simp only [prod_insert hj,Int.natAbs_mul,ih]
  exact h _

theorem norm_completeBalancedCorrelation_of_isolated {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) (a : Fin 4 → ℤ)
    (ha : ∃ i, isolated a i) :
    ∃ i, isolated a i ∧ ‖completeBalancedCorrelation χ a‖≤
      (8:ℝ)^(ω q)*Real.sqrt q*(q.gcd (rootDiffProduct a i)) := by
  apply norm_completeBalancedCorrelation_of_isolated_of_local χ hχ a ha
  · intro p k hp hk _ ξ hξ c hD
    letI : Fact p.Prime := ⟨hp⟩
    simpa only [Nat.cast_pow,discriminantProduct] using
      norm_balanced_prime_power_sqrt_gcd hk ξ hξ c hD
  · intro p k hp hk _ ξ hξ c hc
    letI : Fact p.Prime := ⟨hp⟩
    simpa only [Nat.cast_pow,leftoverDifference] using
      norm_balanced_prime_power_shared hk ξ hξ c hc

/-- The fourth moment of arbitrary primitive Dirichlet character short sums
with Burgess's square-root off-diagonal dependence. -/
theorem primitive_fourth_moment_burgess {ε : ℝ} (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ.IsPrimitive → ∀ B : ℕ,
      (∑ x : ZMod q,‖shortSum χ B x‖^4) ≤ C*(q:ℝ)^ε*
        ((q:ℝ)*(B:ℝ)^2+Real.sqrt q*(B:ℝ)^4) := by
  refine fourthMoment_burgess_le_of_solitary_gcd 3 ?_ hε
  intro q _ χ hχ
  apply of_integer_solitary_gcd χ
  intro a ha
  obtain ⟨i,hi,hn⟩ := norm_completeBalancedCorrelation_of_isolated χ hχ a ha
  exact ⟨i,hi,by simpa only [rootDiffProduct_eq_natAbs,ArithmeticFunction.cardDistinctFactors_eq_card_primeFactors,
    show (2:ℝ)^3=8 by norm_num] using hn⟩

end GoldbachBurgess
end

section
namespace GoldbachBurgessPrefix

noncomputable section

/-- Unrounded shift length balancing the two direct Burgess terms. -/
def burgessShiftScale (q N : ℕ) : ℝ := (N:ℝ)^(3/5:ℝ)*(q:ℝ)^(-(1/10):ℝ)

def burgessBlockLength (q : ℕ) : ℕ := ⌊(q:ℝ)^(1/4:ℝ)⌋₊

def burgessShiftLength (q N : ℕ) : ℕ := ⌊burgessShiftScale q N/2⌋₊

set_option maxHeartbeats 700000 in
/-- The rounded parameters preserve the Burgess powers and no-wrap
condition throughout the middle initial segment range. -/
theorem burgess_middle_scale {q N : ℕ} (hq : 65536≤q)
    (hNlo : (q:ℝ)^(3/8:ℝ)≤N) (hNhi : (N:ℝ)≤(q:ℝ)^(5/8:ℝ)) :
    let V := burgessShiftLength q N
    let B := burgessBlockLength q
    (q:ℝ)^(1/4:ℝ)/2≤(B:ℝ) ∧ (B:ℝ)≤(q:ℝ)^(1/4:ℝ) ∧
    burgessShiftScale q N/4≤(V:ℝ) ∧ (V:ℝ)≤burgessShiftScale q N/2 ∧
    V*N<q ∧ 1≤V ∧ 1≤B ∧ (q:ℝ)^(1/8:ℝ)/4≤(V:ℝ) := by
  intro V B
  have hqN : (65536:ℝ)≤q := by exact_mod_cast hq
  have hq1 : (1:ℝ)≤q := (by norm_num : (1:ℝ)≤65536).trans hqN
  have hq0 : (0:ℝ)<q := zero_lt_one.trans_le hq1
  have hN0 : (0:ℝ)<N := (Real.rpow_pos_of_pos hq0 _).trans_le hNlo
  have hqroot : (4:ℝ)≤(q:ℝ)^(1/8:ℝ) := calc
    (4:ℝ) = ((4:ℝ)^(8:ℕ))^(1/8:ℝ) := by
      rw [show (1/8:ℝ)=((8:ℕ):ℝ)⁻¹ by norm_num,
        Real.pow_rpow_inv_natCast (by norm_num) (by norm_num)]
    _ ≤ _ := Real.rpow_le_rpow (by positivity) (by norm_num; exact hq) (by norm_num)
  have hqB : (4:ℝ)≤(q:ℝ)^(1/4:ℝ) :=
    hqroot.trans (Real.rpow_le_rpow_of_exponent_le hq1 (by norm_num))
  have hScaleLo : (q:ℝ)^(1/8:ℝ)≤burgessShiftScale q N := by
    unfold burgessShiftScale
    calc
      _ = (((q:ℝ)^(3/8:ℝ))^(3/5:ℝ))*(q:ℝ)^(-(1/10):ℝ) := by
        rw [←Real.rpow_mul hq0.le,←Real.rpow_add hq0]
        congr 1
        norm_num
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (Real.rpow_le_rpow (by positivity) hNlo (by norm_num)) (by positivity)
  have hScaleHi : burgessShiftScale q N≤(q:ℝ)^(3/8:ℝ) := by
    unfold burgessShiftScale
    calc
      _ ≤ (((q:ℝ)^(5/8:ℝ))^(3/5:ℝ))*(q:ℝ)^(-(1/10):ℝ) :=
        mul_le_mul_of_nonneg_right (Real.rpow_le_rpow hN0.le hNhi (by norm_num)) (by positivity)
      _ = (q:ℝ)^(11/40:ℝ) := by
        rw [←Real.rpow_mul hq0.le,←Real.rpow_add hq0]
        congr 1
        norm_num
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hq1 (by norm_num)
  have hBup : (B:ℝ)≤(q:ℝ)^(1/4:ℝ) := Nat.floor_le (by positivity)
  have hBdown : (q:ℝ)^(1/4:ℝ)/2≤(B:ℝ) := by
    have hF := Nat.lt_floor_add_one ((q:ℝ)^(1/4:ℝ))
    change (q:ℝ)^(1/4:ℝ)<(B:ℝ)+1 at hF
    linarith only [hqB,hF]
  have hVup : (V:ℝ)≤burgessShiftScale q N/2 := Nat.floor_le (by
    unfold burgessShiftScale
    positivity)
  have hScale4 := hqroot.trans hScaleLo
  have hVdown : burgessShiftScale q N/4≤(V:ℝ) := by
    have hF := Nat.lt_floor_add_one (burgessShiftScale q N/2)
    change burgessShiftScale q N/2<(V:ℝ)+1 at hF
    linarith only [hScale4,hF]
  have hVN : (V:ℝ)*(N:ℝ)<q := calc
    _ ≤ ((q:ℝ)^(3/8:ℝ)/2)*(q:ℝ)^(5/8:ℝ) :=
      mul_le_mul (hVup.trans (div_le_div_of_nonneg_right hScaleHi (by norm_num))) hNhi
        hN0.le (by positivity)
    _ = (q:ℝ)/2 := by
      rw [div_mul_eq_mul_div,←Real.rpow_add hq0,show (3/8:ℝ)+5/8=1 by norm_num,Real.rpow_one]
    _ < _ := by linarith only [hq0]
  have hV1 : (1:ℝ)≤V := by linarith only [hScale4,hVdown]
  have hB1 : (1:ℝ)≤B := by linarith only [hqB,hBdown]
  exact ⟨hBdown,hBup,hVdown,hVup,by exact_mod_cast hVN,by exact_mod_cast hV1,by exact_mod_cast hB1,
    (div_le_div_of_nonneg_right hScaleLo (by norm_num)).trans hVdown⟩

end

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgessPrefix

open Finset ArithmeticFunction
open scoped Classical

noncomputable section

/-- Positive shift multipliers coprime to the modulus. -/
def coprimePrefix (q V : ℕ) : Finset ℕ :=
  (Icc 1 V).filter (fun v => q.Coprime v)

private theorem card_eq_sum_ones (S : Finset ℕ) : (S.card:ℝ)=∑ _∈S,(1:ℝ) := by simp

private theorem multiple_count {d V : ℕ} (hd : 0 < d) :
    (((Icc 1 V).filter (fun n => d∣n)).card:ℝ)=(V/d:ℕ) := by
  have he : (∑ k∈Icc 1 (V/d), (1:ℝ)) =
      ∑ n∈(Icc 1 V).filter (fun n => d∣n), (1:ℝ) := by
    refine Finset.sum_bij (fun k _=>k*d) ?_ ?_ ?_ ?_
    · intro k hk
      obtain ⟨h₁,h₂⟩ := mem_Icc.mp hk
      exact mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.mul_pos h₁ hd,
        (Nat.le_div_iff_mul_le hd).mp h₂⟩,dvd_mul_left d k⟩
    · intro a _ b _ h
      exact Nat.eq_of_mul_eq_mul_right hd h
    · intro n hn
      obtain ⟨hnI,hnD⟩ := mem_filter.mp hn
      refine ⟨n/d, mem_Icc.mpr ⟨?_,Nat.div_le_div_right (mem_Icc.mp hnI).2⟩,
        Nat.div_mul_cancel hnD⟩
      exact (Nat.le_div_iff_mul_le hd).mpr (by simpa using Nat.le_of_dvd (mem_Icc.mp hnI).1 hnD)
    · intros
      rfl
  simpa [Nat.card_Icc] using he.symm

private theorem coprimeIndicator {q n : ℕ} (hq : 0 < q) :
    (if q.Coprime n then (1:ℝ) else 0) =
      ∑ d∈q.divisors, if d∣n then (moebius d:ℝ) else 0 := by
  have hF : q.divisors.filter (fun d=>d∣n)=(q.gcd n).divisors := by
    ext d
    rw [mem_filter,Nat.mem_divisors,Nat.mem_divisors]
    have hpos : 0<q.gcd n := Nat.gcd_pos_of_pos_left n hq
    simp [hq.ne',hpos.ne',Nat.dvd_gcd_iff]
  have hM : (∑ d∈(q.gcd n).divisors,(moebius d:ℝ)) =
      ((↑zeta : ArithmeticFunction ℝ)*(↑moebius : ArithmeticFunction ℝ)) (q.gcd n) := by
    simpa only [intCoe_apply] using
      (coe_zeta_mul_apply (R:=ℝ) (f:=(↑moebius : ArithmeticFunction ℝ)) (x:=q.gcd n)).symm
  rw [←Finset.sum_filter,hF,hM,coe_zeta_mul_coe_moebius,ArithmeticFunction.one_apply]

/-- Exact Möbius count of the units in a positive initial interval. -/
theorem coprimePrefix_card_eq {q V : ℕ} (hq : 0 < q) :
    ((coprimePrefix q V).card:ℝ)=∑ d∈q.divisors,(moebius d:ℝ)*(V/d:ℕ) := by
  unfold coprimePrefix
  rw [card_eq_sum_ones,Finset.sum_filter]
  simp_rw [coprimeIndicator hq]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro d hd
  rw [←Finset.sum_filter,Finset.sum_const,nsmul_eq_mul,
    multiple_count (Nat.pos_of_mem_divisors hd),mul_comm]

private theorem divisors_moebius_inv_eq_totient {q : ℕ} (hq : 0 < q) :
    (∑ d∈q.divisors,(moebius d:ℝ)/(d:ℝ))=(q.totient:ℝ)/(q:ℝ) := by
  have hF : Icc 1 q=Ico 1 (1+q) := by
    ext n
    simp only [mem_Icc,mem_Ico]
    omega
  have hT : (coprimePrefix q q).card=q.totient := by
    unfold coprimePrefix
    rw [hF,Nat.filter_coprime_Ico_eq_totient]
  have hEq := coprimePrefix_card_eq (V:=q) hq
  rw [hT] at hEq
  rw [hEq,Finset.sum_div]
  apply Finset.sum_congr rfl
  intro d hd
  have hd' : (0:ℝ)<d := by exact_mod_cast Nat.pos_of_mem_divisors hd
  have hdq : ((q/d:ℕ):ℝ)=(q:ℝ)/(d:ℝ) := (eq_div_iff hd'.ne').mpr
    (by exact_mod_cast Nat.div_mul_cancel (Nat.mem_divisors.mp hd).1)
  rw [hdq]
  have hq' : (0:ℝ)<q := by exact_mod_cast hq
  field_simp [hd'.ne',hq'.ne']

/-- The discrepancy from the uniform totient density is at most the
number of divisors of the modulus. -/
theorem coprimePrefix_discrepancy {q V : ℕ} (hq : 0 < q) :
    |((coprimePrefix q V).card:ℝ)-(V:ℝ)*(q.totient:ℝ)/(q:ℝ)|≤(q.divisors.card:ℝ) := by
  rw [mul_div_assoc,←divisors_moebius_inv_eq_totient hq,coprimePrefix_card_eq hq,
    Finset.mul_sum,←Finset.sum_sub_distrib]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  rw [card_eq_sum_ones]
  apply Finset.sum_le_sum
  intro d hd
  have he : ⌊(V:ℝ)/(d:ℝ)⌋₊=V/d := by simp [Nat.floor_div_natCast]
  have hF : |((V/d:ℕ):ℝ)-(V:ℝ)/(d:ℝ)|≤1 := by
    have hlo := Nat.floor_le (show 0≤(V:ℝ)/(d:ℝ) by positivity)
    have hhi := Nat.lt_floor_add_one ((V:ℝ)/(d:ℝ))
    rw [he] at hlo hhi
    refine abs_le.mpr ⟨?_,?_⟩ <;> linarith only [hlo,hhi]
  have hM : |(moebius d:ℝ)|≤1 := by exact_mod_cast (abs_moebius_le_one (n:=d))
  rw [show (moebius d:ℝ)*(V/d:ℕ)-(V:ℝ)*((moebius d:ℝ)/(d:ℝ)) =
    (moebius d:ℝ)*(((V/d:ℕ):ℝ)-(V:ℝ)/(d:ℝ)) by ring,abs_mul]
  exact (mul_le_mul hM hF (abs_nonneg _) (by norm_num : (0:ℝ)≤1)).trans_eq (by norm_num)

theorem coprimePrefix_half_density {q V : ℕ} (hq : 0 < q)
    (hV : 2*(q.divisors.card:ℝ)≤(V:ℝ)*(q.totient:ℝ)/(q:ℝ)) :
    (V:ℝ)*(q.totient:ℝ)/(2*(q:ℝ))≤((coprimePrefix q V).card:ℝ) := by
  have h := (abs_le.mp (coprimePrefix_discrepancy (V:=V) hq)).1
  rw [show (V:ℝ)*(q.totient:ℝ)/(2*(q:ℝ)) =
    ((V:ℝ)*(q.totient:ℝ)/(q:ℝ))/2 by ring]
  linarith only [h,hV]

private theorem totient_density_mul_divisor_count {q : ℕ} (hq : 0 < q) :
    (1:ℝ)≤((q.totient:ℝ)/(q:ℝ))*(q.divisors.card:ℝ) := by
  have hq0 : (0:ℝ)<q := by exact_mod_cast hq
  have hEuler : (q.totient:ℝ)=(q:ℝ)*∏ p∈q.primeFactors,(1-(p:ℝ)⁻¹) := by
    have h := congrArg (fun x : ℚ => (x:ℝ)) (Nat.totient_eq_mul_prod_factors q)
    simpa only [Rat.cast_natCast,Rat.cast_mul,Rat.cast_prod,Rat.cast_sub,Rat.cast_one,Rat.cast_inv] using h
  have hDivisors : (q.divisors.card:ℝ)=∏ p∈q.primeFactors,((q.factorization p:ℝ)+1) := by
    rw [Nat.card_divisors hq.ne']
    push_cast
    rfl
  have hLow (p : ℕ) (h : p∈q.primeFactors) : (1/2:ℝ)≤1-(p:ℝ)⁻¹ := by
    have hp2 : (2:ℝ)≤p := by exact_mod_cast (Nat.prime_of_mem_primeFactors h).two_le
    have hp0 : (0:ℝ)<p := (by norm_num : (0:ℝ)<2).trans_le hp2
    have he := (inv_le_inv₀ hp0 (by norm_num : (0:ℝ)<2)).mpr hp2
    norm_num at he
    linarith only [he]
  have hFactor (p : ℕ) (h : p∈q.primeFactors) : (2:ℝ)≤(q.factorization p:ℝ)+1 := by
    obtain ⟨hp,hpq,_⟩ := Nat.mem_primeFactors.mp h
    have hl : 1≤q.factorization p := hp.factorization_pos_of_dvd hq.ne' hpq
    exact_mod_cast Nat.add_le_add_right hl 1
  have hP : (1/2:ℝ)^q.primeFactors.card≤∏ p∈q.primeFactors,(1-(p:ℝ)⁻¹) := by
    rw [←Finset.prod_const]
    exact Finset.prod_le_prod₀ (by norm_num) hLow
  have hT : (2:ℝ)^q.primeFactors.card≤(q.divisors.card:ℝ) := by
    rw [←Finset.prod_const,hDivisors]
    exact Finset.prod_le_prod₀ (by norm_num) hFactor
  have hP' : (1/2:ℝ)^q.primeFactors.card≤(q.totient:ℝ)/(q:ℝ) := by
    rw [hEuler,mul_comm (q:ℝ),mul_div_cancel_right₀ _ hq0.ne']
    exact hP
  have h := mul_le_mul hP' hT (by positivity) (by positivity)
  rw [←mul_pow,show (1/2:ℝ)*2=1 by norm_num,one_pow] at h
  exact h

/-- Once the interval length exceeds twice the squared divisor count,
at least V/(2 τ(q)) multipliers are available for Burgess's shift. -/
theorem coprimePrefix_card_lower {q V : ℕ} (hq : 0 < q)
    (hV : 2*(q.divisors.card:ℝ)^2≤(V:ℝ)) :
    (V:ℝ)/(2*(q.divisors.card:ℝ))≤((coprimePrefix q V).card:ℝ) := by
  have hτ : (0:ℝ)<q.divisors.card := by
    exact_mod_cast Finset.card_pos.mpr ⟨1,Nat.mem_divisors.mpr ⟨one_dvd _,hq.ne'⟩⟩
  have h1 : 1/(q.divisors.card:ℝ)≤(q.totient:ℝ)/(q:ℝ) :=
    (div_le_iff₀ hτ).mpr (totient_density_mul_divisor_count hq)
  have h2 : 2*(q.divisors.card:ℝ)≤(V:ℝ)*(q.totient:ℝ)/(q:ℝ) := calc
    _ ≤ (V:ℝ)/(q.divisors.card:ℝ) := (le_div_iff₀ hτ).mpr (by nlinarith only [hV])
    _ ≤ _ := by
      rw [div_eq_mul_one_div,mul_div_assoc]
      exact mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg V)
  refine le_trans ?_ (coprimePrefix_half_density hq h2)
  calc
    _ = ((V:ℝ)/2)*(1/(q.divisors.card:ℝ)) := by ring
    _ ≤ ((V:ℝ)/2)*((q.totient:ℝ)/(q:ℝ)) :=
      mul_le_mul_of_nonneg_left h1 (by positivity)
    _ = _ := by ring

end

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgessPrefix

open Finset

private abbrev PrefixPair := (ℕ×ℕ)×(ℕ×ℕ)
private abbrev RatioParameters := Σ _ : ℕ, ℕ×ℕ×ℕ

private def equalRatio (a : PrefixPair) : Prop :=
  (a.1.2+1)*a.2.1=(a.2.2+1)*a.1.1

private instance (a : PrefixPair) : Decidable (equalRatio a) :=
  inferInstanceAs (Decidable ((a.1.2+1)*a.2.1=(a.2.2+1)*a.1.1))

private def ratioParameters (a : PrefixPair) : RatioParameters :=
  let d := a.1.1.gcd a.2.1
  let m := a.2.1/d
  ⟨m,(a.1.1/d,d,(a.2.2+1)/m)⟩

private def reconstructRatio (p : RatioParameters) : PrefixPair :=
  ((p.2.1*p.2.2.1,p.2.1*p.2.2.2-1),(p.1*p.2.2.1,p.1*p.2.2.2-1))

private def ratioParametersBound (V N : ℕ) : Finset RatioParameters :=
  (Icc 1 V).sigma fun m => Icc 1 m ×ˢ Icc 1 (V/m) ×ˢ Icc 1 (N/m)

private theorem ratio_parameters_ordered {a : PrefixPair} {V N : ℕ}
    (h1 : a.1∈Icc 1 V ×ˢ range N) (h2 : a.2∈Icc 1 V ×ˢ range N)
    (hle : a.1.1≤a.2.1) (he : equalRatio a) :
    ratioParameters a ∈ ratioParametersBound V N ∧ reconstructRatio (ratioParameters a)=a := by
  rcases a with ⟨⟨v,j⟩,⟨w,k⟩⟩
  obtain ⟨⟨hv,hvV⟩,hj⟩ := (mem_product.mp h1).imp mem_Icc.mp mem_range.mp
  obtain ⟨⟨hw,hwV⟩,hk⟩ := (mem_product.mp h2).imp mem_Icc.mp mem_range.mp
  change v≤w at hle
  change (j+1)*w=(k+1)*v at he
  let d := v.gcd w
  let a := v/d
  let m := w/d
  let z := (k+1)/m
  have hd : 0<d := Nat.gcd_pos_of_pos_left _ hv
  have hda : d∣v := Nat.gcd_dvd_left _ _
  have hdm : d∣w := Nat.gcd_dvd_right _ _
  have ha : 1≤a := (Nat.le_div_iff_mul_le hd).mpr (by simpa [d] using Nat.gcd_le_left w hv)
  have hm : 1≤ m := (Nat.le_div_iff_mul_le hd).mpr (by simpa [d] using Nat.gcd_le_right v hw)
  have ham : a≤ m := Nat.div_le_div_right hle
  have hd1 : a*d=v := Nat.div_mul_cancel hda
  have hd2 : m*d=w := Nat.div_mul_cancel hdm
  have hc : a.Coprime m := Nat.coprime_div_gcd_div_gcd hd
  have he' : (j+1)*m=(k+1)*a := by
    apply Nat.eq_of_mul_eq_mul_right hd
    calc
      _ = (j+1)*w := by rw [mul_assoc,hd2]
      _ = (k+1)*v := he
      _ = _ := by rw [mul_assoc,hd1]
  have hzm : m∣k+1 := hc.symm.dvd_of_dvd_mul_right
    ⟨j+1,by simpa [mul_comm] using he'.symm⟩
  have hkz : z*m=k+1 := Nat.div_mul_cancel hzm
  have hz : 1≤z := (Nat.le_div_iff_mul_le hm).mpr (by
    simpa using Nat.le_of_dvd (Nat.succ_pos k) hzm)
  have hjz : a*z=j+1 := by
    apply Nat.eq_of_mul_eq_mul_right hm
    calc
      a*z*m = (k+1)*a := by rw [mul_assoc,hkz,mul_comm]
      _ = (j+1)*m := he'.symm
  have hmV : m≤V := (Nat.div_le_self _ _).trans hwV
  have hdV : d≤V/m := (Nat.le_div_iff_mul_le hm).mpr (by rw [mul_comm,hd2]; exact hwV)
  have hzN : z≤N/m := Nat.div_le_div_right (Nat.succ_le_of_lt hk)
  refine ⟨?_,?_⟩
  · change (⟨m,(a,d,z)⟩:RatioParameters)∈ratioParametersBound V N
    exact mem_sigma.mpr ⟨mem_Icc.mpr ⟨hm,hmV⟩,mem_product.mpr ⟨mem_Icc.mpr ⟨ha,ham⟩,
      mem_product.mpr ⟨mem_Icc.mpr ⟨hd,hdV⟩,mem_Icc.mpr ⟨hz,hzN⟩⟩⟩⟩
  · change ((a*d,a*z-1),(m*d,m*z-1))=((v,j),(w,k))
    rw [hd1,hd2,hjz,show m*z=k+1 by simpa [mul_comm] using hkz]
    simp

private theorem ratio_parameters_bound_card_le {V N : ℕ} (hV : 1≤V) :
    ((ratioParametersBound V N).card:ℝ)≤(V:ℝ)*(N:ℝ)*(1+Real.log (V:ℝ)) := by
  have hcard : (ratioParametersBound V N).card =
      ∑ m∈Icc 1 V, m*(V/m)*(N/m) := by
    simp [ratioParametersBound,Finset.card_sigma,Finset.card_product,Nat.card_Icc,mul_assoc]
  rw [hcard,Nat.cast_sum]
  have ht (m : ℕ) (hm : m∈Icc 1 V) :
      ((m*(V/m)*(N/m):ℕ):ℝ)≤ (V:ℝ)*(N:ℝ)*(1/(m:ℝ)) := by
    have hm0 : (0:ℝ)< m := by exact_mod_cast (mem_Icc.mp hm).1
    have hV' : ((V/m:ℕ):ℝ)≤(V:ℝ)/(m:ℝ) :=
      (le_div_iff₀ hm0).mpr (by exact_mod_cast Nat.div_mul_le_self V m)
    have hN' : ((N/m:ℕ):ℝ)≤(N:ℝ)/(m:ℝ) :=
      (le_div_iff₀ hm0).mpr (by exact_mod_cast Nat.div_mul_le_self N m)
    push_cast
    calc
      _ ≤ (m:ℝ)*((V:ℝ)/(m:ℝ))*((N:ℝ)/(m:ℝ)) :=
        mul_le_mul (mul_le_mul_of_nonneg_left hV' hm0.le) hN' (by positivity) (by positivity)
      _ = _ := by field_simp [hm0.ne']
  have hH : (∑ m∈Icc 1 V, (1:ℝ)/(m:ℝ))≤1+Real.log (V:ℝ) := by
    have hsum : (∑ m∈Icc 1 V, (1:ℝ)/(m:ℝ))=(harmonic V:ℝ) := by
      simp [harmonic_eq_sum_Icc,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast,one_div]
    rw [hsum]
    exact harmonic_le_one_add_log V
  refine (Finset.sum_le_sum ht).trans ?_
  rw [←Finset.mul_sum]
  exact mul_le_mul_of_nonneg_left hH (by positivity)

set_option maxHeartbeats 850000 in
/-- Integer products collide at most (2VN(1+log V)) times among
positive denominators ≤ V and positive numerators ≤ N. -/
theorem exact_ratio_collision_card_le {V N : ℕ} (hV : 1≤V) :
    let S := Icc 1 V ×ˢ range N
    (((S ×ˢ S).filter (fun a : PrefixPair=>(a.1.2+1)*a.2.1=(a.2.2+1)*a.1.1)).card:ℝ) ≤
      2*(V:ℝ)*(N:ℝ)*(1+Real.log (V:ℝ)) := by
  intro S
  let R := (S ×ˢ S).filter equalRatio
  let O := R.filter (fun a=>a.1.1≤a.2.1)
  let P := R.filter (fun a=>¬a.1.1≤a.2.1)
  have hO : O.card≤(ratioParametersBound V N).card := by
    apply Finset.card_le_card_of_injOn ratioParameters
    · intro a ha
      obtain ⟨hR,hord⟩ := mem_filter.mp ha
      obtain ⟨hS,hEq⟩ := mem_filter.mp hR
      obtain ⟨h1,h2⟩ := mem_product.mp hS
      exact (ratio_parameters_ordered h1 h2 hord hEq).1
    · intro a ha b hb he
      have hr (x : PrefixPair) (hx : x∈O) : reconstructRatio (ratioParameters x)=x := by
        obtain ⟨hR,hord⟩ := mem_filter.mp hx
        obtain ⟨hS,hEq⟩ := mem_filter.mp hR
        obtain ⟨h1,h2⟩ := mem_product.mp hS
        exact (ratio_parameters_ordered h1 h2 hord hEq).2
      rw [←hr a ha,←hr b hb,he]
  have hP : P.card≤O.card := by
    apply Finset.card_le_card_of_injOn Prod.swap
    · intro a ha
      obtain ⟨hR,hord⟩ := mem_filter.mp ha
      obtain ⟨hS,hEq⟩ := mem_filter.mp hR
      obtain ⟨h1,h2⟩ := mem_product.mp hS
      exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_product.mpr ⟨h2,h1⟩,Eq.symm hEq⟩,le_of_lt (lt_of_not_ge hord)⟩
    · intro a _ b _ he
      exact Prod.swap_injective he
  have hR : R.card=O.card+P.card := (card_filter_add_card_filter_not (s:=R) (fun a : PrefixPair=>a.1.1≤a.2.1)).symm
  have hR' : R.card≤2*(ratioParametersBound V N).card := by omega
  change (R.card:ℝ)≤_
  have hR'' : (R.card:ℝ)≤2*((ratioParametersBound V N).card:ℝ) := by exact_mod_cast hR'
  exact hR''.trans ((mul_le_mul_of_nonneg_left (ratio_parameters_bound_card_le (N:=N) hV)
    (by norm_num : (0:ℝ)≤2)).trans_eq (by ring))

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgessPrefix

open Finset

variable {q : ℕ} [NeZero q]

omit [NeZero q] in
private theorem normalizedResidue_mul (u : ℕ → (ZMod q)ˣ) (p : ℕ × ℕ) :
    normalizedResidue u p * (u p.1:ZMod q) = ((p.2+1:ℕ):ZMod q) := by
  rw [normalizedResidue,mul_assoc,←Units.val_mul,inv_mul_cancel,Units.val_one,mul_one]

theorem exact_ratio_of_residue_eq (u : ℕ → (ZMod q)ˣ) {p r : ℕ × ℕ}
    (hp : (u p.1:ZMod q)=p.1) (hr : (u r.1:ZMod q)=r.1)
    (h₁ : (p.2+1)*r.1 < q) (h₂ : (r.2+1)*p.1 < q)
    (h : normalizedResidue u p = normalizedResidue u r) : (p.2+1)*r.1 = (r.2+1)*p.1 := by
  have he : normalizedResidue u p * (u p.1:ZMod q) * (u r.1:ZMod q) =
      normalizedResidue u r * (u r.1:ZMod q) * (u p.1:ZMod q) := by
    rw [h,mul_right_comm]
  rw [normalizedResidue_mul,normalizedResidue_mul,hp,hr,←Nat.cast_mul,←Nat.cast_mul] at he
  have hm := congrArg ZMod.val he
  rwa [ZMod.val_natCast_of_lt h₁,ZMod.val_natCast_of_lt h₂] at hm

def residueCollisions (A : Finset ℕ) (u : ℕ → (ZMod q)ˣ) (N : ℕ) :
    Finset ((ℕ × ℕ) × (ℕ × ℕ)) :=
  ((A ×ˢ range N) ×ˢ (A ×ˢ range N)).filter
    (fun p => normalizedResidue u p.1=normalizedResidue u p.2)

theorem sum_sq_fiberCount_eq_residueCollisions (A : Finset ℕ) (u : ℕ → (ZMod q)ˣ)
    (N : ℕ) : ∑ x : ZMod q,(fiberCount A u N x)^2 = (residueCollisions A u N).card := by
  classical
  let S := A ×ˢ range N
  let R := residueCollisions A u N
  let g (p : (ℕ × ℕ) × (ℕ × ℕ)) := normalizedResidue u p.1
  rw [card_eq_sum_card_fiberwise (f:=g) (s:=R) (t:=univ) (fun p _ => mem_univ (g p))]
  apply sum_congr rfl
  intro x _
  have hf : R.filter (fun p => g p=x) =
      (S.filter (fun p => normalizedResidue u p=x)) ×ˢ
        (S.filter (fun p => normalizedResidue u p=x)) := by
    ext p
    simp only [R,residueCollisions,S,mem_filter,mem_product,g]
    constructor
    · rintro ⟨⟨⟨h₁,h₂⟩,he⟩,hx⟩
      exact ⟨⟨h₁,hx⟩,⟨h₂,he.symm.trans hx⟩⟩
    · rintro ⟨⟨h₁,hx⟩,⟨h₂,hy⟩⟩
      exact ⟨⟨⟨h₁,h₂⟩,hx.trans hy.symm⟩,hx⟩
  rw [hf,card_product,pow_two]
  rfl

theorem residueCollisions_subset_exact {N V : ℕ} (A : Finset ℕ)
    (u : ℕ → (ZMod q)ˣ) (hA : A ⊆ Icc 1 V)
    (hu : ∀ a∈A,(u a:ZMod q)=a) (hNV : V*N<q) :
    residueCollisions A u N ⊆
      ((Icc 1 V ×ˢ range N) ×ˢ (Icc 1 V ×ˢ range N)).filter
        (fun p => (p.1.2+1)*p.2.1=(p.2.2+1)*p.1.1) := by
  intro p hp
  obtain ⟨⟨⟨hpa,hpn⟩,⟨hra,hrn⟩⟩,heq⟩ := by
    simpa only [residueCollisions,mem_filter,mem_product] using hp
  refine mem_filter.mpr ⟨mem_product.mpr
    ⟨mem_product.mpr ⟨hA hpa,hpn⟩,mem_product.mpr ⟨hA hra,hrn⟩⟩,?_⟩
  apply exact_ratio_of_residue_eq u (hu _ hpa) (hu _ hra) _ _ heq
  · exact (Nat.mul_le_mul (Nat.succ_le_of_lt (mem_range.mp hpn)) (mem_Icc.mp (hA hra)).2).trans_lt (by simpa [Nat.mul_comm] using hNV)
  · exact (Nat.mul_le_mul (Nat.succ_le_of_lt (mem_range.mp hrn)) (mem_Icc.mp (hA hpa)).2).trans_lt (by simpa [Nat.mul_comm] using hNV)

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgessPrefix

open Finset

/-- Burgess’s normalized initial segment fibers have the logarithmic second-moment
bound throughout the range where integer cross-products do not wrap. -/
theorem sum_sq_fiberCount_le {q V N : ℕ} [NeZero q]
    (A : Finset ℕ) (u : ℕ→(ZMod q)ˣ) (hV : 1≤V)
    (hA : A⊆Icc 1 V) (hu : ∀ a∈A,(u a:ZMod q)=a) (hVN : V*N<q) :
    (∑ x : ZMod q,(fiberCount A u N x:ℝ)^2)≤
      2*(V:ℝ)*(N:ℝ)*(1+Real.log (V:ℝ)) := by
  have he : (∑ x : ZMod q,(fiberCount A u N x:ℝ)^2)=((residueCollisions A u N).card:ℝ) := by
    exact_mod_cast sum_sq_fiberCount_eq_residueCollisions A u N
  rw [he]
  refine le_trans ?_ (exact_ratio_collision_card_le (N:=N) hV)
  exact_mod_cast card_le_card (residueCollisions_subset_exact A u hA hu hVN)

end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgessPrefix

open Real

set_option maxHeartbeats 1100000 in
/-- The arithmetic part of the direct fourth-moment Burgess initial segment bound.
The collision logarithm may already be replaced by any upper envelope L. -/
theorem direct_prefix_fourth_numeric {Q N V B A τ S C e L : ℝ}
    (hQ : 0<Q) (hN : 0<N) (hV : 0<V) (hB : 0<B) (hA : 0<A)
    (hτ : 0<τ) (hC : 0≤C) (hL : 0≤L)
    (hAdown : V/(2*τ)≤A)
    (hBdown : Q^(1/4:ℝ)/2≤B) (hBup : B≤Q^(1/4:ℝ))
    (hVdown : (N^(3/5:ℝ)*Q^(-(1/10):ℝ))/4≤V)
    (hVup : V≤(N^(3/5:ℝ)*Q^(-(1/10):ℝ))/2)
    (hMoment : (max (A*B*(S-2*V*B)) 0)^4 ≤
      (A*N)^2*(2*V*N*L)*(C*Q^e*(Q*B^2+Q^(1/2:ℝ)*B^4))) :
    S≤(1+(256*C*τ^2*Q^e*L)^(1/4:ℝ))*(N^(3/5:ℝ)*Q^(3/20:ℝ)) := by
  let R := N^(3/5:ℝ)*Q^(-(1/10):ℝ)
  let J := Q^(1/4:ℝ)
  let P := N^(3/5:ℝ)*Q^(3/20:ℝ)
  let D := 256*C*τ^2*Q^e*L
  let Z := max (S-2*V*B) 0
  have hR : 0<R := by unfold R; positivity
  have hJ : 0<J := by unfold J; positivity
  have hP : 0<P := by unfold P; positivity
  have hD : 0≤D := by unfold D; positivity
  have hZ : 0≤Z := le_max_right _ _
  have hJ2 : J^2=Q^(1/2:ℝ) := by
    unfold J
    rw [←Real.rpow_mul_natCast hQ.le]
    norm_num
  have hJ4 : J^4=Q := by
    unfold J
    rw [←Real.rpow_mul_natCast hQ.le]
    norm_num
  have hBlocks : Q^(1/2:ℝ)*B^4≤Q*B^2 := by
    have hs := pow_le_pow_left₀ hB.le hBup 2
    change B^2≤J^2 at hs
    have hs' := mul_le_mul_of_nonneg_left hs (show 0≤J^2*B^2 by positivity)
    rw [←hJ2,←hJ4]
    nlinarith only [hs']
  have hMoment' : (max (A*B*(S-2*V*B)) 0)^4≤
      (A*N)^2*(2*V*N*L)*(2*C*Q^e*Q*B^2) := by
    refine hMoment.trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
    have h := mul_le_mul_of_nonneg_left hBlocks (show 0≤C*Q^e by positivity)
    nlinarith only [h]
  have hMax : A*B*Z=max (A*B*(S-2*V*B)) 0 := by
    unfold Z
    rw [mul_max_of_nonneg _ _ (by positivity : 0≤A*B),mul_zero]
  have hQuart : Z^4≤4*C*Q^e*Q*N^3*L*(V/(A^2*B^2)) := calc
    _ ≤ ((A*N)^2*(2*V*N*L)*(2*C*Q^e*Q*B^2))/(A*B)^4 := by
      apply (le_div_iff₀ (by positivity : 0<(A*B)^4)).mpr
      rw [mul_comm (Z^4),←mul_pow,hMax]
      exact hMoment'
    _ = _ := by field_simp [hA.ne',hB.ne'] <;> ring
  have hDenom : (V/(2*τ))*(J/2)≤A*B :=
    mul_le_mul hAdown hBdown (by positivity) hA.le
  have hRatio : V/(A^2*B^2)≤16*τ^2/((R/4)*J^2) := calc
    _ = V/(A*B)^2 := by rw [mul_pow]
    _ ≤ V/((V/(2*τ))*(J/2))^2 := by
      exact div_le_div_of_nonneg_left hV.le (by positivity)
        (pow_le_pow_left₀ (by positivity) hDenom 2)
    _ = 16*τ^2/(V*J^2) := by field_simp [hV.ne',hτ.ne',hJ.ne'] <;> ring
    _ ≤ _ := div_le_div_of_nonneg_left (by positivity) (by positivity)
      (mul_le_mul_of_nonneg_right hVdown (sq_nonneg J))
  have hNpow : N^3=N^(3/5:ℝ)*(N^(3/5:ℝ))^4 := by
    rw [←pow_succ',←Real.rpow_mul_natCast hN.le]
    norm_num
  have hQpow : Q*Q^(1/10:ℝ)=J^2*(Q^(3/20:ℝ))^4 := calc
    _ = Q^(1+1/10:ℝ) := by rw [Real.rpow_add hQ,Real.rpow_one]
    _ = _ := by
      unfold J
      rw [←Real.rpow_mul_natCast hQ.le,←Real.rpow_mul_natCast hQ.le,←Real.rpow_add hQ]
      norm_num
  have hBalance : Q*N^3/((R/4)*J^2)=4*P^4 := by
    apply (div_eq_iff (show ((R/4)*J^2)≠0 by positivity)).mpr
    unfold R P
    rw [Real.rpow_neg hQ.le,mul_pow]
    have hQn : Q^(1/10:ℝ)≠0 := (Real.rpow_pos_of_pos hQ _).ne'
    calc
      _ = (Q*Q^(1/10:ℝ))*(N^(3/5:ℝ)*(N^(3/5:ℝ))^4)*(Q^(1/10:ℝ))⁻¹ := by
        rw [←hNpow]
        field_simp [hQn] <;> ring
      _ = _ := by rw [hQpow]; ring
  have hZpow : Z^4≤D*P^4 := calc
    _ ≤ _ := hQuart
    _ ≤ 4*C*Q^e*Q*N^3*L*(16*τ^2/((R/4)*J^2)) :=
      mul_le_mul_of_nonneg_left hRatio (by positivity)
    _ = (64*C*τ^2*Q^e*L)*(Q*N^3/((R/4)*J^2)) := by ring
    _ = D*P^4 := by rw [hBalance]; unfold D; ring
  have hFourth : (D^(1/4:ℝ)*P)^4=D*P^4 := by
    rw [mul_pow,←Real.rpow_mul_natCast hD]
    norm_num
  have hZ' : Z≤D^(1/4:ℝ)*P :=
    (pow_le_pow_iff_left₀ hZ (by positivity) (by norm_num : (4:ℕ)≠0)).mp
      (by rwa [hFourth])
  have hShift : 2*V*B≤P := calc
    _ ≤ 2*(R/2)*J := by
      exact mul_le_mul (mul_le_mul_of_nonneg_left hVup (by norm_num)) hBup hB.le (by positivity)
    _ = P := by
      unfold R J P
      rw [show 2*(N^(3/5:ℝ)*Q^(-(1/10):ℝ)/2)*Q^(1/4:ℝ)=
        N^(3/5:ℝ)*(Q^(-(1/10):ℝ)*Q^(1/4:ℝ)) by ring,←Real.rpow_add hQ]
      norm_num
  change S≤(1+D^(1/4:ℝ))*P
  have hS : S-2*V*B≤Z := le_max_left _ _
  rw [add_mul,one_mul]
  linarith only [hS,hZ',hShift]

end GoldbachBurgessPrefix
end

