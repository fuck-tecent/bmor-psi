      0 ≤ ∑ s ∈ n.primeFactors.powerset, upperRosserSetWeight D s :=
        sum_upperRosserSetWeight_nonneg hnFactors
          (fun p hp ↦ Nat.prime_of_mem_primeFactors hp)
          (fun p hp ↦ hD p (hsub hp))
