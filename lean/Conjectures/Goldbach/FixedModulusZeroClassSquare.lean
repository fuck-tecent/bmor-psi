/-- Transport zero orbits to the repeated-zero census used by the class mass. -/
theorem modulus_rank_of_conjugate_pair {q K : ℕ} [NeZero q] {H R d : ℝ}
    {p : DirichletCharacter ℂ q × ℂ}
    (hSimple : modulusOrder p=1)
    (hConj : modulusOrder (p.1⁻¹,line p.2.re (-p.2.im))=1)
    (hOrbit : ∀ r∈modulusZeros q H R, modulusGap q r.2<d →
      r=p ∨ r=(p.1⁻¹,line p.2.re (-p.2.im))) :
    let S := repeatTags (modulusZeros q H R) modulusOrder
    ((S.filter (fun t=>modulusGap q t.1.2<d)).card:ℝ)≤2 ∧
    (conductorClass K p.1≠conductorClass K p.1⁻¹ →
      ∀ c, (((S.filter (fun t=>conductorClass K t.1.1=c)).filter
        (fun t=>modulusGap q t.1.2<d)).card:ℝ)≤1) := by
  dsimp only
  refine ⟨?_,fun hC c=>?_⟩
  · exact_mod_cast repeatTags_card_le_of_simple_pair hSimple hConj hOrbit
  · have hNat := repeatTags_class_card_le_of_simple_pair
      (fun r : DirichletCharacter ℂ q × ℂ=>conductorClass K r.1) c hSimple hConj hC hOrbit
    have hNat' : (((repeatTags (modulusZeros q H R) modulusOrder).filter
        (fun t=>conductorClass K t.1.1=c)).filter (fun t=>modulusGap q t.1.2<d)).card≤1 := by
      convert hNat using 2
      ext t
      simp only [mem_filter]
    exact_mod_cast hNat'


theorem modulus_rank_of_single_leader {q K : ℕ} [NeZero q] {H R d : ℝ}
    {p : DirichletCharacter ℂ q × ℂ}
    (hSimple : modulusOrder p=1)
    (hRiv : ∀ r∈modulusRivals K false H R p, d< modulusGap q r.2) :
    let S := repeatTags (modulusZeros q H R) modulusOrder
    ((S.filter (fun t=>modulusGap q t.1.2<d)).card:ℝ)≤2 ∧
    (∀ c, (((S.filter (fun t=>conductorClass K t.1.1=c)).filter
        (fun t=>modulusGap q t.1.2<d)).card:ℝ)≤1) := by
  dsimp only
  let S := repeatTags (modulusZeros q H R) modulusOrder
  have hCard : (S.filter (fun t=>modulusGap q t.1.2<d)).card≤1 := by
    refine repeatTags_card_le_of_simple_single hSimple (filter_subset _ _) ?_
    intro t ht
    have hm := mem_filter.mp ht
    by_contra! hn
    have hR := hRiv t.1 (mem_filter.mpr ⟨mem_erase.mpr ⟨hn,(mem_sigma.mp hm.1).1⟩,by simp⟩)
    exact hm.2.not_gt hR
  refine ⟨(by exact_mod_cast hCard.trans (by decide : (1:ℕ)≤2)),fun c=>?_⟩
  have hc : ((S.filter (fun t=>conductorClass K t.1.1=c)).filter
      (fun t=>modulusGap q t.1.2<d))⊆S.filter (fun t=>modulusGap q t.1.2<d) :=
    fun t ht=>mem_filter.mpr ⟨(mem_filter.mp (mem_filter.mp ht).1).1,(mem_filter.mp ht).2⟩
  exact_mod_cast (card_le_card hc).trans hCard

theorem eventual_real_lower_gap_for_census
    (hNS : ∃ c : ℝ, 0<c ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (β : ℝ),
      χ^2=1 → 1-c/Real.log ((q:ℝ)+2)<β → β<1 → χ.LFunction (β:ℂ)≠0) :
    ∃ δ : ℝ, 0<δ ∧ δ≤0.005 ∧
      ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (H R : ℝ) (p : DirichletCharacter ℂ q × ℂ),
        p∈modulusZeros q H R → p.1^2=1 → p.2.im=0 → δ≤ modulusGap q p.2 := by
  obtain ⟨δ,hδ,hSmall,h⟩ := fixed_real_gap_of_no_siegel hNS
  refine ⟨δ,hδ,hSmall,?_⟩
  filter_upwards [eventually_ge_atTop (2:ℕ)] with q hq
  intro _ H R p hp hQuad hReal
  obtain ⟨hχ,hz,_⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨_,_,hZ⟩ := (mem_exceptionalZeros _ _ _).mp hz
  have hP : (p.2.re:ℂ)=p.2 := by
    apply Complex.ext <;> simp [hReal]
  exact h q hq p.1 p.2.re hχ hQuad (by simpa only [hP] using hZ)

end
end GoldbachSignedPairs
