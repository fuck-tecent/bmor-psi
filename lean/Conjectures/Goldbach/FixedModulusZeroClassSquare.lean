namespace GoldbachHybridGrowth

open Complex

theorem cd_gram_growth_C {φ : ℝ} (hφ : 3/8 < φ) :
    ∃ B : ℝ, 0 < B ∧ ∀ (q : ℕ) [NeZero q], ∀ scale : ℝ, 1 ≤ scale →
      Real.log (q:ℝ) ≤ scale → ∀ χ : DirichletCharacter ℂ q, χ≠1 →
      ∀ s : ℂ, s.re=7/8 →
      ‖χ.LFunction s‖ ≤ B*(1+|s.im|)*(1+scale)*(q:ℝ)^(φ*(1/8:ℝ)) := by
  obtain ⟨B,hB,hGrowth⟩ := nonprincipal_LFunction_uniform_burgess_strip_linear_height hφ
  refine ⟨B,zero_lt_one.trans_le hB,?_⟩
  intro q _ L hL hq χ hχ s hs
  have hh := hGrowth q χ hχ (abs_nonneg s.im) s (by norm_num [hs]) (by norm_num [hs]) le_rfl
  rw [hs] at hh
  norm_num at hh
  exact hh.trans (by gcongr)

theorem cd_gram_growth_D {φ : ℝ} (hφ : 0 < φ) (Q₀ : ℕ) (hQ₀ : 1 ≤ Q₀) :
    ∃ B : ℝ, 0 < B ∧ ∀ (q : ℕ) [NeZero q], ∀ scale : ℝ, 1 ≤ scale →
      Real.log (q:ℝ) ≤ scale → ∀ χ : DirichletCharacter ℂ q, χ≠1 → χ.conductor ≤ Q₀ →
      ∀ s : ℂ, s.re=7/8 →
      ‖χ.LFunction s‖ ≤ B*(1+|s.im|)*(1+scale)*(q:ℝ)^(φ*(1/8:ℝ)) := by
  obtain ⟨B,hB,hGrowth⟩ := bounded_conductor_strip_linear_height hφ Q₀ hQ₀
  refine ⟨B,hB,?_⟩
  intro q _ L hL hq χ hχ hcond s hs
  have hh := hGrowth q hL hq χ hχ hcond s (by norm_num [hs]) (by norm_num [hs])
  rw [hs] at hh
  norm_num at hh
  exact hh.trans (by gcongr; linarith)

end GoldbachHybridGrowth
end

section
namespace GoldbachCubicRiesz

open Complex MeasureTheory Filter Finset GoldbachTypeII GoldbachSieveSeries
noncomputable section

set_option maxHeartbeats 1200000 in
/-- The nonprincipal Gram term on a fixed negative line with a linear
ordinate bound on its LCM polynomial and L-function. -/
theorem gram_cutoff_norm_le_left {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ≠1) {ρ : ℂ}
    {a h : ℝ} (hh : 0<h) (hh' : h≤1/2) (ha₀ : -(1/2:ℝ)≤a) (ha₁ : a≤ -h)
    (hlo : 1/2≤ρ.re+a) (hhi : ρ.re≤1)
    {W Y U M : ℝ} (hW : 0≤W) (hU : 1≤U) (hUY : U≤Y) (hM : 0≤M)
    (θ : ℕ → ℝ) (hθ : ∀ d, |θ d|≤1)
    (hLeft : ∀ t : ℝ, let s := ρ+((a:ℂ)+t*I)
      ‖χ.LFunction s*lcmPolynomial χ (Icc 1 ⌊W⌋₊) (Icc 1 ⌊W⌋₊)
          (fun d => (θ d:ℂ)) (fun d => (θ d:ℂ)) s‖≤M*(1+|t|)) :
    ‖cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) Y-
      cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) U‖≤
      2*(1+h⁻¹)^3*U^a*M := by
  classical
  let D := Icc 1 ⌊W⌋₊
  let u := fun d => (θ d : ℂ)
  let P := lcmPolynomial χ D D u u
  let H (z : ℂ) := χ.LFunction (ρ+z) * P (ρ+z)
  let B := 12*W
  let A := (Y+U)*(6*(q : ℝ)*(1+‖ρ‖+1)*B)
  have hU₀ : 0 < U := zero_lt_one.trans_le hU
  have hY₀ := hU₀.trans_le hUY
  have hY := hU.trans hUY
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have hshift : Differentiable ℂ (fun z : ℂ => ρ+z) := by fun_prop
  have hH : Differentiable ℂ H := ((χ.differentiable_LFunction hχ).comp hshift).mul
    ((differentiable_lcmPolynomial χ D D u u).comp hshift)
  have hP (s : ℂ) (hs : 1/2 ≤ s.re) : ‖P s‖ ≤ B := by
    have hu (d : ℕ) (_ : d ∈ D) : ‖u d‖ ≤ 1 := by
      simpa only [u, Complex.norm_real, Real.norm_eq_abs] using hθ d
    refine (norm_lcmPolynomial_le χ ⌊W⌋₊ ⌊W⌋₊ u u hs hu hu).trans ?_
    calc
      _ = 12*(Real.sqrt (⌊W⌋₊ : ℝ))^2 := by ring
      _ ≤ B := by rw [Real.sq_sqrt (by positivity)]; exact mul_le_mul_of_nonneg_left (Nat.floor_le hW) (by norm_num)
  have hb : LSeriesSummable (gramCoefficient χ W θ) (ρ+1) := by
    apply sieveProduct_summable
    simp only [add_re, one_re]
    linarith
  have hRight (t : ℝ) : H ((1 : ℂ)+t*I) =
      LSeries (gramCoefficient χ W θ) (ρ+((1 : ℂ)+t*I)) := by
    let s : ℂ := ρ+((1 : ℂ)+t*I)
    have hs : 1 < s.re := by simp [s, add_re, mul_re]; linarith
    change χ.LFunction s * lcmPolynomial χ D D u u s = _
    rw [lcmPolynomial_eq, mul_comm]
    exact (sieveProduct_LSeries χ D D u u hs).symm
  have hgrowth (x : ℝ) (hx : x ∈ Set.Icc a 1) (t : ℝ) (_ : 1 ≤ |t|) :
      ‖((Y : ℂ)^((x : ℂ)+t*I)-(U : ℂ)^((x : ℂ)+t*I)) * H ((x : ℂ)+t*I)‖ ≤ A*(1+|t|) := by
    have hxa : a ≤ x := hx.1
    have hx' : |x| ≤ 1 := abs_le.mpr ⟨by linarith, hx.2⟩
    have hs : 1/2 ≤ ρ.re+x := by linarith
    have hL := shifted_product_linear_growth hχ ρ P hB
      (by norm_num : (0 : ℝ) ≤ 1) hP hx' hs (t := t)
    let z : ℂ := (x : ℂ)+t*I
    have hz : z.re = x := by simp [z, mul_re]
    have hpow : ‖(Y : ℂ)^z-(U : ℂ)^z‖ ≤ Y+U := by
      refine (norm_sub_le _ _).trans ?_
      rw [norm_cpow_eq_rpow_re_of_pos hY₀, norm_cpow_eq_rpow_re_of_pos hU₀, hz]
      exact add_le_add (by simpa using Real.rpow_le_rpow_of_exponent_le hY hx.2)
        (by simpa using Real.rpow_le_rpow_of_exponent_le hU hx.2)
    rw [norm_mul]
    calc
      _ ≤ (Y+U)*((6*(q : ℝ)*(1+‖ρ‖+1)*B)*(1+|t|)) :=
        mul_le_mul hpow hL (norm_nonneg _) (by positivity)
      _ = _ := by dsimp only [A]; ring
  have ha : a<0 := ha₁.trans_lt (neg_neg_of_pos hh)
  have hexact := nonprincipal_gram_cutoff_eq hH (gramCoefficient χ W θ) ρ hb hY₀ hU₀
    (by linarith only [ha₀] : -1<a) ha hA hRight hgrowth
  rw [hexact]
  let Z (t : ℝ) := (a:ℂ)+t*I
  let F (t : ℝ) := ((Y:ℂ)^(Z t)-(U:ℂ)^(Z t))*H (Z t)
  have hF (t : ℝ) : ‖F t‖≤(2*U^a*M)*(1+|t|) := by
    have hz : (Z t).re=a := by simp [Z,mul_re]
    have hpow : ‖(Y:ℂ)^(Z t)-(U:ℂ)^(Z t)‖≤2*U^a := by
      refine (norm_sub_le _ _).trans ?_
      rw [norm_cpow_eq_rpow_re_of_pos hY₀,norm_cpow_eq_rpow_re_of_pos hU₀,hz]
      linarith only [Real.rpow_le_rpow_of_nonpos hU₀ hUY ha.le]
    rw [show F t=((Y:ℂ)^(Z t)-(U:ℂ)^(Z t))*H (Z t) from rfl,norm_mul]
    have hH' : ‖H (Z t)‖≤M*(1+|t|) := hLeft t
    exact (mul_le_mul hpow hH' (norm_nonneg _) (by positivity)).trans_eq (by ring)
  have hN := norm_left_cubic_integral_le hh hh' ha₀ ha₁ (by positivity : 0≤2*U^a*M) F hF
  have hIntegral : (∫ t : ℝ,gramRieszDifference Y U (Z t)*H (Z t))=
      ∫ t : ℝ,symbol (Z t)*F t := by
    apply integral_congr_ae
    filter_upwards [] with t
    dsimp only [gramRieszDifference,F]
    ring
  change ‖((1/(2*Real.pi):ℝ):ℂ)*(∫ t : ℝ,gramRieszDifference Y U (Z t)*H (Z t))‖≤_
  rw [hIntegral]
  exact hN.trans_eq (by ring)

end
end GoldbachCubicRiesz
end

