lemma Vu0 {s k N Q : ℕ} (p a r : ℕ)
    (x : (Fin k → Fin N) × (Fin s → Fin Q)) (j : Fin k) :
    (∑ i, (((X+C (a : ZMod (p^(r+1))))^(j.val+1)).eval
