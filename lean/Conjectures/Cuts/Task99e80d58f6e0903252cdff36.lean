theorem finiteSourceLayer_odd_lowStrip_exact
    (N : ℕ) (x : ℝ) (hN : 3 ≤ N) (hodd : N % 2 = 1)
    (hx1 : 1 < x) (hx3 : x ≤ 3) :
    x * finiteSourceLayer 1 2 N x =
      (3 - x) + 3 * finiteSourceLayer 1 2 N 3 := by
