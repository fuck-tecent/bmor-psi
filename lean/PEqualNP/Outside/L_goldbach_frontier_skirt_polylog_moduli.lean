theorem Vjy (t:ℝ) (S:Finset ℂ)
    (hS:∀z∈S,z∈V59 ∧ |z.im-t|≤4) :
    ∑z∈S,(analyticOrderNatAt riemannZeta z:ℝ)≤
      22*(Real.log (192*(|t|+8)^2)/Real.log (14/13)) := by
