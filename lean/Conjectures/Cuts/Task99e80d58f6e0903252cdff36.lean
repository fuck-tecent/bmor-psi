      Real.log (Real.exp 1 * L) = 1 + Real.log L := by
    rw [Real.log_mul (ne_of_gt (Real.exp_pos _)) (ne_of_gt hL), Real.log_exp]
  have hcoef : 1 + Real.log L - Real.log (s - 2) ≤ 0 := by
    rw [hlogProd] at hlogLarge
