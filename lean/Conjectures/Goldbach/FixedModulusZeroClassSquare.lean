section
namespace GoldbachPintzNumerics

open Complex Finset MeasureTheory Set
open scoped ComplexConjugate

noncomputable section

/-- Coefficients of the one-sided autocorrelation of a finite exponential sum. -/
def exponentialAutoCoeff {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (i : ι) : ℝ :=
  ∑ j∈S, a i*a j/(b i+b j)

/-- The transform of the autocorrelation. -/
def exponentialAutoTransform {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (z : ℂ) : ℂ :=
  ∑ i∈S, (exponentialAutoCoeff S a b i:ℂ)/((b i:ℂ)+z)

/-- Time-domain finite exponential sum. -/
def exponentialPulse {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (t : ℝ) : ℝ :=
  ∑ i∈S, a i*Real.exp (-(b i)*t)

private theorem exp_pair_integrable {r s : ℝ} (hr : 0<r) (hs : 0<s) (w : ℝ) :
    IntegrableOn (fun t => w*Real.exp (-(r+s)*t)) (Ioi 0) :=
  (integrableOn_exp_mul_Ioi (by linarith only [hr,hs] : -(r+s)<0) 0).const_mul w

private theorem exp_pair_integral {r s : ℝ} (hr : 0<r) (hs : 0<s) (w : ℝ) :
    (∫ t in Ioi 0,w*Real.exp (-(r+s)*t))=w/(r+s) := by
  rw [integral_const_mul,integral_exp_mul_Ioi (neg_lt_zero.mpr (add_pos hr hs))]
  rw [mul_zero,Real.exp_zero]
  field_simp [ne_of_gt (add_pos hr hs)]
  <;> ring

/-- The exponential Cauchy matrix is positive semidefinite. -/
theorem exponential_cauchy_nonneg {ι : Type*} (S : Finset ι) (b : ι→ℝ) (v : ι→ℂ)
    (hb : ∀ i∈S, 0<b i) :
    0≤∑ i∈S, ∑ j∈S, (v i*conj (v j)).re/(b i+b j) := by
  let w (i j : ι) := (v i*conj (v j)).re
  let f (i j : ι) (t : ℝ) := w i j*Real.exp (-(b i+b j)*t)
  have hf (i j : ι) (hi : i∈S) (hj : j∈S) : IntegrableOn (f i j) (Ioi 0) :=
    exp_pair_integrable (hb i hi) (hb j hj) (w i j)
  have he (i j : ι) (hi : i∈S) (hj : j∈S) :
      (∫ t in Ioi 0,f i j t)=w i j/(b i+b j) :=
    exp_pair_integral (hb i hi) (hb j hj) (w i j)
  have hI : (∫ t in Ioi 0,∑ i∈S,∑ j∈S,f i j t)=
      ∑ i∈S,∑ j∈S,w i j/(b i+b j) := by
    rw [integral_finsetSum S (fun i hi=>integrable_finsetSum S (fun j hj=>hf i j hi hj))]
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [integral_finsetSum S (fun j hj=>hf i j hi hj)]
    exact Finset.sum_congr rfl fun j hj=>he i j hi hj
  rw [←hI]
  apply integral_nonneg
  intro t
  change 0≤∑ i∈S,∑ j∈S,f i j t
  let x (i : ι) := v i*(Real.exp (-(b i)*t):ℂ)
  have hX (i j : ι) : f i j t=(x i*conj (x j)).re := by
    have hE : Real.exp (-(b i+b j)*t)=Real.exp (-(b i)*t)*Real.exp (-(b j)*t) := by
      rw [←Real.exp_add]
      congr 1
      ring
    simp only [f,w,x,map_mul,Complex.conj_ofReal,hE,Complex.mul_re,Complex.mul_im,
      Complex.ofReal_re,Complex.ofReal_im,mul_zero,sub_zero,zero_add,Complex.conj_re,Complex.conj_im]
    ring
  rw [Finset.sum_congr rfl (fun i _=>Finset.sum_congr rfl (fun j _=>hX i j))]
  have hSum : (∑ i∈S,∑ j∈S,x i*conj (x j))=(∑ i∈S,x i)*conj (∑ j∈S,x j) := by
    rw [map_sum,Finset.sum_mul]
    exact Finset.sum_congr rfl (fun i _=> (Finset.mul_sum _ _ _).symm)
  have hRe := congrArg Complex.re hSum
  simp only [Complex.re_sum] at hRe
  rw [hRe,Complex.mul_conj,Complex.ofReal_re]
  exact Complex.normSq_nonneg _

private theorem exp_coeff_transform_sum {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (z : ℂ) :
    exponentialAutoTransform S a b z =
      ∑ i∈S,∑ j∈S,((a i*a j/(b i+b j):ℝ):ℂ)/((b i:ℂ)+z) := by
  unfold exponentialAutoTransform exponentialAutoCoeff
  refine Finset.sum_congr rfl fun i _=> ?_
  rw [Complex.ofReal_sum,Finset.sum_div]

/-- The transform has nonnegative real part on the closed right half-plane. -/
theorem exponentialAutoTransform_re_nonneg {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S, 0<b i) {z : ℂ} (hz : 0≤z.re) :
    0≤(exponentialAutoTransform S a b z).re := by
  let v (i : ι) : ℂ := (a i:ℂ)/((b i:ℂ)+z)
  let A (i j : ι) : ℂ := (a i*a j/(b i+b j):ℝ)
  let F := exponentialAutoTransform S a b z
  have hF : F=∑ i∈S,∑ j∈S,A i j/((b i:ℂ)+z) := exp_coeff_transform_sum S a b z
  have hFC : conj F=∑ i∈S,∑ j∈S,A i j/((b j:ℂ)+conj z) := by
    rw [hF,Finset.sum_comm]
    simp only [map_sum,map_div₀,map_add]
    refine Finset.sum_congr rfl fun i hi => Finset.sum_congr rfl fun j hj => ?_
    rw [show conj (A j i)=A i j by
      unfold A
      rw [Complex.conj_ofReal,mul_comm (a j),add_comm (b j)]]
    simp
  have hDen (i : ι) (hi : i∈S) : (b i:ℂ)+z≠0 := by
    intro he
    have hR := congrArg Complex.re he
