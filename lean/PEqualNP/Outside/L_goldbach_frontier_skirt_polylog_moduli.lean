section
open Finset MeasureTheory
open scoped BigOperators Interval Classical
namespace V1e
theorem V1ws (u v : ℂ) :
    ‖u-v‖^2 ≤ 2*‖u‖^2+2*‖v‖^2 := by
  have hn := norm_sub_le u v
  have hp : 0 ≤ ‖u‖+‖v‖ := by positivity
  have hs := sq_le_sq₀ (norm_nonneg _) hp |>.2 hn
  nlinarith [sq_nonneg (‖u‖-‖v‖)]
theorem V1bp (P : ℝ → ℂ) (X h : ℝ)
    (hX : 0<X) (hh : 0≤h) (hhX : h≤X)
    (hP : ContinuousOn P (Set.Icc X (4*X))) :
    (∫ y in X..2*X, ‖P (y+h)-P y‖^2) ≤
      4*(∫ y in X..4*X, ‖P y‖^2) := by
  have hsub : Set.Icc X (2*X) ⊆ Set.Icc X (4*X) := by
    intro y hy
    exact ⟨hy.1, by linarith [hy.2]⟩
  have hshift : ContinuousOn (fun y => P (y+h)) (Set.Icc X (2*X)) := by
    apply hP.comp (continuousOn_id.add continuousOn_const)
    intro y hy
    change X≤y+h ∧ y+h≤4*X
    exact ⟨by linarith [hy.1], by linarith [hy.2]⟩
  have horig : ContinuousOn P (Set.Icc X (2*X)) := hP.mono hsub
  have hXX : X≤2*X := by linarith
  have hint1 : IntervalIntegrable (fun y => ‖P (y+h)-P y‖^2) volume X (2*X) :=
    ContinuousOn.intervalIntegrable_of_Icc hXX ((hshift.sub horig).norm.pow 2)
  have hi1 : IntervalIntegrable (fun y => 2*‖P (y+h)‖^2) volume X (2*X) :=
    ContinuousOn.intervalIntegrable_of_Icc hXX ((hshift.norm.pow 2).const_mul 2)
  have hi2 : IntervalIntegrable (fun y => 2*‖P y‖^2) volume X (2*X) :=
    ContinuousOn.intervalIntegrable_of_Icc hXX ((horig.norm.pow 2).const_mul 2)
  have hint2 : IntervalIntegrable (fun y => 2*‖P (y+h)‖^2+2*‖P y‖^2)
      volume X (2*X) := hi1.add hi2
  have hle := intervalIntegral.integral_mono hXX
    hint1 hint2 (fun y => V1ws (P (y+h)) (P y))
  rw [intervalIntegral.integral_add hi1 hi2,
    intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hle
  change (∫ y in X..2*X, ‖P (y+h)-P y‖^2) ≤
    2*(∫ y in X..2*X, ‖P (y+h)‖^2)+2*(∫ y in X..2*X, ‖P y‖^2) at hle
  rw [intervalIntegral.integral_comp_add_right (fun y => ‖P y‖^2) h] at hle
  have hbig : IntervalIntegrable (fun y => ‖P y‖^2) volume X (4*X) :=
    ContinuousOn.intervalIntegrable_of_Icc (by linarith : X≤4*X) (hP.norm.pow 2)
  have hnonneg : 0 ≤ᵐ[volume.restrict (Set.Ioc X (4*X))] (fun y => ‖P y‖^2) :=
    Filter.Eventually.of_forall (fun _ => sq_nonneg _)
  have hb1 := intervalIntegral.integral_mono_interval
    (show X≤X+h by linarith) (show X+h≤2*X+h by linarith)
    (show 2*X+h≤4*X by linarith) hnonneg hbig
  have hb2 := intervalIntegral.integral_mono_interval
    (le_refl X) (show X≤2*X by linarith) (show 2*X≤4*X by linarith)
    hnonneg hbig
  linarith
theorem Vmu {ι : Type*} (S : Finset ι) (a ρ : ι → ℂ)
    (X : ℝ) (hX : 0<X) :
    ContinuousOn (fun y : ℝ => ∑ i∈S, a i*(y : ℂ)^(ρ i)) (Set.Icc X (4*X)) := by
  apply continuousOn_finsetSum
  intro i hi
  apply continuousOn_const.mul
  intro y hy
  exact (Complex.continuousAt_ofReal_cpow_const y (ρ i)
    (Or.inr (by linarith [hy.1] : y≠0))).continuousWithinAt
noncomputable def Ve (y h : ℝ) (ρ : ℂ) : ℂ :=
  (((y+h : ℝ) : ℂ)^ρ-(y : ℂ)^ρ)/ρ
theorem V191 {ι : Type*} (S : Finset ι) (ρ : ι → ℂ)
    (y h : ℝ) :
    (∑ i∈S, Ve y h (ρ i)) =
      (∑ i∈S, (1/ρ i)*((y+h : ℝ) : ℂ)^(ρ i))-
      (∑ i∈S, (1/ρ i)*(y : ℂ)^(ρ i)) := by
  rw [← sum_sub_distrib]
  apply sum_congr rfl
  intro i hi
  dsimp [Ve]
  ring
theorem Vhl (ρ : ℂ) (T : ℝ) (hT : 0<T)
    (ht : T/2≤|ρ.im|) : ‖(1 : ℂ)/ρ‖≤2/T := by
  have hn : T/2≤‖ρ‖ := ht.trans (Complex.abs_im_le_norm ρ)
  have hp : 0<‖ρ‖ := by linarith
  rw [norm_div, norm_one]
  apply (div_le_div_iff₀ hp hT).2
  nlinarith
end V1e
