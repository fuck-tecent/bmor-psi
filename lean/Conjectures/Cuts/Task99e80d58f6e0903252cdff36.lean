  change IntegrableOn (fun t => -f' t) (Ioi a) at hineg
  dsimp only [f'] at hineg
  simpa only [neg_neg] using hineg

theorem integral_Ioi_hatTailIntegrand
    {H : Section13HatLayers} {β a : ℝ} (hH : Section13HatContract H β)
