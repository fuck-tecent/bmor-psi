namespace GoldbachSieveSeries

open Complex Finset Set MeasureTheory GoldbachCubicRiesz
open scoped Classical BigOperators

theorem principalResidueFactor_eq_totient (q : ℕ) [NeZero q] :
    principalResidueFactor q = (q.totient:ℂ)/(q:ℂ) := by
  apply (eq_div_iff (Nat.cast_ne_zero.mpr (NeZero.ne q))).2
  have h := congrArg (algebraMap ℚ ℂ) (Nat.totient_eq_mul_prod_factors q)
  simp only [map_mul,map_prod,map_sub,map_one,map_inv₀,map_natCast] at h
  simpa only [principalResidueFactor,mul_comm] using h.symm

noncomputable def sieveProductPolynomial {q : ℕ} (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) (s : ℂ) : ℂ :=
  ∑ r ∈ lcmSupport D E, LSeries.term ((fun n : ℕ => χ n)*lcmWeight D E u v) s r

theorem sieveProductPolynomial_differentiable {q : ℕ} (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) :
    Differentiable ℂ (sieveProductPolynomial χ D E u v) := by
  unfold sieveProductPolynomial
  apply Differentiable.fun_sum
  intro n _
  by_cases hn : n=0
  · simp [hn]
  simp only [LSeries.term_of_ne_zero hn]
  apply Differentiable.div (differentiable_const _)
  · exact differentiable_id.const_cpow (.inl (Nat.cast_ne_zero.mpr hn))
  · intro s
    exact Complex.cpow_ne_zero_iff.mpr (.inl (Nat.cast_ne_zero.mpr hn))

theorem norm_sieveProductPolynomial_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    (D E : Finset ℕ) (u v : ℕ → ℂ) {s : ℂ} (hs : 0 ≤ s.re) :
    ‖sieveProductPolynomial χ D E u v s‖ ≤
      ∑ n ∈ lcmSupport D E, ‖((fun n : ℕ => χ n)*lcmWeight D E u v) n‖ := by
  unfold sieveProductPolynomial
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro n _
  by_cases hn : n=0
  · simpa only [hn,LSeries.term_zero,norm_zero] using
      (norm_nonneg (((fun n : ℕ => χ n)*lcmWeight D E u v) 0))
  rw [LSeries.term_of_ne_zero hn,norm_div,Complex.norm_natCast_cpow_of_pos (Nat.pos_of_ne_zero hn)]
  exact div_le_self (norm_nonneg _) (Real.one_le_rpow (by exact_mod_cast Nat.pos_of_ne_zero hn) hs)

private theorem principal_norm_le_of_dist (q : ℕ) [NeZero q] {s : ℂ}
    (hs : 1/2 ≤ s.re) (hd : 1/2≤‖s-1‖) :
    ‖(1:DirichletCharacter ℂ q).LFunction s‖ ≤
      (2:ℝ)^q.primeFactors.card*(3+2*‖s‖) := by
  have hs₁ : s≠1 := by
    intro he
    norm_num [he] at hd
  change ‖DirichletCharacter.LFunctionTrivChar q s‖≤_
  rw [DirichletCharacter.LFunctionTrivChar_eq_mul_riemannZeta (N:=q) hs₁,norm_mul]
  have hprod : ‖∏ p ∈ q.primeFactors, (1-(p:ℂ)^(-s))‖ ≤ (2:ℝ)^q.primeFactors.card := by
    rw [norm_prod,← Finset.prod_const]
    apply Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
    intro p hp
    have hpr := Nat.prime_of_mem_primeFactors hp
    refine (norm_sub_le _ _).trans ?_
    rw [norm_one,Complex.norm_natCast_cpow_of_pos hpr.pos,Complex.neg_re]
    have hpow := Real.rpow_le_one_of_one_le_of_nonpos
      (show (1:ℝ)≤p by exact_mod_cast hpr.one_lt.le)
      (show -s.re≤0 by linarith only [hs])
    linarith only [hpow]
  exact mul_le_mul hprod (GoldbachPrincipalDensity.zeta_norm_le_of_dist hs hd) (norm_nonneg _) (by positivity)

set_option maxHeartbeats 1400000 in
/-- The finite divisor-sieve Gram sum equals the left-line integral plus the
exact principal Euler-product residue. -/
theorem sieveProduct_principal_gram_cutoff_eq {q : ℕ} [NeZero q] (ρ : ℂ)
    (hρlo : 1/2<ρ.re) (hρhi : ρ.re≤1) (hρ : ρ≠1)
    (D E : Finset ℕ) (u v : ℕ → ℂ) {Y U : ℝ} (hY : 1≤Y) (hU : 1≤U) :
    let χ : DirichletCharacter ℂ q := 1
    let P := sieveProductPolynomial χ D E u v
    let b := (fun n : ℕ => χ n)*sieveProduct D E u v
    let a : ℝ := 1/2-ρ.re
    let p : ℂ := 1-ρ
    cutoffSum (LSeries.term b ρ) Y-cutoffSum (LSeries.term b ρ) U =
      ((1/(2*Real.pi):ℝ):ℂ) *
        (∫ t : ℝ, let w : ℂ := (a:ℂ)+t*I
          gramRieszDifference Y U w*(χ.LFunction (ρ+w)*P (ρ+w))) +
      gramRieszDifference Y U p*P 1*principalResidueFactor q := by
  let χ : DirichletCharacter ℂ q := 1
  let P := sieveProductPolynomial χ D E u v
  let b := (fun n : ℕ => χ n)*sieveProduct D E u v
  let M : ℝ := ∑ n ∈ lcmSupport D E, ‖((fun n : ℕ => χ n)*lcmWeight D E u v) n‖
  let C := (2:ℝ)^q.primeFactors.card*(3+2*(‖ρ‖+1))
  let A := (Y+U)*C*M
  let B := 2*|ρ.im|+2
  have hA : 0≤A := by dsimp [A,C,M]; positivity
  have hB : 1≤B := by dsimp [B]; linarith only [abs_nonneg ρ.im]
  have hρ1 : 1 < (ρ+1).re := by rw [Complex.add_re,Complex.one_re]; linarith only [hρlo]
  have hbs : LSeriesSummable b (ρ+1) := sieveProduct_summable χ D E u v hρ1
  refine principal_gram_cutoff_eq ρ hρlo hρhi hρ P
    (sieveProductPolynomial_differentiable χ D E u v) b hbs
    (zero_lt_one.trans_le hY) (zero_lt_one.trans_le hU) hA hB ?_ ?_
  · intro t
    let w : ℂ := 1+t*I
    have hw : w.re=1 := by simp [w]
    have hs : 1<(ρ+w).re := by rw [Complex.add_re,hw]; linarith only [hρlo]
    change LSeries b (ρ+w)=χ.LFunction (ρ+w)*P (ρ+w)
    rw [mul_comm]
    exact sieveProduct_LSeries χ D E u v hs
  · intro x hx t ht
    let w : ℂ := (x:ℂ)+t*I
    have hwre : w.re=x := by simp [w]
    have hwim : w.im=t := by simp [w]
    have hre : 1/2≤(ρ+w).re := by rw [Complex.add_re,hwre]; linarith only [hx.1]
    have hdist : 1/2≤‖ρ+w-1‖ := by
      have h₁ : |t|≤|ρ.im+t|+|ρ.im| := by
        have h := abs_add_le (ρ.im+t) (-ρ.im)
        rw [abs_neg,show ρ.im+t + -ρ.im=t by ring] at h
        exact h
      have h₂ := Complex.abs_im_le_norm (ρ+w-1)
      rw [Complex.sub_im,Complex.add_im,Complex.one_im,sub_zero,hwim] at h₂
      dsimp only [B] at ht
      linarith only [h₁,h₂,ht,abs_nonneg ρ.im]
    have hx1 : |x|≤1 := abs_le.mpr ⟨by linarith only [hx.1,hρhi],hx.2⟩
    have hnorm : ‖w‖≤1+|t| := by
      apply (norm_add_le _ _).trans
      rw [norm_mul,Complex.norm_I,mul_one,Complex.norm_real,Complex.norm_real,
        Real.norm_eq_abs,Real.norm_eq_abs]
      exact add_le_add hx1 le_rfl
    have hsnorm : ‖ρ+w‖≤(‖ρ‖+1)*(1+|t|) := by
      apply (norm_add_le _ _).trans
      nlinarith only [hnorm,mul_nonneg (norm_nonneg ρ) (abs_nonneg t)]
    have hL : ‖χ.LFunction (ρ+w)‖≤C*(1+|t|) := by
      refine (principal_norm_le_of_dist q hre hdist).trans ?_
      dsimp only [C]
      rw [mul_assoc]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      nlinarith only [hsnorm,abs_nonneg t]
    have hP : ‖P (ρ+w)‖≤M := norm_sieveProductPolynomial_le χ D E u v
      ((by norm_num : (0:ℝ)≤1/2).trans hre)
    have hscale (V : ℝ) (hV : 1≤V) : ‖(V:ℂ)^w‖≤V := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos (zero_lt_one.trans_le hV),hwre]
      simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hV hx.2
    change ‖((Y:ℂ)^w-(U:ℂ)^w)*(χ.LFunction (ρ+w)*P (ρ+w))‖≤A*(1+|t|)
    rw [norm_mul,norm_mul]
    calc
      _ ≤ (Y+U)*((C*(1+|t|))*M) := by
        apply mul_le_mul ((norm_sub_le _ _).trans (add_le_add (hscale Y hY) (hscale U hU)))
          (mul_le_mul hL hP (norm_nonneg _) (by dsimp only [C]; positivity))
          (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (by positivity)
      _ = _ := by dsimp only [A]; ring

end GoldbachSieveSeries

