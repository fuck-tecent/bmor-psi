theorem eventually_modulus_moderate_rivals (K : ℕ) {H U : ℝ} (hH : 4≤H) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (R : ℝ), 0≤R → R≤U →
      ModulusWindowGrowth q K.factorial U →
      (∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
        1/2<z.re → regularizedL ψ z=0 → modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R) →
      ∀ p∈modulusZeros q H R, (∀ i∈modulusZeros q H R,i.2.re≤p.2.re) →
      p.1^2=1 → p.2.im=0 → modulusOrder p=1 →
      ∀ i : Fin 8, let t := realRivalTests i
        modulusGap q p.2≤t.largestLead →
        ∀ r∈modulusRivals K t.sameClass H R p, t.smallestRival < modulusGap q r.2 := by
  have hTests (i : Fin 8) : let t := realRivalTests i
      ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (R : ℝ), 0≤R → R≤U →
        ModulusWindowGrowth q K.factorial U →
        (∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
          1/2<z.re → regularizedL ψ z=0 → modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R) →
        ∀ p∈modulusZeros q H R, (∀ j∈modulusZeros q H R,j.2.re≤p.2.re) →
        p.1^2=1 → p.2.im=0 → modulusOrder p=1 → modulusGap q p.2≤t.largestLead →
        ∀ r∈modulusRivals K t.sameClass H R p, t.smallestRival < modulusGap q r.2 := by
    dsimp only
    refine eventually_modulus_real_rival_gap K (realRivalTests i).sameClass
      (c:=(realRivalTests i).smallestRival) (A:=(realRivalTests i).largestLead)
      (b:=(realRivalTests i).distinctB) (b':=(realRivalTests i).ownB) ?_ ?_ ?_ ?_ ?_ ?_
    all_goals fin_cases i <;> norm_num [realRivalTests,realRationalZeroKernel] <;> linarith only [hH]
  have hAll := (eventually_all_finset (univ : Finset (Fin 8))).mpr (fun i _=>hTests i)
  exact hAll.mono (fun q h _ R hR hRU G hClean p hp hP hQuad hReal hSimple i =>
    h i (mem_univ i) R hR hRU G hClean p hp hP hQuad hReal hSimple)

