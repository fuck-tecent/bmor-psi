set_option maxHeartbeats 1000000 in
/-- The center logarithmic derivative of a zero-free analytic disk function
is the signed cosine coefficient of its boundary log modulus. -/
theorem logDeriv_re_eq_cosine {f : ℂ→ℂ} {R : ℝ} (hR : 0<R)
    (hf : AnalyticOnNhd ℂ f (closedBall 0 R))
    (hn : ∀ z∈closedBall (0:ℂ) R, f z≠0) :
    (logDeriv f 0).re =
      (∫ t in 0..2*Real.pi, Real.cos t * Real.log ‖f (circleMap 0 R t)‖)/(Real.pi*R) := by
  let u : ℂ→ℝ := fun z => Real.log ‖f z‖
  have hu : HarmonicOnNhd u (closedBall (0:ℂ) R) := fun z hz =>
    (hf z hz).harmonicAt_log_norm (hn z hz)
  obtain ⟨e,he,hthick⟩ := (isCompact_closedBall (0:ℂ) R).exists_thickening_subset_open
    (isOpen_setOfPred_harmonicAt u) (show closedBall (0:ℂ) R ⊆ {z | HarmonicAt u z} from hu)
  rw [thickening_closedBall he hR.le] at hthick
  obtain ⟨G,hG,hGr⟩ := HarmonicOnNhd.exists_analyticOnNhd_ball_re_eq hthick
  have hGball : AnalyticOnNhd ℂ G (closedBall (0:ℂ) R) :=
    hG.mono (closedBall_subset_ball (by linarith only [he]))
  have h0 : (0:ℂ) ∈ closedBall (0:ℂ) R := mem_closedBall_self hR.le
  have hnf := hn 0 h0
  let H : ℂ→ℂ := fun z => Complex.log (f z/f 0)+((Real.log ‖f 0‖:ℝ):ℂ)
  have hh : HasDerivAt H (logDeriv f 0) (0:ℂ) := by
    have hfa := (hf 0 h0).differentiableAt.hasDerivAt.div_const (f 0)
    have hf1 : f 0/f 0 ∈ Complex.slitPlane := by simp [hnf]
    have h := ((Complex.hasDerivAt_log hf1).comp 0 hfa).add_const ((Real.log ‖f 0‖:ℝ):ℂ)
    have h1 : f 0/f 0=1 := div_self hnf
    simpa only [H,Function.comp_def,h1,inv_one,one_mul,logDeriv_apply] using h
  have hHr : (fun x : ℝ => (H (x:ℂ)).re) =ᶠ[𝓝 0] (fun x : ℝ => (G (x:ℂ)).re) := by
    have hPre : ∀ᶠ x : ℝ in 𝓝 0, (x:ℂ)∈ball (0:ℂ) R :=
      Complex.continuous_ofReal.continuousAt.preimage_mem_nhds (ball_mem_nhds _ hR)
    filter_upwards [hPre] with x hx
    have hx' := ball_subset_ball (show R≤e+R by linarith only [he]) hx
    change (H (x:ℂ)).re = (G (x:ℂ)).re
    rw [show (G (x:ℂ)).re=u (x:ℂ) from hGr hx']
    change (Complex.log (f (x:ℂ)/f 0)+((Real.log ‖f 0‖:ℝ):ℂ)).re=Real.log ‖f (x:ℂ)‖
    rw [Complex.add_re,Complex.log_re,Complex.ofReal_re,norm_div,
      Real.log_div (norm_ne_zero_iff.mpr (hn _ (ball_subset_closedBall hx))) (norm_ne_zero_iff.mpr hnf)]
    ring
  have hGr0 : (logDeriv f 0).re=(deriv G 0).re := by
    have hh' : HasDerivAt (fun x : ℝ => (H (x:ℂ)).re) (logDeriv f 0).re 0 :=
      hh.real_of_complex
    have hGd : HasDerivAt (fun x : ℝ => (G (x:ℂ)).re) (deriv G 0).re 0 :=
      ((hGball 0 h0).differentiableAt.hasDerivAt).real_of_complex
    exact (hh'.congr_of_eventuallyEq hHr.symm).unique hGd
  have hDiff : DiffContOnCl ℂ G (ball (0:ℂ) R) :=
    (hGball.differentiableOn.mono closure_ball_subset_closedBall).diffContOnCl
  rw [hGr0,cauchy_deriv_re_cosine hR hDiff]
  congr 1
  apply intervalIntegral.integral_congr
  intro t _
  change Real.cos t * (G (circleMap 0 R t)).re = Real.cos t * u (circleMap 0 R t)
  congr 1
  exact hGr (sphere_subset_ball (by linarith only [he]) (circleMap_mem_sphere _ hR.le _))

end

end GoldbachPintzWeightedFormula
end

