  intro _ R hR hRU G hClean p hp hP hQuad hReal hLow hHigh j hj
  obtain ⟨r,hr,hBest⟩ := exists_max_image (modulusRivals K false H R p) (fun j=>j.2.re) ⟨j,hj⟩
  have hSmall (i) (hi : i∈modulusZeros q H R) := hQ i (modulusZeros_subset le_rfl hRU hi)
  have hr' := mem_erase.mp (mem_filter.mp hr).1
  obtain ⟨hξ,hpz,_⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨_,_,hZp⟩ := (mem_exceptionalZeros _ _ _).mp hpz
  obtain ⟨hχ,hrz,_⟩ := mem_fixed_modulus_zeros.mp hr'.2
  obtain ⟨_,hγR,hZr⟩ := (mem_exceptionalZeros _ _ _).mp hrz
