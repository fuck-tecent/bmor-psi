private theorem norm_LSeries_le_zeta_pole {f : ℕ → ℂ} (hf : ∀ n, ‖f n‖≤1)
    {s : ℂ} (hs : 1<s.re) : ‖LSeries f s‖≤1+(s.re-1)⁻¹ := by
  have hsum : LSeriesSummable f s :=
    LSeriesSummable_of_bounded_of_one_lt_re (fun n _ => hf n) hs
  have hZ := (Real.summable_nat_rpow_inv (p:=s.re)).mpr hs
  have hn (n : ℕ) : ‖LSeries.term f s n‖≤((n:ℝ)^s.re)⁻¹ := by
    rw [LSeries.norm_term_eq]
    split_ifs with h
    · positivity
    · rw [← one_div]
      exact div_le_div_of_nonneg_right (hf n) (by positivity)
  have he : realZetaSeries (1+(s.re-1)) ≤ 1+(s.re-1)⁻¹ :=
    real_zeta_one_add_le (sub_pos.mpr hs)
  rw [show 1+(s.re-1)=s.re by ring] at he
  exact (norm_tsum_le_tsum_norm hsum.norm).trans
    ((hsum.norm.tsum_le_tsum hn hZ).trans he)

/-- The elementary Euler bound for the modulus of a character L-function
and its reciprocal throughout the open right half-plane. -/
theorem euler_LFunction_two_sided {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {s : ℂ} (hs : 1<s.re) :
    (1+(s.re-1)⁻¹)⁻¹ ≤ ‖χ.LFunction s‖ ∧ ‖χ.LFunction s‖ ≤ 1+(s.re-1)⁻¹ := by
  let B := 1+(s.re-1)⁻¹
  have hB : 0<B := by dsimp only [B]; positivity [sub_pos.mpr hs]
  have hχB := norm_LSeries_le_zeta_pole (f:=(fun n : ℕ => χ n)) (fun n => χ.norm_le_one _) hs
  have hμ (n : ℕ) : ‖((fun n : ℕ => χ n) * (fun n : ℕ => ((ArithmeticFunction.moebius n : ℤ) : ℂ)) : ℕ → ℂ) n‖≤1 := by
    rw [Pi.mul_apply,norm_mul]
    apply mul_le_one₀ (χ.norm_le_one _) (norm_nonneg _)
    change ‖((ArithmeticFunction.moebius n:ℤ):ℂ)‖≤1
    rw [Complex.norm_intCast]
    exact_mod_cast (ArithmeticFunction.abs_moebius_le_one (n:=n))
  have hμB := norm_LSeries_le_zeta_pole hμ hs
  have hProd := congrArg norm (DirichletCharacter.LSeries.mul_mu_eq_one χ hs)
  rw [norm_mul,norm_one,← DirichletCharacter.LFunction_eq_LSeries χ hs] at hProd
  rw [← DirichletCharacter.LFunction_eq_LSeries χ hs] at hχB
  refine ⟨(inv_le_iff_one_le_mul₀ hB).mpr ?_,hχB⟩
  have h : 1 ≤ ‖χ.LFunction s‖*B := by
    calc
      _ = ‖χ.LFunction s‖*‖LSeries ((fun n : ℕ => χ n) * (fun n : ℕ => ((ArithmeticFunction.moebius n : ℤ) : ℂ))) s‖ := hProd.symm
      _ ≤ _ := mul_le_mul_of_nonneg_left hμB (norm_nonneg (χ.LFunction s))
  simpa only [mul_comm] using h

/-- Logarithmic modulus bound on the arc with real part greater than one. -/
theorem euler_log_modulus_bound {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    {s : ℂ} (hs : 1<s.re) :
    |Real.log ‖χ.LFunction s‖| ≤ Real.log (1+(s.re-1)⁻¹) := by
  obtain ⟨hL,hU⟩ := euler_LFunction_two_sided χ hs
  have hB : 0<1+(s.re-1)⁻¹ := by positivity [sub_pos.mpr hs]
  have hL₀ := (inv_pos.mpr hB).trans_le hL
  have h := Real.log_le_log (inv_pos.mpr hB) hL
  rw [Real.log_inv] at h
  exact abs_le.mpr ⟨h,Real.log_le_log hL₀ hU⟩

end
end GoldbachPintzWeightedFormula
end

