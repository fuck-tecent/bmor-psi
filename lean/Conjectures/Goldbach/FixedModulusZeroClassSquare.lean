  have h0 := tendsto_rational_primeSum_RationalFourTerm (1:DirichletCharacter ℂ q) b L σ 0 hs
  have hξ' := tendsto_rational_primeSum_RationalFourTerm ξ b L σ 0 hs
  have h1 := tendsto_rational_primeSum_RationalFourTerm χ b L σ t hs
  have hξ1 := tendsto_rational_primeSum_RationalFourTerm (ξ*χ) b L σ t hs
  exact ge_of_tendsto' (((h0.add hξ').add h1).add hξ1) fun N =>
    quadratic_four_primeSum_nonneg ξ χ hξ (Finset.range N) _
      (fun n _=>rational_primeWeight_nat_nonneg hb hL n) σ t

