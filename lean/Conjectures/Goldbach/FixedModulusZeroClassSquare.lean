namespace GoldbachBurgess

open scoped ArithmeticFunction.omega

theorem norm_completeBalancedCorrelation_sq_of_primePowers
    (a : Fin 4 → ℤ) (U V q : ℕ) [NeZero q]
    (h : ∀ p k : ℕ, p.Prime → 0<k → ∀ [NeZero (p^k)]
      (χ : DirichletCharacter ℂ (p^k)), χ.IsPrimitive →
      ‖completeBalancedCorrelation χ a‖^2 ≤
        64*(p^k:ℕ)*(Nat.gcd (p^k) U)*(Nat.gcd (p^k) V))
    (χ : DirichletCharacter ℂ q) (hc : χ.IsPrimitive) :
    ‖completeBalancedCorrelation χ a‖^2 ≤
      (64:ℝ)^(ω q)*q*(Nat.gcd q U)*(Nat.gcd q V) := by
  let P (n : ℕ) := ∀ [NeZero n] (ξ : DirichletCharacter ℂ n), ξ.IsPrimitive →
    ‖completeBalancedCorrelation ξ a‖^2 ≤
      (64:ℝ)^(ω n)*n*(Nat.gcd n U)*(Nat.gcd n V)
  have hAll : ∀ n, P n := by
    apply Nat.recOnPosPrimePosCoprime
    · intro p k hp hk h0 ξ hξ
      simpa [ArithmeticFunction.cardDistinctFactors_apply_prime_pow hp hk.ne'] using
        h p k hp hk ξ hξ
    · intro z
      exact (NeZero.ne 0 rfl).elim
    · intro z ξ hξ
      have hNorm : ‖completeBalancedCorrelation ξ a‖ ≤ 1 := by
        simpa using norm_completeBalancedCorrelation_le_nat ξ a
      simp only [show ω 1=0 by simp, pow_zero, Nat.cast_one, Nat.gcd_one_left, mul_one]
      nlinarith only [hNorm,norm_nonneg (completeBalancedCorrelation ξ a),
        mul_nonneg (norm_nonneg (completeBalancedCorrelation ξ a))
          (sub_nonneg.mpr hNorm)]
    · intro m n hm hn hmn ih₁ ih₂ z ξ hξ
      haveI : NeZero m := ⟨by omega⟩
      haveI : NeZero n := ⟨by omega⟩
      obtain ⟨ξ₁,ξ₂,h₁,h₂,hfact⟩ := exists_primitive_balanced_crt_parts hmn ξ hξ
      rw [hfact a,norm_mul,mul_pow,ArithmeticFunction.cardDistinctFactors_mul hmn,
        pow_add]
      have hg (T : ℕ) : (m*n).gcd T=m.gcd T*n.gcd T := by
        simpa only [Nat.gcd_comm] using hmn.gcd_mul T
      rw [hg U,hg V]
      have hB₁ := ih₁ ξ₁ h₁
      have hB₂ := ih₂ ξ₂ h₂
      have hh := mul_le_mul hB₁ hB₂ (by positivity) (by positivity)
      push_cast
      exact hh.trans_eq (by ring)
  exact hAll q χ hc

end GoldbachBurgess
