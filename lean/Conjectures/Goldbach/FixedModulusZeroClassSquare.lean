noncomputable section

private theorem Lpartial_harmonic_power_le_sharp_height {q : ℕ} (χ : DirichletCharacter ℂ q)
    (s : ℂ) {N : ℕ} (hN : 1≤N) :
    ‖Lpartial χ N s‖ ≤ (N:ℝ)^(max 0 (1-s.re))*(1+Real.log N) := by
  let p := max 0 (1-s.re)
  have hp : 0≤p := le_max_left _ _
  have hN₁ : (1:ℝ)≤N := by exact_mod_cast hN
  have hsum : (∑ n ∈ Icc 1 N, (n:ℝ)⁻¹) ≤ 1+Real.log N := by
    have he : (∑ n ∈ Icc 1 N, (n:ℝ)⁻¹) = (harmonic N:ℝ) := by
      simp only [harmonic,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast]
      rw [← Finset.Ico_succ_right_eq_Icc]
      change (∑ n ∈ Ico 1 (N+1), (n:ℝ)⁻¹) = _
      exact (by simpa only [Nat.Ico_zero_eq_range,zero_add,Nat.add_comm] using
        (Finset.sum_Ico_add (fun n : ℕ => (n:ℝ)⁻¹) 0 N 1).symm)
    rw [he]
    exact harmonic_le_one_add_log N
  rw [Lpartial]
  calc
    _ ≤ ∑ n ∈ Icc 1 N, ((n:ℝ)^(-s.re)) := by
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro n hn
      rw [norm_mul,Complex.norm_natCast_cpow_of_pos (mem_Icc.mp hn).1,Complex.neg_re]
      exact mul_le_of_le_one_left (by positivity) (χ.norm_le_one _)
    _ ≤ ∑ n ∈ Icc 1 N, (N:ℝ)^p*(n:ℝ)⁻¹ := by
      apply sum_le_sum
      intro n hn
      have hn₁ : (1:ℝ)≤n := by exact_mod_cast (mem_Icc.mp hn).1
      have hn₀ := zero_lt_one.trans_le hn₁
      have hnN : (n:ℝ)≤N := by exact_mod_cast (mem_Icc.mp hn).2
      calc
        _ = (n:ℝ)^(1-s.re)*(n:ℝ)⁻¹ := by
          rw [← Real.rpow_neg_one,←Real.rpow_add hn₀]
          congr 1
          ring
        _ ≤ _ := mul_le_mul_of_nonneg_right
          ((Real.rpow_le_rpow_of_exponent_le hn₁ (le_max_right _ _)).trans
            (Real.rpow_le_rpow hn₀.le hnN hp)) (by positivity)
    _ ≤ _ := by
      rw [← mul_sum]
      exact mul_le_mul_of_nonneg_left hsum (by positivity)


set_option maxHeartbeats 1100000 in
/-- Keep the truncation scale to the power `max 0 (1 - s.re)` in
the uniform strip transfer, for integration along vertical contours. -/
theorem nonprincipal_LFunction_uniform_strip_sharp_height_of_two_thirds_prefix
    {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (hχ : χ≠1)
    {A Q φ T : ℝ} (hA : 1≤A) (hQ : 1≤Q) (hφ : 0≤φ) (hT : 0≤T)
    (hprefix : ∀ n : ℕ, ‖charPartialSum χ n‖≤(A*Q^(φ/3))*(n:ℝ)^(2/3:ℝ))
    {s : ℂ} (hlo : (3/4:ℝ) ≤ s.re) (hhi : s.re≤3/2) (him : |s.im|≤T) :
    let C := prefixGrowthScale A T
    ‖χ.LFunction s‖≤(C^(max 0 (1-s.re))*(2+Real.log C+φ*Real.log Q))*Q^(φ*max 0 (1-s.re)) := by
  intro C
  let D : ℝ := 24*(1+T)*A
  let Y : ℝ := D^3*Q^φ
  let N := ⌈Y⌉₊
  let p : ℝ := max 0 (1-s.re)
  have hD : 1≤D := by
    have h' : 1≤1+T := by linarith only [hT]
    have hT' := one_le_mul_of_one_le_of_one_le h' hA
    dsimp [D]
    nlinarith only [hT']
  have hD0 := zero_lt_one.trans_le hD
  have hC : 1≤C := by
    change (1:ℝ)≤2*D^3
    nlinarith only [one_le_pow₀ hD (n:=3)]
  have hC0 := zero_lt_one.trans_le hC
  have hQ0 := zero_lt_one.trans_le hQ
  have hp : 0≤p := le_max_left _ _
  have hY : 1≤Y := one_le_mul_of_one_le_of_one_le (one_le_pow₀ hD) (Real.one_le_rpow hQ hφ)
  have hN : 1≤N := by exact_mod_cast hY.trans (Nat.le_ceil Y)
  have hN1 : (1:ℝ)≤N := by exact_mod_cast hN
  have hN0 := zero_lt_one.trans_le hN1
  have hNBound : (N:ℝ)≤C*Q^φ := calc
    _ ≤ Y+1 := (Nat.ceil_lt_add_one (zero_le_one.trans hY)).le
    _ ≤ 2*Y := by linarith only [hY]
    _ = _ := by change 2*(D^3*Q^φ)=(2*D^3)*Q^φ; ring
  have hs : (2/3:ℝ)<s.re := by linarith only [hlo]
  have hs0 : 0<s.re := by linarith only [hlo]
  have hsNorm : ‖s‖≤3/2+T := by
    calc
      _ = ‖(s.re:ℂ)+(s.im:ℂ)*I‖ := congrArg norm (Complex.re_add_im s).symm
      _ ≤ ‖(s.re:ℂ)‖+‖(s.im:ℂ)*I‖ := norm_add_le _ _
      _ ≤ _ := by
        rw [norm_mul,norm_I,mul_one,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,
          Real.norm_eq_abs,abs_of_pos hs0]
        linarith only [hhi,him]
  have hsCoef : 1+‖s‖/(s.re-2/3)≤24*(1+T) := by
    have hden : (1/12:ℝ) ≤ s.re-2/3 := by linarith only [hlo]
    have hd := (div_le_iff₀ (sub_pos.mpr hs)).mpr (
      hsNorm.trans (show 3/2+T ≤ (18+12*T)*(s.re-2/3) by
        have hh := mul_le_mul_of_nonneg_left hden (by positivity : 0≤18+12*T)
        nlinarith only [hh]))
    linarith only [hd,hT]
  have hEqScale : Y^(1/3:ℝ)=D*Q^(φ/3) := by
    unfold Y
    rw [Real.mul_rpow (pow_nonneg hD0.le _) (Real.rpow_nonneg hQ0.le _),
      ←Real.rpow_mul hQ0.le,←Real.rpow_natCast_mul hD0.le]
    norm_num only [Nat.cast_ofNat]
    rw [Real.rpow_one,show φ*(1/3)=φ/3 by ring]
  have hTailCoef : (A*Q^(φ/3))*(1+‖s‖/(s.re-2/3))≤(N:ℝ)^(1/3:ℝ) := calc
    _ ≤ (A*Q^(φ/3))*(24*(1+T)) :=
      mul_le_mul_of_nonneg_left hsCoef (by positivity)
    _ = Y^(1/3:ℝ) := by rw [hEqScale]; unfold D; ring
    _ ≤ _ := Real.rpow_le_rpow (zero_le_one.trans hY) (Nat.le_ceil Y) (by norm_num)
  have hTail := nonprincipal_truncation_of_power_partial_sum χ hχ
    (B:=A*Q^(φ/3)) (a:=(2/3:ℝ)) (by positivity) (by norm_num) hprefix hs hN
  have hTail' : ‖χ.LFunction s-Lpartial χ N s‖≤(N:ℝ)^p := calc
    _ ≤ (A*Q^(φ/3))*(1+‖s‖/(s.re-2/3))*(N:ℝ)^(2/3-s.re) := hTail
    _ ≤ (N:ℝ)^(1/3:ℝ)*(N:ℝ)^(2/3-s.re) :=
      mul_le_mul_of_nonneg_right hTailCoef (by positivity)
    _ = (N:ℝ)^(1-s.re) := by
      rw [←Real.rpow_add hN0]
      congr 1
      ring
    _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hN1 (le_max_right _ _)
  have hPart := Lpartial_harmonic_power_le_sharp_height χ s hN
  have hTotal : ‖χ.LFunction s‖≤(N:ℝ)^p*(2+Real.log (N:ℝ)) := by
    have hh := (norm_add_le (χ.LFunction s-Lpartial χ N s) (Lpartial χ N s)).trans
      (add_le_add hTail' hPart)
    rw [sub_add_cancel] at hh
    exact hh.trans_eq (by ring)
  have hExp : (N:ℝ)^p≤C^p*Q^(φ*p) := calc
    _ ≤ (C*Q^φ)^p := Real.rpow_le_rpow hN0.le hNBound hp
    _ = _ := by rw [Real.mul_rpow hC0.le (Real.rpow_nonneg hQ0.le _),←Real.rpow_mul hQ0.le]
  have hLogN := Real.log_le_log hN0 hNBound
  rw [Real.log_mul hC0.ne' (Real.rpow_pos_of_pos hQ0 φ).ne',Real.log_rpow hQ0] at hLogN
  refine hTotal.trans ((mul_le_mul hExp (by linarith only [hLogN] :
    2+Real.log (N:ℝ)≤2+Real.log C+φ*Real.log Q)
    (by linarith only [Real.log_nonneg hN1]) (by positivity)).trans_eq ?_)
  change (C^p*Q^(φ*p))*(2+Real.log C+φ*Real.log Q)=(C^p*(2+Real.log C+φ*Real.log Q))*Q^(φ*p)
  ring

/-- Near-one growth for arbitrary nonprincipal characters, with any
fixed conductor exponent above three eighths. -/
theorem nonprincipal_LFunction_uniform_strip_sharp_height_of_primitive_fourth_moment
    (hMoment : HasPrimitiveBurgessFourthMoment) {φ : ℝ} (hφ : 3/8 < φ) :
    ∃ A : ℝ, 1≤A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → ∀ {T : ℝ}, 0≤T → ∀ s : ℂ,
      3/4 ≤ s.re → s.re ≤ 3/2 → |s.im| ≤ T →
      ‖χ.LFunction s‖≤((prefixGrowthScale A T)^(max 0 (1-s.re))*
        (2+Real.log (prefixGrowthScale A T)+φ*Real.log (q:ℝ)))*
        (q:ℝ)^(φ*max 0 (1-s.re)) := by
  let δ := 2*φ/5-3/20
  have hδ : 0<δ := by unfold δ; linarith only [hφ]
  have hp : 0≤φ := by linarith only [hφ]
  obtain ⟨A,hA,hP⟩ := nonprincipal_prefix_burgess_of_fourth_moment hMoment hδ
  let B := A^(5/6:ℝ)
  have hB : 1≤B := Real.one_le_rpow hA (by norm_num)
  refine ⟨B,hB,?_⟩
  intro q _ χ hχ T hT
  have hQ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hPrefix : ∀ n : ℕ, ‖charPartialSum χ n‖≤B*(q:ℝ)^(φ/3)*(n:ℝ)^(2/3:ℝ) := by
    apply prefix_bound_of_three_fifths_prefix hA hQ (norm_charPartialSum_le χ)
    intro n
    have h := hP q χ hχ n
    rwa [show 3/20+δ=2*φ/5 by unfold δ; ring] at h
  intro s
  exact nonprincipal_LFunction_uniform_strip_sharp_height_of_two_thirds_prefix χ hχ hB hQ hp hT hPrefix (s:=s)


end

