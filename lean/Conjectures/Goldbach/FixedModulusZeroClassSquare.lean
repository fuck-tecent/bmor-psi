namespace GoldbachPrincipalPintz

open Finset Filter Complex Goldbach GoldbachSieveSeries GoldbachDensityDetector
open scoped Topology


theorem zeta_near_zero_height_eventually {K p : ℝ} (hK : 0 < K) (hp : 0 ≤ p) :
    ∀ᶠ X : ℝ in atTop, ∀ ρ : ℂ, regularizedL (1 : DirichletCharacter ℂ 1) ρ = 0 →
      1-ρ.re < K*Real.log (Real.log X)/Real.log X →
      (Real.log X)^p < |ρ.im| := by
  obtain ⟨c,hc,hZF⟩ := GoldbachZeroFree.principal_zero_gap_of_height_le
  let B := p+Real.log 6
  have hB : 0 < B := add_pos_of_nonneg_of_pos hp (Real.log_pos (by norm_num))
  have hasym := isLittleO_log_rpow_rpow_atTop (s:=1) (2:ℝ) zero_lt_one
  have hsmall₀ := hasym.bound (show 0 < c/(K*B) by positivity)
  have hloglarge : ∀ᶠ X : ℝ in atTop, Real.exp 1 ≤ Real.log X :=
    Real.tendsto_log_atTop.eventually_ge_atTop (Real.exp 1)
  filter_upwards [Real.tendsto_log_atTop.eventually hsmall₀,hloglarge] with X hsmall hLarge ρ hzero hgap
  let L := Real.log X
  have hL : 0 < L := (Real.exp_pos _).trans_le hLarge
  have hLL : 1 ≤ Real.log L := by rw [← Real.log_exp 1]; exact Real.log_le_log (Real.exp_pos _) hLarge
  have hL1 : 1 ≤ L := (Real.one_lt_exp_iff.mpr zero_lt_one).le.trans hLarge
  have hLpow : 1 ≤ L^p := Real.one_le_rpow hL1 hp
  have hsq : (Real.log L)^2 ≤ (c/(K*B))*L := by
    change ‖(Real.log L)^(2:ℝ)‖ ≤ (c/(K*B))*‖L^(1:ℝ)‖ at hsmall
    rw [Real.rpow_ofNat, Real.rpow_one, Real.norm_of_nonneg (sq_nonneg _),
      Real.norm_of_nonneg hL.le] at hsmall
    exact hsmall
  have hscale : B*Real.log L ≤ c*L/(K*Real.log L) := by
    apply (le_div_iff₀ (mul_pos hK (zero_lt_one.trans_le hLL))).mpr
    have hmul := mul_le_mul_of_nonneg_left hsq (mul_pos hK hB).le
    have hdiv : K*B*(c/(K*B)) = c := mul_div_cancel₀ c (mul_pos hK hB).ne'
    rw [← mul_assoc,hdiv] at hmul
    nlinarith only [hmul]
  by_contra! ht
  have hH : logHeight 1 ρ.im ≤ B*Real.log L := by
    unfold logHeight
    have hfactor : (2:ℝ)*(1:ℕ)*(2+|ρ.im|) ≤ 6*L^p := by
      push_cast
      nlinarith only [ht,hLpow]
    calc
      _ ≤ Real.log (6*L^p) := Real.log_le_log (by positivity) hfactor
      _ = Real.log 6+p*Real.log L := by rw [Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hL p).ne',Real.log_rpow hL]
      _ ≤ _ := by
        dsimp [B]
        nlinarith only [mul_nonneg (Real.log_nonneg (show (1:ℝ)≤6 by norm_num)) (sub_nonneg.mpr hLL)]
  exact (not_le_of_gt hgap) (hZF ρ K X hzero
    hK hL (zero_lt_one.trans_le hLL) (hH.trans hscale))


end GoldbachPrincipalPintz

end

