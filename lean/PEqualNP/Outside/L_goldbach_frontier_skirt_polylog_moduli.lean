  rw [← Real.sqrt_eq_rpow] at hsmall
  simp only [Nat.cast_mul, Nat.cast_ofNat]
  apply hsimple.trans
  apply (le_div_iff₀ hLP).2
  calc
    _ = 12*Real.sqrt (X : ℝ)*(Real.log (X : ℝ))^(A+1) := by rw [pow_succ]; ring
    _ ≤ 12*Real.sqrt (X : ℝ)*((ε/12)*Real.sqrt (X : ℝ)) :=
