noncomputable section

/-- The single-character estimate with the cutoff and normalization used in the family table. -/
def CharacterDiagonalEstimate (A E : ℝ) : Prop :=
  ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ ≠ 1 →
    ∀ (Q : ℕ), q ≤ Q → ∀ {δ T W U Y : ℝ}, 0 ≤ δ → δ ≤ 1/8 → 0 ≤ T →
    1 < W → 4 ≤ Real.log Y → logHeight Q (T+2) ≤ 4*Real.log Y →
    Real.log Y ≤ (3/loss)*Real.log W → 1 ≤ U → U ≤ Y →
    ∀ (θ : ℕ → ℝ), (∀ d, |θ d| ≤ 1) →
    (((q^2:ℕ).totient:ℝ)/((q^2:ℕ):ℝ)) * quadratic (support W) θ (q^2) ≤ 16/Real.log W →
    ∀ (S : Finset ℂ), (∀ s ∈ S, 1-δ ≤ s.re ∧ s.re < 1 ∧ |s.im| ≤ T ∧ χ.LFunction s = 0) →
    ∀ r ∈ S, (∑ s ∈ S, (analyticOrderNatAt (regularizedL χ) s:ℝ)*
      ‖gramSum (support Y) (differenceWeight Y U) (realDivisorWeight (support W) θ)
        (fun n => χ (n:ZMod q)) (fun n => χ (n:ZMod q)) r s‖) ≤
      A*Y^(2*δ)*(1+δ*logHeight Q (T+2))*(1+Real.log (1+(S.card:ℝ))) +
        E*W*U^(-1/2+2*δ)*(q:ℝ)^loss*(1+2*T)^(1/2:ℝ)*
          (∑ s ∈ S, (analyticOrderNatAt (regularizedL χ) s:ℝ))

private theorem canonical_same_column_error_scale {q Q : ℕ} (hq : 1 ≤ q) (hqQ : q ≤ Q)
    {T δ : ℝ} (hT : 1 ≤ T) (hδ : δ ≤ loss) :
    let W := thetaScale (Q:ℝ) T
    let U := lowerScale (Q:ℝ) T
    W*U^(-1/2+2*δ)*(q:ℝ)^loss*(1+2*T)^(1/2:ℝ) ≤ 2*((Q:ℝ)*(T+1))^(-3*loss) := by
  dsimp only
  have hq₁ : (1:ℝ) ≤ q := by exact_mod_cast hq
  have hqQ' : (q:ℝ) ≤ Q := by exact_mod_cast hqQ
  have hQ := hq₁.trans hqQ'
  have hLoss : 0 ≤ loss := by unfold loss; norm_num
  have hpow : (q:ℝ)^loss ≤ (Q:ℝ)^(1/2+loss) :=
    (Real.rpow_le_rpow (Nat.cast_nonneg _) hqQ' hLoss).trans
      (Real.rpow_le_rpow_of_exponent_le hQ (by linarith))
  have ht' : (1+2*T)^(1/2:ℝ) ≤ 2*(T+1)^(1/2:ℝ) := by
    simp only [← Real.sqrt_eq_rpow]
    apply (Real.sqrt_le_sqrt (by linarith only [hT] : 1+2*T ≤ 4*(T+1))).trans_eq
    rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 4)]
    rw [show Real.sqrt 4 = (2:ℝ) by rw [show (4:ℝ)=2^2 by norm_num, Real.sqrt_sq (by norm_num)]]
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  have hW : 0 < W := thetaScale_pos _ _
  have hU : 0 < U := lowerScale_pos _ _
  calc
    _ ≤ W*U^(-1/2+2*δ)*(Q:ℝ)^(1/2+loss)*(2*(T+1)^(1/2:ℝ)) := by
      gcongr
    _ = 2*(W*U^(-1/2+2*δ)*(Q:ℝ)^(1/2+loss)*(T+1)^(1/2:ℝ)) := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_left (comparison_error_scale hQ hT hδ) (by norm_num)

set_option maxHeartbeats 1000000 in
/-- Transport a single-character Gram estimate into the exact finite family, preserving orders. -/
theorem canonical_diagonal_of_character {A E : ℝ} (hA : 0 ≤ A) (hE : 0 ≤ E)
    (hchar : CharacterDiagonalEstimate A E) (Q : ℕ) (hQ : 1 ≤ Q)
    {δ T : ℝ} (hδ : 0 ≤ δ) (hδ' : δ ≤ loss) (hT : 1 ≤ T)
    (hlarge : 4 ≤ Real.log ((Q:ℝ)*(T+1)))
    (θ : ℕ → ℝ) (hθ : ∀ d, |θ d| ≤ 1)
    (hθq : ∀ q : ℕ, 0 < q → ((q.totient:ℝ)/(q:ℝ)) * quadratic (support (thetaScale (Q:ℝ) T)) θ q ≤
      16/Real.log (thetaScale (Q:ℝ) T)) : canonicalDiagonalBound A (2*E) Q δ T θ := by
  intro Z hZ r hr
  let q := level r
  let χ := r.1.2
  let S := columnZeros Z r
  let H := (Q:ℝ)*(T+1)
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let Y := upperScale (Q:ℝ) T
  let J : ℝ := ∑ s ∈ Z,(order s:ℝ)
  have hq : 0 < q := Nat.zero_lt_succ _
  let _ : NeZero q := ⟨hq.ne'⟩
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  have hQ₀ := zero_lt_one.trans_le hQ₁
  have hT₁ : 1 ≤ T+1 := by linarith
  have hT₀ := zero_lt_one.trans_le hT₁
  have hlog : Real.log H = Real.log (Q:ℝ)+Real.log (T+1) := Real.log_mul hQ₀.ne' hT₀.ne'
  have hLoss : 0 < loss := by unfold loss; norm_num
  obtain ⟨hU,_,hUV,hVY,_,_,hupper⟩ := scale_relations hQ₁ hT
  have hU₁ : 1 ≤ U := (by norm_num : (1:ℝ) ≤ 2).trans hU
  have hUY : U ≤ Y := hUV.le.trans hVY
  have hY₀ : 0 ≤ Y := (zero_le_one.trans hU₁).trans hUY
  have hlogY : 4 ≤ Real.log Y := by
    have hq' := Real.log_nonneg hQ₁
    have ht := Real.log_nonneg hT₁
    rw [← show H = (Q:ℝ)*(T+1) by rfl, hlog] at hlarge
    simp only [Y,upperScale,Real.log_exp,upperLog,loss]
    linarith only [hlarge,hq',ht]
  have hlogW : Real.log W = loss*Real.log H := by
    simp only [W,thetaScale,Real.log_exp,thetaLog,hlog]
  have hW : 1 < W := (scale_relations hQ₁ hT).2.1
  have hH₁ : 1 ≤ Real.log (Q:ℝ)+Real.log (T+1) := by
    rw [← hlog]
    linarith only [hlarge]
  have hHeight : logHeight Q (T+2) ≤ 4*Real.log Y := by
    simpa only [Y,upperScale,Real.log_exp] using
      logHeight_le_four_upperLog hQ (by linarith only [hT]) hH₁
  have hYupper : Real.log Y ≤ (3/loss)*Real.log W := by
    rw [hlogW]
    rw [show (3/loss)*(loss*Real.log H) = 3*Real.log H by field_simp [hLoss.ne']]
    exact hupper
  have hχ : χ ≠ 1 := (family_mem_geometry (hZ hr)).2.1
  have hδ'' : δ ≤ (1:ℝ)/8 := by unfold loss at hδ'; linarith only [hδ']
  have hgeom (s : ℂ) (hs : s ∈ S) :
      1-δ ≤ s.re ∧ s.re < 1 ∧ |s.im| ≤ T ∧ χ.LFunction s = 0 := by
    have hmem := hZ (mem_columnZeros.mp hs)
    obtain ⟨_,_,hb,hb',ht,hz₀,hz⟩ := family_mem_geometry hmem
    have hb'' : s.re < 1 := lt_of_not_ge fun hb₁ =>
      (χ.LFunction_ne_zero_of_one_le_re (.inl hχ) hb₁) hz
    exact ⟨hb,hb'',ht,hz⟩
  have hrS : r.2 ∈ S := mem_columnZeros.mpr (by simpa only [Sigma.eta] using hr)
  have hx := hchar q χ hχ Q (level_le r) hδ hδ'' (by linarith only [hT])
    hW hlogY hHeight hYupper hU₁ hUY θ hθ (hθq (q^2) (pow_pos hq _)) S hgeom r.2 hrS
  have hJ₀ : 0 ≤ J := sum_nonneg fun s _ => Nat.cast_nonneg _
  have hm : (∑ s ∈ S,(analyticOrderNatAt (regularizedL χ) s:ℝ)) ≤ J := by
    change (∑ s ∈ columnZeros Z r, (order (⟨r.1,s⟩ : TaggedZero Q):ℝ)) ≤ J
    rw [← sum_column_eq Z r (fun s => (order s:ℝ))]
    exact sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun s _ _ => Nat.cast_nonneg _
  have hlogJ : 1+Real.log (1+(S.card:ℝ)) ≤ 1+Real.log (1+J) :=
    (add_le_add) le_rfl (Real.log_le_log (by positivity) (add_le_add le_rfl (card_column_le_order hZ r)))
  have hHeight₀ : 0 ≤ 1+δ*logHeight Q (T+2) := by
    let _ : NeZero Q := ⟨(Nat.ne_of_gt (Nat.zero_lt_one.trans_le hQ))⟩
    have hh := logHeight_ge_one Q (T+2)
    nlinarith only [mul_nonneg hδ (zero_le_one.trans hh)]
  have hE' : E*W*U^(-1/2+2*δ)*(q:ℝ)^loss*(1+2*T)^(1/2:ℝ) ≤
      (2*E)*H^(-3*loss) := calc
    _ = E*(W*U^(-1/2+2*δ)*(q:ℝ)^loss*(1+2*T)^(1/2:ℝ)) := by ring
    _ ≤ E*(2*H^(-3*loss)) :=
      mul_le_mul_of_nonneg_left (canonical_same_column_error_scale hq (level_le r) hT hδ') hE
    _ = _ := by ring
  rw [sum_column_eq]
  have heq (s : ℂ) :
      canonicalGram T θ r ⟨r.1,s⟩ =
        gramSum (support Y) (differenceWeight Y U) (realDivisorWeight (support W) θ)
          (fun n => χ (n:ZMod q)) (fun n => χ (n:ZMod q)) r.2 s := by
    unfold canonicalGram
    rw [primitiveGram_eq_gramSum]
    rfl
  simp only [heq]
  exact hx.trans (add_le_add
    (mul_le_mul_of_nonneg_left hlogJ
      (mul_nonneg (mul_nonneg hA (Real.rpow_nonneg hY₀ _)) hHeight₀))
    (mul_le_mul hE' hm
      (sum_nonneg fun s _ => Nat.cast_nonneg _) (by positivity)))

end
end GoldbachPintzFamily

