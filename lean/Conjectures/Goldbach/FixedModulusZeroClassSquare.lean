noncomputable section

/-- The same-column norm estimate with the actual Gram and an error per zero. -/
def canonicalDiagonalBound (A E : ℝ) (Q : ℕ) (δ T : ℝ) (θ : ℕ → ℝ) : Prop :=
  ∀ (Z : Finset (TaggedZero Q)), Z ⊆ familyZeroTags Q (1-δ) T →
    ∀ r ∈ Z,
    (∑ s ∈ Z.filter (fun s => column s = column r),(order s:ℝ)*‖canonicalGram T θ r s‖) ≤
      A*(upperScale (Q:ℝ) T)^(2*δ)*(1+δ*logHeight Q (T+2))*
        (1+Real.log (1+∑ s ∈ Z,(order s:ℝ))) +
      E*((Q:ℝ)*(T+1))^(-3*loss)*(∑ s ∈ Z,(order s:ℝ))

private theorem canonical_eventually_small {CD CE : ℝ} :
    ∀ᶠ H : ℝ in atTop, 4 ≤ Real.log H ∧ Real.log 16 / loss ≤ Real.log H ∧
      CD*H^(-4*loss) ≤ 1/8 ∧ CE*H^(-3*loss)/(1/8:ℝ)^2 ≤ 1/2 := by
  have hD := tendsto_rpow_neg_atTop (by unfold loss; norm_num : 0 < 4*loss)
  have hE := tendsto_rpow_neg_atTop (by unfold loss; norm_num : 0 < 3*loss)
  have hD' : Tendsto (fun H : ℝ => CD*H^(-4*loss)) atTop (𝓝 0) := by
    simpa only [neg_mul, mul_zero] using hD.const_mul CD
  have hE' : Tendsto (fun H : ℝ => CE*H^(-3*loss)/(1/8:ℝ)^2) atTop (𝓝 0) := by
    simpa only [neg_mul, mul_zero, zero_div] using (hE.const_mul CE).div_const ((1/8:ℝ)^2)
  filter_upwards [Real.tendsto_log_atTop.eventually_ge_atTop 4,
    Real.tendsto_log_atTop.eventually_ge_atTop (Real.log 16 / loss),
    hD'.eventually_lt_const (by norm_num : (0:ℝ) < 1/8),
    hE'.eventually_lt_const (by norm_num : (0:ℝ) < 1/2)] with H h₁ h₂ h₃ h₄
  exact ⟨h₁,h₂,h₃.le,h₄.le⟩

set_option maxHeartbeats 1000000 in
/-- Log-free nonprincipal density from the actual diagonal row estimate. -/
theorem canonical_nonprincipal_count {A E : ℝ}
    (hA : 0 ≤ A) :
    ∃ C H₀ : ℝ, 0 < C ∧ ∀ (Q : ℕ), 1 ≤ Q → ∀ {δ T : ℝ}, 0 ≤ δ → δ ≤ loss → 1 ≤ T →
      H₀ ≤ (Q:ℝ)*(T+1) →
      (4 ≤ Real.log ((Q:ℝ)*(T+1)) → ∀ θ : ℕ → ℝ, θ 1 = 1 → (∀ d, |θ d| ≤ 1) →
        (∀ d : ℕ, thetaScale (Q:ℝ) T < (d:ℝ) → θ d = 0) →
        (∀ q : ℕ, 0 < q → ((q.totient:ℝ)/(q:ℝ)) * quadratic (support (thetaScale (Q:ℝ) T)) θ q ≤
          16/Real.log (thetaScale (Q:ℝ) T)) → canonicalDiagonalBound A E Q δ T θ) →
      ∀ Z : Finset (TaggedZero Q), Z ⊆ familyZeroTags Q (1-δ) T →
      (∑ r ∈ Z,(order r:ℝ)) ≤ C*((Q:ℝ)^3*(T+1)^4)^((1+1/100:ℝ)*δ) := by
  obtain ⟨CD,hCD,hdet⟩ := canonical_detector_lower
  obtain ⟨CO,hCO,hoff⟩ := canonical_off_column_error
  have hLoss : 0 < loss := by unfold loss; norm_num
  obtain ⟨L,H₁,hL,hnormBound⟩ :=
    GoldbachGrahamDiagonal.canonical_compact_harmonic_from_graham
  obtain ⟨C,hC,hcount⟩ := tagged_count_of_full_height_rows (L:=L) (K:=4) (τ:=1/8) (ε:=1/200)
    hA (by norm_num) hL.le (by norm_num) (by norm_num)
  obtain ⟨H₀,hlarge⟩ := eventually_atTop.1 (canonical_eventually_small (CD:=CD) (CE:=L*(E+CO)))
  refine ⟨C,max H₀ H₁,hC,?_⟩
  intro Q hQ δ T hδ hδ₁ hT hH hdiag Z hZ
  let W := thetaScale (Q:ℝ) T
  let U := lowerScale (Q:ℝ) T
  let V := U*W
  let Y := upperScale (Q:ℝ) T
  let H := (Q:ℝ)*(T+1)
  let J : ℝ := ∑ s ∈ Z,(order s:ℝ)
  let w := differenceWeight Y U
  let ψ := barbanVehov U V
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  have hQ₀ := zero_lt_one.trans_le hQ₁
  have hT₀ : 0 < T+1 := by linarith only [hT]
  have hH₀ : 0 < H := mul_pos hQ₀ hT₀
  have hlog : Real.log H = Real.log (Q:ℝ)+Real.log (T+1) := Real.log_mul hQ₀.ne' hT₀.ne'
  obtain ⟨hL₁,hL₁₆,hDetE,hGramE⟩ := hlarge H ((le_max_left H₀ H₁).trans hH)
  have hloss : 0 < loss := by unfold loss; norm_num
  have hW : 16 ≤ W := by
    change 16 ≤ Real.exp (thetaLog (Real.log (Q:ℝ)) (Real.log (T+1)))
    rw [← Real.exp_log (by norm_num : 0 < (16:ℝ))]
    apply Real.exp_le_exp.mpr
    unfold thetaLog
    rw [← hlog]
    linarith only [(div_le_iff₀ hloss).mp hL₁₆]
  obtain ⟨θ,hθ₁,hθ,hθsupport,hθq⟩ := exists_theta_real_of_sharp hW
  obtain ⟨hU,_,hUV,hVY,hnum,hden,_⟩ := scale_relations hQ₁ hT
  have hU₀ : 0 < U := by linarith only [hU]
  have hUY : U ≤ Y := hUV.le.trans hVY
  have hY : 1 ≤ Y := (by norm_num : (1:ℝ) ≤ 2).trans (hU.trans hUY)
  have hlogY : 4 ≤ Real.log Y := by
    have hq := Real.log_nonneg hQ₁
    have ht := Real.log_nonneg (show 1 ≤ T+1 by linarith only [hT])
    rw [hlog] at hL₁
    simp only [Y,upperScale,Real.log_exp,upperLog,loss]
    linarith only [hL₁,hq,ht]
  have hnorm : canonicalHarmonic Q T ≤ L :=
    hnormBound Q hQ (zero_le_one.trans hT) ((le_max_right H₀ H₁).trans hH)
  have hHeight : logHeight Q (T+2) ≤ 4*Real.log Y := by
    simpa only [Y,upperScale,Real.log_exp] using
      logHeight_le_four_upperLog hQ (by linarith only [hT]) (hlog ▸ (show 1 ≤ Real.log H from (by norm_num : (1:ℝ) ≤ 4).trans hL₁))
  have hErr : L*((E+CO)*H^(-3*loss))/(1/8:ℝ)^2 ≤ 1/2 := by
    rw [← mul_assoc]
    exact hGramE
  have hDet (r : TaggedZero Q) (hr : r ∈ Z) :
      (1/8:ℝ) ≤ ‖primitiveDetector (support Y) (support V) (support W) w ψ θ r‖ := by
    change (1/8:ℝ) ≤ ‖canonicalDetector T θ r‖
    linarith only [hdet Q hQ hδ₁ hT θ hθ₁ hθ r (hZ hr),hDetE]
  have hRow (r : TaggedZero Q) (hr : r ∈ Z) :
      (∑ s ∈ Z, (order s:ℝ)*‖primitiveGram (support Y) (support W) w θ r s‖) ≤
        A*Y^(2*δ)*(1+δ*logHeight Q (T+2))*(1+Real.log (1+J))+
          ((E+CO)*H^(-3*loss))*J := by
    change (∑ s ∈ Z,(order s:ℝ)*‖canonicalGram T θ r s‖) ≤ _
    have hd := hdiag hL₁ θ hθ₁ hθ hθsupport hθq Z hZ r hr
    have ho (s : TaggedZero Q) (hs : s ∈ Z) (hcol : column s ≠ column r) :
        ‖canonicalGram T θ r s‖ ≤ CO*H^(-3*loss) :=
      hoff Q hQ hδ₁ hT θ hθ r (hZ hr) s (hZ hs) hcol.symm
    have hx := full_row_of_column_errors Z order column (canonicalGram T θ)
      (ed:=E*H^(-3*loss)) (eo:=CO*H^(-3*loss))
      (r:=r) (mul_nonneg hCO.le (Real.rpow_nonneg hH₀.le _)) (by
        convert hd using 1
        apply sum_congr
        · apply filter_congr_decidable
        · intro _ _; rfl) ho
    exact hx.trans_eq (by dsimp only [Y,J]; ring)
  have hCount := hcount Q hδ hY hHeight Z (support V) (support W) w ψ θ
    ((E+CO)*H^(-3*loss)) hErr (fun n _ => (differenceWeight_bounds hU₀ hUY n).1)
    hnorm hDet hRow
  exact hCount.trans (mul_le_mul_of_nonneg_left
    (upperLog_density_scale hQ (by linarith only [hT]) hδ) hC.le)

end
end GoldbachPintzFamily

