  intro z hzK
  by_cases hz : z∈S
  · have hsum : AnalyticAt ℂ (fun s => ∑ w∈S.erase z,C w/(s-w)) z := by
      apply (S.erase z).analyticAt_fun_sum
      intro w hw
      exact (show AnalyticAt ℂ (fun _ : ℂ => C w) z from analyticAt_const).div
        (show AnalyticAt ℂ (fun s : ℂ => s-w) z from analyticAt_id.sub analyticAt_const)
        (sub_ne_zero.mpr (Finset.ne_of_mem_erase hw).symm)
    apply ((hR ⟨z,hz⟩).add hsum).congr
    have hav : ∀ᶠ s in 𝓝 z,s∉S.erase z :=
      (S.erase z).finite_toSet.isClosed.isOpen_compl.mem_nhds (by simp)
    have he : ∀ᶠ s in 𝓝 z,s≠z → f s+C z/(s-z)=R ⟨z,hz⟩ s := by
      simpa only [mem_compl_iff,mem_singleton_iff] using
        (eventually_nhdsWithin_iff.mp (heR ⟨z,hz⟩))
