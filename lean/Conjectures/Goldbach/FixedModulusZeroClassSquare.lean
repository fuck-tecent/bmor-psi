section

namespace GoldbachPintzScales

noncomputable def loss : ℝ := 1/10000

/-- The logarithms of the two sieve cutoffs and the Riesz length.
Here x and y are the logarithms of the conductor and height bounds. -/
noncomputable def thetaLog (x y : ℝ) : ℝ := loss*(x+y)
noncomputable def lowerLog (x y : ℝ) : ℝ := (1+16*loss)*(x+y)
noncomputable def upperLog (x y : ℝ) : ℝ := (3/2)*x+2*y+32*loss*(x+y)

theorem off_diagonal_exponent_le {x y δ : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y)
    (hδ : δ ≤ loss) :
    (-1/2+2*δ)*lowerLog x y + thetaLog x y + (1/2+loss)*x+(1/2)*y ≤
      -3*loss*(x+y) := by
  have hu : 0 ≤ lowerLog x y := by unfold lowerLog loss; positivity
  have h := mul_le_mul_of_nonneg_right
    (show -1/2+2*δ ≤ (-1/2+2*loss:ℝ) by linarith only [hδ]) hu
  unfold lowerLog thetaLog loss at *
  nlinarith only [h,hx,hy]

theorem detector_exponent_le {x y δ : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y)
    (hδ : δ ≤ loss) :
    (-1/2+δ)*upperLog x y + (1/2)*lowerLog x y + thetaLog x y +
      (1/4+loss/2)*x+(1/2)*y ≤ -4*loss*(x+y) := by
  have hu : 0 ≤ upperLog x y := by unfold upperLog loss; positivity
  have h := mul_le_mul_of_nonneg_right
    (show -1/2+δ ≤ (-1/2+loss:ℝ) by linarith only [hδ]) hu
  unfold upperLog lowerLog thetaLog loss at *
  nlinarith only [h,hx,hy]

theorem cutoff_log_comparison {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    lowerLog x y+thetaLog x y ≤ upperLog x y ∧
    2*lowerLog x y+thetaLog x y ≤ 2*upperLog x y ∧
    (loss/3)*upperLog x y ≤ thetaLog x y := by
  unfold lowerLog upperLog thetaLog loss
  constructor
  · linarith only [hx,hy]
  · constructor <;> linarith only [hx,hy]

theorem density_exponent_le {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    2*(1+1/200)*upperLog x y ≤ (1+1/100)*(3*x+4*y) := by
  unfold upperLog loss
  linarith only [hx,hy]

end GoldbachPintzScales

end

