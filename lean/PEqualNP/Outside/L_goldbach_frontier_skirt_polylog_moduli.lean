    (hf : ∀ z∈K, z∉S → AnalyticAt ℂ f z) :
    ∃ F : ℂ → ℂ, AnalyticOnNhd ℂ F K ∧
      ∀ z∉S,F z=f z+∑ w∈S,C w/(z-w) := by
  choose R hR heR using fun z : {z : ℂ // z∈S} => hreg z.1 z.2
  let F : ℂ → ℂ := fun z => if hz : z∈S then
    R ⟨z,hz⟩ z+∑ w∈S.erase z,C w/(z-w)
    else f z+∑ w∈S,C w/(z-w)
