import Mathlib
import PEqualNP.Outside.L_goldbach_frontier_skirt_polylog_moduli

/-! Formalization of the upper-exponent branch of Theorem 1.2 of
D. Koukoulopoulos, *Primes in short arithmetic progressions* (arXiv:1405.6592).
The final theorem discharges the upper-branch estimate via a multiplicative grid.
-/

namespace ShortAP
open Filter
open scoped Topology

noncomputable section

def theta (q : ℕ) [NeZero q] (r : ZMod q) (y h : ℝ) : ℝ :=
  ∑ k ∈ (Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊).filter (fun k : ℕ => (k : ZMod q) = r),
    if k.Prime then Real.log (k : ℝ) else 0

def err (q : ℕ) (h y : ℝ) : ℝ :=
  if hq : q = 0 then 0 else
    letI : NeZero q := ⟨hq⟩
    Finset.univ.sup' Finset.univ_nonempty (fun r : ZMod q =>
      if IsUnit r then |theta q r y h - h / (q.totient : ℝ)| else 0)

theorem mem_window {y h : ℝ} (hy : 0 ≤ y) (hh : 0 ≤ h) (k : ℕ) :
    k ∈ Finset.Icc (⌊y⌋₊ + 1) ⌊y+h⌋₊ ↔ y < (k : ℝ) ∧ (k : ℝ) ≤ y+h := by
  rw [Finset.mem_Icc, Nat.add_one_le_iff, Nat.floor_lt hy, Nat.le_floor_iff (by linarith)]

theorem err_le_iff {q : ℕ} [NeZero q] (y h B : ℝ) (hB : 0 ≤ B) :
    err q h y ≤ B ↔ ∀ a : (ZMod q)ˣ, |theta q a y h - h / (q.totient : ℝ)| ≤ B := by
  classical
  simp only [err, dite_eq_right (NeZero.ne q), Finset.sup'_le_iff, Finset.mem_univ, true_implies]
  constructor
  · intro H a
    simpa only [ite_eq_left a.isUnit] using H (a : ZMod q)
  · intro H r
    by_cases hr : IsUnit r
    · obtain ⟨a, rfl⟩ := hr
      simpa only [ite_eq_left a.isUnit] using H a
    · simpa only [ite_eq_right hr] using hB

/-- Orthogonality reduction for the actual short prime sum. The principal
character alone carries the subtraction of the expected mass. -/
theorem err_le_twisted_mean (q : ℕ) [NeZero q] (y h : ℝ) :
    err q h y ≤ (∑ χ : DirichletCharacter ℂ q,
      ‖(∑ k ∈ Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊,
        ((if k.Prime then Real.log (k : ℝ) else 0 : ℝ) : ℂ) * χ (k : ZMod q)) -
        (if χ = 1 then (h : ℂ) else 0)‖) / (q.totient : ℝ) := by
  classical
  let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
  let w (k : ℕ) : ℝ := if k.Prime then Real.log (k : ℝ) else 0
  let T (χ : DirichletCharacter ℂ q) := (∑ k ∈ s, (w k : ℂ) * χ (k : ZMod q)) -
    (if χ = 1 then (h : ℂ) else 0)
  change err q h y ≤ (∑ χ, ‖T χ‖) / (q.totient : ℝ)
  have hφ : 0 < (q.totient : ℝ) := by exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  apply (err_le_iff y h _ (by positivity)).2
  intro a
  let u := (a : ZMod q)⁻¹
  have hu : IsUnit u := by simp [u, ZMod.inv_coe_unit]
  have hm : (∑ χ : DirichletCharacter ℂ q, χ u * (if χ = 1 then (h : ℂ) else 0)) = h := by
    simp [mul_ite, MulChar.one_apply hu]
  have hs : (∑ χ : DirichletCharacter ℂ q, χ u * (∑ k ∈ s, (w k : ℂ) * χ (k : ZMod q))) =
      (q.totient : ℂ) * (theta q a y h : ℂ) := by
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    have hh (k : ℕ) : (∑ χ : DirichletCharacter ℂ q, χ u * ((w k : ℂ) * χ (k : ZMod q))) =
        (if (k : ZMod q) = a then (q.totient : ℂ) * w k else 0) := by
      simp_rw [mul_left_comm ( _ : ℂ) (w k : ℂ)]
      rw [← Finset.mul_sum, DirichletCharacter.sum_char_inv_mul_char_eq ℂ a.isUnit]
      by_cases heq : (a : ZMod q) = k
      · simp [heq, mul_comm]
      · simp [heq, Ne.symm heq]
    simp_rw [hh]
    simp only [theta, Finset.sum_filter, Complex.ofReal_sum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun k _ => by split_ifs <;> simp_all [w]
  have he : (∑ χ : DirichletCharacter ℂ q, χ u * T χ) =
      (((q.totient : ℝ) * (theta q a y h - h / (q.totient : ℝ)) : ℝ) : ℂ) := by
    simp only [T, mul_sub, Finset.sum_sub_distrib, hs, hm]
    push_cast
    have hz : (q.totient : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hφ)
    field_simp [hz]
  have hb := norm_sum_le (Finset.univ : Finset (DirichletCharacter ℂ q)) (fun χ => χ u * T χ)
  rw [he, Complex.norm_real, Real.norm_eq_abs, abs_mul, abs_of_pos hφ] at hb
  rw [le_div_iff₀ hφ, mul_comm]
  apply hb.trans
  apply Finset.sum_le_sum
  intro χ _
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one u)

/-- The analytic estimate needed from the high-exponent branch. Constants must
be chosen *before* the interval exponent and modulus range. -/
def UpperBranch (A : ℕ) (ε : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∃ X : ℕ, ∀ x t : ℝ, (X : ℝ) ≤ x → 1 ≤ x →
    1/6 + 2*ε ≤ t → 5/8 ≤ t → t ≤ 1 → ∀ Q : ℕ, 1 ≤ Q →
    (Q : ℝ)^2 ≤ x^t / x^((1-t)/3+ε) →
    intervalIntegral (fun y => ∑ q ∈ Finset.Icc 1 Q, err q (x^t) y) x (2*x)
      MeasureTheory.volume ≤ C * (x^t*x) / (Real.log x)^A

/-- Diameter of a logarithmic window in the ordinary coefficient index.
This keeps the length term of a static large sieve of size N/T, not N. -/
theorem log_window_diameter {N T m n : ℝ} (hT : 0 < T) (hm : 0 < m)
    (hn : 0 < n) (hN : n ≤ N) (hw : Real.log n - Real.log m ≤ 1/T) :
    n-m ≤ N/T := by
  have h := Real.log_le_sub_one_of_pos (div_pos hm hn)
  rw [Real.log_div hm.ne' hn.ne'] at h
  have hd : 1 - m/n ≤ 1/T := by linarith
  have hmul := mul_le_mul_of_nonneg_right hd hn.le
  calc n-m = (1-m/n)*n := by field_simp
       _ ≤ (1/T)*n := hmul
       _ ≤ N/T := by simpa [div_eq_mul_inv, mul_comm] using
                         (div_le_div_of_nonneg_right hN hT.le)

open MeasureTheory

/-- The real part of the box multiplier stays bounded away from zero on
the entire band |t| ≤ T; this is the pointwise step in the Fourier cutoff. -/
theorem box_multiplier {T t : ℝ} (hT : 0 < T) (ht : |t| ≤ T) :
    1/(2*T) ≤ ∫ y : ℝ in 0..1/T, Real.cos (t*y) := by
  have h := intervalIntegral.integral_mono_on (μ := volume) (a := 0) (b := 1/T) (one_div_nonneg.mpr hT.le)
    (f := fun _ : ℝ => (1/2 : ℝ)) (g := fun y => Real.cos (t*y))
    intervalIntegrable_const ((by fun_prop : Continuous (fun y : ℝ => Real.cos (t*y))).intervalIntegrable ..)
    (by
      intro y hy
      have hp : |t*y| ≤ 1 := by
        rw [abs_mul, abs_of_nonneg hy.1]
        calc |t| * y ≤ T*(1/T) := mul_le_mul ht hy.2 hy.1 hT.le
             _ = _ := by field_simp
      obtain ⟨hl, hu⟩ := abs_le.mp hp
      nlinarith [Real.one_sub_sq_div_two_le_cos (x := t*y),
        mul_nonneg (sub_nonneg.mpr hu) (show 0 ≤ 1 + t*y by linarith)])
  rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at h
  convert h using 1
  ring

/-- For a Gallagher cutoff in log-coordinates each coefficient occurs in
windows of total measure exactly 1/T. -/
theorem log_window_mass (s : Finset ℕ) (w : ℕ → ℝ) {T : ℝ} (hT : 0 < T) :
    (∫ y : ℝ, ∑ n ∈ s, (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator
      (fun _ : ℝ => w n) y) = (1/T) * ∑ n ∈ s, w n := by
  have hi (n : ℕ) : Integrable ((Set.Ioc (Real.log n-1/T) (Real.log n)).indicator
      (fun _ : ℝ => w n)) := by
    rw [integrable_indicator_iff measurableSet_Ioc]
    exact continuous_const.integrableOn_Ioc
  rw [integral_finsetSum _ fun n _ => hi n, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n _
  rw [integral_indicator_const _ measurableSet_Ioc, Real.volume_real_Ioc_of_le (by
    linarith [one_div_pos.mpr hT]), smul_eq_mul]
  ring

open FourierTransform
open scoped SchwartzMap FourierTransform ContDiff

private theorem test_fourier_swap {f : ℝ → ℂ} (hf : Integrable f) (g : 𝓢(ℝ, ℂ)) :
    (∫ x, (𝓕 f) x • g x) = ∫ x, f x • (𝓕 g) x := by
  simpa using! VectorFourier.integral_fourierIntegral_smul_eq_flip (L := innerₗ ℝ)
    Real.continuous_fourierChar continuous_inner hf g.integrable

private theorem ae_eq_of_schwartz_test {u v : ℝ → ℂ}
    (hu : LocallyIntegrable u volume) (hv : LocallyIntegrable v volume)
    (h : ∀ φ : 𝓢(ℝ, ℂ), (∫ x, φ x * u x) = ∫ x, φ x * v x) :
    u =ᵐ[volume] v := by
  apply ae_eq_of_integral_contDiff_smul_eq hu hv
  intro g hg hgc
  let φ := (hgc.comp_left (show Complex.ofRealCLM 0 = 0 by simp)).toSchwartzMap
    (show ContDiff ℝ ∞ (Complex.ofRealCLM ∘ g) by fun_prop)
  simp only [RCLike.real_smul_eq_coe_mul]
  exact h φ

private theorem lp_test (v : Lp ℂ 2 (volume : Measure ℝ)) (φ : 𝓢(ℝ, ℂ)) :
    (∫ x, (𝓕 φ) x • v x) = ∫ x, φ x • (𝓕 v) x := calc
  _ = Lp.toTemperedDistribution v (𝓕 φ) := (Lp.toTemperedDistribution_apply ..).symm
  _ = (𝓕 (Lp.toTemperedDistribution v)) φ := rfl
  _ = Lp.toTemperedDistribution (𝓕 v) φ := by rw [Lp.fourier_toTemperedDistribution_eq]
  _ = _ := Lp.toTemperedDistribution_apply ..

/-- Identify the ordinary Fourier integral with the L² transform by testing
against compactly supported smooth functions. Box functions need not be smooth. -/
private theorem fourier_agrees {f : ℝ → ℂ} (h₁ : Integrable f) (h₂ : MemLp f 2) :
    (𝓕 f) =ᵐ[volume] (𝓕 (h₂.toLp f) : Lp ℂ 2 (volume : Measure ℝ)) := by
  let v := h₂.toLp f
  have hc : Continuous (𝓕 f) := VectorFourier.fourierIntegral_continuous
    Real.continuous_fourierChar (innerSL ℝ).continuous₂ h₁
  apply ae_eq_of_schwartz_test hc.locallyIntegrable
    ((Lp.memLp (𝓕 v)).locallyIntegrable (by norm_num))
  intro φ
  have A := test_fourier_swap (f := f) h₁ φ
  have B := lp_test v φ
  simp only [smul_eq_mul] at A B
  have C : (∫ x : ℝ, f x * (𝓕 φ) x) = ∫ x : ℝ, (𝓕 φ) x * v x := by
    apply integral_congr_ae
    filter_upwards [h₂.coeFn_toLp] with x hx
    change f x * (𝓕 φ) x = (𝓕 φ) x * (h₂.toLp f) x
    rw [hx, mul_comm]
  have D : (∫ x : ℝ, φ x * (𝓕 f) x) = ∫ x : ℝ, (𝓕 f) x * φ x :=
    integral_congr_ae (ae_of_all _ fun x => mul_comm ..)
  exact D.trans (A.trans (C.trans B))

private theorem lp_energy (f : Lp ℂ 2 (volume : Measure ℝ)) :
    ∫ x, ‖f x‖^2 = ‖f‖^2 := by
  conv_rhs => rw [norm_sq_eq_re_inner (𝕜 := ℂ), MeasureTheory.L2.inner_def,
    ← integral_re (MeasureTheory.L2.integrable_inner (𝕜 := ℂ) f f)]
  exact integral_congr_ae (ae_of_all _ fun x => norm_sq_eq_re_inner (𝕜 := ℂ) (f x))

private theorem box_plancherel {f : ℝ → ℂ} (h₁ : Integrable f) (h₂ : MemLp f 2) :
    Integrable (fun ξ => ‖𝓕 f ξ‖^2) ∧ (∫ ξ, ‖𝓕 f ξ‖^2) = ∫ x, ‖f x‖^2 := by
  let v := h₂.toLp f
  have he := fourier_agrees h₁ h₂
  have hae : (fun ξ => ‖𝓕 f ξ‖^2) =ᵐ[volume] (fun ξ => ‖(𝓕 v) ξ‖^2) := by
    filter_upwards [he] with ξ h using congrArg (fun z : ℂ => ‖z‖^2) h
  refine ⟨((Lp.memLp (𝓕 v)).norm.integrable_sq).congr hae.symm, ?_⟩
  rw [integral_congr_ae hae, lp_energy, Lp.norm_fourier_eq, ← lp_energy]
  apply integral_congr_ae
  filter_upwards [h₂.coeFn_toLp] with x h using congrArg (fun z : ℂ => ‖z‖^2) h

private def phase (t y : ℝ) : ℂ := Complex.exp (((-t*y : ℝ) : ℂ)*Complex.I)

private def boxKernel (T t : ℝ) : ℂ := ∫ u : ℝ in 0..1/T, phase t (-u)

private theorem kernel_norm {T t : ℝ} (hT : 0 < T) (ht : |t| ≤ T) :
    1/(2*T) ≤ ‖boxKernel T t‖ := by
  have hb := box_multiplier hT ht
  have hc : Continuous (fun u : ℝ => phase t (-u)) := by unfold phase; fun_prop
  have hm : (boxKernel T t).re = ∫ u : ℝ in 0..1/T, Real.cos (t*u) := by
    rw [boxKernel, intervalIntegral.integral_of_le (by positivity),
      intervalIntegral.integral_of_le (by positivity)]
    change RCLike.re (∫ u in Set.Ioc 0 (1/T), phase t (-u)) = _
    rw [← integral_re (hc.integrableOn_Ioc)]
    simp [phase, Complex.exp_re]
  exact hb.trans (hm ▸ Complex.re_le_norm _)

private def boxes (s : Finset ℕ) (a : ℕ → ℝ) (c : ℕ → ℂ) (T y : ℝ) : ℂ :=
  ∑ n ∈ s, (Set.Ioc (a n-1/T) (a n)).indicator (fun _ : ℝ => c n) y

private theorem boxes_transform (s : Finset ℕ) (a : ℕ → ℝ) (c : ℕ → ℂ)
    {T : ℝ} (hT : 0 < T) (t : ℝ) :
    𝓕 (boxes s a c T) (t/(2*Real.pi)) =
      boxKernel T t * (∑ n ∈ s, phase t (a n) * c n) := by
  have hfreq (y : ℝ) : -2 * Real.pi * y * (t/(2*Real.pi)) = -t*y := by
    field_simp
  rw [Real.fourier_real_eq_integral_exp_smul]
  simp_rw [hfreq, smul_eq_mul]
  change (∫ y, phase t y * boxes s a c T y) = _
  let W (n : ℕ) := Set.Ioc (a n-1/T) (a n)
  have hfun (y : ℝ) : phase t y * boxes s a c T y =
      ∑ n ∈ s, (W n).indicator (fun v => phase t v * c n) y := by
    unfold boxes
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro n _
    by_cases h : y ∈ W n <;> simp [W] at h ⊢ <;> simp_all [Set.indicator]
  have hc (n : ℕ) : Continuous (fun v => phase t v * c n) := by unfold phase; fun_prop
  simp_rw [hfun]
  rw [integral_finsetSum _ (fun n _ => (integrable_indicator_iff measurableSet_Ioc).2
    (hc n).integrableOn_Ioc), Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n _
  rw [integral_indicator measurableSet_Ioc]
  change (∫ y in Set.Ioc (a n-1/T) (a n), phase t y * c n) = _
  rw [← intervalIntegral.integral_of_le (by linarith [one_div_pos.mpr hT])]
  have sh := intervalIntegral.integral_comp_sub_left (fun v => phase t v * c n)
    (a := 0) (b := 1/T) (a n)
  rw [sub_zero] at sh
  rw [← sh, boxKernel, ← intervalIntegral.integral_mul_const]
  apply intervalIntegral.integral_congr
  intro u _
  have hs : phase t (a n-u) = phase t (-u) * phase t (a n) := by
    unfold phase
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  dsimp only
  rw [hs, mul_assoc]

/-- Sharp-window Fourier cutoff for arbitrary real centers and complex
coefficients, with angular frequency t (Mathlib Fourier frequency t/(2π)). -/
theorem finite_fourier_cutoff (s : Finset ℕ) (a : ℕ → ℝ) (c : ℕ → ℂ)
    {T : ℝ} (hT : 0 < T) :
    (∫ t : ℝ in -T..T, ‖∑ n ∈ s, phase t (a n) * c n‖^2) ≤
      (8*Real.pi)*T^2 * ∫ y, ‖boxes s a c T y‖^2 := by
  let f := boxes s a c T
  let P (t : ℝ) := ∑ n ∈ s, phase t (a n) * c n
  have hi : Integrable f := integrable_finsetSum s fun n _ =>
    (integrable_indicator_iff measurableSet_Ioc).2 continuous_const.integrableOn_Ioc
  have hm : MemLp f 2 := memLp_finsetSum s fun n _ =>
    memLp_indicator_const 2 measurableSet_Ioc.nullMeasurableSet (c n) (.inr measure_Ioc_lt_top.ne)
  obtain ⟨hfi,henergy⟩ := box_plancherel hi hm
  have h2π : 0 < 2*Real.pi := by positivity
  have hsc := (integrable_comp_div_iff (fun ξ => ‖𝓕 f ξ‖^2) h2π.ne').2 hfi
  have hpt (t : ℝ) (ht : |t| ≤ T) : ‖P t‖^2 ≤ (2*T)^2 * ‖𝓕 f (t/(2*Real.pi))‖^2 := by
    have hk := (div_le_iff₀ (by positivity : 0 < 2*T)).mp (kernel_norm hT ht)
    have h := mul_le_mul_of_nonneg_right hk (norm_nonneg (P t))
    rw [one_mul] at h
    rw [show 𝓕 f (t/(2*Real.pi)) = boxKernel T t * P t from boxes_transform s a c hT t,
      norm_mul, ← mul_pow]
    apply pow_le_pow_left₀ (norm_nonneg _) _ 2
    convert h using 1
    ring
  have hp : Continuous (fun t => ‖P t‖^2) := by unfold P phase; fun_prop
  rw [intervalIntegral.integral_of_le (by linarith : -T ≤ T)]
  calc
    _ ≤ ∫ t in Set.Ioc (-T) T, (2*T)^2 * ‖𝓕 f (t/(2*Real.pi))‖^2 := by
      apply setIntegral_mono_on hp.integrableOn_Ioc (hsc.const_mul _).integrableOn measurableSet_Ioc
      intro t ht
      exact hpt t (abs_le.mpr ⟨ht.1.le, ht.2⟩)
    _ ≤ ∫ t : ℝ, (2*T)^2 * ‖𝓕 f (t/(2*Real.pi))‖^2 :=
      setIntegral_le_integral (hsc.const_mul _) (ae_of_all _ fun _ => by positivity)
    _ = _ := by
      rw [integral_const_mul, Measure.integral_comp_div (fun ξ => ‖𝓕 f ξ‖^2), abs_of_pos h2π,
        smul_eq_mul, henergy]
      ring

/-- Exact log-window Plancherel identity, in the direction from physical
short sums to frequency estimates. The half-open interval is (v,v+1/T]. -/
theorem window_plancherel (s : Finset ℕ) (a : ℕ → ℝ) (c : ℕ → ℂ)
    {T : ℝ} (hT : 0 < T) :
    (2*Real.pi) * (∫ v : ℝ, ‖∑ n ∈ s.filter (fun n => v < a n ∧ a n ≤ v+1/T), c n‖^2) =
      ∫ t : ℝ, ‖boxKernel T t * ∑ n ∈ s, phase t (a n) * c n‖^2 := by
  classical
  let f := boxes s a c T
  have hi : Integrable f := integrable_finsetSum s fun n _ =>
    (integrable_indicator_iff measurableSet_Ioc).2 continuous_const.integrableOn_Ioc
  have hm : MemLp f 2 := memLp_finsetSum s fun n _ =>
    memLp_indicator_const 2 measurableSet_Ioc.nullMeasurableSet (c n) (.inr measure_Ioc_lt_top.ne)
  have hwin : (∫ v : ℝ, ‖∑ n ∈ s.filter (fun n => v < a n ∧ a n ≤ v+1/T), c n‖^2) =
      ∫ v, ‖f v‖^2 := by
    apply integral_congr_ae
    have hsets : ∀ᵐ v : ℝ, ∀ n ∈ s, v ∈ Set.Ico (a n-1/T) (a n) ↔ v ∈ Set.Ioc (a n-1/T) (a n) :=
      (Filter.eventually_all_finset s).2 fun n _ => Ico_ae_eq_Ioc
    filter_upwards [hsets] with v hv
    congr 2
    rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro n hn
    have he : (v < a n ∧ a n ≤ v+1/T) ↔ v ∈ Set.Ioc (a n-1/T) (a n) := by
      rw [← hv n hn, Set.mem_Ico]; constructor <;> intro h <;> constructor <;> linarith [h.1,h.2]
    simp only [Set.indicator_apply, he]
  have h2π : 0 < 2*Real.pi := by positivity
  rw [hwin, ← (box_plancherel hi hm).2]
  calc
    _ = ∫ t : ℝ, ‖𝓕 f (t/(2*Real.pi))‖^2 := by
      rw [Measure.integral_comp_div (fun ξ => ‖𝓕 f ξ‖^2), abs_of_pos h2π, smul_eq_mul]
    _ = _ := integral_congr_ae (ae_of_all _ fun t => congrArg (fun z : ℂ => ‖z‖^2)
      (boxes_transform s a c hT t))

/-- The sharp log-window multiplier supplies the high-frequency 1/|t| gain. -/
theorem boxKernel_upper {T t : ℝ} (hT : 0 < T) (ht : t ≠ 0) :
    ‖boxKernel T t‖ ≤ min (1/T) (2/|t|) := by
  let z : ℂ := (t : ℂ)*Complex.I
  have hz : z ≠ 0 := mul_ne_zero (Complex.ofReal_ne_zero.mpr ht) Complex.I_ne_zero
  have he (u : ℝ) : phase t (-u) = Complex.exp (z*u) := by
    unfold phase z
    congr 1
    push_cast
    ring
  have hu (u : ℝ) : ‖Complex.exp (z*u)‖ = 1 := by
    simp [z, Complex.norm_exp]
  unfold boxKernel
  simp_rw [he]
  apply le_min
  · have hb := intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := 1/T) (C := 1) (f := fun u : ℝ => Complex.exp (z*u))
        (fun u _ => (hu u).le)
    simpa [abs_of_pos hT] using hb
  · rw [integral_exp_mul_complex hz, norm_div]
    have hden : ‖z‖ = |t| := by simp [z]
    rw [hden]
    apply div_le_div_of_nonneg_right _ (abs_nonneg _)
    exact (norm_sub_le _ _).trans (by rw [hu,hu]; norm_num)

theorem boxKernel_decay {T : ℝ} (hT : 0 < T) (t : ℝ) :
    ‖boxKernel T t‖ ≤ 3/(T+|t|) := by
  by_cases ht : t = 0
  · subst t
    have h0 : boxKernel T 0 = ((1/T : ℝ) : ℂ) := by simp [boxKernel,phase]
    rw [h0, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr hT), abs_zero, add_zero]
    gcongr; norm_num
  · have hk := boxKernel_upper hT ht
    have h₁ := (le_div_iff₀ hT).1 (hk.trans (min_le_left ..))
    have h₂ := (le_div_iff₀ (abs_pos.mpr ht)).1 (hk.trans (min_le_right ..))
    apply (le_div_iff₀ (add_pos_of_pos_of_nonneg hT (abs_nonneg t))).2
    linarith [mul_add ‖boxKernel T t‖ T |t|]

/-- Multiplicative-window Parseval in the original physical variable, with the
true sharp endpoints and measure dy/y. The character or convolution weights are arbitrary. -/
theorem multiplicative_window_plancherel (s : Finset ℕ) (hs : ∀ n ∈ s, 0 < n)
    (c : ℕ → ℂ) {T : ℝ} (hT : 0 < T) :
    (2*Real.pi) * (∫ y in Set.Ioi (0:ℝ), y⁻¹ *
      ‖∑ n ∈ s.filter (fun n : ℕ => y < (n : ℝ) ∧ (n : ℝ) ≤ y*Real.exp (1/T)), c n‖^2) =
      ∫ t : ℝ, ‖boxKernel T t * ∑ n ∈ s, phase t (Real.log n) * c n‖^2 := by
  rw [← window_plancherel s (fun n => Real.log n) c hT]
  congr 1
  rw [← integral_comp_log_Ioi_zero (fun v : ℝ =>
    ‖∑ n ∈ s.filter (fun n : ℕ => v < Real.log n ∧ Real.log n ≤ v + 1/T), c n‖^2)]
  apply setIntegral_congr_fun measurableSet_Ioi
  intro y hy
  have hy' : 0 < y := hy
  simp only [smul_eq_mul]
  congr 3
  apply congrArg (fun u : Finset ℕ => ∑ n ∈ u, c n)
  apply Finset.filter_congr
  intro n hn
  have hn' : 0 < (n : ℝ) := by exact_mod_cast hs n hn
  have he : Real.log (y*Real.exp (1/T)) = Real.log y+1/T := by
    rw [Real.log_mul hy'.ne' (Real.exp_pos _).ne', Real.log_exp]
  rw [Real.log_lt_log_iff hy' hn', ← he, Real.log_le_log_iff hn' (by positivity)]

/-- A sharp physical multiplicative window is controlled by a nonsingular
frequency kernel. Both integrals here are over the full range; no Perron tail
or implicit truncation is assumed. -/
theorem multiplicative_window_frequency_bound (s : Finset ℕ) (hs : ∀ n ∈ s, 0 < n)
    (c : ℕ → ℂ) {T : ℝ} (hT : 1 ≤ T) :
    (2*Real.pi) * (∫ y in Set.Ioi (0:ℝ), y⁻¹ *
      ‖∑ n ∈ s.filter (fun n : ℕ => y < (n : ℝ) ∧ (n : ℝ) ≤ y*Real.exp (1/T)), c n‖^2) ≤
      9 * ∫ t : ℝ, (‖∑ n ∈ s, phase t (Real.log n) * c n‖ / (T+|t|))^2 := by
  have hT0 : 0 < T := by linarith
  let P (t : ℝ) := ∑ n ∈ s, phase t (Real.log n) * c n
  let K := ∑ n ∈ s, ‖c n‖
  have hP (t : ℝ) : ‖P t‖ ≤ K := by
    apply (norm_sum_le _ _).trans_eq
    apply Finset.sum_congr rfl
    intro n _
    have e (u : ℝ) : ‖phase t u‖ = 1 := by simp [phase,Complex.norm_exp]
    rw [norm_mul, e, one_mul]
  have hp : Continuous P := by unfold P phase; fun_prop
  have hp' : Continuous (fun t : ℝ => (‖P t‖ / (T+|t|))^2) :=
    (hp.norm.div (continuous_const.add continuous_abs)
      (fun t => (add_pos_of_pos_of_nonneg hT0 (abs_nonneg t)).ne')).pow _
  have hi : Integrable (fun t : ℝ => (‖P t‖ / (T+|t|))^2) := by
    apply (integrable_inv_one_add_sq.const_mul (K^2)).mono' hp'.aestronglyMeasurable
    filter_upwards with t
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), div_pow, ← div_eq_mul_inv]
    have hden : 1+t^2 ≤ (T+|t|)^2 := by
      calc
        _ ≤ (1+|t|)^2 := by nlinarith [sq_abs t,abs_nonneg t]
        _ ≤ _ := by gcongr
    apply (div_le_div_of_nonneg_left (sq_nonneg _) (by positivity) hden).trans'
    exact div_le_div_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) (hP _) 2) (sq_nonneg _)
  rw [multiplicative_window_plancherel s hs c hT0, ← integral_const_mul]
  apply integral_mono_of_nonneg (ae_of_all _ fun t => sq_nonneg _) (hi.const_mul 9)
  filter_upwards with t
  rw [norm_mul]
  change (‖boxKernel T t‖ * ‖P t‖)^2 ≤ 9*(‖P t‖/(T+|t|))^2
  calc _ ≤ (3/(T+|t|)*‖P t‖)^2 := by
         gcongr
         exact boxKernel_decay hT0 t
       _ = _ := by ring

/-- Gallagher cutoff for a finite family of Dirichlet polynomials. In
particular the coefficients may be twisted by primitive Dirichlet characters.
Neither a Fourier estimate nor an integrability assumption is supplied by the caller. -/
theorem dirichlet_family_cutoff {ι : Type*} (I : Finset ι) (s : Finset ℕ)
    (hs : ∀ n ∈ s, 0 < n) (b : ι → ℕ → ℂ) {T : ℝ} (hT : 0 < T) :
    (∑ j ∈ I, ∫ t : ℝ in -T..T,
      ‖∑ n ∈ s, b j n / (n : ℂ)^((t : ℂ)*Complex.I)‖^2) ≤
      (8*Real.pi)*T^2 * ∫ y : ℝ, ∑ j ∈ I,
        ‖∑ n ∈ s, (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator
          (fun _ : ℝ => b j n) y‖^2 := by
  classical
  have hpol (j : ι) (t : ℝ) : (∑ n ∈ s, b j n / (n : ℂ)^((t : ℂ)*Complex.I)) =
      ∑ n ∈ s, phase t (Real.log n) * b j n := by
    apply Finset.sum_congr rfl
    intro n hn
    rw [Complex.cpow_def_of_ne_zero (by exact_mod_cast (hs n hn).ne'), div_eq_mul_inv,
      ← Complex.exp_neg, mul_comm, phase]
    congr 2
    push_cast
    ring
  have hint (j : ι) : Integrable (fun y => ‖boxes s (fun n => Real.log n) (b j) T y‖^2) := by
    apply MemLp.integrable_sq
    apply MemLp.norm
    exact memLp_finsetSum s fun n _ =>
      memLp_indicator_const 2 measurableSet_Ioc.nullMeasurableSet (b j n) (.inr measure_Ioc_lt_top.ne)
  simp_rw [hpol]
  change _ ≤ (8*Real.pi)*T^2 * ∫ y : ℝ, ∑ j ∈ I, ‖boxes s (fun n => Real.log n) (b j) T y‖^2
  rw [integral_finsetSum I fun j _ => hint j, Finset.mul_sum]
  exact Finset.sum_le_sum fun j _ => finite_fourier_cutoff s _ (b j) hT

/-- Conditional localization step for Lemma 3.1. The Fourier cutoff
inequality and the short-window character large sieve are separate inputs;
integrating the latter costs exactly one factor 1/T. -/
theorem hybrid_from_windows (s : Finset ℕ) (w : ℕ → ℝ) (F : ℝ → ℝ)
    {S Q N T C D : ℝ} (hT : 0 < T) (hD : 0 ≤ D) (hi : Integrable F)
    (hFourier : S ≤ D*T^2 * ∫ y, F y)
    (hSieve : ∀ y, F y ≤ C*(Q^2+N/T) * ∑ n ∈ s,
      (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator (fun _ : ℝ => w n) y) :
    S ≤ D*C*(Q^2*T+N) * ∑ n ∈ s, w n := by
  have hw (n : ℕ) : Integrable ((Set.Ioc (Real.log n-1/T) (Real.log n)).indicator
      (fun _ : ℝ => w n)) :=
    (integrable_indicator_iff measurableSet_Ioc).2 continuous_const.integrableOn_Ioc
  have H := integral_mono hi ((integrable_finsetSum s fun n _ => hw n).const_mul
    (C*(Q^2+N/T))) hSieve
  rw [integral_const_mul, log_window_mass s w hT] at H
  refine (hFourier.trans (mul_le_mul_of_nonneg_left H (by positivity))).trans_eq ?_
  field_simp

/-- Localized form of the hybrid mean-square bound: just the character
large sieve on each ordinary short window remains as input. -/
theorem hybrid_of_local_sieve {ι : Type*} (I : Finset ι) (s : Finset ℕ)
    (hs : ∀ n ∈ s, 0 < n) (b : ι → ℕ → ℂ) (w : ℕ → ℝ)
    {T Q N C : ℝ} (hT : 0 < T)
    (hlocal : ∀ y : ℝ, (∑ j ∈ I, ‖∑ n ∈ s,
        (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator (fun _ : ℝ => b j n) y‖^2) ≤
        C*(Q^2+N/T) * ∑ n ∈ s,
          (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator (fun _ : ℝ => w n) y) :
    (∑ j ∈ I, ∫ t : ℝ in -T..T, ‖∑ n ∈ s, b j n / (n : ℂ)^((t : ℂ)*Complex.I)‖^2) ≤
      (8*Real.pi)*C*(Q^2*T+N) * ∑ n ∈ s, w n := by
  apply hybrid_from_windows s w _ hT (by positivity : 0 ≤ 8*Real.pi) _
    (dirichlet_family_cutoff I s hs b hT) hlocal
  apply integrable_finsetSum
  intro j _
  apply MemLp.integrable_sq
  apply MemLp.norm
  exact memLp_finsetSum s fun n _ =>
    memLp_indicator_const 2 measurableSet_Ioc.nullMeasurableSet (b j n) (.inr measure_Ioc_lt_top.ne)

/-- The short multiplicative interval kernel before (4.9). The first
bound is uniform at low frequency and the second decays at high frequency. -/
theorem mellin_window {η : ℝ} (hη : 0 ≤ η) (hη' : η ≤ 1) (s : ℂ)
    (hs : s.re = 1/2) :
    ‖(((1+η : ℝ) : ℂ)^s - 1) / s‖ ≤ min η (9/(1+|s.im|)) := by
  have hx : 1 ≤ 1+η := by linarith
  have hpos : 0 < 1+η := by linarith
  have hsr : (s-1).re = -1/2 := by rw [Complex.sub_re, hs, Complex.one_re]; ring
  apply le_min
  · have h := intervalIntegral.norm_integral_le_of_norm_le_const
      (a := (1 : ℝ)) (b := 1+η) (C := 1) (f := fun y : ℝ => (y : ℂ)^(s-1)) (by
        intro y hy
        rw [Set.uIoc_of_le hx] at hy
        rw [Complex.norm_cpow_eq_rpow_re_of_pos (by linarith [hy.1] : 0 < y), hsr]
        exact Real.rpow_le_one_of_one_le_of_nonpos hy.1.le (by norm_num))
    rw [integral_cpow (Or.inl (show -1 < (s-1).re by rw [hsr]; norm_num))] at h
    simpa [abs_of_nonneg hη] using h
  · have hden : 1+|s.im| ≤ 3*‖s‖ := by
      have hr := Complex.abs_re_le_norm s
      rw [hs] at hr
      norm_num at hr
      linarith [Complex.abs_im_le_norm s]
    have hspos : 0 < ‖s‖ := by linarith [abs_nonneg s.im]
    have hb := norm_sub_le (((1+η : ℝ) : ℂ)^s) (1 : ℂ)
    rw [Complex.norm_cpow_eq_rpow_re_of_pos hpos, hs, norm_one] at hb
    have hr : (1+η)^(1/2 : ℝ) ≤ 1+η := by
      simpa using (Real.rpow_le_rpow_of_exponent_le hx (by norm_num : (1/2 : ℝ) ≤ 1))
    rw [norm_div, div_le_div_iff₀ hspos (by positivity : 0 < 1+|s.im|)]
    calc
      _ ≤ 3*(1+|s.im|) := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
      _ ≤ 3*(3*‖s‖) := by linarith
      _ = _ := by ring

/-- The oscillatory integral entering the mean-square reduction before (4.9).
The frequency difference is the imaginary part of the exponent. -/
theorem frequency_kernel {x : ℝ} (hx : 0 < x) (v : ℝ) :
    ‖∫ y : ℝ in x..3*x, (y : ℂ) ^ (1 + (v : ℂ)*Complex.I : ℂ)‖ ≤
      20*x^2/(1+|v|) := by
  let z : ℂ := 1 + (v : ℂ)*Complex.I
  have hz : z.re = 1 := by simp [z]
  have hr : (z+1).re = 2 := by simp [hz]; norm_num
  have hi : (z+1).im = v := by simp [z]
  have hn : 1 + |v| ≤ 2 * ‖z+1‖ := by
    have h₁ := Complex.abs_re_le_norm (z+1)
    have h₂ := Complex.abs_im_le_norm (z+1)
    rw [hr] at h₁
    rw [hi] at h₂
    norm_num at h₁
    linarith
  change ‖∫ y : ℝ in x..3*x, (y : ℂ) ^ z‖ ≤ _
  rw [integral_cpow (Or.inl (show -1 < z.re by rw [hz]; norm_num)), norm_div]
  have hnum := norm_sub_le (((3*x : ℝ) : ℂ) ^ (z+1)) ((x : ℂ) ^ (z+1))
  rw [Complex.norm_cpow_eq_rpow_re_of_pos (by linarith : 0 < 3*x),
    Complex.norm_cpow_eq_rpow_re_of_pos hx, hr] at hnum
  simp only [Real.rpow_two] at hnum
  have hnpos : 0 < ‖z+1‖ := by linarith [abs_nonneg v]
  apply (div_le_div_iff₀ hnpos (by positivity : 0 < 1+|v|)).mpr
  calc
    _ ≤ (10*x^2)*(1+|v|) := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      nlinarith only [hnum]
    _ ≤ (10*x^2)*(2*‖z+1‖) := mul_le_mul_of_nonneg_left hn (by positivity)
    _ = _ := by ring

/-- Final contradiction in Section 4, Case 4, with an explicit uniform
power margin instead of an unspecified o(1) in the exponent. -/
theorem case_four {B : ℝ} : ∀ᶠ x : ℝ in atTop, ∀ θ β : ℝ,
    (1-θ)/3 + 1/32 ≤ β →
    ¬ x^(4*β) ≤ (Real.log x)^B * x^(1-θ+β) := by
  have hlog := (isLittleO_log_rpow_rpow_atTop B (show (0 : ℝ) < 1/16 by norm_num)).bound
    (show (0 : ℝ) < 1 by norm_num)
  filter_upwards [hlog, eventually_gt_atTop (1 : ℝ)] with x h hx
  have hx0 : 0 < x := by linarith
  simp only [Real.norm_eq_abs, one_mul, abs_of_nonneg (Real.rpow_nonneg
    (Real.log_nonneg hx.le) B), abs_of_nonneg (Real.rpow_nonneg hx0.le _)] at h
  intro θ β hβ hbad
  have he : 1/16 + (1-θ+β) < 4*β := by linarith
  have hstrict := Real.rpow_lt_rpow_of_exponent_lt hx he
  rw [Real.rpow_add hx0] at hstrict
  exact (not_lt_of_ge (hbad.trans (mul_le_mul_of_nonneg_right h
    (Real.rpow_nonneg hx0.le _)))) hstrict

theorem target_of_upper (paper : UpperBranch 18 (1/16)) :
    let theta := fun (q : ℕ) [NeZero q] (r : ZMod q) (y h : ℝ) => Finset.sum ((Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊).filter (fun k : ℕ => (k:ZMod q)=r)) (fun k => if k.Prime then Real.log (k:ℝ) else 0); let E := fun (q : ℕ) (h y : ℝ) => if hq : q=0 then (0:ℝ) else (letI : NeZero q := ⟨hq⟩; (Finset.univ : Finset (ZMod q)).sup' Finset.univ_nonempty (fun r => if IsUnit r then |theta q r y h - h/(q.totient:ℝ)| else 0)); ∃ C : ℝ, 0<C ∧ ∃ X : ℕ, ∀ x t : ℝ, (X:ℝ)≤x → 1≤x → 5/8≤t → t≤1 → ∀ Q : ℕ, 1≤Q → (Q:ℝ)^2*x^((1-t)/3+1/16) ≤ x^t → intervalIntegral (fun y => Finset.sum (Finset.Icc 1 Q) (fun q => E q (x^t) y)) x (2*x) MeasureTheory.volume ≤ C*x*x^t/(Real.log x)^18 := by
  obtain ⟨C, hC, X, h⟩ := paper
  refine ⟨C, hC, X, ?_⟩
  intro x t hX hx ht ht' Q hQ hsize
  have hp : 0 < x^((1-t)/3+(1:ℝ)/16) := Real.rpow_pos_of_pos (by linarith) _
  simpa only [err, theta, mul_comm (x^t) x, ← mul_assoc] using
    h x t hX hx (by linarith) ht ht' Q hQ ((le_div_iff₀ hp).2 hsize)

end
end ShortAP

/-! ## Hybrid mean square: the additive large sieve and character reduction

The proof in namespace ShortAPAdditive is adapted from SaladDay's
AnalyticLargeSieve.lean, goldbach-proofs 389244edd2a39fc0f8c6b4748893e39196754c8e
(Apache-2.0). The unit orthogonality helpers below adapt CharacterWindowFiberEnergy.lean,
goldbach-proofs 70a0b694eab17efbbff87fa410b3342c03a96e60 (Apache-2.0).
All analytic inputs used by the hybrid bound are proved in this file.
-/

section

open MeasureTheory

namespace ShortAPAdditive

noncomputable def Ex (x : ℝ) : ℂ := Complex.exp (((2 * Real.pi * x : ℝ) : ℂ) * Complex.I)

lemma Ex_add (x y : ℝ) : Ex (x + y) = Ex x * Ex y := by
  unfold Ex
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

lemma Ex_int (m : ℤ) : Ex (m : ℝ) = 1 := by
  unfold Ex
  have h : (((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) * Complex.I) =
      2 * (Real.pi : ℂ) * (m : ℂ) * Complex.I := by
    push_cast
    ring
  have h2 : (2 : ℂ) * (Real.pi : ℂ) * (m : ℂ) * Complex.I =
      (m : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
    ring
  rw [h, h2, Complex.exp_int_mul_two_pi_mul_I]

lemma Ex_conj (x : ℝ) : (starRingEnd ℂ) (Ex x) = Ex (-x) := by
  unfold Ex
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
  push_cast
  ring

lemma norm_Ex (x : ℝ) : ‖Ex x‖ = 1 := by
  unfold Ex
  exact Complex.norm_exp_ofReal_mul_I _

lemma continuous_Ex : Continuous Ex := by
  unfold Ex
  fun_prop

lemma orth (m : ℤ) (a : ℝ) :
    ∫ t in a..(a + 1), Ex ((m : ℝ) * t) = if m = 0 then 1 else 0 := by
  have hrewrite : (∫ t in a..(a + 1), Ex ((m : ℝ) * t)) =
      ∫ t in a..(a + 1), Complex.exp ((((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) * Complex.I) * (t : ℂ)) := by
    refine intervalIntegral.integral_congr (fun t _ => ?_)
    unfold Ex
    congr 1
    push_cast
    ring
  rw [hrewrite]
  by_cases hm : m = 0
  · subst hm
    simp
  · have hmr : (m : ℝ) ≠ 0 := by
      intro hzero
      exact hm (by exact_mod_cast hzero)
    have h1 : (2 * Real.pi * (m : ℝ)) ≠ 0 :=
      mul_ne_zero (mul_ne_zero two_ne_zero Real.pi_ne_zero) hmr
    have hc : (((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) * Complex.I) ≠ 0 := by
      have h2 : ((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) ≠ 0 := by
        simpa [Complex.ofReal_eq_zero] using h1
      exact mul_ne_zero h2 Complex.I_ne_zero
    rw [integral_exp_mul_complex hc]
    have hval : Complex.exp (((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) * Complex.I) = 1 := by
      have h := Ex_int m
      unfold Ex at h
      exact h
    have hexp : Complex.exp ((((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) * Complex.I) * ((a + 1 : ℝ) : ℂ)) =
        Complex.exp ((((2 * Real.pi * (m : ℝ) : ℝ) : ℂ) * Complex.I) * (a : ℂ)) := by
      have hcast : ((a + 1 : ℝ) : ℂ) = (a : ℂ) + 1 := by
        push_cast
        ring
      rw [hcast, mul_add, Complex.exp_add, mul_one, hval, mul_one]
    rw [hexp, sub_self, zero_div]
    simp [hm]

lemma parseval (s : Finset ℕ) (z : ℕ → ℂ) (a : ℝ) :
    ∫ t in a..(a + 1), ‖∑ k ∈ s, z k * Ex ((k : ℝ) * t)‖ ^ 2 = ∑ k ∈ s, ‖z k‖ ^ 2 := by
  classical
  set S : ℝ → ℂ := fun t => ∑ k ∈ s, z k * Ex ((k : ℝ) * t) with hSdef
  set W : ℝ → ℂ := fun t => ∑ k ∈ s, ∑ j ∈ s,
    ((starRingEnd ℂ) (z k) * z j) * Ex (((j : ℝ) - (k : ℝ)) * t) with hWdef
  have hpoint : ∀ t : ℝ, (Complex.normSq (S t) : ℂ) = W t := by
    intro t
    rw [Complex.normSq_eq_conj_mul_self]
    simp only [hSdef, hWdef]
    rw [map_sum, Finset.sum_mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    apply Finset.sum_congr rfl
    intro j hj
    simp only [map_mul, Ex_conj]
    have hmul : Ex (-((k : ℝ) * t)) * Ex ((j : ℝ) * t) = Ex (((j : ℝ) - (k : ℝ)) * t) := by
      rw [← Ex_add]
      congr 1
      ring
    calc
      ((starRingEnd ℂ) (z k) * Ex (-((k : ℝ) * t))) * (z j * Ex ((j : ℝ) * t)) =
          ((starRingEnd ℂ) (z k) * z j) * (Ex (-((k : ℝ) * t)) * Ex ((j : ℝ) * t)) := by ring
      _ = ((starRingEnd ℂ) (z k) * z j) * Ex (((j : ℝ) - (k : ℝ)) * t) := by rw [hmul]
  have hint_single : ∀ (c : ℂ) (b : ℝ),
      IntervalIntegrable (fun t : ℝ => c * Ex (b * t)) volume a (a + 1) := by
    intro c b
    exact (continuous_const.mul (continuous_Ex.comp (by fun_prop))).intervalIntegrable _ _
  have hint_W : IntervalIntegrable W volume a (a + 1) := by
    simp only [hWdef]
    exact (continuous_finsetSum _ (fun k _ => continuous_finsetSum _
      (fun j _ => continuous_const.mul (continuous_Ex.comp (by fun_prop))))).intervalIntegrable _ _
  have hmain : (∫ t in a..(a + 1), W t) = ((∑ k ∈ s, ‖z k‖ ^ 2 : ℝ) : ℂ) := by
    simp only [hWdef]
    have houter (k : ℕ) (hk : k ∈ s) : IntervalIntegrable (fun t : ℝ => ∑ j ∈ s,
        ((starRingEnd ℂ) (z k) * z j) * Ex (((j : ℝ) - (k : ℝ)) * t)) volume a (a + 1) := by
      exact (continuous_finsetSum _ (fun j _ => continuous_const.mul
        (continuous_Ex.comp (by fun_prop)))).intervalIntegrable _ _
    rw [intervalIntegral.integral_finsetSum houter]
    have hstep : ∀ k ∈ s, (∫ t in a..(a + 1), ∑ j ∈ s,
        ((starRingEnd ℂ) (z k) * z j) * Ex (((j : ℝ) - (k : ℝ)) * t)) = ∑ j ∈ s,
        ((starRingEnd ℂ) (z k) * z j) * (if ((j : ℤ) - (k : ℤ)) = 0 then 1 else 0) := by
      intro k hk
      have hii : ∀ j ∈ s, IntervalIntegrable
          (fun t : ℝ => ((starRingEnd ℂ) (z k) * z j) * Ex (((j : ℝ) - (k : ℝ)) * t))
          volume a (a + 1) := fun j hj => hint_single _ _
      rw [intervalIntegral.integral_finsetSum hii]
      apply Finset.sum_congr rfl
      intro j hj
      rw [intervalIntegral.integral_const_mul]
      have hm : ((j : ℝ) - (k : ℝ)) = (((j : ℤ) - (k : ℤ) : ℤ) : ℝ) := by
        push_cast
        ring
      have ho : (∫ t in a..(a + 1), Ex (((j : ℝ) - (k : ℝ)) * t))
          = (if ((j : ℤ) - (k : ℤ)) = 0 then (1 : ℂ) else 0) := by
        rw [hm]
        exact orth _ a
      rw [ho]
    calc
      (∑ k ∈ s, ∫ t in a..(a + 1), ∑ j ∈ s,
          ((starRingEnd ℂ) (z k) * z j) * Ex (((j : ℝ) - (k : ℝ)) * t)) =
          ∑ k ∈ s, ∑ j ∈ s, ((starRingEnd ℂ) (z k) * z j) *
            (if ((j : ℤ) - (k : ℤ)) = 0 then 1 else 0) := Finset.sum_congr rfl hstep
      _ = ∑ k ∈ s, (starRingEnd ℂ) (z k) * z k := by
        apply Finset.sum_congr rfl
        intro k hk
        have hdiag : ∀ j ∈ s, ((starRingEnd ℂ) (z k) * z j) *
            (if ((j : ℤ) - (k : ℤ)) = 0 then (1 : ℂ) else 0) =
            (if j = k then (starRingEnd ℂ) (z k) * z j else 0) := by
          intro j hj
          by_cases hjk : j = k
          · subst hjk
            simp
          · have hne : ((j : ℤ) - (k : ℤ)) ≠ 0 := by
              intro hz
              exact hjk (by omega)
            simp [hne, hjk]
        rw [Finset.sum_congr rfl hdiag,
          Finset.sum_eq_single k (fun b hb hbk => by simp [hbk]) (fun hk' => absurd hk hk')]
        simp
      _ = ((∑ k ∈ s, ‖z k‖ ^ 2 : ℝ) : ℂ) := by
        push_cast
        apply Finset.sum_congr rfl
        intro k hk
        have hz : (starRingEnd ℂ) (z k) * z k = ((‖z k‖ ^ 2 : ℝ) : ℂ) := by
          have h := Complex.normSq_eq_conj_mul_self (z := z k)
          rw [Complex.normSq_eq_norm_sq] at h
          exact h.symm
        rw [hz]
        push_cast
        ring
  have hre : (∫ t in a..(a + 1), (W t).re) = (∫ t in a..(a + 1), W t).re := by
    rw [intervalIntegral.intervalIntegral_eq_integral_uIoc,
      intervalIntegral.intervalIntegral_eq_integral_uIoc]
    simp only [show a ≤ a + 1 by linarith, ite_true, one_smul]
    exact integral_re hint_W.def'
  calc
    (∫ t in a..(a + 1), ‖S t‖ ^ 2) = ∫ t in a..(a + 1), (W t).re := by
      apply intervalIntegral.integral_congr
      intro t ht
      have hp := congrArg Complex.re (hpoint t)
      simpa only [Complex.ofReal_re, Complex.normSq_eq_norm_sq] using hp
    _ = (∫ t in a..(a + 1), W t).re := hre
    _ = ∑ k ∈ s, ‖z k‖ ^ 2 := by rw [hmain]; exact Complex.ofReal_re _

lemma hasDerivAt_Ex (lam t : ℝ) :
    HasDerivAt (fun s : ℝ => Ex (lam * s))
      (Ex (lam * t) * (((2 * Real.pi * lam : ℝ) : ℂ) * Complex.I)) t := by
  have hreal : HasDerivAt (fun s : ℝ => 2 * Real.pi * (lam * s)) (2 * Real.pi * lam) t := by
    have h1 : HasDerivAt (fun s : ℝ => lam * s) lam t := by
      simpa using (hasDerivAt_id t).const_mul lam
    have h2 : HasDerivAt (fun s : ℝ => Real.pi * (lam * s)) (Real.pi * lam) t := by
      simpa using h1.const_mul Real.pi
    simpa [mul_assoc] using h2.const_mul 2
  have h1 : HasDerivAt (fun s : ℝ => ((2 * Real.pi * (lam * s) : ℝ) : ℂ))
      ((2 * Real.pi * lam : ℝ) : ℂ) t := hreal.ofReal_comp
  have h2 : HasDerivAt (fun s : ℝ => ((2 * Real.pi * (lam * s) : ℝ) : ℂ) * Complex.I)
      (((2 * Real.pi * lam : ℝ) : ℂ) * Complex.I) t := h1.mul_const Complex.I
  have h3 := h2.cexp
  simpa only [Ex] using h3

lemma sum_image_of_inj {α β : Type*} [DecidableEq α] [DecidableEq β] {G : Type*}
    [AddCommMonoid G] (f : α → β) (g : β → G) :
    ∀ (A : Finset α), Set.InjOn f ↑A → (∑ a ∈ A, g (f a)) = ∑ b ∈ A.image f, g b := by
  intro A
  induction A using Finset.induction_on with
  | empty => intro _; simp
  | insert a A' ha ih =>
    intro hf
    have hne : f a ∉ A'.image f := by
      intro hmem
      obtain ⟨b, hbA, hbeq⟩ := Finset.mem_image.mp hmem
      have hba : b = a :=
        hf (Finset.mem_insert_of_mem hbA) (Finset.mem_insert_self a A') hbeq
      exact ha (hba ▸ hbA)
    have hf' : Set.InjOn f ↑A' :=
      hf.mono (fun x hx => Finset.mem_insert_of_mem hx)
    rw [Finset.sum_insert ha, Finset.image_insert, Finset.sum_insert hne, ih hf']

lemma gallagher_midpoint {f f' : ℝ → ℂ} (hf : ∀ t, HasDerivAt f (f' t) t)
    (hcont : Continuous f') (x r : ℝ) (hr : 0 < r) :
    ‖f x‖ ^ 2 ≤ (1 / (2 * r)) * (∫ t in (x - r)..(x + r), ‖f t‖ ^ 2)
      + ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ := by
  let g : ℝ → ℝ := fun t => ‖f t‖ ^ 2
  let gd : ℝ → ℝ := fun t => 2 * inner ℝ (f t) (f' t)
  have hg : ∀ t, HasDerivAt g (gd t) t := by
    intro t
    simpa [g, gd] using (hf t).norm_sq
  have hfc : Continuous f := continuous_iff_continuousAt.mpr fun t => (hf t).continuousAt
  have hgc : Continuous g := by
    change Continuous (fun t : ℝ => ‖f t‖ ^ 2)
    exact (continuous_norm.comp hfc).pow 2
  have hgdc : Continuous gd := by
    change Continuous (fun t : ℝ => (2 : ℝ) * inner ℝ (f t) (f' t))
    exact continuous_const.mul (hfc.inner hcont)
  have hleftWeightC : Continuous (fun t => (t - (x - r)) * gd t) :=
    (continuous_id.sub continuous_const).mul hgdc
  have hrightWeightC : Continuous (fun t => ((x + r) - t) * gd t) :=
    (continuous_const.sub continuous_id).mul hgdc
  have hprodC : Continuous (fun t => ‖f t‖ * ‖f' t‖) :=
    (continuous_norm.comp hfc).mul (continuous_norm.comp hcont)
  have h2prodC : Continuous (fun t : ℝ => (2 : ℝ) * (‖f t‖ * ‖f' t‖)) :=
    continuous_const.mul hprodC
  have hab : x - r ≤ x := by linarith
  have hbc : x ≤ x + r := by linarith
  have hFleft : ∀ t, HasDerivAt (fun t => (t - (x - r)) * g t)
      (g t + (t - (x - r)) * gd t) t := by
    intro t
    convert ((hasDerivAt_id t).sub_const (x - r)).mul (hg t) using 1
    · funext s
      simp
    · simp
  have hFright : ∀ t, HasDerivAt (fun t => ((x + r) - t) * g t)
      (-g t + ((x + r) - t) * gd t) t := by
    intro t
    convert ((hasDerivAt_id t).const_sub (x + r)).mul (hg t) using 1
    · funext s
      simp
    · simp
  have hleftDerivC : Continuous (fun t => g t + (t - (x - r)) * gd t) :=
    hgc.add hleftWeightC
  have hrightDerivC : Continuous (fun t => -g t + ((x + r) - t) * gd t) :=
    hgc.neg.add hrightWeightC
  have h1 : (∫ t in (x - r)..x, g t + (t - (x - r)) * gd t) = r * g x := by
    convert intervalIntegral.integral_eq_sub_of_hasDerivAt
      (fun t _ => hFleft t)
      (hleftDerivC.intervalIntegrable (x - r) x) using 1
    ring
  have h2 : (∫ t in x..(x + r), -g t + ((x + r) - t) * gd t) = -(r * g x) := by
    convert intervalIntegral.integral_eq_sub_of_hasDerivAt
      (fun t _ => hFright t)
      (hrightDerivC.intervalIntegrable x (x + r)) using 1
    ring
  have h1split :
      (∫ t in (x - r)..x, g t + (t - (x - r)) * gd t) =
        (∫ t in (x - r)..x, g t) +
          ∫ t in (x - r)..x, (t - (x - r)) * gd t :=
    intervalIntegral.integral_add
      (hgc.intervalIntegrable (x - r) x)
      (hleftWeightC.intervalIntegrable (x - r) x)
  have h2split :
      (∫ t in x..(x + r), -g t + ((x + r) - t) * gd t) =
        -(∫ t in x..(x + r), g t) +
          ∫ t in x..(x + r), ((x + r) - t) * gd t := by
    simpa only [Pi.neg_apply, intervalIntegral.integral_neg] using
      intervalIntegral.integral_add
        (hgc.neg.intervalIntegrable x (x + r))
        (hrightWeightC.intervalIntegrable x (x + r))
  rw [h1split] at h1
  rw [h2split] at h2
  have hleft_point : ∀ t ∈ Set.Icc (x - r) x,
      |(t - (x - r)) * gd t| ≤ r * |gd t| := by
    intro t ht
    have ht0 : 0 ≤ t - (x - r) := by linarith [ht.1]
    have htr : t - (x - r) ≤ r := by linarith [ht.2]
    rw [abs_mul, abs_of_nonneg ht0]
    exact mul_le_mul_of_nonneg_right htr (abs_nonneg _)
  have hright_point : ∀ t ∈ Set.Icc x (x + r),
      |((x + r) - t) * gd t| ≤ r * |gd t| := by
    intro t ht
    have ht0 : 0 ≤ (x + r) - t := by linarith [ht.2]
    have htr : (x + r) - t ≤ r := by linarith [ht.1]
    rw [abs_mul, abs_of_nonneg ht0]
    exact mul_le_mul_of_nonneg_right htr (abs_nonneg _)
  have hrGdAbsC : Continuous (fun t => r * |gd t|) :=
    continuous_const.mul hgdc.abs
  have hleft_bound :
      |∫ t in (x - r)..x, (t - (x - r)) * gd t| ≤
        r * ∫ t in (x - r)..x, |gd t| := by
    calc
      |∫ t in (x - r)..x, (t - (x - r)) * gd t| ≤
          ∫ t in (x - r)..x, |(t - (x - r)) * gd t| :=
        intervalIntegral.abs_integral_le_integral_abs hab
      _ ≤ ∫ t in (x - r)..x, r * |gd t| :=
        intervalIntegral.integral_mono_on hab
          (hleftWeightC.abs.intervalIntegrable (x - r) x)
          (hrGdAbsC.intervalIntegrable (x - r) x) hleft_point
      _ = r * ∫ t in (x - r)..x, |gd t| :=
        intervalIntegral.integral_const_mul r (fun t => |gd t|)
  have hright_bound :
      |∫ t in x..(x + r), ((x + r) - t) * gd t| ≤
        r * ∫ t in x..(x + r), |gd t| := by
    calc
      |∫ t in x..(x + r), ((x + r) - t) * gd t| ≤
          ∫ t in x..(x + r), |((x + r) - t) * gd t| :=
        intervalIntegral.abs_integral_le_integral_abs hbc
      _ ≤ ∫ t in x..(x + r), r * |gd t| :=
        intervalIntegral.integral_mono_on hbc
          (hrightWeightC.abs.intervalIntegrable x (x + r))
          (hrGdAbsC.intervalIntegrable x (x + r)) hright_point
      _ = r * ∫ t in x..(x + r), |gd t| :=
        intervalIntegral.integral_const_mul r (fun t => |gd t|)
  have hgd_bound : ∀ t, |gd t| ≤ 2 * (‖f t‖ * ‖f' t‖) := by
    intro t
    dsimp [gd]
    calc
      |2 * inner ℝ (f t) (f' t)| = 2 * |inner ℝ (f t) (f' t)| := by
        rw [abs_mul]; norm_num
      _ ≤ 2 * (‖f t‖ * ‖f' t‖) :=
        mul_le_mul_of_nonneg_left (abs_real_inner_le_norm _ _) (by norm_num)
  have hJleft :
      (∫ t in (x - r)..x, |gd t|) ≤
        2 * ∫ t in (x - r)..x, ‖f t‖ * ‖f' t‖ := by
    calc
      (∫ t in (x - r)..x, |gd t|) ≤
          ∫ t in (x - r)..x, 2 * (‖f t‖ * ‖f' t‖) :=
        intervalIntegral.integral_mono hab
          (hgdc.abs.intervalIntegrable (x - r) x)
          (h2prodC.intervalIntegrable (x - r) x)
          (fun t => hgd_bound t)
      _ = 2 * ∫ t in (x - r)..x, ‖f t‖ * ‖f' t‖ :=
        intervalIntegral.integral_const_mul 2 (fun t => ‖f t‖ * ‖f' t‖)
  have hJright :
      (∫ t in x..(x + r), |gd t|) ≤
        2 * ∫ t in x..(x + r), ‖f t‖ * ‖f' t‖ := by
    calc
      (∫ t in x..(x + r), |gd t|) ≤
          ∫ t in x..(x + r), 2 * (‖f t‖ * ‖f' t‖) :=
        intervalIntegral.integral_mono hbc
          (hgdc.abs.intervalIntegrable x (x + r))
          (h2prodC.intervalIntegrable x (x + r))
          (fun t => hgd_bound t)
      _ = 2 * ∫ t in x..(x + r), ‖f t‖ * ‖f' t‖ :=
        intervalIntegral.integral_const_mul 2 (fun t => ‖f t‖ * ‖f' t‖)
  have hleft_main :
      r * g x ≤ (∫ t in (x - r)..x, g t) +
        r * ∫ t in (x - r)..x, |gd t| := by
    have hupper : (∫ t in (x - r)..x, (t - (x - r)) * gd t) ≤
        r * ∫ t in (x - r)..x, |gd t| := (le_abs_self _).trans hleft_bound
    linarith
  have hright_main :
      r * g x ≤ (∫ t in x..(x + r), g t) +
        r * ∫ t in x..(x + r), |gd t| := by
    have hneg := neg_le_of_abs_le hright_bound
    linarith
  have hGadj :
      (∫ t in (x - r)..x, g t) + (∫ t in x..(x + r), g t) =
        ∫ t in (x - r)..(x + r), g t :=
    intervalIntegral.integral_add_adjacent_intervals
      (hgc.intervalIntegrable (x - r) x)
      (hgc.intervalIntegrable x (x + r))
  have hJadj :
      (∫ t in (x - r)..x, |gd t|) + (∫ t in x..(x + r), |gd t|) =
        ∫ t in (x - r)..(x + r), |gd t| :=
    intervalIntegral.integral_add_adjacent_intervals
      (hgdc.abs.intervalIntegrable (x - r) x)
      (hgdc.abs.intervalIntegrable x (x + r))
  have hHadj :
      (∫ t in (x - r)..x, ‖f t‖ * ‖f' t‖) +
          (∫ t in x..(x + r), ‖f t‖ * ‖f' t‖) =
        ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ :=
    intervalIntegral.integral_add_adjacent_intervals
      (hprodC.intervalIntegrable (x - r) x)
      (hprodC.intervalIntegrable x (x + r))
  have hsum :
      2 * r * g x ≤
        ((∫ t in (x - r)..x, g t) + (∫ t in x..(x + r), g t)) +
          ((r * ∫ t in (x - r)..x, |gd t|) +
            r * ∫ t in x..(x + r), |gd t|) := by
    linarith
  have hJtotal :
      (∫ t in (x - r)..(x + r), |gd t|) ≤
        2 * ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ := by
    rw [← hJadj, ← hHadj]
    linarith
  have hJmul :
      r * (∫ t in (x - r)..(x + r), |gd t|) ≤
        r * (2 * ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖) :=
    mul_le_mul_of_nonneg_left hJtotal (le_of_lt hr)
  have hmain :
      2 * r * g x ≤ (∫ t in (x - r)..(x + r), g t) +
        2 * r * ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ := by
    calc
      2 * r * g x ≤
          ((∫ t in (x - r)..x, g t) + (∫ t in x..(x + r), g t)) +
            ((r * ∫ t in (x - r)..x, |gd t|) +
              r * ∫ t in x..(x + r), |gd t|) := hsum
      _ = (∫ t in (x - r)..(x + r), g t) +
          r * ((∫ t in (x - r)..x, |gd t|) +
            ∫ t in x..(x + r), |gd t|) := by
        rw [hGadj]
        ring
      _ = (∫ t in (x - r)..(x + r), g t) +
          r * (∫ t in (x - r)..(x + r), |gd t|) := by rw [hJadj]
      _ ≤ (∫ t in (x - r)..(x + r), g t) +
          r * (2 * ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖) :=
        by linarith
      _ = (∫ t in (x - r)..(x + r), g t) +
          2 * r * ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ := by ring
  have hden : 0 < 2 * r := mul_pos (by norm_num) hr
  have hsub :
      2 * r * (g x - ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖) ≤
        ∫ t in (x - r)..(x + r), g t := by
    nlinarith
  have hquot :
      g x - ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ ≤
        (∫ t in (x - r)..(x + r), g t) / (2 * r) :=
    (le_div_iff₀ hden).2 (by simpa [mul_comm] using hsub)
  have hfinish :
      g x ≤ (∫ t in (x - r)..(x + r), g t) / (2 * r) +
        ∫ t in (x - r)..(x + r), ‖f t‖ * ‖f' t‖ := by
    linarith
  simpa [g, div_eq_mul_inv, one_div, mul_comm] using hfinish

lemma sum_windows_le (F : ℝ → ℝ) (hF : Continuous F) (hF0 : ∀ t, 0 ≤ F t)
    (δ : ℝ) (_hδ : 0 < δ) :
    ∀ (X : Finset ℝ) (α β : ℝ),
      (∀ u ∈ X, ∀ v ∈ X, u ≠ v → δ ≤ |u - v|) →
      (∀ u ∈ X, α + δ / 2 ≤ u ∧ u ≤ β - δ / 2) →
      α ≤ β →
      (∑ u ∈ X, ∫ t in (u - δ / 2)..(u + δ / 2), F t) ≤ ∫ t in α..β, F t := by
  classical
  intro X
  induction X using Finset.induction_on_max with
  | empty =>
      intro α β _ _ hαβ
      simpa using intervalIntegral.integral_nonneg hαβ (fun u _ => hF0 u)
  | insert a s hlt ih =>
      intro α β hsep hbd _hαβ
      have ha : a ∉ s := fun ha => lt_irrefl a (hlt a ha)
      have hmem : ∀ u ∈ s, u ∈ insert a s := fun u hu => Finset.mem_insert_of_mem hu
      have hle : ∀ u ∈ s, u ≤ a - δ := by
        intro u hu
        have h1 : δ ≤ |u - a| :=
          hsep u (hmem u hu) a (Finset.mem_insert_self a s) (ne_of_lt (hlt u hu))
        have h2 : u - a ≤ 0 := by linarith [hlt u hu]
        rw [abs_of_nonpos h2] at h1
        linarith
      have ih' : (∑ u ∈ s, ∫ t in (u - δ / 2)..(u + δ / 2), F t)
          ≤ ∫ t in α..(a - δ / 2), F t :=
        ih α (a - δ / 2)
          (fun u hu v hv huv => hsep u (hmem u hu) v (hmem v hv) huv)
          (fun u hu => ⟨(hbd u (hmem u hu)).1, by have := hle u hu; linarith⟩)
          (by have := (hbd a (Finset.mem_insert_self a s)).1; linarith)
      have hsum : (∑ u ∈ insert a s, ∫ t in (u - δ / 2)..(u + δ / 2), F t)
          = (∫ t in (a - δ / 2)..(a + δ / 2), F t)
            + ∑ u ∈ s, ∫ t in (u - δ / 2)..(u + δ / 2), F t := Finset.sum_insert ha
      have hadd : (∫ t in α..(a - δ / 2), F t) + (∫ t in (a - δ / 2)..(a + δ / 2), F t)
          = ∫ t in α..(a + δ / 2), F t :=
        intervalIntegral.integral_add_adjacent_intervals
          (hF.intervalIntegrable α (a - δ / 2)) (hF.intervalIntegrable (a - δ / 2) (a + δ / 2))
      have hfin : ∫ t in α..(a + δ / 2), F t ≤ ∫ t in α..β, F t := by
        have hb : a + δ / 2 ≤ β := by
          have := (hbd a (Finset.mem_insert_self a s)).2; linarith
        have h2 : (∫ t in α..(a + δ / 2), F t) + (∫ t in (a + δ / 2)..β, F t)
            = ∫ t in α..β, F t :=
          intervalIntegral.integral_add_adjacent_intervals
            (hF.intervalIntegrable α (a + δ / 2)) (hF.intervalIntegrable (a + δ / 2) β)
        have h3 : 0 ≤ ∫ t in (a + δ / 2)..β, F t :=
          intervalIntegral.integral_nonneg hb (fun u _ => hF0 u)
        linarith
      calc (∑ u ∈ insert a s, ∫ t in (u - δ / 2)..(u + δ / 2), F t)
          = (∫ t in (a - δ / 2)..(a + δ / 2), F t)
              + ∑ u ∈ s, ∫ t in (u - δ / 2)..(u + δ / 2), F t := hsum
        _ ≤ (∫ t in (a - δ / 2)..(a + δ / 2), F t) + ∫ t in α..(a - δ / 2), F t :=
            by linarith [ih']
        _ = (∫ t in α..(a - δ / 2), F t) + (∫ t in (a - δ / 2)..(a + δ / 2), F t) := by ring
        _ = ∫ t in α..(a + δ / 2), F t := hadd
        _ ≤ ∫ t in α..β, F t := hfin

lemma frac_sep (Q q r a b : ℕ) (hq1 : 1 ≤ q) (hr1 : 1 ≤ r) (hqQ : q ≤ Q) (hrQ : r ≤ Q)
    (hca : Nat.Coprime a q) (hcb : Nat.Coprime b r) (hne : q ≠ r ∨ a ≠ b) :
    (1 : ℝ) / (Q : ℝ) ^ 2 ≤ |(a : ℝ) / q - (b : ℝ) / r| := by
  have hcross_ne : a * r ≠ b * q := by
    intro hcross
    have hqr : q ∣ a * r := by
      rw [hcross]
      exact dvd_mul_left q b
    have hrq : r ∣ b * q := by
      rw [← hcross]
      exact dvd_mul_left r a
    have hqdr : q ∣ r := hca.symm.dvd_of_dvd_mul_left hqr
    have hrdq : r ∣ q := hcb.symm.dvd_of_dvd_mul_left hrq
    have hqreq : q = r := Nat.dvd_antisymm hqdr hrdq
    have hab : a = b := by
      apply Nat.mul_right_cancel (show 0 < r by omega)
      calc
        a * r = b * q := hcross
        _ = b * r := by rw [hqreq]
    rcases hne with hqne | hane
    · exact hqne hqreq
    · exact hane hab
  have hqR : 0 < (q : ℝ) := by exact_mod_cast (show 0 < q by omega)
  have hrR : 0 < (r : ℝ) := by exact_mod_cast (show 0 < r by omega)
  have hcross : (1 : ℝ) ≤ |(a : ℝ) * r - (b : ℝ) * q| := by
    rcases lt_or_gt_of_ne hcross_ne with h | h
    · have hstep : (a : ℝ) * r + 1 ≤ (b : ℝ) * q := by
        exact_mod_cast Nat.succ_le_of_lt h
      exact le_trans (by linarith) (neg_le_abs _)
    · have hstep : (b : ℝ) * q + 1 ≤ (a : ℝ) * r := by
        exact_mod_cast Nat.succ_le_of_lt h
      exact le_trans (by linarith) (le_abs_self _)
  have hquot : (a : ℝ) / q - (b : ℝ) / r =
      ((a : ℝ) * r - (b : ℝ) * q) / ((q : ℝ) * r) := by
    field_simp
  have hsep : (1 : ℝ) / ((q : ℝ) * r) ≤ |(a : ℝ) / q - (b : ℝ) / r| := by
    rw [hquot, abs_div, abs_of_pos (mul_pos hqR hrR)]
    exact div_le_div_of_nonneg_right hcross (mul_pos hqR hrR).le
  have hden : (q : ℝ) * r ≤ (Q : ℝ) ^ 2 := by
    calc
      (q : ℝ) * r ≤ (Q : ℝ) * Q := by exact_mod_cast Nat.mul_le_mul hqQ hrQ
      _ = (Q : ℝ) ^ 2 := by ring
  exact (one_div_le_one_div_of_le (mul_pos hqR hrR) hden).trans hsep

lemma frac_inj (q r a b : ℕ) (hq1 : 1 ≤ q) (hr1 : 1 ≤ r) (ha : a < q) (hb : b < r)
    (hca : Nat.Coprime a q) (hcb : Nat.Coprime b r)
    (heq : (a : ℝ) / q = (b : ℝ) / r) : q = r ∧ a = b := by
  have hqfacts : 0 < q ∧ 1 ≤ q := ⟨Nat.zero_lt_of_lt ha, hq1⟩
  have hrfacts : 0 < r ∧ 1 ≤ r := ⟨Nat.zero_lt_of_lt hb, hr1⟩
  have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast hqfacts.1.ne'
  have hrR : (r : ℝ) ≠ 0 := by exact_mod_cast hrfacts.1.ne'
  have hcross : a * r = b * q := by
    field_simp [hqR, hrR] at heq
    have hcross' : a * r = q * b := by exact_mod_cast heq
    simpa [Nat.mul_comm] using hcross'
  have hqr : q ∣ a * r := by
    rw [hcross]
    exact dvd_mul_left q b
  have hrq : r ∣ b * q := by
    rw [← hcross]
    exact dvd_mul_left r a
  have hqdr : q ∣ r := hca.symm.dvd_of_dvd_mul_left hqr
  have hrdq : r ∣ q := hcb.symm.dvd_of_dvd_mul_left hrq
  have hqreq : q = r := Nat.dvd_antisymm hqdr hrdq
  have hab : a = b := by
    apply Nat.mul_right_cancel (show 0 < r by omega)
    calc
      a * r = b * q := hcross
      _ = b * r := by rw [hqreq]
  exact ⟨hqreq, hab⟩

lemma frac_bounds (Q q a : ℕ) (hQ : 1 ≤ Q) (hq1 : 1 ≤ q) (hqQ : q ≤ Q) (ha : a < q) :
    (0 : ℝ) ≤ (a : ℝ) / q ∧ (a : ℝ) / q ≤ 1 - 1 / (Q : ℝ) ^ 2 := by
  have hqR : 0 < (q : ℝ) := by exact_mod_cast (show 0 < q by omega)
  have hQR : 0 < (Q : ℝ) := by exact_mod_cast (show 0 < Q by omega)
  have hqQ' : (q : ℝ) ≤ Q := by exact_mod_cast hqQ
  have hQone : (1 : ℝ) ≤ Q := by exact_mod_cast hQ
  have haR : (a : ℝ) + 1 ≤ q := by
    exact_mod_cast Nat.succ_le_of_lt ha
  have hfrac : (a : ℝ) / q ≤ 1 - 1 / (q : ℝ) := by
    calc
      (a : ℝ) / q ≤ ((q : ℝ) - 1) / q :=
        div_le_div_of_nonneg_right (by linarith) hqR.le
      _ = (q : ℝ) / q - 1 / (q : ℝ) := by ring
      _ = 1 - 1 / (q : ℝ) := by rw [div_self hqR.ne']
  have hinvQ_le_one : 1 / (Q : ℝ) ≤ 1 := div_le_self zero_le_one hQone
  have hinvQ_sq : 1 / (Q : ℝ) ^ 2 ≤ 1 / (Q : ℝ) := by
    calc
      1 / (Q : ℝ) ^ 2 = (1 / (Q : ℝ)) * (1 / (Q : ℝ)) := by ring
      _ ≤ 1 / (Q : ℝ) :=
        mul_le_of_le_one_right (one_div_nonneg.mpr hQR.le) hinvQ_le_one
  have hinvQq : 1 / (Q : ℝ) ≤ 1 / (q : ℝ) :=
    one_div_le_one_div_of_le hqR hqQ'
  have hsmall : 1 / (Q : ℝ) ^ 2 ≤ 1 / (q : ℝ) := hinvQ_sq.trans hinvQq
  constructor
  · exact div_nonneg (Nat.cast_nonneg a) hqR.le
  · calc
      (a : ℝ) / q ≤ 1 - 1 / (q : ℝ) := hfrac
      _ ≤ 1 - 1 / (Q : ℝ) ^ 2 := by linarith

theorem large_sieve (M N Q : ℕ) (c : ℕ → ℂ) :
    (∑ q ∈ Finset.Icc 1 Q, ∑ a ∈ (Finset.range q).filter (fun a => Nat.Coprime a q),
        ‖(∑ k ∈ Finset.Ico M (M + N), c k * Ex ((k : ℝ) * ((a : ℝ) / q)))‖ ^ 2)
      ≤ (Real.pi * (N : ℝ) + (Q : ℝ) ^ 2) * ∑ k ∈ Finset.Ico M (M + N), ‖c k‖ ^ 2 := by
  classical
  by_cases hQ : Q = 0
  · subst hQ
    have h1 : Finset.Icc 1 0 = (∅ : Finset ℕ) := by decide
    rw [h1, Finset.sum_empty]
    refine mul_nonneg (add_nonneg ?_ ?_) ?_
    · exact mul_nonneg Real.pi_pos.le (Nat.cast_nonneg N)
    · positivity
    · exact Finset.sum_nonneg (fun k hk => sq_nonneg _)
  by_cases hN : N = 0
  · subst hN
    have h1 : Finset.Ico M (M + 0) = (∅ : Finset ℕ) := by
      rw [Nat.add_zero, Finset.Ico_self]
    simp
  have hQ1 : 1 ≤ Q := by omega
  have hN1 : 1 ≤ N := by omega
  have hQpos : (0 : ℝ) < Q := by exact_mod_cast hQ1
  have hQ0 : (Q : ℝ) ≠ 0 := ne_of_gt hQpos
  set s : Finset ℕ := Finset.Ico M (M + N) with hs
  set L : ℝ := (M : ℝ) + (N : ℝ) / 2 with hL
  set δ : ℝ := 1 / (Q : ℝ) ^ 2 with hδ
  have hδpos : (0 : ℝ) < δ := by
    simp only [hδ]
    positivity
  set S : ℝ → ℂ := fun t => ∑ k ∈ s, c k * Ex ((k : ℝ) * t) with hSdef
  set T : ℝ → ℂ := fun t => Ex (-(L * t)) * S t with hTdef
  set V : ℝ → ℂ := fun t => ∑ k ∈ s,
    ((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k) * Ex ((k : ℝ) * t) with hVdef
  set Td : ℝ → ℂ := fun t => Ex (-(L * t)) * V t with hTddef
  have hTS : ∀ t, ‖T t‖ = ‖S t‖ := by
    intro t
    rw [hTdef, norm_mul, norm_Ex, one_mul]
  have hTdV : ∀ t, ‖Td t‖ = ‖V t‖ := by
    intro t
    rw [hTddef, norm_mul, norm_Ex, one_mul]
  have hmulwin : ∀ (k : ℕ) (t : ℝ),
      Ex (-(L * t)) * Ex ((k : ℝ) * t) = Ex (((k : ℝ) - L) * t) := by
    intro k t
    rw [← Ex_add]
    congr 1
    ring
  have hTsum : ∀ t, T t = ∑ k ∈ s, c k * Ex (((k : ℝ) - L) * t) := by
    intro t
    simp only [hTdef, hSdef, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    calc Ex (-(L * t)) * (c k * Ex ((k : ℝ) * t))
        = c k * (Ex (-(L * t)) * Ex ((k : ℝ) * t)) := by ring
      _ = c k * Ex (((k : ℝ) - L) * t) := by rw [hmulwin k t]
  have hderivT : ∀ t, HasDerivAt T (Td t) t := by
    intro t
    have hpiece : ∀ k ∈ s, HasDerivAt
        (fun u : ℝ => c k * Ex (((k : ℝ) - L) * u))
        (c k * (Ex (((k : ℝ) - L) * t) *
          (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I))) t :=
      fun k hk => (hasDerivAt_Ex ((k : ℝ) - L) t).const_mul (c k)
    have h1 : HasDerivAt (fun u : ℝ => ∑ k ∈ s, c k * Ex (((k : ℝ) - L) * u))
        (∑ k ∈ s, c k * (Ex (((k : ℝ) - L) * t) *
          (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I))) t := by
      have key : ∀ (u : Finset ℕ),
          HasDerivAt (fun v : ℝ => ∑ k ∈ u, c k * Ex (((k : ℝ) - L) * v))
            (∑ k ∈ u, c k * (Ex (((k : ℝ) - L) * t) *
              (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I))) t := by
        intro u
        induction u using Finset.induction_on with
        | empty => simpa using (hasDerivAt_const t (0 : ℂ))
        | insert a u' ha ih =>
            have hA : HasDerivAt (fun v : ℝ => c a * Ex (((a : ℝ) - L) * v))
                (c a * (Ex (((a : ℝ) - L) * t) *
                  (((2 * Real.pi * ((a : ℝ) - L) : ℝ) : ℂ) * Complex.I))) t :=
              (hasDerivAt_Ex ((a : ℝ) - L) t).const_mul (c a)
            have hsum := hA.add ih
            have hfun : ((fun v : ℝ => c a * Ex (((a : ℝ) - L) * v))
                  + fun v : ℝ => ∑ k ∈ u', c k * Ex (((k : ℝ) - L) * v))
                = (fun v : ℝ => ∑ k ∈ insert a u', c k * Ex (((k : ℝ) - L) * v)) := by
              funext v
              rw [Finset.sum_insert ha]
              simp
            have hder : (c a * (Ex (((a : ℝ) - L) * t) *
                  (((2 * Real.pi * ((a : ℝ) - L) : ℝ) : ℂ) * Complex.I)))
                + (∑ k ∈ u', c k * (Ex (((k : ℝ) - L) * t) *
                  (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I)))
                = ∑ k ∈ insert a u', c k * (Ex (((k : ℝ) - L) * t) *
                  (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I)) := by
              rw [Finset.sum_insert ha]
            rw [hfun] at hsum
            rw [hder] at hsum
            exact hsum
      exact key s
    have h3 : (fun u : ℝ => ∑ k ∈ s, c k * Ex (((k : ℝ) - L) * u)) = T := by
      funext u
      exact (hTsum u).symm
    rw [h3] at h1
    have h4 : (∑ k ∈ s, c k * (Ex (((k : ℝ) - L) * t) *
        (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I))) = Td t := by
      simp only [hTddef, hVdef, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      calc c k * (Ex (((k : ℝ) - L) * t) *
            (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I))
          = (((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k *
              (Ex (-(L * t)) * Ex ((k : ℝ) * t)) := by rw [hmulwin k t]; ring
        _ = Ex (-(L * t)) * (((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k) *
            Ex ((k : ℝ) * t)) := by ring
    rw [h4] at h1
    exact h1
  have hcontT : Continuous T :=
    continuous_iff_continuousAt.mpr (fun t => (hderivT t).continuousAt)
  have hcontTd : Continuous Td := by
    simp only [hTddef]
    refine (continuous_Ex.comp (by fun_prop)).mul ?_
    simp only [hVdef]
    exact continuous_finsetSum _ (fun k _ =>
      continuous_const.mul (continuous_Ex.comp (by fun_prop)))
  have hab : -(δ / 2) ≤ 1 - δ / 2 := by linarith
  have hpar1 : (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ ^ 2) = ∑ k ∈ s, ‖c k‖ ^ 2 := by
    have h1 : (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ ^ 2)
        = ∫ t in (-(δ / 2))..(1 - δ / 2), ‖S t‖ ^ 2 := by
      apply intervalIntegral.integral_congr
      intro t ht
      simp only [hTS t]
    rw [h1]
    have h2 : (1 - δ / 2) = (-(δ / 2)) + 1 := by ring
    rw [h2]
    simpa only [hSdef] using (parseval s c (-(δ / 2)))
  have hpar2 : (∫ t in (-(δ / 2))..(1 - δ / 2), ‖Td t‖ ^ 2)
      = ∑ k ∈ s, ‖((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k)‖ ^ 2 := by
    have h1 : (∫ t in (-(δ / 2))..(1 - δ / 2), ‖Td t‖ ^ 2)
        = ∫ t in (-(δ / 2))..(1 - δ / 2), ‖V t‖ ^ 2 := by
      apply intervalIntegral.integral_congr
      intro t ht
      simp only [hTdV t]
    rw [h1]
    have h2 : (1 - δ / 2) = (-(δ / 2)) + 1 := by ring
    rw [h2]
    simpa only [hVdef] using
      (parseval s (fun k => ((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k))
        (-(δ / 2)))
  have hcoef : ∀ k ∈ s, ‖((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k)‖ ^ 2
      ≤ (Real.pi * (N : ℝ)) ^ 2 * ‖c k‖ ^ 2 := by
    intro k hk
    have hk1 : M ≤ k := (Finset.mem_Ico.mp (hs ▸ hk)).1
    have hk2 : k < M + N := (Finset.mem_Ico.mp (hs ▸ hk)).2
    have hk1' : (M : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk1
    have hk2' : (k : ℝ) < (M : ℝ) + (N : ℝ) := by exact_mod_cast hk2
    have hkl : |(k : ℝ) - L| ≤ (N : ℝ) / 2 := by
      rw [abs_le]
      simp only [hL]
      constructor <;> linarith
    have hsq : ((k : ℝ) - L) ^ 2 ≤ ((N : ℝ) / 2) ^ 2 := by
      nlinarith [abs_nonneg ((k : ℝ) - L)]
    have hpi : (2 * Real.pi * ((k : ℝ) - L)) ^ 2 ≤ (Real.pi * (N : ℝ)) ^ 2 := by
      have h4 : 4 * Real.pi ^ 2 * ((k : ℝ) - L) ^ 2 ≤ 4 * Real.pi ^ 2 * ((N : ℝ) / 2) ^ 2 :=
        mul_le_mul_of_nonneg_left hsq (by positivity)
      calc (2 * Real.pi * ((k : ℝ) - L)) ^ 2 = 4 * Real.pi ^ 2 * ((k : ℝ) - L) ^ 2 := by ring
        _ ≤ 4 * Real.pi ^ 2 * ((N : ℝ) / 2) ^ 2 := h4
        _ = (Real.pi * (N : ℝ)) ^ 2 := by ring
    have hI : ‖(Complex.I : ℂ)‖ = 1 := by simp
    have hreal : ‖((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ)‖ ^ 2
        = (2 * Real.pi * ((k : ℝ) - L)) ^ 2 := by
      rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
      simp
      ring
    calc ‖((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k)‖ ^ 2
        = (‖((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ)‖ * ‖(Complex.I : ℂ)‖ * ‖c k‖) ^ 2 := by
          rw [norm_mul, norm_mul]
      _ = (2 * Real.pi * ((k : ℝ) - L)) ^ 2 * ‖c k‖ ^ 2 := by
          rw [hI, mul_one, mul_pow, hreal]
      _ ≤ (Real.pi * (N : ℝ)) ^ 2 * ‖c k‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hpi (by positivity)
  have hYoung : (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ * ‖Td t‖)
      ≤ Real.pi * (N : ℝ) * ∑ k ∈ s, ‖c k‖ ^ 2 := by
    have hπN : (0 : ℝ) < Real.pi * (N : ℝ) := by
      have : (0 : ℝ) < (N : ℝ) := by exact_mod_cast hN1
      positivity
    have hpt : ∀ t, 2 * (Real.pi * (N : ℝ)) * (‖T t‖ * ‖Td t‖)
        ≤ (Real.pi * (N : ℝ)) ^ 2 * ‖T t‖ ^ 2 + ‖Td t‖ ^ 2 := by
      intro t
      nlinarith [sq_nonneg ((Real.pi * (N : ℝ)) * ‖T t‖ - ‖Td t‖)]
    have hintL : IntervalIntegrable (fun t => ‖T t‖ * ‖Td t‖) volume (-(δ / 2)) (1 - δ / 2) :=
      (hcontT.norm.mul hcontTd.norm).intervalIntegrable _ _
    have hintL' : IntervalIntegrable (fun t => 2 * (Real.pi * (N : ℝ)) * (‖T t‖ * ‖Td t‖))
        volume (-(δ / 2)) (1 - δ / 2) :=
      (continuous_const.mul (hcontT.norm.mul hcontTd.norm)).intervalIntegrable _ _
    have hintR1 : IntervalIntegrable (fun t => (Real.pi * (N : ℝ)) ^ 2 * ‖T t‖ ^ 2)
        volume (-(δ / 2)) (1 - δ / 2) :=
      (continuous_const.mul (hcontT.norm.pow 2)).intervalIntegrable _ _
    have hintR2 : IntervalIntegrable (fun t => ‖Td t‖ ^ 2) volume (-(δ / 2)) (1 - δ / 2) :=
      (hcontTd.norm.pow 2).intervalIntegrable _ _
    have hmono := intervalIntegral.integral_mono
      (f := fun t => 2 * (Real.pi * (N : ℝ)) * (‖T t‖ * ‖Td t‖))
      (g := fun t => (Real.pi * (N : ℝ)) ^ 2 * ‖T t‖ ^ 2 + ‖Td t‖ ^ 2)
      (a := -(δ / 2)) (b := 1 - δ / 2) (μ := volume) hab hintL' (hintR1.add hintR2) hpt
    have hL : (∫ t in (-(δ / 2))..(1 - δ / 2), 2 * (Real.pi * (N : ℝ)) * (‖T t‖ * ‖Td t‖))
        = 2 * (Real.pi * (N : ℝ)) * (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ * ‖Td t‖) :=
      intervalIntegral.integral_const_mul (r := 2 * (Real.pi * (N : ℝ)))
        (f := fun t => ‖T t‖ * ‖Td t‖)
    have hR : (∫ t in (-(δ / 2))..(1 - δ / 2),
        (Real.pi * (N : ℝ)) ^ 2 * ‖T t‖ ^ 2 + ‖Td t‖ ^ 2)
        = (Real.pi * (N : ℝ)) ^ 2 * (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ ^ 2)
          + (∫ t in (-(δ / 2))..(1 - δ / 2), ‖Td t‖ ^ 2) := by
      rw [intervalIntegral.integral_add
        (f := fun t => (Real.pi * (N : ℝ)) ^ 2 * ‖T t‖ ^ 2) (g := fun t => ‖Td t‖ ^ 2)
        hintR1 hintR2,
        intervalIntegral.integral_const_mul (r := (Real.pi * (N : ℝ)) ^ 2)
          (f := fun t => ‖T t‖ ^ 2)]
    rw [hL, hR, hpar1, hpar2] at hmono
    have hsumcoef : (∑ k ∈ s, ‖((((2 * Real.pi * ((k : ℝ) - L) : ℝ) : ℂ) * Complex.I) * c k)‖ ^ 2)
        ≤ (Real.pi * (N : ℝ)) ^ 2 * ∑ k ∈ s, ‖c k‖ ^ 2 := by
      rw [Finset.mul_sum]
      exact Finset.sum_le_sum (fun k hk => hcoef k hk)
    have hkey : 2 * (Real.pi * (N : ℝ)) * (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ * ‖Td t‖)
        ≤ 2 * (Real.pi * (N : ℝ)) * (Real.pi * (N : ℝ) * ∑ k ∈ s, ‖c k‖ ^ 2) := by
      nlinarith [hmono, hsumcoef]
    exact le_of_mul_le_mul_left hkey (by positivity : (0 : ℝ) < 2 * (Real.pi * (N : ℝ)))
  set P : Finset (Σ q : ℕ, ℕ) := (Finset.Icc 1 Q).sigma
    (fun q => (Finset.range q).filter (fun a => Nat.Coprime a q)) with hP
  set X : Finset ℝ := P.image (fun p : (Σ q : ℕ, ℕ) => (p.2 : ℝ) / (p.1 : ℝ)) with hX
  have hfrac_inj : Set.InjOn (fun p : (Σ q : ℕ, ℕ) => (p.2 : ℝ) / (p.1 : ℝ)) ↑P := by
    intro p hp p' hp' heq
    have hmem := Finset.mem_sigma.mp hp
    have hmem' := Finset.mem_sigma.mp hp'
    have hq1 : 1 ≤ p.1 := (Finset.mem_Icc.mp hmem.1).1
    have hq1' : 1 ≤ p'.1 := (Finset.mem_Icc.mp hmem'.1).1
    have ha : p.2 < p.1 := Finset.mem_range.mp (Finset.mem_filter.mp hmem.2).1
    have ha' : p'.2 < p'.1 := Finset.mem_range.mp (Finset.mem_filter.mp hmem'.2).1
    have hcop : Nat.Coprime p.2 p.1 := (Finset.mem_filter.mp hmem.2).2
    have hcop' : Nat.Coprime p'.2 p'.1 := (Finset.mem_filter.mp hmem'.2).2
    obtain ⟨hqq, haa⟩ := frac_inj p.1 p'.1 p.2 p'.2 hq1 hq1' ha ha' hcop hcop' heq
    exact Sigma.ext hqq (heq_of_eq haa)
  have hsep : ∀ x ∈ X, ∀ y ∈ X, x ≠ y → δ ≤ |x - y| := by
    intro x hx y hy hne
    rw [hX] at hx hy
    obtain ⟨p, hp, hpx⟩ := Finset.mem_image.mp hx
    obtain ⟨p', hp', hpy⟩ := Finset.mem_image.mp hy
    have hmem := Finset.mem_sigma.mp hp
    have hmem' := Finset.mem_sigma.mp hp'
    have hq1 : 1 ≤ p.1 := (Finset.mem_Icc.mp hmem.1).1
    have hq1' : 1 ≤ p'.1 := (Finset.mem_Icc.mp hmem'.1).1
    have hqQ : p.1 ≤ Q := (Finset.mem_Icc.mp hmem.1).2
    have hqQ' : p'.1 ≤ Q := (Finset.mem_Icc.mp hmem'.1).2
    have hcop : Nat.Coprime p.2 p.1 := (Finset.mem_filter.mp hmem.2).2
    have hcop' : Nat.Coprime p'.2 p'.1 := (Finset.mem_filter.mp hmem'.2).2
    have hpair : p.1 ≠ p'.1 ∨ p.2 ≠ p'.2 := by
      by_contra hc
      have hqeq : p.1 = p'.1 := by
        by_contra h
        exact hc (Or.inl h)
      have haeq : p.2 = p'.2 := by
        by_contra h
        exact hc (Or.inr h)
      apply hne
      rw [← hpx, ← hpy, Sigma.ext hqeq (heq_of_eq haeq)]
    have hfs := frac_sep Q p.1 p'.1 p.2 p'.2 hq1 hq1' hqQ hqQ' hcop hcop' hpair
    rw [hδ, ← hpx, ← hpy]
    exact hfs
  have hbounds : ∀ x ∈ X, (-(δ / 2)) + δ / 2 ≤ x ∧ x ≤ (1 - δ / 2) - δ / 2 := by
    intro x hx
    rw [hX] at hx
    obtain ⟨p, hp, hpx⟩ := Finset.mem_image.mp hx
    have hmem := Finset.mem_sigma.mp hp
    have hq1 : 1 ≤ p.1 := (Finset.mem_Icc.mp hmem.1).1
    have hqQ : p.1 ≤ Q := (Finset.mem_Icc.mp hmem.1).2
    have ha : p.2 < p.1 := Finset.mem_range.mp (Finset.mem_filter.mp hmem.2).1
    have hfb := frac_bounds Q p.1 p.2 hQ1 hq1 hqQ ha
    have hx0 : (0 : ℝ) ≤ x := by rw [← hpx]; exact hfb.1
    have hx1 : x ≤ 1 - δ := by rw [← hpx, hδ]; exact hfb.2
    constructor <;> linarith
  have hmain : (∑ q ∈ Finset.Icc 1 Q,
      ∑ a ∈ (Finset.range q).filter (fun a => Nat.Coprime a q), ‖S ((a : ℝ) / q)‖ ^ 2)
      = ∑ x ∈ X, ‖S x‖ ^ 2 := by
    have h1 : (∑ q ∈ Finset.Icc 1 Q,
        ∑ a ∈ (Finset.range q).filter (fun a => Nat.Coprime a q), ‖S ((a : ℝ) / q)‖ ^ 2)
        = ∑ p ∈ P, ‖S ((p.2 : ℝ) / (p.1 : ℝ))‖ ^ 2 := by
      rw [Finset.sum_sigma']
    rw [h1, hX]
    exact (sum_image_of_inj (fun p : (Σ q : ℕ, ℕ) => (p.2 : ℝ) / (p.1 : ℝ))
      (fun x : ℝ => ‖S x‖ ^ 2) P hfrac_inj)
  have hstep : ∀ x ∈ X, ‖S x‖ ^ 2 ≤ (Q : ℝ) ^ 2 *
      (∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ ^ 2)
      + ∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ * ‖Td t‖ := by
    intro x hx
    have hg := gallagher_midpoint hderivT hcontTd x (δ / 2) (by linarith)
    rw [hTS x] at hg
    have h2r : (1 : ℝ) / (2 * (δ / 2)) = (Q : ℝ) ^ 2 := by
      have he : (2 : ℝ) * (δ / 2) = δ := by ring
      rw [he, hδ]
      field_simp
    rw [h2r] at hg
    exact hg
  have hsum1 : (∑ x ∈ X, ∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ ^ 2)
      ≤ ∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ ^ 2 :=
    sum_windows_le (fun t => ‖T t‖ ^ 2) (hcontT.norm.pow 2) (fun t => sq_nonneg _) δ hδpos X
      (-(δ / 2)) (1 - δ / 2) hsep hbounds hab
  have hsum2 : (∑ x ∈ X, ∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ * ‖Td t‖)
      ≤ ∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ * ‖Td t‖ :=
    sum_windows_le (fun t => ‖T t‖ * ‖Td t‖) (hcontT.norm.mul hcontTd.norm)
      (fun t => mul_nonneg (norm_nonneg _) (norm_nonneg _)) δ hδpos X
      (-(δ / 2)) (1 - δ / 2) hsep hbounds hab
  have hQsq : (0 : ℝ) ≤ (Q : ℝ) ^ 2 := by positivity
  calc (∑ q ∈ Finset.Icc 1 Q,
        ∑ a ∈ (Finset.range q).filter (fun a => Nat.Coprime a q), ‖S ((a : ℝ) / q)‖ ^ 2)
      = ∑ x ∈ X, ‖S x‖ ^ 2 := hmain
    _ ≤ ∑ x ∈ X, ((Q : ℝ) ^ 2 * (∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ ^ 2)
        + ∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ * ‖Td t‖) :=
      Finset.sum_le_sum (fun x hx => hstep x hx)
    _ = (Q : ℝ) ^ 2 * (∑ x ∈ X, ∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ ^ 2)
        + ∑ x ∈ X, ∫ t in (x - δ / 2)..(x + δ / 2), ‖T t‖ * ‖Td t‖ := by
      rw [Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ (Q : ℝ) ^ 2 * (∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ ^ 2)
        + ∫ t in (-(δ / 2))..(1 - δ / 2), ‖T t‖ * ‖Td t‖ :=
      by exact add_le_add (mul_le_mul_of_nonneg_left hsum1 hQsq) hsum2
    _ ≤ (Q : ℝ) ^ 2 * (∑ k ∈ s, ‖c k‖ ^ 2) + Real.pi * (N : ℝ) * ∑ k ∈ s, ‖c k‖ ^ 2 := by
      rw [hpar1]
      exact add_le_add (le_refl _) hYoung
    _ = (Real.pi * (N : ℝ) + (Q : ℝ) ^ 2) * ∑ k ∈ s, ‖c k‖ ^ 2 := by ring

end ShortAPAdditive

end

section

open scoped BigOperators Classical

namespace ShortAPPrimitive

/- The next three lemmas adapt the unit reindexing and character orthogonality
   proofs in goldbach-short-progressions/lean/Conjectures/Goldbach/
   CharacterWindowFiberEnergy.lean (Apache-2.0). -/

private theorem units_sum (q : ℕ) [NeZero q] {M : Type*} [AddCommMonoid M]
    (g : ZMod q → M) :
    (∑ a : (ZMod q)ˣ, g (a : ZMod q)) =
      ∑ r ∈ (Finset.univ : Finset (ZMod q)).filter IsUnit, g r := by
  refine Finset.sum_bij (fun (a : (ZMod q)ˣ) _ => (a : ZMod q)) ?_ ?_ ?_ ?_
  · intro a _
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, a.isUnit⟩
  · intro a₁ _ a₂ _ h
    exact Units.val_injective h
  · intro r hr
    have hu : IsUnit r := (Finset.mem_filter.mp hr).2
    exact ⟨hu.unit, Finset.mem_univ _, hu.unit_spec⟩
  · intro a _
    rfl

private theorem orthogonality (q : ℕ) [NeZero q] (a b : (ZMod q)ˣ) :
    (∑ χ : DirichletCharacter ℂ q, χ (a : ZMod q) * star (χ (b : ZMod q))) =
      if a = b then (q.totient : ℂ) else 0 := by
  have hcb (χ : DirichletCharacter ℂ q) :
      star (χ (b : ZMod q)) = χ ((b : ZMod q)⁻¹) := by
    rw [MulChar.star_apply', MulChar.inv_apply, Ring.inverse_unit, ZMod.inv_coe_unit]
  have h1 : (∑ χ : DirichletCharacter ℂ q, χ (a : ZMod q) * star (χ (b : ZMod q))) =
      ∑ χ : DirichletCharacter ℂ q, χ ((b : ZMod q)⁻¹) * χ (a : ZMod q) := by
    apply Finset.sum_congr rfl
    intro χ _
    rw [hcb χ, mul_comm]
  rw [h1, DirichletCharacter.sum_char_inv_mul_char_eq ℂ b.isUnit (a : ZMod q)]
  by_cases h : (b : ZMod q) = (a : ZMod q)
  · rw [ite_eq_left h, ite_eq_left (Units.val_inj.mp h).symm]
  · rw [ite_eq_right h, ite_eq_right (fun hab => h (by rw [hab]))]

private theorem parseval_star (q : ℕ) [NeZero q] (G : (ZMod q)ˣ → ℂ) :
    (∑ χ : DirichletCharacter ℂ q, ‖∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))‖ ^ 2) =
      (q.totient : ℝ) * ∑ a : (ZMod q)ˣ, ‖G a‖ ^ 2 := by
  have hv (z : ℂ) : star z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    rw [Complex.star_def, Complex.conj_mul', Complex.ofReal_pow]
  have hex (χ : DirichletCharacter ℂ q) :
      star (∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))) *
          (∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))) =
        ∑ a : (ZMod q)ˣ, ∑ b : (ZMod q)ˣ,
          (star (G a) * G b) * (χ (a : ZMod q) * star (χ (b : ZMod q))) := by
    rw [star_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    rw [star_mul, star_star]
    ring
  have hswap (F : (ZMod q)ˣ → (ZMod q)ˣ → DirichletCharacter ℂ q → ℂ) :
      (∑ χ : DirichletCharacter ℂ q, ∑ a : (ZMod q)ˣ, ∑ b : (ZMod q)ˣ, F a b χ) =
        ∑ a : (ZMod q)ˣ, ∑ b : (ZMod q)ˣ, ∑ χ : DirichletCharacter ℂ q, F a b χ := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.sum_comm]
  have hmain : (∑ χ : DirichletCharacter ℂ q,
        star (∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))) *
          (∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q)))) =
      (q.totient : ℂ) * ∑ a : (ZMod q)ˣ, ((‖G a‖ ^ 2 : ℝ) : ℂ) := by
    simp_rw [hex]
    rw [hswap]
    simp_rw [← Finset.mul_sum, orthogonality q]
    have hcol (a b : (ZMod q)ˣ) :
        (star (G a) * G b) * (if a = b then (q.totient : ℂ) else 0) =
          if a = b then ((‖G a‖ ^ 2 : ℝ) : ℂ) * (q.totient : ℂ) else 0 := by
      by_cases h : a = b
      · subst h
        rw [ite_eq_left rfl, ite_eq_left rfl, hv]
      · rw [ite_eq_right h, ite_eq_right h, mul_zero]
    simp_rw [hcol]
    simp
    rw [← Finset.sum_mul, mul_comm]
  simp_rw [hv, ← Complex.ofReal_sum] at hmain
  exact_mod_cast hmain

private theorem sum_units_eq (q : ℕ) [NeZero q] (g : ZMod q → ℂ)
    (h0 : ∀ r, ¬ IsUnit r → g r = 0) :
    (∑ a : (ZMod q)ˣ, g (a : ZMod q)) = ∑ r : ZMod q, g r := by
  rw [units_sum q g, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro r _
  by_cases h : IsUnit r
  · rw [ite_eq_left h]
  · rw [ite_eq_right h, h0 r h]

private theorem gauss_transform (q : ℕ) [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ)
    {χ : DirichletCharacter ℂ q} (hχ : χ.IsPrimitive) :
    (∑ a : (ZMod q)ˣ, (∑ n ∈ s, c n * ZMod.stdAddChar ((n : ZMod q) * (a : ZMod q))) *
      star (χ (a : ZMod q))) =
      (∑ n ∈ s, c n * χ (n : ZMod q)) * gaussSum χ⁻¹ ZMod.stdAddChar := by
  calc
    _ = ∑ a : (ZMod q)ˣ, ∑ n ∈ s,
          c n * (χ⁻¹ (a : ZMod q) * ZMod.stdAddChar ((n : ZMod q) * (a : ZMod q))) := by
      apply Finset.sum_congr rfl
      intro a _
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro n _
      rw [MulChar.star_apply']
      ring
    _ = ∑ n ∈ s, c n * gaussSum χ⁻¹ (ZMod.stdAddChar.mulShift (n : ZMod q)) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro n _
      rw [← Finset.mul_sum, gaussSum, ← sum_units_eq q _]
      · rfl
      · intro a ha
        rw [MulChar.map_nonunit _ ha, zero_mul]
    _ = _ := by
      simp_rw [gaussSum_mulShift_of_isPrimitive _ hχ.inv, inv_inv,
        ← mul_assoc, Finset.sum_mul]

private theorem sum_units_eq_sum_coprime (q : ℕ) [NeZero q]
    {M : Type*} [AddCommMonoid M] (f : ℕ → M) :
    (∑ a : (ZMod q)ˣ, f ((a : ZMod q).val)) =
      ∑ a ∈ (Finset.range q).filter (fun a => a.Coprime q), f a := by
  refine Finset.sum_bij (fun (a : (ZMod q)ˣ) _ => (a : ZMod q).val) ?_ ?_ ?_ ?_
  · intro a _
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_range.mpr (ZMod.val_lt _), ZMod.val_coe_unit_coprime a⟩
  · intro a _ b _ hab
    apply Units.ext
    rw [← ZMod.natCast_zmod_val (a : ZMod q), ← ZMod.natCast_zmod_val (b : ZMod q), hab]
  · intro a ha
    obtain ⟨haq, hac⟩ := Finset.mem_filter.mp ha
    have hu := (ZMod.isUnit_iff_coprime a q).mpr hac
    exact ⟨hu.unit, Finset.mem_univ _, by
      rw [hu.unit_spec, ZMod.val_natCast_of_lt (Finset.mem_range.mp haq)]⟩
  · intro a _
    rfl

private theorem stdAddChar_natCast_mul (q : ℕ) [NeZero q] (n a : ℕ) :
    ZMod.stdAddChar ((n : ZMod q) * (a : ZMod q)) =
      Complex.exp (((2 * Real.pi * ((n : ℝ) * ((a : ℝ) / (q : ℝ))) : ℝ) : ℂ) *
        Complex.I) := by
  rw [← Nat.cast_mul, ← Int.cast_natCast, ZMod.stdAddChar_coe, Int.cast_natCast]
  push_cast
  congr 1
  ring

/-- The single-modulus primitive character sum is bounded by the reduced
additive frequency sum, with the usual large-sieve weight `q / φ(q)`. -/
theorem primitive_sieve_weighted (q : ℕ) [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ) :
    ((q : ℝ) / (q.totient : ℝ)) *
      (∑ χ ∈ (Finset.univ : Finset (DirichletCharacter ℂ q)).filter
        DirichletCharacter.IsPrimitive, ‖∑ n ∈ s, c n * χ (n : ZMod q)‖ ^ 2) ≤
      ∑ a ∈ (Finset.range q).filter (fun a => a.Coprime q),
        ‖∑ n ∈ s, c n *
          Complex.exp (((2 * Real.pi * ((n : ℝ) * ((a : ℝ) / (q : ℝ))) : ℝ) : ℂ) *
            Complex.I)‖ ^ 2 := by
  let t := (Finset.univ : Finset (DirichletCharacter ℂ q)).filter DirichletCharacter.IsPrimitive
  let G (a : (ZMod q)ˣ) := ∑ n ∈ s, c n * ZMod.stdAddChar ((n : ZMod q) * (a : ZMod q))
  have htot : (0 : ℝ) < q.totient := by exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  have hterm (χ : DirichletCharacter ℂ q) (hχ : χ ∈ t) :
      ‖∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))‖ ^ 2 =
        (q : ℝ) * ‖∑ n ∈ s, c n * χ (n : ZMod q)‖ ^ 2 := by
    have hp : χ.IsPrimitive := (Finset.mem_filter.mp hχ).2
    rw [show (∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))) = _ from
      gauss_transform q s c hp, norm_mul, mul_pow,
      DirichletCharacter.norm_gaussSum_stdAddChar hp.inv,
      Real.sq_sqrt (Nat.cast_nonneg q), mul_comm]
  have hbound : (q : ℝ) * (∑ χ ∈ t, ‖∑ n ∈ s, c n * χ (n : ZMod q)‖ ^ 2) ≤
      (q.totient : ℝ) * ∑ a : (ZMod q)ˣ, ‖G a‖ ^ 2 := by
    rw [Finset.mul_sum, ← parseval_star q G]
    calc
      _ = ∑ χ ∈ t, ‖∑ a : (ZMod q)ˣ, G a * star (χ (a : ZMod q))‖ ^ 2 :=
        Finset.sum_congr rfl (fun χ hχ => (hterm χ hχ).symm)
      _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.subset_univ t) (fun _ _ _ => sq_nonneg _)
  have hadd :
      (∑ a : (ZMod q)ˣ, ‖G a‖ ^ 2) = ∑ a ∈ (Finset.range q).filter (fun a => a.Coprime q),
        ‖∑ n ∈ s, c n *
          Complex.exp (((2 * Real.pi * ((n : ℝ) * ((a : ℝ) / (q : ℝ))) : ℝ) : ℂ) *
            Complex.I)‖ ^ 2 := by
    rw [← sum_units_eq_sum_coprime q]
    apply Finset.sum_congr rfl
    intro a _
    simp only [← stdAddChar_natCast_mul, ZMod.natCast_zmod_val, G]
  rw [← hadd, div_mul_eq_mul_div]
  exact (div_le_iff₀ htot).mpr (by simpa only [mul_comm] using hbound)

/-- The unweighted single-modulus primitive character bound. -/
theorem primitive_sieve (q : ℕ) [NeZero q] (s : Finset ℕ) (c : ℕ → ℂ) :
    (∑ χ ∈ (Finset.univ : Finset (DirichletCharacter ℂ q)).filter
      DirichletCharacter.IsPrimitive, ‖∑ n ∈ s, c n * χ (n : ZMod q)‖ ^ 2) ≤
      ∑ a ∈ (Finset.range q).filter (fun a => a.Coprime q),
        ‖∑ n ∈ s, c n *
          Complex.exp (((2 * Real.pi * ((n : ℝ) * ((a : ℝ) / (q : ℝ))) : ℝ) : ℂ) *
            Complex.I)‖ ^ 2 := by
  have htot : (0 : ℝ) < q.totient := by exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  have hweight : (1 : ℝ) ≤ (q : ℝ) / (q.totient : ℝ) :=
    (le_div_iff₀' htot).mpr (by simpa using (show (q.totient : ℝ) ≤ (q : ℝ) by
      exact_mod_cast Nat.totient_le q))
  exact (le_mul_of_one_le_left (Finset.sum_nonneg (fun _ _ => sq_nonneg _)) hweight).trans
    (primitive_sieve_weighted q s c)

end ShortAPPrimitive

end

section

open scoped BigOperators

namespace ShortAPWindowSieve

noncomputable def phase (x : ℝ) : ℂ :=
  Complex.exp (((2 * Real.pi * x : ℝ) : ℂ) * Complex.I)

/-- The usual additive large sieve on a translated interval. -/
def AdditiveLargeSieve : Prop :=
  ∀ (M L Q : ℕ) (c : ℕ → ℂ),
    (∑ q ∈ Finset.Icc 1 Q, ∑ a ∈ (Finset.range q).filter (fun a => Nat.Coprime a q),
      ‖∑ n ∈ Finset.Ico M (M + L), c n * phase ((n : ℝ) * ((a : ℝ) / q))‖ ^ 2)
      ≤ (Real.pi * (L : ℝ) + (Q : ℝ) ^ 2) * ∑ n ∈ Finset.Ico M (M + L), ‖c n‖ ^ 2

/-- A sliding logarithmic window on the positive integers up to `N` is an ordinary
translated interval. The strict lower endpoint of the log window stays strict. -/
theorem exists_log_window_Ico (N : ℕ) {T : ℝ} (hT : 0 < T) (y : ℝ) :
    ∃ M L : ℕ,
      (Finset.Icc 1 N).filter (fun n : ℕ => y ∈ Set.Ioc (Real.log n - 1 / T) (Real.log n)) =
        Finset.Ico M (M + L) ∧ (L : ℝ) ≤ (N : ℝ) / T + 1 := by
  classical
  let s := (Finset.Icc 1 N).filter (fun n : ℕ => y ∈ Set.Ioc (Real.log n - 1 / T) (Real.log n))
  change ∃ M L : ℕ, s = Finset.Ico M (M + L) ∧ (L : ℝ) ≤ (N : ℝ) / T + 1
  by_cases hs : s.Nonempty
  · let m := s.min' hs
    let n := s.max' hs
    have hm : m ∈ s := Finset.min'_mem _ _
    have hn : n ∈ s := Finset.max'_mem _ _
    have hmn : m ≤ n := Finset.min'_le _ _ hn
    have hm' := Finset.mem_filter.mp hm
    have hn' := Finset.mem_filter.mp hn
    have hm1 : 1 ≤ m := (Finset.mem_Icc.mp hm'.1).1
    have hnN : n ≤ N := (Finset.mem_Icc.mp hn'.1).2
    have hmpos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
    have hnpos : (0 : ℝ) < n := by exact_mod_cast (by omega : 0 < n)
    have hy_m : y ≤ Real.log m := hm'.2.2
    have hy_n : Real.log n - 1 / T < y := hn'.2.1
    refine ⟨m, n - m + 1, ?_, ?_⟩
    · ext k
      rw [Finset.mem_Ico]
      constructor
      · intro hk
        have h₁ : m ≤ k := Finset.min'_le _ _ hk
        have h₂ : k ≤ n := Finset.le_max' _ _ hk
        omega
      · intro hk
        have hmk : m ≤ k := hk.1
        have hkn : k ≤ n := by omega
        have hkpos : (0 : ℝ) < k := by exact_mod_cast (by omega : 0 < k)
        have hlog_mk := Real.log_le_log hmpos (by exact_mod_cast hmk : (m : ℝ) ≤ k)
        have hlog_kn := Real.log_le_log hkpos (by exact_mod_cast hkn : (k : ℝ) ≤ n)
        refine Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨by omega, by omega⟩, ?_⟩
        exact ⟨by linarith, hy_m.trans hlog_mk⟩
    · rw [Nat.cast_add, Nat.cast_sub hmn, Nat.cast_one]
      have hnN' : (n : ℝ) ≤ N := by exact_mod_cast hnN
      have hd := ShortAP.log_window_diameter hT hmpos hnpos hnN' (by linarith)
      linarith
  · refine ⟨0, 0, ?_, ?_⟩
    · simpa using Finset.not_nonempty_iff_eq_empty.mp hs
    · have hNT : 0 ≤ (N : ℝ) / T := div_nonneg (Nat.cast_nonneg N) hT.le
      simpa using (show 0 ≤ (N : ℝ) / T + 1 by linarith)

private theorem sum_window_eq_sum_filter {α : Type*} [AddCommMonoid α]
    (N : ℕ) (T y : ℝ) (f : ℕ → α) :
    (∑ n ∈ Finset.Icc 1 N,
      (Set.Ioc (Real.log n - 1 / T) (Real.log n)).indicator (fun _ : ℝ => f n) y) =
      ∑ n ∈ (Finset.Icc 1 N).filter
        (fun n : ℕ => y ∈ Set.Ioc (Real.log n - 1 / T) (Real.log n)), f n := by
  classical
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl fun n _ => ?_
  by_cases hn : y ∈ Set.Ioc (Real.log n - 1 / T) (Real.log n)
  · rw [Set.indicator_of_mem hn, ite_eq_left hn]
  · rw [Set.indicator_of_notMem hn, ite_eq_right hn]

/-- Pointwise sliding-window large sieve, using only the ordinary additive large sieve. -/
theorem log_window_large_sieve (hAdd : AdditiveLargeSieve) (N Q : ℕ) (c : ℕ → ℂ)
    {T : ℝ} (hT : 1 ≤ T) (hQ : 1 ≤ Q) (y : ℝ) :
    (∑ q ∈ Finset.Icc 1 Q, ∑ a ∈ (Finset.range q).filter (fun a => Nat.Coprime a q),
      ‖∑ n ∈ Finset.Icc 1 N, (Set.Ioc (Real.log n - 1 / T) (Real.log n)).indicator
        (fun _ : ℝ => c n * phase ((n : ℝ) * ((a : ℝ) / q))) y‖ ^ 2)
      ≤ (Real.pi + 1) * ((Q : ℝ) ^ 2 + (N : ℝ) / T) * ∑ n ∈ Finset.Icc 1 N,
        (Set.Ioc (Real.log n - 1 / T) (Real.log n)).indicator (fun _ : ℝ => ‖c n‖ ^ 2) y := by
  have hTpos : 0 < T := lt_of_lt_of_le zero_lt_one hT
  obtain ⟨M, L, hwindow, hlength⟩ := exists_log_window_Ico N hTpos y
  simp_rw [sum_window_eq_sum_filter, hwindow]
  refine (hAdd M L Q c).trans (mul_le_mul_of_nonneg_right ?_ (Finset.sum_nonneg fun _ _ => sq_nonneg _))
  have hQreal : (1 : ℝ) ≤ Q := by exact_mod_cast hQ
  have hQsq : 1 ≤ (Q : ℝ) ^ 2 := by nlinarith
  have hNT : 0 ≤ (N : ℝ) / T := div_nonneg (Nat.cast_nonneg N) hTpos.le
  have hL : (L : ℝ) ≤ (N : ℝ) / T + (Q : ℝ) ^ 2 := by linarith
  calc Real.pi * (L : ℝ) + (Q : ℝ) ^ 2
    _ ≤ Real.pi * ((N : ℝ) / T + (Q : ℝ) ^ 2) + (Q : ℝ) ^ 2 :=
      show _ from add_le_add_left (mul_le_mul_of_nonneg_left hL Real.pi_pos.le) _
    _ ≤ (Real.pi + 1) * ((Q : ℝ) ^ 2 + (N : ℝ) / T) := by nlinarith

end ShortAPWindowSieve

end

