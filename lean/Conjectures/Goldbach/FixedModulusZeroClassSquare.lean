    have hd := orderOf_dvd_of_pow_eq_one hq'
    have hu := Nat.le_of_dvd (by norm_num : 0<(2:ℕ)) hd
    omega
  apply Or.inr
  refine ⟨?_,fun h=>False.elim (hNoQ h)⟩
  by_cases h₃ : orderOf χ=3
  · have hQ : χ^3=1 := h₃ ▸ pow_orderOf_eq_one χ
    have hW' : ∀ j∈Icc (1:ℕ) 4,j≠3 →
        PrimeTestWindow (χ^j) ((j:ℝ)*t) σ T B L 2 (47/125) := by
      intro j hj he
      refine hWPow j hj ?_
      intro hPow
      have hd := orderOf_dvd_of_pow_eq_one hPow
      rw [h₃] at hd
      have hl := mem_Icc.mp hj
      omega
    have hh := hE₃ q χ σ t T B le_rfl hσ hL hB hBL hQ hW' hz'
    exact (by norm_num : (0.226:ℝ)≤1/4).trans_lt hh
  by_cases h₄ : orderOf χ=4
  · have hQ : χ^4=1 := h₄ ▸ pow_orderOf_eq_one χ
    have hW' : ∀ j∈Icc (1:ℕ) 4,j≠4 →
        PrimeTestWindow (χ^j) ((j:ℝ)*t) σ T B L 2 (47/125) := by
      intro j hj he
      have hl := mem_Icc.mp hj
      exact hWPow j hj (order_power_ne_one χ hl.1 (by omega))
    have hh := hE₄ q χ σ t T B le_rfl hσ hL hB hBL hQ hW' hz'
    exact (by norm_num : (0.226:ℝ)≤57/250).trans_lt hh
  have hOrd (j : ℕ) (hj : j∈Icc (1:ℕ) 4) : χ^j≠1 := by
    have hl := mem_Icc.mp hj
    exact order_power_ne_one χ hl.1 (by omega)
  norm_num only [show (0.226:ℝ)=113/500 by norm_num]
  exact hE₅ q χ σ t B T le_rfl hσ hB hBL
    hOrd (fun j hj=>⟨(hWPow j hj (hOrd j hj)).height,(hWPow j hj (hOrd j hj)).logHeight_le⟩)
    (fun j hj => (hWPow j hj (hOrd j hj)).strip)
    (fun j hj => (hWPow j hj (hOrd j hj)).leading) hz'

end GoldbachSignedPairs
