section
open Finset
open scoped BigOperators Classical
namespace Vit
noncomputable def Vdo (x δ u : ℝ) : ℝ :=
  (max (x-u) 0-max (x-δ-u) 0)/δ
noncomputable def Vs9 (x u : ℝ) : ℝ := if u≤x then 1 else 0
theorem V1yj (x δ u : ℝ) (hδ : 0<δ) :
    0≤Vs9 x u-Vdo x δ u ∧
    Vs9 x u-Vdo x δ u≤1 ∧
    (¬(x-δ<u ∧ u≤x) → Vs9 x u-Vdo x δ u=0) := by
  by_cases hlo : u≤x-δ
  · have hux : u≤x := by linarith
    have h0 : 0≤x-u := by linarith
    have h1 : 0≤x-δ-u := by linarith
    have hr : Vdo x δ u=1 := by
      rw [Vdo,max_eq_left h0,max_eq_left h1]
      field_simp
      ring
    simp [Vs9,hux,hr]
  · by_cases hhi : x<u
    · have h0 : x-u≤0 := by linarith
      have h1 : x-δ-u≤0 := by linarith
      simp [Vs9,not_le_of_gt hhi,Vdo,max_eq_right h0,max_eq_right h1]
    · have hb : x-δ<u ∧ u≤x := ⟨lt_of_not_ge hlo,le_of_not_gt hhi⟩
      have h0 : 0≤x-u := by linarith [hb.2]
      have h1 : x-δ-u≤0 := by linarith [hb.1]
      have hr : Vdo x δ u=(x-u)/δ := by
        simp [Vdo,max_eq_left h0,max_eq_right h1]
      have hquot0 : 0≤(x-u)/δ := div_nonneg h0 hδ.le
      have hquot1 : (x-u)/δ≤1 := (div_le_one hδ).2 (by linarith [hb.1])
      simp only [Vs9,ite_eq_left hb.2,hr]
      exact ⟨by linarith,by linarith,fun hn => (hn hb).elim⟩
noncomputable def Vdh (S : Finset ℕ) (a : ℕ → ℂ) (x : ℝ) : ℂ :=
  ∑ n∈S, if (n : ℝ)≤x then a n else 0
noncomputable def Vor (S : Finset ℕ) (a : ℕ → ℂ) (x : ℝ) : ℂ :=
  ∑ n∈S, a n*(max (x-(n : ℝ)) 0 : ℝ)
noncomputable def Vgc (S : Finset ℕ) (a : ℕ → ℂ) (x δ : ℝ) : ℂ :=
  (Vor S a x-Vor S a (x-δ))/(δ : ℂ)
theorem V1rv (S : Finset ℕ) (a : ℕ → ℂ) (x δ : ℝ) :
    Vgc S a x δ=
      ∑ n∈S, a n*(Vdo x δ (n : ℝ) : ℂ) := by
  unfold Vgc Vor
  rw [← sum_sub_distrib,sum_div]
  apply sum_congr rfl
  intro n hn
  simp only [Vdo,Complex.ofReal_div,Complex.ofReal_sub]
  ring
theorem V1iz (S : Finset ℕ) (a : ℕ → ℂ) (x δ : ℝ) :
    Vdh S a x-Vgc S a x δ=
      ∑ n∈S, a n*((Vs9 x (n : ℝ)-Vdo x δ (n : ℝ) : ℝ) : ℂ) := by
  rw [V1rv,Vdh,← sum_sub_distrib]
  apply sum_congr rfl
  intro n hn
  by_cases hn : (n : ℝ)≤x <;>
    simp [Vs9,hn,Complex.ofReal_sub] <;> ring
theorem V1g2 (S : Finset ℕ) (a : ℕ → ℂ)
    (x δ : ℝ) (hδ : 0<δ) :
    ‖Vdh S a x-Vgc S a x δ‖≤
      ∑ n∈S.filter (fun n : ℕ => x-δ<(n : ℝ) ∧ (n : ℝ)≤x), ‖a n‖ := by
  rw [V1iz]
  let B := S.filter (fun n : ℕ => x-δ<(n : ℝ) ∧ (n : ℝ)≤x)
  have he : (∑ n∈S, a n*((Vs9 x (n : ℝ)-Vdo x δ (n : ℝ) : ℝ) : ℂ)) =
      ∑ n∈B, a n*((Vs9 x (n : ℝ)-Vdo x δ (n : ℝ) : ℝ) : ℂ) := by
    apply (sum_subset (filter_subset _ _) ?_).symm
    intro n hn hnB
    have hb : ¬(x-δ<(n : ℝ) ∧ (n : ℝ)≤x) := by
      intro hb
      exact hnB (mem_filter.mpr ⟨hn,hb⟩)
    rw [(V1yj x δ n hδ).2.2 hb,Complex.ofReal_zero,mul_zero]
  rw [he]
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro n hn
  obtain ⟨hn0,hn1,_⟩ := V1yj x δ n hδ
  rw [norm_mul,Complex.norm_real,Real.norm_of_nonneg hn0]
  simpa only [mul_one] using mul_le_mul_of_nonneg_left hn1 (norm_nonneg (a n))
theorem V1xs (S : Finset ℕ) (x δ : ℝ) (hδ : 0≤δ) (hxδ : δ≤x) :
    ((S.filter (fun n : ℕ => x-δ<(n : ℝ) ∧ (n : ℝ)≤x)).card : ℝ)≤δ+1 := by
  have hx : 0≤x := hδ.trans hxδ
  have hxd : 0≤x-δ := sub_nonneg.mpr hxδ
  have hsub : S.filter (fun n : ℕ => x-δ<(n : ℝ) ∧ (n : ℝ)≤x)⊆
      Ioc ⌊x-δ⌋₊ ⌊x⌋₊ := by
    intro n hn
    obtain ⟨hnS,hnl,hnr⟩ := mem_filter.mp hn
    exact mem_Ioc.mpr ⟨(Nat.floor_lt hxd).2 hnl,(Nat.le_floor_iff hx).2 hnr⟩
  have hfloor : ⌊x-δ⌋₊≤⌊x⌋₊ := Nat.floor_mono (by linarith)
  have hleft := Nat.lt_floor_add_one (x-δ)
  have hright := Nat.floor_le hx
  calc
    _ ≤ ((Ioc ⌊x-δ⌋₊ ⌊x⌋₊).card : ℝ) := by exact_mod_cast card_le_card hsub
    _ = (⌊x⌋₊ : ℝ)-(⌊x-δ⌋₊ : ℝ) := by rw [Nat.card_Ioc,Nat.cast_sub hfloor]
    _ ≤ δ+1 := by linarith
theorem V1o5 (S : Finset ℕ) (a : ℕ → ℂ)
    (x δ M : ℝ) (hδ : 0<δ) (hxδ : δ≤x) (hM : 0≤M)
    (ha : ∀ n∈S, (n : ℝ)≤x → ‖a n‖≤M) :
    ‖Vdh S a x-Vgc S a x δ‖≤(δ+1)*M := by
  apply (V1g2 S a x δ hδ).trans
  calc
    _ ≤ ∑ _n∈S.filter (fun n : ℕ => x-δ<(n : ℝ) ∧ (n : ℝ)≤x), M := by
      apply sum_le_sum
      intro n hn
      exact ha n (mem_filter.mp hn).1 (mem_filter.mp hn).2.2
    _ = ((S.filter (fun n : ℕ => x-δ<(n : ℝ) ∧ (n : ℝ)≤x)).card : ℝ)*M := by simp
    _ ≤ (δ+1)*M := mul_le_mul_of_nonneg_right (V1xs S x δ hδ.le hxδ) hM
end Vit
end

