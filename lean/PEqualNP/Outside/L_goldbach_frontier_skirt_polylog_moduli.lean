  let b (i : ι) := ‖a i‖*X^((ρ i).re-1)
  have hK (i j : ι) : 0≤K i j := by dsimp [K]; positivity
  have hSym (i j : ι) : K i j=K j i := by dsimp [K]; rw [abs_sub_comm]
  have hscale (i j : ι) :
      X^((ρ i).re+(ρ j).re+1) = X^3*X^((ρ i).re-1)*X^((ρ j).re-1) := by
    rw [← Real.rpow_natCast X 3, ← Real.rpow_add hX, ← Real.rpow_add hX]
    congr 1
    ring
  have hpair (i : ι) (hi : i∈S) (j : ι) (hj : j∈S) :
      ‖(a i*conj (a j))*(∫ y in X..4*X, (y : ℂ)^(ρ i+conj (ρ j)))‖ ≤
        (130*X^3)*(K i j*b i*b j) := by
    have hk := V1vt X hX (ρ i+conj (ρ j))
      (by simp only [Complex.add_re, Complex.conj_re]; exact add_nonneg (hρ0 i hi) (hρ0 j hj))
      (by simp only [Complex.add_re, Complex.conj_re]; linarith [hρ1 i hi,hρ1 j hj])
    simp only [Complex.add_re, Complex.conj_re, Complex.add_im, Complex.conj_im,
      ← sub_eq_add_neg] at hk
    rw [hscale i j] at hk
    calc
      _ = ‖a i‖*‖a j‖*‖∫ y in X..4*X, (y : ℂ)^(ρ i+conj (ρ j))‖ := by
        simp only [norm_mul, Complex.norm_conj]
      _ ≤ ‖a i‖*‖a j‖*((130*(X^3*X^((ρ i).re-1)*X^((ρ j).re-1)))/
          (1+|(ρ i).im-(ρ j).im|)) :=
        mul_le_mul_of_nonneg_left hk (by positivity)
      _ = _ := by dsimp [K,b]; ring
  have hschur := V1p8 S K b R
    (fun i _ j _ => hK i j) (fun i _ j _ => hSym i j) hRow
  have hb2 (i : ι) : (b i)^2 = ‖a i‖^2*X^(2*(ρ i).re-2) := by
    rw [show 2*(ρ i).re-2 = ((ρ i).re-1)*(2 : ℝ) by ring,
      Real.rpow_mul hX.le, Real.rpow_two]
    dsimp [b]
    ring
  have hexpand := V1kn S a ρ X hX hρ0
  calc
    _ = (∑ i∈S, ∑ j∈S, (a i*conj (a j)) *
        (∫ y in X..4*X, (y : ℂ)^(ρ i+conj (ρ j)))).re := by
      exact congrArg Complex.re hexpand
    _ ≤ ‖∑ i∈S, ∑ j∈S, (a i*conj (a j)) *
        (∫ y in X..4*X, (y : ℂ)^(ρ i+conj (ρ j)))‖ := Complex.re_le_norm _
    _ ≤ ∑ i∈S, ∑ j∈S, ‖(a i*conj (a j)) *
        (∫ y in X..4*X, (y : ℂ)^(ρ i+conj (ρ j)))‖ := by
      apply (norm_sum_le _ _).trans
      exact sum_le_sum fun i _ => norm_sum_le _ _
    _ ≤ ∑ i∈S, ∑ j∈S, (130*X^3)*(K i j*b i*b j) :=
      sum_le_sum fun i hi => sum_le_sum fun j hj => hpair i hi j hj
    _ = (130*X^3)*(∑ i∈S, ∑ j∈S, K i j*b i*b j) := by simp only [mul_sum]
    _ ≤ (130*X^3)*(R*∑ i∈S, (b i)^2) :=
      mul_le_mul_of_nonneg_left hschur (by positivity)
    _ = _ := by simp only [hb2]; ring
theorem V1r0 {ι : Type*} (S : Finset ι)
    (a ρ : ι → ℂ) (X R A : ℝ) (hX : 0<X) (hR : 0≤R)
    (hρ0 : ∀ i∈S, 0≤(ρ i).re) (hρ1 : ∀ i∈S, (ρ i).re≤1)
