        V28 p a x j % p^(min (j.val+1) (r+1)) := by
  have hcast : (∑ i, (((X+C (a : ZMod (p^(r+1))))^(j.val+1)).eval
      (V7v p r x i))) =
      ((∑ i, ((x.1 i).val+1+a)^(j.val+1) : ℕ) : ZMod (p^(r+1))) := by
    simp only [eval_pow,eval_add,eval_X,eval_C,V7v,Nat.cast_sum,
      Nat.cast_pow,Nat.cast_add]
