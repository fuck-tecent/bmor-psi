theorem euler_factor_ne_zero (χ : DirichletCharacter ℂ q)
    {p : ℕ} (hp : p.Prime) {s : ℂ} (hs : 0 < s.re) :
    1 - χ (p : ZMod q) * (p : ℂ) ^ (-s) ≠ 0 := by
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hp.one_lt
  have hneg : (-s).re < 0 := by simpa only [neg_re, neg_neg_iff_pos] using hs
  have hpw : ‖(p : ℂ) ^ (-s)‖ < 1 := by
    rw [norm_natCast_cpow_of_re_ne_zero _ hneg.ne]
    exact Real.rpow_lt_one_of_one_lt_of_neg hp1 hneg
  have h := (mul_le_of_le_one_left (norm_nonneg ((p : ℂ) ^ (-s))) (χ.norm_le_one (p : ZMod q))).trans_lt hpw
  intro he
  have hh : χ (p : ZMod q) * (p : ℂ) ^ (-s) = 1 := (sub_eq_zero.mp he).symm
  rw [← norm_mul, hh, norm_one] at h
  exact (lt_irrefl (1 : ℝ)) h

theorem regularized_changeLevel_coeff {r : ℕ} [NeZero r] (hr : r ∣ q)
    (χ : DirichletCharacter ℂ r) {s : ℂ} (hs : s ≠ 1) :
    regularizedL (changeLevel hr χ) s =
      regularizedL χ s * (∏ p ∈ q.primeFactors, (1 - χ (p : ZMod r) * (p : ℂ) ^ (-s))) := by
  have h := LFunction_changeLevel hr χ (Or.inr hs)
  by_cases hχ : χ = 1
  · subst χ
    rw [changeLevel_one] at h ⊢
    simp only [regularizedL, ite_true, LFunctionTrivChar₁, Function.update_of_ne hs]
    change (s - 1) * LFunction (1 : DirichletCharacter ℂ q) s = _
    rw [h, LFunctionTrivChar, mul_assoc]
  · have hq : changeLevel hr χ ≠ 1 := hχ ∘ (changeLevel_eq_one_iff hr).mp
    simpa only [regularizedL, hχ, hq, ite_false] using h

theorem changeLevel_regularized_zero_iff {r : ℕ} [NeZero r] (hr : r ∣ q)
    (χ : DirichletCharacter ℂ r) {s : ℂ} (hs : 0 < s.re) (hs₁ : s ≠ 1) :
    regularizedL (changeLevel hr χ) s = 0 ↔ regularizedL χ s = 0 := by
  rw [regularized_changeLevel_coeff hr χ hs₁]
  have hF : (∏ p ∈ q.primeFactors, (1 - χ (p : ZMod r) * (p : ℂ) ^ (-s))) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun p hp => euler_factor_ne_zero χ (Nat.prime_of_mem_primeFactors hp) hs)
  exact mul_eq_zero.trans (or_iff_left hF)

theorem changeLevel_regularized_order {r : ℕ} [NeZero r] (hr : r ∣ q)
    (χ : DirichletCharacter ℂ r) {s : ℂ} (hs : 0 < s.re) (hs₁ : s ≠ 1) :
    analyticOrderNatAt (regularizedL (changeLevel hr χ)) s =
      analyticOrderNatAt (regularizedL χ) s := by
  let F (z : ℂ) := ∏ p ∈ q.primeFactors, (1 - χ (p : ZMod r) * (p : ℂ) ^ (-z))
  have hF : F s ≠ 0 := Finset.prod_ne_zero_iff.mpr
    (fun p hp => euler_factor_ne_zero χ (Nat.prime_of_mem_primeFactors hp) hs)
  have hFA : AnalyticAt ℂ F s := by
    apply Finset.analyticAt_fun_prod
    intro p hp
    have hp₀ : (p : ℂ) ≠ 0 := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).ne_zero
    have hc : AnalyticAt ℂ (fun z : ℂ => (p : ℂ) ^ (-z)) s := by
      simp_rw [Complex.cpow_def_of_ne_zero hp₀]
      fun_prop
    exact analyticAt_const.sub (analyticAt_const.mul hc)
  have hEq : regularizedL (changeLevel hr χ) =ᶠ[𝓝 s] fun t => regularizedL χ t * F t := by
    filter_upwards [eventually_ne_nhds hs₁] with t ht
    exact regularized_changeLevel_coeff hr χ ht
  unfold analyticOrderNatAt
  rw [analyticOrderAt_congr hEq]
  change (analyticOrderAt (regularizedL χ * F) s).toNat = _
  rw [analyticOrderAt_mul (analytic_regularizedL χ s (Set.mem_univ s)) hFA,
    hFA.analyticOrderAt_eq_zero.mpr hF, add_zero]

theorem regularized_primitive_zero_iff (χ : DirichletCharacter ℂ q) [NeZero χ.conductor]
    {s : ℂ} (hs : 0 < s.re) :
    regularizedL χ s = 0 ↔ regularizedL χ.primitiveCharacter s = 0 := by
  by_cases h : s = 1
  · subst s
    simp only [Goldbach.regularizedL_ne_zero_at_one]
  · simpa only [changeLevel_primitiveCharacter χ] using
      changeLevel_regularized_zero_iff χ.conductor_dvd_level χ.primitiveCharacter hs h


end GoldbachConductorZeros
