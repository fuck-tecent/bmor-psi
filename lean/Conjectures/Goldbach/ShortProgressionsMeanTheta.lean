/-- The genuine box energy in the moderate-height small-conductor range,
with no short-scale hypothesis. `D` is the conductor scale used for `Q`. -/
theorem all_scales_energy (j B Bq : ℕ) (hj : j < 4) {CHeight : ℝ} (hHeight : 1 ≤ CHeight) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ᶠ x : ℝ in atTop,
      ∀ {X H Q : ℕ} (a z T Z D θ β : ℝ) (b : Choice j)
        (U : {i // i ∈ blockIndices j} → ℝ),
      let s := (blockIndices j).attach
      let F := fun k (χ : ShortAP.CharIndex) (t : ℝ) =>
        boxPolynomial H j k.val (b k.val k.property) χ.2 (point t)
      H ≠ 0 → H ≤ X → (X:ℝ) ≤ 4*x → (H:ℝ) ≤ (4*x)^((1:ℝ)/4) → x ≤ a → z ≤ 4*x →
      b ∈ activeChoices X H j a z → 1 ≤ Q → 1 ≤ T → 0 ≤ Z → 1 ≤ D → D ≤ (Real.log x)^B →
      (Q:ℝ) ≤ 2*D → (Q:ℝ) ≤ 2*(Real.log x)^Bq → 2*T ≤ x → (Q:ℝ)^2*(2*T) ≤ CHeight*Z →
      5/8 ≤ θ → θ ≤ 1 → (1-θ)/3+1/32 ≤ β → (∀ k, 1 ≤ U k) →
      D^2*x^β*(Real.log x)^19 = x^θ → Z*x^β ≤ x*(Real.log x)^120 →
      D^2*T*x^β ≤ x*(Real.log x)^120 →
      (∑ χ ∈ (ShortAP.primitiveFamily Q).filter (fun χ => 1 < χ.1),
        ∫ t in amplitudeBox s F T U χ, ‖∏ k ∈ s, F k χ t‖^2)*(Real.log x)^77 ≤ K*x := by
  classical
  obtain ⟨K,hK,hLong⟩ := ShortAPLongFactorEnergy.actual_long_factor_energy
      (c := 4) (C := 4) (by norm_num) (by norm_num)
  let Cshort := ((2:ℝ)^8)^2 * (4*boxSamplingConstant 4 4 CHeight)
  refine ⟨max Cshort K, hK.trans (le_max_right _ _), ?_⟩
  filter_upwards [scale_split, ShortAPSmallConductorEnergy.all_blocks_energy j B Bq hj hHeight,
    hLong, eventually_ge_atTop (1:ℝ)] with x hSplit hShort hL hx
  intro X H Q a z T Z D θ β b U s F hH hHX hX hHr ha hz hb hQ hT hZ hD hDB hQD hQsmall
    hTx hZQ hθ hθ₁ hβ hU hid hZheight hDheight
  let ι := {i // i ∈ blockIndices j}
  let M := fun k : ι => scale (b k.val k.property)
  let I := (ShortAP.primitiveFamily Q).filter (fun χ => 1 < χ.1)
  let P := amplitudeBox s F T U
  obtain hShort' | ⟨k,hk,hKlong⟩ := hSplit θ β D T hH hHX hHr hb hθ hβ
    (zero_lt_one.trans_le hD) (zero_le_one.trans hT) hid hDheight
  · have h := hShort a z T Z D θ β b U hH hHX hX hHr ha hz hb hQ hT hZ
      (zero_lt_one.trans_le hD) hDB hQsmall hTx hZQ hθ hθ₁ hβ hShort' hU hid hZheight
    exact h.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (zero_le_one.trans hx))
  · let N := fun l : ι => ⌊4*M l⌋₊
    let d := fun l : ι => logDegree l.val
    let f := fun l : ι => complexCoeffs (boxFactor H j l.val (b l.val l.property))
    have hCont (χ : ShortAP.CharIndex) (l : ι) : Continuous (F l χ) :=
      continuous_factor (N l) (f l) χ.2
    have hmem : k ∈ s := mem_attach _ _
    have hs : s.card ≤ 8 := by simp [s, blockIndices]; omega
    have hN (l : ι) (_ : l ∈ s) : 1 ≤ N l ∧ (N l:ℝ) ≤ 4*M l := by
      have h₀ : 0 ≤ 4*M l := mul_nonneg (by norm_num) (scale_pos _).le
      exact ⟨(Nat.le_floor_iff h₀).mpr (by
        have hHalf : 1/2 ≤ M l := one_half_le_scale _
        change (1:ℝ) ≤ 4*M l
        linarith), Nat.floor_le h₀⟩
    have hd : logDegree k.val + (∑ l ∈ s.erase k, d l) ≤ 1 := by
      change d k + (∑ l ∈ s.erase k, d l) ≤ 1
      rw [Finset.add_sum_erase s d hmem]
      exact ShortAPSmallConductorProduct.sampling_degree j
    have hProd : (∏ l ∈ s, M l) ≤ 4*x := (active_box_scales hb).2.trans hz
    have hEq : ∀ χ : ShortAP.CharIndex, ∀ t : ℝ, (∏ l ∈ s, F l χ t) =
        boxPolynomial H j k.val (b k.val k.property) χ.2 (point t) *
          (∏ l ∈ s.erase k, ShortAPFactorSampling.factor (N l) (f l) χ.2 (point t)) := by
      intro χ t
      rw [← Finset.mul_prod_erase s (fun l => F l χ t) hmem]
      rfl
    have he := hL s hmem hs N d M f hQ hD hT hQD (by linarith : (1:ℝ)/32 ≤ β) hDheight
      I (filter_subset _ _) (fun χ hχ => (mem_filter.mp hχ).2) H j k.val (b k.val k.property) hk rfl
      (fun l _ => by linarith [show (1:ℝ)/2 ≤ M l from one_half_le_scale _]) hN hProd hKlong hd
      (fun l _ n hn => ShortAPSmallConductorProduct.sampling_support H j l.val (b l.val l.property) n hn)
      (fun l _ n hn => ShortAPSmallConductorProduct.sampling_coeff H j l.val (b l.val l.property) n hn)
      P (fun χ _ => measurableSet_amplitudeBox s F T U χ (fun l _ => hCont χ l))
      (fun χ _ _ ht => abs_le.mp (abs_le_of_mem_amplitudeBox ht))
    change (∑ χ ∈ I, ∫ t in P χ, ‖∏ l ∈ s, F l χ t‖^2)*_ ≤ _
    simp only [hEq]
    exact he.trans (mul_le_mul_of_nonneg_right (le_max_right _ _) (zero_le_one.trans hx))

end

end ShortAPActualScaleBands

