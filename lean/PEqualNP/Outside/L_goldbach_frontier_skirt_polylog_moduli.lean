    apply Finset.card_le_card_of_injOn (fun k : ℕ => k/q)
    · intro k hk
      have hm := mem_Ioc.mp (mem_filter.mp hk).1
      exact mem_Icc.mpr ⟨Nat.div_le_div_right hm.1.le, Nat.div_le_div_right hm.2⟩
    · intro k hk l hl he
