noncomputable section

private theorem auxiliary_radius_avoids_zeros {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ ≠ 1)
    (t : ℝ) (w : ℂ) (hw : ‖w-line 1 t‖≤1/8) (Z : Finset ℂ)
    (hcover : ∀ ρ : ℂ, ‖ρ-line 1 t‖≤1/2 → regularizedL χ ρ=0 → ρ∈Z) :
    ∃ R : ℝ, (1/8:ℝ)<R ∧ R<1/4 ∧
      ∀ z∈sphere (0:ℂ) R, χ.LFunction (w+z)≠0 := by
  obtain ⟨R,hRI,hR⟩ := (Set.Ioo_infinite (show (1/8:ℝ)<1/4 by norm_num)).exists_notMem_finset
    (Z.image fun ρ=>‖ρ-w‖)
  refine ⟨R,hRI.1,hRI.2,?_⟩
  intro z hz hzero
  have hzR : ‖z‖=R := by simpa [Metric.mem_sphere,dist_eq_norm] using hz
  have hdist : ‖w+z-line 1 t‖≤1/2 := by
    have h := norm_add_le (w-line 1 t) z
    rw [show w-line 1 t+z=w+z-line 1 t by ring,hzR] at h
    linarith only [h,hw,hRI.2]
  have hzZ := hcover (w+z) hdist (by simpa [regularizedL,hχ] using hzero)
  apply hR
  exact Finset.mem_image.mpr ⟨w+z,hzZ,by simpa using hzR⟩

private theorem translate_finite_zeros {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ≠1) (w : ℂ) (V : Finset ℂ)
    {δ : ℝ} (hV : ∀ ρ∈V, ‖ρ-w‖≤δ ∧ regularizedL χ ρ=0) :
    let W := V.map (Equiv.subRight w).toEmbedding
    (∀ z∈W, ‖z‖≤δ ∧ χ.LFunction (w+z)=0) ∧
    (∑ z∈W,(analyticOrderNatAt χ.LFunction (w+z):ℝ)) =
      ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ) ∧
    (∑ z∈W,(analyticOrderNatAt χ.LFunction (w+z):ℝ)*(-(1/z)).re) =
      ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*(1/(w-ρ)).re := by
  intro W
  have hreg : regularizedL χ=χ.LFunction := by simp [regularizedL,hχ]
  have htrans (ρ : ℂ) : w+(Equiv.subRight w) ρ=ρ := by
    change w+(ρ-w)=ρ
    ring
  refine ⟨?_,?_,?_⟩
  · intro z hz
    obtain ⟨ρ,hρ,rfl⟩ := Finset.mem_map.mp hz
    change ‖ρ-w‖≤δ ∧ χ.LFunction (w+(Equiv.subRight w) ρ)=0
    exact ⟨(hV ρ hρ).1,by simpa [htrans,hreg] using (hV ρ hρ).2⟩
  · unfold W
    simp only [Finset.sum_map,Equiv.toEmbedding_apply,htrans,hreg]
  · unfold W
    simp only [Finset.sum_map,Equiv.toEmbedding_apply,htrans,hreg]
    apply Finset.sum_congr rfl
    intro ρ _
    change _ * (-(1/(ρ-w))).re = _ * (1/(w-ρ)).re
    rw [show ρ-w=-(w-ρ) by ring,div_neg,neg_neg]

private theorem re_weighted_pole_sum (m : ℂ→ℕ) (V : Finset ℂ) (f : ℂ→ℂ) :
    (∑ ρ∈V,(m ρ:ℂ)*f ρ).re=∑ ρ∈V,(m ρ:ℝ)*(f ρ).re := by
  change Complex.reAddGroupHom (∑ ρ∈V,(m ρ:ℂ)*f ρ)=_
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro ρ _
  change ((m ρ:ℂ)*f ρ).re=_
  rw [←Complex.ofReal_natCast]
  simp [Complex.mul_re]

set_option maxHeartbeats 1900000 in
/-- Local analytic remainder on the evaluation disk with the sharp strip
coefficient and exact weighted zero window. -/
theorem sharp_local_window_remainder :
    ∃ A : ℝ, 0<A ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
    χ≠1 → ∀ {w : ℂ} {r e T φ B Q : ℝ},
      0<r → r≤1/32 → 0<e → 1+e≤w.re → w.re≤1+r/2 →
      |w.im|+1/4≤T → 0≤φ → 1≤B → 1≤Q →
      (∀ z : ℂ, 3/4≤z.re → z.re≤3/2 → |z.im|≤T →
        ‖χ.LFunction z‖≤B*Q^(φ*max 0 (1-z.re))) →
      ∃ V : Finset ℂ, ∃ G : ℂ→ℂ,
      (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ ‖ρ-line 1 w.im‖≤2*r) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 w.im‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
      AnalyticOnNhd ℂ G (closedBall w (r/2)) ∧
      (∀ z∈closedBall w (r/2), ‖G z‖≤(1+r⁻¹)*(A*logHeight q w.im)) ∧
      ((fun z=>-logDeriv χ.LFunction z) =ᶠ[𝓝 w]
        (fun z=>G z-∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*(1/(z-ρ)))) ∧
      (G w).re≤φ*Real.log Q/2+16*(max (Real.log (1+e⁻¹)) (Real.log B))+
        192*r*(A*logHeight q w.im) := by
  obtain ⟨A,hA,hAux⟩ := nonprincipal_local_analytic_remainder_with_coverage
  refine ⟨A,hA,?_⟩
  intro q _ χ hχ w r e T φ B Q hr hrmax he hwe hwr hT hφ hB hQ hstrip
  let t := w.im
  let M := A*logHeight q t
  let m := analyticOrderNatAt (regularizedL χ)
  have hM : 0≤M := mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one q t))
  have hw : 1<w.re := by linarith only [he,hwe]
  have hwdist : ‖w-line 1 t‖≤r/2 := by
    have heq : w-line 1 t=((w.re-1:ℝ):ℂ) := by
      apply Complex.ext <;> simp [t,line,Complex.sub_re,Complex.sub_im,Complex.mul_re,Complex.mul_im]
    rw [heq,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (sub_pos.mpr hw)]
    linarith only [hwr]
  obtain ⟨Z,G,hZ,hZMass,hGa,hGb,hGe,hcover⟩ := hAux q χ hχ t
  obtain ⟨G',hG'a,hG'b,hG'e⟩ := selected_analytic_remainder χ hr
    (hrmax.trans (by norm_num)) hM Z G hGa hGb hZMass hGe
  let V := Z.filter (fun ρ=>‖ρ-line 1 t‖≤2*r)
  have hVZ : V⊆Z := Finset.filter_subset _ _
  have hVM : (∑ ρ∈V,(m ρ:ℝ))≤M :=
    (Finset.sum_le_sum_of_subset_of_nonneg hVZ (fun _ _ _=>Nat.cast_nonneg _)).trans hZMass
  have hV (ρ : ℂ) (hρ : ρ∈V) : ‖ρ-w‖≤3*r ∧ regularizedL χ ρ=0 := by
    obtain ⟨hρZ,hρd⟩ := Finset.mem_filter.mp hρ
    have hh := norm_add_le (ρ-line 1 t) (line 1 t-w)
    rw [sub_add_sub_cancel,norm_sub_rev (line 1 t) w] at hh
    exact ⟨by linarith only [hh,hρd,hwdist,hr],(hZ ρ hρZ).1⟩
  obtain ⟨R,hRlo,hRhi,hRfree⟩ := auxiliary_radius_avoids_zeros χ hχ t w
    (hwdist.trans (by linarith only [hrmax])) Z hcover
  have hR : 0<R := (by norm_num : (0:ℝ)<1/8).trans hRlo
  have hδR : 3*r<R := by linarith only [hRlo,hrmax]
  let W := V.map (Equiv.subRight w).toEmbedding
  obtain ⟨hW,hW0,hW1⟩ := translate_finite_zeros χ hχ w V hV
  have hD := sharp_logDeriv_of_strip χ hχ he hR hRhi.le hwe
    (hwr.trans (by linarith only [hrmax])) (by linarith only [hT,hRhi])
    hφ hB hQ hstrip (mul_nonneg (by norm_num) hr.le) hδR hRfree W hW
  change _ ≤ _ + _ + (3*r/R^2)*(∑ z∈W,(analyticOrderNatAt χ.LFunction (w+z):ℝ)) -
    ∑ z∈W,(analyticOrderNatAt χ.LFunction (w+z):ℝ)*(-(1/z)).re at hD
  rw [hW0,hW1] at hD
  have hwBall : w∈ball (line 1 t) r := mem_ball_iff_norm.mpr
    (hwdist.trans_lt (by linarith only [hr]))
  have hDe : (fun z=>-logDeriv χ.LFunction z) =ᶠ[𝓝 w]
      (fun z=>G' z-∑ ρ∈V,(m ρ:ℂ)*(1/(z-ρ))) := by
    have hwRe : w∈{z : ℂ | 1<z.re} := hw
    have ho : IsOpen {z : ℂ | 1<z.re} := isOpen_lt continuous_const Complex.continuous_re
    filter_upwards [isOpen_ball.mem_nhds hwBall,ho.mem_nhds hwRe] with z hz hz'
    simpa [div_eq_mul_inv] using hG'e z (ball_subset_closedBall hz) hz'
  have hwSmall : closedBall w (r/2) ⊆ closedBall (line 1 t) r := by
    intro z hz
    apply mem_closedBall_iff_norm.mpr
    have hh := norm_add_le (z-w) (w-line 1 t)
    rw [sub_add_sub_cancel] at hh
    linarith only [hh,mem_closedBall_iff_norm.mp hz,hwdist]
  have hcG : G' w=(fun z=>-logDeriv χ.LFunction z) w+
      ∑ ρ∈V,(m ρ:ℂ)*(1/(w-ρ)) := by
    have h := hDe.eq_of_nhds
    dsimp only at h ⊢
    rw [h,sub_add_cancel]
  have hE : 0 ≤ max (Real.log (1+e⁻¹)) (Real.log B) :=
    (Real.log_nonneg hB).trans (le_max_right _ _)
  have hE' : 2*(max (Real.log (1+e⁻¹)) (Real.log B))/R≤
      16*(max (Real.log (1+e⁻¹)) (Real.log B)) := by
    apply (div_le_iff₀ hR).mpr
    have hh := mul_le_mul_of_nonneg_left hRlo.le (mul_nonneg (by norm_num : (0:ℝ)≤16) hE)
    nlinarith only [hh]
  have hR8 : (1/64:ℝ) ≤ R^2 := by
    have hh := pow_le_pow_left₀ (show (0:ℝ)≤1/8 by norm_num) hRlo.le 2
    norm_num at hh ⊢
    exact hh
  have hV' : (3*r/R^2)*(∑ ρ∈V,(m ρ:ℝ))≤192*r*M := calc
    _ ≤ (3*r/R^2)*M := mul_le_mul_of_nonneg_left hVM (by positivity)
    _ ≤ _ := by
      rw [div_mul_eq_mul_div]
      apply (div_le_iff₀ (by positivity : 0<R^2)).mpr
      have hh := mul_le_mul_of_nonneg_left hR8 (show 0≤192*r*M by positivity)
      nlinarith only [hh]
  have hG'Re : (G' w).re≤φ*Real.log Q/2+16*(max (Real.log (1+e⁻¹)) (Real.log B))+192*r*M := by
    rw [hcG,Complex.add_re,re_weighted_pole_sum]
    linarith only [hD,hE',hV']
  refine ⟨V,G',(fun ρ hρ=>⟨(hV ρ hρ).2,(hZ ρ (hVZ hρ)).2.1,(Finset.mem_filter.mp hρ).2⟩),
    ?_,hG'a.mono hwSmall,(fun z hz=>hG'b z (hwSmall hz)),hDe,hG'Re⟩
  intro ρ hρ hzero
  refine Finset.mem_filter.mpr ⟨hcover ρ (hρ.trans ?_) hzero,hρ⟩
  linarith only [hrmax]

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Filter

/-- Uniform error absorption at the conductor logarithm. The zero disk
radius is chosen before the lower cutoff for the scale. -/
theorem rational_jet_error_budget {ε A K κ b D C : ℝ} (hε : 0<ε)
    (hA : 0<A) (hK : 0<K) (hκ : 0<κ) (hb : 0<b) (hD : 0≤D) (_hC : 0≤C) :
    ∃ r L₀ : ℝ, 0<r ∧ r≤1/32 ∧ 1≤L₀ ∧
      ∀ L M B : ℝ, L₀≤L → 0≤M → M≤A*K*L → Real.log B≤D*Real.log L →
      C/L≤r/2 ∧
      16*(max (Real.log (1+(κ/L)⁻¹)) (Real.log B)) + 192*r*M +
        (b/L)*((1+r⁻¹)*M)/(r/2) +
        (2/3:ℝ)*(b/L)^2*((1+r⁻¹)*M)/(r/2)^2≤ε*L := by
  let r : ℝ := min (1/64) (ε/(768*A*K))
  let G : ℝ := (1+r⁻¹)*A*K
  let P : ℝ := b*G/(r/2) + (2/3:ℝ)*b^2*G/(r/2)^2
  let a : ℝ := 1+κ⁻¹
  have hr : 0<r := lt_min (by norm_num) (by positivity)
  have hr32 : r≤1/32 :=
    (min_le_left _ _).trans (by norm_num)
  have hrE : 192*r*(A*K)≤ε/4 := by
    have h := (le_div_iff₀ (show 0<768*A*K by positivity)).mp (min_le_right (1/64:ℝ) (ε/(768*A*K)))
    change r*(768*A*K)≤ε at h
    linarith only [h]
  have hG : 0<G := by dsimp [G]; positivity
  have hP : 0<P := by dsimp [P]; positivity
  have ha : 1≤a := le_add_of_nonneg_right (inv_nonneg.mpr hκ.le)
  have ha0 : 0<a := zero_lt_one.trans_le ha
  obtain ⟨L₁,hL₁⟩ := eventually_atTop.mp
    (Real.isLittleO_log_id_atTop.def (show 0<ε/(64*(D+1)) by positivity))
  let L₀ := max (max 1 L₁) (max (2*C/r) (4*(16*Real.log a+P)/ε))
  refine ⟨r,L₀,hr,hr32,(le_max_left _ _).trans (le_max_left _ _),?_⟩
  intro L M B hL hM hMK hB
  have hL1 : 1≤L := (le_max_left _ _).trans ((le_max_left _ _).trans hL)
  have hLpos : 0<L := zero_lt_one.trans_le hL1
  have hL₁' : L₁≤L := (le_max_right _ _).trans ((le_max_left _ _).trans hL)
  have hgeom : 2*C/r≤L := (le_max_left _ _).trans ((le_max_right _ _).trans hL)
  have hCauch : 4*(16*Real.log a+P)/ε≤L := (le_max_right _ _).trans ((le_max_right _ _).trans hL)
  refine ⟨(div_le_iff₀ hLpos).mpr (by
    have h := (div_le_iff₀ hr).mp hgeom
    nlinarith only [h]),?_⟩
  have hlogL : 0≤Real.log L := Real.log_nonneg hL1
  have hloga : 0≤Real.log a := Real.log_nonneg ha
  have hlog : Real.log L≤ε/(64*(D+1))*L := by
    simpa [id,Real.norm_eq_abs,abs_of_nonneg hlogL,abs_of_pos hLpos] using hL₁ L hL₁'
  have h0 : Real.log (1+(κ/L)⁻¹)≤Real.log a+Real.log L := by
    rw [inv_div]
    have h : 1+L/κ≤a*L := by
      dsimp [a]
      rw [div_eq_mul_inv]
      nlinarith only [hL1]
    have h' := Real.log_le_log (by positivity : 0<1+L/κ) h
    rwa [Real.log_mul ha0.ne' hLpos.ne'] at h'
  have h1 : 16*(max (Real.log (1+(κ/L)⁻¹)) (Real.log B))≤16*Real.log a + ε*L/4 := by
    have hlog₁ : (D+1)*Real.log L≤ε*L/64 := by
      calc
        _ ≤ (D+1)*(ε/(64*(D+1))*L) := mul_le_mul_of_nonneg_left hlog (by positivity)
        _ = _ := by field_simp [show D+1≠0 by positivity]
    have hm : max (Real.log (1+(κ/L)⁻¹)) (Real.log B)≤Real.log a+(D+1)*Real.log L := by
      apply max_le
      · linarith only [h0,mul_nonneg hD hlogL]
      · linarith only [hB,hloga,hlogL]
    linarith only [hm,hlog₁]
  have h2 : 192*r*M≤ε*L/4 := by
    have hM' := mul_le_mul_of_nonneg_left hMK (show 0≤192*r by positivity)
    have hR' := mul_le_mul_of_nonneg_right hrE hLpos.le
    nlinarith only [hM',hR']
  have hGM : (1+r⁻¹)*M≤G*L := by
    have h := mul_le_mul_of_nonneg_left hMK (show 0≤1+r⁻¹ by positivity)
    dsimp [G]
    nlinarith only [h]
  have hc1 : (b/L)*((1+r⁻¹)*M)/(r/2)≤b*G/(r/2) := by
    apply div_le_div_of_nonneg_right _ (by positivity)
    calc
      _ ≤ (b/L)*(G*L) := mul_le_mul_of_nonneg_left hGM (by positivity)
      _ = _ := by field_simp [hLpos.ne']
  have hc2 : (2/3:ℝ)*(b/L)^2*((1+r⁻¹)*M)/(r/2)^2≤(2/3:ℝ)*b^2*G/(r/2)^2 := by
    apply div_le_div_of_nonneg_right _ (by positivity)
    calc
      _ ≤ (2/3:ℝ)*(b/L)^2*(G*L) := mul_le_mul_of_nonneg_left hGM (by positivity)
      _ = ((2/3:ℝ)*b^2*G)/L := by field_simp [hLpos.ne']
      _ ≤ _ := (div_le_iff₀ hLpos).mpr (by
        have h := mul_le_mul_of_nonneg_left hL1 (show 0≤(2/3:ℝ)*b^2*G by positivity)
        simpa only [mul_one] using h)
  have hc : 16*Real.log a+P≤ε*L/4 := by
    have h := (div_le_iff₀ hε).mp hCauch
    linarith only [h]
  dsimp [P] at hc
  linarith only [h1,h2,hc1,hc2,hc,mul_nonneg hε.le hLpos.le]

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Set GoldbachSmoothing LSeries
open scoped Topology

noncomputable section

/-- The second logarithmic-derivative combination for the rational test. -/
def rationalLogJet (D : ℂ→ℂ) (c w : ℂ) : ℂ :=
  D w-c*deriv D w+c^2/3*iteratedDeriv 2 D w

set_option maxHeartbeats 1100000 in
/-- The rational prime test is an absolutely convergent Dirichlet series
after moving its exponential factor into the real evaluation point. -/
theorem rationalLogJet_eq_prime_series {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {w : ℂ} (hw : 1<w.re) (c : ℂ) :
    rationalLogJet (fun z=>-logDeriv χ.LFunction z) c w =
      ∑' n : ℕ, term (twistedCoefficient χ) w n *
        (1+c*Complex.log (n:ℂ)+(c*Complex.log (n:ℂ))^2/3) := by
  let a := twistedCoefficient χ
  let D : ℂ→ℂ := fun z=>-logDeriv χ.LFunction z
  let b := logMul a
  let k := logMul b
  have hab : abscissaOfAbsConv a ≤ ((1:ℝ):EReal) :=
    abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun z hz=>
      χ.LSeriesSummable_twist_vonMangoldt hz)
  have hσ : abscissaOfAbsConv a < (w.re:EReal) := hab.trans_lt (by exact_mod_cast hw)
  have he : D =ᶠ[𝓝 w] LSeries a := by
    have ho : IsOpen {z : ℂ | 1 < z.re} := isOpen_lt continuous_const Complex.continuous_re
    have hm : w ∈ {z : ℂ | 1 < z.re} := hw
    filter_upwards [ho.mem_nhds hm] with z hz
    exact (LSeries_twistedCoefficient_eq χ hz).symm
  have h0 : D w=LSeries a w := he.eq_of_nhds
  have h1 : deriv D w=-LSeries b w := he.deriv_eq.trans (LSeries_deriv hσ)
  have h2 : iteratedDeriv 2 D w=LSeries k w := by
    rw [he.iteratedDeriv_eq 2,LSeries_iteratedDeriv 2 hσ]
    norm_num [k,b,Function.iterate_succ_apply']
  have hSa : Summable (term a w) := χ.LSeriesSummable_twist_vonMangoldt hw
  have hSb : Summable (term b w) := LSeriesSummable_logMul_of_lt_re hσ
  have hSk : Summable (term k w) := LSeriesSummable_logMul_of_lt_re
    (by simpa [b] using hσ : abscissaOfAbsConv b < (w.re:EReal))
  unfold rationalLogJet
  change D w-c*deriv D w+c^2/3*iteratedDeriv 2 D w = _
  rw [h0,h1,h2,mul_neg,sub_neg_eq_add]
  unfold LSeries
  rw [←tsum_mul_left,←tsum_mul_left,←hSa.tsum_add (hSb.mul_left c),
    ←(hSa.add (hSb.mul_left c)).tsum_add (hSk.mul_left (c^2/3))]
  apply tsum_congr
  intro n
  by_cases hn : n=0
  · subst n
    simp
  · simp only [term_of_ne_zero hn,k,b,logMul]
    ring

/-- Explicit derivative budget for the analytic remainder in the rational
test on the original right half-plane. -/
theorem rationalLogJet_analytic_error {G : ℂ→ℂ} {w : ℂ} {R M : ℝ}
    (hR : 0<R) (hG : AnalyticOnNhd ℂ G (Metric.closedBall w R))
    (hM : ∀ z∈Metric.closedBall w R, ‖G z‖≤M) (c : ℂ) :
    ‖rationalLogJet G c w-G w‖≤‖c‖*M/R+(2/3:ℝ)*‖c‖^2*M/R^2 := by
  have hDiff : DiffContOnCl ℂ G (Metric.ball w R) :=
    ((hG.mono Metric.closure_ball_subset_closedBall).differentiableOn).diffContOnCl
  have hSphere : ∀ z∈Metric.sphere w R, ‖G z‖≤M :=
    fun z hz=>hM z (Metric.sphere_subset_closedBall hz)
  have h1 := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hDiff hSphere
  have h2 := Complex.norm_iteratedDeriv_le_of_forall_mem_sphere_norm_le 2 hR hDiff hSphere
  have h2' : ‖iteratedDeriv 2 G w‖≤2*M/R^2 := by simpa using h2
  unfold rationalLogJet
  rw [show G w-c*deriv G w+c^2/3*iteratedDeriv 2 G w-G w =
    -(c*deriv G w)+c^2/3*iteratedDeriv 2 G w by ring]
  apply (norm_add_le _ _).trans
  rw [norm_neg,norm_mul,norm_mul,norm_div,norm_pow,norm_ofNat]
  have hA := mul_le_mul_of_nonneg_left h1 (norm_nonneg c)
  have hB := mul_le_mul_of_nonneg_left h2' (show 0≤‖c‖^2/3 by positivity)
  exact (add_le_add hA hB).trans_eq (by ring)

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Set Finset
open scoped Topology

noncomputable section

private theorem hasDerivAt_reciprocal_shift {w ρ : ℂ} (hw : w≠ρ) :
    HasDerivAt (fun z : ℂ => 1/(z-ρ)) (-( (w-ρ)^2)⁻¹) w := by
  have hd := ((hasDerivAt_id' w).sub_const ρ).inv (sub_ne_zero.mpr hw)
  convert hd using 1
  · funext z
    simp [Pi.inv_apply,one_div]
  · simp [div_eq_mul_inv]

private theorem hasDerivAt_reciprocal_shift_deriv {w ρ : ℂ} (hw : w≠ρ) :
    HasDerivAt (fun z : ℂ => -((z-ρ)^2)⁻¹) (2/(w-ρ)^3) w := by
  have hd := ((((hasDerivAt_id' w).sub_const ρ).pow 2).inv
    (pow_ne_zero 2 (sub_ne_zero.mpr hw))).neg
  convert hd using 1
  simp only [Pi.pow_apply, Nat.cast_ofNat, mul_one]
  field_simp [sub_ne_zero.mpr hw]; ring

/-- The rational weighted jet acts exactly on a simple local zero pole. -/
theorem rationalLogJet_reciprocal_shift {w ρ : ℂ} (hw : w≠ρ) (c : ℂ) :
    rationalLogJet (fun z=>1/(z-ρ)) c w =
      1/(w-ρ)+c/(w-ρ)^2+(2*c^2/3)/(w-ρ)^3 := by
  have he : deriv (fun z : ℂ => 1/(z-ρ)) =ᶠ[𝓝 w]
      fun z => -((z-ρ)^2)⁻¹ := by
    filter_upwards [eventually_ne_nhds hw] with z hz
    exact (hasDerivAt_reciprocal_shift hz).deriv
  have h2 : iteratedDeriv 2 (fun z : ℂ => 1/(z-ρ)) w=2/(w-ρ)^3 := by
    rw [show (2:ℕ)=1+1 by rfl,iteratedDeriv_succ,iteratedDeriv_one,he.deriv_eq]
    exact (hasDerivAt_reciprocal_shift_deriv hw).deriv
  unfold rationalLogJet
  rw [he.eq_of_nhds,h2]
  simp only [div_eq_mul_inv]
  ring

private theorem rational_reciprocal_analyticAt {w ρ : ℂ} (hw : w≠ρ) :
    AnalyticAt ℂ (fun z : ℂ => 1/(z-ρ)) w := by
  have hd : AnalyticAt ℂ (fun z : ℂ => z-ρ) w := by fun_prop
  exact analyticAt_const.fun_div hd (sub_ne_zero.mpr hw)

set_option maxHeartbeats 950000 in
/-- Exact passage from a finite set of local poles and an analytic
remainder to the weighted rational logarithmic-derivative jet. -/
theorem rationalLogJet_of_partial_fractions
    {D G : ℂ→ℂ} {w : ℂ} (hG : AnalyticAt ℂ G w)
    (V : Finset ℂ) (m : ℂ→ℂ) (hV : ∀ ρ∈V, w≠ρ)
    (hEq : D =ᶠ[𝓝 w] (fun z => G z-∑ ρ∈V,m ρ*(1/(z-ρ)))) (c : ℂ) :
    rationalLogJet D c w = rationalLogJet G c w -
      ∑ ρ∈V,m ρ*(1/(w-ρ)+c/(w-ρ)^2+(2*c^2/3)/(w-ρ)^3) := by
  let P : ℂ → ℂ := fun z=>∑ ρ∈V,m ρ*(1/(z-ρ))
  have hP : AnalyticAt ℂ P w :=
    V.analyticAt_fun_sum (fun ρ hρ=>analyticAt_const.fun_mul (rational_reciprocal_analyticAt (hV ρ hρ)))
  have h1 : deriv D w=deriv G w-deriv P w := by
    rw [hEq.deriv_eq,deriv_fun_sub hG.differentiableAt hP.differentiableAt]
  have h2 :
      iteratedDeriv 2 D w=iteratedDeriv 2 G w-iteratedDeriv 2 P w := by
    rw [hEq.iteratedDeriv_eq 2,iteratedDeriv_fun_sub hG.contDiffAt hP.contDiffAt]
  have hdp :
      deriv P w=∑ ρ∈V,m ρ*deriv (fun z : ℂ => 1/(z-ρ)) w := by
    have hdiff (ρ : ℂ) (hρ : ρ∈V) :
        DifferentiableAt ℂ (fun z : ℂ => m ρ*(1/(z-ρ))) w :=
      ((hasDerivAt_reciprocal_shift (hV ρ hρ)).const_mul (m ρ)).differentiableAt
    unfold P
    rw [deriv_fun_sum hdiff]
    apply Finset.sum_congr rfl
    intro ρ _
    rw [deriv_const_mul_field]
  have h2p :
      iteratedDeriv 2 P w=∑ ρ∈V,m ρ*iteratedDeriv 2 (fun z : ℂ => 1/(z-ρ)) w := by
    have hd (ρ : ℂ) (hρ : ρ∈V) :
        ContDiffAt ℂ 2 (fun z : ℂ => m ρ*(1/(z-ρ))) w :=
      (analyticAt_const.fun_mul (rational_reciprocal_analyticAt (hV ρ hρ))).contDiffAt
    unfold P
    rw [iteratedDeriv_fun_sum hd]
    exact Finset.sum_congr rfl (fun ρ _=>iteratedDeriv_const_mul_field (m ρ) _)
  have hJet : (∑ ρ∈V,m ρ*rationalLogJet (fun z=>1/(z-ρ)) c w)=
      ∑ ρ∈V,m ρ*(1/(w-ρ)+c/(w-ρ)^2+(2*c^2/3)/(w-ρ)^3) :=
    Finset.sum_congr rfl (fun ρ hρ=>congrArg (fun z=>m ρ*z) (rationalLogJet_reciprocal_shift (hV ρ hρ) c))
  have hJ' : (∑ ρ∈V,m ρ*rationalLogJet (fun z=>1/(z-ρ)) c w)=
      P w - c*(∑ ρ∈V,m ρ*deriv (fun z : ℂ => 1/(z-ρ)) w) +
        c^2/3*(∑ ρ∈V,m ρ*iteratedDeriv 2 (fun z : ℂ => 1/(z-ρ)) w) := by
    unfold rationalLogJet P
    rw [Finset.mul_sum,Finset.mul_sum,←Finset.sum_sub_distrib,←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro ρ _
    ring
  rw [←hJet,hJ']
  unfold rationalLogJet
  rw [hEq.eq_of_nhds,h1,h2,hdp,h2p]
  change (G w-P w)-c*(deriv G w-_)+c^2/3*(iteratedDeriv 2 G w-_)=_
  ring

/-- Algebraic conversion from the unscaled pole to the Laplace test with
conductor logarithm L and rational decay b. -/
theorem rational_pole_scale {s ρ w : ℂ} {L b : ℝ}
    (hL : L≠0) (hw : w≠ρ) (he : w=s+(b:ℂ)/(L:ℂ)) :
    let z := (b:ℂ)+(L:ℂ)*(s-ρ)
    1/(w-ρ)+((b:ℂ)/(L:ℂ))/(w-ρ)^2+
      (2*((b:ℂ)/(L:ℂ))^2/3)/(w-ρ)^3 =
      (L:ℂ)*(1/z+(b:ℂ)/z^2+(2*(b:ℂ)^2/3)/z^3) := by
  intro z
  have hLc : (L:ℂ)≠0 := ofReal_ne_zero.mpr hL
  have hwr : w-ρ≠0 := sub_ne_zero.mpr hw
  have hz : z=(L:ℂ)*(w-ρ) := by
    unfold z
    rw [he]
    field_simp [hLc]
    ring
  rw [hz]
  field_simp [hLc,hwr]

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Set Finset GoldbachSmoothing LSeries
open scoped Topology

noncomputable section

/-- The second logarithmic-derivative combination for the rational test. -/
def independentRationalJet (D : ℂ→ℂ) (u v w : ℂ) : ℂ :=
  D w-u*deriv D w+v*iteratedDeriv 2 D w

set_option maxHeartbeats 1100000 in
/-- The rational prime test is an absolutely convergent Dirichlet series
after moving its exponential factor into the real evaluation point. -/
theorem independentRationalJet_eq_prime_series {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {w : ℂ} (hw : 1<w.re) (u v : ℂ) :
    independentRationalJet (fun z=>-logDeriv χ.LFunction z) u v w =
      ∑' n : ℕ, term (twistedCoefficient χ) w n *
        (1+u*Complex.log (n:ℂ)+v*(Complex.log (n:ℂ))^2) := by
  let a := twistedCoefficient χ
  let D : ℂ→ℂ := fun z=>-logDeriv χ.LFunction z
  let b := logMul a
  let k := logMul b
  have hab : abscissaOfAbsConv a ≤ ((1:ℝ):EReal) :=
    abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun z hz=>
      χ.LSeriesSummable_twist_vonMangoldt hz)
  have hσ : abscissaOfAbsConv a < (w.re:EReal) := hab.trans_lt (by exact_mod_cast hw)
  have he : D =ᶠ[𝓝 w] LSeries a := by
    have ho : IsOpen {z : ℂ | 1 < z.re} := isOpen_lt continuous_const Complex.continuous_re
    have hm : w ∈ {z : ℂ | 1 < z.re} := hw
    filter_upwards [ho.mem_nhds hm] with z hz
    exact (LSeries_twistedCoefficient_eq χ hz).symm
  have h0 : D w=LSeries a w := he.eq_of_nhds
  have h1 : deriv D w=-LSeries b w := he.deriv_eq.trans (LSeries_deriv hσ)
  have h2 : iteratedDeriv 2 D w=LSeries k w := by
    rw [he.iteratedDeriv_eq 2,LSeries_iteratedDeriv 2 hσ]
    norm_num [k,b,Function.iterate_succ_apply']
  have hSa : Summable (term a w) := χ.LSeriesSummable_twist_vonMangoldt hw
  have hSb : Summable (term b w) := LSeriesSummable_logMul_of_lt_re hσ
  have hSk : Summable (term k w) := LSeriesSummable_logMul_of_lt_re
    (by simpa [b] using hσ : abscissaOfAbsConv b < (w.re:EReal))
  unfold independentRationalJet
  change D w-u*deriv D w+v*iteratedDeriv 2 D w = _
  rw [h0,h1,h2,mul_neg,sub_neg_eq_add]
  unfold LSeries
  rw [←tsum_mul_left,←tsum_mul_left,←hSa.tsum_add (hSb.mul_left u),
    ←(hSa.add (hSb.mul_left u)).tsum_add (hSk.mul_left v)]
  apply tsum_congr
  intro n
  by_cases hn : n=0
  · subst n
    simp
  · simp only [term_of_ne_zero hn,k,b,logMul]
    ring

/-- Explicit derivative budget for the analytic remainder in the rational
test on the original right half-plane. -/
theorem independentRationalJet_analytic_error {G : ℂ→ℂ} {w : ℂ} {R M : ℝ}
    (hR : 0<R) (hG : AnalyticOnNhd ℂ G (Metric.closedBall w R))
    (hM : ∀ z∈Metric.closedBall w R, ‖G z‖≤M) (u v : ℂ) :
    ‖independentRationalJet G u v w-G w‖≤‖u‖*M/R+2*‖v‖*M/R^2 := by
  have hDiff : DiffContOnCl ℂ G (Metric.ball w R) :=
    ((hG.mono Metric.closure_ball_subset_closedBall).differentiableOn).diffContOnCl
  have hSphere : ∀ z∈Metric.sphere w R, ‖G z‖≤M :=
    fun z hz=>hM z (Metric.sphere_subset_closedBall hz)
  have h1 := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hDiff hSphere
  have h2 := Complex.norm_iteratedDeriv_le_of_forall_mem_sphere_norm_le 2 hR hDiff hSphere
  have h2' : ‖iteratedDeriv 2 G w‖≤2*M/R^2 := by simpa using h2
  unfold independentRationalJet
  rw [show G w-u*deriv G w+v*iteratedDeriv 2 G w-G w =
    -(u*deriv G w)+v*iteratedDeriv 2 G w by ring]
  apply (norm_add_le _ _).trans
  rw [norm_neg,norm_mul,norm_mul]
  have hA := mul_le_mul_of_nonneg_left h1 (norm_nonneg u)
  have hB := mul_le_mul_of_nonneg_left h2' (norm_nonneg v)
  exact (add_le_add hA hB).trans_eq (by ring)

private theorem independentRationalJet_eq_combination (D : ℂ→ℂ) (u v w : ℂ) :
    independentRationalJet D u v w=(1-3*v)*rationalLogJet D 0 w+
      ((3*v+u)/2)*rationalLogJet D 1 w+((3*v-u)/2)*rationalLogJet D (-1) w := by
  unfold independentRationalJet rationalLogJet
  ring

theorem independentRationalJet_reciprocal_shift {w ρ : ℂ} (hw : w≠ρ) (u v : ℂ) :
    independentRationalJet (fun z=>1/(z-ρ)) u v w=
      1/(w-ρ)+u/(w-ρ)^2+2*v/(w-ρ)^3 := by
  rw [independentRationalJet_eq_combination,rationalLogJet_reciprocal_shift hw,
    rationalLogJet_reciprocal_shift hw,rationalLogJet_reciprocal_shift hw]
  ring

private theorem independent_reciprocal_analyticAt {w ρ : ℂ} (hw : w≠ρ) :
    AnalyticAt ℂ (fun z : ℂ => 1/(z-ρ)) w := by
  have hd : AnalyticAt ℂ (fun z : ℂ => z-ρ) w := by fun_prop
  exact analyticAt_const.fun_div hd (sub_ne_zero.mpr hw)

set_option maxHeartbeats 950000 in
/-- Exact passage from a finite set of local poles and an analytic
remainder to the weighted rational logarithmic-derivative jet. -/
theorem independentRationalJet_of_partial_fractions
    {D G : ℂ→ℂ} {w : ℂ} (hG : AnalyticAt ℂ G w)
    (V : Finset ℂ) (m : ℂ→ℂ) (hV : ∀ ρ∈V, w≠ρ)
    (hEq : D =ᶠ[𝓝 w] (fun z => G z-∑ ρ∈V,m ρ*(1/(z-ρ)))) (u v : ℂ) :
    independentRationalJet D u v w = independentRationalJet G u v w -
      ∑ ρ∈V,m ρ*(1/(w-ρ)+u/(w-ρ)^2+2*v/(w-ρ)^3) := by
  let P : ℂ → ℂ := fun z=>∑ ρ∈V,m ρ*(1/(z-ρ))
  have hP : AnalyticAt ℂ P w :=
    V.analyticAt_fun_sum (fun ρ hρ=>analyticAt_const.fun_mul (independent_reciprocal_analyticAt (hV ρ hρ)))
  have h1 : deriv D w=deriv G w-deriv P w := by
    rw [hEq.deriv_eq,deriv_fun_sub hG.differentiableAt hP.differentiableAt]
  have h2 :
      iteratedDeriv 2 D w=iteratedDeriv 2 G w-iteratedDeriv 2 P w := by
    rw [hEq.iteratedDeriv_eq 2,iteratedDeriv_fun_sub hG.contDiffAt hP.contDiffAt]
  have hdp :
      deriv P w=∑ ρ∈V,m ρ*deriv (fun z : ℂ => 1/(z-ρ)) w := by
    have hdiff (ρ : ℂ) (hρ : ρ∈V) :
        DifferentiableAt ℂ (fun z : ℂ => m ρ*(1/(z-ρ))) w :=
      (analyticAt_const.fun_mul (independent_reciprocal_analyticAt (hV ρ hρ))).differentiableAt
    unfold P
    rw [deriv_fun_sum hdiff]
    apply Finset.sum_congr rfl
    intro ρ _
    rw [deriv_const_mul_field]
  have h2p :
      iteratedDeriv 2 P w=∑ ρ∈V,m ρ*iteratedDeriv 2 (fun z : ℂ => 1/(z-ρ)) w := by
    have hd (ρ : ℂ) (hρ : ρ∈V) :
        ContDiffAt ℂ 2 (fun z : ℂ => m ρ*(1/(z-ρ))) w :=
      (analyticAt_const.fun_mul (independent_reciprocal_analyticAt (hV ρ hρ))).contDiffAt
    unfold P
    rw [iteratedDeriv_fun_sum hd]
    exact Finset.sum_congr rfl (fun ρ _=>iteratedDeriv_const_mul_field (m ρ) _)
  have hJet : (∑ ρ∈V,m ρ*independentRationalJet (fun z=>1/(z-ρ)) u v w)=
      ∑ ρ∈V,m ρ*(1/(w-ρ)+u/(w-ρ)^2+2*v/(w-ρ)^3) :=
    Finset.sum_congr rfl (fun ρ hρ=>congrArg (fun z=>m ρ*z) (independentRationalJet_reciprocal_shift (hV ρ hρ) u v))
  have hJ' : (∑ ρ∈V,m ρ*independentRationalJet (fun z=>1/(z-ρ)) u v w)=
      P w - u*(∑ ρ∈V,m ρ*deriv (fun z : ℂ => 1/(z-ρ)) w) +
        v*(∑ ρ∈V,m ρ*iteratedDeriv 2 (fun z : ℂ => 1/(z-ρ)) w) := by
    unfold independentRationalJet P
    rw [Finset.mul_sum,Finset.mul_sum,←Finset.sum_sub_distrib,←Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro ρ _
    ring
  rw [←hJet,hJ']
  unfold independentRationalJet
  rw [hEq.eq_of_nhds,h1,h2,hdp,h2p]
  change (G w-P w)-u*(deriv G w-_)+v*(iteratedDeriv 2 G w-_)=_
  ring


end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedFormula

open Complex Goldbach GoldbachZeroFree Finset
open scoped Classical

noncomputable section

/-- The finite weighted prime sum of Heath-Brown and Xylouris with an
explicit weight, also defined to the left of the line one. -/
def primeSum {q : ℕ} (S : Finset ℕ) (w : ℕ → ℝ) (χ : DirichletCharacter ℂ q)
    (σ t : ℝ) : ℝ :=
  ∑ n ∈ S, (w n*ArithmeticFunction.vonMangoldt n*(n:ℝ)^(-σ)) *
    (χ (n:ZMod q)*(n:ℂ)^(-(t:ℂ)*I)).re

private theorem square_re_of_norm_one {z : ℂ} (hz : ‖z‖=1) :
    (z^2).re = 2*z.re^2-1 := by
  have h := Complex.sq_norm z
  rw [hz,one_pow,Complex.normSq_apply] at h
  rw [pow_two,Complex.mul_re]
  nlinarith only [h]

private theorem cube_re_of_norm_one {z : ℂ} (hz : ‖z‖=1) :
    (z^3).re = 4*z.re^3-3*z.re := by
  have h := Complex.sq_norm z
  rw [hz,one_pow,Complex.normSq_apply] at h
  rw [show z^3=z^2*z by ring,pow_two,Complex.mul_re,Complex.mul_re,Complex.mul_im]
  linear_combination 3*z.re*h

private theorem fourth_re_of_norm_one {z : ℂ} (hz : ‖z‖=1) :
    (z^4).re = 8*z.re^4-8*z.re^2+1 := by
  have h := square_re_of_norm_one (z:=z^2) (by rw [norm_pow,hz,one_pow])
  rw [square_re_of_norm_one hz,show (z^2)^2=z^4 by ring] at h
  exact h.trans (by ring)

/-- The degree-four test in Heath-Brown’s Equation (9.15). -/
theorem heathBrown_trig_nonneg {z : ℂ} (hz : ‖z‖=1) :
    0 ≤ 14379+24480*z.re+14900*(z^2).re+6000*(z^3).re+1250*(z^4).re := by
  rw [square_re_of_norm_one hz,cube_re_of_norm_one hz,fourth_re_of_norm_one hz]
  convert mul_nonneg (sq_nonneg (3+10*z.re)) (sq_nonneg (9+10*z.re)) using 1
  ring

private theorem phase_pow {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) (t : ℝ)
    (k : ℕ) (hk : k ≠ 0) :
    (χ^k) (n:ZMod q)*(n:ℂ)^(-(((k:ℝ)*t:ℝ):ℂ)*I) =
      (χ (n:ZMod q)*(n:ℂ)^(-(t:ℂ)*I))^k := by
  rw [χ.pow_apply' hk,show -(((k:ℝ)*t:ℝ):ℂ)*I = (k:ℂ)*(-(t:ℂ)*I) by push_cast; ring,
    Complex.cpow_nat_mul,mul_pow]

private theorem phase_norm_of_unit {q : ℕ} (χ : DirichletCharacter ℂ q) {n : ℕ}
    (hn : 0<n) (hu : IsUnit (n:ZMod q)) (t : ℝ) :
    ‖χ (n:ZMod q)*(n:ℂ)^(-(t:ℂ)*I)‖ = 1 := by
  have hχ : ‖χ (n:ZMod q)‖ = 1 := χ.unit_norm_eq_one hu.unit
  rw [norm_mul,hχ,Complex.norm_natCast_cpow_of_pos hn]
  simp [Complex.mul_re]

/-- The exact five-term positivity behind Xylouris §3.1.5. -/
theorem heathBrown_primeSum_nonneg {q : ℕ} (χ : DirichletCharacter ℂ q)
    (S : Finset ℕ) (w : ℕ → ℝ) (hw : ∀ n ∈ S, 0≤w n) (σ t : ℝ) :
    0 ≤ 14379*primeSum S w (1:DirichletCharacter ℂ q) σ 0 +
      24480*primeSum S w χ σ t + 14900*primeSum S w (χ^2) σ (2*t) +
      6000*primeSum S w (χ^3) σ (3*t) + 1250*primeSum S w (χ^4) σ (4*t) := by
  simp only [primeSum,mul_sum,← sum_add_distrib]
  apply sum_nonneg
  intro n hnS
  by_cases hn : n=0
  · subst n
    simp
  by_cases hu : IsUnit (n:ZMod q)
  · let z := χ (n:ZMod q)*(n:ℂ)^(-(t:ℂ)*I)
    let c := w n*ArithmeticFunction.vonMangoldt n*(n:ℝ)^(-σ)
    have hcz : 0≤c := mul_nonneg
      (mul_nonneg (hw n hnS) ArithmeticFunction.vonMangoldt_nonneg) (by positivity)
    have hz := phase_norm_of_unit χ (Nat.pos_of_ne_zero hn) hu t
    have h2 := phase_pow χ n t 2 (by decide)
    have h3 := phase_pow χ n t 3 (by decide)
    have h4 := phase_pow χ n t 4 (by decide)
    norm_num only [Nat.cast_ofNat] at h2 h3 h4
    rw [MulChar.one_apply hu,h2,h3,h4]
    simp only [ofReal_zero,neg_zero,zero_mul,cpow_zero,mul_one,one_re]
    change 0 ≤ 14379*c+24480*(c*z.re)+14900*(c*(z^2).re)+6000*(c*(z^3).re)+1250*(c*(z^4).re)
    convert mul_nonneg hcz (heathBrown_trig_nonneg hz) using 1
    ring
  · simp [MulChar.map_nonunit _ hu]


end
end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzNumerics

open Complex

noncomputable section

def anchorRationalKernel (b : ℝ) (z : ℂ) : ℂ :=
  1/((b:ℂ)+z)+(((7/8:ℝ)*b:ℝ):ℂ)/((b:ℂ)+z)^2+((b:ℂ)^2)/((b:ℂ)+z)^3

def anchorRationalKernelReal (b x : ℝ) : ℝ :=
  1/(b+x)+(7/8:ℝ)*b/(b+x)^2+b^2/(b+x)^3

theorem anchorRationalKernel_ofReal_re (b x : ℝ) :
    (anchorRationalKernel b (x:ℂ)).re=anchorRationalKernelReal b x := by
  have h : anchorRationalKernel b (x:ℂ)=(anchorRationalKernelReal b x:ℂ) := by
    unfold anchorRationalKernel anchorRationalKernelReal
    push_cast
    ring
  rw [h,Complex.ofReal_re]

private theorem anchorRationalKernel_re_formula {b x t : ℝ} (h : 0 < b+x) :
    let u := b+x
    let v := t^2
    (anchorRationalKernel b ((x:ℂ)+(t:ℂ)*I)).re =
      (u^5+(7/8:ℝ)*b*u^4+b^2*u^3+(2*u^3-3*b^2*u)*v+(u-(7/8:ℝ)*b)*v^2)/(u^2+v)^3 := by
  dsimp only
  let u := b+x
  let w : ℂ := (u:ℂ)+(t:ℂ)*I
  have hw₁ : (b:ℂ)+((x:ℂ)+(t:ℂ)*I)=w := by simp only [w,u,Complex.ofReal_add]; ring
  have hwR : w.re=u := by simp [w,Complex.mul_re]
  have hwI : w.im=t := by simp [w,Complex.mul_im]
  have hwN : Complex.normSq w = u^2+t^2 := by rw [Complex.normSq_apply,hwR,hwI]; ring
  have hd : u^2+t^2 ≠ 0 := (add_pos_of_pos_of_nonneg (sq_pos_of_pos h) (sq_nonneg _)).ne'
  have hwSum : w⁻¹ = (((u/(u^2+t^2)):ℝ):ℂ)+(((-t/(u^2+t^2)):ℝ):ℂ)*I := by
    apply Complex.ext
    · rw [Complex.inv_re,hwR,hwN]
      simp only [Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
        Complex.I_re,Complex.I_im,mul_zero,zero_mul,sub_zero,add_zero]
    · rw [Complex.inv_im,hwI,hwN]
      simp only [Complex.add_im,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im,
        Complex.I_re,Complex.I_im,mul_zero,zero_mul,mul_one,zero_add,add_zero]
  change _ = (u^5+(7/8:ℝ)*b*u^4+b^2*u^3+(2*u^3-3*b^2*u)*t^2+(u-(7/8:ℝ)*b)*(t^2)^2)/(u^2+t^2)^3
  simp only [anchorRationalKernel,hw₁,div_eq_mul_inv,one_mul,← inv_pow,hwSum]
  simp only [pow_succ,pow_zero,one_mul,Complex.add_re,Complex.add_im,Complex.mul_re,Complex.mul_im,
    Complex.ofReal_re,Complex.ofReal_im,Complex.I_re,Complex.I_im,
    zero_mul,mul_zero,zero_add,add_zero,sub_zero,mul_one]
  field_simp [hd]
  ring


theorem anchorRationalKernel_re_nonneg {b x t : ℝ} (hb : 0<b) (hx : 0≤x) :
    0≤(anchorRationalKernel b ((x:ℂ)+(t:ℂ)*I)).re := by
  let u := b+x
  let v := t^2
  have hu : 0<u := add_pos_of_pos_of_nonneg hb hx
  have hv : 0≤v := sq_nonneg t
  have hbu : b≤u := by dsimp [u]; linarith only [hx]
  have hb2 : b^2≤u^2 := pow_le_pow_left₀ hb.le hbu 2
  have hvc : u-(7/8:ℝ)*b≥u/8 := by linarith only [hbu]
  rw [anchorRationalKernel_re_formula hu]
  change 0≤(u^5+(7/8:ℝ)*b*u^4+b^2*u^3+
    (2*u^3-3*b^2*u)*v+(u-(7/8:ℝ)*b)*v^2)/(u^2+v)^3
  apply div_nonneg _ (by positivity)
  by_cases ha : b≤(4/5:ℝ)*u
  · have hs := pow_le_pow_left₀ hb.le ha 2
    have hmid : 0≤2*u^3-3*b^2*u := by
      have h := mul_le_mul_of_nonneg_right hs hu.le
      nlinarith only [h,pow_nonneg hu.le 3]
    have hlast : 0≤u-(7/8:ℝ)*b := (by positivity : 0≤u/8).trans hvc
    positivity
  · have hba : (4/5:ℝ)*u≤b := le_of_lt (lt_of_not_ge ha)
    have h2 := pow_le_pow_left₀ (by positivity : 0≤(4/5:ℝ)*u) hba 2
    have h3 := mul_le_mul_of_nonneg_right hba hu.le
    have hconst : 2*u^2≤u^2+(7/8:ℝ)*b*u+b^2 := by nlinarith only [h2,h3,sq_nonneg u]
    have hconst' := mul_le_mul_of_nonneg_right hconst (pow_nonneg hu.le 3)
    have hmid : -u^3≤2*u^3-3*b^2*u := by
      have h := mul_le_mul_of_nonneg_right hb2 hu.le
      nlinarith only [h]
    have hmid' := mul_le_mul_of_nonneg_right hmid hv
    have hlast := mul_le_mul_of_nonneg_right hvc (sq_nonneg v)
    have hsq : 0≤(u/8)*(4*u^2-v)^2 := by positivity
    nlinarith only [hconst',hmid',hlast,hsq]

theorem anchorRationalKernel_nonneg_of_re {b : ℝ} {z : ℂ} (hb : 0<b) (hz : 0≤z.re) :
    0≤(anchorRationalKernel b z).re :=
  (Complex.re_add_im z) ▸ anchorRationalKernel_re_nonneg (t:=z.im) hb hz

/-- The optimized second-order rational test has a strict margin at the
first-zero target for the conductor exponent .376. -/
theorem high_order_anchor_margin :
    (100:ℝ) < 24480*anchorRationalKernelReal (9/5) 0 -
      14379*anchorRationalKernelReal (9/5) (-(113/500)) - 46630*(47/125)/2 := by
  norm_num [anchorRationalKernelReal]


end
end GoldbachPintzNumerics
end

section
namespace GoldbachPintzWeightedFormula

open Complex Filter Finset Goldbach GoldbachSmoothing GoldbachTwistedMellin LSeries
open scoped Topology Classical

noncomputable section

def anchorPrimeLinear (b L : ℝ) : ℝ := (7/8:ℝ)*(b/L)

def anchorPrimeQuadratic (b L : ℝ) : ℝ := (b/L)^2/2

def anchorPrimeWeight (b L : ℝ) (n : ℕ) : ℝ :=
  1+anchorPrimeLinear b L*Real.log (n:ℝ)+anchorPrimeQuadratic b L*(Real.log (n:ℝ))^2

theorem anchorPrimeWeight_nonneg {b L : ℝ} (hb : 0≤b) (hL : 0≤L) (n : ℕ) :
    0≤anchorPrimeWeight b L n := by
  unfold anchorPrimeWeight anchorPrimeLinear anchorPrimeQuadratic
  have hn := Real.log_natCast_nonneg n
  positivity

def anchorPrimeTest {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (b L : ℝ) (s : ℂ) : ℂ :=
  independentRationalJet (fun z=>-logDeriv χ.LFunction z)
    (anchorPrimeLinear b L:ℂ) (anchorPrimeQuadratic b L:ℂ) (s+((b/L:ℝ):ℂ))

private theorem anchor_polynomial_cast (b L : ℝ) {n : ℕ} (hn : 0<n) :
    (anchorPrimeWeight b L n:ℂ) =
      1+(anchorPrimeLinear b L:ℂ)*Complex.log (n:ℂ)+
        (anchorPrimeQuadratic b L:ℂ)*(Complex.log (n:ℂ))^2 := by
  have hnℝ : (0:ℝ)≤n := Nat.cast_nonneg n
  have he : Complex.log (n:ℂ)=(Real.log (n:ℝ):ℂ) := by
    rw [←Complex.ofReal_natCast,←Complex.ofReal_log hnℝ]
  rw [he]
  unfold anchorPrimeWeight
  push_cast
  rfl

private theorem anchor_prime_terms_summable {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L : ℝ) (w : ℂ) (hw : 1<w.re) :
    Summable (fun n : ℕ => term (twistedCoefficient χ) w n*(anchorPrimeWeight b L n:ℂ)) := by
  let a := twistedCoefficient χ
  let u : ℂ := (anchorPrimeLinear b L:ℂ)
  let v : ℂ := (anchorPrimeQuadratic b L:ℂ)
  have hab : abscissaOfAbsConv a ≤ ((1:ℝ):EReal) :=
    abscissaOfAbsConv_le_of_forall_lt_LSeriesSummable (fun z hz=>
      χ.LSeriesSummable_twist_vonMangoldt hz)
  have hσ : abscissaOfAbsConv a < (w.re:EReal) := hab.trans_lt (by exact_mod_cast hw)
  have ha : Summable (term a w) := χ.LSeriesSummable_twist_vonMangoldt hw
  have hb : Summable (term (logMul a) w) := LSeriesSummable_logMul_of_lt_re hσ
  have hk : Summable (term (logMul (logMul a)) w) := LSeriesSummable_logMul_of_lt_re
    (by simpa using hσ : abscissaOfAbsConv (logMul a) < (w.re:EReal))
  refine ((ha.add (hb.mul_left u)).add (hk.mul_left v)).congr ?_
  intro n
  change term a w n+u*term (logMul a) w n+v*term (logMul (logMul a)) w n=_
  by_cases hn : n=0
  · subst n
    simp
  · rw [anchor_polynomial_cast b L (Nat.pos_of_ne_zero hn)]
    simp only [term_of_ne_zero hn,logMul,u,v,a]
    ring

theorem anchorPrimeTest_eq_series {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L : ℝ) (s : ℂ) (hs : 1<s.re+b/L) :
    anchorPrimeTest χ b L s =
      ∑' n : ℕ, term (twistedCoefficient χ) (s+((b/L:ℝ):ℂ)) n*(anchorPrimeWeight b L n:ℂ) := by
  unfold anchorPrimeTest
  rw [independentRationalJet_eq_prime_series χ (by simpa using hs)]
  apply tsum_congr
  intro n
  by_cases hn : n=0
  · subst n
    simp
  · rw [anchor_polynomial_cast b L (Nat.pos_of_ne_zero hn)]

theorem tendsto_anchor_primeSum {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (b L σ t : ℝ) (hs : 1<σ+b/L) :
    Tendsto (fun N : ℕ => primeSum (Finset.range N) (anchorPrimeWeight b L) χ (σ+b/L) t)
      atTop (𝓝 ((anchorPrimeTest χ b L (line σ t)).re)) := by
  let σ' := σ+b/L
  have hline : line σ t+((b/L:ℝ):ℂ)=line σ' t := by
    unfold line σ'
    push_cast
    ring
  have hσ : 1<(line σ t).re+b/L := by simpa [line] using hs
  rw [anchorPrimeTest_eq_series χ b L _ hσ,hline]
  have h := (anchor_prime_terms_summable χ b L (line σ' t) (by simpa [line,σ'] using hs)).hasSum.tendsto_sum_nat
  have hr := Complex.continuous_re.continuousAt.tendsto.comp h
  refine hr.congr (fun N=>?_ )
  change Complex.reAddGroupHom (∑ n∈Finset.range N,term (twistedCoefficient χ) (line σ' t) n*
      (anchorPrimeWeight b L n:ℂ))=_
  rw [map_sum]
  unfold primeSum
  apply Finset.sum_congr rfl
  intro n _
  by_cases hn : n=0
  · subst n
    simp
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn
  have he : -(line σ' t)=((-σ':ℝ):ℂ)+(-(t:ℂ)*I) := by push_cast; unfold line; ring
  change (term (twistedCoefficient χ) (line σ' t) n*(anchorPrimeWeight b L n:ℂ)).re=_
  rw [term_of_ne_zero hn,div_eq_mul_inv,←Complex.cpow_neg,he,Complex.cpow_add _ _ hn0,
    ←Complex.ofReal_natCast,←Complex.ofReal_cpow (Nat.cast_nonneg n)]
  simp only [twistedCoefficient,Pi.mul_apply]
  have hMul : χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)*
       (((n:ℝ)^(-σ'):ℝ):ℂ)*((n:ℝ):ℂ)^(-(t:ℂ)*I)*(anchorPrimeWeight b L n:ℂ) =
      ((anchorPrimeWeight b L n*ArithmeticFunction.vonMangoldt n*(n:ℝ)^(-σ'):ℝ):ℂ)*
      (χ (n:ZMod q)*((n:ℝ):ℂ)^(-(t:ℂ)*I)) := by push_cast; ring
  rw [←mul_assoc (χ (n:ZMod q)*(ArithmeticFunction.vonMangoldt n:ℂ)),hMul]
  simp [Complex.mul_re,σ']

set_option maxHeartbeats 950000 in
theorem heathBrown_anchor_primeTest_nonneg {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {b L σ t : ℝ} (hb : 0<b) (hL : 0<L) (hs : 1<σ+b/L) :
    0≤14379*(anchorPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re+
      24480*(anchorPrimeTest χ b L (line σ t)).re+
      14900*(anchorPrimeTest (χ^2) b L (line σ (2*t))).re+
      6000*(anchorPrimeTest (χ^3) b L (line σ (3*t))).re+
      1250*(anchorPrimeTest (χ^4) b L (line σ (4*t))).re := by
  have h0 := tendsto_anchor_primeSum (1:DirichletCharacter ℂ q) b L σ 0 hs
  have h1 := tendsto_anchor_primeSum χ b L σ t hs
  have h2 := tendsto_anchor_primeSum (χ^2) b L σ (2*t) hs
  have h3 := tendsto_anchor_primeSum (χ^3) b L σ (3*t) hs
  have h4 := tendsto_anchor_primeSum (χ^4) b L σ (4*t) hs
  have h := (((h0.const_mul (14379:ℝ)).add (h1.const_mul 24480)).add
    (h2.const_mul 14900)).add (h3.const_mul 6000) |>.add (h4.const_mul 1250)
  exact ge_of_tendsto' h fun N=>heathBrown_primeSum_nonneg χ (Finset.range N) _
    (fun n _=>anchorPrimeWeight_nonneg hb.le hL.le n) (σ+b/L) t

/-- At ordinate zero the principal test at level q is bounded above by
the one at level 1, since the weight is nonnegative. -/
theorem anchor_principal_level_one_le {q : ℕ} [NeZero q]
    {b L σ : ℝ} (hb : 0<b) (hL : 0<L) (hs : 1<σ+b/L) :
    (anchorPrimeTest (1:DirichletCharacter ℂ q) b L (line σ 0)).re≤
      (anchorPrimeTest (1:DirichletCharacter ℂ 1) b L (line σ 0)).re := by
  apply le_of_tendsto_of_tendsto' (tendsto_anchor_primeSum (1:DirichletCharacter ℂ q) b L σ 0 hs)
    (tendsto_anchor_primeSum (1:DirichletCharacter ℂ 1) b L σ 0 hs)
  intro N
  unfold primeSum
  apply Finset.sum_le_sum
  intro n _
  simp only [Complex.ofReal_zero,neg_zero,zero_mul,cpow_zero,mul_one]
  apply mul_le_mul_of_nonneg_left
  · rw [MulChar.one_apply (isUnit_of_subsingleton (n:ZMod 1)),Complex.one_re]
    exact (Complex.re_le_norm _).trans ((1:DirichletCharacter ℂ q).norm_le_one _)
  · exact mul_nonneg (mul_nonneg (anchorPrimeWeight_nonneg hb.le hL.le n)
      ArithmeticFunction.vonMangoldt_nonneg) (by positivity)

end

