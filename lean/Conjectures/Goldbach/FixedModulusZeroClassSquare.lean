section
namespace GoldbachBurgess

open Polynomial Finset Finset.Nat
open scoped Polynomial

section

variable {K : Type*} [Field K]

private noncomputable def scaledHasseFirst (F : K[X]) (j : ℕ) : K[X] :=
  if j=0 then 1 else F^(j-1)*hasseDeriv j F

private theorem scaledHasseFirst_spec (F : K[X]) (j : ℕ) :
    F^j*hasseDeriv j F = F*scaledHasseFirst F j := by
  cases j with
  | zero => simp [scaledHasseFirst,hasseDeriv_zero']
  | succ j => simp [scaledHasseFirst,pow_succ',mul_assoc]

private theorem scaledDegreeArithmetic (s j : ℕ) (hj : 0 < j) (hjs : j ≤ s) :
    (j-1)*s+(s-j)=j*(s-1) := by
  rw [Nat.mul_sub,j.mul_one]
  obtain ⟨k,rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj.ne'
  simp only [Nat.succ_sub_one,Nat.succ_mul]
  omega

private theorem scaledHasseFirst_degree (F : K[X]) (j : ℕ) :
    (scaledHasseFirst F j).natDegree ≤ j*(F.natDegree-1) := by
  by_cases hj : j=0
  · simp [scaledHasseFirst,hj]
  by_cases hjF : F.natDegree<j
  · simp [scaledHasseFirst,hj,hasseDeriv_eq_zero_of_lt_natDegree F j hjF]
  have hLe := le_of_not_gt hjF
  simp only [scaledHasseFirst,ite_eq_right hj]
  refine natDegree_mul_le.trans ?_
  exact (add_le_add natDegree_pow_le (natDegree_hasseDeriv_le F j)).trans_eq
    (scaledDegreeArithmetic F.natDegree j (Nat.pos_of_ne_zero hj) hLe)

/-- Multiplying the j-th Hasse derivative by F^j preserves divisibility by
F^m already present in the original power, with no restriction from the
characteristic. -/
theorem exists_scaled_hasse_power (F : K[X]) (m : ℕ) :
    ∀ j : ℕ, ∃ P : K[X], P.natDegree ≤ j*(F.natDegree-1) ∧
      F^j*hasseDeriv j (F^m) = F^m*P := by
  induction m with
  | zero =>
      intro j
      by_cases hj : j=0
      · subst j
        exact ⟨1,by simp,by simp⟩
      · exact ⟨0,by simp,by simp [hasseDeriv_apply_one j (Nat.pos_of_ne_zero hj)]⟩
  | succ m ih =>
      choose P hDegree hEq using ih
      intro j
      let R := ∑ ij ∈ antidiagonal j, P ij.1*scaledHasseFirst F ij.2
      refine ⟨R,natDegree_sum_le_of_forall_le _ _ ?_,?_⟩
      · intro ij hij
        have hs := mem_antidiagonal.mp hij
        exact natDegree_mul_le.trans ((add_le_add (hDegree _)
          (scaledHasseFirst_degree F _)).trans_eq (by rw [← add_mul,hs]))
      · rw [pow_succ,hasseDeriv_mul,mul_sum]
        change (∑ ij ∈ antidiagonal j,
          F^j*(hasseDeriv ij.1 (F^m)*hasseDeriv ij.2 F)) = (F^m*F)*R
        rw [show (F^m*F)*R = ∑ ij ∈ antidiagonal j,
          (F^m*F)*(P ij.1*scaledHasseFirst F ij.2) by unfold R; rw [mul_sum]]
        refine sum_congr rfl fun ij hij => ?_
        rw [← mem_antidiagonal.mp hij,pow_add]
        calc
          _ = (F^ij.1*hasseDeriv ij.1 (F^m))*(F^ij.2*hasseDeriv ij.2 F) := by ring
          _ = _ := by rw [hEq,scaledHasseFirst_spec]; ring

private theorem natDegree_scaled_hasse_monomial (F : K[X]) (a j : ℕ) :
    (F^j*hasseDeriv j (X^a)).natDegree ≤ a+j*(F.natDegree-1) := by
  by_cases h : a<j
  · have hZ : hasseDeriv j (X^a : K[X]) = 0 :=
      hasseDeriv_eq_zero_of_lt_natDegree _ _ (by simpa using h)
    rw [hZ,mul_zero,natDegree_zero]
    exact Nat.zero_le _
  · have hj := le_of_not_gt h
    have hdeg := natDegree_hasseDeriv_le (X^a : K[X]) j
    rw [natDegree_X_pow] at hdeg
    refine natDegree_mul_le.trans ((add_le_add natDegree_pow_le hdeg).trans ?_)
    by_cases hF : F.natDegree=0
    · simp [hF]
    · rw [Nat.mul_sub,Nat.mul_one]
      have hs := Nat.le_mul_of_pos_right j (Nat.pos_of_ne_zero hF)
      omega

/-- Characteristic-free degree bound for the exact Stepanov interpolation
constraints at each shift of a polynomial power. -/
theorem exists_scaled_hasse_monomial_mul_power (F : K[X]) (a m j : ℕ) :
    ∃ P : K[X], P.natDegree ≤ a+j*(F.natDegree-1) ∧
      F^j*hasseDeriv j (X^a*F^m) = F^m*P := by
  choose P hDegree hEq using exists_scaled_hasse_power F m
  let R := ∑ ij ∈ antidiagonal j, (F^ij.1*hasseDeriv ij.1 (X^a))*P ij.2
  refine ⟨R,natDegree_sum_le_of_forall_le _ _ ?_,?_⟩
  · intro ij hij
    have hs := mem_antidiagonal.mp hij
    refine natDegree_mul_le.trans ((add_le_add
      (natDegree_scaled_hasse_monomial F a ij.1) (hDegree _)).trans_eq ?_)
    rw [add_assoc,← add_mul,hs]
  · rw [hasseDeriv_mul,mul_sum]
    unfold R
    rw [mul_sum]
    refine sum_congr rfl fun ij hij => ?_
    rw [← mem_antidiagonal.mp hij,pow_add]
    calc
      _ = (F^ij.1*hasseDeriv ij.1 (X^a))*(F^ij.2*hasseDeriv ij.2 (F^m)) := by ring
      _ = _ := by rw [hEq]; ring

end

end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

variable {K : Type*} [Field K]

theorem exists_nonzero_vector_in_kernel {ι κ : Type*} [Fintype ι] [Fintype κ]
    (A : (ι → K) →ₗ[K] (κ → K)) (hD : Fintype.card κ < Fintype.card ι) :
    ∃ v : ι → K, v ≠ 0 ∧ A v = 0 := by
  by_contra! h
  have hInj : Function.Injective A := by
    intro x y he
    have hh : A (x-y) = 0 := by simp [he]
    by_contra hn
    exact (h (x-y) (sub_ne_zero.mpr hn)) hh
  have hh := LinearMap.finrank_le_finrank_of_injective (f:=A) hInj
  rw [Module.finrank_pi_fintype,Module.finrank_pi_fintype] at hh
  simp only [Module.finrank_self,Finset.sum_const,Finset.card_univ,nsmul_eq_mul,mul_one] at hh
  exact (not_le_of_gt hD) hh

/-- The extra Frobenius factor contributes only its value to any Hasse
derivative evaluated below the field cardinality. -/
theorem hasseDeriv_eval_field_frobenius_mul [Fintype K] (x : K) (P : K[X]) (b : ℕ)
    {j : ℕ} (hj : j < Fintype.card K) :
    (hasseDeriv j ((X:K[X])^(Fintype.card K*b)*P)).eval x = x^b*(hasseDeriv j P).eval x := by
  let q := Fintype.card K
  have hD : X^q ∣ taylor x ((X:K[X])^(q*b))-C (x^b) := by
    rw [pow_mul,taylor_pow,taylor_X_pow_field_card,Polynomial.C_pow]
    simpa only [add_sub_cancel_right,q] using
      sub_dvd_pow_sub_pow ((X:K[X])^(Fintype.card K)+C x) (C x) b
  have h : X^q ∣ (taylor x ((X:K[X])^(q*b))-C (x^b))*taylor x P :=
    dvd_mul_of_dvd_left hD _
  have hj' : j < q := hj
  have hc := X_pow_dvd_iff.mp h j hj'
  rw [sub_mul,coeff_sub,← taylor_mul,coeff_C_mul,taylor_coeff,taylor_coeff] at hc
  exact sub_eq_zero.mp hc

end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

abbrev AuxiliaryIndex (A B D : ℕ) := Fin A × Fin B × Fin D

def stepanovAuxiliary (F : K[X]) (n A B D : ℕ)
    (v : AuxiliaryIndex A B D → K) : K[X] :=
  ∑ i : AuxiliaryIndex A B D, v i •
      (X^(Fintype.card K*(i.2.1:ℕ))*(X^(i.1:ℕ)*F^(n*(i.2.2:ℕ))))

theorem stepanovAuxiliary_degree (F : K[X]) (n A B D : ℕ)
    (v : AuxiliaryIndex A B D → K) :
    (stepanovAuxiliary F n A B D v).natDegree ≤
      Fintype.card K*(B-1)+(A-1)+n*(D-1)*F.natDegree := by
  unfold stepanovAuxiliary
  apply natDegree_sum_le_of_forall_le
  intro i _
  have hi : (i.1:ℕ) ≤ A-1 := by have h := i.1.isLt; omega
  have hj : (i.2.1:ℕ) ≤ B-1 := by have h := i.2.1.isLt; omega
  have hk : (i.2.2:ℕ) ≤ D-1 := by have h := i.2.2.isLt; omega
  refine (natDegree_smul_le _ _).trans (natDegree_mul_le.trans ?_)
  rw [natDegree_X_pow]
  have h :
      (X^(i.1:ℕ)*F^(n*(i.2.2:ℕ))).natDegree ≤
        (A-1)+n*(D-1)*F.natDegree := by
    refine natDegree_mul_le.trans ?_
    rw [natDegree_X_pow]
    exact add_le_add hi (natDegree_pow_le.trans
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ hk)))
  exact (add_le_add (Nat.mul_le_mul_left _ hj) h).trans_eq (by omega)

set_option maxHeartbeats 2000000 in
/-- Linear interpolation yields the simultaneous Stepanov constraints, as
soon as there are more coefficients than conditions. -/
theorem exists_stepanov_coefficients (F : K[X]) (n A B D M : ℕ) (u : K)
    (hM : M ≤ Fintype.card K)
    (hDim : M*(A+B+M*(F.natDegree-1)) < A*B*D) :
    ∃ v : AuxiliaryIndex A B D → K, v ≠ 0 ∧
      ∀ x : K, F.eval x ≠ 0 → (F.eval x)^n=u → ∀ j<M,
        (hasseDeriv j (stepanovAuxiliary F n A B D v)).eval x=0 := by
  classical
  choose H hH hEq using fun (j : ℕ) (i : AuxiliaryIndex A B D) =>
    exists_scaled_hasse_monomial_mul_power F (i.1:ℕ) (n*(i.2.2:ℕ)) j
  let I := AuxiliaryIndex A B D
  let E := A+B+M*(F.natDegree-1)
  let G (j : ℕ) (i : I) : K[X] := ((X:K[X])^(i.2.1:ℕ)*H j i)
  let h (v : I → K) (j : ℕ) : K[X] :=
    ∑ i : I, (v i*u^(i.2.2:ℕ)) • G j i
  let Amap : (I → K) →ₗ[K] (Fin M × Fin E → K) :=
    { toFun := fun v p => (h v p.1).coeff p.2
      map_add' := by
        intro v w
        funext p
        simp only [h,finsetSum_coeff,Polynomial.coeff_smul,smul_eq_mul,Pi.add_apply,add_mul,sum_add_distrib]
      map_smul' := by
        intro c v
        funext p
        simp only [h,finsetSum_coeff,Polynomial.coeff_smul,smul_eq_mul,Pi.smul_apply,
          RingHom.id_apply,mul_assoc,mul_sum] }
  have hRank : Fintype.card (Fin M × Fin E) < Fintype.card I := by
    simpa only [Fintype.card_prod,Fintype.card_fin,I,AuxiliaryIndex,E,mul_assoc] using hDim
  obtain ⟨v,hv,hV⟩ := exists_nonzero_vector_in_kernel Amap hRank
  refine ⟨v,hv,?_⟩
  intro x hx hu j hj
  have hpos : 0 < A*B*D := (Nat.zero_le _).trans_lt hDim
  have hAB : 0 < A*B := Nat.pos_of_mul_pos_right hpos
  have hA : 0 < A := Nat.pos_of_mul_pos_right hAB
  have hB : 0 < B := Nat.pos_of_mul_pos_left hAB
  have hPdeg : (h v j).natDegree < E := by
    have hDeg : (h v j).natDegree ≤ (A-1)+(B-1)+j*(F.natDegree-1) := by
      apply natDegree_sum_le_of_forall_le
      intro i _
      have hi : (i.1:ℕ) ≤ A-1 := by have h := i.1.isLt; omega
      have hb : (i.2.1:ℕ) ≤ B-1 := by have h := i.2.1.isLt; omega
      refine (natDegree_smul_le _ _).trans (natDegree_mul_le.trans ?_)
      rw [natDegree_X_pow]
      exact (add_le_add hb ((hH _ _).trans (Nat.add_le_add_right hi _))).trans_eq (by omega)
    have hjD := Nat.mul_le_mul_right (F.natDegree-1) hj.le
    exact hDeg.trans_lt (by dsimp [E]; omega)
  have hPoly : h v j = 0 := by
    ext k
    rw [coeff_zero]
    by_cases hk : k<E
    · have hh := congrArg (fun w : Fin M × Fin E → K => w (⟨j,hj⟩,⟨k,hk⟩)) hV
      exact hh
    · exact coeff_eq_zero_of_natDegree_lt (hPdeg.trans_le (le_of_not_gt hk))
  have hPts (i : I) :
      (F.eval x)^j * (hasseDeriv j
        ((X:K[X])^(Fintype.card K*(i.2.1:ℕ))*((X:K[X])^(i.1:ℕ)*F^(n*(i.2.2:ℕ))))).eval x =
        (u^(i.2.2:ℕ))*(G j i).eval x := by
    rw [hasseDeriv_eval_field_frobenius_mul x _ _ (hj.trans_le hM)]
    have hEval := congrArg (Polynomial.eval x) (hEq j i)
    simp only [eval_mul,eval_pow] at hEval
    have hz : (F.eval x)^(n*(i.2.2:ℕ))=u^(i.2.2:ℕ) := by rw [pow_mul,hu]
    rw [hz] at hEval
    unfold G
    rw [eval_mul,eval_pow,eval_X]
    linear_combination x^(i.2.1:ℕ)*hEval
  have hExact :
      (F.eval x)^j*(hasseDeriv j (stepanovAuxiliary F n A B D v)).eval x =
        (h v j).eval x := by
    unfold stepanovAuxiliary h
    rw [map_sum,eval_finsetSum,eval_finsetSum,mul_sum]
    apply sum_congr rfl
    intro i _
    simp only [map_smul,eval_smul,smul_eq_mul]
    rw [mul_left_comm _ (v i),hPts]
    ring
  rw [hPoly,eval_zero] at hExact
  exact (mul_eq_zero.mp hExact).resolve_left (pow_ne_zero _ hx)

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset Finset.Nat
open scoped Polynomial

open scoped Classical

noncomputable section

variable {K : Type*} [Field K]

theorem coeff_mul_expand_eq_zero_of_mod_ge {m A k : ℕ} (hm : 0 < m) (hAm : A ≤ m)
    {P Q : K[X]} (hP : P.natDegree < A) (hk : A ≤ k % m) :
    (P*Polynomial.expand K m Q).coeff k = 0 := by
  rw [coeff_mul]
  apply sum_eq_zero
  intro ij hij
  have hSum := mem_antidiagonal.mp hij
  by_cases hDiv : m ∣ ij.2
  · by_cases hx : ij.1 < A
    · have hMod := congrArg (fun n : ℕ => n % m) hSum
      rw [Nat.add_mod,Nat.mod_eq_zero_of_dvd hDiv,add_zero,
        Nat.mod_mod,Nat.mod_eq_of_lt (hx.trans_le hAm)] at hMod
      omega
    · rw [coeff_eq_zero_of_natDegree_lt (hP.trans_le (le_of_not_gt hx)),zero_mul]
  · rw [coeff_expand hm,ite_eq_right hDiv,mul_zero]

theorem natTrailingDegree_lt_mod_of_sparse {m A : ℕ} {P : K[X]} (hP : P ≠ 0)
    (h : ∀ k : ℕ, A≤k % m → P.coeff k=0) : P.natTrailingDegree % m<A := by
  by_contra! hn
  exact (coeff_natTrailingDegree_ne_zero.mpr hP) (h _ hn)

theorem sum_polynomial_ne_zero_of_distinct_trailing {ι : Type*} (S : Finset ι)
    (P : ι → K[X]) (hN : ∃ i ∈ S,P i ≠ 0)
    (hInj : Set.InjOn (fun i => (P i).natTrailingDegree)
      (↑(S.filter (fun i => P i ≠ 0)):Set ι)) : ∑ i ∈ S, P i ≠ 0 := by
  classical
  let T := S.filter (fun i => P i ≠ 0)
  have hT : T.Nonempty := by
    obtain ⟨i,hi,hI⟩ := hN
    exact ⟨i,mem_filter.mpr ⟨hi,hI⟩⟩
  obtain ⟨i,hi,hmin⟩ := exists_min_image T (fun i => (P i).natTrailingDegree) hT
  have hInside := (mem_filter.mp hi).1
  have hNonzero := (mem_filter.mp hi).2
  let d := (P i).natTrailingDegree
  have he : (∑ j ∈ S,P j).coeff d = (P i).coeff d := by
    rw [finsetSum_coeff]
    refine sum_eq_single_of_mem i hInside ?_
    intro j hj hji
    by_cases hj0 : P j=0
    · simp only [hj0,coeff_zero]
    · have hmem : j ∈ T := mem_filter.mpr ⟨hj,hj0⟩
      refine coeff_eq_zero_of_lt_natTrailingDegree (lt_of_le_of_ne (hmin _ hmem) ?_)
      intro heq
      exact hji (hInj hmem hi heq.symm)
  intro hzero
  rw [hzero,coeff_zero] at he
  exact (coeff_natTrailingDegree_ne_zero.mpr hNonzero) he.symm

variable [Fintype K]

def stepanovCoefficientSlice (A B D : ℕ) (v : AuxiliaryIndex A B D → K)
    (c : Fin D) : K[X] :=
  ∑ i : Fin A × Fin B, v (i.1,i.2,c) • (X^(Fintype.card K*(i.2:ℕ)+(i.1:ℕ)) : K[X])

theorem stepanovCoefficientSlice_ne_zero {A B D : ℕ}
    (hA : A ≤ Fintype.card K) (v : AuxiliaryIndex A B D → K)
    {a : Fin A} {b : Fin B} {c : Fin D} (hv : v (a,b,c) ≠ 0) :
    stepanovCoefficientSlice A B D v c ≠ 0 := by
  classical
  let q := Fintype.card K
  have hq : 0 < q := Fintype.card_pos
  let k (i : Fin A × Fin B) := q*(i.2:ℕ)+(i.1:ℕ)
  have hInj : Function.Injective k := by
    intro i j he
    have hi : (i.1:ℕ)<q := i.1.isLt.trans_le hA
    have hj : (j.1:ℕ)<q := j.1.isLt.trans_le hA
    have hmod := congrArg (fun n : ℕ => n % q) he
    change (q*(i.2:ℕ)+(i.1:ℕ)) % q=(q*(j.2:ℕ)+(j.1:ℕ)) % q at hmod
    have hi' : (i.1:ℕ)=(j.1:ℕ) := by
      simpa only [Nat.add_mod,Nat.mul_mod_right,zero_add,Nat.mod_mod,
        Nat.mod_eq_of_lt hi,Nat.mod_eq_of_lt hj] using hmod
    have hb : (i.2:ℕ)=(j.2:ℕ) := by
      change q*(i.2:ℕ)+(i.1:ℕ)=q*(j.2:ℕ)+(j.1:ℕ) at he
      rw [hi',Nat.add_right_cancel_iff] at he
      exact Nat.eq_of_mul_eq_mul_left hq he
    exact Prod.ext (Fin.ext hi') (Fin.ext hb)
  have hCoeff : (stepanovCoefficientSlice A B D v c).coeff (k (a,b)) = v (a,b,c) := by
    unfold stepanovCoefficientSlice
    rw [finsetSum_coeff]
    refine (sum_eq_single (a,b) ?_ ?_).trans ?_
    · intro j _ h
      simp only [Polynomial.coeff_smul,coeff_X_pow,smul_eq_mul]
      have hneq : k j ≠ k (a,b) := fun he => h (hInj he)
      change v (j.1,j.2,c)*(if k (a,b)=k j then 1 else 0)=0
      simp only [if_neg (Ne.symm hneq),mul_zero]
    · simp
    · change (v (a,b,c) • (X ^ k (a,b) : K[X])).coeff (k (a,b)) = _
      simp [coeff_X_pow]
  intro h
  rw [h,coeff_zero] at hCoeff
  exact hv hCoeff.symm

theorem stepanovCoefficientSlice_taylor_sparse {A B D : ℕ}
    (hA : A ≤ Fintype.card K) (v : AuxiliaryIndex A B D → K)
    (c : Fin D) (x : K) {k : ℕ} (hk : A ≤ k % Fintype.card K) :
    (taylor x (stepanovCoefficientSlice A B D v c)).coeff k = 0 := by
  unfold stepanovCoefficientSlice
  rw [map_sum,finsetSum_coeff]
  apply sum_eq_zero
  intro i _
  rw [map_smul,Polynomial.coeff_smul]
  have he : taylor x (X^(Fintype.card K*(i.2:ℕ)+(i.1:ℕ)) : K[X]) =
      ((X:K[X])+C x)^(i.1:ℕ)*Polynomial.expand K (Fintype.card K) (((X:K[X])+C x)^(i.2:ℕ)) := by
    rw [pow_add,pow_mul,taylor_mul,taylor_pow,taylor_X_pow_field_card,taylor_pow]
    simp [taylor_apply,pow_comp,map_pow,expand_X,expand_C,mul_comm]
  rw [he,coeff_mul_expand_eq_zero_of_mod_ge Fintype.card_pos hA ?_ hk,smul_zero]
  rw [natDegree_pow_X_add_C]
  exact i.1.isLt

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

theorem stepanovAuxiliary_eq_sum_slices (F : K[X]) (n A B D : ℕ)
    (v : AuxiliaryIndex A B D → K) :
    stepanovAuxiliary F n A B D v =
      ∑ c : Fin D, stepanovCoefficientSlice A B D v c * F^(n*(c:ℕ)) := by
  classical
  let e : Fin D × (Fin A × Fin B) ≃ AuxiliaryIndex A B D :=
    { toFun := fun i => (i.2.1,i.2.2,i.1)
      invFun := fun i => (i.2.2,i.1,i.2.1)
      left_inv := by rintro ⟨c,a,b⟩; rfl
      right_inv := by rintro ⟨a,b,c⟩; rfl }
  unfold stepanovAuxiliary
  rw [← e.sum_comp, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro c _
  simp only [stepanovCoefficientSlice,sum_mul]
  apply sum_congr rfl
  intro i _
  rw [smul_mul_assoc,pow_add]
  simp only [e]
  congr 1
  ac_rfl

theorem stepanovAuxiliary_ne_zero_of_simple_root {F : K[X]} {x : K}
    (hF : F ≠ 0) (hx : F.rootMultiplicity x=1)
    {n A B D : ℕ} (hAn : A ≤ n) (hnD : n*D ≤ Fintype.card K)
    (v : AuxiliaryIndex A B D → K) (hv : v ≠ 0) :
    stepanovAuxiliary F n A B D v ≠ 0 := by
  classical
  have hn : 0 < n := by
    by_contra! h
    obtain rfl : n = 0 := by omega
    have hA : A=0 := by omega
    subst A
    apply hv
    funext i
    exact Fin.elim0 i.1
  have hD : 0 < D := by
    by_contra! h
    obtain rfl : D = 0 := by omega
    apply hv
    funext i
    exact Fin.elim0 i.2.2
  have hAq : A ≤ Fintype.card K :=
    hAn.trans ((Nat.le_mul_of_pos_right n hD).trans hnD)
  have hEx : ∃ i, v i ≠ 0 := by
    by_contra! he
    exact hv (funext he)
  obtain ⟨⟨a,b,c⟩,hc⟩ := hEx
  let S (j : Fin D) := stepanovCoefficientSlice A B D v j
  let P (j : Fin D) := S j * F^(n*(j:ℕ))
  have hNonzero : ∃ i ∈ (univ : Finset (Fin D)), P i ≠ 0 :=
    ⟨c,mem_univ _,mul_ne_zero (stepanovCoefficientSlice_ne_zero hAq v hc) (pow_ne_zero _ hF)⟩
  let Q (j : Fin D) := taylor x (P j)
  have hQ : ∃ i ∈ (univ : Finset (Fin D)), Q i ≠ 0 := by
    obtain ⟨i,hi,hnz⟩ := hNonzero
    exact ⟨i,hi,fun he => hnz (by simpa [Q] using he)⟩
  have hRes {j : Fin D} (hj : Q j ≠ 0) :
      n*(j:ℕ) ≤ (Q j).natTrailingDegree % Fintype.card K ∧
        (Q j).natTrailingDegree % Fintype.card K < n*((j:ℕ)+1) := by
    have hSj : S j ≠ 0 := by
      intro h
      exact hj (by simp [Q,P,h])
    have hs : taylor x (S j) ≠ 0 := fun he => hSj (by simpa using he)
    have hsparse := natTrailingDegree_lt_mod_of_sparse hs
      (fun k hk => stepanovCoefficientSlice_taylor_sparse hAq v j x hk)
    have he : (Q j).natTrailingDegree = (taylor x (S j)).natTrailingDegree+n*(j:ℕ) := by
      have heq : (P j).rootMultiplicity x =
          (S j).rootMultiplicity x+n*(j:ℕ) := by
        dsimp [P]
        rw [rootMultiplicity_mul (mul_ne_zero hSj (pow_ne_zero _ hF))]
        congr 1
        generalize n*(j:ℕ)=k
        induction k with
        | zero => simp
        | succ k ih =>
            rw [pow_succ,rootMultiplicity_mul (mul_ne_zero (pow_ne_zero _ hF) hF),ih,hx]
      simpa only [rootMultiplicity_eq_natTrailingDegree,← taylor_apply,Q] using heq
    have hend : (taylor x (S j)).natTrailingDegree % Fintype.card K+n*(j:ℕ) <
        n*((j:ℕ)+1) := by rw [Nat.mul_succ]; omega
    have hjD := Nat.mul_le_mul_left n (Nat.succ_le_of_lt j.isLt)
    have hnq : n*(j:ℕ)<Fintype.card K :=
      (Nat.mul_lt_mul_of_pos_left j.isLt hn).trans_le hnD
    rw [he,Nat.add_mod,Nat.mod_eq_of_lt hnq,
      Nat.mod_eq_of_lt (hend.trans_le (hjD.trans hnD))]
    exact ⟨by omega,hend⟩
  have hInj : Set.InjOn (fun j => (Q j).natTrailingDegree)
      (↑((univ : Finset (Fin D)).filter (fun j => Q j ≠ 0)):Set (Fin D)) := by
    intro i hi j hj he
    have hi' := hRes (mem_filter.mp hi).2
    have hj' := hRes (mem_filter.mp hj).2
    change (Q i).natTrailingDegree=(Q j).natTrailingDegree at he
    rw [he] at hi'
    apply Fin.ext
    rcases lt_trichotomy (i:ℕ) (j:ℕ) with h|h|h
    · have h' : n*((i:ℕ)+1)≤n*(j:ℕ) := Nat.mul_le_mul_left n (Nat.succ_le_of_lt h)
      exact False.elim ((not_lt_of_ge (h'.trans hj'.1)) hi'.2)
    · exact h
    · have h' : n*((j:ℕ)+1)≤n*(i:ℕ) := Nat.mul_le_mul_left n (Nat.succ_le_of_lt h)
      exact False.elim ((not_lt_of_ge (h'.trans hi'.1)) hj'.2)
  have hSum := sum_polynomial_ne_zero_of_distinct_trailing univ Q hQ hInj
  rw [stepanovAuxiliary_eq_sum_slices]
  intro he
  exact hSum (by simpa only [Q,← map_sum,map_zero,P,S] using congrArg (taylor x) he)

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

def stepanovMargin (d s : ℕ) := 4*d^2*(1+d*s)+1

def stepanovCoset (F : K[X]) (n : ℕ) (u : K) : Finset K := by
  classical
  exact univ.filter (fun x => F.eval x  ≠  0 ∧ (F.eval x)^n=u)

set_option maxHeartbeats 1500000 in
theorem stepanovCoset_upper_of_simple_root {F : K[X]} {x : K}
    (hF : F  ≠  0) (hx : F.rootMultiplicity x=1)
    {d s : ℕ} (hd : 2  ≤  d) (hs : F.natDegree  ≤  s)
    (hLarge : max (4*d) ((stepanovMargin d s+d+1)^2)  ≤  Fintype.card K)
    (u : K) :
    d*(stepanovCoset F ((Fintype.card K-1)/d) u).card  ≤
       Fintype.card K+4*(stepanovMargin d s+d*(s+1))*Nat.sqrt (Fintype.card K) := by
  classical
  let q := Fintype.card K
  let J := stepanovMargin d s
  let A := q/(2*d)
  let B := Nat.sqrt q
  let M := d*B-J
  let n := (q-1)/d
  have hd0 : 0 < d := by omega
  have hd2 : 0 < 2*d := by omega
  have hJ : 0 < J := by simp [J,stepanovMargin]
  have hLarge1 : 4*d  ≤  q := le_max_left _ _ |>.trans hLarge
  have hB : J+d+1  ≤  B := Nat.le_sqrt'.2 (le_max_right _ _ |>.trans hLarge)
  have hBa : B*B  ≤  q := Nat.sqrt_le _
  have hBb : q < (B+1)*(B+1) := Nat.lt_succ_sqrt _
  have hB1 : 1  ≤  B := by omega
  have hB2 : q  ≤  4*(B*B) := by nlinarith
  have hdB : d  ≤  B := by omega
  have hJdB : J+B  ≤  d*B := by
    have h := Nat.mul_le_mul_right B hd
    omega
  have hMB : B  ≤  M := by omega
  have hM : 0 < M := by omega
  have hMEq : M+J=d*B := by omega
  have hMq : M  ≤  q :=
    (Nat.sub_le _ _).trans ((Nat.mul_le_mul_right _ hdB).trans hBa)
  have hA : 0 < A := Nat.div_pos (by omega) hd2
  have hAq : q  ≤  4*d*A := by
    have hdv := Nat.div_add_mod q (2*d)
    have hm := Nat.mod_lt q hd2
    have hA' : 2*d  ≤  (2*d)*A := Nat.le_mul_of_pos_right _ hA
    change (2*d)*A+q % (2*d)=q at hdv
    nlinarith
  have hAn : A  ≤  n := by
    apply (Nat.le_div_iff_mul_le hd0).2
    have ha := Nat.div_mul_le_self q (2*d)
    change A*(2*d) ≤ q at ha
    have hq : A*d + d  ≤  q := by
      have hAd : d  ≤  A*d := Nat.le_mul_of_pos_left _ hA
      nlinarith
    omega
  have hnq : n*d  ≤  q := (Nat.div_mul_le_self (q-1) d).trans (Nat.sub_le _ _)
  have hBound : M*(B+M*(F.natDegree-1))  ≤  (J-1)*A := by
    have hM' : M  ≤  d*B := Nat.sub_le _ _
    have hDegree : F.natDegree-1 ≤ s := (Nat.sub_le _ _).trans hs
    calc
      _  ≤  (d*B)*(B+(d*B)*s) := by gcongr
      _ = d*(1+d*s)*(B*B) := by ring
      _  ≤  d*(1+d*s)*q := by gcongr
      _  ≤  d*(1+d*s)*(4*d*A) := by gcongr
      _ = _ := by dsimp [J,stepanovMargin]; ring
  have hDim : M*(A+B+M*(F.natDegree-1)) < A*B*d := by
    have hh : (J-1)*A < J*A := Nat.mul_lt_mul_of_pos_right (by omega) hA
    calc
      _ = M*A+M*(B+M*(F.natDegree-1)) := by ring
      _ < M*A+J*A := Nat.add_lt_add_left (hBound.trans_lt hh) _
      _ = _ := by rw [← add_mul,hMEq]; ring
  obtain ⟨v,hv,hV⟩ := exists_stepanov_coefficients F n A B d M u hMq hDim
  let P := stepanovAuxiliary F n A B d v
  have hP : P  ≠  0 := stepanovAuxiliary_ne_zero_of_simple_root hF hx hAn hnq v hv
  let N := (stepanovCoset F n u).card
  have hR : M*N  ≤  P.natDegree := by
    apply card_mul_le_degree_of_hasseDeriv_zero hP
    intro y hy j hj
    have h : F.eval y  ≠  0 ∧ (F.eval y)^n=u := (mem_filter.mp hy).2
    exact hV y h.1 h.2 j hj
  have hMd : M*N  ≤  q*B+(s+1)*q := by
    refine hR.trans ((stepanovAuxiliary_degree F n A B d v).trans ?_)
    have hA' : A-1  ≤  q := (Nat.sub_le _ _).trans
      ((Nat.div_le_self _ _).trans (le_refl q))
    have hn' : n*(d-1)  ≤  q := (Nat.mul_le_mul_left _ (Nat.sub_le _ _)).trans hnq
    have hdeg : n*(d-1)*F.natDegree  ≤  s*q := by
      rw [mul_comm s q]
      exact Nat.mul_le_mul hn' hs
    have hqb := Nat.mul_le_mul_left q (Nat.sub_le B 1)
    change q*(B-1)+(A-1)+n*(d-1)*F.natDegree  ≤  _
    nlinarith
  let C := J+d*(s+1)
  have hMul : M*(d*N)  ≤  M*(q+4*C*B) := by
    calc
      _ = d*(M*N) := by ring
      _  ≤  d*(q*B+(s+1)*q) := Nat.mul_le_mul_left _ hMd
      _ = M*q+C*q := by dsimp [C]; nlinarith only [hMEq]
      _  ≤  M*q+C*(4*(B*B)) := by gcongr
      _ = M*q+(4*C*B)*B := by ring
      _  ≤  M*q+(4*C*B)*M := by gcongr
      _ = _ := by ring
  exact Nat.le_of_mul_le_mul_left hMul hM

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

theorem mulChar_apply_eq_of_power_eq {χ : MulChar K ℂ} {x y : K}
    (hx : x ≠ 0) (hy : y ≠ 0)
    (h : x^((Fintype.card K-1)/orderOf χ)=y^((Fintype.card K-1)/orderOf χ)) :
    χ x=χ y := by
  classical
  let d := orderOf χ
  let n := (Fintype.card K-1)/d
  have hd : d ∣ Fintype.card K-1 := χ.orderOf_dvd_card_sub_one
  have hnd : n*d=Fintype.card K-1 := Nat.div_mul_cancel hd
  have hnd0 : 0 < n*d := by rw [hnd]; exact Nat.sub_pos_of_lt Fintype.one_lt_card
  have hn : 0 < n := Nat.pos_of_mul_pos_right hnd0
  let z : Kˣ := Units.mk0 (x/y) (div_ne_zero hx hy)
  have hz : z^n=1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val,Units.val_one]
    change (x/y)^n=1
    rw [div_pow]
    exact (div_eq_one_iff_eq (pow_ne_zero n hy)).mpr h
  obtain ⟨g,hg⟩ := IsCyclic.exists_generator (α:=Kˣ)
  obtain ⟨k,hk⟩ : z ∈ Submonoid.powers g := by rw [mem_powers_iff_mem_zpowers]; exact hg z
  change g^k=z at hk
  have hgd : orderOf g=Fintype.card K-1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg,Nat.card_eq_fintype_card,Fintype.card_units]
  have hkdn : n*d ∣ k*n := by
    have hpow : g^(k*n)=1 := by rw [pow_mul,hk]; exact hz
    rw [hnd,← hgd]
    exact orderOf_dvd_of_pow_eq_one hpow
  have hkd : d ∣ k := by
    rw [mul_comm n d] at hkdn
    exact Nat.dvd_of_mul_dvd_mul_right hn hkdn
  have hχg : χ (g:K)^d=1 := by
    rw [← χ.pow_apply_coe,pow_orderOf_eq_one,MulChar.one_apply_coe]
  have hχz : χ (z:K)=1 := by
    obtain ⟨l,hl⟩ := hkd
    have hk' : g^k=z := hk
    rw [← hk',Units.val_pow_eq_pow_val,map_pow,hl,pow_mul,hχg,one_pow]
  have he : (z:K)*y=x := div_mul_cancel₀ _ hy
  calc
    χ x = χ ((z:K)*y) := congrArg χ he.symm
    _ = χ y := by rw [map_mul,hχz,one_mul]

theorem norm_mulChar_apply_le_one (χ : MulChar K ℂ) (x : K) : ‖χ x‖≤1 := by
  by_cases hx : x=0
  · simp [hx,χ.map_zero]
  · have hn : Fintype.card K-1≠0 := Nat.ne_of_gt (Nat.sub_pos_of_lt Fintype.one_lt_card)
    apply le_of_not_gt
    intro hc
    have h := one_lt_pow₀ hc hn
    have ht : ‖χ x‖^(Fintype.card K-1)=1 := by
      rw [← norm_pow,← map_pow,FiniteField.pow_card_sub_one_eq_one x hx,map_one,norm_one]
    linarith

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

set_option maxHeartbeats 1600000 in
theorem norm_sum_mulChar_polynomial_of_simple_root {F : K[X]} {x : K}
    (hF : F  ≠  0) (hx : F.rootMultiplicity x=1) (χ : MulChar K ℂ)
    (hχ : χ  ≠  1) {s : ℕ} (hs : F.natDegree ≤ s)
    (hLarge : max (4*orderOf χ) ((stepanovMargin (orderOf χ) s+orderOf χ+1)^2)  ≤
      Fintype.card K) :
    ‖∑ t : K,χ (F.eval t)‖  ≤
      4*(stepanovMargin (orderOf χ) s+(orderOf χ)*(s+1))*(Nat.sqrt (Fintype.card K):ℝ)+s := by
  classical
  let q := Fintype.card K
  let d := orderOf χ
  let n := (q-1)/d
  let C₀ := 4*(stepanovMargin d s+d*(s+1))
  have hd : 2  ≤  d := by
    have h1 : 0<d := χ.orderOf_pos
    have h2 : d ≠ 1 := fun h => hχ (orderOf_eq_one_iff.mp h)
    omega
  have hd0 : 0 < d := by omega
  have hnd : n*d=q-1 := Nat.div_mul_cancel χ.orderOf_dvd_card_sub_one
  let U : Finset K := (univ.filter (fun y : K => y ≠ 0)).image (fun y => y^n)
  have hU (u : K) : u  ∈  U ↔ ∃ y : K, y ≠ 0 ∧ y^n=u := by simp [U]
  let A (u : K) : K := if hu : u  ∈  U then ((hU u).1 hu).choose else 0
  have hA (u : K) (hu : u ∈ U) : A u ≠ 0 ∧ (A u)^n=u := by
    simpa only [A,dif_pos hu] using ((hU u).1 hu).choose_spec
  let W (u : K) : ℂ := χ (A u)
  have hW (y : K) (hy : y ≠ 0) : W (y^n)=χ y :=
    mulChar_apply_eq_of_power_eq (hA _ ((hU _).2 ⟨y,hy,rfl⟩)).1 hy
      (hA _ ((hU _).2 ⟨y,hy,rfl⟩)).2
  have hWnorm (u : K) : ‖W u‖ ≤ 1 := norm_mulChar_apply_le_one _ _
  have hUcard : U.card  ≤  d := by
    let P : K[X] := X^d-C 1
    have hP : P ≠ 0 := by
      intro he
      have h := congrArg (fun p : K[X] => p.coeff d) he
      change ((X:K[X])^d-C 1).coeff d=(0:K[X]).coeff d at h
      have hc : (C (1:K)).coeff d=0 := by rw [coeff_C,if_neg hd0.ne']
      rw [coeff_sub,coeff_X_pow,if_pos rfl,hc,sub_zero,coeff_zero] at h
      exact one_ne_zero h
    have hSub : U ⊆ P.roots.toFinset := by
      intro u hu
      obtain ⟨y,hy,rfl⟩ := (hU u).1 hu
      rw [Multiset.mem_toFinset,mem_roots hP]
      change (X^d-C 1 : K[X]).eval (y^n)=0
      rw [eval_sub,eval_pow,eval_X,eval_C,← pow_mul,hnd,FiniteField.pow_card_sub_one_eq_one y hy,sub_self]
    exact (card_le_card hSub).trans ((Multiset.toFinset_card_le _).trans
      ((card_roots' P).trans ((natDegree_sub_le _ _).trans (by simp))))
  have hWzero : ∑ u  ∈  U,W u=0 := by
    have hc : ∃ c : Kˣ, χ (c:K)  ≠  1 := by
      by_contra! hn
      exact hχ (MulChar.ext fun c => (hn c).trans (MulChar.one_apply_coe c).symm)
    obtain ⟨c,hc⟩ := hc
    let f (u : K) := (c:K)^n*u
    have hfu (u : K) (hu : u ∈ U) : f u ∈ U := by
      obtain ⟨y,hy,rfl⟩ := (hU u).1 hu
      exact (hU _).2 ⟨(c:K)*y,mul_ne_zero (Units.ne_zero _) hy,mul_pow _ _ _⟩
    have hfW (u : K) (hu : u ∈ U) : W (f u)=χ (c:K)*W u := by
      obtain ⟨y,hy,rfl⟩ := (hU u).1 hu
      dsimp [f]
      rw [← mul_pow,hW _ (mul_ne_zero (Units.ne_zero _) hy),map_mul,hW _ hy]
    have hEq : (∑ u  ∈  U,W (f u))=∑ u  ∈  U,W u := by
      apply sum_bij (fun u _ => f u)
      · exact hfu
      · intro u _ v _ h
        exact mul_left_cancel₀ (pow_ne_zero _ (Units.ne_zero c)) h
      · intro u hu
        obtain ⟨y,hy,rfl⟩ := (hU u).1 hu
        refine ⟨(y/(c:K))^n,(hU _).2 ⟨_,div_ne_zero hy (Units.ne_zero c),rfl⟩,?_⟩
        dsimp [f]
        rw [← mul_pow,mul_div_cancel₀ _ (Units.ne_zero _)]
      · intro u hu
        rfl
    simp_rw [sum_congr rfl hfW,← mul_sum] at hEq
    exact (mul_eq_zero.mp (show (χ (c:K)-1)*(∑ u  ∈  U,W u)=0 by
      rw [sub_mul,one_mul,hEq,sub_self])).resolve_left (sub_ne_zero.mpr hc)
  let S : Finset K := univ.filter (fun y => F.eval y ≠ 0)
  have hMaps (y : K) (hy : y ∈ S) : (F.eval y)^n ∈ U :=
    (hU _).2 ⟨_,(mem_filter.mp hy).2,rfl⟩
  let N (u : K) := (stepanovCoset F n u).card
  have hFiber (u : K) : S.filter (fun y => (F.eval y)^n=u)=stepanovCoset F n u := by
    ext y
    simp [S,stepanovCoset,and_assoc]
  have hNsum : (∑ u  ∈  U,N u)=S.card := by
    simpa only [Finset.card_eq_sum_ones,N,hFiber] using
      (sum_fiberwise_of_maps_to hMaps (fun _ => (1:ℕ)))
  have hS : q  ≤  S.card+s := by
    have hZ : (univ.filter (fun y => F.eval y=0)).card  ≤  s := by
      have hSub : univ.filter (fun y => F.eval y=0) ⊆ F.roots.toFinset := by
        intro y hy
        exact Multiset.mem_toFinset.mpr ((mem_roots hF).mpr ((mem_filter.mp hy).2))
      exact (card_le_card hSub).trans ((Multiset.toFinset_card_le _).trans ((card_roots' F).trans hs))
    have h := card_filter_add_card_filter_not (s:=(univ : Finset K)) (fun y => F.eval y=0)
    rw [card_univ,add_comm] at h
    have he : S.card+(univ.filter (fun y => F.eval y=0)).card=q := h
    omega
  have hSum : (∑ y : K,χ (F.eval y))=∑ u  ∈  U,(N u:ℂ)*W u := by
    rw [← sum_filter_add_sum_filter_not (s:=univ) (p:=fun y => F.eval y ≠ 0)]
    have h0 : (∑ y  ∈  univ.filter (fun y => ¬F.eval y ≠ 0),χ (F.eval y))=0 := by
      apply sum_eq_zero
      intro y hy
      rw [not_ne_iff.mp (mem_filter.mp hy).2,χ.map_zero]
    rw [h0,add_zero]
    change (∑ y  ∈  S,χ (F.eval y))=_
    rw [← sum_fiberwise_of_maps_to hMaps]
    apply sum_congr rfl
    intro u hu
    have hFibre (y : K) (hy : y ∈ S.filter (fun y => (F.eval y)^n=u)) :
        χ (F.eval y)=W u := by
      obtain ⟨hy,he⟩ := mem_filter.mp hy
      rw [← he,hW _ (mem_filter.mp hy).2]
    rw [sum_congr rfl hFibre,hFiber]
    simp [N,nsmul_eq_mul]
  let B := ((q:ℝ)+C₀*(Nat.sqrt q:ℝ))/d
  have hB : 0 ≤ B := by positivity
  have hNu (u : K) : (N u:ℝ) ≤ B := by
    have h := stepanovCoset_upper_of_simple_root hF hx hd hs hLarge u
    apply (le_div_iff₀ (by exact_mod_cast hd0)).2
    exact_mod_cast (by simpa only [N,C₀,mul_assoc,mul_comm,mul_left_comm] using h :
      N u*d ≤ q+C₀*Nat.sqrt q)
  have hDiff : (∑ u  ∈  U,(N u:ℂ)*W u) =
      -∑ u  ∈  U,((B-(N u:ℝ):ℝ):ℂ)*W u := by
    simp only [Complex.ofReal_sub,Complex.ofReal_natCast,sub_mul,sum_sub_distrib,
      ← mul_sum,hWzero,mul_zero,zero_sub,neg_neg]
  rw [hSum,hDiff,norm_neg]
  have hCast : (C₀:ℝ) = 4*((stepanovMargin (orderOf χ) s:ℝ)+(orderOf χ:ℝ)*((s:ℝ)+1)) := by
    simp [C₀,d]
  rw [← hCast]
  change _ ≤ (C₀:ℝ)*(Nat.sqrt q:ℝ)+(s:ℝ)
  calc
    _ ≤ ∑ u ∈ U, ‖((B-(N u:ℝ):ℝ):ℂ)*W u‖ := norm_sum_le _ _
    _ ≤ ∑ u ∈ U, (B-(N u:ℝ)) := by
      apply sum_le_sum
      intro u hu
      rw [norm_mul,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg (sub_nonneg.mpr (hNu u))]
      exact mul_le_of_le_one_right (sub_nonneg.mpr (hNu u)) (hWnorm u)
    _ ≤ _ := by
      rw [sum_sub_distrib,sum_const,nsmul_eq_mul,← Nat.cast_sum,hNsum]
      have hN := mul_le_mul_of_nonneg_right (show (U.card:ℝ) ≤ d by exact_mod_cast hUcard) hB
      have hEq : (d:ℝ)*B=q+C₀*(Nat.sqrt q:ℝ) := by
        dsimp [B]
        field_simp
      rw [hEq] at hN
      have hS' : (q:ℝ) ≤ S.card+(s:ℝ) := by exact_mod_cast hS
      linarith

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial

noncomputable section

universe u

theorem uniform_stepanov_mulChar_bound (d s : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧
      ∀ (E : Type u) [Field E] [Fintype E] (χ : MulChar E ℂ),
        orderOf χ=d → χ ≠ 1 →
        ∀ (P : E[X]) (x : E), P ≠ 0 → P.rootMultiplicity x=1 → P.natDegree ≤ s →
          ‖∑ t : E,χ (P.eval t)‖ ≤ C*Real.sqrt (Fintype.card E) := by
  let J := stepanovMargin d s
  let B := max (4*d) ((J+d+1)^2)
  let A := 4*(J+d*(s+1))
  let C : ℝ := (A:ℝ)+s+B
  refine ⟨C,by positivity,?_⟩
  intro E _ _ χ hd hχ P x hP hx hs
  have hq : 1 ≤ (Fintype.card E:ℝ) := by exact_mod_cast Fintype.card_pos
  have hsqrt : 1 ≤ Real.sqrt (Fintype.card E:ℝ) := by simpa using Real.sqrt_le_sqrt hq
  by_cases h : B ≤ Fintype.card E
  · have hLarge : max (4*orderOf χ) ((stepanovMargin (orderOf χ) s+orderOf χ+1)^2) ≤
        Fintype.card E := by simpa only [hd,J,B] using h
    have hBound := norm_sum_mulChar_polynomial_of_simple_root hP hx χ hχ hs hLarge
    rw [hd] at hBound
    refine hBound.trans ?_
    have hS : ((Fintype.card E).sqrt:ℝ) ≤ Real.sqrt (Fintype.card E) := by
      apply (Real.le_sqrt (by positivity) (by positivity)).2
      exact_mod_cast Nat.sqrt_le' (Fintype.card E)
    have h1 := mul_le_mul_of_nonneg_left hS (show 0 ≤ (A:ℝ) by positivity)
    have h2 : (s:ℝ) ≤ (s:ℝ)*Real.sqrt (Fintype.card E) :=
      le_mul_of_one_le_right (by positivity) hsqrt
    have h3 : 0 ≤ (B:ℝ)*Real.sqrt (Fintype.card E) := by positivity
    have hAcast : (A:ℝ)=4*((stepanovMargin d s:ℝ)+(d:ℝ)*((s:ℝ)+1)) := by
      simp [A,J]
    rw [← hAcast]
    dsimp [C]
    nlinarith only [h1,h2,h3]
  · have hqB : (Fintype.card E:ℝ) ≤ B := by exact_mod_cast (lt_of_not_ge h).le
    calc
      _ ≤ ∑ t : E, ‖χ (P.eval t)‖ := norm_sum_le _ _
      _ ≤ ∑ _t : E, (1:ℝ) := sum_le_sum (fun t _ => norm_mulChar_apply_le_one _ _)
      _ = (Fintype.card E:ℝ) := by simp
      _ ≤ (B:ℝ) := hqB
      _ ≤ (B:ℝ)*Real.sqrt (Fintype.card E) := le_mul_of_one_le_right (by positivity) hsqrt
      _ ≤ _ := by apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _); dsimp [C]; linarith

theorem orderOf_normLift_ne_one {K E : Type*} [Field K] [Field E] [Algebra K E] [Finite E]
    {χ : MulChar K ℂ} (hχ : χ ≠ 1) : normLift (E:=E) χ ≠ 1 := by
  intro h
  have he := orderOf_normLift (E:=E) χ
  rw [h,orderOf_one] at he
  exact hχ (orderOf_eq_one_iff.mp he.symm)

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Finset

private theorem norm_geom_sum_le_of_le_one {z : ℂ} (hz : ‖z‖ ≤ 1) (hne : z ≠ 1)
    (N : ℕ) : ‖∑ k ∈ range N,z^k‖ ≤ 2/‖z-1‖ := by
  have hpos : 0 < ‖z-1‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hne)
  apply (le_div_iff₀ hpos).2
  rw [← norm_mul,geom_sum_mul]
  refine (norm_sub_le _ _).trans ?_
  rw [norm_pow,norm_one]
  have h := pow_le_one₀ (norm_nonneg z) hz (n:=N)
  linarith

/-- A bound for all extension-field power sums gives the same exact bound on
each reciprocal root, independently of the implied constant. -/
theorem norm_le_of_power_sum_bound {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    {C R : ℝ} (hR : 0 ≤ R)
    (hPow : ∀ n : ℕ, ‖∑ j ∈ S,z j ^ n‖ ≤ C*R^n) :
    ∀ i ∈ S, ‖z i‖ ≤ R := by
  classical
  intro i hi
  by_contra! hiR
  obtain ⟨j,hj,hm⟩ := exists_max_image S (fun j => ‖z j‖) ⟨i,hi⟩
  let w := z j
  have hw : R < ‖w‖ := hiR.trans_le (hm _ hi)
  have hw0 : 0 < ‖w‖ := hR.trans_lt hw
  have hw' : w ≠ 0 := norm_pos_iff.mp hw0
  let u (k : ι) := z k/w
  let a : ℝ := R/‖w‖
  have ha0 : 0 ≤ a := div_nonneg hR hw0.le
  have ha1 : a < 1 := (div_lt_one hw0).mpr hw
  have hC : 0 ≤ C := by simpa using (norm_nonneg _).trans (hPow 0)
  have hTop (n : ℕ) : ‖∑ k ∈ S,u k^n‖ ≤ C*a^n := by
    simp only [u,div_pow,← sum_div,norm_div,norm_pow]
    calc
      _ ≤ (C*R^n)/(‖w‖^n) := by gcongr; exact hPow n
      _ = _ := by rw [mul_div_assoc,← div_pow]
  let A := S.filter (fun k => u k=1)
  let B := S.filter (fun k => u k≠1)
  have hPart : A∪B=S := by ext k; by_cases hk : u k=1 <;> simp [A,B,hk]
  have hDisj : Disjoint A B := by
    apply disjoint_left.2
    intro k hk hk'
    exact (mem_filter.mp hk').2 (mem_filter.mp hk).2
  have hA : 1 ≤ A.card :=
    card_pos.mpr ⟨j,mem_filter.mpr ⟨hj,div_self hw'⟩⟩
  let D : ℝ := ∑ k ∈ B,2/‖u k-1‖
  have hTail (N : ℕ) : ‖∑ k ∈ B,∑ n ∈ range N,u k^n‖ ≤ D := by
    refine (norm_sum_le _ _).trans (sum_le_sum ?_)
    intro k hk
    refine norm_geom_sum_le_of_le_one ?_ (mem_filter.mp hk).2 N
    dsimp [u]
    rw [norm_div,div_le_one hw0]
    exact hm _ (mem_filter.mp hk).1
  have hAll (N : ℕ) : ‖∑ n ∈ range N,∑ k ∈ S,u k^n‖ ≤ C/(1-a) := by
    refine (norm_sum_le _ _).trans ((sum_le_sum (fun n _ => hTop n)).trans ?_)
    have hg : (∑ n ∈ range N,a^n) = (1-a^N)/(1-a) :=
      (eq_div_iff (sub_ne_zero.mpr ha1.ne')).2 (geom_sum_mul_neg a N)
    rw [← mul_sum,hg]
    rw [← mul_div_assoc]
    apply div_le_div_of_nonneg_right _ (sub_nonneg.mpr ha1.le)
    have h := pow_nonneg ha0 N
    exact mul_le_of_le_one_right hC (by linarith)
  obtain ⟨N,hN⟩ := exists_nat_gt (C/(1-a)+D)
  have hEa : (∑ k ∈ A,∑ n ∈ range N,u k^n) = (A.card:ℂ)*(N:ℂ) := by
    calc
      _ = ∑ _k ∈ A,(N:ℂ) := by
        apply sum_congr rfl
        intro k hk
        simp [(mem_filter.mp hk).2]
      _ = _ := by simp [nsmul_eq_mul]
  have he : (∑ n ∈ range N,∑ k ∈ S,u k^n) =
      (A.card:ℂ)*(N:ℂ)+∑ k ∈ B,∑ n ∈ range N,u k^n := by
    rw [sum_comm,← hPart,sum_union hDisj,hEa]
  have h := norm_sub_le (∑ n ∈ range N,∑ k ∈ S,u k^n)
    (∑ k ∈ B,∑ n ∈ range N,u k^n)
  have he' : (∑ n ∈ range N,∑ k ∈ S,u k^n) -
      (∑ k ∈ B,∑ n ∈ range N,u k^n) = (A.card:ℂ)*(N:ℂ) := by
    rw [he,add_sub_cancel_right]
  rw [he',norm_mul,Complex.norm_natCast,Complex.norm_natCast] at h
  have hAn : 1 ≤ (A.card:ℝ) := by exact_mod_cast hA
  have hNa : (N:ℝ) ≤ (A.card:ℝ)*(N:ℝ) :=
    le_mul_of_one_le_left (Nat.cast_nonneg _) hAn
  exact (not_lt_of_ge (hNa.trans (h.trans (add_le_add (hAll N) (hTail N))))) hN

end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial Classical

noncomputable section

theorem sqrt_nat_pow (p n : ℕ) : Real.sqrt ((p^n:ℕ):ℝ) = (Real.sqrt p)^n := by
  push_cast
  apply (sq_eq_sq₀ (Real.sqrt_nonneg _) (pow_nonneg (Real.sqrt_nonneg _) _)).mp
  rw [Real.sq_sqrt (by positivity),← pow_mul,Nat.mul_comm n 2,pow_mul,Real.sq_sqrt (by positivity)]

set_option maxHeartbeats 1600000 in
theorem norm_complete_shift_sum_le {p s : ℕ} [Fact p.Prime] (a : Fin s → ZMod p)
    (ha : Function.Injective a) (e : Fin s → ℕ) (he : ∀ i, e i ≠ 0)
    (i : Fin s) (hi : e i=1) (χ : MulChar (ZMod p) ℂ) (hχ : χ ≠ 1) :
    ‖∑ x : ZMod p, χ ((shiftPolynomial a e).eval x)‖ ≤ (↑(s-1:ℕ):ℝ)*Real.sqrt p := by
  classical
  let w := shiftWeight a e χ
  have hTail : ∀ n≥s, monicWeightCoeff w n=0 := by
    intro n hn
    unfold monicWeightCoeff
    change (∑ P : MonicDegree (ZMod p) n,
      evaluationWeight a (fun j => (χ^e j : MulChar (ZMod p) ℂ)) P.val)=0
    refine sum_evaluationWeight_eq_zero_of_card_le a ha _ i ?_ hn
    rw [hi,pow_one]
    exact MulChar.sum_eq_zero_of_ne_one hχ
  have hs : 0<s := i.isLt.pos
  obtain ⟨R,hR,hRoots⟩ := primePowerWeightCoeff_eq_neg_power_sum w hs hTail
  let l := R.toList
  let z (j : Fin l.length) := l.get j
  have hL : l.length=R.card := by simp [l]
  have hSeries (n : ℕ) : (∑ j : Fin l.length,z j^n)=(R.map (fun x => x^n)).sum := by
    have hList (L : List ℂ) : List.ofFn (fun j : Fin L.length => (L.get j)^n) =
        L.map (fun x => x^n) := by
      induction L with
      | nil => rfl
      | cons x L ih =>
          simp [List.ofFn_succ]
          simpa using ih
    rw [← List.sum_ofFn]
    dsimp only [z]
    rw [hList]
    simpa [l] using (show (l.map (fun x : ℂ => x^n)).sum =
        ((l:Multiset ℂ).map (fun x => x^n)).sum from rfl)
  obtain ⟨C,hC,hBound⟩ := uniform_stepanov_mulChar_bound (orderOf χ) (∑ j,e j)
  let C' := max C (R.card:ℝ)
  have hExtension (n : ℕ) (hn : 0<n) :
      ‖primePowerWeightCoeff w n‖ ≤ C'*(Real.sqrt p)^n := by
    let E := GaloisField p n
    letI : Fintype E := Fintype.ofFinite E
    let c : MulChar E ℂ := normLift χ
    let b (j : Fin s) : E := algebraMap (ZMod p) E (a j)
    let F := shiftPolynomial b e
    have hb : Function.Injective b := (algebraMap (ZMod p) E).injective.comp ha
    have hq : Fintype.card E=p^n := by
      rw [Fintype.card_eq_nat_card]
      exact GaloisField.card p n hn.ne'
    have hd : Module.finrank (ZMod p) E=n := GaloisField.finrank p hn.ne'
    have heq := sum_normLift_shiftPolynomial_eq_weightCoeff (E:=E) a e he χ
    change (∑ y : E,c (F.eval y))=primePowerWeightCoeff w (Module.finrank (ZMod p) E) at heq
    rw [hd] at heq
    rw [← heq]
    have h := hBound E c (orderOf_normLift χ) (orderOf_normLift_ne_one hχ) F (b i)
      (shiftPolynomial_ne_zero b e) (rootMultiplicity_shiftPolynomial_eq_one b hb e i hi)
      (natDegree_shiftPolynomial b e)
    rw [hq,sqrt_nat_pow] at h
    exact h.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (by positivity))
  have hPowers (n : ℕ) : ‖∑ j : Fin l.length,z j^n‖ ≤ C'*(Real.sqrt p)^n := by
    cases n with
    | zero =>
        simp only [pow_zero,sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,mul_one,
          Complex.norm_natCast]
        rw [hL]
        exact le_max_right C (R.card:ℝ)
    | succ n =>
        have h := hExtension (n+1) (by omega)
        rw [hRoots _ (by omega),norm_neg,← hSeries] at h
        exact h
  have hInd : ∀ j : Fin l.length, ‖z j‖ ≤ Real.sqrt p := fun j =>
    norm_le_of_power_sum_bound univ z (Real.sqrt_nonneg _)
      hPowers j (mem_univ _)
  have hBase := sum_normLift_shiftPolynomial_eq_weightCoeff (E:=ZMod p) a e he χ
  have heq : (∑ y : ZMod p, χ ((shiftPolynomial a e).eval y))=primePowerWeightCoeff w 1 := by
    simpa [normLift_apply,Algebra.norm_self,Module.finrank_self] using hBase
  rw [heq,hRoots 1 (by norm_num),norm_neg,← hSeries]
  simp only [pow_one]
  refine (norm_sum_le _ _).trans ((sum_le_sum (fun j _ => hInd j)).trans ?_)
  simp only [sum_const,card_univ,Fintype.card_fin,nsmul_eq_mul,hL]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.le_sub_one_of_lt hR)
    (Real.sqrt_nonneg _)

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Polynomial Finset
open scoped Polynomial Classical ComplexConjugate

noncomputable section

variable {K : Type*} [Field K] [Fintype K]

theorem conj_mulChar_eq_pow_order_sub_one (χ : MulChar K ℂ) (hχ : χ ≠ 1) (x : K) :
    conj (χ x)=(χ x)^(orderOf χ-1) := by
  classical
  have hd0 : 0<orderOf χ := χ.orderOf_pos
  have hd1 : 1<orderOf χ := lt_of_le_of_ne hd0 (fun h => hχ (orderOf_eq_one_iff.mp h.symm))
  by_cases hx : x=0
  · rw [hx,χ.map_zero,map_zero,zero_pow (by omega)]
  · have hpow : (χ x)^(orderOf χ)=1 := by
      rw [← χ.pow_apply' hd0.ne',pow_orderOf_eq_one,MulChar.one_apply (isUnit_iff_ne_zero.mpr hx)]
    have hNorm : ‖χ x‖=1 := by
      have h := congrArg norm hpow
      rw [norm_pow,norm_one] at h
      apply le_antisymm (norm_mulChar_apply_le_one χ x)
      by_contra! hn
      exact (ne_of_lt (pow_lt_one₀ (norm_nonneg _) hn hd0.ne')) h
    have h1 : χ x*conj (χ x)=1 := by rw [Complex.mul_conj',hNorm,Complex.ofReal_one,one_pow]
    have h2 : χ x*(χ x)^(orderOf χ-1)=1 := by
      rw [← pow_succ',Nat.sub_add_cancel hd0,hpow]
    have hr : χ x ≠ 0 := by
      intro hn
      rw [hn,zero_mul] at h1
      exact zero_ne_one h1
    exact mul_left_cancel₀ hr (h1.trans h2.symm)

theorem norm_completeBalancedCorrelation_of_singleton_prime {p : ℕ} [Fact p.Prime]
    [NeZero p] (χ : DirichletCharacter ℂ p) (hχ : χ ≠ 1) (a : Fin 4 → ℤ)
    (i₀ : Fin 4) (hSolo : ∀ j : Fin 4, j ≠ i₀ → (a j:ZMod p) ≠ (a i₀:ZMod p)) :
    ‖completeBalancedCorrelation χ a‖ ≤ 3*Real.sqrt p := by
  classical
  let K := ZMod p
  let d := orderOf χ
  have hd0 : 0<d := χ.orderOf_pos
  have hd1 : 1<d := lt_of_le_of_ne hd0 (fun h => hχ (orderOf_eq_one_iff.mp h.symm))
  let b (i : Fin 4) : K := -(a i:K)
  let A : Finset K := univ.image b
  let f : Fin A.card ≃ {y : K // y∈A} :=
    (Fintype.equivFinOfCardEq (Fintype.card_coe A)).symm
  let t (j : Fin A.card) := (f j).val
  have ht : Function.Injective t := fun j j' h => f.injective (Subtype.ext h)
  let l (i : Fin 4) := f.symm ⟨b i,mem_image_of_mem b (mem_univ i)⟩
  have htL (i : Fin 4) : t (l i)=b i := by simp [t,l]
  have hl : Function.Surjective l := by
    intro j
    have hj : t j∈A := (f j).property
    obtain ⟨i,_,he⟩ := mem_image.mp hj
    exact ⟨i,ht ((htL i).trans he)⟩
  let k (i : Fin 4) := if ((i:ℕ)<2 ↔ (i₀:ℕ)<2) then 1 else d-1
  let e (j : Fin A.card) := ∑ i ∈ univ.filter (fun i => l i=j), k i
  have hk (i : Fin 4) : 0<k i := by dsimp [k]; split <;> omega
  have he (j : Fin A.card) : e j ≠ 0 := by
    obtain ⟨i,hi⟩ := hl j
    have hle : k i ≤ e j :=
      single_le_sum (fun _ _ => Nat.zero_le _) (mem_filter.mpr ⟨mem_univ _,hi⟩)
    exact (Nat.ne_of_gt ((hk i).trans_le hle))
  have hi : e (l i₀)=1 := by
    have hA : univ.filter (fun i => l i=l i₀) = {i₀} := by
      ext j
      simp only [mem_filter,mem_univ,true_and,mem_singleton]
      constructor
      · intro h
        by_contra hn
        have ht' := congrArg t h
        rw [htL,htL] at ht'
        exact hSolo j hn (neg_injective ht')
      · rintro rfl
        rfl
    dsimp only [e]
    rw [hA,sum_singleton]
    simp [k]
  have hSum (x : K) : χ ((shiftPolynomial t e).eval (-x)) =
      ∏ i, (χ (x-(a i:K)))^k i := by
    rw [eval_shiftPolynomial,map_prod]
    simp only [map_pow]
    rw [← prod_fiberwise (univ : Finset (Fin 4)) l
      (fun i => (χ (x-(a i:K)))^k i)]
    apply prod_congr rfl
    intro j hj
    unfold e
    rw [← Finset.prod_pow_eq_pow_sum]
    apply prod_congr rfl
    intro i hi
    rw [← (mem_filter.mp hi).2,htL]
    congr 2
    ring
  have hNorm : ‖completeBalancedCorrelation χ a‖ =
      ‖∑ x : K,χ ((shiftPolynomial t e).eval x)‖ := by
    have hg : (∑ x : K,χ ((shiftPolynomial t e).eval x)) =
        ∑ x : K,χ ((shiftPolynomial t e).eval (-x)) :=
      (Equiv.sum_comp (Equiv.neg K) (fun x => χ ((shiftPolynomial t e).eval x))).symm
    rw [hg]
    simp_rw [hSum]
    by_cases h : (i₀:ℕ)<2
    · have hEq (x : K) :
          (∏ i,χ (x-(a i:K))^k i) = ∏ i,balancedTerm i (χ (x-(a i:K))) := by
        apply prod_congr rfl
        intro i _
        by_cases h' : (i:ℕ)<2
        · have he : ((i:ℕ)<2 ↔ (i₀:ℕ)<2) := ⟨fun _ => h,fun _ => h'⟩
          simp only [k,balancedTerm,ite_eq_left he,ite_eq_left h',pow_one]
        · have he : ¬((i:ℕ)<2 ↔ (i₀:ℕ)<2) := fun H => h' (H.mpr h)
          simp only [k,balancedTerm,ite_eq_right he,ite_eq_right h',d,
            conj_mulChar_eq_pow_order_sub_one χ hχ]
      simp only [completeBalancedCorrelation,hEq,K]
    · have hEq (x : K) :
          (∏ i,χ (x-(a i:K))^k i) = conj (∏ i,balancedTerm i (χ (x-(a i:K)))) := by
        rw [map_prod]
        apply prod_congr rfl
        intro i _
        by_cases h' : (i:ℕ)<2
        · have he : ¬((i:ℕ)<2 ↔ (i₀:ℕ)<2) := fun H => h (H.mp h')
          simp only [k,balancedTerm,ite_eq_right he,ite_eq_left h',d,
            conj_mulChar_eq_pow_order_sub_one χ hχ]
        · have he : ((i:ℕ)<2 ↔ (i₀:ℕ)<2) :=
            ⟨fun hi => False.elim (h' hi),fun hi => False.elim (h hi)⟩
          simp only [k,balancedTerm,ite_eq_left he,ite_eq_right h',pow_one,starRingEnd_self_apply]
      simp only [hEq,← map_sum,Complex.norm_conj,completeBalancedCorrelation,K]
  rw [hNorm]
  refine (norm_complete_shift_sum_le t ht e he (l i₀) hi χ hχ).trans ?_
  have hC : A.card≤4 := card_image_le.trans (by simp)
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast (show A.card-1≤3 by omega)) (Real.sqrt_nonneg _)

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Finset
open scoped Classical ComplexConjugate

noncomputable section

def rootDiffProduct (a : Fin 4 → ℤ) (i : Fin 4) : ℕ :=
  ∏ j ∈ (univ : Finset (Fin 4)).erase i, (a i-a j).natAbs

def isolated (a : Fin 4 → ℤ) (i : Fin 4) : Prop :=
  ∀ j, j≠i → a j≠a i

theorem rootDiffProduct_comp_perm (a : Fin 4 → ℤ) (π : Equiv.Perm (Fin 4)) (i : Fin 4) :
    rootDiffProduct (a ∘ π) i=rootDiffProduct a (π i) := by
  unfold rootDiffProduct
  refine prod_bij (fun j _ => π j) ?_ ?_ ?_ (fun j _ => rfl)
  · intro j hj
    exact mem_erase.mpr ⟨fun h => (mem_erase.mp hj).1 (π.injective h),mem_univ _⟩
  · intro j hj k hk h
    exact π.injective h
  · intro j hj
    refine ⟨π.symm j,mem_erase.mpr ⟨?_,mem_univ _⟩,π.apply_symm_apply _⟩
    intro h
    exact (mem_erase.mp hj).1 ((π.apply_symm_apply j).symm.trans (congrArg π h))

theorem isolated_comp_perm (a : Fin 4 → ℤ) (π : Equiv.Perm (Fin 4)) (i : Fin 4) :
    isolated (a ∘ π) i ↔ isolated a (π i) := by
  constructor
  · intro h j hj
    have hJ : π.symm j≠i := fun e => hj ((π.apply_symm_apply j).symm.trans (congrArg π e))
    simpa only [Function.comp_apply,Equiv.apply_symm_apply] using h (π.symm j) hJ
  · intro h j hj
    exact h (π j) (fun e => hj (π.injective e))

theorem rootDiffProduct_zero (a : Fin 4 → ℤ) :
    rootDiffProduct a 0=(a 0-a 1).natAbs*(a 0-a 2).natAbs*(a 0-a 3).natAbs := by
  rw [rootDiffProduct,show (univ : Finset (Fin 4)).erase 0 = {1,2,3} by decide]
  rw [prod_insert (show (1:Fin 4) ∉ ({2,3}:Finset (Fin 4)) by decide),
    prod_insert (show (2:Fin 4) ∉ ({3}:Finset (Fin 4)) by decide),prod_singleton]
  ring

theorem rootDiffProduct_one (a : Fin 4 → ℤ) :
    rootDiffProduct a 1=(a 1-a 0).natAbs*(a 1-a 2).natAbs*(a 1-a 3).natAbs := by
  rw [rootDiffProduct,show (univ : Finset (Fin 4)).erase 1 = {0,2,3} by decide]
  rw [prod_insert (show (0:Fin 4) ∉ ({2,3}:Finset (Fin 4)) by decide),
    prod_insert (show (2:Fin 4) ∉ ({3}:Finset (Fin 4)) by decide),prod_singleton]
  ring

private def frontTuplePerm (i : Fin 4) : Equiv.Perm (Fin 4) :=
  if (i:ℕ)<2 then Equiv.swap 0 i
  else ((Equiv.swap 0 2).trans (Equiv.swap 1 3)).trans (Equiv.swap 2 i)

private theorem frontTuplePerm_zero (i : Fin 4) : frontTuplePerm i 0=i := by
  fin_cases i <;> decide

private theorem frontTuplePerm_first {i : Fin 4} (hi : (i:ℕ)<2) (j : Fin 4) :
    ((frontTuplePerm i j:Fin 4):ℕ)<2 ↔ (j:ℕ)<2 := by
  fin_cases i <;> fin_cases j <;> first | decide | (exfalso; exact (by decide : ¬(_ : ℕ)<2) hi)

private theorem frontTuplePerm_second {i : Fin 4} (hi : ¬(i:ℕ)<2) (j : Fin 4) :
    ((frontTuplePerm i j:Fin 4):ℕ)<2 ↔ ¬(j:ℕ)<2 := by
  fin_cases i <;> fin_cases j <;> first | decide | (exfalso; exact hi (by decide))

theorem exists_front_perm {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (a : Fin 4 → ℤ) (i : Fin 4) :
    ∃ π : Equiv.Perm (Fin 4),
      π 0=i ∧ ‖completeBalancedCorrelation χ (a ∘ π)‖=‖completeBalancedCorrelation χ a‖ := by
  let π := frontTuplePerm i
  refine ⟨π,frontTuplePerm_zero i,?_⟩
  unfold completeBalancedCorrelation
  by_cases h : (i:ℕ)<2
  · congr 1
    apply sum_congr rfl
    intro x _
    rw [← Equiv.prod_comp π (fun j : Fin 4 => balancedTerm j (χ (x-(a j:ZMod q))))]
    apply prod_congr rfl
    intro j _
    simp only [balancedTerm,Function.comp_apply,π,frontTuplePerm_first h j]
  · rw [← Complex.norm_conj (∑ x : ZMod q,∏ j,balancedTerm j (χ (x-(a j:ZMod q))))]
    congr 1
    rw [map_sum]
    apply sum_congr rfl
    intro x _
    rw [map_prod]
    rw [← Equiv.prod_comp π (fun j : Fin 4 => conj (balancedTerm j (χ (x-(a j:ZMod q)))))]
    apply prod_congr rfl
    intro j _
    simp only [balancedTerm,Function.comp_apply,π,frontTuplePerm_second h j]
    by_cases hj : (j:ℕ)<2
    · simp only [ite_eq_left hj,ite_eq_right (not_not_intro hj),starRingEnd_self_apply]
    · simp only [ite_eq_right hj,ite_eq_left hj]

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Finset

noncomputable section

theorem is_singleton_mod_of_not_dvd_rootDiffProduct {p : ℕ}
    (a : Fin 4 → ℤ) (i : Fin 4) (h : ¬p∣rootDiffProduct a i) :
    ∀ j : Fin 4, j≠i → (a j:ZMod p) ≠ (a i:ZMod p) := by
  intro j hj he
  apply h
  have hd : (p:ℤ)∣a i-a j := by
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp
    rw [Int.cast_sub,he,sub_self]
  have hd' : p∣(a i-a j).natAbs := by
    simpa only [Int.natAbs_natCast] using Int.natAbs_dvd_natAbs.mpr hd
  exact hd'.trans (dvd_prod_of_mem _ (mem_erase.mpr ⟨hj,mem_univ _⟩))

theorem norm_completeBalancedCorrelation_prime_sq_bound {p : ℕ} [Fact p.Prime] [NeZero p]
    (χ : DirichletCharacter ℂ p) (hχ : χ.IsPrimitive) (a : Fin 4 → ℤ) (i j : Fin 4) :
    ‖completeBalancedCorrelation χ a‖^2 ≤
      64*(p:ℝ)*(Nat.gcd p (rootDiffProduct a i))*(Nat.gcd p (rootDiffProduct a j)) := by
  let x := ‖completeBalancedCorrelation χ a‖
  let u := rootDiffProduct a i
  let v := rootDiffProduct a j
  have hp : p.Prime := Fact.out
  have hp₀ : (0:ℝ)<p := by exact_mod_cast hp.pos
  have hp₁ : (1:ℝ)≤p := by exact_mod_cast hp.one_lt.le
  have hχ₁ : χ≠1 := by
    intro he
    have hh := hχ
    rw [he,DirichletCharacter.IsPrimitive,DirichletCharacter.conductor_one] at hh
    exact hp.ne_one hh.symm
  have hU : (1:ℝ)≤p.gcd u := by exact_mod_cast Nat.gcd_pos_of_pos_left _ hp.pos
  have hV : (1:ℝ)≤p.gcd v := by exact_mod_cast Nat.gcd_pos_of_pos_left _ hp.pos
  have hm (h : x≤3*Real.sqrt p) : x^2 ≤ 64*(p:ℝ)*(p.gcd u)*(p.gcd v) := by
    have hs := pow_le_pow_left₀ (norm_nonneg _) h 2
    rw [mul_pow,Real.sq_sqrt hp₀.le] at hs
    refine hs.trans ?_
    calc
      _ ≤ 64*(p:ℝ)*1*1 := by nlinarith only [hp₀]
      _ ≤ _ := by gcongr
  by_cases hu : p∣u
  · by_cases hv : p∣v
    · have hs := pow_le_pow_left₀ (norm_nonneg _) (norm_completeBalancedCorrelation_le_nat χ a) 2
      change x^2 ≤ 64*(p:ℝ)*(p.gcd u)*(p.gcd v)
      rw [Nat.gcd_eq_left_iff_dvd.mpr hu,Nat.gcd_eq_left_iff_dvd.mpr hv]
      have h : (0:ℝ)≤64*p-1 := by linarith only [hp₁]
      exact hs.trans (by nlinarith only [mul_nonneg (sq_nonneg (p:ℝ)) h])
    · exact hm (norm_completeBalancedCorrelation_of_singleton_prime χ hχ₁ a j
        (is_singleton_mod_of_not_dvd_rootDiffProduct a j hv))
  · exact hm (norm_completeBalancedCorrelation_of_singleton_prime χ hχ₁ a i
      (is_singleton_mod_of_not_dvd_rootDiffProduct a i hu))

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open scoped ArithmeticFunction.omega

noncomputable section

def discriminantProduct (a : Fin 4 → ℤ) : ℤ :=
  (a 0-a 2)*(a 0-a 3)*(a 1-a 2)*(a 1-a 3)

def leftoverDifference (a : Fin 4 → ℤ) : ℤ := a 0-(a 2+a 3-a 1)

private theorem discriminantProduct_dvd (a : Fin 4 → ℤ) :
    (discriminantProduct a).natAbs ∣ rootDiffProduct a 0*rootDiffProduct a 1 := by
  refine ⟨(a 0-a 1).natAbs*(a 1-a 0).natAbs,?_⟩
  simp only [rootDiffProduct_zero,rootDiffProduct_one,discriminantProduct,Int.natAbs_mul]
  ring

private theorem leftoverDifference_dvd (a : Fin 4 → ℤ) (h : a 2=a 1 ∨ a 3=a 1) :
    (leftoverDifference a).natAbs ∣ rootDiffProduct a 0 := by
  rcases h with h | h
  · have hh : leftoverDifference a=a 0-a 3 := by dsimp [leftoverDifference]; rw [h]; ring
    rw [hh,rootDiffProduct_zero]
    exact dvd_mul_left _ _
  · have hh : leftoverDifference a=a 0-a 2 := by dsimp [leftoverDifference]; rw [h]; ring
    rw [hh,rootDiffProduct_zero, mul_assoc]
    exact (dvd_mul_right _ _).trans (dvd_mul_left _ _)

private theorem le_gcd_of_dvd_gcd {q U V : ℕ} (hq : 0<q) (h : U∣V) :
    q.gcd U ≤ q.gcd V := Nat.le_of_dvd (Nat.gcd_pos_of_pos_left _ hq)
      (Nat.dvd_gcd (Nat.gcd_dvd_left _ _) ((Nat.gcd_dvd_right _ _).trans h))

private theorem gcd_discriminantProduct_le (q : ℕ) (hq : 0<q) (a : Fin 4 → ℤ) :
    q.gcd (discriminantProduct a).natAbs ≤ q.gcd (rootDiffProduct a 0)*q.gcd (rootDiffProduct a 1) := by
  refine (le_gcd_of_dvd_gcd hq (discriminantProduct_dvd a)).trans ?_
  exact Nat.le_of_dvd (Nat.mul_pos (Nat.gcd_pos_of_pos_left _ hq) (Nat.gcd_pos_of_pos_left _ hq))
    (gcd_mul_dvd_mul_gcd q _ _)

private theorem norm_sq_le_of_sqrt_products {x : ℝ} (hx : 0≤x) {q u v : ℕ}
    (hh : x≤8*Real.sqrt q*Real.sqrt u) (huv : u≤v) :
    x^2≤64*q*v := by
  have h := pow_le_pow_left₀ hx hh 2
  rw [mul_pow,mul_pow,Real.sq_sqrt (Nat.cast_nonneg _),Real.sq_sqrt (Nat.cast_nonneg _)] at h
  norm_num only [show (8:ℝ)^2=64 by norm_num] at h
  exact h.trans (mul_le_mul_of_nonneg_left (by exact_mod_cast huv) (by positivity))

private theorem norm_le_of_sq_max_gcd {x : ℝ} {q U V : ℕ}
    (h : x^2 ≤ (64:ℝ)^(ω q)*q*(q.gcd U)*(q.gcd V)) :
    x ≤ (8:ℝ)^(ω q)*Real.sqrt q*(max (q.gcd U) (q.gcd V):ℕ) := by
  have hs : ((8:ℝ)^(ω q)*Real.sqrt q*(max (q.gcd U) (q.gcd V):ℕ))^2 =
      (64:ℝ)^(ω q)*q*(max (q.gcd U) (q.gcd V):ℕ)^2 := by
    rw [mul_pow,mul_pow,Real.sq_sqrt (Nat.cast_nonneg _),← pow_mul,mul_comm (ω q) 2,
      pow_mul,show (8:ℝ)^2=64 by norm_num]
  have h' : x^2≤((8:ℝ)^(ω q)*Real.sqrt q*(max (q.gcd U) (q.gcd V):ℕ))^2 := by
    rw [hs]
    refine h.trans ?_
    let M : ℝ := ((max (q.gcd U) (q.gcd V) : ℕ) : ℝ)
    have hM : (q.gcd U:ℝ)*(q.gcd V:ℝ)≤M*M :=
      mul_le_mul (by dsimp only [M]; exact_mod_cast le_max_left (q.gcd U) (q.gcd V))
        (by dsimp only [M]; exact_mod_cast le_max_right (q.gcd U) (q.gcd V))
        (Nat.cast_nonneg _) (by dsimp only [M]; positivity)
    calc
      _ = ((64:ℝ)^(ω q)*q)*((q.gcd U:ℝ)*(q.gcd V:ℝ)) := by ring
      _ ≤ ((64:ℝ)^(ω q)*q)*(M*M) := mul_le_mul_of_nonneg_left hM (by positivity)
      _ = _ := by dsimp only [M]; ring
  exact (abs_le_of_sq_le_sq' h' (by positivity)).2

/-- The primitive quartic complete sum, reduced to local bounds at exponents at least two. -/
theorem norm_completeBalancedCorrelation_of_isolated_of_local {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) (a : Fin 4 → ℤ)
    (hi : ∃ i, isolated a i)
    (hPP : ∀ p k : ℕ, p.Prime → 2≤k → ∀ [NeZero (p^k)]
      (ξ : DirichletCharacter ℂ (p^k)), ξ.IsPrimitive →
      ∀ c : Fin 4 → ℤ, discriminantProduct c ≠ 0 →
        ‖completeBalancedCorrelation ξ c‖≤8*Real.sqrt (p^k:ℕ)*
          Real.sqrt ((p^k).gcd (discriminantProduct c).natAbs))
    (hShared : ∀ p k : ℕ, p.Prime → 2≤k → ∀ [NeZero (p^k)]
      (ξ : DirichletCharacter ℂ (p^k)), ξ.IsPrimitive →
      ∀ c : Fin 4 → ℤ, c 2=c 1 ∨ c 3=c 1 →
        ‖completeBalancedCorrelation ξ c‖≤2*Real.sqrt (p^k:ℕ)*
          ((p^k).gcd (leftoverDifference c).natAbs:ℕ)) :
    ∃ i, isolated a i ∧ ‖completeBalancedCorrelation χ a‖≤
      (8:ℝ)^(ω q)*Real.sqrt q*(q.gcd (rootDiffProduct a i)) := by
  obtain ⟨i,hi⟩ := hi
  obtain ⟨π,hπ,hNorm⟩ := exists_front_perm χ a i
  let c := a ∘ π
  have h0 : isolated c 0 := (isolated_comp_perm a π 0).mpr (hπ ▸ hi)
  have hFront (k : Fin 4) (hk : isolated c k)
      (h : ‖completeBalancedCorrelation χ c‖ ≤
        (8:ℝ)^(ω q)*Real.sqrt q*(q.gcd (rootDiffProduct c k))) :
      ∃ i, isolated a i ∧ ‖completeBalancedCorrelation χ a‖≤
        (8:ℝ)^(ω q)*Real.sqrt q*(q.gcd (rootDiffProduct a i)) := by
    refine ⟨π k,(isolated_comp_perm a π k).mp hk,?_⟩
    rw [←hNorm,←rootDiffProduct_comp_perm]
    exact h
  have hBase (j : Fin 4) {p Q : ℕ} (hQ : Q=p) (hp : p.Prime) [NeZero Q]
      (ξ : DirichletCharacter ℂ Q) (hξ : ξ.IsPrimitive) :
      ‖completeBalancedCorrelation ξ c‖^2 ≤
        64*(Q:ℝ)*(Q.gcd (rootDiffProduct c 0))*(Q.gcd (rootDiffProduct c j)) := by
    subst Q
    letI : Fact p.Prime := ⟨hp⟩
    exact norm_completeBalancedCorrelation_prime_sq_bound ξ hξ c 0 j
  by_cases h : c 2=c 1 ∨ c 3=c 1
  · apply hFront 0 h0
    have hSq := norm_completeBalancedCorrelation_sq_of_primePowers c
      (rootDiffProduct c 0) (rootDiffProduct c 0) q ?_ χ hχ
    · simpa only [max_self] using norm_le_of_sq_max_gcd hSq
    intro p k hp hk hz ξ hξ
    by_cases hk1 : k=1
    · exact hBase 0 (show p^k=p by simp [hk1]) hp ξ hξ
    · let Q := p^k
      let G := Q.gcd (rootDiffProduct c 0)
      have hG : Q.gcd (leftoverDifference c).natAbs ≤ G :=
        le_gcd_of_dvd_gcd (NeZero.pos Q) (leftoverDifference_dvd c h)
      have hpw := hShared p k hp (by omega) ξ hξ c h
      have hB : ‖completeBalancedCorrelation ξ c‖≤8*Real.sqrt Q*G := by
        refine hpw.trans ?_
        gcongr
        norm_num
      have hB' := pow_le_pow_left₀ (norm_nonneg _) hB 2
      rw [mul_pow,mul_pow,Real.sq_sqrt (Nat.cast_nonneg _)] at hB'
      exact hB'.trans_eq (by ring)
  · have h1 : isolated c 1 := by
      intro j hj
      fin_cases j
      · exact (h0 1 (by decide)).symm
      · exact (hj rfl).elim
      · exact fun e => h (Or.inl e)
      · exact fun e => h (Or.inr e)
    have hD : discriminantProduct c≠0 := by
      unfold discriminantProduct
      exact mul_ne_zero (mul_ne_zero (mul_ne_zero
        (sub_ne_zero.mpr (h0 2 (by decide)).symm) (sub_ne_zero.mpr (h0 3 (by decide)).symm))
        (sub_ne_zero.mpr (h1 2 (by decide)).symm)) (sub_ne_zero.mpr (h1 3 (by decide)).symm)
    have hSq := norm_completeBalancedCorrelation_sq_of_primePowers c
      (rootDiffProduct c 0) (rootDiffProduct c 1) q ?_ χ hχ
    · have hB := norm_le_of_sq_max_gcd hSq
      rcases le_total (q.gcd (rootDiffProduct c 0)) (q.gcd (rootDiffProduct c 1)) with hh|hh
      · rw [max_eq_right hh] at hB
        exact hFront 1 h1 hB
      · rw [max_eq_left hh] at hB
        exact hFront 0 h0 hB
    intro p k hp hk hz ξ hξ
    by_cases hk1 : k=1
    · exact hBase 1 (show p^k=p by simp [hk1]) hp ξ hξ
    · have hB := hPP p k hp (by omega) ξ hξ c hD
      have hh := norm_sq_le_of_sqrt_products (norm_nonneg _) hB
        (gcd_discriminantProduct_le (p^k) (NeZero.pos (p^k)) c)
      push_cast at hh
      exact hh.trans_eq (by push_cast; ring)

end
end GoldbachBurgess
end

