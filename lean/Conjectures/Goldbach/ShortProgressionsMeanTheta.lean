namespace ShortAPSourceDual

open MeasureTheory ShortAPContourShift ShortAPCriticalMain ShortAPFEBridge
open ShortAPInitialLShift ShortAPMellinExpansion ShortAPDualEndpoints
open scoped BigOperators

set_option maxHeartbeats 800000 in
/-- The actual short polynomial equals the absolutely convergent dual expansion.
The left line of the initial shift is chosen so that (1-s_0-w) has real
part (5/2), where the endpoint and series interchange are both available. -/
theorem smooth_dirichlet_dual_expansion {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hq : 1 < q) (hp : χ.IsPrimitive) {N : ℝ} (hN : 1 ≤ N) (t : ℝ) (g : ℝ → ℂ)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ x ∉ Set.Icc (1:ℝ) 4, g x = 0) :
    (∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, g ((n:ℝ)/N) * χ (n:ZMod q) / (n:ℂ)^(point t)) =
      ((1/(2*Real.pi):ℝ):ℂ) * pref χ N t * (∑' n : ℕ, dualTerm χ N t g n) := by
  have hNp : 0 < N := zero_lt_one.trans_le hN
  have hqp : 0 < (q:ℝ) := by exact_mod_cast NeZero.pos q
  have hx : 0 < N/(q:ℝ) := div_pos hNp hqp
  have htRe : (point t).re = 1/2 := by simp [point]
  have hpnt : vertical (1/2) t = point t := by simp [vertical, point]
  let K (v : ℝ) := dualKernel (parity χ) (N/q) g (point (-t)) (vertical (5/2) v)
  let E (v : ℝ) := K v * χ⁻¹.LFunction (vertical (5/2) v)
  let P := pref χ N t
  let L (v : ℝ) := initialKernel χ N g (point t) (-2+(v:ℂ)*Complex.I)
  let R (v : ℝ) := initialKernel χ N g (point t) ((3:ℂ)/4+(v:ℂ)*Complex.I)
  have hK : Integrable K := by
    have h := dualKernel_vertical_integrable (parity χ) hx hg hs (point (-t)) 1
    have hσ : (1/2:ℝ)+2*(1:ℝ) = 5/2 := by norm_num
    simpa only [Complex.VerticalIntegrable, Nat.cast_one, hσ, K, vertical] using h
  have hE := LFunction_vertical_exchange_cpow χ⁻¹ (5/2) (by norm_num) K hK
  have hchange (v : ℝ) : L v = P * E (-t-v) := by
    let z := vertical (5/2) (-t-v)
    have hz : 1 < z.re := by dsimp only [z]; rw [vertical_re]; norm_num
    have hw : point (-t)-z = -2+(v:ℂ)*Complex.I := by
      apply Complex.ext <;> simp [z, vertical, point, Complex.mul_re, Complex.mul_im]
      ring
    have hh := transformed_integrand hp hNp t g hz
    rw [mul_comm (χ⁻¹.LFunction z)] at hh
    change initialKernel χ N g (point t) (-2+(v:ℂ)*Complex.I) = _
    rw [← hw]
    exact hh
  have hLi : Integrable L := by
    have h₁ := ((volume : Measure ℝ).measurePreserving_sub_left (-t)).integrable_comp_of_integrable
      (show Integrable E from hE.1)
    exact (h₁.const_mul P).congr (Filter.Eventually.of_forall fun v => (hchange v).symm)
  have hInit := smooth_dirichlet_critical_initial_line χ g hg hs hNp t
  have hRightLine (v : ℝ) : vertical (3/4) v = (3:ℂ)/4+(v:ℂ)*Complex.I := by simp [vertical]
  simp only [hpnt, hRightLine] at hInit
  have hRi : Integrable R := by
    unfold R initialKernel
    exact hInit.1
  have hshift : (∫ v : ℝ, L v) = ∫ v : ℝ, R v :=
    initialKernel_vertical_integral_eq χ hq hp hN hg.continuous hs htRe hLi hRi
  have hL : (∫ v : ℝ, L v) = P * ∫ v : ℝ, E v := by
    calc
      (∫ v : ℝ, L v) = ∫ v : ℝ, P * E (-t-v) := integral_congr_ae (Filter.Eventually.of_forall hchange)
      _ = _ := by rw [integral_const_mul, integral_sub_left_eq_self E volume (-t)]
  have hseries : (∫ v : ℝ, E v) = ∑' n : ℕ, dualTerm χ N t g n := by
    refine hE.2.trans ?_
    apply tsum_congr
    intro n
    unfold dualTerm
    congr 1
    apply integral_congr_ae
    filter_upwards with v
    unfold K dualKernel
    have hline : vertical (5/2) v = (5/2:ℂ)+(v:ℂ)*Complex.I := by simp [vertical]
    rw [hline]
    rw [Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg hx.le (Nat.cast_nonneg n),
      Complex.ofReal_natCast]
    ring
  calc
    _ = ((1/(2*Real.pi):ℝ):ℂ) * ∫ v : ℝ, R v := by
      simpa only [R, initialKernel] using hInit.2
    _ = ((1/(2*Real.pi):ℝ):ℂ) * ∫ v : ℝ, L v := by rw [hshift]
    _ = _ := by rw [hL, hseries, ← mul_assoc]

end ShortAPSourceDual

end

