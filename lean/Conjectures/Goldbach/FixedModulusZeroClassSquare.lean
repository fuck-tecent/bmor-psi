noncomputable section

/-- The actual time-domain weight of the exponential test. -/
def exponentialAutoWeight {ι : Type*} (S : Finset ι) (a b : ι→ℝ) (u : ℝ) : ℝ :=
  exponentialPulse S (exponentialAutoCoeff S a b) b u

private theorem complex_exp_term_Ioi {b : ℝ} {z : ℂ} (h : 0<b+z.re) (c : ℂ) :
    (∫ u : ℝ in Ioi 0,c*Complex.exp (-((b:ℂ)+z)*(u:ℂ)))=c/((b:ℂ)+z) := by
  have hC : -((b:ℂ)+z).re<0 := by simpa [Complex.add_re] using neg_lt_zero.mpr h
  rw [integral_const_mul,integral_exp_mul_complex_Ioi (by simpa only [Complex.neg_re] using hC)]
  rw [Complex.ofReal_zero,mul_zero,Complex.exp_zero,neg_div_neg_eq,one_div,div_eq_mul_inv]

/-- The time weight is exactly the ordinary one-sided autocorrelation. -/
theorem exponentialAutoWeight_eq_integral {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S, 0<b i) (u : ℝ) :
    exponentialAutoWeight S a b u=
      ∫ t in Ioi 0,exponentialPulse S a b (t+u)*exponentialPulse S a b t := by
  let c (i j : ι) := a i*a j*Real.exp (-(b i)*u)
  let f (i j : ι) (t : ℝ) := c i j*Real.exp (-(b i+b j)*t)
  have hf (i j : ι) (hi : i∈S) (hj : j∈S) : IntegrableOn (f i j) (Ioi 0) :=
    (integrableOn_exp_mul_Ioi (neg_lt_zero.mpr (add_pos (hb i hi) (hb j hj))) 0).const_mul _
  have hId (t : ℝ) : exponentialPulse S a b (t+u)*exponentialPulse S a b t=
      ∑ i∈S,∑ j∈S,f i j t := by
    unfold exponentialPulse
    rw [Finset.sum_mul]
    simp_rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun i hi=>Finset.sum_congr rfl fun j hj=> ?_
    unfold f c
    rw [show -(b i)*(t+u)=-(b i)*t+ -(b i)*u by ring,
      show -(b i+b j)*t=-(b i)*t+ -(b j)*t by ring,Real.exp_add,Real.exp_add]
    ring
  simp_rw [hId]
  rw [integral_finsetSum S (fun i hi=>integrable_finsetSum S (fun j hj=>hf i j hi hj))]
  unfold exponentialAutoWeight exponentialPulse exponentialAutoCoeff
  refine Finset.sum_congr rfl fun i hi=> ?_
  rw [Finset.sum_mul,integral_finsetSum S (fun j hj=>hf i j hi hj)]
  refine Finset.sum_congr rfl fun j hj=> ?_
  unfold f
  rw [integral_const_mul,integral_exp_mul_Ioi (neg_lt_zero.mpr (add_pos (hb i hi) (hb j hj)))]
  rw [mul_zero,Real.exp_zero,div_neg,neg_div,neg_neg]
  unfold c
  ring

theorem exponentialAutoWeight_nonneg {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S, 0<b i) (ha : ∀ t≥0, 0≤exponentialPulse S a b t)
    {u : ℝ} (hu : 0≤u) :
    0≤exponentialAutoWeight S a b u := by
  rw [exponentialAutoWeight_eq_integral S a b hb]
  exact setIntegral_nonneg measurableSet_Ioi
    (fun t ht=>mul_nonneg (ha (t+u) (by linarith only [Set.mem_Ioi.mp ht,hu]))
      (ha t (Set.mem_Ioi.mp ht).le))

theorem exponentialAutoTransform_eq_integral {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (z : ℂ) (hb : ∀ i∈S, 0<b i+z.re) :
    exponentialAutoTransform S a b z =
      ∫ u : ℝ in Ioi 0,(exponentialAutoWeight S a b u:ℂ)*Complex.exp (-z*(u:ℂ)) := by
  let c (i : ι) : ℂ := exponentialAutoCoeff S a b i
  let f (i : ι) (u : ℝ) := c i*Complex.exp (-((b i:ℂ)+z)*(u:ℂ))
  have hf (i : ι) (hi : i∈S) : IntegrableOn (f i) (Ioi 0) :=
    (integrableOn_exp_mul_complex_Ioi (by simpa [Complex.add_re] using neg_lt_zero.mpr (hb i hi)) 0).const_mul _
  have hE (u : ℝ) :
      (exponentialAutoWeight S a b u:ℂ)*Complex.exp (-z*(u:ℂ))=∑ i∈S,f i u := by
    unfold exponentialAutoWeight exponentialPulse
    rw [Complex.ofReal_sum,Finset.sum_mul]
    refine Finset.sum_congr rfl fun i hi=> ?_
    unfold f c
    push_cast
    rw [mul_assoc,←Complex.exp_add]
    congr 2
    ring
  simp_rw [hE]
  rw [integral_finsetSum S hf]
  unfold exponentialAutoTransform
  exact Finset.sum_congr rfl fun i hi=>(complex_exp_term_Ioi (hb i hi) (c i)).symm

end

end GoldbachPintzNumerics
end

