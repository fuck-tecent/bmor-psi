theorem realRationalZeroKernel_antitone {b x y : ℝ}
    (hb : 0<b) (hx : 0<b+x) (hxy : x≤y) :
    realRationalZeroKernel b y≤realRationalZeroKernel b x := by
  have h : b+x≤b+y := by linarith only [hxy]
  have h1 := div_le_div_of_nonneg_left (show (0:ℝ)≤1 by norm_num) hx h
  have h2 := div_le_div_of_nonneg_left hb.le (pow_pos hx 2) (pow_le_pow_left₀ hx.le h 2)
  have h3 := div_le_div_of_nonneg_left (show 0≤2*b^2/3 by positivity)
    (pow_pos hx 3) (pow_le_pow_left₀ hx.le h 3)
  unfold realRationalZeroKernel
  linarith only [h1,h2,h3]


end GoldbachPintzNumerics
