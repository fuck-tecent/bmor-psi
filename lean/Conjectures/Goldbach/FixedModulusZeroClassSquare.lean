noncomputable def kernel (x : ℝ) : ℂ :=
  (Ioc (0 : ℝ) 1).indicator (fun t => (1 - (t : ℂ)) ^ 2) x

noncomputable def symbol (s : ℂ) : ℂ :=
  2 / (s * (s + 1) * (s + 2))

theorem kernel_eq {x : ℝ} (hx : 0 < x) :
    kernel x = (((max (1 - x) 0) ^ 2 : ℝ) : ℂ) := by
  by_cases h : x ≤ 1
  · simp [kernel, hx, h]
  · simp [kernel, h, max_eq_right (sub_nonpos.mpr (le_of_not_ge h))]

theorem hasMellin_kernel {s : ℂ} (hs : 0 < s.re) :
    HasMellin kernel s (symbol s) := by
  have h₀ := hasMellin_one_Ioc hs
  have h₁ := hasMellin_cpow_Ioc 1 (by simp; linarith : 0 < s.re + (1 : ℂ).re)
  have h₂ := hasMellin_cpow_Ioc 2 (by simp; linarith : 0 < s.re + (2 : ℂ).re)
  have h₁' := hasMellin_const_smul h₁.1 (2 : ℂ)
  have h₀₁ := hasMellin_sub h₀.1 h₁'.1
  have h := hasMellin_add h₀₁.1 h₂.1
  rw [h₀₁.2, h₀.2, h₁'.2, h₁.2, h₂.2, smul_eq_mul] at h
  have e : (fun t : ℝ =>
      ((Ioc (0 : ℝ) 1).indicator (fun _ => (1 : ℂ)) t -
        (2 : ℂ) • (Ioc (0 : ℝ) 1).indicator (fun u => (u : ℂ) ^ (1 : ℂ)) t) +
      (Ioc (0 : ℝ) 1).indicator (fun u => (u : ℂ) ^ (2 : ℂ)) t) = kernel := by
    funext t
    by_cases ht : t ∈ Ioc (0 : ℝ) 1
    · simp only [kernel, indicator_of_mem ht, cpow_one, smul_eq_mul]
      rw [show (2 : ℂ) = ((2 : ℕ) : ℂ) by norm_num, cpow_natCast]
      ring
    · simp [kernel, ht]
  rw [e] at h
  have hs0 : s ≠ 0 := by intro hh; simp [hh] at hs
  have hs1 : s + 1 ≠ 0 := by
    intro hh
    have hr := congrArg Complex.re hh
    simp at hr
    linarith
  have hs2 : s + 2 ≠ 0 := by
    intro hh
    have hr := congrArg Complex.re hh
    norm_num at hr
    linarith
  convert h using 1
  unfold symbol
  field_simp
  ring

theorem kernel_continuousAt {x : ℝ} (hx : 0 < x) : ContinuousAt kernel x := by
  have e : kernel =ᶠ[𝓝 x] (fun t : ℝ => (((max (1 - t) 0) ^ 2 : ℝ) : ℂ)) := by
    filter_upwards [Ioi_mem_nhds hx] with t ht
    exact kernel_eq ht
  exact (show ContinuousAt (fun t : ℝ => (((max (1 - t) 0) ^ 2 : ℝ) : ℂ)) x by fun_prop).congr e.symm

/-- The cubic symbol is dominated by an integrable rational function on any
vertical line at real part at least one. -/
theorem norm_symbol_le {s : ℂ} (hs : 1 ≤ s.re) :
    ‖symbol s‖ ≤ 2 / (1 + s.im ^ 2) := by
  have ha : 1 ≤ ‖s‖ := hs.trans (Complex.re_le_norm s)
  have hb : 1 ≤ ‖s + 1‖ := by
    have h := Complex.re_le_norm (s + 1)
    simp at h
    linarith
  have hc : 2 ≤ ‖s + 2‖ := by
    have h := Complex.re_le_norm (s + 2)
    norm_num at h
    linarith
  have hai : |s.im| ≤ ‖s‖ := Complex.abs_im_le_norm s
  have hbi : |s.im| ≤ ‖s + 1‖ := by simpa using Complex.abs_im_le_norm (s + 1)
  have hp : 1 ≤ ‖s‖ * ‖s + 1‖ := one_le_mul_of_one_le_of_one_le ha hb
  have hi : s.im ^ 2 ≤ ‖s‖ * ‖s + 1‖ := by
    simpa only [← sq, sq_abs] using mul_le_mul hai hbi (abs_nonneg _) (norm_nonneg _)
  have h := mul_le_mul_of_nonneg_left hc (mul_nonneg (norm_nonneg s) (norm_nonneg (s + 1)))
  simp only [symbol, norm_div, norm_mul, Complex.norm_ofNat]
  apply (div_le_div_iff₀ (by positivity) (by positivity : 0 < 1 + s.im ^ 2)).mpr
  nlinarith

set_option maxHeartbeats 800000 in
private theorem symbol_continuous_vertical {σ : ℝ} (hσ : 1 ≤ σ) :
    Continuous (fun t : ℝ => symbol ((σ : ℂ) + t * I)) := by
  have hs (t : ℝ) (c : ℂ) (hc : 0 ≤ c.re) : (σ : ℂ) + t * I + c ≠ 0 := by
    intro hz
    have hr := congrArg Complex.re hz
    simp at hr
    linarith
  unfold symbol
  refine Continuous.div continuous_const (by fun_prop) (fun t => ?_)
  exact mul_ne_zero (mul_ne_zero (by simpa using hs t 0 (by simp)) (hs t 1 (by simp)))
    (hs t 2 (by norm_num))

theorem symbol_verticalIntegrable {σ : ℝ} (hσ : 1 ≤ σ) :
    VerticalIntegrable symbol σ := by
  apply (integrable_inv_one_add_sq.const_mul 2).mono'
    (symbol_continuous_vertical hσ).aestronglyMeasurable
  filter_upwards [] with t
  have hb := norm_symbol_le (s := (σ : ℂ) + t * I) (by simpa using hσ)
  simpa only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.I_re, mul_zero,
    Complex.ofReal_re, Complex.I_im, mul_one, add_zero, zero_add, div_eq_mul_inv] using hb

/-- Inverse Mellin for the compact square cutoff used in the mollified
Dirichlet-series detector. -/
theorem mellinInv_symbol {σ x : ℝ} (hσ : 1 ≤ σ) (hx : 0 < x) :
    mellinInv σ symbol x = kernel x := by
  have hσ0 : 0 < σ := by linarith
  have hm (t : ℝ) : mellin kernel ((σ : ℂ) + t * I) = symbol ((σ : ℂ) + t * I) :=
    (hasMellin_kernel (by simpa using hσ0)).2
  have hF : VerticalIntegrable (mellin kernel) σ := by
    unfold VerticalIntegrable
    simp_rw [hm]
    exact symbol_verticalIntegrable hσ
  rw [← mellinInv_mellin_eq σ kernel hx
    (hasMellin_kernel (by simpa using hσ0)).1 hF (kernel_continuousAt hx)]
  simp only [mellinInv, hm]

theorem mellinInv_term {σ y : ℝ} (hσ : 1 ≤ σ) (hy : 0 < y) (a : ℕ → ℂ) (n : ℕ) :
    mellinInv σ (fun s => LSeries.term a s n * symbol s) y =
      if n = 0 then 0 else a n * kernel ((n : ℝ) * y) := by
  by_cases hn : n = 0
  · simp [hn, mellinInv]
  rw [ite_eq_right hn]
  rw [← mellinInv_symbol hσ (mul_pos (Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)) hy)]
  simp only [mellinInv, LSeries.term_of_ne_zero hn, smul_eq_mul, Complex.real_smul]
  rw [mul_left_comm (a n) ((1 / (2 * Real.pi) : ℝ) : ℂ)]
  congr 1
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  rw [Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg (Nat.cast_nonneg n) hy.le]
  simp only [Complex.ofReal_natCast, Complex.cpow_neg]
  ring

private theorem norm_term_integrand {σ y : ℝ} (hy : 0 < y) (a : ℕ → ℂ) (n : ℕ) (t : ℝ) :
    ‖(y : ℂ) ^ (-((σ : ℂ) + t * I)) *
      (LSeries.term a ((σ : ℂ) + t * I) n * symbol ((σ : ℂ) + t * I))‖ =
      (y ^ (-σ) * ‖LSeries.term a (σ : ℂ) n‖) * ‖symbol ((σ : ℂ) + t * I)‖ := by
  simp only [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hy, Complex.neg_re, Complex.add_re,
    Complex.ofReal_re, Complex.mul_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
    mul_zero, zero_mul, sub_self, add_zero, LSeries.norm_term_eq]
  ring

set_option maxHeartbeats 800000 in
/-- Apply the inverse Mellin transform to an absolutely convergent
Dirichlet series with a compact square cutoff. -/
theorem mellinInv_LSeries {σ y : ℝ} (hσ : 1 ≤ σ) (hy : 0 < y)
    (a : ℕ → ℂ) (ha : LSeriesSummable a (σ : ℂ)) :
    mellinInv σ (fun s => LSeries a s * symbol s) y =
      ∑' n : ℕ, if n = 0 then 0 else a n * kernel ((n : ℝ) * y) := by
  let W (n : ℕ) (t : ℝ) := (y : ℂ) ^ (-((σ : ℂ) + t * I)) *
    (LSeries.term a ((σ : ℂ) + t * I) n * symbol ((σ : ℂ) + t * I))
  have hk := symbol_continuous_vertical hσ
  have hw (n : ℕ) : Continuous (W n) := by
    have hp : Continuous (fun t : ℝ => -((σ : ℂ) + t * I)) := by fun_prop
    dsimp only [W]
    apply (hp.const_cpow (.inl (Complex.ofReal_ne_zero.mpr hy.ne'))).mul
    apply Continuous.mul _ hk
    by_cases hn : n = 0
    · simpa [hn] using (continuous_const : Continuous (fun _ : ℝ => (0 : ℂ)))
    · simp only [LSeries.term_of_ne_zero hn]
      apply continuous_const.div
      · exact (show Continuous (fun t : ℝ => (σ : ℂ) + t * I) by fun_prop).const_cpow
          (.inl (Nat.cast_ne_zero.mpr hn))
      · intro t
        exact Complex.cpow_ne_zero_iff.mpr (.inl (Nat.cast_ne_zero.mpr hn))
  have hnorm (n : ℕ) : Integrable (fun t : ℝ => ‖W n t‖) := by
    simp_rw [W, norm_term_integrand hy]
    exact (symbol_verticalIntegrable hσ).norm.const_mul _
  have hi (n : ℕ) : Integrable (W n) := (integrable_norm_iff (hw n).aestronglyMeasurable).mp (hnorm n)
  have hsum : Summable (fun n : ℕ => ∫ t : ℝ, ‖W n t‖) := by
    simp_rw [W, norm_term_integrand hy, integral_const_mul]
    exact (ha.norm.mul_left (y ^ (-σ))).mul_right _
  have hF := integral_tsum_of_summable_integral_norm hi hsum
  simp only [mellinInv, smul_eq_mul, Complex.real_smul]
  simp only [LSeries, ← tsum_mul_right, ← tsum_mul_left]
  change ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, ∑' n, W n t) = _
  rw [← hF, ← tsum_mul_left]
  apply tsum_congr
  intro n
  exact mellinInv_term hσ hy a n

noncomputable def cutoffSum (a : ℕ → ℂ) (Y : ℝ) : ℂ :=
  ∑ n ∈ Finset.Ioc 0 ⌊Y⌋₊, a n * (1 - (n : ℂ) / (Y : ℂ)) ^ 2

theorem cutoffSum_mellinInv {σ Y : ℝ} (hσ : 1 ≤ σ) (hY : 0 < Y)
    (a : ℕ → ℂ) (ha : LSeriesSummable a (σ : ℂ)) :
    mellinInv σ (fun s => LSeries a s * symbol s) (1 / Y) = cutoffSum a Y := by
  classical
  rw [mellinInv_LSeries hσ (one_div_pos.mpr hY) a ha,
    tsum_eq_sum (s := Finset.Ioc 0 ⌊Y⌋₊)]
  · apply Finset.sum_congr rfl
    intro n hn
    obtain ⟨hn0, hnY⟩ := Finset.mem_Ioc.mp hn
    have hn0' : (0 : ℝ) < n := by exact_mod_cast hn0
    have hnY' : (n : ℝ) ≤ Y := (Nat.le_floor_iff hY.le).mp hnY
    have hm1 : (n : ℝ) * (1 / Y) ≤ 1 := by
      rw [mul_one_div]
      exact (div_le_one hY).mpr hnY'
    rw [ite_eq_right hn0.ne', kernel, Set.indicator_of_mem
      (show (n : ℝ) * (1 / Y) ∈ Ioc (0 : ℝ) 1 from ⟨mul_pos hn0' (one_div_pos.mpr hY), hm1⟩)]
    push_cast
    ring
  · intro n hn
    by_cases hn0 : n = 0
    · simp [hn0]
    have hnY : Y < (n : ℝ) := lt_of_not_ge (fun h =>
      hn (Finset.mem_Ioc.mpr ⟨Nat.pos_of_ne_zero hn0, (Nat.le_floor_iff hY.le).mpr h⟩))
    have hm1 : 1 < (n : ℝ) * (1 / Y) := by
      rw [mul_one_div]
      exact (lt_div_iff₀ hY).mpr (by simpa using hnY)
    rw [ite_eq_right hn0, kernel, Set.indicator_of_notMem
      (show (n : ℝ) * (1 / Y) ∉ Ioc (0 : ℝ) 1 from fun h => hm1.not_ge h.2), mul_zero]


theorem term_shift (a : ℕ → ℂ) (r s : ℂ) (n : ℕ) :
    LSeries.term (LSeries.term a r) s n = LSeries.term a (r + s) n := by
  by_cases hn : n = 0
  · simp [hn]
  simp only [LSeries.term_of_ne_zero hn, cpow_add _ _ (Nat.cast_ne_zero.mpr hn), div_div]

theorem shifted_cutoff_mellinInv {σ Y : ℝ} (hσ : 1 ≤ σ) (hY : 0 < Y)
    (a : ℕ → ℂ) (ρ : ℂ) (ha : LSeriesSummable a (ρ + (σ : ℂ))) :
    mellinInv σ (fun s => LSeries a (ρ + s) * symbol s) (1 / Y) =
      cutoffSum (LSeries.term a ρ) Y := by
  have hterm (s : ℂ) : LSeries.term (LSeries.term a ρ) s = LSeries.term a (ρ + s) :=
    funext (term_shift a ρ s)
  have ha' : LSeriesSummable (LSeries.term a ρ) (σ : ℂ) := by
    change Summable (LSeries.term (LSeries.term a ρ) (σ : ℂ))
    rw [hterm]
    exact ha
  have hs (s : ℂ) : LSeries (LSeries.term a ρ) s = LSeries a (ρ + s) := by
    simp only [LSeries, hterm]
  simpa only [hs] using cutoffSum_mellinInv hσ hY (LSeries.term a ρ) ha'

open ArithmeticFunction Finset



noncomputable def truncatedMoebius (D : ℕ) (n : ℕ) : ℂ :=
  if n ≤ D then (moebius n : ℂ) else 0

noncomputable def twistedCoefficient (D : ℕ) (χ : ℕ →* ℂ) : ℕ → ℂ :=
  LSeries.convolution (fun n => χ n * truncatedMoebius D n) χ


/-- Restrict the character from its residue ring to the natural numbers. -/
noncomputable def natCharacter {q : ℕ} (χ : DirichletCharacter ℂ q) : ℕ →* ℂ :=
  χ.toMonoidHom.comp (Nat.castRingHom (ZMod q)).toMonoidHom


noncomputable def mollifier {q : ℕ} (D : ℕ) (χ : DirichletCharacter ℂ q) : ℂ → ℂ :=
  LSeries (fun n => natCharacter χ n * truncatedMoebius D n)

private theorem mollifier_term_eq_zero_of_lt {q D n : ℕ} (χ : DirichletCharacter ℂ q)
    (s : ℂ) (hn : D < n) :
    LSeries.term (fun m => natCharacter χ m * truncatedMoebius D m) s n = 0 := by
  simp [LSeries.term, truncatedMoebius, not_le.mpr hn]

theorem mollifier_eq_sum {q : ℕ} (D : ℕ) (χ : DirichletCharacter ℂ q) (s : ℂ) :
    mollifier D χ s = ∑ n ∈ Finset.range D,
      LSeries.term (fun m => natCharacter χ m * truncatedMoebius D m) s (n + 1) := by
  unfold mollifier LSeries
  rw [tsum_eq_sum (s := Finset.range (D + 1))]
  · rw [Finset.sum_range_succ']
    simp only [LSeries.term_zero, add_zero]
  · intro n hn
    exact mollifier_term_eq_zero_of_lt χ s (by simpa using hn)


private theorem norm_truncatedMoebius_le_one (D n : ℕ) : ‖truncatedMoebius D n‖ ≤ 1 := by
  by_cases hn : n ≤ D
  · simpa [truncatedMoebius, hn, Complex.norm_intCast] using
      (show (|(moebius n : ℤ)| : ℝ) ≤ 1 by exact_mod_cast abs_moebius_le_one (n := n))
  · simp [truncatedMoebius, hn]


private theorem inv_sqrt_add_one_le (n : ℕ) :
    1 / Real.sqrt ((n : ℝ) + 1) ≤ 2 * (Real.sqrt ((n : ℝ) + 1) - Real.sqrt n) := by
  have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hpos : 0 < Real.sqrt ((n : ℝ) + 1) := Real.sqrt_pos.mpr (by linarith)
  have hmono : Real.sqrt (n : ℝ) ≤ Real.sqrt ((n : ℝ) + 1) :=
    Real.sqrt_le_sqrt (by linarith)
  have hdiff : 0 ≤ Real.sqrt ((n : ℝ) + 1) - Real.sqrt (n : ℝ) := sub_nonneg.mpr hmono
  have hprod : (Real.sqrt ((n : ℝ) + 1) - Real.sqrt (n : ℝ)) *
      (Real.sqrt ((n : ℝ) + 1) + Real.sqrt (n : ℝ)) = 1 := by
    nlinarith only [Real.sq_sqrt hn, Real.sq_sqrt (show 0 ≤ (n : ℝ) + 1 by linarith)]
  apply (div_le_iff₀ hpos).mpr
  calc
    1 = (Real.sqrt ((n : ℝ) + 1) - Real.sqrt (n : ℝ)) *
        (Real.sqrt ((n : ℝ) + 1) + Real.sqrt (n : ℝ)) := hprod.symm
    _ ≤ (Real.sqrt ((n : ℝ) + 1) - Real.sqrt (n : ℝ)) *
        (Real.sqrt ((n : ℝ) + 1) + Real.sqrt ((n : ℝ) + 1)) :=
      mul_le_mul_of_nonneg_left (add_le_add_right hmono _) hdiff
    _ = _ := by ring

private theorem sum_inv_sqrt_le (D : ℕ) :
    (∑ n ∈ Finset.range D, 1 / Real.sqrt ((n : ℝ) + 1)) ≤ 2 * Real.sqrt D := by
  induction D with
  | zero => simp
  | succ D ih =>
    rw [Finset.sum_range_succ, Nat.cast_succ]
    linarith only [ih, inv_sqrt_add_one_le D]

/-- The finite mollifier is bounded by twice the square root of its length
throughout the half-plane needed by the detector. -/
theorem norm_mollifier_le {q : ℕ} (D : ℕ) (χ : DirichletCharacter ℂ q) {s : ℂ}
    (hs : (1 / 2 : ℝ) ≤ s.re) : ‖mollifier D χ s‖ ≤ 2 * Real.sqrt D := by
  rw [mollifier_eq_sum]
  apply (norm_sum_le _ _).trans
  apply (Finset.sum_le_sum (fun n _ => ?_)).trans (sum_inv_sqrt_le D)
  simp only [LSeries.norm_term_eq, Nat.succ_ne_zero, Nat.cast_add, Nat.cast_one, ite_false]
  have hn : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [Nat.cast_nonneg (α := ℝ) n]
  have hsqrt : 0 < Real.sqrt ((n : ℝ) + 1) := Real.sqrt_pos.mpr (by linarith)
  have hpow : Real.sqrt ((n : ℝ) + 1) ≤ ((n : ℝ) + 1) ^ s.re := by
    rw [Real.sqrt_eq_rpow]
    exact Real.rpow_le_rpow_of_exponent_le hn hs
  rw [norm_mul]
  have hχ : ‖natCharacter χ (n + 1)‖ ≤ 1 := χ.norm_le_one ((n + 1 : ℕ) : ZMod q)
  have hcoeff : ‖natCharacter χ (n + 1)‖ * ‖truncatedMoebius D (n + 1)‖ ≤ 1 :=
    (mul_le_mul_of_nonneg_left (norm_truncatedMoebius_le_one D (n + 1)) (norm_nonneg _)).trans
      (by simpa using hχ)
  exact (div_le_div_of_nonneg_right hcoeff (by positivity)).trans
    (div_le_div_of_nonneg_left zero_le_one hsqrt hpow)

theorem mollifier_differentiable {q : ℕ} (D : ℕ) (χ : DirichletCharacter ℂ q) :
    Differentiable ℂ (mollifier D χ) := by
  have heq : mollifier D χ = fun s =>
      ∑ n ∈ Finset.range D, LSeries.term (fun m => natCharacter χ m * truncatedMoebius D m) s (n + 1) :=
    funext (mollifier_eq_sum D χ)
  rw [heq]
  apply Differentiable.fun_sum
  intro n _
  simp only [LSeries.term_of_ne_zero (Nat.succ_ne_zero n)]
  apply Differentiable.div (differentiable_const _)
  · exact differentiable_id.const_cpow (Or.inl (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n)))
  · intro s
    exact Complex.cpow_ne_zero_iff.mpr (Or.inl (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n)))


end GoldbachCubicRiesz

namespace GoldbachCubicRiesz

open Complex Set MeasureTheory Filter Topology

/-- Vertical integrals on two lines agree when the integrand is holomorphic
between them and the horizontal sides of expanding rectangles decay. -/
theorem vertical_integral_eq {F : ℂ → ℂ} {a b C : ℝ} (hab : a ≤ b) (hC : 0 ≤ C)
    (hF : DifferentiableOn ℂ F {z | a ≤ z.re ∧ z.re ≤ b})
    (ha : VerticalIntegrable F a) (hb : VerticalIntegrable F b)
    (hdecay : ∀ x ∈ Icc a b, ∀ y : ℝ, 1 ≤ |y| →
      ‖F ((x : ℂ) + y * I)‖ ≤ C / (1 + y ^ 2)) :
    (∫ y : ℝ, F ((b : ℂ) + y * I)) = ∫ y : ℝ, F ((a : ℂ) + y * I) := by
  let T (n : ℕ) : ℝ := (n : ℝ) + 1
  let B (n : ℕ) : ℂ := ∫ x : ℝ in a..b, F ((x : ℂ) + (-T n : ℝ) * I)
  let U (n : ℕ) : ℂ := ∫ x : ℝ in a..b, F ((x : ℂ) + (T n : ℝ) * I)
  let L (n : ℕ) : ℂ := ∫ y : ℝ in -T n..T n, F ((a : ℂ) + y * I)
  let R (n : ℕ) : ℂ := ∫ y : ℝ in -T n..T n, F ((b : ℂ) + y * I)
  have hT (n : ℕ) : 1 ≤ T n := by dsimp [T]; linarith only [Nat.cast_nonneg (α := ℝ) n]
  have ht : Tendsto T atTop atTop := tendsto_atTop_add_const_right atTop 1 tendsto_natCast_atTop_atTop
  have htn : Tendsto (fun n => -T n) atTop atBot := tendsto_neg_atTop_atBot.comp ht
  have hvertL : Tendsto L atTop (𝓝 (∫ y : ℝ, F ((a : ℂ) + y * I))) :=
    intervalIntegral_tendsto_integral ha htn ht
  have hvertR : Tendsto R atTop (𝓝 (∫ y : ℝ, F ((b : ℂ) + y * I))) :=
    intervalIntegral_tendsto_integral hb htn ht
  have hrect (n : ℕ) : B n - U n + I * R n - I * L n = 0 := by
    have hh : DifferentiableOn ℂ F
        (Set.uIcc (Complex.re ⟨a, -T n⟩) (Complex.re ⟨b, T n⟩) ×ℂ
          Set.uIcc (Complex.im ⟨a, -T n⟩) (Complex.im ⟨b, T n⟩)) := by
      apply hF.mono
      intro z hz
      have hz' : z.re ∈ Set.uIcc a b := (mem_reProdIm.mp hz).1
      rwa [Set.uIcc_of_le hab] at hz'
    simpa only [B, U, R, L, smul_eq_mul] using
      integral_boundary_rect_eq_zero_of_differentiableOn F ⟨a, -T n⟩ ⟨b, T n⟩ hh
  have hside (ε : ℝ) (hε : |ε| = 1) (n : ℕ) :
      ‖∫ x : ℝ in a..b, F ((x : ℂ) + (ε * T n : ℝ) * I)‖ ≤ C * (b - a) / T n := by
    have ht0 : 0 < T n := lt_of_lt_of_le zero_lt_one (hT n)
    have hn' : 1 ≤ |ε * T n| := by
      rw [abs_mul, hε, one_mul, abs_of_pos ht0]
      exact hT n
    have hε2 : ε ^ 2 = 1 := by nlinarith only [sq_abs ε, show |ε| ^ 2 = 1 by rw [hε]; norm_num]
    have hconst : ∀ x ∈ Set.uIoc a b, ‖F ((x : ℂ) + (ε * T n : ℝ) * I)‖ ≤ C / (1 + (T n) ^ 2) := by
      intro x hx
      rw [Set.uIoc_of_le hab] at hx
      convert hdecay x ⟨hx.1.le, hx.2⟩ (ε * T n) hn' using 2
      rw [mul_pow, hε2, one_mul]
    have hf := intervalIntegral.norm_integral_le_of_norm_le_const hconst
    rw [abs_of_nonneg (sub_nonneg.mpr hab)] at hf
    apply hf.trans
    rw [div_mul_eq_mul_div]
    apply div_le_div_of_nonneg_left (mul_nonneg hC (sub_nonneg.mpr hab)) ht0
    nlinarith only [hT n, sq_nonneg (T n - 1)]
  have hbound : Tendsto (fun n : ℕ => C * (b - a) / T n) atTop (𝓝 0) := by
    simpa only [div_eq_mul_inv, mul_zero, Function.comp_apply] using (tendsto_inv_atTop_zero.comp ht).const_mul (C * (b - a))
  have hbot : Tendsto B atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    apply squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) hbound
    simpa only [B, neg_one_mul] using hside (-1) (by norm_num) n
  have htop : Tendsto U atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    apply squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) hbound
    simpa only [U, one_mul] using hside 1 (by norm_num) n
  have hlim := ((hbot.sub htop).add (hvertR.const_mul I)).sub (hvertL.const_mul I)
  have h0 := tendsto_nhds_unique hlim
    (show Tendsto (fun n : ℕ => B n - U n + I * R n - I * L n) atTop (𝓝 0) by
      simp only [hrect]; exact tendsto_const_nhds)
  apply mul_left_cancel₀ Complex.I_ne_zero
  simpa only [sub_zero, zero_add, sub_eq_zero] using h0

end GoldbachCubicRiesz

open Complex Set MeasureTheory

namespace GoldbachCubicRiesz

/-- The Mellin kernel at a zero of its numerator, extended across the
removable singularity at zero. -/
noncomputable def regularizedKernel (F : ℂ → ℂ) (w : ℂ) : ℂ :=
  2 * dslope F 0 w / ((w + 1) * (w + 2))

theorem regularizedKernel_eq {F : ℂ → ℂ} (hF : F 0 = 0) {w : ℂ} (hw : w ≠ 0) :
    regularizedKernel F w = 2 * F w / (w * (w + 1) * (w + 2)) := by
  rw [regularizedKernel, dslope_of_ne F hw, slope_def_field, hF, sub_zero, sub_zero,
    ← mul_div_assoc, div_div, mul_assoc w]

theorem differentiableOn_regularizedKernel {F : ℂ → ℂ} (hF : Differentiable ℂ F) :
    DifferentiableOn ℂ (regularizedKernel F) {w | -1 < w.re} := by
  intro w hw
  have hw' : -1 < w.re := hw
  have h1 : w + 1 ≠ 0 := by
    intro h
    have hr := congrArg Complex.re h
    simp only [Complex.add_re, Complex.one_re, Complex.zero_re] at hr
    linarith only [hw', hr]
  have h2 : w + 2 ≠ 0 := by
    intro h
    have hr := congrArg Complex.re h
    norm_num [Complex.add_re] at hr
    linarith only [hw', hr]
  have hD : DifferentiableAt ℂ (fun z : ℂ => (z + 1) * (z + 2)) w := by fun_prop
  exact ((((hF.analyticAt w).dslope 0).differentiableAt.const_mul 2).div
    hD (mul_ne_zero h1 h2)).differentiableWithinAt

/-- A linearly growing numerator and the cubic kernel give an integrable
quadratic bound in the vertical parameter. -/
theorem regularizedKernel_decay {F : ℂ → ℂ} (hF : F 0 = 0) {w : ℂ} {A : ℝ}
    (hA : 0 ≤ A) (hw : 1 ≤ |w.im|) (hbound : ‖F w‖ ≤ A * (1 + |w.im|)) :
    ‖regularizedKernel F w‖ ≤ 8 * A / (1 + w.im ^ 2) := by
  let y := |w.im|
  have hy : 0 < y := lt_of_lt_of_le zero_lt_one hw
  have h0 : y ≤ ‖w‖ := abs_im_le_norm w
  have h1 : y ≤ ‖w + 1‖ := by
    simpa [y, Complex.add_im] using abs_im_le_norm (w + 1)
  have h2 : y ≤ ‖w + 2‖ := by
    simpa [y, Complex.add_im] using abs_im_le_norm (w + 2)
  have hden : y * y * y ≤ ‖w‖ * ‖w + 1‖ * ‖w + 2‖ :=
    mul_le_mul (mul_le_mul h0 h1 hy.le (norm_nonneg _)) h2 hy.le (by positivity)
  have hz : w ≠ 0 := norm_pos_iff.mp (hy.trans_le h0)
  have hnum : 2 * ‖F w‖ ≤ 4 * A * y := by
    calc
      _ ≤ 2 * (A * (1 + y)) := mul_le_mul_of_nonneg_left hbound (by norm_num)
      _ ≤ 2 * (A * (2 * y)) := by
        have h : 1 + y ≤ 2 * y := by linarith only [show 1 ≤ y from hw]
        exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h hA) (by norm_num)
      _ = _ := by ring
  have htwo : ‖(2 : ℂ)‖ = (2 : ℝ) := by norm_num
  rw [regularizedKernel_eq hF hz, norm_div, norm_mul, norm_mul, norm_mul, htwo]
  have hy2 : 1 ≤ y ^ 2 := by
    have hy₁ : 1 ≤ y := hw
    simpa only [one_pow] using pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 1) hy₁ 2
  have hsq : y ^ 2 = w.im ^ 2 := sq_abs _
  rw [← hsq]
  calc
    _ ≤ (4 * A * y) / (‖w‖ * ‖w + 1‖ * ‖w + 2‖) :=
      div_le_div_of_nonneg_right hnum (by positivity)
    _ ≤ (4 * A * y) / (y * y * y) :=
      div_le_div_of_nonneg_left (by positivity) (by positivity) hden
    _ = (4 * A) / y ^ 2 := by field_simp
    _ ≤ _ := by
      apply (div_le_div_iff₀ (sq_pos_of_pos hy) (by positivity)).mpr
      nlinarith only [mul_nonneg hA (sub_nonneg.mpr hy2)]

/-- The regularized kernel is integrable on each vertical line when the
numerator has at most linear growth on the line. -/
theorem regularizedKernel_verticalIntegrable {F : ℂ → ℂ} (hF : Differentiable ℂ F)
    (hF0 : F 0 = 0) {x A : ℝ} (hx : -1 < x) (hA : 0 ≤ A)
    (hbound : ∀ y : ℝ, 1 ≤ |y| → ‖F ((x : ℂ) + y * I)‖ ≤ A * (1 + |y|)) :
    VerticalIntegrable (regularizedKernel F) x := by
  let f : ℝ → ℂ := fun y => regularizedKernel F ((x : ℂ) + y * I)
  have hcont : Continuous f := by
    apply continuousOn_univ.mp
    apply (differentiableOn_regularizedKernel hF).continuousOn.comp (by fun_prop)
    intro y _
    simpa [Complex.add_re, Complex.mul_re] using hx
  let compact := Icc (-1 : ℝ) 1
  have hcomp : IntegrableOn f compact := hcont.continuousOn.integrableOn_compact isCompact_Icc
  have htail : IntegrableOn f compactᶜ := by
    have hmaj : IntegrableOn (fun y : ℝ => 8 * A / (1 + y ^ 2)) compactᶜ := by
      simp only [div_eq_mul_inv]
      exact (integrable_inv_one_add_sq.const_mul _).integrableOn
    apply Integrable.mono' hmaj hcont.aestronglyMeasurable
    filter_upwards [ae_restrict_mem (measurableSet_Icc.compl : MeasurableSet compactᶜ)] with y hy
    have hy' : 1 ≤ |y| := le_of_not_ge fun he => hy (abs_le.mp he)
    have h := regularizedKernel_decay hF0 hA (w := (x : ℂ) + y * I)
      (by simpa [Complex.add_im, Complex.mul_im] using hy')
      (by simpa [Complex.add_im, Complex.mul_im] using hbound y hy')
    simpa [f, Complex.add_im, Complex.mul_im] using h
  change Integrable f
  have h := hcomp.union htail
  rwa [Set.union_compl_self, integrableOn_univ] at h


end GoldbachCubicRiesz

open Complex Set MeasureTheory

namespace GoldbachCubicRiesz

/-- A cubic Riesz detector whose numerator vanishes at the crossed pole
can be shifted to any nonzero line between real part −1 and 0. -/
theorem shift_regularized {F : ℂ → ℂ} (hF : Differentiable ℂ F) (hF0 : F 0 = 0) {a b A : ℝ}
    (ha : -1 < a) (ha0 : a ≠ 0) (hb0 : b ≠ 0) (hab : a ≤ b) (hA : 0 ≤ A)
    (hgrowth : ∀ x ∈ Icc a b, ∀ y : ℝ, 1 ≤ |y| → ‖F ((x : ℂ) + y * I)‖ ≤ A * (1 + |y|)) :
    let G := fun w : ℂ => 2 * F w / (w * (w + 1) * (w + 2))
    (∫ y : ℝ, G ((b : ℂ) + y * I)) = ∫ y : ℝ, G ((a : ℂ) + y * I) := by
  let G := fun w : ℂ => 2 * F w / (w * (w + 1) * (w + 2))
  have hreg {x : ℝ} (hx : x ≠ 0) :
      (∫ y : ℝ, regularizedKernel F ((x : ℂ) + y * I)) =
        ∫ y : ℝ, G ((x : ℂ) + y * I) := by
    apply integral_congr_ae
    filter_upwards [] with y
    apply regularizedKernel_eq hF0
    intro he
    apply hx
    simpa [Complex.add_re, Complex.mul_re] using congrArg Complex.re he
  change (∫ y : ℝ, G ((b : ℂ) + y * I)) = ∫ y : ℝ, G ((a : ℂ) + y * I)
  rw [← hreg hb0, ← hreg ha0]
  apply vertical_integral_eq hab (by positivity : 0 ≤ 8 * A)
  · exact (differentiableOn_regularizedKernel hF).mono (fun z hz => ha.trans_le hz.1)
  · exact regularizedKernel_verticalIntegrable hF hF0 ha hA
      (hgrowth a (left_mem_Icc.mpr hab))
  · exact regularizedKernel_verticalIntegrable hF hF0 (ha.trans_le hab) hA
      (hgrowth b (right_mem_Icc.mpr hab))
  · intro x hx y hy
    simpa [Complex.add_im, Complex.mul_im] using
      regularizedKernel_decay hF0 hA (w := ((x : ℂ) + y * I))
        (by simpa [Complex.add_im, Complex.mul_im] using hy)
        (by simpa [Complex.add_im, Complex.mul_im] using hgrowth x hx y hy)

end GoldbachCubicRiesz

