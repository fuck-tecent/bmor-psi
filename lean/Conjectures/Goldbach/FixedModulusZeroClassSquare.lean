private theorem principal_scaled_resolvent {L d : ℝ} (hL : 0<L) (s : ℂ) :
    1/(s+(d/L:ℝ)-1)=(L:ℂ)/((d:ℂ)+(L:ℂ)*(s-1)) := by
  have hLc : (L:ℂ)≠0 := Complex.ofReal_ne_zero.mpr hL.ne'
