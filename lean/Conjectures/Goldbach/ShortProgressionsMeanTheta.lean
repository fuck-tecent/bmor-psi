/-- One actual, short-scale, first-cap box at a moderate height. -/
theorem moderate_short_box_energy (j : ℕ) (hj : j<4) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H Q : ℕ} (a z T D θ β : ℝ) (b : Choice j)
