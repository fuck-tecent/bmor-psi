/-- The optimized rational prime test preserves the sharp strip coefficient
and the signed sum over the exact local zero window. -/
theorem anchor_prime_nonprincipal_upper {ε κ b K D C : ℝ}
    (hε : 0<ε) (hκ : 0<κ) (hb : 0<b) (hK : 0<K) (hD : 0≤D) (hC : 0≤C) :
    ∃ r L₀ : ℝ, 0<r ∧ r≤1/32 ∧ 1≤L₀ ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → ∀ {L φ B Q T : ℝ} {s : ℂ},
      L₀≤L → 1+κ/L≤ s.re+b/L → s.re+b/L≤1+C/L →
      |s.im|+1/4≤T → logHeight q s.im≤K*L → 0≤φ → 1≤B → 1≤Q →
      Real.log B≤D*Real.log L →
      (∀ z : ℂ, 3/4≤z.re → z.re≤3/2 → |z.im|≤T →
        ‖χ.LFunction z‖≤B*Q^(φ*max 0 (1-z.re))) →
      ∃ V : Finset ℂ,
      (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ ‖ρ-line 1 s.im‖≤2*r) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 s.im‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V → (∀ ρ∈V, ρ∉U → ρ.re≤ s.re) →
      (anchorPrimeTest χ b L s).re ≤ φ*Real.log Q/2+ε*L -
        L*∑ ρ∈U,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
          (anchorRationalKernel b ((L:ℂ)*(s-ρ))).re := by
  obtain ⟨A,hA,hBase⟩ := sharp_local_window_remainder
  obtain ⟨r,L₀,hr,hr32,hL₀,hBud⟩ := rational_jet_error_budget hε hA hK hκ
    (show 0<2*b by positivity) hD hC
  refine ⟨r,L₀,hr,hr32,hL₀,?_⟩
  intro q _ χ hχ L φ B Q T s hL hslo hshi hT hHeight hφ hB hQ hBlog hstrip
  let w := s+((b/L:ℝ):ℂ)
  let u : ℂ := (anchorPrimeLinear b L:ℂ)
  let v : ℂ := (anchorPrimeQuadratic b L:ℂ)
  let M := A*logHeight q s.im
  let m := analyticOrderNatAt (regularizedL χ)
  have hL1 : 1≤L := hL₀.trans hL
  have hL0 : 0<L := zero_lt_one.trans_le hL1
  have hM : 0≤M := mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one q s.im))
  have hML : M≤A*K*L := by
    have hh := mul_le_mul_of_nonneg_left hHeight hA.le
    dsimp [M]
    nlinarith only [hh]
  obtain ⟨hGeo,hErr⟩ := hBud L M B hL hM hML hBlog
  have hwRe : w.re=s.re+b/L := by simp [w]
  have hwIm : w.im=s.im := by simp [w]
  have hwlo : 1+κ/L≤w.re := by rwa [hwRe]
  have hwHi : w.re≤1+r/2 := by rw [hwRe]; linarith only [hshi,hGeo]
  have hw : 1<w.re := (lt_add_of_pos_right _ (div_pos hκ hL0)).trans_le hwlo
  obtain ⟨V,G,hV,hCov,hGa,hGb,hDloc,hGre⟩ := hBase q χ hχ (w:=w) hr hr32
    (show 0<κ/L by positivity) hwlo hwHi (by simpa [hwIm] using hT) hφ hB hQ hstrip
  refine ⟨V,(by simpa [hwIm] using hV),(by simpa [hwIm] using hCov),?_⟩
  intro U hU hUleft
  have hNe (ρ : ℂ) (hρ : ρ∈V) : w≠ρ := by
    intro he
    exact (not_lt_of_ge ((congrArg Complex.re he).symm ▸ (hV ρ hρ).2.1)) hw
  have hMem : w∈closedBall w (r/2) := mem_closedBall_self (by positivity)
  have hJ := independentRationalJet_of_partial_fractions (hGa w hMem) V (fun ρ=>(m ρ:ℂ))
    hNe hDloc u v
  let P := fun ρ : ℂ=>1/(w-ρ)+u/(w-ρ)^2+2*v/(w-ρ)^3
  change _ = independentRationalJet G u v w - ∑ ρ∈V,(m ρ:ℂ)*P ρ at hJ
  have hSum : (∑ ρ∈V,(m ρ:ℂ)*P ρ).re =
      L*∑ ρ∈V,(m ρ:ℝ)*(anchorRationalKernel b ((L:ℂ)*(s-ρ))).re := by
    change Complex.reAddGroupHom (∑ ρ∈V,(m ρ:ℂ)*P ρ)=_
    rw [map_sum,Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro ρ hρ
    have hp := anchor_pole_scale (b:=b) (s:=s) (ρ:=ρ) hL0.ne' (hNe ρ hρ)
    change P ρ=(L:ℂ)*anchorRationalKernel b ((L:ℂ)*(s-ρ)) at hp
    change ((m ρ:ℂ)*P ρ).re=_
    rw [hp,←Complex.ofReal_natCast]
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
    ring
  have hMono : (∑ ρ∈U,(m ρ:ℝ)*(anchorRationalKernel b ((L:ℂ)*(s-ρ))).re) ≤
      ∑ ρ∈V,(m ρ:ℝ)*(anchorRationalKernel b ((L:ℂ)*(s-ρ))).re := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hU
    intro ρ hρ hρ'
    apply mul_nonneg (Nat.cast_nonneg _)
    apply anchorRationalKernel_nonneg_of_re hb
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero,Complex.sub_re]
    exact mul_nonneg hL0.le (sub_nonneg.mpr (hUleft ρ hρ hρ'))
  have hGerr := independentRationalJet_analytic_error (show 0<r/2 by positivity) hGa hGb u v
  have hu : ‖u‖≤(2*b)/L := by
    have hh : 0≤(7/8:ℝ)*(b/L) := by positivity
    simp only [u,anchorPrimeLinear,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hh]
    rw [mul_div_assoc]
    nlinarith only [div_nonneg hb.le hL0.le]
  have hv : 2*‖v‖≤(2/3:ℝ)*((2*b)/L)^2 := by
    have hh : 0≤(b/L)^2/2 := by positivity
    simp only [v,anchorPrimeQuadratic,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hh]
    rw [mul_div_assoc,mul_pow]
    nlinarith only [sq_nonneg (b/L)]
  have hGerrorRe := (Complex.re_le_norm _).trans hGerr
  rw [Complex.sub_re] at hGerrorRe
  rw [hwIm] at hGerrorRe hGre
  have hu' : ‖u‖*((1+r⁻¹)*M)/(r/2)≤(2*b/L)*((1+r⁻¹)*M)/(r/2) := by gcongr
  have hv' : 2*‖v‖*((1+r⁻¹)*M)/(r/2)^2≤
      (2/3:ℝ)*(2*b/L)^2*((1+r⁻¹)*M)/(r/2)^2 := by gcongr
  change _≤‖u‖*((1+r⁻¹)*M)/(r/2)+2*‖v‖*((1+r⁻¹)*M)/(r/2)^2 at hGerrorRe
  change (G w).re≤φ*Real.log Q/2+16*max (Real.log (1+(κ/L)⁻¹)) (Real.log B)+192*r*M at hGre
  change (independentRationalJet (fun z=>-logDeriv χ.LFunction z) u v w).re≤_
  rw [hJ,Complex.sub_re,hSum]
  have hMono' := mul_le_mul_of_nonneg_left hMono hL0.le
  linarith only [hGerrorRe,hGre,hu',hv',hErr,hMono']

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachBurgessPrefix

open Finset

noncomputable section

def prefixSum (f : ℕ → ℂ) (N : ℕ) : ℂ := ∑ n ∈ range N, f (n+1)

theorem prefix_shift_norm_le (f : ℕ → ℂ) (h : ∀ n, ‖f n‖ ≤ 1) (N H : ℕ) :
    ‖prefixSum f N - ∑ n ∈ range N, f (n+1+H)‖ ≤ 2*(H:ℝ) := by
  have e₁ := sum_range_add (fun n => f (n+1)) N H
  have e₂ := sum_range_add (fun n => f (n+1)) H N
  rw [Nat.add_comm H N] at e₂
  have he : prefixSum f N-(∑ n ∈ range N,f (n+1+H)) =
      prefixSum f H-(∑ n ∈ range H,f (n+1+N)) := by
    unfold prefixSum
    simp only [Nat.add_assoc,Nat.add_left_comm,Nat.add_comm] at e₁ e₂ ⊢
    linear_combination e₂-e₁
  rw [he]
  have hle (K : ℕ) : ‖∑ n ∈ range H,f (n+1+K)‖ ≤ (H:ℝ) := calc
    _ ≤ ∑ n ∈ range H,‖f (n+1+K)‖ := norm_sum_le _ _
    _ ≤ ∑ _ ∈ range H,(1:ℝ) := sum_le_sum fun n _ => h _
    _ = _ := by simp
  have hP : ‖prefixSum f H‖ ≤ (H:ℝ) := by simpa [prefixSum] using hle 0
  linarith only [(norm_sub_le (prefixSum f H) (∑ n ∈ range H,f (n+1+N))).trans
    (add_le_add hP (hle N))]

/-- Two finite Cauchy–Schwarz applications in the fourth-power form used
in Burgess's averaging step. -/
theorem weighted_fourth_holder {ι : Type*} (S : Finset ι) (ν w : ι → ℝ)
    (hν : ∀ i ∈ S,0≤ν i) :
    (∑ i ∈ S,ν i*w i)^4 ≤ (∑ i ∈ S,ν i)^2*(∑ i ∈ S,(ν i)^2)*(∑ i ∈ S,(w i)^4) := by
  have h₁ := sum_sq_le_sum_mul_sum_of_sq_le_mul S (r:=fun i => ν i*w i)
    (f:=ν) (g:=fun i=>ν i*(w i)^2) hν
    (fun i hi => mul_nonneg (hν i hi) (sq_nonneg _)) (fun i _ => by ring_nf; exact le_rfl)
  have h₂ := sum_mul_sq_le_sq_mul_sq S ν (fun i=> (w i)^2)
  have h₃ := pow_le_pow_left₀ (sq_nonneg _) h₁ 2
  calc
    _ = ((∑ i ∈ S,ν i*w i)^2)^2 := by ring
    _ ≤ ((∑ i ∈ S,ν i)*(∑ i ∈ S,ν i*(w i)^2))^2 := h₃
    _ = (∑ i ∈ S,ν i)^2*(∑ i ∈ S,ν i*(w i)^2)^2 := by rw [mul_pow]
    _ ≤ _ := by
      rw [mul_assoc]
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
      simpa only [← pow_mul,show 2*2=4 by decide] using h₂

variable {q : ℕ} [NeZero q]

def normalizedResidue (u : ℕ → (ZMod q)ˣ) (p : ℕ × ℕ) : ZMod q :=
  ((p.2+1:ℕ):ZMod q)*(↑((u p.1)⁻¹):ZMod q)

def fiberCount (A : Finset ℕ) (u : ℕ → (ZMod q)ˣ) (N : ℕ) (x : ZMod q) : ℕ :=
  ((A ×ˢ range N).filter (fun p => normalizedResidue u p=x)).card

def shortSum (χ : DirichletCharacter ℂ q) (B : ℕ) (x : ZMod q) : ℂ :=
  ∑ b ∈ range B,χ (x+((b+1:ℕ):ZMod q))

theorem sum_fiberCount (A : Finset ℕ) (u : ℕ → (ZMod q)ˣ) (N : ℕ) :
    ∑ x : ZMod q, fiberCount A u N x = A.card*N := by
  classical
  simpa only [fiberCount,card_product,card_range] using
    (card_eq_sum_card_fiberwise (f:=normalizedResidue u) (s:=A ×ˢ range N)
      (t:=univ) (fun p _ => mem_univ (normalizedResidue u p))).symm

omit [NeZero q] in
private theorem character_shift {χ : DirichletCharacter ℂ q} {u : ℕ → (ZMod q)ˣ}
    {a n b : ℕ} (hu : ((u a):(ZMod q)) = a) :
    χ ((n+1+a*(b+1):ℕ):ZMod q) = χ (a:ZMod q)*
      χ (normalizedResidue u (a,n)+((b+1:ℕ):ZMod q)) := by
  rw [←map_mul]
  congr 1
  simp only [normalizedResidue,Nat.cast_add,Nat.cast_one,Nat.cast_mul]
  have he : (a:ZMod q)*(↑((u a)⁻¹):ZMod q)=1 := by
    rw [←hu,←Units.val_mul,mul_inv_cancel,Units.val_one]
  calc
    _ = (((n:ZMod q)+1)*((a:ZMod q)*(↑((u a)⁻¹):ZMod q)))+
        (a:ZMod q)*((b:ZMod q)+1) := by rw [he,mul_one]
    _ = _ := by ring

/-- The Burgess shift average, without dividing by the number of available
units. The shift error is at most twice the maximal shift. -/
theorem prefix_average_le (χ : DirichletCharacter ℂ q) (A : Finset ℕ)
    (u : ℕ → (ZMod q)ˣ) (N B V : ℕ) (hA : ∀ a∈A,a≤V)
    (hu : ∀ a∈A,((u a):ZMod q)=a) :
    ((A.card:ℝ)*B)*‖prefixSum (fun n => χ (n:ZMod q)) N‖ ≤
      ((A.card:ℝ)*B)*(2*(V:ℝ)*B)+
        ∑ x : ZMod q, (fiberCount A u N x:ℝ)*‖shortSum χ B x‖ := by
  classical
  let S := prefixSum (fun n => χ (n:ZMod q)) N
  let D (a b : ℕ) := ∑ n∈range N,χ ((n+1+a*(b+1):ℕ):ZMod q)
  have hs : ((A.card:ℂ)*B)*S =
      (∑ a∈A,∑ b∈range B,(S-D a b))+(∑ a∈A,∑ b∈range B,D a b) := by
    simp [sum_sub_distrib, sum_const, nsmul_eq_mul, mul_assoc]
  have herr (a : ℕ) (ha : a∈A) (b : ℕ) (hb : b∈range B) : ‖S-D a b‖ ≤ 2*(V:ℝ)*B := by
    refine (prefix_shift_norm_le (fun n => χ (n:ZMod q)) (fun _ => χ.norm_le_one _) N
      (a*(b+1))).trans ?_
    have hab : a*(b+1) ≤ V*B := Nat.mul_le_mul (hA a ha) (Nat.succ_le_of_lt (mem_range.mp hb))
    have hab' : ((a*(b+1):ℕ):ℝ) ≤ (V:ℝ)*B := by exact_mod_cast hab
    linarith only [hab']
  have hsumerr : ‖∑ a∈A,∑ b∈range B,(S-D a b)‖ ≤ ((A.card:ℝ)*B)*(2*(V:ℝ)*B) := by
    refine (norm_sum_le _ _).trans ?_
    calc
      _ ≤ ∑ a∈A,∑ b∈range B,‖S-D a b‖ := sum_le_sum fun a _ => norm_sum_le _ _
      _ ≤ ∑ _∈A,∑ _∈range B,2*(V:ℝ)*B := sum_le_sum fun a ha => sum_le_sum (herr a ha)
      _ = _ := by simp [nsmul_eq_mul,mul_assoc]
  have hsumD : (∑ a∈A,∑ b∈range B,D a b) =
      ∑ a∈A,∑ n∈range N,χ (a:ZMod q)*shortSum χ B (normalizedResidue u (a,n)) := by
    apply sum_congr rfl
    intro a ha
    dsimp only [D]
    rw [sum_comm]
    apply sum_congr rfl
    intro n _
    rw [shortSum,mul_sum]
    exact sum_congr rfl (fun b _ => character_shift (hu a ha))
  have hreg : (∑ a∈A,∑ n∈range N,‖shortSum χ B (normalizedResidue u (a,n))‖) =
      ∑ x : ZMod q, (fiberCount A u N x:ℝ)*‖shortSum χ B x‖ := by
    rw [←sum_product A (range N) (fun p : ℕ × ℕ => ‖shortSum χ B (normalizedResidue u p)‖)]
    have hmap : ((A ×ˢ range N : Finset (ℕ × ℕ)):Set (ℕ × ℕ)).MapsTo
        (normalizedResidue u) (univ : Finset (ZMod q)) := fun p _ => mem_univ _
    rw [←sum_fiberwise_of_maps_to hmap]
    apply sum_congr rfl
    intro x _
    calc
      _ = ∑ _ ∈ (A ×ˢ range N).filter (fun p => normalizedResidue u p=x), ‖shortSum χ B x‖ := by
        apply sum_congr rfl
        intro p hp
        rw [(mem_filter.mp hp).2]
      _ = _ := by simp [fiberCount,nsmul_eq_mul]
  have hD : ‖∑ a∈A,∑ b∈range B,D a b‖ ≤
      ∑ x : ZMod q, (fiberCount A u N x:ℝ)*‖shortSum χ B x‖ := by
    rw [hsumD,←hreg]
    refine (norm_sum_le _ _).trans (sum_le_sum (fun a _ => (norm_sum_le _ _).trans ?_))
    apply sum_le_sum
    intro n _
    rw [norm_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)
  calc
    _ = ‖((A.card:ℂ)*B)*S‖ := by rw [norm_mul,norm_mul,Complex.norm_natCast,Complex.norm_natCast]
    _ ≤ _ := by rw [hs]; exact (norm_add_le _ _).trans (add_le_add hsumerr hD)

/-- Discharging the collision and complete fourth moments gives the initial segment
bound by one nonnegative fourth root. -/
theorem prefix_fourth_le (χ : DirichletCharacter ℂ q) (A : Finset ℕ)
    (u : ℕ → (ZMod q)ˣ) (N B V : ℕ) (hA : ∀ a∈A,a≤V)
    (hu : ∀ a∈A,((u a):ZMod q)=a) :
    (max (((A.card:ℝ)*B)*(‖prefixSum (fun n => χ (n:ZMod q)) N‖-2*(V:ℝ)*B)) 0)^4 ≤
      ((A.card:ℝ)*N)^2*(∑ x : ZMod q,(fiberCount A u N x:ℝ)^2)*
        (∑ x : ZMod q,‖shortSum χ B x‖^4) := by
  have hAvg := prefix_average_le χ A u N B V hA hu
  let F (x : ZMod q) := (fiberCount A u N x:ℝ)
  let W (x : ZMod q) := ‖shortSum χ B x‖
  have hHold := weighted_fourth_holder (univ:Finset (ZMod q)) F W (fun _ _ => by dsimp [F]; positivity)
  have hsum : ∑ x,F x = (A.card:ℝ)*N := by
    dsimp only [F]
    exact_mod_cast sum_fiberCount A u N
  rw [hsum] at hHold
  refine le_trans (pow_le_pow_left₀ (le_max_right _ _) (max_le ?_ ?_) 4) hHold
  · dsimp only [F,W]
    linarith only [hAvg]
  · exact sum_nonneg (fun x _ => by dsimp [F,W]; positivity)

end
end GoldbachBurgessPrefix
end

section
namespace GoldbachBurgess

open Finset GoldbachBurgessPrefix
open scoped ComplexConjugate

noncomputable section

def balancedTerm (i : Fin 4) (z : ℂ) : ℂ :=
  if (i:ℕ)<2 then z else conj z

theorem balancedTerm_mul (i : Fin 4) (z w : ℂ) :
    balancedTerm i (z*w) = balancedTerm i z*balancedTerm i w := by
  unfold balancedTerm
  split <;> simp_all

def completeBalancedCorrelation {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (a : Fin 4 → ℤ) : ℂ :=
  ∑ x : ZMod q, ∏ i, balancedTerm i (χ (x-(a i:ZMod q)))

theorem fourthMoment_le_sum_balancedCorrelation {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (B : ℕ) :
    (∑ x : ZMod q, ‖shortSum χ B x‖^4) ≤
      ∑ a ∈ Fintype.piFinset (fun _ : Fin 4 => range B),
        ‖completeBalancedCorrelation χ (fun i => -((a i+1:ℕ):ℤ))‖ := by
  classical
  let C := fun a : Fin 4 → ℕ =>
    completeBalancedCorrelation χ (fun i => -((a i+1:ℕ):ℤ))
  have hsum (x : ZMod q) : (‖shortSum χ B x‖:ℂ)^4 =
      ∑ a ∈ Fintype.piFinset (fun _ : Fin 4 => range B),
        ∏ i,balancedTerm i (χ (x-( -((a i+1:ℕ):ℤ):ℤ))) := by
    rw [← prod_univ_sum (fun _ : Fin 4 => range B)
      (fun i b => balancedTerm i (χ (x-( -((b+1:ℕ):ℤ):ℤ)))),Fin.prod_univ_four]
    simp only [Int.cast_neg,sub_neg_eq_add,Int.cast_natCast,balancedTerm]
    norm_num
    simp only [← map_sum]
    have hs : (∑ b ∈ range B, χ (x+((b:ZMod q)+1))) = shortSum χ B x := by
      simp only [shortSum,Nat.cast_add,Nat.cast_one]
    simp only [hs]
    have h := Complex.mul_conj' (shortSum χ B x)
    linear_combination -( (‖shortSum χ B x‖:ℂ)^2 +
       shortSum χ B x * conj (shortSum χ B x)) * h
  have he : Complex.ofReal (∑ x : ZMod q, ‖shortSum χ B x‖^4) =
      ∑ a ∈ Fintype.piFinset (fun _ : Fin 4 => range B), C a := by
    rw [Complex.ofReal_sum]
    simp only [Complex.ofReal_pow,hsum]
    rw [sum_comm]
    rfl
  rw [← Real.norm_of_nonneg (sum_nonneg (fun x _ => pow_nonneg (norm_nonneg _) _)),
    ← Complex.norm_real,he]
  exact norm_sum_le _ _

end
end GoldbachBurgess
end

section
namespace GoldbachBurgess

open Finset DirichletCharacter

noncomputable section

private theorem crt_fst {m d : ℕ} [NeZero m] [NeZero d] (h : m.Coprime d)
    (z : ZMod (m*d)) : (ZMod.chineseRemainder h z).1 = (ZMod.cast z:ZMod m) := by
  let e := ZMod.chineseRemainder h
  change (e z).1 = _
  conv_lhs => rw [← ZMod.natCast_zmod_val z, map_natCast]
  rw [← ZMod.natCast_zmod_val z, ZMod.cast_natCast (Nat.dvd_mul_right m d)]
  simp

private theorem crt_snd {m d : ℕ} [NeZero m] [NeZero d] (h : m.Coprime d)
    (z : ZMod (m*d)) : (ZMod.chineseRemainder h z).2 = (ZMod.cast z:ZMod d) := by
  let e := ZMod.chineseRemainder h
  change (e z).2 = _
  conv_lhs => rw [← ZMod.natCast_zmod_val z, map_natCast]
  rw [← ZMod.natCast_zmod_val z, ZMod.cast_natCast (Nat.dvd_mul_left d m)]
  simp

private theorem crt_lift_eval {m d : ℕ} [NeZero m] [NeZero d] (h : m.Coprime d)
    (χ : DirichletCharacter ℂ m) (ξ : DirichletCharacter ℂ d) (y : ZMod (m*d)) :
    (χ.changeLevel (Nat.dvd_mul_right m d) * ξ.changeLevel (Nat.dvd_mul_left d m)) y =
      χ ((ZMod.chineseRemainder h y).1) * ξ ((ZMod.chineseRemainder h y).2) := by
  let e := ZMod.chineseRemainder h
  change _ = χ (e y).1 * ξ (e y).2
  by_cases hy : IsUnit y
  · obtain ⟨v,rfl⟩ := hy
    rw [MulChar.mul_apply, changeLevel_eq_cast_of_dvd,changeLevel_eq_cast_of_dvd,
      crt_fst h,crt_snd h]
  · rw [MulChar.map_nonunit _ hy]
    by_cases hm : IsUnit (e y).1
    · have hd : ¬IsUnit (e y).2 := fun hh => hy
        (by simpa using (Prod.isUnit_iff.mpr ⟨hm,hh⟩).map e.symm)
      simp [MulChar.map_nonunit ξ hd]
    · simp [MulChar.map_nonunit χ hm]

/-- Complete quartic correlations factor exactly over coprime moduli. -/
theorem completeBalancedCorrelation_crt {m d : ℕ} [NeZero m] [NeZero d] [NeZero (m*d)]
    (h : m.Coprime d) (χ : DirichletCharacter ℂ m) (ξ : DirichletCharacter ℂ d)
    (a : Fin 4 → ℤ) :
    completeBalancedCorrelation (χ.changeLevel (Nat.dvd_mul_right m d) *
      ξ.changeLevel (Nat.dvd_mul_left d m)) a =
      completeBalancedCorrelation χ a * completeBalancedCorrelation ξ a := by
  classical
  let e := ZMod.chineseRemainder h
  let f (x : ZMod m) := ∏ i, balancedTerm i (χ (x-(a i:ZMod m)))
  let g (x : ZMod d) := ∏ i, balancedTerm i (ξ (x-(a i:ZMod d)))
  unfold completeBalancedCorrelation
  calc
    _ = ∑ x : ZMod (m*d),f (e x).1 * g (e x).2 := by
      apply sum_congr rfl
      intro x _
      dsimp only [f,g]
      rw [←prod_mul_distrib]
      apply prod_congr rfl
      intro i _
      rw [crt_lift_eval h, balancedTerm_mul, map_sub, map_intCast]
      rfl
    _ = ∑ x : ZMod m × ZMod d,f x.1*g x.2 :=
      Equiv.sum_comp e.toEquiv (fun x : ZMod m × ZMod d => f x.1*g x.2)
    _ = _ := by
      rw [Fintype.sum_prod_type, sum_mul]
      apply sum_congr rfl
      intro x _
      rw [mul_sum]

private def unitsCrt {m d : ℕ} (h : m.Coprime d) :
    (ZMod (m*d))ˣ ≃* (ZMod m)ˣ × (ZMod d)ˣ :=
  (Units.mapEquiv (ZMod.chineseRemainder h).toMulEquiv).trans MulEquiv.prodUnits

private def crtLeft {m d : ℕ} (h : m.Coprime d)
    (χ : DirichletCharacter ℂ (m*d)) : DirichletCharacter ℂ m :=
  MulChar.ofUnitHom (χ.toUnitHom.comp ((unitsCrt h).symm.toMonoidHom.comp (MonoidHom.inl _ _)))

private def crtRight {m d : ℕ} (h : m.Coprime d)
    (χ : DirichletCharacter ℂ (m*d)) : DirichletCharacter ℂ d :=
  MulChar.ofUnitHom (χ.toUnitHom.comp ((unitsCrt h).symm.toMonoidHom.comp (MonoidHom.inr _ _)))

private theorem crtParts_spec {m d : ℕ} [NeZero m] [NeZero d]
    (h : m.Coprime d) (χ : DirichletCharacter ℂ (m*d)) :
    χ = (crtLeft h χ).changeLevel (Nat.dvd_mul_right m d)*
      (crtRight h χ).changeLevel (Nat.dvd_mul_left d m) := by
  apply MulChar.ext
  intro v
  rw [crt_lift_eval h]
  let e := unitsCrt h
  change χ (v:ZMod (m*d)) = crtLeft h χ ((e v).1:ZMod m) * crtRight h χ ((e v).2:ZMod d)
  simp only [crtLeft,crtRight,MulChar.ofUnitHom_coe,MonoidHom.comp_apply,
    MulEquiv.coe_toMonoidHom,MonoidHom.inl_apply,MonoidHom.inr_apply,MulChar.coe_toUnitHom]
  rw [←map_mul χ,←Units.val_mul,←map_mul]
  change χ (v:ZMod (m*d)) = χ (↑(e.symm (((e v).1,1)* (1,(e v).2))):ZMod (m*d))
  have he : (((e v).1,1)* (1,(e v).2))=e v := by ext <;> simp
  rw [he,e.symm_apply_apply]

theorem exists_primitive_balanced_crt_parts {m d : ℕ} [NeZero m] [NeZero d] [NeZero (m*d)]
    (h : m.Coprime d) (χ : DirichletCharacter ℂ (m*d))
    (hp : χ.IsPrimitive) :
    ∃ χ₁ : DirichletCharacter ℂ m, ∃ χ₂ : DirichletCharacter ℂ d,
      χ₁.IsPrimitive ∧ χ₂.IsPrimitive ∧
        ∀ a : Fin 4 → ℤ, completeBalancedCorrelation χ a =
          completeBalancedCorrelation χ₁ a*completeBalancedCorrelation χ₂ a := by
  let χ₁ := crtLeft h χ
  let χ₂ := crtRight h χ
  have hχ : χ = χ₁.changeLevel (Nat.dvd_mul_right m d)*χ₂.changeLevel (Nat.dvd_mul_left d m) :=
    crtParts_spec h χ
  have hcond := conductor_mul_dvd_lcm_conductor
    (χ₁.changeLevel (Nat.dvd_mul_right m d)) (χ₂.changeLevel (Nat.dvd_mul_left d m))
  rw [←hχ,hp,conductor_changeLevel,conductor_changeLevel] at hcond
  have hc₁ := Nat.le_of_dvd (NeZero.pos m) χ₁.conductor_dvd_level
  have hc₂ := Nat.le_of_dvd (NeZero.pos d) χ₂.conductor_dvd_level
  have h₁ := Nat.pos_of_ne_zero χ₁.conductor_ne_zero
  have h₂ := Nat.pos_of_ne_zero χ₂.conductor_ne_zero
  have hL := Nat.le_of_dvd (Nat.lcm_pos h₁ h₂) hcond
  have hP := hL.trans (Nat.lcm_le_mul h₁ h₂)
  refine ⟨χ₁,χ₂,?_,?_,?_⟩
  · refine le_antisymm hc₁ (le_of_not_gt (fun hlt => hP.not_gt ?_))
    exact (Nat.mul_le_mul_left _ hc₂).trans_lt (Nat.mul_lt_mul_of_pos_right hlt (NeZero.pos d))
  · refine le_antisymm hc₂ (le_of_not_gt (fun hlt => hP.not_gt ?_))
    exact (Nat.mul_le_mul_right _ hc₁).trans_lt (Nat.mul_lt_mul_of_pos_left hlt (NeZero.pos m))
  · intro a
    rw [hχ,completeBalancedCorrelation_crt h]

end
end GoldbachBurgess
end

section
namespace GoldbachQuadraticCorrelation

open Finset
open scoped Classical

noncomputable section

def tupleBox (B : ℕ) : Finset (Fin 4 → ℕ) := Fintype.piFinset (fun _ => range B)

def solitary (a : Fin 4 → ℕ) (i : Fin 4) : Prop := ∀ j : Fin 4,j≠i → a j≠a i

private theorem has_partner_of_not_solitary {a : Fin 4 → ℕ} {i : Fin 4}
    (h : ¬solitary a i) : ∃ j : Fin 4,j≠i ∧ a j=a i := by
  unfold solitary at h
  push Not at h
  exact h

private theorem no_solitary_pairings {a : Fin 4 → ℕ} (h : ∀ i, ¬solitary a i) :
    (a 0=a 1 ∧ a 2=a 3) ∨ (a 0=a 2 ∧ a 1=a 3) ∨ (a 0=a 3 ∧ a 1=a 2) := by
  obtain ⟨a₀,h₀,he₀⟩ := has_partner_of_not_solitary (h 0)
  obtain ⟨a₁,h₁,he₁⟩ := has_partner_of_not_solitary (h 1)
  obtain ⟨a₂,h₂,he₂⟩ := has_partner_of_not_solitary (h 2)
  obtain ⟨a₃,h₃,he₃⟩ := has_partner_of_not_solitary (h 3)
  fin_cases a₀ <;> fin_cases a₁ <;> fin_cases a₂ <;> fin_cases a₃ <;> simp_all

private theorem pairing_card_le (B : ℕ) {i j k l : Fin 4}
    (hcover : ∀ t : Fin 4,t=i ∨ t=j ∨ t=k ∨ t=l) :
    ((tupleBox B).filter (fun a => a i=a j ∧ a k=a l)).card ≤ B^2 := by
  classical
  let S := (tupleBox B).filter (fun a => a i=a j ∧ a k=a l)
  let f (a : Fin 4 → ℕ) := (a i,a k)
  have hmap : (S:Set (Fin 4 → ℕ)).MapsTo f ((range B ×ˢ range B : Finset (ℕ × ℕ)):Set (ℕ × ℕ)) := by
    intro a ha
    have hh := Fintype.mem_piFinset.mp (mem_filter.mp ha).1
    change (a i,a k)∈(range B ×ˢ range B : Finset (ℕ × ℕ))
    exact mem_product.mpr ⟨hh i,hh k⟩
  have hinj : (S:Set (Fin 4 → ℕ)).InjOn f := by
    intro a ha b hb he
    obtain ⟨_,ha₁,ha₂⟩ := mem_filter.mp ha
    obtain ⟨_,hb₁,hb₂⟩ := mem_filter.mp hb
    have h₁ : a i=b i := congrArg Prod.fst he
    have h₂ : a k=b k := congrArg Prod.snd he
    funext t
    rcases hcover t with rfl|rfl|rfl|rfl
    · exact h₁
    · exact ha₁.symm.trans (h₁.trans hb₁)
    · exact h₂
    · exact ha₂.symm.trans (h₂.trans hb₂)
  simpa only [S,card_product,card_range,pow_two] using card_le_card_of_injOn f hmap hinj

/-- There are at most three pairings of four positions when all values occur
at least twice. -/
theorem no_solitary_card_le (B : ℕ) :
    ((tupleBox B).filter (fun a => ∀ i,¬solitary a i)).card ≤ 3*B^2 := by
  classical
  let A₀ := (tupleBox B).filter (fun a => a 0=a 1 ∧ a 2=a 3)
  let A₁ := (tupleBox B).filter (fun a => a 0=a 2 ∧ a 1=a 3)
  let A₂ := (tupleBox B).filter (fun a => a 0=a 3 ∧ a 1=a 2)
  have hsub : (tupleBox B).filter (fun a => ∀ i,¬solitary a i) ⊆ A₀∪A₁∪A₂ := by
    intro a ha
    obtain ⟨ha,h⟩ := mem_filter.mp ha
    rcases no_solitary_pairings h with h₀|h₁|h₂
    · exact mem_union_left _ (mem_union_left _ (mem_filter.mpr ⟨ha,h₀⟩))
    · exact mem_union_left _ (mem_union_right _ (mem_filter.mpr ⟨ha,h₁⟩))
    · exact mem_union_right _ (mem_filter.mpr ⟨ha,h₂⟩)
  have h₀ : A₀.card≤B^2 := pairing_card_le B (by decide)
  have h₁ : A₁.card≤B^2 := pairing_card_le B (by decide)
  have h₂ : A₂.card≤B^2 := pairing_card_le B (by decide)
  exact (card_le_card hsub).trans ((card_union_le _ _).trans (by
    have h := card_union_le A₀ A₁
    omega))


end
end GoldbachQuadraticCorrelation
end

section
namespace GoldbachBurgess

open Finset GoldbachQuadraticCorrelation GoldbachBurgessPrefix
open scoped Classical

noncomputable section

private theorem dist_le_of_mem_range {u v B : ℕ} (hu : u<B) (hv : v<B) :
    Nat.dist u v ≤ B := by unfold Nat.dist; omega

private theorem count_dvd_dist_le {u B d : ℕ} (hu : u<B) (hd : 0<d) :
    (((range B).erase u).filter (fun v => d ∣ Nat.dist u v)).card ≤ 2*(B/d) := by
  classical
  let F := ((range B).erase u).filter (fun v => d ∣ Nat.dist u v)
  let g (v : ℕ) := (decide (v≤u),Nat.dist u v/d)
  let target := (univ:Finset Bool) ×ˢ Icc 1 (B/d)
  have hmap : (F:Set ℕ).MapsTo g target := by
    intro v hv
    obtain ⟨hv,hD⟩ := mem_filter.mp hv
    obtain ⟨hvu,hvB⟩ := mem_erase.mp hv
    have hDist := Nat.dist_pos_of_ne (Ne.symm hvu)
    apply mem_product.mpr
    refine ⟨mem_univ _,mem_Icc.mpr ⟨?_,Nat.div_le_div_right (dist_le_of_mem_range hu (mem_range.mp hvB))⟩⟩
    exact Nat.succ_le_iff.mpr (Nat.div_pos (Nat.le_of_dvd hDist hD) hd)
  have hinj : (F:Set ℕ).InjOn g := by
    intro v hv w hw he
    obtain ⟨_,hdv⟩ := mem_filter.mp hv
    obtain ⟨_,hdw⟩ := mem_filter.mp hw
    have hdE : Nat.dist u v = Nat.dist u w := by
      have h := congrArg (fun p : Bool × ℕ => p.2*d) he
      simpa only [g,Nat.div_mul_cancel hdv,Nat.div_mul_cancel hdw] using h
    have hs := congrArg Prod.fst he
    dsimp only [g] at hs
    by_cases hvu : v≤u
    · have hwu : w≤u := of_decide_eq_true (hs.symm.trans (decide_eq_true hvu))
      rw [Nat.dist_eq_sub_of_le_right hvu,Nat.dist_eq_sub_of_le_right hwu] at hdE
      omega
    · have hwu : ¬w≤u := of_decide_eq_false (hs.symm.trans (decide_eq_false hvu))
      rw [Nat.dist_eq_sub_of_le (le_of_not_ge hvu),Nat.dist_eq_sub_of_le (le_of_not_ge hwu)] at hdE
      omega
  have h := card_le_card_of_injOn g hmap hinj
  simpa only [F,target,card_product,card_univ,Fintype.card_bool,Nat.card_Icc,add_tsub_cancel_right] using h

/-- A fixed short interval supplies at most two nonzero displacements for
each given distance. Summing the gcd weights costs a divisor factor. -/
theorem sum_gcd_dist_le {q u B : ℕ} (hq : 0<q) (hu : u<B) :
    ∑ v ∈ (range B).erase u, (q.gcd (Nat.dist u v):ℝ) ≤
      2*(B:ℝ)*q.divisors.card := by
  classical
  let D (v : ℕ) := q.gcd (Nat.dist u v)
  let S := (range B).erase u
  have hmap : (S:Set ℕ).MapsTo D q.divisors := by
    intro v _
    exact Nat.mem_divisors.mpr ⟨Nat.gcd_dvd_left ..,hq.ne'⟩
  change (∑ v∈S,(D v:ℝ)) ≤ _
  rw [← sum_fiberwise_of_maps_to hmap]
  calc
    _ ≤ ∑ d∈q.divisors,2*(B:ℝ) := by
      apply sum_le_sum
      intro d hd
      have hd₀ := Nat.pos_of_mem_divisors hd
      have hsub : S.filter (fun v => D v=d) ⊆
          S.filter (fun v => d ∣ Nat.dist u v) := by
        intro v hv
        obtain ⟨hv,he⟩ := mem_filter.mp hv
        exact mem_filter.mpr ⟨hv,he ▸ Nat.gcd_dvd_right q (Nat.dist u v)⟩
      have hCard := (card_le_card hsub).trans (count_dvd_dist_le hu hd₀)
      have hconst : (∑ v ∈ S.filter (fun v => D v=d),(D v:ℝ)) =
          ((S.filter (fun v => D v=d)).card:ℝ)*(d:ℝ) := by
        rw [← nsmul_eq_mul,←sum_const]
        exact sum_congr rfl (fun v hv => by rw [(mem_filter.mp hv).2])
      have hc : (((S.filter (fun v => D v=d)).card:ℕ):ℝ) ≤ 2*((B/d:ℕ):ℝ) := by
        exact_mod_cast hCard
      have hDivide : ((B/d:ℕ):ℝ)*(d:ℝ)≤B := by
        exact_mod_cast Nat.div_mul_le_self B d
      rw [hconst]
      calc
        _ ≤ (2*((B/d:ℕ):ℝ))*d := mul_le_mul_of_nonneg_right hc (Nat.cast_nonneg d)
        _ ≤ _ := by linarith only [hDivide]
    _ = _ := by simp [nsmul_eq_mul,mul_comm,mul_left_comm]

/-- The separable gcd weights over all tuples for one designated solitary
index cost no more than three copies of the displacement bound. -/
theorem solitary_full_gcd_sum_le {q : ℕ} (hq : 0<q) (B : ℕ) (i : Fin 4) :
    ∑ a ∈ (tupleBox B).filter (fun a=>solitary a i),
      ∏ j ∈ (univ : Finset (Fin 4)).erase i, (q.gcd (Nat.dist (a i) (a j)):ℝ) ≤
        (B:ℝ)*(2*(B:ℝ)*q.divisors.card)^3 := by
  classical
  let J := (univ : Finset (Fin 4)).erase i
  let G (u v : ℕ) : ℝ := (q.gcd (Nat.dist u v):ℝ)
  let W (u : ℕ) (j : Fin 4) (v : ℕ) : ℝ :=
    if j=i then if v=u then 1 else 0 else if v=u then 0 else G u v
  let P (a : Fin 4 → ℕ) := ∏ j∈J, G (a i) (a j)
  have hW (u : ℕ) (j : Fin 4) (v : ℕ) : 0≤W u j v := by dsimp [W,G]; split <;> split <;> positivity
  have hpoint (a : Fin 4 → ℕ) (ha : a ∈ (tupleBox B).filter (fun a=>solitary a i)) :
      P a ≤ ∑ u ∈ range B, ∏ j, W u j (a j) := by
    obtain ⟨ha,hs⟩ := mem_filter.mp ha
    have hu := Fintype.mem_piFinset.mp ha i
    have he : (∏ j, W (a i) j (a j)) = P a := by
      rw [← Finset.mul_prod_erase univ _ (mem_univ i)]
      rw [show W (a i) i (a i)=1 by simp [W],one_mul]
      apply prod_congr rfl
      intro j hj
      have hji := (mem_erase.mp hj).1
      simp [W,hji,hs j hji]
    rw [←he]
    exact single_le_sum (fun j _ => prod_nonneg fun k _=>hW j k (a k)) hu
  calc
    _ ≤ ∑ a∈(tupleBox B).filter (fun a=>solitary a i),
        ∑ u∈range B,∏ j,W u j (a j) := sum_le_sum hpoint
    _ ≤ ∑ a∈tupleBox B,∑ u∈range B,∏ j,W u j (a j) :=
      sum_le_sum_of_subset_of_nonneg (filter_subset ..)
        (fun a _ _ => sum_nonneg fun u _ => prod_nonneg fun j _=>hW u j (a j))
    _ = ∑ u∈range B, ∏ j,∑ v∈range B,W u j v := by
      rw [sum_comm]
      apply sum_congr rfl
      intro u _
      exact sum_prod_piFinset (ι:=Fin 4) (range B) (W u)
    _ ≤ ∑ _∈range B,(2*(B:ℝ)*q.divisors.card)^3 := by
      apply sum_le_sum
      intro u hu
      rw [←Finset.mul_prod_erase univ _ (mem_univ i)]
      have hdiag : (∑ v∈range B,W u i v)=1 := by simp [W,hu]
      rw [hdiag,one_mul]
      have hb (j : Fin 4) (hj : j∈J) :
          ∑ v∈range B,W u j v ≤ 2*(B:ℝ)*q.divisors.card := by
        have hji := (mem_erase.mp hj).1
        rw [show (∑ v∈range B,W u j v)=∑ v∈(range B).erase u,G u v by
          rw [←sum_erase_add _ _ hu,show W u j u=0 by simp [W,hji],add_zero]
          exact sum_congr rfl (fun v hv=> by simp [W,hji,(mem_erase.mp hv).1])]
        exact sum_gcd_dist_le hq (mem_range.mp hu)
      have hcard : J.card=3 := by simp [J]
      rw [←hcard,←prod_const]
      exact prod_le_prod₀ (fun j _=>sum_nonneg fun v _=>hW u j v) hb
    _ = _ := by simp [nsmul_eq_mul]

theorem natAbs_negative_offsets (u v : ℕ) :
    ((-((u+1:ℕ):ℤ))-(-((v+1:ℕ):ℤ))).natAbs = Nat.dist u v := by
  have h : (-((u+1:ℕ):ℤ))-(-((v+1:ℕ):ℤ)) = (v:ℤ)-(u:ℤ) := by push_cast; ring
  rw [h]
  rcases le_total u v with h|h
  · rw [Int.natAbs_natCast_sub_natCast_of_ge h,Nat.dist_eq_sub_of_le h]
  · rw [Int.natAbs_natCast_sub_natCast_of_le h,Nat.dist_eq_sub_of_le_right h]

theorem natGcd_prod_dvd_prod_natGcd {ι : Type*} (q : ℕ) (S : Finset ι) (f : ι→ℕ) :
    q.gcd (∏ j∈S,f j) ∣ ∏ j∈S,q.gcd (f j) := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert i S hi ih =>
    simp only [prod_insert hi]
    exact (show q.gcd (f i*(∏ j∈S,f j))∣q.gcd (f i)*q.gcd (∏ j∈S,f j) from
      gcd_mul_dvd_mul_gcd q (f i) _).trans (mul_dvd_mul_left _ ih)

theorem natGcd_prod_le_prod_natGcd {ι : Type*} {q : ℕ} (hq : 0<q) (S : Finset ι) (f : ι→ℕ) :
    q.gcd (∏ j∈S,f j) ≤ ∏ j∈S,q.gcd (f j) :=
  Nat.le_of_dvd (prod_pos (fun _ _=>Nat.gcd_pos_of_pos_left _ hq)) (natGcd_prod_dvd_prod_natGcd q S f)

theorem norm_completeBalancedCorrelation_le_nat {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (a : Fin 4 → ℤ) :
    ‖completeBalancedCorrelation χ a‖≤q := by
  unfold completeBalancedCorrelation
  refine (norm_sum_le _ _).trans ?_
  calc
    _ ≤ ∑ x : ZMod q,(1:ℝ) := by
      apply sum_le_sum
      intro x _
      rw [norm_prod]
      apply prod_le_one₀ (fun _ _=>norm_nonneg _)
      intro i _
      unfold balancedTerm
      split
      · exact χ.norm_le_one _
      · simpa only [Complex.norm_conj] using χ.norm_le_one (x-(a i:ZMod q))
    _ = _ := by simp [ZMod.card]

/-- Average the full gcd charged to a single isolated coordinate of each
quartic tuple. The three paired diagonals use the trivial complete bound. -/
theorem sum_balancedCorrelation_le_of_solitary_gcd {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (B : ℕ) {M : ℝ} (hM : 0≤M)
    (hCorr : ∀ a : Fin 4→ℕ, (∃ i,solitary a i) →
      ∃ i, solitary a i ∧ ‖completeBalancedCorrelation χ (fun j=>-((a j+1:ℕ):ℤ))‖ ≤
        M*(q.gcd (∏ j∈(univ:Finset (Fin 4)).erase i,Nat.dist (a i) (a j)):ℝ)) :
    (∑ a∈tupleBox B, ‖completeBalancedCorrelation χ (fun j=>-((a j+1:ℕ):ℤ))‖) ≤
      3*(q:ℝ)*(B:ℝ)^2+32*M*(q.divisors.card:ℝ)^3*(B:ℝ)^4 := by
  classical
  let S := tupleBox B
  let R (a : Fin 4 → ℕ) := fun i => -((a i+1:ℕ):ℤ)
  let W (a : Fin 4 → ℕ) (i : Fin 4) := ∏ j∈(univ:Finset (Fin 4)).erase i,
    (q.gcd (Nat.dist (a i) (a j)):ℝ)
  let D (a : Fin 4 → ℕ) : ℝ := if ∀ i, ¬solitary a i then (q:ℝ) else 0
  let U (a : Fin 4 → ℕ) (i : Fin 4) := if solitary a i then W a i else 0
  have hW (a : Fin 4 → ℕ) (i : Fin 4) : 0≤W a i := prod_nonneg (fun _ _ => Nat.cast_nonneg _)
  have hU (a : Fin 4 → ℕ) (i : Fin 4) : 0≤U a i := by
    dsimp only [U]
    split
    · exact hW a i
    · exact le_rfl
  have hpnt (a : Fin 4 → ℕ) : ‖completeBalancedCorrelation χ (R a)‖ ≤ D a+M*(∑ i,U a i) := by
    by_cases hd : ∀ i, ¬solitary a i
    · dsimp only [D]
      rw [ite_eq_left hd]
      exact (norm_completeBalancedCorrelation_le_nat χ _).trans
        (le_add_of_nonneg_right (mul_nonneg hM (sum_nonneg fun i _=>hU a i)))
    have hD : ∃ i,solitary a i := by push Not at hd; exact hd
    obtain ⟨i,hi,hcorr⟩ := hCorr a hD
    have hiU : W a i ≤ ∑ j,U a j := by
      have h := single_le_sum (s:=(univ:Finset (Fin 4))) (fun j _ => hU a j) (mem_univ i)
      simpa only [U,ite_eq_left hi] using h
    have hG : (q.gcd (∏ j∈(univ:Finset (Fin 4)).erase i,Nat.dist (a i) (a j)):ℝ)≤W a i := by
      unfold W
      exact_mod_cast natGcd_prod_le_prod_natGcd (NeZero.pos q)
        ((univ:Finset (Fin 4)).erase i) (fun j=>Nat.dist (a i) (a j))
    rw [show D a=0 by simp [D,hd],zero_add]
    exact hcorr.trans (mul_le_mul_of_nonneg_left (hG.trans hiU) hM)
  have hdiag : ∑ a∈S,D a ≤ 3*(q:ℝ)*(B:ℝ)^2 := by
    simp only [D,←sum_filter,sum_const,nsmul_eq_mul]
    have hc : (((S.filter (fun a=>∀ i,¬solitary a i)).card:ℕ):ℝ)≤3*(B:ℝ)^2 := by
      exact_mod_cast no_solitary_card_le B
    nlinarith only [mul_le_mul_of_nonneg_right hc (Nat.cast_nonneg (α:=ℝ) q)]
  have hOff : ∑ a∈S,∑ i,U a i ≤ 4*(B:ℝ)*(2*(B:ℝ)*q.divisors.card)^3 := by
    rw [sum_comm]
    calc
      _ ≤ ∑ _ : Fin 4,(B:ℝ)*(2*(B:ℝ)*q.divisors.card)^3 := by
        apply sum_le_sum
        intro i _
        simpa only [U,←sum_filter] using (solitary_full_gcd_sum_le (NeZero.pos q) B i)
      _ = _ := by simp [nsmul_eq_mul,mul_assoc]
  change (∑ a∈S,‖completeBalancedCorrelation χ (R a)‖) ≤ _
  refine (sum_le_sum (fun a _ => hpnt a)).trans ?_
  rw [sum_add_distrib,←mul_sum]
  exact (add_le_add hdiag (mul_le_mul_of_nonneg_left hOff hM)).trans_eq (by ring)

theorem fourthMoment_le_of_solitary_gcd {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (B : ℕ) {M : ℝ} (hM : 0≤M)
    (hCorr : ∀ a : Fin 4→ℕ, (∃ i,solitary a i) →
      ∃ i, solitary a i ∧ ‖completeBalancedCorrelation χ (fun j=>-((a j+1:ℕ):ℤ))‖ ≤
        M*(q.gcd (∏ j∈(univ:Finset (Fin 4)).erase i,Nat.dist (a i) (a j)):ℝ)) :
    (∑ x : ZMod q, ‖shortSum χ B x‖^4) ≤
      3*(q:ℝ)*(B:ℝ)^2+32*M*(q.divisors.card:ℝ)^3*(B:ℝ)^4 :=
  (fourthMoment_le_sum_balancedCorrelation χ B).trans
    (sum_balancedCorrelation_le_of_solitary_gcd χ B hM hCorr)

end
end GoldbachBurgess
end

