namespace GoldbachCubicRiesz

open Complex Set

private theorem norm_symbol_nonneg_re_le {w : ℂ} (hw : 0 ≤ w.re) (hw₀ : w≠0) :
    ‖symbol w‖ ≤ 1/‖w‖ := by
  have h₁ : (1:ℝ)≤‖w+1‖ := by
    have h := Complex.re_le_norm (w+1)
    simp only [Complex.add_re,Complex.one_re] at h
    linarith only [h,hw]
  have h₂ : (2:ℝ)≤‖w+2‖ := by
    have h := Complex.re_le_norm (w+2)
    norm_num [Complex.add_re] at h
    linarith only [h,hw]
  have h₀ : 0<‖w‖ := norm_pos_iff.mpr hw₀
  have hden : 0<‖w‖*‖w+1‖*‖w+2‖ := by positivity
  simp only [symbol,norm_div,norm_mul,Complex.norm_ofNat]
  apply (div_le_div_iff₀ hden h₀).mpr
  have hmass : (2:ℝ)≤‖w+1‖*‖w+2‖ := by
    calc
      2 = 1*2 := by norm_num
      _ ≤ _ := mul_le_mul h₁ h₂ (by norm_num) (norm_nonneg _)
  have hm := mul_le_mul_of_nonneg_left hmass h₀.le
  nlinarith only [hm]

private theorem norm_cpow_difference_le_log {Y U : ℝ} (hU : 0<U) (hUY : U≤Y)
    {w : ℂ} (hw : 0 ≤ w.re) :
    ‖(Y:ℂ)^w-(U:ℂ)^w‖ ≤ Y^w.re*Real.log (Y/U)*‖w‖ := by
  have hY := hU.trans_le hUY
  let f (x : ℝ) := Complex.exp ((x:ℂ)*w)
  have hf (x : ℝ) : HasDerivAt f (f x*w) x := by
    have h := (Complex.hasDerivAt_exp ((x:ℂ)*w)).comp (x:ℂ)
      ((hasDerivAt_id (x:ℂ)).mul_const w)
    simpa only [f,Function.comp_apply,id_eq,one_mul] using h.comp_ofReal
  have hf_pow (V : ℝ) (hV : 0<V) : f (Real.log V)=(V:ℂ)^w := by
    dsimp only [f]
    rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hV.ne'),← Complex.ofReal_log hV.le]
  have hbound (x : ℝ) (hx : x≤Real.log Y) : ‖f x*w‖≤Y^w.re*‖w‖ := by
    rw [norm_mul,Real.rpow_def_of_pos hY]
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
    simp only [f,Complex.norm_exp,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
    exact Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hx hw)
  have hlog := Real.log_le_log hU hUY
  have hmv := norm_image_sub_le_of_norm_deriv_le_segment' (a:=Real.log U) (b:=Real.log Y)
    (fun x _ => (hf x).hasDerivWithinAt)
    (fun x hx => hbound x hx.2.le) (Real.log Y) (right_mem_Icc.mpr hlog)
  rw [hf_pow Y hY,hf_pow U hU] at hmv
  rw [Real.log_div hY.ne' hU.ne']
  exact hmv.trans_eq (by ring)

set_option maxHeartbeats 600000 in
/-- Triangle inequality and the mean-value estimate give the two useful
bounds for the compact Riesz residue. -/
theorem norm_gramRieszDifference_le {Y U : ℝ} (hU : 1≤U) (hUY : U≤Y)
    {w : ℂ} (hw : 0 ≤ w.re) (hw₀ : w≠0) :
    ‖gramRieszDifference Y U w‖ ≤ Y^w.re*min (Real.log (Y/U)) (2/‖w‖) := by
  have hU₀ : 0<U := zero_lt_one.trans_le hU
  have hY₀ : 0<Y := hU₀.trans_le hUY
  have hY : 1≤Y := hU.trans hUY
  have hnorm : 0<‖w‖ := norm_pos_iff.mpr hw₀
  have hy : 0≤Y^w.re := Real.rpow_nonneg hY₀.le _
  have hs := norm_symbol_nonneg_re_le hw hw₀
  have hlog : 0≤Real.log (Y/U) := Real.log_nonneg ((le_div_iff₀ hU₀).mpr (by simpa using hUY))
  rw [mul_min_of_nonneg _ _ hy,gramRieszDifference,norm_mul]
  apply le_min
  · calc
      _ ≤ (Y^w.re*Real.log (Y/U)*‖w‖)*‖symbol w‖ :=
        mul_le_mul_of_nonneg_right (norm_cpow_difference_le_log hU₀ hUY hw) (norm_nonneg _)
      _ ≤ (Y^w.re*Real.log (Y/U)*‖w‖)*(1/‖w‖) :=
        mul_le_mul_of_nonneg_left hs (mul_nonneg (mul_nonneg hy hlog) hnorm.le)
      _ = _ := by field_simp [hnorm.ne']
  · have hdiff : ‖(Y:ℂ)^w-(U:ℂ)^w‖≤2*Y^w.re := by
      refine (norm_sub_le _ _).trans ?_
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hY₀,Complex.norm_cpow_eq_rpow_re_of_pos hU₀]
      linarith only [Real.rpow_le_rpow hU₀.le hUY hw]
    calc
      _ ≤ (2*Y^w.re)*‖symbol w‖ := mul_le_mul_of_nonneg_right hdiff (norm_nonneg _)
      _ ≤ (2*Y^w.re)*(1/‖w‖) := mul_le_mul_of_nonneg_left hs (mul_nonneg (by norm_num) hy)
      _ = _ := by ring

end GoldbachCubicRiesz

