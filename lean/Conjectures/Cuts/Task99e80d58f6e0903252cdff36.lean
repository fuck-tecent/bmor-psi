/-- The reflected divisor residue is 2, while the dyadic scale supplies the endpoints. -/
theorem shifted_prime_distribution (A : ℝ) (hA : 0 < A) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop, ∀ D P : ℕ,
      (D : ℝ) ≤ (N : ℝ)^(9/20 : ℝ) → (2 : ℕ).Coprime P →
      let u := (2*N-1)/3
      let l := N/3
      (∑ d ∈ (Icc 1 D).filter (fun d => d ∣ P),
        |bvAPMass bvPrimeWeight l u d 2 - ((u : ℝ) - l)/d.totient|) ≤
          C*N/(Real.log N)^A := by
  obtain ⟨M, hM, hBV⟩ := roughFifthBVSubHalf (19/40) A (by norm_num) hA
  have hev := (tendsto_natCast_atTop_atTop (R := ℝ)).eventually hBV
  obtain ⟨T, hT⟩ := eventually_atTop.mp (hev.and roughBV_cutoff_eventually)
  refine ⟨2*M*2^A + 1, by positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (3*T + 20), eventually_bvPrimePower_cost A 1 zero_lt_one]
    with N hNL hcost
  intro D P hD hcop
  dsimp only
  let l := N/3
  let u := (2*N-1)/3
  let G := (Icc 1 D).filter (fun d => d ∣ P)
  let b := fun (x d : ℕ) => |bvAPMass ArithmeticFunction.vonMangoldt 0 x d 2 - (x:ℝ)/d.totient|
  have hlu : l ≤ u := by dsimp [l, u]; omega
  have huN : u ≤ N := by dsimp [u]; omega
  have hNpos : (1 : ℝ) < N := by exact_mod_cast (by omega : 1 < N)
  have hlNp := Real.log_pos hNpos
  have hend (x : ℕ) (hTx : T ≤ x) (h4x : 4 ≤ x) (hNx : N ≤ 4*x) (hxN : x ≤ N) :
      (∑ d ∈ G, b x d) ≤ M*(N:ℝ)*(2^A * (Real.log N)^(-A)) := by
    obtain ⟨hb, hc⟩ := hT x hTx
    apply (roughBV_prefix_bound hcop (hD.trans (hc N hNx))).trans
    apply hb.trans
    exact mul_le_mul (mul_le_mul_of_nonneg_left (by exact_mod_cast hxN) hM.le)
      (roughBV_log_compare h4x hNx (by omega) A hA) (Real.rpow_nonneg
        (Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ x))) _) (by positivity)
  have hl := hend l (by dsimp [l]; omega) (by dsimp [l]; omega)
    (by dsimp [l]; omega) (hlu.trans huN)
  have hu := hend u (by dsimp [u]; omega) (by dsimp [u]; omega)
    (by dsimp [u]; omega) huN
  have hpp : ((G.card : ℝ) * (Chebyshev.psi N - Chebyshev.theta N)) ≤
      (1:ℝ)*N/(Real.log N)^A := by
    apply le_trans _ (hcost D hD)
    apply mul_le_mul_of_nonneg_right _ (sub_nonneg.mpr (Chebyshev.theta_le_psi _))
    exact_mod_cast ((card_le_card (filter_subset _ _)).trans_eq
      (by simp [Nat.card_Icc] : (Icc 1 D).card = D) : G.card ≤ D)
  have hs := sum_le_sum (s := G) (fun d _ => bvAPMass_prime_error_from_prefix hlu huN d 2
    (fun x => (x : ℝ)/d.totient))
  simp only [sum_add_distrib, sum_const, nsmul_eq_mul, ← sub_div] at hs
  change (∑ d ∈ G, |bvAPMass bvPrimeWeight l u d 2 - ((u:ℝ)-l)/d.totient|) ≤ _
  refine hs.trans ((add_le_add (add_le_add hu hl) hpp).trans_eq ?_)
  rw [Real.rpow_neg hlNp.le]
  ring

theorem shifted_rem_bv {N : ℕ} (hN : 12 ≤ N) (he : Even N) (d : ℕ) :
    (shiftSieve N he).rem d =
      bvAPMass bvPrimeWeight (N/3) ((2*N-1)/3) d 2 -
        ((((2*N-1)/3 : ℕ):ℝ) - ((N/3 : ℕ):ℝ))/d.totient := by
  rw [BoundingSieve.rem, shifted_multSum_bv hN he]
  change _ - ((d.totient:ℝ))⁻¹ * ((((2*N-1)/3 : ℕ):ℝ) - ((N/3 : ℕ):ℝ)) = _
  rw [div_eq_mul_inv]
  ring


end ReverseRoughSieve

