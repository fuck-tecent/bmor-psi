theorem V1om (X b T:ℝ) (hX:0<X) (hb:1<b) (hT:0<T)
    (hheight:∀z∈V59,|z.im|≠T) :
    V9 (fun z=> -logDeriv riemannZeta z*Vf X z)
      (-(1/2:ℝ)) b (-T) T =
    -(2*(Real.pi:ℂ)*I)*(logDeriv riemannZeta 0-(X:ℂ)/2+
