namespace ShortAP
open ShortAPLargeValues
open scoped Classical
noncomputable section

abbrev CharIndex := Σ q : ℕ, DirichletCharacter ℂ q
def primitiveFamily (Q : ℕ) : Finset CharIndex := (Finset.Icc 1 Q).sigma primitiveChars
def charValue (j : CharIndex) (n : ℕ) : ℂ := j.2 (n : ZMod j.1)

private theorem primitive_mean_input (N Q : ℕ) (T : ℝ) (hQ : 1 ≤ Q) (hT : 1 ≤ T) :
    ContinuousMeanSquare (primitiveFamily Q) charValue N T
      ((8*Real.pi)*(Real.pi+1)*((Q:ℝ)^2*(T+1/2)+N)) := by
  intro c
  have h := hybrid_character_mean_square N Q (T+1/2) hQ (by linarith) c
  have hp (j : CharIndex) (t : ℝ) :
      poly N c (charValue j) t = ∑ n ∈ Finset.Icc 1 N,
        c n * j.2 (n : ZMod j.1) / (n : ℂ)^((t:ℂ)*Complex.I) := by
    unfold poly
    apply Finset.sum_congr rfl
    intro n hn
    have hn0 : (n : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
    rw [Complex.cpow_def_of_ne_zero hn0, div_eq_mul_inv, ← Complex.exp_neg]
    unfold freq charValue
    rw [Complex.natCast_log]
    congr 2
    ring
  simp_rw [hp]
  simpa only [primitiveFamily, Finset.sum_sigma, neg_add_rev, add_comm (-(1/2:ℝ)) (-T),
    sub_eq_add_neg] using h

/-- First large-value case of Lemma 3.2, with a coefficient budget
and an explicit constant. The second (Huxley) case is not assumed. -/
theorem primitive_large_values_first (N Q : ℕ) (hN : 1 ≤ N) (hQ : 1 ≤ Q)
    (T U : ℝ) (hT : 1 ≤ T) (hU : 0 < U)
    (m : ℕ) (r : ℝ) (hr : 0 ≤ r) (a : ℕ → ℂ)
    (ha : ∀ n ∈ Finset.Icc 1 N, ‖a n‖ ≤ ((ArithmeticFunction.zeta^m) n : ℝ)*(Real.log n)^r)
    (S : CharIndex → Finset ℝ) (hsep : WellSpaced S)
    (hb : ∀ j ∈ primitiveFamily Q, ∀ t ∈ S j, |t| ≤ T)
    (hv : ∀ j ∈ primitiveFamily Q, ∀ t ∈ S j, U ≤
      ‖∑ n ∈ Finset.Icc 1 N, a n * charValue j n / (n:ℂ)^(1/2+(t:ℂ)*Complex.I)‖) :
    (∑ j ∈ primitiveFamily Q, ((S j).card : ℝ)) ≤
      36*Real.pi*(Real.pi+1) * ((N:ℝ)+(Q:ℝ)^2*T) *
        Real.log (2*(N:ℝ)) * ((Real.log N)^r)^2 * (1+Real.log N)^(m*m) / U^2 := by
  let C := (8*Real.pi)*(Real.pi+1)*((Q:ℝ)^2*(T+1/2)+N)
  have hT0 : 0 ≤ T := by linarith
  have hN1 : 1 ≤ (N:ℝ) := by exact_mod_cast hN
  have hlog : 0 ≤ Real.log (2*(N:ℝ)) := Real.log_nonneg (by linarith)
  have hC : 0 ≤ C := by dsimp [C]; positivity
  have h := critical_large_values_card_le (primitiveFamily Q) charValue S hN a hT0 hC hU
    (primitive_mean_input N Q T hQ hT) hsep hb hv
  have he := ShortAPDivisor.critical_divisor_energy N m r hr a ha
  have hbase : (Q:ℝ)^2*(T+1/2)+N ≤ (3/2)*((N:ℝ)+(Q:ℝ)^2*T) := by
    nlinarith [mul_nonneg (sq_nonneg (Q:ℝ)) (sub_nonneg.mpr hT), Nat.cast_nonneg (α := ℝ) N]
  have hbound : C ≤ 12*Real.pi*(Real.pi+1)*((N:ℝ)+(Q:ℝ)^2*T) := by
    calc C ≤ (8*Real.pi)*(Real.pi+1)*((3/2)*((N:ℝ)+(Q:ℝ)^2*T)) :=
               mul_le_mul_of_nonneg_left hbase (by positivity)
         _ = _ := by ring
  refine h.trans (div_le_div_of_nonneg_right ?_ (sq_nonneg _))
  have hE : 0 ≤ ∑ n ∈ Finset.Icc 1 N, ‖a n‖^2/(n:ℝ) :=
    Finset.sum_nonneg fun n _ => div_nonneg (sq_nonneg _) (Nat.cast_nonneg n)
  have hR := mul_le_mul (mul_le_mul_of_nonneg_left hbound (show 0 ≤ 3*Real.log (2*(N:ℝ)) by positivity))
    he hE (by positivity)
  exact hR.trans_eq (by ring)

/-- Replace the direct logarithmic budget by the power used in the paper.
Keeping 1 + log(2N) until the last step also covers N = 1. -/
theorem first_log_budget (N m : ℕ) (hN : 1 ≤ N) (r : ℝ) (hr : 0 ≤ r) :
    Real.log (2*(N:ℝ)) * ((Real.log N)^r)^2 * (1+Real.log N)^(m*m) ≤
    3^(3*((m*m:ℕ):ℝ)+6*r+18) *
      (Real.log (2*(N:ℝ)))^(3*((m*m:ℕ):ℝ)+6*r+18) := by
  let x := Real.log (2*(N:ℝ))
  let L := 1+x
  let A := 3*((m*m:ℕ):ℝ)+6*r+18
  have hN1 : 1 ≤ (N:ℝ) := by exact_mod_cast hN
  have hN0 : 0 < (N:ℝ) := by linarith
  have hlog : 0 ≤ Real.log (N:ℝ) := Real.log_nonneg hN1
  have hcmp : Real.log (N:ℝ) ≤ x := Real.log_le_log hN0 (by linarith)
  have hx : 0 ≤ x := hlog.trans hcmp
  have hL : 1 ≤ L := by dsimp [L]; linarith
  have hL0 : 0 < L := by linarith
  have hxL : x ≤ L := by dsimp [L]; linarith
  have hex : 1+2*r+(m*m:ℕ) ≤ A := by dsimp [A]; linarith [Nat.cast_nonneg (α := ℝ) (m*m)]
  have hA : 0 ≤ A := by dsimp [A]; positivity
  calc
    _ ≤ L * (L^r)^2 * L^(m*m) := by
      apply mul_le_mul _ (pow_le_pow_left₀ (by linarith : 0 ≤ 1+Real.log N)
        (by dsimp [L]; linarith) _) (by positivity) (by positivity)
      exact mul_le_mul hxL (pow_le_pow_left₀ (Real.rpow_nonneg hlog r)
        (Real.rpow_le_rpow hlog (hcmp.trans hxL) hr) 2) (sq_nonneg _) hL0.le
    _ = L^(1+2*r+(m*m:ℕ) : ℝ) := by
      rw [Real.rpow_add hL0, Real.rpow_add hL0, Real.rpow_one, Real.rpow_natCast,
        mul_comm (2:ℝ) r, Real.rpow_mul hL0.le, Real.rpow_two]
    _ ≤ L^A := Real.rpow_le_rpow_of_exponent_le hL hex
    _ ≤ (3*x)^A := Real.rpow_le_rpow hL0.le (sampling_loss_le_three_log hN) hA
    _ = _ := Real.mul_rpow (by norm_num) hx

/-- First term in the minimum of Lemma 3.2, in the bounded frequency band
used by Section 4. The constant multiplying the paper's logarithm depends
only on m and r. -/
theorem large_values_first_branch (N Q : ℕ) (hN : 1 ≤ N) (hQ : 1 ≤ Q)
    (T U : ℝ) (hT : 1 ≤ T) (hU : 1 ≤ U) (m : ℕ) (r : ℝ) (hr : 0 ≤ r)
    (a : ℕ → ℂ)
    (ha : ∀ n ∈ Finset.Icc 1 N, ‖a n‖ ≤ ((ArithmeticFunction.zeta^m) n : ℝ)*(Real.log n)^r)
    (S : CharIndex → Finset ℝ) (hsep : WellSpaced S)
    (hb : ∀ j ∈ primitiveFamily Q, ∀ t ∈ S j, |t| ≤ T)
    (hv : ∀ j ∈ primitiveFamily Q, ∀ t ∈ S j, U ≤
      ‖∑ n ∈ Finset.Icc 1 N, a n * charValue j n / (n:ℂ)^(1/2+(t:ℂ)*Complex.I)‖) :
    let A := 3*((m*m:ℕ):ℝ)+6*r+18
    (∑ j ∈ primitiveFamily Q, ((S j).card : ℝ)) ≤
      (36*Real.pi*(Real.pi+1)*3^A) * (((N:ℝ)+(Q:ℝ)^2*T)/U^2) * (Real.log (2*(N:ℝ)))^A := by
  dsimp only
  have h := primitive_large_values_first N Q hN hQ T U hT (by linarith) m r hr a ha S hsep hb hv
  have hw := first_log_budget N m hN r hr
  have hT0 : 0 ≤ T := by linarith
  have k : 0 ≤ 36*Real.pi*(Real.pi+1)*((N:ℝ)+(Q:ℝ)^2*T) := by positivity
  have hbnd := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hw k) (sq_nonneg U)
  apply h.trans
  convert hbnd using 1 <;> ring

/-- Off the region H > N and U^4 > N the first case already gives
the minimum up to an absolute factor of two. This does not use Huxley's estimate. -/
theorem first_le_two_min {N H U : ℝ} (hN : 0 ≤ N) (hH : 0 ≤ H) (hU : 0 < U)
    (hreg : U^4 ≤ N ∨ H ≤ N) :
    (N+H)/U^2 ≤ 2 * min ((N+H)/U^2) (N/U^2+N*H/U^6) := by
  have hfirst : 0 ≤ (N+H)/U^2 := by positivity
  have hsecond : 0 ≤ N/U^2 + N*H/U^6 := by positivity
  have hx : (N+H)/U^2 ≤ 2*(N/U^2+N*H/U^6) := by
    rcases hreg with hsmall | hshort
    · have hh : H/U^2 ≤ N*H/U^6 := by
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
        calc H*U^6 = (U^4*H)*U^2 := by ring
             _ ≤ (N*H)*U^2 := by gcongr
      rw [add_div]
      linarith
    · have hh := div_le_div_of_nonneg_right hshort (sq_nonneg U)
      rw [add_div]
      linarith [show 0 ≤ N*H/U^6 by positivity]
  rcases le_total ((N+H)/U^2) (N/U^2+N*H/U^6) with h | h
  · rw [min_eq_left h]; linarith
  · rwa [min_eq_right h]

theorem large_values_easy_region (N Q : ℕ) (hN : 1 ≤ N) (hQ : 1 ≤ Q)
    (T U : ℝ) (hT : 1 ≤ T) (hU : 1 ≤ U) (m : ℕ) (r : ℝ) (hr : 0 ≤ r)
    (a : ℕ → ℂ)
    (ha : ∀ n ∈ Finset.Icc 1 N, ‖a n‖ ≤ ((ArithmeticFunction.zeta^m) n : ℝ)*(Real.log n)^r)
    (S : CharIndex → Finset ℝ) (hsep : WellSpaced S)
    (hb : ∀ j ∈ primitiveFamily Q, ∀ t ∈ S j, |t| ≤ T)
    (hv : ∀ j ∈ primitiveFamily Q, ∀ t ∈ S j, U ≤
      ‖∑ n ∈ Finset.Icc 1 N, a n * charValue j n / (n:ℂ)^(1/2+(t:ℂ)*Complex.I)‖)
    (hreg : U^4 ≤ (N:ℝ) ∨ (Q:ℝ)^2*T ≤ N) :
    let A := 3*((m*m:ℕ):ℝ)+6*r+18
    let H := (Q:ℝ)^2*T
    (∑ j ∈ primitiveFamily Q, ((S j).card : ℝ)) ≤
      (72*Real.pi*(Real.pi+1)*3^A) *
        min (((N:ℝ)+H)/U^2) ((N:ℝ)/U^2+N*H/U^6) * (Real.log (2*(N:ℝ)))^A := by
  dsimp only
  have h := large_values_first_branch N Q hN hQ T U hT hU m r hr a ha S hsep hb hv
  have hT0 : 0 ≤ T := by linarith
  have hN1 : 1 ≤ (N:ℝ) := by exact_mod_cast hN
  have hlog : 0 ≤ Real.log (2*(N:ℝ)) := Real.log_nonneg (by linarith)
  have hmin := first_le_two_min (Nat.cast_nonneg N) (by positivity : 0 ≤ (Q:ℝ)^2*T)
    (lt_of_lt_of_le zero_lt_one hU) hreg
  let A := 3*((m*m:ℕ):ℝ)+6*r+18
  have hmul := mul_le_mul_of_nonneg_right
    (mul_le_mul_of_nonneg_left hmin (show 0 ≤ 36*Real.pi*(Real.pi+1)*(3:ℝ)^A by positivity))
    (Real.rpow_nonneg hlog A)
  exact h.trans (hmul.trans_eq (by dsimp [A]; ring))

end
end ShortAP

end

/-! ## Finite identities and analytic reductions for the high-exponent branch. -/

section

/-!
# Finite Heath--Brown identity

The coefficient identity at the start of §4 of D. Koukoulopoulos,
*Primes in short arithmetic progressions* (arXiv:1405.6592), before any dyadic
or smooth splitting. A term indexed by `j` below has `2 * (j + 1)` factors.

The truncation convention agrees with `truncateArithmetic` in the local
`goldbach-short-progressions/lean/Conjectures/Goldbach/B13BilateralVaughanReduction.lean`.
-/

open Finset ArithmeticFunction
open scoped BigOperators ArithmeticFunction.Moebius ArithmeticFunction.zeta

namespace ShortAPHeathBrown

noncomputable section


/-- Truncate the coefficients of an arithmetic function to `n ≤ H`. -/
def truncate (f : (ArithmeticFunction ℝ)) (H : ℕ) : (ArithmeticFunction ℝ) := ⟨fun n => if n ≤ H then f n else 0, by simp⟩

@[simp]
theorem truncate_apply (f : (ArithmeticFunction ℝ)) (H n : ℕ) : truncate f H n = if n ≤ H then f n else 0 :=
  rfl

private theorem convolution_vanishes_below {f g : (ArithmeticFunction ℝ)} {a b : ℕ}
    (hf : ∀ n < a, f n = 0) (hg : ∀ n < b, g n = 0) :
    ∀ n < a * b, (f * g) n = 0 := by
  intro n hn
  rw [ArithmeticFunction.mul_apply]
  apply Finset.sum_eq_zero
  intro p hp
  have hp' := (Nat.mem_divisorsAntidiagonal.mp hp).1
  by_cases ha : p.1 < a
  · rw [hf _ ha, zero_mul]
  · have hb : p.2 < b := by
      by_contra! h
      exact (not_le_of_gt hn) (hp' ▸ Nat.mul_le_mul (Nat.le_of_not_gt ha) h)
    rw [hg _ hb, mul_zero]

private theorem power_vanishes_below {f : (ArithmeticFunction ℝ)} {a : ℕ} (hf : ∀ n < a, f n = 0) (k : ℕ) :
    ∀ n < a ^ k, (f ^ k) n = 0 := by
  induction k with
  | zero =>
      intro n hn
      have hn' : n = 0 := by simpa using hn
      simp [hn']
  | succ k ih => simpa only [pow_succ] using convolution_vanishes_below ih hf

/-- The truncated Möbius series inverts zeta below the first discarded index.
After taking `k` convolution powers the cutoff becomes `(H + 1)^k`. -/
theorem heathBrown_remainder_vanishes (H k n : ℕ) (hn : n < (H + 1) ^ k) :
    (Λ * (1 - truncate (μ : ArithmeticFunction ℝ) H * (ζ : ArithmeticFunction ℝ)) ^ k) n = 0 := by
  have hinv : (μ : ArithmeticFunction ℝ) * (ζ : ArithmeticFunction ℝ) = 1 := ArithmeticFunction.coe_moebius_mul_coe_zeta
  have heq : 1 - truncate (μ : ArithmeticFunction ℝ) H * (ζ : ArithmeticFunction ℝ) = ((μ : ArithmeticFunction ℝ) - truncate (μ : ArithmeticFunction ℝ) H) * (ζ : ArithmeticFunction ℝ) := by
    rw [sub_mul, hinv]
  have hcut : ∀ m < H + 1, ((μ : ArithmeticFunction ℝ) - truncate (μ : ArithmeticFunction ℝ) H) m = 0 := by
    intro m hm
    change (μ : ArithmeticFunction ℝ) m - truncate (μ : ArithmeticFunction ℝ) H m = 0
    simp [Nat.le_of_lt_succ hm]
  have hbase (f : (ArithmeticFunction ℝ)) : ∀ m < 1, f m = 0 := by
    intro m hm
    have hm' : m = 0 := by omega
    simp [hm']
  have herror : ∀ m < H + 1, (1 - truncate (μ : ArithmeticFunction ℝ) H * (ζ : ArithmeticFunction ℝ) : (ArithmeticFunction ℝ)) m = 0 := by
    rw [heq]
    simpa only [mul_one] using convolution_vanishes_below hcut (hbase (ζ : ArithmeticFunction ℝ))
  exact convolution_vanishes_below (hbase Λ) (power_vanishes_below herror k)
    n (by simpa using hn)

/-- The convolution product for the `(j+1)`-st term. -/
def block (H j : ℕ) : (ArithmeticFunction ℝ) := ArithmeticFunction.log * (ζ : ArithmeticFunction ℝ) ^ j * (truncate (μ : ArithmeticFunction ℝ) H) ^ (j + 1)

private theorem alternating_expansion (F : (ArithmeticFunction ℝ)) (k : ℕ) :
    1 - (1 - F) ^ k =
      ∑ j ∈ Finset.range k, ((-1 : (ArithmeticFunction ℝ)) ^ j * (k.choose (j + 1) : (ArithmeticFunction ℝ))) * F ^ (j + 1) := by
  rw [sub_eq_add_neg 1 F, add_comm 1 (-F), add_pow, Finset.sum_range_succ']
  simp only [one_pow, mul_one, pow_zero, Nat.choose_zero_right, Nat.cast_one]
  rw [show 1 - ((∑ j ∈ Finset.range k, (-F) ^ (j + 1) * (k.choose (j + 1) : (ArithmeticFunction ℝ))) + 1) =
      -(∑ j ∈ Finset.range k, (-F) ^ (j + 1) * (k.choose (j + 1) : (ArithmeticFunction ℝ))) by abel,
    ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro j _
  rw [neg_pow F (j + 1), pow_succ (-1 : (ArithmeticFunction ℝ)) j]
  ring

private theorem eval_sum {ι : Type*} (S : Finset ι) (f : ι → (ArithmeticFunction ℝ)) (n : ℕ) :
    (∑ i ∈ S, f i) n = ∑ i ∈ S, f i n := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert i S hi ih => simp [Finset.sum_insert hi, ih]

private theorem coefficient_apply (k j : ℕ) (f : (ArithmeticFunction ℝ)) (n : ℕ) :
    (((-1 : (ArithmeticFunction ℝ)) ^ j * (k.choose (j + 1) : (ArithmeticFunction ℝ))) * f) n =
      ((-1 : ℝ) ^ j * (k.choose (j + 1) : ℝ)) * f n := by
  have hcast (z : ℤ) (f : (ArithmeticFunction ℝ)) : ((z : (ArithmeticFunction ℝ)) * f) n = (z : ℝ) * f n := by
    rw [← zsmul_eq_mul, ← zsmul_eq_mul]
    rfl
  calc
    _ = (((( (-1 : ℤ) ^ j * (k.choose (j + 1) : ℤ)) : ℤ) : (ArithmeticFunction ℝ)) * f) n := by
      push_cast
      rfl
    _ = _ := by
      rw [hcast]
      push_cast
      rfl

/-- Heath--Brown's finite identity, valid at every `n < (H + 1)^k`, including
`n ≤ H^k` for `k > 0`. The untruncated factors are `log` and `j` copies of zeta. -/
theorem heathBrown_apply (H k n : ℕ) (hn : n < (H + 1) ^ k) :
    Λ n = ∑ j ∈ Finset.range k,
      ((-1 : ℝ) ^ j * (k.choose (j + 1) : ℝ)) * block H j n := by
  let F : (ArithmeticFunction ℝ) := truncate (μ : ArithmeticFunction ℝ) H * (ζ : ArithmeticFunction ℝ)
  have hzero : (Λ * (1 - F) ^ k) n = 0 := heathBrown_remainder_vanishes H k n hn
  have hfinite : Λ n = (Λ * (1 - (1 - F) ^ k)) n := by
    rw [mul_sub, mul_one]
    change Λ n = Λ n - (Λ * (1 - F) ^ k) n
    rw [hzero, sub_zero]
  rw [hfinite, alternating_expansion, Finset.mul_sum, eval_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [show Λ * (((-1 : (ArithmeticFunction ℝ)) ^ j * (k.choose (j + 1) : (ArithmeticFunction ℝ))) * F ^ (j + 1)) =
      ((-1 : (ArithmeticFunction ℝ)) ^ j * (k.choose (j + 1) : (ArithmeticFunction ℝ))) * (Λ * F ^ (j + 1)) by ring,
    coefficient_apply]
  have hblock : Λ * F ^ (j + 1) = block H j := by
    calc
      _ = (Λ * (ζ : ArithmeticFunction ℝ)) * (ζ : ArithmeticFunction ℝ) ^ j * (truncate (μ : ArithmeticFunction ℝ) H) ^ (j + 1) := by
        dsimp only [F]
        rw [mul_pow, pow_succ' (ζ : ArithmeticFunction ℝ)]
        ring
      _ = _ := by rw [ArithmeticFunction.vonMangoldt_mul_zeta]; rfl
  rw [hblock]

/-- The zero-based factor list before inserting smooth or dyadic cutoffs. -/
def factor (H j i : ℕ) : (ArithmeticFunction ℝ) := if i = 0 then ArithmeticFunction.log else if i < j + 1 then (ζ : ArithmeticFunction ℝ) else truncate (μ : ArithmeticFunction ℝ) H

/-- Exactly `j+1` non-Möbius factors followed by `j+1` truncated Möbius factors. -/
theorem block_eq_prod (H j : ℕ) :
    block H j = ∏ i ∈ Finset.range (2 * (j + 1)), factor H j i := by
  rw [two_mul, Finset.prod_range_add, Finset.prod_range_succ' (factor H j)]
  have hfirst : (∏ i ∈ Finset.range j, factor H j (i + 1)) = (ζ : ArithmeticFunction ℝ) ^ j := by
    calc
      _ = ∏ _i ∈ Finset.range j, (ζ : ArithmeticFunction ℝ) := by
        apply Finset.prod_congr rfl
        intro i hi
        have hil : i + 1 < j + 1 := Nat.succ_lt_succ (Finset.mem_range.mp hi)
        simp [factor, hil]
      _ = _ := by simp
  have hsecond : (∏ i ∈ Finset.range (j + 1), factor H j (j + 1 + i)) =
      (truncate (μ : ArithmeticFunction ℝ) H) ^ (j + 1) := by
    calc
      _ = ∏ _i ∈ Finset.range (j + 1), truncate (μ : ArithmeticFunction ℝ) H := by
        apply Finset.prod_congr rfl
        intro i _
        simp [factor, show ¬ (j + 1 + i < j + 1) by omega]
      _ = _ := by simp
  rw [hfirst, hsecond]
  simp [block, factor, mul_comm]

/-- Apply the coefficient formula to any finite collection of terms with a complex
weight. In particular the weight may be a Dirichlet character. -/
theorem heathBrown_weighted_sum (H k : ℕ) (S : Finset ℕ) (w : ℕ → ℂ)
    (hS : ∀ n ∈ S, n < (H + 1) ^ k) :
    (∑ n ∈ S, (Λ n : ℂ) * w n) =
      ∑ j ∈ Finset.range k, ((-1 : ℂ) ^ j * (k.choose (j + 1) : ℂ)) *
        ∑ n ∈ S, (block H j n : ℂ) * w n := by
  calc
    _ = ∑ n ∈ S, ∑ j ∈ Finset.range k,
        ((-1 : ℂ) ^ j * (k.choose (j + 1) : ℂ)) * (block H j n : ℂ) * w n := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [heathBrown_apply H k n (hS n hn)]
      push_cast
      rw [Finset.sum_mul]
    _ = _ := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j _
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun _ _ => mul_assoc _ _ _

/-- The cutoff in the paper is the floor of the real `k`-th root of the
coefficient range. -/
def rangeCutoff (X : ℝ) (k : ℕ) : ℕ := ⌊X ^ (1 / (k : ℝ))⌋₊

theorem lt_rangeCutoff_power {X : ℝ} (hX : 0 ≤ X) {k n : ℕ} (hk : 0 < k) (hn : (n : ℝ) ≤ X) :
    n < (rangeCutoff X k + 1) ^ k := by
  have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
  have hroot : (X ^ (1 / (k : ℝ))) ^ k = X := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hX, one_div_mul_cancel hk', Real.rpow_one]
  have hf : X ^ (1 / (k : ℝ)) < (rangeCutoff X k : ℝ) + 1 := Nat.lt_floor_add_one _
  have hlt := pow_lt_pow_left₀ hf (Real.rpow_nonneg hX _) hk.ne'
  rw [hroot] at hlt
  exact_mod_cast hn.trans_lt hlt

/-- Coefficient form with the precise real root cutoff on the window `n ≤ X`. -/
theorem heathBrown_on_real_range {X : ℝ} (hX : 0 ≤ X) {k n : ℕ} (hk : 0 < k) (hn : (n : ℝ) ≤ X) :
    Λ n = ∑ j ∈ Finset.range k,
      ((-1 : ℝ) ^ j * (k.choose (j + 1) : ℝ)) *
        (∏ i ∈ Finset.range (2 * (j + 1)), factor (rangeCutoff X k) j i) n := by
  simp_rw [← block_eq_prod]
  exact heathBrown_apply _ _ _ (lt_rangeCutoff_power hX hk hn)

/-- A real interval `(y, z]` as a finite set of nonnegative integers. -/
def shortWindow (y z : ℝ) : Finset ℕ :=
  (Finset.range (⌊z⌋₊ + 1)).filter (fun n => y < (n : ℝ) ∧ (n : ℝ) ≤ z)

@[simp]
theorem mem_shortWindow {y z : ℝ} {n : ℕ} :
    n ∈ shortWindow y z ↔ y < (n : ℝ) ∧ (n : ℝ) ≤ z := by
  constructor
  · intro h
    exact (Finset.mem_filter.mp h).2
  · intro h
    have hz : 0 ≤ z := (Nat.cast_nonneg n).trans h.2
    exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_of_le ((Nat.le_floor_iff hz).2 h.2)), h⟩

/-- The character-twisted finite short-interval identity, with `X = 4*x`
in the application. The upper interval endpoint `z` must satisfy `z ≤ X`. -/
theorem heathBrown_short_window {X y z : ℝ} (hX : 0 ≤ X) (hz : z ≤ X)
    {k q : ℕ} (hk : 0 < k) (χ : DirichletCharacter ℂ q) :
    (∑ n ∈ shortWindow y z, (Λ n : ℂ) * χ (n : ZMod q)) =
      ∑ j ∈ Finset.range k, ((-1 : ℂ) ^ j * (k.choose (j + 1) : ℂ)) *
        ∑ n ∈ shortWindow y z,
          ((∏ i ∈ Finset.range (2 * (j + 1)), factor (rangeCutoff X k) j i) n : ℂ) *
            χ (n : ZMod q) := by
  simp_rw [← block_eq_prod]
  apply heathBrown_weighted_sum
  intro n hn
  exact lt_rangeCutoff_power hX hk ((mem_shortWindow.mp hn).2.trans hz)

private theorem convolution_pointwise_congr {X n : ℕ} {a b c d : (ArithmeticFunction ℝ)}
    (ha : ∀ m ≤ X, a m = c m) (hb : ∀ m ≤ X, b m = d m) (hn : n ≤ X) :
    (a * b) n = (c * d) n := by
  simp only [ArithmeticFunction.mul_apply]
  apply Finset.sum_congr rfl
  intro p hp
  obtain ⟨hp', hn0⟩ := Nat.mem_divisorsAntidiagonal.mp hp
  have h1 : p.1 ∣ n := ⟨p.2, hp'.symm⟩
  have h2 : p.2 ∣ n := ⟨p.1, by simpa only [mul_comm] using hp'.symm⟩
  rw [ha _ ((Nat.le_of_dvd (Nat.pos_of_ne_zero hn0) h1).trans hn),
    hb _ ((Nat.le_of_dvd (Nat.pos_of_ne_zero hn0) h2).trans hn)]

private theorem product_pointwise_congr {ι : Type*} (S : Finset ι) {X : ℕ} {a b : ι → (ArithmeticFunction ℝ)}
    (h : ∀ i ∈ S, ∀ n ≤ X, a i n = b i n) :
    ∀ n ≤ X, (∏ i ∈ S, a i) n = (∏ i ∈ S, b i) n := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert i S hi ih =>
      intro n hn
      simp only [Finset.prod_insert hi]
      exact convolution_pointwise_congr (h i (Finset.mem_insert_self i S))
        (ih fun t ht => h t (Finset.mem_insert_of_mem ht)) hn

/-- Finite localization of a convolution block. Only a partition on coefficients
up to `X` is required. This identity does not assert that a smooth dyadic
partition exists or bound the number of resulting boxes. -/
theorem block_apply_eq_sum_boxes {ι : Type*} (H j X n : ℕ) (hn : n ≤ X)
    (boxes : ℕ → Finset ι) (piece : ℕ → ι → (ArithmeticFunction ℝ))
    (hpiece : ∀ i ∈ Finset.range (2 * (j + 1)), ∀ m ≤ X,
      factor H j i m = (∑ b ∈ boxes i, piece i b) m) :
    let S := Finset.range (2 * (j + 1))
    block H j n = ∑ b ∈ S.pi boxes, (∏ i ∈ S.attach, piece i.1 (b i.1 i.2)) n := by
  dsimp only
  rw [block_eq_prod, product_pointwise_congr _ hpiece n hn, Finset.prod_sum, eval_sum]

end
end ShortAPHeathBrown

end

section

/-!
# Dyadic partitions for finite convolution blocks

This supplies the partition of unity in §4 of D. Koukoulopoulos,
*Primes in short arithmetic progressions* (arXiv:1405.6592), using the
telescoping difference of a smooth step and its dilation by two. It also
supplies the sharp dyadic intervals for the truncated Möbius factors.
-/

open Finset Set ArithmeticFunction
open scoped BigOperators ContDiff

namespace ShortAPDyadicPartition

noncomputable section

/-- Zero on `u ≤ 1` and one on `u ≥ 2`. -/
def smoothStep (u : ℝ) : ℝ := Real.smoothTransition (u - 1)

theorem smoothStep_zero {u : ℝ} (hu : u ≤ 1) : smoothStep u = 0 :=
  Real.smoothTransition.zero_of_nonpos (sub_nonpos.mpr hu)

theorem smoothStep_one {u : ℝ} (hu : 2 ≤ u) : smoothStep u = 1 :=
  Real.smoothTransition.one_of_one_le (by linarith)

theorem contDiff_smoothStep : ContDiff ℝ ∞ smoothStep := by
  exact Real.smoothTransition.contDiff.comp (contDiff_id.sub contDiff_const)

/-- The dilation difference used as the smooth dyadic weight. -/
def smoothWeight (u : ℝ) : ℝ := smoothStep u - smoothStep (u / 2)

theorem contDiff_smoothWeight : ContDiff ℝ ∞ smoothWeight :=
  contDiff_smoothStep.sub (contDiff_smoothStep.comp (contDiff_id.div_const 2))

theorem smoothWeight_zero_below {u : ℝ} (hu : u ≤ 1) : smoothWeight u = 0 := by
  rw [smoothWeight, smoothStep_zero hu, smoothStep_zero (show u / 2 ≤ 1 by linarith), sub_self]

theorem smoothWeight_zero_above {u : ℝ} (hu : 4 ≤ u) : smoothWeight u = 0 := by
  rw [smoothWeight, smoothStep_one (show 2 ≤ u by linarith),
    smoothStep_one (show 2 ≤ u / 2 by linarith), sub_self]

theorem smoothWeight_nonneg (u : ℝ) : 0 ≤ smoothWeight u := by
  by_cases hu : 0 ≤ u
  · exact sub_nonneg.mpr (Real.smoothTransition.monotone (show u / 2 - 1 ≤ u - 1 by linarith))
  · rw [smoothWeight_zero_below (show u ≤ 1 by linarith)]

theorem smoothWeight_le_one (u : ℝ) : smoothWeight u ≤ 1 := by
  exact (sub_le_self _ (Real.smoothTransition.nonneg (u / 2 - 1))).trans
    (Real.smoothTransition.le_one (u - 1))

theorem support_smoothWeight : Function.support smoothWeight ⊆ Set.Ioo 1 4 := by
  intro u hu
  exact ⟨lt_of_not_ge (fun h => hu (smoothWeight_zero_below h)),
    lt_of_not_ge (fun h => hu (smoothWeight_zero_above h))⟩

theorem tsupport_smoothWeight : tsupport smoothWeight ⊆ Set.Icc 1 4 :=
  closure_minimal (support_smoothWeight.trans Set.Ioo_subset_Icc_self) isClosed_Icc

theorem hasCompactSupport_smoothWeight : HasCompactSupport smoothWeight :=
  isCompact_Icc.of_isClosed_subset (isClosed_tsupport _) tsupport_smoothWeight

private def sharpStep (u : ℝ) : ℝ := if 1 < u then 1 else 0

/-- The exact indicator of the paper's half-open dyadic interval. -/
def sharpWeight (u : ℝ) : ℝ := if 1 < u ∧ u ≤ 2 then 1 else 0

private theorem sharpWeight_eq_step_sub (u : ℝ) :
    sharpWeight u = sharpStep u - sharpStep (u / 2) := by
  unfold sharpWeight sharpStep
  rcases le_or_gt u 1 with h | h
  · simp [not_lt.mpr h, show ¬ 1 < u / 2 by linarith]
  · rcases le_or_gt u 2 with h' | h'
    · simp [h, h', show ¬ 1 < u / 2 by linarith]
    · simp [h, not_le.mpr h', show 1 < u / 2 by linarith]

/-- Scales `1/2, 1, 2, 4, …`. The half scale is needed to cover `n = 1`. -/
def scale (i : ℕ) : ℝ := (2 : ℝ) ^ i / 2

theorem scale_pos (i : ℕ) : 0 < scale i := by unfold scale; positivity

theorem one_half_le_scale (i : ℕ) : 1 / 2 ≤ scale i := by
  exact div_le_div_of_nonneg_right (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)) (by norm_num)

theorem scale_succ (i : ℕ) : scale (i + 1) = scale i * 2 := by
  unfold scale
  rw [pow_succ]
  ring

private theorem scaled_succ (x : ℝ) (i : ℕ) : x / scale (i + 1) = (x / scale i) / 2 := by
  rw [scale_succ, div_div]

/-- This finite family suffices simultaneously for every coefficient `1 ≤ n ≤ X`. -/
def indices (X : ℕ) : Finset ℕ := Finset.range (Nat.log 2 X + 2)

@[simp] theorem card_indices (X : ℕ) : (indices X).card = Nat.log 2 X + 2 := by
  simp [indices]

theorem scale_le_cutoff {X i : ℕ} (hX : X ≠ 0) (hi : i ∈ indices X) : scale i ≤ X := by
  have hi' : i ≤ Nat.log 2 X + 1 := by
    have h := Finset.mem_range.mp hi
    omega
  have heq : scale (Nat.log 2 X + 1) = (2 : ℝ) ^ Nat.log 2 X := by
    unfold scale
    rw [pow_succ]
    ring
  calc
    scale i ≤ scale (Nat.log 2 X + 1) := div_le_div_of_nonneg_right
      (pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hi') (by norm_num)
    _ = (2 : ℝ) ^ Nat.log 2 X := heq
    _ ≤ X := by exact_mod_cast Nat.pow_log_le_self 2 hX

private theorem cutoff_lt_end_scale (X : ℕ) : (X : ℝ) < scale (Nat.log 2 X + 2) := by
  have heq : scale (Nat.log 2 X + 2) = (2 : ℝ) ^ (Nat.log 2 X + 1) := by
    unfold scale
    rw [show Nat.log 2 X + 2 = (Nat.log 2 X + 1) + 1 by omega, pow_succ]
    ring
  rw [heq]
  exact_mod_cast Nat.lt_pow_succ_log_self (by decide : 1 < 2) X

private theorem telescope (f : ℕ → ℝ) (k : ℕ) :
    (∑ i ∈ Finset.range k, (f i - f (i + 1))) = f 0 - f k := by
  induction k with
  | zero => simp
  | succ k ih => rw [Finset.sum_range_succ, ih]; ring

private theorem sum_step_difference (φ : ℝ → ℝ)
    (h0 : ∀ u ≤ 1, φ u = 0) (h1 : ∀ u ≥ 2, φ u = 1)
    {X : ℕ} {x : ℝ} (hx : 1 ≤ x) (hX : x ≤ X) :
    (∑ i ∈ indices X, (φ (x / scale i) - φ ((x / scale i) / 2))) = 1 := by
  unfold indices
  simp_rw [← scaled_succ]
  rw [telescope (fun i => φ (x / scale i))]
  have hl : 2 ≤ x / scale 0 := by
    norm_num [scale]
    linarith
  have hr : x / scale (Nat.log 2 X + 2) ≤ 1 :=
    (div_le_one (scale_pos _)).2 (hX.trans (cutoff_lt_end_scale X).le)
  rw [h1 _ hl, h0 _ hr, sub_zero]

/-- Exact smooth partition at every real `x` in `[1, X]`. -/
theorem sum_smoothWeight {X : ℕ} {x : ℝ} (hx : 1 ≤ x) (hX : x ≤ X) :
    (∑ i ∈ indices X, smoothWeight (x / scale i)) = 1 :=
  sum_step_difference smoothStep (fun _ => smoothStep_zero) (fun _ => smoothStep_one) hx hX

/-- Exact sharp partition, including points on dyadic boundaries. -/
theorem sum_sharpWeight {X : ℕ} {x : ℝ} (hx : 1 ≤ x) (hX : x ≤ X) :
    (∑ i ∈ indices X, sharpWeight (x / scale i)) = 1 := by
  simp_rw [sharpWeight_eq_step_sub]
  apply sum_step_difference sharpStep _ _ hx hX
  · intro u hu; simp [sharpStep, not_lt.mpr hu]
  · intro u hu; simp [sharpStep, show 1 < u by linarith]

/-- A single dyadic piece of an arithmetic function. -/
def piece (weight : ℝ → ℝ) (f : ArithmeticFunction ℝ) (i : ℕ) : ArithmeticFunction ℝ :=
  ⟨fun n => weight ((n : ℝ) / scale i) * f n, by simp⟩

@[simp] theorem piece_apply (weight : ℝ → ℝ) (f : ArithmeticFunction ℝ) (i n : ℕ) :
    piece weight f i n = weight ((n : ℝ) / scale i) * f n := rfl

private theorem sum_apply {ι : Type*} (I : Finset ι) (f : ι → ArithmeticFunction ℝ) (n : ℕ) :
    (∑ i ∈ I, f i) n = ∑ i ∈ I, f i n := by
  classical
  induction I using Finset.induction_on with
  | empty => simp
  | insert i I hi ih => simp [Finset.sum_insert hi, ih]

private theorem piece_partition (w : ℝ → ℝ) (X : ℕ) (f : ArithmeticFunction ℝ)
    (hweight : ∀ x : ℝ, 1 ≤ x → x ≤ X → (∑ i ∈ indices X, w (x / scale i)) = 1)
    (n : ℕ) (hn : n ≤ X) : f n = (∑ i ∈ indices X, piece w f i) n := by
  by_cases h : n = 0
  · simp [h]
  have hn' : (1 : ℝ) ≤ n := by exact_mod_cast Nat.pos_of_ne_zero h
  have hX' : (n : ℝ) ≤ X := by exact_mod_cast hn
  rw [sum_apply]
  simp only [piece_apply, ← Finset.sum_mul, hweight _ hn' hX', one_mul]

theorem smooth_piece_partition (X : ℕ) (f : ArithmeticFunction ℝ) (n : ℕ) (hn : n ≤ X) :
    f n = (∑ i ∈ indices X, piece smoothWeight f i) n :=
  piece_partition smoothWeight X f (fun _ => sum_smoothWeight) n hn

/-- For a function supported on `n ≤ H` (in particular truncated Möbius),
the sharp pieces give an equality of arithmetic functions, not just a local equality. -/
theorem sharp_piece_partition (H : ℕ) (f : ArithmeticFunction ℝ) (hf : ∀ n > H, f n = 0) :
    f = ∑ i ∈ indices H, piece sharpWeight f i := by
  ext n
  rcases le_or_gt n H with hn | hn
  · exact piece_partition sharpWeight H f (fun _ => sum_sharpWeight) n hn
  · simp [hf n hn]

/-- The mixed factor partition in the form required by a `Finset.pi` expansion
of a Heath--Brown block: sharp factors can have their own smaller cutoff. -/
theorem mixed_piece_partition (X H : ℕ) (sharp : Bool) (f : ArithmeticFunction ℝ)
    (hf : sharp = true → ∀ n > H, f n = 0) (n : ℕ) (hn : n ≤ X) :
    f n = (∑ i ∈ indices (if sharp then H else X),
      piece (if sharp then sharpWeight else smoothWeight) f i) n := by
  cases sharp
  · simpa using smooth_piece_partition X f n hn
  · exact congrArg (fun g : ArithmeticFunction ℝ => g n) (sharp_piece_partition H f (hf rfl))

theorem smooth_piece_support {f : ArithmeticFunction ℝ} {i n : ℕ}
    (h : piece smoothWeight f i n ≠ 0) : scale i < n ∧ (n : ℝ) < 4 * scale i := by
  have hn := support_smoothWeight (show smoothWeight ((n : ℝ) / scale i) ≠ 0 by
    intro he; simp [he] at h)
  exact ⟨by simpa using (lt_div_iff₀ (scale_pos i)).1 hn.1,
    (div_lt_iff₀ (scale_pos i)).1 hn.2⟩

theorem sharp_piece_support {f : ArithmeticFunction ℝ} {i n : ℕ}
    (h : piece sharpWeight f i n ≠ 0) : scale i < n ∧ (n : ℝ) ≤ 2 * scale i := by
  have hn : 1 < (n : ℝ) / scale i ∧ (n : ℝ) / scale i ≤ 2 := by
    by_contra hn
    simp [sharpWeight, hn] at h
  exact ⟨by simpa using (lt_div_iff₀ (scale_pos i)).1 hn.1,
    (div_le_iff₀ (scale_pos i)).1 hn.2⟩

/-- The box count, allowing a separate smaller cutoff for each Möbius factor. -/
theorem card_boxes_le {ι : Type*} [DecidableEq ι] (I : Finset ι) (cap : ι → ℕ) {X : ℕ}
    (hcap : ∀ i ∈ I, cap i ≤ X) :
    (I.pi (fun i => indices (cap i))).card ≤ (Nat.log 2 X + 2) ^ I.card := by
  rw [Finset.card_pi, ← Finset.prod_const]
  exact Finset.prod_le_prod fun i hi => by
    simp only [card_indices]
    exact Nat.add_le_add_right (Nat.log_mono_right (hcap i hi)) 2

theorem card_boxes_le_log {ι : Type*} [DecidableEq ι] (I : Finset ι) (cap : ι → ℕ) {X : ℕ}
    (hcap : ∀ i ∈ I, cap i ≤ X) :
    ((I.pi (fun i => indices (cap i))).card : ℝ) ≤ (Real.logb 2 X + 2) ^ I.card := by
  have h : ((I.pi (fun i => indices (cap i))).card : ℝ) ≤
      ((Nat.log 2 X : ℝ) + 2) ^ I.card := by exact_mod_cast card_boxes_le I cap hcap
  have h0 : 0 ≤ (Nat.log 2 X : ℝ) := Nat.cast_nonneg _
  have hlog : (Nat.log 2 X : ℝ) ≤ Real.logb 2 X := by
    simpa only [Nat.cast_ofNat] using Real.natLog_le_logb X 2
  have h1 : (Nat.log 2 X : ℝ) + 2 ≤ Real.logb 2 X + 2 := add_le_add hlog le_rfl
  exact h.trans (pow_le_pow_left₀ (add_nonneg h0 (by norm_num : (0 : ℝ) ≤ 2))
    h1 _)

/-- A box meeting a coefficient window `[x, z]` has scale product in
`[x / 4^#I, z]`. Sharp pieces can be mixed in via their stronger factor bounds. -/
theorem scale_product_bounds {ι : Type*} (I : Finset ι) (j : ι → ℕ) (n : ι → ℕ) {x z : ℝ}
    (hfactor : ∀ i ∈ I, scale (j i) ≤ (n i : ℝ) ∧ (n i : ℝ) ≤ 4 * scale (j i))
    (hx : x ≤ ∏ i ∈ I, (n i : ℝ)) (hz : (∏ i ∈ I, (n i : ℝ)) ≤ z) :
    x / 4 ^ I.card ≤ (∏ i ∈ I, scale (j i)) ∧ (∏ i ∈ I, scale (j i)) ≤ z := by
  constructor
  · apply (div_le_iff₀ (by positivity)).2
    have h := Finset.prod_le_prod₀ (fun i _ => Nat.cast_nonneg (n i)) (fun i hi => (hfactor i hi).2)
    rw [Finset.prod_mul_distrib, Finset.prod_const] at h
    rw [mul_comm]
    exact hx.trans h
  · exact (Finset.prod_le_prod₀ (fun i _ => (scale_pos (j i)).le) (fun i hi => (hfactor i hi).1)).trans hz

/-- The full partition of unity over integer dyadic scales. For each `x > 0`
only the two indices immediately at and below `floor (log₂ x)` can contribute. -/
theorem tsum_smoothWeight {x : ℝ} (hx : 0 < x) :
    (∑' j : ℤ, smoothWeight (x / (2 : ℝ) ^ j)) = 1 := by
  let m : ℤ := ⌊Real.logb 2 x⌋
  have h₂ : (1 : ℝ) < 2 := by norm_num
  have hb0 : (2 : ℝ) ≠ 0 := by norm_num
  have hlow : (2 : ℝ) ^ m ≤ x := by
    rw [← Real.rpow_intCast]
    exact (Real.le_logb_iff_rpow_le h₂ hx).1 (Int.floor_le _)
  have hhigh : x < (2 : ℝ) ^ (m + 1) := by
    rw [← Real.rpow_intCast]
    apply (Real.logb_lt_iff_lt_rpow h₂ hx).1
    simpa only [Int.cast_add, Int.cast_one] using Int.lt_floor_add_one (Real.logb 2 x)
  have shift (j : ℤ) : x / (2 : ℝ) ^ j / 2 = x / (2 : ℝ) ^ (j + 1) := by
    rw [div_div, zpow_add₀ hb0, zpow_one]
  have hs : ∀ j ∉ ({m - 1, m} : Finset ℤ), smoothWeight (x / (2 : ℝ) ^ j) = 0 := by
    intro j hj
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hj
    by_cases h : j + 2 ≤ m
    · apply smoothWeight_zero_above
      apply (le_div_iff₀ (by positivity)).2
      calc
        4 * (2 : ℝ) ^ j = (2 : ℝ) ^ (j + 2) := by rw [zpow_add₀ hb0]; norm_num [mul_comm]
        _ ≤ (2 : ℝ) ^ m := zpow_le_zpow_right₀ h₂.le h
        _ ≤ x := hlow
    · apply smoothWeight_zero_below
      exact (div_le_one (by positivity)).2 (hhigh.le.trans
        (zpow_le_zpow_right₀ h₂.le (by omega : m + 1 ≤ j)))
  rw [tsum_eq_sum hs, Finset.sum_insert (by simp), Finset.sum_singleton]
  have hl : 2 ≤ x / (2 : ℝ) ^ (m - 1) := by
    apply (le_div_iff₀ (by positivity)).2
    calc
      2 * (2 : ℝ) ^ (m - 1) = (2 : ℝ) ^ ((m - 1) + 1) := by
        rw [zpow_add₀ hb0, zpow_one, mul_comm]
      _ ≤ x := by rwa [sub_add_cancel]
  have hr : x / (2 : ℝ) ^ (m + 1) ≤ 1 := (div_le_one (by positivity)).2 hhigh.le
  rw [smoothWeight, smoothWeight, shift, shift, sub_add_cancel, smoothStep_one hl, smoothStep_zero hr]
  ring

private theorem convolution_coefficient_support {f g : ArithmeticFunction ℝ}
    {a b c d : ℝ} (ha : 0 ≤ a) (hc : 0 ≤ c)
    (hf : ∀ k : ℕ, f k ≠ 0 → a ≤ (k : ℝ) ∧ (k : ℝ) ≤ b)
    (hg : ∀ k : ℕ, g k ≠ 0 → c ≤ (k : ℝ) ∧ (k : ℝ) ≤ d)
    {n : ℕ} (hn : (f * g) n ≠ 0) : a * c ≤ n ∧ (n : ℝ) ≤ b * d := by
  obtain ⟨p, hp, hv⟩ : ∃ p ∈ n.divisorsAntidiagonal, f p.1 * g p.2 ≠ 0 := by
    by_contra! h
    exact hn (by rw [ArithmeticFunction.mul_apply]; exact Finset.sum_eq_zero h)
  have hf' := hf p.1 (left_ne_zero_of_mul hv)
  have hg' := hg p.2 (right_ne_zero_of_mul hv)
  have heq : (p.1 : ℝ) * (p.2 : ℝ) = (n : ℝ) := by
    exact_mod_cast (Nat.mem_divisorsAntidiagonal.mp hp).1
  rw [← heq]
  exact ⟨mul_le_mul hf'.1 hg'.1 hc (Nat.cast_nonneg p.1),
    mul_le_mul hf'.2 hg'.2 (Nat.cast_nonneg p.2) (ha.trans (hf'.1.trans hf'.2))⟩

/-- A nonzero coefficient of a box is supported between the products of the
individual lower and upper endpoints. -/
theorem product_coefficient_support {ι : Type*} (I : Finset ι)
    (f : ι → ArithmeticFunction ℝ) (a b : ι → ℝ)
    (hpos : ∀ i ∈ I, 0 ≤ a i)
    (hf : ∀ i ∈ I, ∀ k : ℕ, f i k ≠ 0 → a i ≤ (k : ℝ) ∧ (k : ℝ) ≤ b i)
    {n : ℕ} (hn : (∏ i ∈ I, f i) n ≠ 0) :
    (∏ i ∈ I, a i) ≤ n ∧ (n : ℝ) ≤ ∏ i ∈ I, b i := by
  classical
  induction I using Finset.induction_on generalizing n with
  | empty =>
      have hn' : n = 1 := by
        by_contra h
        exact hn (by simp [h])
      simp [hn']
  | insert i I hi ih =>
      have he : ∀ t ∈ I, t ∈ insert i I := fun _ => Finset.mem_insert_of_mem
      simp only [Finset.prod_insert hi] at hn ⊢
      exact convolution_coefficient_support (hpos i (Finset.mem_insert_self i I))
        (Finset.prod_nonneg (fun t ht => hpos t (he t ht))) (hf i (Finset.mem_insert_self i I))
        (fun k hk => ih (fun t ht => hpos t (he t ht)) (fun t ht => hf t (he t ht)) hk) hn

/-- If a smooth/sharp convolution box contributes in `[x,z]`, its scale
product lies between `x / 4^#I` and `z`. The predicate `sharp` selects which
coordinates use the Möbius-style sharp cutoffs. -/
theorem dyadic_convolution_box_scales {ι : Type*} (I : Finset ι)
    (f : ι → ArithmeticFunction ℝ) (j : ι → ℕ) (sharp : ι → Bool)
    {n : ℕ} {x z : ℝ} (hx : x ≤ n) (hz : (n : ℝ) ≤ z)
    (hn : (∏ i ∈ I,
      piece (if sharp i then sharpWeight else smoothWeight) (f i) (j i)) n ≠ 0) :
    x / 4 ^ I.card ≤ (∏ i ∈ I, scale (j i)) ∧ (∏ i ∈ I, scale (j i)) ≤ z := by
  have hb := product_coefficient_support I _ (fun i => scale (j i))
    (fun i => 4 * scale (j i)) (fun i _ => (scale_pos (j i)).le) (fun i _ k hk => by
      cases h : sharp i
      · have hS := smooth_piece_support (f := f i) (i := j i) (n := k) (by simpa [h] using hk)
        exact ⟨hS.1.le, hS.2.le⟩
      · have hS := sharp_piece_support (f := f i) (i := j i) (n := k) (by simpa [h] using hk)
        have h4 : 2 * scale (j i) ≤ 4 * scale (j i) := by linarith [scale_pos (j i)]
        exact ⟨hS.1.le, hS.2.trans h4⟩) hn
  rw [Finset.prod_mul_distrib, Finset.prod_const] at hb
  exact ⟨(div_le_iff₀ (by positivity)).2 (by rw [mul_comm]; exact hx.trans hb.2),
    hb.1.trans hz⟩

end
end ShortAPDyadicPartition

end

section

/-!
# Heath--Brown's identity in fixed dyadic boxes

This combines the exact finite coefficient identity and the smooth/sharp
partitions. The analytic estimates for individual boxes are separate.
-/

open Finset ArithmeticFunction ShortAPHeathBrown ShortAPDyadicPartition
open scoped BigOperators Classical ArithmeticFunction.Moebius

namespace ShortAPBoxedHB

noncomputable section

/-- The last `j+1` factors in the `(j+1)`-st block are Möbius factors. -/
def isSharp (j i : ℕ) : Bool := decide (j + 1 ≤ i)

def blockIndices (j : ℕ) : Finset ℕ := Finset.range (2 * (j + 1))

abbrev Choice (j : ℕ) := ∀ i ∈ blockIndices j, ℕ

def choices (X H j : ℕ) : Finset (Choice j) :=
  (blockIndices j).pi (fun i => indices (if isSharp j i then H else X))

def boxFactor (H j i b : ℕ) : ArithmeticFunction ℝ :=
  piece (if isSharp j i then sharpWeight else smoothWeight) (factor H j i) b

/-- The Dirichlet convolution of the `2(j+1)` fixed-scale factors. -/
def boxProduct (H j : ℕ) (b : Choice j) : ArithmeticFunction ℝ :=
  ∏ i ∈ (blockIndices j).attach, boxFactor H j i.1 (b i.1 i.2)

/-- The genuine factor partition for Heath--Brown: log and zeta use smooth
weights and truncated Möbius uses sharp weights at its own cutoff. -/
theorem factor_apply_eq_sum_pieces (X H j i n : ℕ) (hn : n ≤ X) :
    factor H j i n =
      (∑ b ∈ indices (if isSharp j i then H else X), boxFactor H j i b) n := by
  unfold boxFactor
  apply mixed_piece_partition X H (isSharp j i) (factor H j i) _ n hn
  intro hs m hm
  have hi : j + 1 ≤ i := of_decide_eq_true hs
  have hi0 : i ≠ 0 := by omega
  simp [factor, hi0, not_lt.mpr hi, not_le.mpr hm]

/-- No partition hypothesis is needed for the fixed-scale box expansion. -/
theorem block_apply_eq_sum_fixed_boxes (X H j n : ℕ) (hn : n ≤ X) :
    block H j n = ∑ b ∈ choices X H j, boxProduct H j b n := by
  exact block_apply_eq_sum_boxes H j X n hn
    (fun i => indices (if isSharp j i then H else X)) (boxFactor H j)
    (fun i _ m hm => factor_apply_eq_sum_pieces X H j i m hm)

/-- The total number of boxes for the block is logarithmic to the power
`2(j+1)`, including the independent choices for the sharp factors. -/
theorem card_choices_le (X H j : ℕ) (hH : H ≤ X) :
    (choices X H j).card ≤ (Nat.log 2 X + 2) ^ (2 * (j + 1)) := by
  have h := card_boxes_le (blockIndices j) (fun i => if isSharp j i then H else X)
    (X := X) (fun i _ => by split <;> first | exact hH | exact le_rfl)
  have heq : (blockIndices j).card = 2 * (j + 1) := by simp [blockIndices]
  rw [heq] at h
  exact h

/-- Each sharp scale is bounded by its own Möbius cutoff, and all scales
lie between `1/2` and the total coefficient cap. -/
theorem choice_scale_bounds {X H j i : ℕ} (hH : H ≠ 0) (hHX : H ≤ X)
    {b : Choice j} (hb : b ∈ choices X H j) (hi : i ∈ blockIndices j) :
    1 / 2 ≤ scale (b i hi) ∧ scale (b i hi) ≤ X ∧
      (isSharp j i = true → scale (b i hi) ≤ H) := by
  have hv := Finset.mem_pi.mp hb i hi
  have hX : X ≠ 0 := by omega
  refine ⟨one_half_le_scale _, ?_⟩
  cases hs : isSharp j i
  · exact ⟨scale_le_cutoff hX (by simpa [hs] using hv), by simp⟩
  · have hh : scale (b i hi) ≤ H := scale_le_cutoff hH (by simpa [hs] using hv)
    exact ⟨hh.trans (by exact_mod_cast hHX), fun _ => hh⟩

def scales (j : ℕ) (b : Choice j) : ℝ :=
  ∏ i ∈ (blockIndices j).attach, scale (b i.1 i.2)

/-- Only boxes with ∏`N_i` comparable to the interval center can contribute. -/
theorem contributing_box_scales (H j : ℕ) (b : Choice j) {n : ℕ} {a z : ℝ}
    (ha : a ≤ n) (hz : (n : ℝ) ≤ z) (hn : boxProduct H j b n ≠ 0) :
    a / 4 ^ (2 * (j + 1)) ≤ scales j b ∧ scales j b ≤ z := by
  have h := dyadic_convolution_box_scales (I := (blockIndices j).attach)
    (fun i => factor H j i.1) (fun i => b i.1 i.2) (fun i => isSharp j i.1) ha hz hn
  simpa only [scales, Finset.card_attach, blockIndices, Finset.card_range] using h

/-- Restrict to the boxes with a nonzero coefficient somewhere in `(a,z]`. -/
def activeChoices (X H j : ℕ) (a z : ℝ) : Finset (Choice j) :=
  (choices X H j).filter (fun b => ∃ n ∈ shortWindow a z, boxProduct H j b n ≠ 0)

theorem card_activeChoices_le (X H j : ℕ) (a z : ℝ) (hH : H ≤ X) :
    (activeChoices X H j a z).card ≤ (Nat.log 2 X + 2) ^ (2 * (j + 1)) :=
  (Finset.card_le_card (Finset.filter_subset _ _)).trans (card_choices_le X H j hH)

theorem active_box_scales {X H j : ℕ} {a z : ℝ} {b : Choice j}
    (hb : b ∈ activeChoices X H j a z) :
    a / 4 ^ (2 * (j + 1)) ≤ scales j b ∧ scales j b ≤ z := by
  obtain ⟨n, hn, hv⟩ := (Finset.mem_filter.mp hb).2
  have h := mem_shortWindow.mp hn
  exact contributing_box_scales H j b h.1.le h.2 hv

private theorem block_apply_eq_sum_active (X H j : ℕ) {a z : ℝ} {n : ℕ}
    (hn : n ≤ X) (hwin : n ∈ shortWindow a z) :
    block H j n = ∑ b ∈ activeChoices X H j a z, boxProduct H j b n := by
  rw [block_apply_eq_sum_fixed_boxes X H j n hn]
  symm
  refine Finset.sum_subset (Finset.filter_subset _ _) (fun b hb hba => ?_)
  by_contra hv
  exact hba (Finset.mem_filter.mpr ⟨hb, n, hwin, hv⟩)

/-- The exact boxed short-interval identity, with the boxes chosen once in
an enclosing window `(a₀,z₀]`. This family does not change as `(a,z]` moves
inside the enclosing window. -/
theorem heathBrown_short_window_boxed_in {X a z a₀ z₀ : ℝ}
    (hX : 0 ≤ X) (hz : z ≤ X) (ha₀ : a₀ ≤ a) (hz₀ : z ≤ z₀)
    {k q : ℕ} (hk : 0 < k) (χ : DirichletCharacter ℂ q) :
    let H := rangeCutoff X k
    (∑ n ∈ shortWindow a z, (vonMangoldt n : ℂ) * χ (n : ZMod q)) =
      ∑ j ∈ Finset.range k, ((-1 : ℂ) ^ j * (k.choose (j + 1) : ℂ)) *
        ∑ b ∈ activeChoices ⌊X⌋₊ H j a₀ z₀,
          ∑ n ∈ shortWindow a z, (boxProduct H j b n : ℂ) * χ (n : ZMod q) := by
  dsimp only
  rw [heathBrown_short_window hX hz hk χ]
  simp_rw [← block_eq_prod]
  apply Finset.sum_congr rfl
  intro j _
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro n hn
  obtain ⟨hl, hr⟩ := mem_shortWindow.mp hn
  have hn' : n ≤ ⌊X⌋₊ := (Nat.le_floor_iff hX).2 (hr.trans hz)
  have hwin : n ∈ shortWindow a₀ z₀ := mem_shortWindow.mpr ⟨ha₀.trans_lt hl, hr.trans hz₀⟩
  rw [block_apply_eq_sum_active ⌊X⌋₊ _ j hn' hwin]
  push_cast
  rw [Finset.sum_mul]

/-- The moving-window version, discarding all boxes with zero contribution in
the exact window. Use `heathBrown_short_window_boxed_in` for a fixed family. -/
theorem heathBrown_short_window_boxed {X a z : ℝ} (hX : 0 ≤ X) (hz : z ≤ X)
    {k q : ℕ} (hk : 0 < k) (χ : DirichletCharacter ℂ q) :
    let H := rangeCutoff X k
    (∑ n ∈ shortWindow a z, (vonMangoldt n : ℂ) * χ (n : ZMod q)) =
      ∑ j ∈ Finset.range k, ((-1 : ℂ) ^ j * (k.choose (j + 1) : ℂ)) *
        ∑ b ∈ activeChoices ⌊X⌋₊ H j a z,
          ∑ n ∈ shortWindow a z, (boxProduct H j b n : ℂ) * χ (n : ZMod q) :=
  heathBrown_short_window_boxed_in hX hz le_rfl le_rfl hk χ

/-- The paper's actual cutoff is positive and at most the coefficient cap. -/
theorem rangeCutoff_bounds {X : ℝ} (hX : 1 ≤ X) {k : ℕ} (hk : 0 < k) :
    1 ≤ rangeCutoff X k ∧ rangeCutoff X k ≤ ⌊X⌋₊ := by
  have hk' : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hk0 : 0 < (k : ℝ) := by linarith
  have he : (1 : ℝ) / k ≤ 1 := (div_le_one hk0).2 hk'
  have hr : 1 ≤ X ^ (1 / (k : ℝ)) := Real.one_le_rpow hX (by positivity)
  unfold rangeCutoff
  constructor
  · apply (Nat.le_floor_iff (by linarith : 0 ≤ X ^ (1 / (k : ℝ)))).2
    simpa only [Nat.cast_one] using hr
  · apply Nat.floor_mono
    calc
      X ^ (1 / (k : ℝ)) ≤ X ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hX he
      _ = X := Real.rpow_one X

/-- Triangle inequality in the fixed-family version. This is the reduction
of the short-window absolute value to the sum of box absolute values. -/
theorem heathBrown_short_window_norm_le_boxes {X a z a₀ z₀ : ℝ}
    (hX : 0 ≤ X) (hz : z ≤ X) (ha₀ : a₀ ≤ a) (hz₀ : z ≤ z₀)
    {k q : ℕ} (hk : 0 < k) (χ : DirichletCharacter ℂ q) :
    let H := rangeCutoff X k
    ‖∑ n ∈ shortWindow a z, (vonMangoldt n : ℂ) * χ (n : ZMod q)‖ ≤
      ∑ j ∈ Finset.range k, (k.choose (j + 1) : ℝ) *
        ∑ b ∈ activeChoices ⌊X⌋₊ H j a₀ z₀,
          ‖∑ n ∈ shortWindow a z, (boxProduct H j b n : ℂ) * χ (n : ZMod q)‖ := by
  dsimp only
  rw [heathBrown_short_window_boxed_in hX hz ha₀ hz₀ hk χ]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
  simp only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, Complex.norm_natCast]
  exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (Nat.cast_nonneg _)

end
end ShortAPBoxedHB

end

section

namespace ShortAP
open MeasureTheory ArithmeticFunction
noncomputable section

/-- Each higher prime power contributes on a set of starting points of length h. -/
def powerCover (X h y : ℝ) : ℝ :=
  ∑ k ∈ (Finset.Ioc 0 ⌊X⌋₊).filter (fun k : ℕ => ¬k.Prime),
    (Set.Ico ((k : ℝ)-h) k).indicator (fun _ => vonMangoldt k) y

theorem powerCover_nonneg (X h y : ℝ) : 0 ≤ powerCover X h y := by
  apply Finset.sum_nonneg
  intro k hk
  simp only [Set.indicator_apply]
  split_ifs <;> positivity

private theorem powerTerm_integrable (k : ℕ) (h : ℝ) :
    Integrable ((Set.Ico ((k : ℝ)-h) k).indicator (fun _ => vonMangoldt k)) := by
  apply (integrable_indicator_iff measurableSet_Ico).2
  exact integrableOn_const (by simp)

theorem integrable_powerCover (X h : ℝ) : Integrable (powerCover X h) := by
  unfold powerCover
  exact integrable_finsetSum _ (fun k _ => powerTerm_integrable k h)

theorem integral_powerCover (X : ℝ) {h : ℝ} (hh : 0 ≤ h) :
    ∫ y, powerCover X h y = h * (Chebyshev.psi X - Chebyshev.theta X) := by
  unfold powerCover
  rw [integral_finsetSum _ (fun k _ => powerTerm_integrable k h),
    Chebyshev.psi_sub_theta_eq_sum_not_prime, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k hk
  rw [integral_indicator_const _ measurableSet_Ico, Real.volume_real_Ico_of_le (by linarith)]
  simp

def psiAP (q : ℕ) [NeZero q] (r : ZMod q) (y h : ℝ) : ℝ :=
  ∑ k ∈ (Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊).filter (fun k : ℕ => (k : ZMod q) = r),
    vonMangoldt k

theorem abs_psiAP_sub_theta_le {q : ℕ} [NeZero q] (r : ZMod q) {y h X : ℝ}
    (hy : 0 ≤ y) (hh : 0 ≤ h) (hX : y+h ≤ X) :
    |psiAP q r y h - theta q r y h| ≤ powerCover X h y := by
  classical
  let s := (Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊).filter (fun k : ℕ => (k : ZMod q) = r)
  let t := (Finset.Ioc 0 ⌊X⌋₊).filter (fun k : ℕ => ¬k.Prime)
  let w (k : ℕ) := (Set.Ico ((k : ℝ)-h) k).indicator (fun _ => vonMangoldt k) y
  have hw (k : ℕ) : 0 ≤ w k := by simp only [w, Set.indicator_apply]; split_ifs <;> positivity
  have hsub : s.filter (fun k : ℕ => ¬k.Prime) ⊆ t := by
    intro k hk
    obtain ⟨hks,hp⟩ := Finset.mem_filter.mp hk
    have hky := (mem_window hy hh k).1 (Finset.mem_filter.mp hks).1
    exact Finset.mem_filter.mpr ⟨Finset.mem_Ioc.mpr ⟨by exact_mod_cast hy.trans_lt hky.1,
      (Nat.le_floor_iff (by linarith)).2 (hky.2.trans hX)⟩,hp⟩
  have he : psiAP q r y h - theta q r y h = ∑ k ∈ s.filter (fun k : ℕ => ¬k.Prime), w k := by
    change (∑ k ∈ s, vonMangoldt k) - (∑ k ∈ s, if k.Prime then Real.log k else 0) = _
    rw [← Finset.sum_sub_distrib]
    conv_rhs => rw [Finset.sum_filter]
    apply Finset.sum_congr rfl
    intro k hk
    have hky := (mem_window hy hh k).1 (Finset.mem_filter.mp hk).1
    have hmem : y ∈ Set.Ico ((k : ℝ)-h) k := ⟨by linarith [hky.2],hky.1⟩
    by_cases hp : k.Prime <;> simp [hp, w, hmem, vonMangoldt_apply_prime]
  rw [he, abs_of_nonneg (Finset.sum_nonneg fun i _ => hw i)]
  exact Finset.sum_le_sum_of_subset_of_nonneg hsub (fun i _ _ => hw i)

/-- Maximal progression error for the von Mangoldt weight, including q=1. -/
def psiErr (q : ℕ) (h y : ℝ) : ℝ :=
  if hq : q = 0 then 0 else
    letI : NeZero q := ⟨hq⟩
    Finset.univ.sup' Finset.univ_nonempty (fun r : ZMod q =>
      if IsUnit r then |psiAP q r y h - h / (q.totient : ℝ)| else 0)

private theorem unit_le_psiErr {q : ℕ} [NeZero q] (y h : ℝ) (a : (ZMod q)ˣ) :
    |psiAP q a y h - h / (q.totient : ℝ)| ≤ psiErr q h y := by
  classical
  unfold psiErr
  rw [dite_eq_right (NeZero.ne q)]
  let f (r : ZMod q) : ℝ := if IsUnit r then |psiAP q r y h - h / (q.totient : ℝ)| else 0
  have H : f a.val ≤ Finset.univ.sup' Finset.univ_nonempty f :=
    Finset.le_sup' f (Finset.mem_univ a.val)
  simpa only [f, ite_eq_left a.isUnit] using H

theorem err_le_psiErr_add_powerCover {q : ℕ} [NeZero q] {y h X : ℝ}
    (hy : 0 ≤ y) (hh : 0 ≤ h) (hX : y+h ≤ X) :
    err q h y ≤ psiErr q h y + powerCover X h y := by
  classical
  have hmax := unit_le_psiErr (q := q) y h
  have hnon : 0 ≤ psiErr q h y := (abs_nonneg _).trans (hmax 1)
  apply (err_le_iff (q := q) y h _ (add_nonneg hnon (powerCover_nonneg X h y))).2
  intro a
  calc |theta q a y h - h / (q.totient : ℝ)| ≤
         |psiAP q a y h - h / (q.totient : ℝ)| + |psiAP q a y h - theta q a y h| := by
           have H := abs_sub_le (theta q a y h) (psiAP q a y h) (h / (q.totient : ℝ))
           rw [abs_sub_comm (theta q a y h) (psiAP q a y h), add_comm] at H
           exact H
       _ ≤ _ := add_le_add (hmax a) (abs_psiAP_sub_theta_le (q := q) a hy hh hX)

theorem integral_powerCover_moduli {x h : ℝ} {Q : ℕ} (hx : 0 ≤ x) (hh : 0 ≤ h) :
    (∫ y in x..2*x, (Q : ℝ) * powerCover (3*x) h y) ≤
      (Q : ℝ) * h * (Chebyshev.psi (3*x) - Chebyshev.theta (3*x)) := by
  rw [intervalIntegral.integral_of_le (by linarith), integral_const_mul, mul_assoc]
  apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
  rw [← integral_powerCover _ hh]
  exact setIntegral_le_integral (integrable_powerCover _ _) (Filter.Eventually.of_forall fun y => powerCover_nonneg _ _ y)

theorem intervalIntegrable_floorPair (F : ℕ × ℕ → ℝ) (h a b : ℝ) (hab : a ≤ b) :
    IntervalIntegrable (fun y : ℝ => F (⌊y⌋₊, ⌊y+h⌋₊)) volume a b := by
  classical
  rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hab]
  let S := (Finset.Iic ⌊b⌋₊) ×ˢ (Finset.Iic ⌊b+h⌋₊)
  have hm : Measurable (fun y : ℝ => F (⌊y⌋₊, ⌊y+h⌋₊)) :=
    (measurable_of_countable F).comp (measurable_id.nat_floor.prodMk
      (measurable_id.add_const h).nat_floor)
  apply IntegrableOn.of_bound measure_Ioc_lt_top hm.aestronglyMeasurable (∑ p ∈ S, ‖F p‖)
  filter_upwards [ae_restrict_mem (μ := volume) measurableSet_Ioc] with y hy
  apply Finset.single_le_sum (f := fun p => ‖F p‖) (fun p _ => norm_nonneg _)
  exact Finset.mem_product.mpr ⟨Finset.mem_Iic.mpr (Nat.floor_mono hy.2),
    Finset.mem_Iic.mpr (Nat.floor_mono (by linarith [hy.2]))⟩

private noncomputable def weightMax (w : ℕ → ℝ) (h : ℝ) (q : ℕ) (p : ℕ × ℕ) : ℝ :=
  if hq : q = 0 then 0 else
    letI : NeZero q := ⟨hq⟩
    Finset.univ.sup' Finset.univ_nonempty (fun r : ZMod q =>
      if IsUnit r then |(∑ k ∈ (Finset.Icc (p.1+1) p.2).filter (fun k : ℕ => (k : ZMod q) = r),
        w k) - h / (q.totient : ℝ)| else 0)

theorem intervalIntegrable_errSum (Q : ℕ) (h a b : ℝ) (hab : a ≤ b) :
    IntervalIntegrable (fun y => ∑ q ∈ Finset.Icc 1 Q, err q h y) volume a b :=
  intervalIntegrable_floorPair (fun p => ∑ q ∈ Finset.Icc 1 Q,
    weightMax (fun k => if k.Prime then Real.log k else 0) h q p) h a b hab

/-- Section 2, weight replacement, with a single error term uniform in all residues. -/
theorem integral_err_le_integral_psiErr {x h : ℝ} (Q : ℕ) (hx : 0 ≤ x) (hh : 0 ≤ h)
    (hhx : h ≤ x) :
    (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, err q h y) ≤
    (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, psiErr q h y) +
      (Q : ℝ) * h * (Chebyshev.psi (3*x) - Chebyshev.theta (3*x)) := by
  have hxx : x ≤ 2*x := by linarith
  have hθ := intervalIntegrable_errSum Q h x (2*x) hxx
  have hψ := intervalIntegrable_floorPair (fun p => ∑ q ∈ Finset.Icc 1 Q,
    weightMax vonMangoldt h q p) h x (2*x) hxx
  have hP : IntervalIntegrable (fun y => (Q : ℝ) * powerCover (3*x) h y) volume x (2*x) :=
    ((integrable_powerCover _ _).const_mul _).intervalIntegrable
  change IntervalIntegrable (fun y => ∑ q ∈ Finset.Icc 1 Q, psiErr q h y) volume x (2*x) at hψ
  apply le_trans _ (add_le_add_right (integral_powerCover_moduli (Q := Q) hx hh) _)
  rw [← intervalIntegral.integral_add hψ hP]
  apply intervalIntegral.integral_mono_on hxx hθ (hψ.add hP)
  intro y hy
  calc
    (∑ q ∈ Finset.Icc 1 Q, err q h y)
      ≤ ∑ q ∈ Finset.Icc 1 Q, (psiErr q h y + powerCover (3*x) h y) := by
        apply Finset.sum_le_sum
        intro q hq
        have : NeZero q := ⟨by have := (Finset.mem_Icc.mp hq).1; omega⟩
        exact err_le_psiErr_add_powerCover (hx.trans hy.1) hh (by linarith [hy.2])
    _ = _ := by simp [Finset.sum_add_distrib, Nat.card_Icc, nsmul_eq_mul]

/-- At the frozen modulus range Q loses a power 1/32 below the square root.
This absorbs the full eighteenth power of the logarithm without a t-dependent threshold. -/
theorem power_error_absorbed :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ᶠ x : ℝ in Filter.atTop, ∀ (t : ℝ) (Q : ℕ), t ≤ 1 →
      (Q : ℝ)^2 ≤ x^t / x^((1-t)/3+(1:ℝ)/16) →
      (Q : ℝ) * x^t * (Chebyshev.psi (3*x) - Chebyshev.theta (3*x)) ≤
        K * (x^t*x) / (Real.log x)^18 := by
  obtain ⟨C,hC⟩ := Chebyshev.psi_sub_theta_le_mul_sqrt
  refine ⟨|C| * Real.sqrt 3, by positivity, ?_⟩
  have hlog := (isLittleO_log_rpow_rpow_atTop (18 : ℝ) (show (0 : ℝ) < 1/32 by norm_num)).bound
    (show (0 : ℝ) < 1 by norm_num)
  filter_upwards [hlog, Filter.eventually_gt_atTop (1 : ℝ)] with x hl hx t Q ht hQ
  have hx0 : 0 < x := by linarith
  have hl0 := Real.log_pos hx
  simp only [Real.norm_eq_abs, one_mul, abs_of_nonneg (Real.rpow_nonneg hl0.le _),
    abs_of_nonneg (Real.rpow_nonneg hx0.le _)] at hl
  norm_cast at hl
  have hlog' : (Real.log x)^18 ≤ x^((1:ℝ)/32) := by exact_mod_cast hl
  rw [← Real.rpow_sub hx0] at hQ
  have hQ2 := hQ.trans (Real.rpow_le_rpow_of_exponent_le hx.le
    (by linarith : t-((1-t)/3+1/16) ≤ 2*(15/32 : ℝ)))
  rw [mul_comm (2:ℝ), Real.rpow_mul hx0.le] at hQ2
  norm_cast at hQ2
  push_cast at hQ2
  have hq : (Q : ℝ) ≤ x^((15:ℝ)/32) := by
    have hp := Real.rpow_nonneg hx0.le ((15:ℝ)/32)
    nlinarith [sq_nonneg ((Q:ℝ)-x^((15:ℝ)/32))]
  have hmain : (Q:ℝ) * Real.sqrt x * (Real.log x)^18 ≤ x := calc
    _ ≤ x^((15:ℝ)/32) * x^((1:ℝ)/2) * x^((1:ℝ)/32) := by
      rw [← Real.sqrt_eq_rpow]
      exact mul_le_mul (mul_le_mul_of_nonneg_right hq (Real.sqrt_nonneg _)) hlog'
        (by positivity) (by positivity)
    _ = x := by rw [← Real.rpow_add hx0, ← Real.rpow_add hx0]; norm_num
  have hψ := (hC (3*x)).trans (mul_le_mul_of_nonneg_right (le_abs_self C) (Real.sqrt_nonneg _))
  rw [Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 3)] at hψ
  apply (le_div_iff₀ (pow_pos hl0 18)).2
  calc
    _ ≤ ((Q:ℝ) * x^t) * (|C| * (Real.sqrt 3 * Real.sqrt x)) * (Real.log x)^18 := by gcongr
    _ = (|C| * Real.sqrt 3*x^t) * ((Q:ℝ)*Real.sqrt x*(Real.log x)^18) := by ring
    _ ≤ (|C| * Real.sqrt 3*x^t) * x := by gcongr
    _ = _ := by ring

/-- It suffices to establish the same high-exponent mean estimate for Λ.
The higher prime powers are discharged here, not assumed negligible. -/
theorem upperBranch_of_psi
    (H : ∃ C : ℝ, 0 < C ∧ ∃ X : ℕ, ∀ x t : ℝ, (X : ℝ) ≤ x → 1 ≤ x →
      5/8 ≤ t → t ≤ 1 → ∀ Q : ℕ, 1 ≤ Q →
      (Q : ℝ)^2 ≤ x^t / x^((1-t)/3+(1:ℝ)/16) →
      (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, psiErr q (x^t) y) ≤
        C * (x^t*x) / (Real.log x)^18) :
    UpperBranch 18 (1/16) := by
  obtain ⟨C,hC,X,h⟩ := H
  obtain ⟨K,hK,hk⟩ := power_error_absorbed
  obtain ⟨b,hb⟩ := Filter.eventually_atTop.1 hk
  obtain ⟨N,hN⟩ := exists_nat_ge b
  refine ⟨C+K, by linarith, max X N, ?_⟩
  intro x t hmax hx _ ht ht' Q hQ hsize
  have hmax' : max (X : ℝ) (N : ℝ) ≤ x := by exact_mod_cast hmax
  have hp := integral_err_le_integral_psiErr Q (by linarith : 0 ≤ x)
    (Real.rpow_nonneg (by linarith : 0 ≤ x) t)
    (by simpa using Real.rpow_le_rpow_of_exponent_le hx ht')
  have h₁ := h x t ((le_max_left ..).trans hmax') hx ht ht' Q hQ hsize
  have h₂ := hb x (hN.trans ((le_max_right ..).trans hmax')) t Q ht' hsize
  exact hp.trans ((add_le_add h₁ h₂).trans_eq (by ring))

end
end ShortAP

end

section

namespace ShortAP
open ArithmeticFunction
noncomputable section

theorem twisted_weight_replacement {q : ℕ} (χ : DirichletCharacter ℂ q)
    {X h y : ℝ} (hy : 0 ≤ y) (hh : 0 ≤ h) (hX : y+h ≤ X) :
    let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
    ‖(∑ n ∈ s, ((if n.Prime then Real.log (n : ℝ) else 0 : ℝ) : ℂ) * χ (n : ZMod q)) -
      (∑ n ∈ s, (vonMangoldt n : ℂ) * χ (n : ZMod q))‖ ≤ powerCover X h y := by
  classical
  let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
  let w (n : ℕ) : ℝ := if n.Prime then Real.log n else 0
  have hnon (n : ℕ) : 0 ≤ vonMangoldt n - w n := by
    by_cases hp : n.Prime <;> simp [w,hp,vonMangoldt_apply_prime, vonMangoldt_nonneg]
  have hsum := abs_psiAP_sub_theta_le (q := 1) 0 hy hh hX
  have he : (∑ n ∈ s, (vonMangoldt n - w n)) ≤ powerCover X h y := by
    rw [Finset.sum_sub_distrib]
    apply (le_abs_self _).trans
    have hz (k : ℕ) : (k : ZMod 1) = 0 := Subsingleton.elim ..
    simpa [psiAP,theta,s,w,hz] using hsum
  dsimp only
  rw [← Finset.sum_sub_distrib]
  apply (norm_sum_le _ _).trans
  apply le_trans _ he
  apply Finset.sum_le_sum
  intro n _
  change ‖(w n : ℂ) * χ (n : ZMod q) - (vonMangoldt n : ℂ) * χ (n : ZMod q)‖ ≤ _
  rw [← sub_mul, norm_mul, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
    abs_sub_comm, abs_of_nonneg (hnon n)]
  exact mul_le_of_le_one_right (hnon n) (χ.norm_le_one _)

open scoped Classical in
def hbFiniteMean {k : ℕ} (q : ℕ) [NeZero q] (X h : ℝ) (s : Finset ℕ) : ℝ :=
  (∑ χ : DirichletCharacter ℂ q, ‖(∑ j ∈ Finset.range k,
    ((-1 : ℂ)^j * (k.choose (j+1) : ℂ)) * ∑ n ∈ s,
      ((∏ i ∈ Finset.range (2*(j+1)), ShortAPHeathBrown.factor
          (ShortAPHeathBrown.rangeCutoff X k) j i) n : ℂ) * χ (n : ZMod q)) -
        (if χ = 1 then (h : ℂ) else 0)‖) / (q.totient : ℝ)

def hbCharacterMean {k : ℕ} (q : ℕ) [NeZero q] (X y h : ℝ) : ℝ :=
  hbFiniteMean (k := k) q X h (ShortAPHeathBrown.shortWindow y (y+h))

/-- Direct link from the paper's exact character-twisted Heath--Brown identity
to the maximal prime error in the frozen statement, before smoothing. -/
theorem err_le_hbCharacterMean {q k : ℕ} [NeZero q] (hk : 0 < k)
    {X h y : ℝ} (hy : 0 ≤ y) (hh : 0 ≤ h) (hX : y+h ≤ X) :
    err q h y ≤ hbCharacterMean (k := k) q X y h + powerCover X h y := by
  classical
  let s := Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊
  let A (χ : DirichletCharacter ℂ q) := ∑ n ∈ s,
    ((if n.Prime then Real.log (n : ℝ) else 0 : ℝ) : ℂ) * χ (n : ZMod q)
  let B (χ : DirichletCharacter ℂ q) := ∑ n ∈ s, (vonMangoldt n : ℂ) * χ (n : ZMod q)
  let P (χ : DirichletCharacter ℂ q) : ℂ := if χ = 1 then h else 0
  have hsame : s = ShortAPHeathBrown.shortWindow y (y+h) := by
    ext n
    rw [ShortAPHeathBrown.mem_shortWindow, ← mem_window hy hh]
  have hB (χ : DirichletCharacter ℂ q) := ShortAPHeathBrown.heathBrown_short_window
    (y := y) (by linarith : 0 ≤ X) hX hk χ
  have hnorm (χ : DirichletCharacter ℂ q) :
      ‖A χ - P χ‖ ≤ ‖B χ - P χ‖ + powerCover X h y := by
    have h := dist_triangle (A χ) (B χ) (P χ)
    simp only [dist_eq_norm] at h
    rw [add_comm] at h
    exact h.trans (add_le_add_right (twisted_weight_replacement χ hy hh hX) _)
  have hφ : 0 < (q.totient : ℝ) := by exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  apply (err_le_twisted_mean q y h).trans
  change (∑ χ, ‖A χ - P χ‖) / (q.totient : ℝ) ≤ _
  have hmass : (∑ χ : DirichletCharacter ℂ q, ‖B χ - P χ‖) / (q.totient : ℝ) =
      hbCharacterMean (k := k) q X y h := by
    unfold hbCharacterMean hbFiniteMean
    simp only [B,P,hsame,hB]
  rw [← hmass, div_add' _ _ _ hφ.ne']
  apply div_le_div_of_nonneg_right _ hφ.le
  have hh' := Finset.sum_le_sum (s := Finset.univ) (fun χ _ => hnorm χ)
  simpa [Finset.sum_add_distrib, nsmul_eq_mul, ← Nat.card_eq_fintype_card,
    DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity, mul_comm] using hh'

def hbMeanSum (k Q : ℕ) (X h : ℝ) (p : ℕ × ℕ) : ℝ :=
  ∑ q ∈ Finset.Icc 1 Q, if hq : q = 0 then 0 else
    letI : NeZero q := ⟨hq⟩
    hbFiniteMean (k := k) q X h (Finset.Icc (p.1+1) p.2)

/-- The full averaging and both endpoint floors from the frozen statement are retained. -/
theorem integral_err_le_integral_hbMeanSum {k : ℕ} (hk : 0 < k) {x h : ℝ} (Q : ℕ)
    (hx : 0 ≤ x) (hh : 0 ≤ h) (hhx : h ≤ x) :
    (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, err q h y) ≤
    (∫ y in x..2*x, hbMeanSum k Q (3*x) h (⌊y⌋₊,⌊y+h⌋₊)) +
      (Q : ℝ) * h * (Chebyshev.psi (3*x) - Chebyshev.theta (3*x)) := by
  have hxx : x ≤ 2*x := by linarith
  have hθ := intervalIntegrable_errSum Q h x (2*x) hxx
  have hHB := intervalIntegrable_floorPair (hbMeanSum k Q (3*x) h) h x (2*x) hxx
  have hP : IntervalIntegrable (fun y => (Q : ℝ) * powerCover (3*x) h y)
      MeasureTheory.volume x (2*x) := ((integrable_powerCover _ _).const_mul _).intervalIntegrable
  apply le_trans _ (add_le_add_right (integral_powerCover_moduli (Q := Q) hx hh) _)
  rw [← intervalIntegral.integral_add hHB hP]
  apply intervalIntegral.integral_mono_on hxx hθ (hHB.add hP)
  intro y hy
  have hy0 := hx.trans hy.1
  have hsame : ShortAPHeathBrown.shortWindow y (y+h) = Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊ := by
    ext n; rw [ShortAPHeathBrown.mem_shortWindow, mem_window hy0 hh]
  unfold hbMeanSum
  have hsum := Finset.sum_le_sum (s := Finset.Icc 1 Q) (fun q hq => by
    have hn : q ≠ 0 := by have := (Finset.mem_Icc.mp hq).1; omega
    have : NeZero q := ⟨hn⟩
    have H := err_le_hbCharacterMean (q := q) hk hy0 hh (by linarith [hy.2] : y+h ≤ 3*x)
    exact show err q h y ≤ (if Hq : q = 0 then 0 else
      letI : NeZero q := ⟨Hq⟩; hbFiniteMean (k := k) q (3*x) h (Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊)) +
        powerCover (3*x) h y from by simpa [hn,hbCharacterMean,hsame] using H)
  simpa [Finset.sum_add_distrib, Nat.card_Icc, nsmul_eq_mul] using hsum

/-- Sufficient analytic input on the four-term Heath--Brown decomposition.
The subtraction of h occurs only on the principal character, before its norm. -/
def HBMeanUpper : Prop := ∃ C : ℝ, 0 < C ∧ ∀ᶠ x : ℝ in Filter.atTop,
  ∀ t : ℝ, 5/8 ≤ t → t ≤ 1 → ∀ Q : ℕ, 1 ≤ Q →
  (Q : ℝ)^2 ≤ x^t / x^((1-t)/3+(1:ℝ)/16) →
  (∫ y in x..2*x, hbMeanSum 4 Q (3*x) (x^t) (⌊y⌋₊,⌊y+x^t⌋₊)) ≤
    C * (x^t*x) / (Real.log x)^18

theorem upperBranch_of_HBMeanUpper (H : HBMeanUpper) : UpperBranch 18 (1/16) := by
  obtain ⟨C,hC,h⟩ := H
  obtain ⟨K,hK,hk⟩ := power_error_absorbed
  obtain ⟨b,hb⟩ := Filter.eventually_atTop.1 (h.and hk)
  obtain ⟨N,hN⟩ := exists_nat_ge b
  refine ⟨C+K, by linarith, N, ?_⟩
  intro x t hxN hx _ ht ht' Q hQ hsize
  obtain ⟨h₁,h₂⟩ := hb x (hN.trans hxN)
  have hp := integral_err_le_integral_hbMeanSum (k := 4) (by decide) Q
    (by linarith : 0 ≤ x) (Real.rpow_nonneg (by linarith : 0 ≤ x) t)
    (by simpa using Real.rpow_le_rpow_of_exponent_le hx ht')
  exact hp.trans ((add_le_add (h₁ t ht ht' Q hQ hsize) (h₂ t Q ht' hsize)).trans_eq (by ring))

end
end ShortAP

end

section

/-! The finite conductor partition adapts the two finset identities of
`DyadicMixedB4ConductorPartition` in B13BilateralVaughanReduction.lean
(goldbach-proofs 9e15333e527bef0fb439636fd9c07b40ab2617eb, Apache-2.0).
The prime window here is unchanged on induction as soon as its lower endpoint is ≥ q. -/

namespace ShortAP
open Finset
open scoped Classical
noncomputable section

private theorem sum_at_primitive_conductor {A : Type*} [AddCommMonoid A] {q d : ℕ}
    [NeZero q] (hd : d ∣ q) (F : DirichletCharacter ℂ q → A) :
    (∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.conductor = d), F χ) =
      ∑ ψ ∈ primitiveChars d, F (DirichletCharacter.changeLevel hd ψ) := by
  classical
  have hd0 : d ≠ 0 := by intro h; exact NeZero.ne q (Nat.eq_zero_of_zero_dvd (h ▸ hd))
  have : NeZero d := ⟨hd0⟩
  simp only [primitiveChars, dite_eq_right hd0]
  symm
  apply sum_bij (fun ψ _ => DirichletCharacter.changeLevel hd ψ)
  · intro ψ hp
    exact mem_filter.mpr ⟨mem_univ _, (DirichletCharacter.conductor_changeLevel ψ hd).trans
      (show ψ.IsPrimitive from (mem_filter.mp hp).2)⟩
  · intro χ _ ψ _ h
    exact DirichletCharacter.changeLevel_injective hd h
  · intro χ hp
    have he := (mem_filter.mp hp).2
    subst d
    exact ⟨χ.primitiveCharacter, mem_filter.mpr ⟨mem_univ _, χ.primitiveCharacter_isPrimitive⟩,
      χ.changeLevel_primitiveCharacter⟩
  · intro _ _; rfl

theorem sum_primitive_conductors {A : Type*} [AddCommMonoid A] {q : ℕ} [NeZero q]
    (F : DirichletCharacter ℂ q → A) : (∑ χ, F χ) =
      ∑ d ∈ q.divisors.attach, ∑ ψ ∈ primitiveChars d.1,
        F (DirichletCharacter.changeLevel (Nat.mem_divisors.mp d.2).1 ψ) := by
  classical
  have hm (χ : DirichletCharacter ℂ q) (_ : χ ∈ (univ : Finset (DirichletCharacter ℂ q))) :
      χ.conductor ∈ q.divisors := Nat.mem_divisors.mpr ⟨χ.conductor_dvd_level, NeZero.ne q⟩
  calc
    _ = ∑ d ∈ q.divisors, ∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.conductor = d),
        F χ := (sum_fiberwise_of_maps_to hm F).symm
    _ = ∑ d ∈ q.divisors.attach, ∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q =>
        χ.conductor = d.1), F χ := (sum_attach _ _).symm
    _ = _ := sum_congr rfl fun d _ => sum_at_primitive_conductor (Nat.mem_divisors.mp d.2).1 F

def centeredPrimeSum {q : ℕ} (χ : DirichletCharacter ℂ q) (y h : ℝ) : ℂ :=
  (∑ k ∈ Finset.Icc (⌊y⌋₊+1) ⌊y+h⌋₊,
    ((if k.Prime then Real.log (k : ℝ) else 0 : ℝ) : ℂ) * χ (k : ZMod q)) -
    (if χ = 1 then (h : ℂ) else 0)

theorem centeredPrimeSum_changeLevel {d q : ℕ} [NeZero q] (hd : d ∣ q)
    (χ : DirichletCharacter ℂ d) {h y : ℝ} (hq : (q : ℝ) ≤ y) (hh : 0 ≤ h) :
    centeredPrimeSum (DirichletCharacter.changeLevel hd χ) y h = centeredPrimeSum χ y h := by
  classical
  have hone : DirichletCharacter.changeLevel hd χ = 1 ↔ χ = 1 := by
    rw [← map_one (DirichletCharacter.changeLevel (R := ℂ) hd)]
    exact (DirichletCharacter.changeLevel_injective hd).eq_iff
  unfold centeredPrimeSum
  simp only [hone]
  congr 1
  apply Finset.sum_congr rfl
  intro p hp
  by_cases hpr : p.Prime
  · have hpy := ((mem_window ((Nat.cast_nonneg q).trans hq) hh p).1 hp).1
    have hqp : q < p := by exact_mod_cast (hq.trans_lt hpy)
    have hcop := hpr.coprime_iff_not_dvd.mpr
      (fun hdvd => (Nat.not_le_of_gt hqp) (Nat.le_of_dvd (NeZero.pos q) hdvd))
    have he := χ.changeLevel_eq_cast_of_dvd' hd (Nat.isCoprime_iff_coprime.mpr hcop)
    simpa only [Int.cast_natCast] using congrArg
      (fun z : ℂ => ((if p.Prime then Real.log (p : ℝ) else 0 : ℝ) : ℂ) * z) he
  · simp [hpr]

/-- No imprimitive-character error is paid for prime weights at q ≤ y. -/
theorem err_le_primitive_conductor_mean {q : ℕ} [NeZero q] {h y : ℝ}
    (hq : (q : ℝ) ≤ y) (hh : 0 ≤ h) :
    err q h y ≤ (∑ d ∈ q.divisors.attach, ∑ ψ ∈ primitiveChars d.1,
      ‖centeredPrimeSum ψ y h‖) / (q.totient : ℝ) := by
  apply (err_le_twisted_mean q y h).trans_eq
  have H := sum_primitive_conductors (q := q) (fun χ => ‖centeredPrimeSum χ y h‖)
  simp only [centeredPrimeSum_changeLevel _ _ hq hh] at H
  rw [← H]
  congr 1
  apply Finset.sum_congr rfl
  intro χ _
  by_cases hp : χ = 1 <;> simp [centeredPrimeSum, hp]

end
end ShortAP

end

section

/-! The reciprocal-totient bound below is adapted from muxkin, goldbach-proofs PR 1708
(c56bb450d43259dd871d29020d53facb6e5de557, Apache-2.0), as ported in
PacketRemainingRationalShell.lean. -/
namespace ShortAP
open Finset
noncomputable section

private theorem inv_totient_le_pairs (q : ℕ) (hq : 0 < q) :
    1 / (q.totient : ℝ) ≤ ∑ ab ∈ q.divisorsAntidiagonal, ((ab.1:ℝ)⁻¹ * (ab.2:ℝ)⁻¹) := by
  have hφ := Nat.totient_pos.mpr hq
  have hcount : q ≤ q.divisors.card * q.totient := by
    calc
      _ = ∑ d ∈ q.divisors, d.totient := (Nat.sum_totient q).symm
      _ ≤ ∑ _ ∈ q.divisors, q.totient := sum_le_sum (fun d hd =>
        Nat.le_of_dvd hφ (Nat.totient_dvd_of_dvd (Nat.dvd_of_mem_divisors hd)))
      _ = _ := by simp
  calc
    _ ≤ (q.divisors.card : ℝ) / q := (div_le_div_iff₀ (by exact_mod_cast hφ) (by exact_mod_cast hq)).mpr
      (by rw [one_mul]; exact_mod_cast hcount)
    _ = ∑ _ ∈ q.divisorsAntidiagonal, (q:ℝ)⁻¹ := by
      rw [Nat.sum_divisorsAntidiagonal (fun _ _ => (q:ℝ)⁻¹)]; simp [div_eq_mul_inv]
    _ = _ := by
      apply sum_congr rfl
      intro ab hab
      rw [← (Nat.mem_divisorsAntidiagonal.mp hab).1, Nat.cast_mul, mul_inv]

/-- A finite reciprocal-totient bound with constant one. -/
theorem sum_inv_totient_le (Q : ℕ) :
    (∑ q ∈ Icc 1 Q, 1 / (q.totient : ℝ)) ≤ (1 + Real.log Q)^2 := by
  let S := Icc 1 Q
  let w := fun ab : ℕ × ℕ => (ab.1:ℝ)⁻¹ * (ab.2:ℝ)⁻¹
  have hf (q : ℕ) (hq : q ∈ S) :
      q.divisorsAntidiagonal = (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q) := by
    obtain ⟨hq0,hqQ⟩ := mem_Icc.mp hq
    ext ab
    constructor
    · intro hab
      have hf := Nat.fst_mem_divisors_of_mem_antidiagonal hab
      have hs := Nat.snd_mem_divisors_of_mem_antidiagonal hab
      have hm (a : ℕ) (ha : a ∈ q.divisors) : a ∈ S :=
        mem_Icc.mpr ⟨Nat.pos_of_mem_divisors ha,(Nat.le_of_dvd hq0 (Nat.dvd_of_mem_divisors ha)).trans hqQ⟩
      exact mem_filter.mpr ⟨mem_product.mpr ⟨hm _ hf,hm _ hs⟩,(Nat.mem_divisorsAntidiagonal.mp hab).1⟩
    · intro hab
      exact Nat.mem_divisorsAntidiagonal.mpr ⟨(mem_filter.mp hab).2,by omega⟩
  have hsum : (∑ i ∈ S, (i:ℝ)⁻¹) ≤ 1+Real.log Q := by
    simpa only [S,harmonic_eq_sum_Icc,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast] using harmonic_le_one_add_log Q
  calc
    _ ≤ ∑ q ∈ S, ∑ ab ∈ q.divisorsAntidiagonal, w ab :=
      sum_le_sum (fun q hq => inv_totient_le_pairs q (mem_Icc.mp hq).1)
    _ = ∑ q ∈ S, ∑ ab ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q), w ab :=
      sum_congr rfl (fun q hq => by rw [hf q hq])
    _ = ∑ ab ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2 ∈ S), w ab :=
      sum_fiberwise_eq_sum_filter _ _ _ _
    _ ≤ ∑ ab ∈ S ×ˢ S, w ab := sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun _ _ _ => by dsimp [w]; positivity)
    _ = (∑ i ∈ S, (i:ℝ)⁻¹)^2 := by rw [sq,sum_product,sum_mul_sum]
    _ ≤ _ := pow_le_pow_left₀ (sum_nonneg fun _ _ => by positivity) hsum 2

/-- Summing the multiplicities of a primitive conductor costs at most two
powers of the logarithm, uniformly also for the principal conductor. -/
theorem sum_conductor_weights (Q : ℕ) (F : ℕ → ℝ) (hF : ∀ d, 0 ≤ F d) :
    (∑ q ∈ Icc 1 Q, (∑ d ∈ q.divisors, F d) / (q.totient : ℝ)) ≤
      (∑ d ∈ Icc 1 Q, F d / (d.totient : ℝ)) * (1 + Real.log Q)^2 := by
  classical
  let S := Icc 1 Q
  let w (p : ℕ × ℕ) := (F p.1 / (p.1.totient : ℝ)) * (1 / (p.2.totient : ℝ))
  have hw (p : ℕ × ℕ) : 0 ≤ w p :=
    mul_nonneg (div_nonneg (hF _) (Nat.cast_nonneg _)) (by positivity)
  have hsub (q : ℕ) (hq : q ∈ S) :
      q.divisorsAntidiagonal ⊆ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q) := by
    intro ab hab
    have hm (d : ℕ) (hd : d ∈ q.divisors) : d ∈ S :=
      mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hd,
        (Nat.le_of_dvd (mem_Icc.mp hq).1 (Nat.dvd_of_mem_divisors hd)).trans (mem_Icc.mp hq).2⟩
    exact mem_filter.mpr ⟨mem_product.mpr ⟨hm _ (Nat.fst_mem_divisors_of_mem_antidiagonal hab),
      hm _ (Nat.snd_mem_divisors_of_mem_antidiagonal hab)⟩,(Nat.mem_divisorsAntidiagonal.mp hab).1⟩
  have hterm (q : ℕ) (hq : q ∈ S) :
      (∑ d ∈ q.divisors, F d) / (q.totient : ℝ) ≤ ∑ p ∈ q.divisorsAntidiagonal, w p := by
    rw [Finset.sum_div]
    have he := Nat.sum_divisorsAntidiagonal (fun d _ => F d / (q.totient : ℝ)) (n := q)
    rw [← he]
    apply sum_le_sum
    intro p hp
    have h1 := Nat.pos_of_mem_divisors (Nat.fst_mem_divisors_of_mem_antidiagonal hp)
    have h2 := Nat.pos_of_mem_divisors (Nat.snd_mem_divisors_of_mem_antidiagonal hp)
    have h3 : 0 < (p.1.totient : ℝ) * (p.2.totient : ℝ) := by
      exact_mod_cast Nat.mul_pos (Nat.totient_pos.mpr h1) (Nat.totient_pos.mpr h2)
    have hφ := Nat.totient_super_multiplicative p.1 p.2
    rw [(Nat.mem_divisorsAntidiagonal.mp hp).1] at hφ
    calc F p.1 / (q.totient : ℝ) ≤ F p.1 / ((p.1.totient : ℝ) * (p.2.totient : ℝ)) :=
           div_le_div_of_nonneg_left (hF _) h3 (by exact_mod_cast hφ)
         _ = w p := by simp [w, div_eq_mul_inv, mul_comm, mul_assoc]
  calc
    _ ≤ ∑ q ∈ S, ∑ p ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2=q), w p :=
      sum_le_sum fun q hq => (hterm q hq).trans
        (sum_le_sum_of_subset_of_nonneg (hsub q hq) fun p _ _ => hw p)
    _ = ∑ p ∈ (S ×ˢ S).filter (fun ab : ℕ × ℕ => ab.1*ab.2 ∈ S), w p :=
      sum_fiberwise_eq_sum_filter _ _ _ _
    _ ≤ ∑ p ∈ S ×ˢ S, w p := sum_le_sum_of_subset_of_nonneg (filter_subset _ _) fun p _ _ => hw p
    _ = (∑ d ∈ S, F d / (d.totient : ℝ)) * (∑ d ∈ S, 1/(d.totient : ℝ)) := by
      rw [sum_product, sum_mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left (sum_inv_totient_le _)
      (sum_nonneg fun d _ => div_nonneg (hF _) (Nat.cast_nonneg _))

end
end ShortAP

end

section

namespace ShortAP
open Finset
noncomputable section

def primitiveErrorMass (d : ℕ) (y h : ℝ) : ℝ :=
  ∑ ψ ∈ primitiveChars d, ‖centeredPrimeSum ψ y h‖

/-- Replacing all progressions by primitive twists and charging their multiples
costs at most a logarithm squared, with no y-dependent or conductor-dependent constant. -/
theorem sum_err_le_primitive_mean (Q : ℕ) {h y : ℝ} (hQ : (Q : ℝ) ≤ y) (hh : 0 ≤ h) :
    (∑ q ∈ Icc 1 Q, err q h y) ≤
      (∑ d ∈ Icc 1 Q, primitiveErrorMass d y h / (d.totient : ℝ)) * (1+Real.log Q)^2 := by
  classical
  apply le_trans _ (sum_conductor_weights Q (fun d => primitiveErrorMass d y h)
    (fun _ => sum_nonneg fun _ _ => norm_nonneg _))
  apply sum_le_sum
  intro q hq
  have : NeZero q := ⟨by have := (mem_Icc.mp hq).1; omega⟩
  have hqy : (q : ℝ) ≤ y := (Nat.cast_le.mpr (mem_Icc.mp hq).2).trans hQ
  have H := err_le_primitive_conductor_mean (q := q) hqy hh
  convert H using 1
  exact congrArg (fun u : ℝ => u / q.totient)
    (Finset.sum_attach q.divisors (fun d => primitiveErrorMass d y h)).symm

theorem frozen_sum_err_le_primitive_mean {x t y : ℝ} (hx : 1 ≤ x) (ht : t ≤ 1)
    (hy : x ≤ y) (Q : ℕ) (hQ : 1 ≤ Q)
    (hsize : (Q : ℝ)^2 * x^((1-t)/3+(1:ℝ)/16) ≤ x^t) :
    (∑ q ∈ Icc 1 Q, err q (x^t) y) ≤
      (∑ d ∈ Icc 1 Q, primitiveErrorMass d y (x^t) / (d.totient : ℝ)) *
        (1+Real.log Q)^2 := by
  have hx0 : 0 ≤ x := by linarith
  have hQ' : 1 ≤ (Q : ℝ) := by exact_mod_cast hQ
  have hpow : 1 ≤ x^((1-t)/3+(1:ℝ)/16) := Real.one_le_rpow hx (by linarith)
  have hqx : (Q:ℝ) ≤ x := calc
    _ ≤ (Q:ℝ)^2 := by nlinarith [sq_nonneg ((Q:ℝ)-1)]
    _ ≤ (Q:ℝ)^2*x^((1-t)/3+(1:ℝ)/16) := le_mul_of_one_le_right (sq_nonneg _) hpow
    _ ≤ x^t := hsize
    _ ≤ x := by simpa using Real.rpow_le_rpow_of_exponent_le hx ht
  exact sum_err_le_primitive_mean Q (hqx.trans hy) (Real.rpow_nonneg hx0 _)

end
end ShortAP

end

