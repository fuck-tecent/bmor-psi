private def exceptions : List ℕ := [7564, 7909, 11134, 11329, 11989, 12154]

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem bank_le {t : ℕ} (ht : t ∈ bank) : t ≤ 60269 := by
  have all : bank.all (fun t => decide (t ≤ 60269)) = true := by decide +kernel
  exact of_decide_eq_true (List.all_eq_true.mp all t ht)

private def checked : ℕ → List ℕ → Bool
  | _, [] => true
  | i, w :: rest =>
    decide (i ∈ exceptions ∨ (w ∈ bank ∧ Rfc11SmallPrime.check (w - 2*i) = true)) && checked (i+1) rest

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem checked_sound (start : ℕ) (rows : List ℕ)
    (h : checked start rows = true) (i : ℕ) (hlo : start ≤ i) (hhi : i < start + rows.length) :
    i ∈ exceptions ∨ ∃ t ∈ bank, Nat.Prime (t - 2*i) := by
  induction rows generalizing start with
  | nil => simp at hhi; omega
  | cons w rest ih =>
    simp only [checked, Bool.and_eq_true, decide_eq_true_eq] at h
    by_cases he : i=start
    · subst i
      rcases h.1 with hex | hw
      · exact Or.inl hex
      · have cap : w - 2*start ≤ 60269 := (Nat.sub_le _ _).trans (bank_le hw.1)
        exact Or.inr ⟨w, hw.1, (Rfc11SmallPrime.check_correct cap).mp hw.2⟩
    · exact ih (start+1) h.2 (by omega) (by simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hhi)

private def noWitness (i : ℕ) : Bool :=
  bank.all (fun t => !(Rfc11SmallPrime.check (t - 2*i)))

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem noWitness_sound (i : ℕ) (h : noWitness i = true) :
    ¬ (∃ t ∈ bank, Nat.Prime (t - 2*i)) := by
  rintro ⟨t, ht, hp⟩
  have cap : t - 2*i ≤ 60269 := (Nat.sub_le _ _).trans (bank_le ht)
  have primeCheck := (Rfc11SmallPrime.check_correct cap).2 hp
  have hNot : !(Rfc11SmallPrime.check (t - 2*i)) = true := List.all_eq_true.mp h t ht
  simp [primeCheck] at hNot

set_option maxRecDepth 180000 in
set_option maxHeartbeats 0 in
private theorem exception_cases (i : ℕ) (hi : i ∈ exceptions) :
    ¬ (∃ t ∈ bank, Nat.Prime (t - 2*i)) := by
  apply noWitness_sound i
  simp only [exceptions, List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

