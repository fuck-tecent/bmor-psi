namespace GoldbachPintzDetector

open Finset Complex MeasureTheory
open GoldbachPintzTheta GoldbachSieveSeries GoldbachCubicRiesz

noncomputable section

def support (X : ℝ) : Finset ℕ := Icc 1 ⌊X⌋₊

def coefficient {q : ℕ} (χ : DirichletCharacter ℂ q) (U V W : ℝ) (θ : ℕ → ℝ) :
    ℕ → ℂ :=
  (fun n : ℕ => χ n) * sieveProduct (support V) (support W)
    (fun d => (barbanVehov U V d : ℂ)) (fun d => (θ d : ℂ))

def polynomial {q : ℕ} (χ : DirichletCharacter ℂ q) (U V W : ℝ) (θ : ℕ → ℝ)
    (s : ℂ) : ℂ :=
  ∑ r ∈ lcmSupport (support V) (support W),
    LSeries.term ((fun n : ℕ => χ n) * lcmWeight (support V) (support W)
      (fun d => (barbanVehov U V d : ℂ)) (fun d => (θ d : ℂ))) s r

def rieszWeight (Y : ℝ) (n : ℕ) : ℝ := max (1 - (n : ℝ) / Y) 0 ^ 2

def differenceWeight (Y Z : ℝ) (n : ℕ) : ℝ := rieszWeight Y n - rieszWeight Z n

private theorem cutoff_eq_sum_weight (f : ℕ → ℂ) {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z ≤ Y) :
    cutoffSum f Z = ∑ n ∈ support Y, f n * (rieszWeight Z n : ℂ) := by
  classical
  have heq : Finset.Ioc 0 ⌊Z⌋₊ = support Z := by
    ext n
    simp only [support, mem_Ioc, mem_Icc]
    omega
  have hsub : support Z ⊆ support Y := Finset.Icc_subset_Icc_right (Nat.floor_mono hZY)
  unfold cutoffSum
  rw [heq]
  calc
    _ = ∑ n ∈ support Z, f n * (rieszWeight Z n : ℂ) := by
      apply sum_congr rfl
      intro n hn
      have hnZ : (n : ℝ) ≤ Z := (Nat.le_floor_iff hZ.le).mp (mem_Icc.mp hn).2
      rw [rieszWeight, max_eq_left (sub_nonneg.mpr ((div_le_one hZ).mpr hnZ))]
      push_cast
      rfl
    _ = _ := by
      refine sum_subset hsub fun n hn hnZ => ?_
      have hlt : Z < (n : ℝ) := lt_of_not_ge fun h =>
        hnZ (mem_Icc.mpr ⟨(mem_Icc.mp hn).1, Nat.le_floor h⟩)
      have ht : 1 < (n : ℝ) / Z := (one_lt_div hZ).mpr hlt
      simp [rieszWeight, max_eq_right (sub_nonpos.mpr ht.le)]

theorem differenceWeight_bounds {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z ≤ Y) (n : ℕ) :
    0 ≤ differenceWeight Y Z n ∧ differenceWeight Y Z n ≤ 1 := by
  have hdiv : (n : ℝ) / Y ≤ (n : ℝ) / Z := div_le_div_of_nonneg_left (Nat.cast_nonneg _) hZ hZY
  have hmon : max (1 - (n : ℝ) / Z) 0 ≤ max (1 - (n : ℝ) / Y) 0 :=
    max_le_max (sub_le_sub_left hdiv _) le_rfl
  have hupper : max (1 - (n : ℝ) / Y) 0 ≤ 1 :=
    max_le (sub_le_self _ (div_nonneg (Nat.cast_nonneg _) (hZ.trans_le hZY).le)) zero_le_one
  have h₀ : 0 ≤ max (1 - (n : ℝ) / Z) 0 := le_max_right _ _
  have h₁ : 0 ≤ max (1 - (n : ℝ) / Y) 0 := le_max_right _ _
  constructor
  · exact sub_nonneg.mpr (pow_le_pow_left₀ h₀ hmon 2)
  · have hsq := pow_le_pow_left₀ h₁ hupper 2
    change max (1 - (n : ℝ) / Y) 0 ^ 2 - max (1 - (n : ℝ) / Z) 0 ^ 2 ≤ 1
    nlinarith only [hsq, sq_nonneg (max (1 - (n : ℝ) / Z) 0)]

theorem cutoff_sub_eq_difference (f : ℕ → ℂ) {Z Y : ℝ} (hZ : 0 < Z) (hZY : Z ≤ Y) :
    cutoffSum f Y - cutoffSum f Z =
      ∑ n ∈ support Y, f n * (differenceWeight Y Z n : ℂ) := by
  rw [cutoff_eq_sum_weight f (hZ.trans_le hZY) le_rfl, cutoff_eq_sum_weight f hZ hZY,
    ← sum_sub_distrib]
  simp only [differenceWeight, Complex.ofReal_sub, mul_sub]

private theorem psi_divisorWeight {U V : ℝ} (hU : 0 < U) (hUV : U < V)
    {n : ℕ} (hn : n ≠ 0) :
    divisorWeight (support V) (fun d => (barbanVehov U V d : ℂ)) n =
      ∑ d ∈ n.divisors, (barbanVehov U V d : ℂ) := by
  classical
  unfold divisorWeight
  rw [← sum_filter]
  refine sum_subset (fun d hd => Nat.mem_divisors.mpr ⟨(mem_filter.mp hd).2,hn⟩) ?_
  intro d hd hdn
  have hd' : V < (d : ℝ) := lt_of_not_ge fun h =>
    hdn (mem_filter.mpr ⟨mem_Icc.mpr ⟨Nat.pos_of_mem_divisors hd,Nat.le_floor h⟩,
      Nat.dvd_of_mem_divisors hd⟩)
  rw [barbanVehov_zero hU.le hUV.le hd', Complex.ofReal_zero]

theorem coefficient_one {q : ℕ} (χ : DirichletCharacter ℂ q) {U V W : ℝ} {θ : ℕ → ℝ}
    (hU : 1 ≤ U) (hUV : U < V) (hW : 1 ≤ W) (hθ : θ 1 = 1) :
    coefficient χ U V W θ 1 = 1 := by
  classical
  have hV : 1 ∈ support V := mem_Icc.mpr ⟨le_rfl,Nat.le_floor (hU.trans hUV.le)⟩
  have hW' : 1 ∈ support W := mem_Icc.mpr ⟨le_rfl,Nat.le_floor hW⟩
  simp [coefficient, sieveProduct, divisorWeight, Nat.dvd_one, hV, hW', hθ,
    barbanVehov_one hU hUV]

theorem coefficient_eq_zero {q : ℕ} (χ : DirichletCharacter ℂ q) {U V W : ℝ}
    (θ : ℕ → ℝ) (hU : 0 < U) (hUV : U < V) {n : ℕ} (hn : 1 < n) (hnU : (n : ℝ) ≤ U) :
    coefficient χ U V W θ n = 0 := by
  have hψ := barbanVehov_divisor_sum_zero hU hUV hn hnU
  unfold coefficient sieveProduct
  rw [Pi.mul_apply, psi_divisorWeight hU hUV (zero_lt_one.trans hn).ne']
  have hs : (∑ d ∈ n.divisors, (barbanVehov U V d : ℂ)) = 0 := by
    exact_mod_cast hψ
  rw [hs, zero_mul, mul_zero]

/-- The short Riesz sum is exactly its term at one. -/
theorem cutoff_short {q : ℕ} (χ : DirichletCharacter ℂ q) {U V W Z : ℝ} {θ : ℕ → ℝ}
    (hZ : 1 ≤ Z) (hZU : Z ≤ U) (hUV : U < V) (hW : 1 ≤ W) (hθ : θ 1 = 1)
    (ρ : ℂ) :
    cutoffSum (LSeries.term (coefficient χ U V W θ) ρ) Z = (1 - 1 / (Z : ℂ)) ^ 2 := by
  classical
  have hz : 0 < Z := zero_lt_one.trans_le hZ
  rw [cutoff_eq_sum_weight _ hz le_rfl]
  have h1 : 1 ∈ support Z := mem_Icc.mpr ⟨le_rfl,Nat.le_floor hZ⟩
  rw [sum_eq_single_of_mem 1 h1]
  · simp only [LSeries.term_of_ne_zero one_ne_zero, Nat.cast_one, one_cpow, div_one,
      coefficient_one χ (hZ.trans hZU) hUV hW hθ, one_mul, rieszWeight]
    rw [max_eq_left (sub_nonneg.mpr ((div_le_one hz).mpr hZ))]
    push_cast
    rfl
  · intro n hn hne
    have h1 : 1 < n := lt_of_le_of_ne (mem_Icc.mp hn).1 (Ne.symm hne)
    have hnZ := (Nat.le_floor_iff hz.le).mp (mem_Icc.mp hn).2
    simp [LSeries.term_of_ne_zero (zero_lt_one.trans h1).ne',
      coefficient_eq_zero χ θ (hz.trans_le hZU) hUV h1 (hnZ.trans hZU)]

theorem differentiable_polynomial {q : ℕ} (χ : DirichletCharacter ℂ q)
    (U V W : ℝ) (θ : ℕ → ℝ) : Differentiable ℂ (polynomial χ U V W θ) := by
  unfold polynomial
  apply Differentiable.fun_sum
  intro r _
  by_cases hr : r = 0
  · subst r
    simpa only [LSeries.term_zero] using (differentiable_const (c := (0 : ℂ)))
  · simp only [LSeries.term_of_ne_zero hr]
    exact Differentiable.div (differentiable_const _) (differentiable_id.const_cpow (.inl (Nat.cast_ne_zero.mpr hr)))
      (fun s => cpow_ne_zero_iff.mpr (.inl (Nat.cast_ne_zero.mpr hr)))

/-- Exact contour identity at a zero of a nonprincipal L-function, with
the finite Pintz weights and the left line at real part one half. -/
theorem cutoff_eq_mellinInv {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1)
    {ρ : ℂ} (hρ : χ.LFunction ρ = 0) (hlo : 3/4 ≤ ρ.re) (hhi : ρ.re ≤ 1)
    (U V W : ℝ) (θ : ℕ → ℝ) {Y B : ℝ} (hY : 1 ≤ Y) (hB : 0 ≤ B)
    (hpoly : ∀ s : ℂ, (1/2 : ℝ) ≤ s.re → ‖polynomial χ U V W θ s‖ ≤ B) :
    cutoffSum (LSeries.term (coefficient χ U V W θ) ρ) Y =
      mellinInv (1/2 - ρ.re) (fun w => (polynomial χ U V W θ (ρ+w) *
        χ.LFunction (ρ+w)) * symbol w) (1/Y) := by
  let a := (1/2 : ℝ) - ρ.re
  let A := Y * (6*(q : ℝ)*(1+‖ρ‖+1)*B)
  let H (w : ℂ) := polynomial χ U V W θ (ρ+w) * χ.LFunction (ρ+w)
  have hshift : Differentiable ℂ (fun w : ℂ => ρ+w) := by fun_prop
  have hH : Differentiable ℂ H := ((differentiable_polynomial χ U V W θ).comp hshift).mul
    ((DirichletCharacter.differentiable_LFunction hχ).comp hshift)
  have hz : H 0 = 0 := by simp [H,hρ]
  have hYS : 0 < Y := zero_lt_one.trans_le hY
  have hA : 0 ≤ A := by unfold A; positivity
  have hb : LSeriesSummable (coefficient χ U V W θ) (ρ+1) := by
    apply sieveProduct_summable
    simp only [add_re,one_re]
    linarith
  have hg (x : ℝ) (hx : x ∈ Set.Icc a 1) (t : ℝ) (_ : 1 ≤ |t|) :
      ‖(Y : ℂ)^((x : ℂ)+t*I) * H ((x : ℂ)+t*I)‖ ≤ A*(1+|t|) := by
    have hxa : (1/2 : ℝ) - ρ.re ≤ x := hx.1
    have hx' : |x| ≤ 1 := abs_le.mpr ⟨by linarith, hx.2⟩
    have hr : (1/2 : ℝ) ≤ ρ.re+x := by linarith
    have hm := shifted_product_linear_growth hχ ρ (polynomial χ U V W θ)
      hB (show (0:ℝ) ≤ 1 by norm_num) hpoly hx' hr (t := t)
    have hyPow : ‖(Y : ℂ)^((x : ℂ)+t*I)‖ ≤ Y := by
      rw [norm_cpow_eq_rpow_re_of_pos hYS, show (((x : ℂ)+t*I) : ℂ).re = x by simp [mul_re]]
      simpa using Real.rpow_le_rpow_of_exponent_le hY hx.2
    rw [norm_mul]
    calc
      _ ≤ Y * ((6*(q : ℝ)*(1+‖ρ‖+1)*B)*(1+|t|)) :=
        mul_le_mul hyPow (by simpa [H,mul_comm] using hm) (norm_nonneg _) hYS.le
      _ = _ := by dsimp [A]; ring
  have hright (t : ℝ) :
      H ((1 : ℂ)+t*I) = LSeries (coefficient χ U V W θ) (ρ+((1 : ℂ)+t*I)) := by
    have hs : 1 < (ρ+((1 : ℂ)+t*I)).re := by simp [add_re,mul_re]; linarith
    exact (sieveProduct_LSeries χ (support V) (support W) _ _ hs).symm
  exact (compact_riesz_shift hH hz (by dsimp [a]; linarith) (by dsimp [a]; linarith)
    hYS hA hg _ ρ hb hright).symm

end
end GoldbachPintzDetector


namespace GoldbachPintzDetector

open Finset Complex MeasureTheory Filter
open GoldbachPintzTheta GoldbachSieveSeries GoldbachCubicRiesz GoldbachTypeII

noncomputable section

/-- The absolute mass of the finite LCM polynomial on the critical line. -/
def polynomialBound {q : ℕ} (χ : DirichletCharacter ℂ q) (U V W : ℝ) (θ : ℕ → ℝ) : ℝ :=
  ∑ r ∈ lcmSupport (support V) (support W),
    ‖((fun n : ℕ => χ n) * lcmWeight (support V) (support W)
      (fun d => (barbanVehov U V d : ℂ)) (fun d => (θ d : ℂ))) r‖ / Real.sqrt (r : ℝ)

theorem norm_polynomial_le_bound {q : ℕ} (χ : DirichletCharacter ℂ q)
    (U V W : ℝ) (θ : ℕ → ℝ) {s : ℂ} (hs : (1/2 : ℝ) ≤ s.re) :
    ‖polynomial χ U V W θ s‖ ≤ polynomialBound χ U V W θ := by
  unfold polynomial polynomialBound
  refine (norm_sum_le _ _).trans (sum_le_sum fun r _ => ?_)
  by_cases hr : r = 0
  · subst r
    simp
  have hrR : (0 : ℝ) < r := by exact_mod_cast Nat.pos_of_ne_zero hr
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast Nat.pos_of_ne_zero hr
  have hnorm : ‖(r : ℂ)^s‖ = (r : ℝ)^s.re := by
    simpa only [Complex.ofReal_natCast] using norm_cpow_eq_rpow_re_of_pos (y := s) hrR
  rw [LSeries.term_of_ne_zero hr, norm_div, hnorm]
  apply div_le_div_of_nonneg_left (norm_nonneg _) (Real.sqrt_pos.mpr hrR)
  rw [Real.sqrt_eq_rpow]
  exact Real.rpow_le_rpow_of_exponent_le hr1 hs

private theorem criticalMollified_one {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (t : ℝ) :
    criticalMollified χ 1 t = χ.LFunction (((1/2 : ℝ) : ℂ)+(t : ℂ)*I) := by
  dsimp only [criticalMollified]
  rw [mollifier_eq_sum]
  simp [LSeries.term, truncatedMoebius]

/-- The weighted absolute critical-line mass used by the left contour. -/
def criticalIntegral {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (γ : ℝ) : ℝ :=
  ∫ t : ℝ, cubicWeight t γ * ‖χ.LFunction (((1/2 : ℝ) : ℂ)+(t : ℂ)*I)‖

theorem cutoff_norm_le_criticalIntegral {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1)
    {ρ : ℂ} (hρ : χ.LFunction ρ = 0) (hlo : 3/4 ≤ ρ.re) (hhi : ρ.re ≤ 1)
    (U V W : ℝ) (θ : ℕ → ℝ) {Y B : ℝ} (hY : 1 ≤ Y) (hB : 0 ≤ B)
    (hpoly : ∀ s : ℂ, (1/2 : ℝ) ≤ s.re → ‖polynomial χ U V W θ s‖ ≤ B) :
    ‖cutoffSum (LSeries.term (coefficient χ U V W θ) ρ) Y‖ ≤
      (250 * B * Y ^ (1/2 - ρ.re)) * criticalIntegral χ ρ.im := by
  rw [cutoff_eq_mellinInv hχ hρ hlo hhi U V W θ hY hB hpoly]
  let a : ℝ := 1/2 - ρ.re
  let weight (u : ℝ) : ℝ :=
    cubicWeight u ρ.im * ‖χ.LFunction (((1/2 : ℝ) : ℂ)+(u : ℂ)*I)‖
  let f (v : ℝ) : ℂ :=
    let w := (a : ℂ) + v*I
    ((1/Y : ℝ) : ℂ)^(-w) * ((polynomial χ U V W θ (ρ+w) * χ.LFunction (ρ+w)) * symbol w)
  let C : ℝ := 250 * B * Y^a
  have hY' : 0 < Y := zero_lt_one.trans_le hY
  have hI : Integrable weight := by
    simpa only [weight, criticalMollified_one] using weighted_criticalMollified_integrable hχ 1 ρ.im
  have hG : Integrable (fun v => C * weight (v + ρ.im)) := by
    have hshift := measurePreserving_add_right (volume : Measure ℝ) ρ.im
    change Integrable ((fun u => C * weight u) ∘ fun v => v + ρ.im)
    exact hshift.integrable_comp_of_integrable (hI.const_mul C)
  have hbound (v : ℝ) : ‖f v‖ ≤ C * weight (v + ρ.im) := by
    let w : ℂ := (a : ℂ) + v*I
    have hw : w.re = a := by simp [w, Complex.mul_re]
    have hshift : ρ+w = ((1/2 : ℝ) : ℂ) + ((v+ρ.im : ℝ) : ℂ)*I := by
      apply Complex.ext
      · simp [w, a, Complex.mul_re]
      · simp [w, a, Complex.mul_im, add_comm]
    have hp : ‖((1/Y : ℝ) : ℂ)^(-w)‖ = Y^a := by
      rw [norm_cpow_eq_rpow_re_of_pos (one_div_pos.mpr hY'), Complex.neg_re, hw,
        Real.div_rpow zero_le_one hY'.le, Real.one_rpow, Real.rpow_neg hY'.le, one_div, inv_inv]
    have hs : ‖symbol w‖ ≤ 250*cubicWeight (v+ρ.im) ρ.im := by
      have hs := symbol_left_bound (a := a) (t := v) (by dsimp [a]; linarith)
        (by dsimp [a]; linarith)
      have ha : ρ.im - (v+ρ.im) = -v := by ring
      simpa [w, cubicWeight, ha, div_eq_mul_inv] using hs
    have hM := hpoly (ρ+w) (by rw [hshift]; simp [mul_re])
    change ‖((1/Y : ℝ) : ℂ)^(-w) *
      ((polynomial χ U V W θ (ρ+w) * χ.LFunction (ρ+w))*symbol w)‖ ≤ _
    simp only [norm_mul, hp]
    calc
      _ ≤ Y^a * ((B*‖χ.LFunction (ρ+w)‖)*(250*cubicWeight (v+ρ.im) ρ.im)) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        exact mul_le_mul (mul_le_mul_of_nonneg_right hM (norm_nonneg _)) hs
          (norm_nonneg _) (mul_nonneg hB (norm_nonneg _))
      _ = _ := by rw [hshift]; dsimp only [C, weight]; ring
  have hnorm : ‖∫ v, f v‖ ≤ C * ∫ u, weight u := by
    apply (norm_integral_le_of_norm_le hG (Eventually.of_forall hbound)).trans_eq
    rw [integral_const_mul, integral_add_right_eq_self weight ρ.im]
  have hconst : (1/(2*Real.pi) : ℝ) ≤ 1 := by
    apply (div_le_one (by positivity)).mpr
    linarith [Real.pi_gt_three]
  have hnonneg : 0 ≤ (1/(2*Real.pi) : ℝ) := by positivity
  change ‖(((1/(2*Real.pi) : ℝ) : ℂ) • ∫ v, f v)‖ ≤ C * ∫ u, weight u
  rw [smul_eq_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hnonneg]
  exact (mul_le_of_le_one_left (norm_nonneg _) hconst).trans hnorm

/-- At a zero the short normalization forces either the finite compact
sum or the weighted critical-line integral to be large. -/
theorem compact_detector_lower {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1)
    {ρ : ℂ} (hρ : χ.LFunction ρ = 0) (hlo : 3/4 ≤ ρ.re) (hhi : ρ.re ≤ 1)
    {U V W Y Z B : ℝ} {θ : ℕ → ℝ}
    (hZ : 2 ≤ Z) (hZU : Z ≤ U) (hUV : U < V) (hW : 1 ≤ W) (hθ : θ 1 = 1)
    (hZY : Z ≤ Y) (hB : 0 ≤ B)
    (hpoly : ∀ s : ℂ, (1/2 : ℝ) ≤ s.re → ‖polynomial χ U V W θ s‖ ≤ B) :
    (1/4 : ℝ) ≤
      ‖∑ n ∈ support Y, LSeries.term (coefficient χ U V W θ) ρ n *
        (differenceWeight Y Z n : ℂ)‖ +
      (250 * B * Y ^ (1/2 - ρ.re)) * criticalIntegral χ ρ.im := by
  have hz1 : 1 ≤ Z := by linarith
  have hcut := cutoff_norm_le_criticalIntegral hχ hρ hlo hhi U V W θ (hz1.trans hZY) hB hpoly
  let F := LSeries.term (coefficient χ U V W θ) ρ
  have hdiff := cutoff_sub_eq_difference F (zero_lt_one.trans_le hz1) hZY
  have hs := cutoff_short χ hz1 hZU hUV hW hθ ρ
  have hZpos : 0 < Z := by linarith
  have hratio : 1 / Z ≤ (1/2 : ℝ) := one_div_le_one_div_of_le (by norm_num) hZ
  have hhalf : (1/2 : ℝ) ≤ 1 - 1/Z := by linarith
  have hn : (1/4 : ℝ) ≤ ‖cutoffSum F Z‖ := by
    have he : (1-1/(Z : ℂ))^2 = (((1-1/Z)^2 : ℝ) : ℂ) := by push_cast; rfl
    rw [hs, he, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    nlinarith [pow_le_pow_left₀ (show (0 : ℝ) ≤ 1/2 by norm_num) hhalf 2]
  rw [← hdiff]
  calc
    _ ≤ ‖cutoffSum F Z‖ := hn
    _ = ‖cutoffSum F Y - (cutoffSum F Y - cutoffSum F Z)‖ := by
      congr 1
      ring
    _ ≤ ‖cutoffSum F Y‖ + ‖cutoffSum F Y - cutoffSum F Z‖ := norm_sub_le _ _
    _ ≤ _ := by rw [add_comm]; exact add_le_add_right hcut _

end
end GoldbachPintzDetector


namespace GoldbachPintzDetector

open Finset
open GoldbachPintzTheta GoldbachSieveSeries

/-- Absolute coefficient mass is bounded by the inverse square roots of
the least common multiples in the two sieve ranges. -/
theorem polynomialBound_le_inverse_sqrt_lcm {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {U V W : ℝ} {θ : ℕ → ℝ}
    (hU : 0 < U) (hUV : U < V) (hθ : ∀ d, |θ d| ≤ 1) :
    polynomialBound χ U V W θ ≤
      ∑ d ∈ support V, ∑ e ∈ support W, 1 / Real.sqrt ((d.lcm e : ℕ) : ℝ) := by
  classical
  let D := support V
  let E := support W
  let u := fun d => (barbanVehov U V d : ℂ)
  let v := fun d => (θ d : ℂ)
  let S := lcmSupport D E
  have hmass (r : ℕ) :
      ‖((fun n : ℕ => χ n) * lcmWeight D E u v) r‖ / Real.sqrt (r : ℝ) ≤
      ∑ d ∈ D, ∑ e ∈ E, if d.lcm e = r then 1 / Real.sqrt (r : ℝ) else 0 := by
    have hrs : 0 ≤ Real.sqrt (r : ℝ) := Real.sqrt_nonneg _
    have hu (d : ℕ) : ‖u d‖ ≤ 1 := by
      simpa only [u, Complex.norm_real, Real.norm_eq_abs] using (abs_barbanVehov_le_one hU hUV d)
    have hv (d : ℕ) : ‖v d‖ ≤ 1 := by simpa [v, Complex.norm_real, Real.norm_eq_abs] using hθ d
    have hχ : ‖(fun n : ℕ => χ n) r‖ ≤ 1 := χ.norm_le_one _
    rw [Pi.mul_apply, norm_mul]
    calc
      _ ≤ ‖lcmWeight D E u v r‖ / Real.sqrt (r : ℝ) :=
        div_le_div_of_nonneg_right (mul_le_of_le_one_left (norm_nonneg _) hχ) hrs
      _ ≤ (∑ d ∈ D, ∑ e ∈ E, ‖if d.lcm e = r then u d * v e else 0‖) / Real.sqrt (r : ℝ) := by
        apply div_le_div_of_nonneg_right _ hrs
        unfold lcmWeight
        exact (norm_sum_le _ _).trans (sum_le_sum fun d _ => norm_sum_le _ _)
      _ ≤ _ := by
        simp_rw [Finset.sum_div]
        apply sum_le_sum
        intro d _
        apply sum_le_sum
        intro e _
        by_cases h : d.lcm e = r
        · simp only [h, ite_true, norm_mul]
          exact div_le_div_of_nonneg_right
            ((mul_le_of_le_one_left (norm_nonneg _) (hu d)).trans (hv e)) hrs
        · simp [h]
  unfold polynomialBound
  change (∑ r ∈ S, ‖((fun n : ℕ => χ n) * lcmWeight D E u v) r‖ / Real.sqrt (r : ℝ)) ≤ _
  calc
    _ ≤ ∑ r ∈ S, ∑ d ∈ D, ∑ e ∈ E,
        if d.lcm e = r then 1 / Real.sqrt (r : ℝ) else 0 := sum_le_sum (fun r _ => hmass r)
    _ = _ := by
      rw [sum_comm]
      apply sum_congr rfl
      intro d hd
      rw [sum_comm]
      apply sum_congr rfl
      intro e he
      have hmem : d.lcm e ∈ S :=
        mem_image.mpr ⟨(d,e),mem_product.mpr ⟨hd,he⟩,rfl⟩
      exact sum_ite_eq_of_mem S (d.lcm e) (fun r : ℕ => 1 / Real.sqrt (r : ℝ)) hmem

end GoldbachPintzDetector

end

