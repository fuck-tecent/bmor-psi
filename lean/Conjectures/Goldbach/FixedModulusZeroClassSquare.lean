def CensusDensityBound (q K : ℕ) [NeZero q] (H R : ℝ) (same : Bool)
    (h b σ₀ : ℝ) : Prop :=
  ∀ T : Finset (ModulusTag q), T⊆repeatTags (modulusZeros q H R) modulusOrder →
    (same=true → OneConductorClass K T) →
    ((∑ t∈T,clippedGapWeight h (modulusGap q t.1.2))≤b) ∧
    ∀ h' : ℝ, h≤h' → (∀ t∈T,h'≤ modulusGap q t.1.2) →
      (∑ t∈T,gapWeight (modulusGap q t.1.2))≤Real.exp (-σ₀*(h'-h))*b

set_option maxHeartbeats 1500000 in
/-- The weighted C or D bound for any selected tags of the actual fixed-modulus
census. For D, different characters have bounded-conductor quotient. -/
theorem eventually_census_density_bound (K : ℕ) (same : Bool)
    {H U w c k h b σ₀ : ℝ} (hH : 0≤H) (hU : 0≤U)
    (hw : 0<w) (hc : 0<c) (hk : 0<k) (hh : 0<h)
    (hB₀ : 0≤b) (hσ₀ : 0≤σ₀)
    (hσ : σ₀ < densityRemaining same w c k 0)
    (hB : rawDensity376 (if same then 1 else 2) w c k h < b) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (R : ℝ), R≤U →
      CensusDensityBound q K H R same h b σ₀ := by
  obtain ⟨η,hη,hσ,hIdeal⟩ := exists_census_density_parameters same hw hc hk hh hσ hB
  obtain ⟨J,hJ⟩ := eventually_fixed_modulus_order_bound hH
  let φ := densityPhi
  let ψ := densityOffDiagonal same η
  let u := densityStart same w η
  let r := densitySpan w c η
  let σ := densityRemaining same w c k η
  let M := b*Real.exp (σ*h)
  let Allowed (q : ℕ) (χ : DirichletCharacter ℂ q) := same=true → χ.conductor≤K.factorial
  have hφ : 3/8<φ := by norm_num [φ,densityPhi]
  have hψ : 0≤ψ := by
    unfold ψ densityOffDiagonal
    split
    · exact hη.le
    · norm_num [densityPhi]
  have hD : φ+c+w<r := by unfold r densitySpan φ; linarith only [hη]
  have hG : ψ+2*w<u := by unfold ψ u densityStart; linarith only [hη]
  have hGrowth : ∃ B : ℝ, 0<B ∧ ∀ (q : ℕ) [NeZero q], ∀ L : ℝ, 1≤L →
      Real.log (q:ℝ)≤L → ∀ χ : DirichletCharacter ℂ q, χ≠1 → Allowed q χ →
      ∀ s : ℂ, s.re=7/8 →
        ‖χ.LFunction s‖≤B*(1+|s.im|)*(1+L)*(q:ℝ)^(ψ*(1/8:ℝ)) := by
    cases hs : same
    · have hψ' : ψ=φ := by simp [ψ,φ,densityOffDiagonal,hs]
      obtain ⟨B,hB,hS⟩ := cd_gram_growth_C hφ
      refine ⟨B,hB,fun q _ L hL hq χ hχ _ s hs'=>?_⟩
      simpa only [hψ'] using hS q L hL hq χ hχ s hs'
    · have hψ' : ψ=η := by simp [ψ,densityOffDiagonal,hs]
      obtain ⟨B,hB,hS⟩ := cd_gram_growth_D hη K.factorial (Nat.factorial_pos K)
      refine ⟨B,hB,fun q _ L hL hq χ hχ hA s hs'=>?_⟩
      simpa only [hψ'] using hS q L hL hq χ hχ (hA hs) s hs'
  obtain ⟨B,hBP,hGrowth⟩ := hGrowth
  have hσP : 0≤σ := hσ₀.trans hσ.le
  have hEq : b=Real.exp (-σ*h)*M := by
    unfold M
    rw [mul_left_comm,←Real.exp_add,show -σ*h+σ*h=0 by ring,Real.exp_zero,mul_one]
  have hM : ((2*r-c)/(2*c))*(1/(w*k))*
      Real.sqrt (densityMomentScalar φ k h)*Real.sqrt (densityMomentScalar φ r h)<M := by
    apply lt_of_mul_lt_mul_right _ (Real.exp_nonneg (-σ*h))
    calc
      _ = densityIdeal same w c k h η := by unfold densityIdeal r φ σ; rfl
      _ < b := hIdeal
      _ = _ := hEq.trans (mul_comm _ _)
  have hLog : Tendsto (fun q : ℕ => Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R:=ℝ))
  have hEvent := hLog.eventually (eventually_cd_raw_moment Allowed
    (φ:=φ) (φoff:=ψ) (u:=u) (w:=w) (c:=c) (r:=r) (κ:=k)
    (H:=H) (T:=U) (J:=(J:ℝ)) (h:=h) (B:=B) (M:=M) (σ:=σ)
    hφ hψ hw hc hk hD hG hH hU (by positivity) hh hBP.le hσP hGrowth hM)
  filter_upwards [hEvent,hJ U hU] with q hA hJq
  intro _ R hRU T hT hC
  have hCount : (∑ p∈modulusZeros q H R,(modulusOrder p:ℝ))≤(J:ℝ) := by
    have he := sum_le_sum_of_subset_of_nonneg (modulusZeros_subset (q:=q) (le_refl H) hRU)
      (f:=fun p=>(modulusOrder p:ℝ)) (fun _ _ _=>by positivity)
    have hJ' : (∑ p∈modulusZeros q H U,(modulusOrder p:ℝ))≤(J:ℝ) := by
      exact_mod_cast hJq
    exact he.trans hJ'
  obtain ⟨hF,hW⟩ := cd_census_rows hT hCount
  have hg : ∀ i∈T, ∀ j∈T, tagCharacter i≠tagCharacter j →
      Allowed q (cdQuotient (tagCharacter i) (tagCharacter j)) :=
    fun i hi j hj hNe he => cd_census_small_quotients (hC he) i hi j hj hNe
  have hSupport (i : ModulusTag q) : cdColumnZeros T tagCharacter tagZero i =
      ((T.filter (fun j => tagCharacter i=tagCharacter j)).image tagZero) := by
    ext z
    simp only [cdColumnZeros,mem_image,mem_filter]
  have hMass := hA q le_rfl T tagCharacter tagZero (census_tag_zero_geometry hT hRU) hg
    (by
      intro i hi z hz
      have hs := hF i hi z ((hSupport i) ▸ hz)
      convert hs using 2)
    (by
      intro i hi
      rw [hSupport]
      exact hW i hi)
  have hPow : 2*(u+r+k)+σ=4.93 := by unfold σ densityRemaining u r; ring
  rw [hPow,←hEq] at hMass
  refine ⟨(by simpa only [clippedGapWeight,gapWeight,tagZero,modulusGap,max_comm] using hMass.1),
    fun h' hh' hMin=>?_⟩
  have hTail : (∑ i∈T,gapWeight (modulusGap q i.1.2))≤Real.exp (-σ*(h'-h))*b := by
    simpa only [gapWeight,tagZero,modulusGap] using hMass.2 h' hh' hMin
  refine hTail.trans ?_
  exact mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr
    (mul_le_mul_of_nonneg_right (neg_le_neg hσ.le) (sub_nonneg.mpr hh'))) hB₀

end
