  simp only [suzukiSupportedBelow, mem_filter]
  constructor
  · rintro ⟨⟨⟨hpS, hpz⟩, hqp⟩, hpp₁⟩
    exact ⟨⟨hpS, hpp₁⟩, hqp⟩
  · rintro ⟨⟨hpS, hpp₁⟩, hqp⟩
    exact ⟨⟨⟨hpS, hpp₁.trans hp₁z⟩, hqp⟩, hpp₁⟩

