namespace GoldbachSignedPairs

open Finset Filter Complex Goldbach GoldbachTwistedMellin DirichletCharacter
open GoldbachPintzFamily GoldbachTypeII GoldbachDensitySlices
open scoped Classical Topology

noncomputable section

theorem mem_fixed_modulus_zeros {q : ℕ} [NeZero q] {H T : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} :
    p∈modulusZeros q H T ↔ p.1≠1 ∧ p.2∈exceptionalZeros p.1 T ∧
      (1-p.2.re)*Real.log (q:ℝ)≤H := by
  rcases p with ⟨χ,z⟩
  simp only [modulusZeros,mem_image,mem_sigma,mem_filter,mem_univ,true_and]
  constructor
  · rintro ⟨⟨ψ,w⟩,⟨hψ,hz,hGap⟩,he⟩
    obtain ⟨rfl,rfl⟩ := Prod.mk.inj he
    exact ⟨hψ,hz,hGap⟩
  · rintro ⟨hχ,hz,hGap⟩
    exact ⟨⟨χ,z⟩,⟨hχ,hz,hGap⟩,rfl⟩

private def packZero (q n : ℕ) (hn : n≠0) (hq : n≤q)
    (ψ : DirichletCharacter ℂ n) (z : ℂ) : TaggedZero q :=
  match n with
  | 0 => (hn rfl).elim
  | m+1 => ⟨⟨⟨m,by omega⟩,ψ⟩,z⟩

private theorem packZero_spec {q n : ℕ} (hn : n≠0) (hq : n≤q)
    (ψ : DirichletCharacter ℂ n) (z : ℂ) :
    naturalColumn (packZero q n hn hq ψ z).1=⟨n,ψ⟩ ∧ (packZero q n hn hq ψ z).2=z := by
  cases n with
  | zero => exact (hn rfl).elim
  | succ m => exact ⟨rfl,rfl⟩

private def fixedToTagged {q : ℕ} [NeZero q] (p : DirichletCharacter ℂ q × ℂ) : TaggedZero q :=
  packZero q p.1.conductor p.1.conductor_ne_zero
    (Nat.le_of_dvd (NeZero.pos q) p.1.conductor_dvd_level) p.1.primitiveCharacter p.2

private theorem fixedToTagged_injective {q : ℕ} [NeZero q] :
    Function.Injective (fixedToTagged (q:=q)) := by
  intro p s h
  have hPack (r : DirichletCharacter ℂ q × ℂ) :
      naturalColumn (fixedToTagged r).1=⟨r.1.conductor,r.1.primitiveCharacter⟩ ∧
        (fixedToTagged r).2=r.2 :=
    packZero_spec _ _ _ _
  let lift (x : Σ n : ℕ,DirichletCharacter ℂ n) : DirichletCharacter ℂ q :=
    if h : x.1∣q then x.2.changeLevel h else 1
  have he : (⟨p.1.conductor,p.1.primitiveCharacter⟩ : Σ n,DirichletCharacter ℂ n)=
      ⟨s.1.conductor,s.1.primitiveCharacter⟩ :=
    (hPack p).1.symm.trans ((congrArg (fun t : TaggedZero q => naturalColumn t.1) h).trans (hPack s).1)
  have hh := congrArg lift he
  simp only [lift,dite_eq_left p.1.conductor_dvd_level,dite_eq_left s.1.conductor_dvd_level,
    changeLevel_primitiveCharacter] at hh
  exact Prod.ext hh ((hPack p).2.symm.trans ((congrArg (fun t : TaggedZero q => t.2) h).trans (hPack s).2))

private theorem packZero_mem_family {q n : ℕ} (hn : n≠0) (hq : n≤q)
    (ψ : DirichletCharacter ℂ n) (z : ℂ) (σ T : ℝ) (hp : ψ.IsPrimitive) (hψ : ψ≠1)
    (hz : let _ : NeZero n := ⟨hn⟩; z∈densityZeros ψ σ T) :
    packZero q n hn hq ψ z∈familyZeroTags q σ T := by
  cases n with
  | zero => exact (hn rfl).elim
  | succ m => exact mem_sigma.mpr ⟨mem_primitiveNonprincipalFamily.mpr ⟨hp,hψ⟩,hz⟩

private theorem fixedToTagged_mem_family {q : ℕ} [NeZero q] {H T : ℝ} (hQ : 1<(q:ℝ))
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H T) :
    fixedToTagged p∈familyZeroTags q (1-H/Real.log (q:ℝ)) T := by
  obtain ⟨hNP,hz,hD⟩ := mem_fixed_modulus_zeros.mp hp
  let _ : NeZero p.1.conductor := ⟨p.1.conductor_ne_zero⟩
  have hc : p.1.primitiveCharacter≠1 := by
    intro h
    apply hNP
    rw [←p.1.changeLevel_primitiveCharacter,h,map_one]
  have hd : 1-H/Real.log (q:ℝ)≤p.2.re := by
    have hL := Real.log_pos hQ
    exact sub_le_comm.mp ((le_div_iff₀ hL).mpr hD)
  have hz₁ := (mem_exceptionalZeros _ _ _).mp hz
  have hz₂ : p.2∈exceptionalZeros p.1.primitiveCharacter T := by
    rwa [← GoldbachWeightedMajorResidual.exceptionalZeros_primitive]
  have hz₃ := (mem_exceptionalZeros _ _ _).mp hz₂
  have hS : p.2.re≤1 := by
    exact le_of_not_gt (fun he => regularizedL_ne_zero_right p.1 he hz₁.2.2)
  refine packZero_mem_family _ _ _ _ _ _ p.1.primitiveCharacter_isPrimitive hc ?_
  exact mem_densityZeros.mpr ⟨hd,hS,hz₃.2.1,hz₃.2.2⟩


private theorem order_packZero {q n : ℕ} [NeZero n] (hq : n≤q)
    (ψ : DirichletCharacter ℂ n) (z : ℂ) :
    order (packZero q n (NeZero.ne n) hq ψ z)=analyticOrderNatAt (regularizedL ψ) z := by
  cases n with
  | zero => exact (NeZero.ne 0 rfl).elim
  | succ n => rfl

private theorem order_fixedToTagged {q : ℕ} [NeZero q] {H R : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R) :
    order (fixedToTagged p)=analyticOrderNatAt (regularizedL p.1) p.2 := by
  obtain ⟨hχ,hz,_⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨hRe,_,hZ⟩ := (mem_exceptionalZeros _ _ _).mp hz
  let _ : NeZero p.1.conductor := ⟨p.1.conductor_ne_zero⟩
  have hn : p.2≠1 := by
    intro he
    rw [he] at hZ
    exact LFunction_ne_zero_of_one_le_re p.1 (s:=1) (Or.inl hχ) (by simp)
      (by simpa only [regularizedL,hχ,ite_false] using hZ)
  unfold fixedToTagged
  rw [order_packZero]
  rw [←GoldbachConductorZeros.changeLevel_regularized_order
    p.1.conductor_dvd_level p.1.primitiveCharacter (by linarith only [hRe]) hn,
    changeLevel_primitiveCharacter]

/-- At a fixed real-gap cap, the total multiplicity of the actual zeros is
bounded uniformly for each fixed height. The bound precedes the height. -/
theorem eventually_fixed_modulus_order_bound {H : ℝ} (hH : 0≤H) :
    ∃ B : ℕ, ∀ T : ℝ, 0≤T → ∀ᶠ q : ℕ in atTop, ∀ [NeZero q],
      (∑ p∈modulusZeros q H T,analyticOrderNatAt (regularizedL p.1) p.2)≤B := by
  obtain ⟨C,hC,hCount⟩ := nonprincipal_logfree_density
  let K := C*Real.exp (((101:ℝ)/25)*H)
  let B := ⌈K⌉₊
  have hK : 0≤K := by dsimp [K]; positivity
  refine ⟨B,?_⟩
  intro T hT
  have hLogAnt : Tendsto (fun q : ℕ => Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hδ : 0<GoldbachPintzScales.loss := by norm_num [GoldbachPintzScales.loss]
  filter_upwards [eventually_ge_atTop (2:ℕ),
    hLogAnt.eventually_ge_atTop (max (H/GoldbachPintzScales.loss) (4*Real.log (T+1)))]
    with q hq hL
  intro zq
  let L := Real.log (q:ℝ)
  let δ := H/L
  have hq2 : (1:ℝ)<q := by exact_mod_cast (show 1<q by omega)
  have hL0 : 0<L := Real.log_pos hq2
  have hδL : δ≤GoldbachPintzScales.loss := by
    apply (div_le_iff₀ hL0).mpr
    simpa only [mul_comm] using (div_le_iff₀ hδ).mp ((le_max_left _ _).trans hL)
  let S := modulusZeros q H T
  let Z := S.image fixedToTagged
  have hZ : Z ⊆ familyZeroTags q (1-δ) T := by
    intro z hz
    obtain ⟨p,hp,rfl⟩ := mem_image.mp hz
    exact fixedToTagged_mem_family hq2 hp
  have hSum := hCount q (by omega) (div_nonneg hH hL0.le) hδL hT Z hZ
  have hSize : (∑ p∈S,(analyticOrderNatAt (regularizedL p.1) p.2:ℝ)) =
      ∑ z∈Z,(order z:ℝ) := by
    rw [show Z=S.image fixedToTagged from rfl,sum_image fixedToTagged_injective.injOn]
    exact sum_congr rfl (fun p hp => congrArg (fun n : ℕ=>(n:ℝ)) (order_fixedToTagged hp).symm)
  have hGrowth : ((q:ℝ)^3*(T+1)^4)^((1+1/100:ℝ)*δ)≤Real.exp ((101/25:ℝ)*H) := by
    have hT₀ : 0<T+1 := by linarith only [hT]
    rw [Real.rpow_def_of_pos (by positivity),Real.log_mul (by positivity) (by positivity),
      Real.log_pow,Real.log_pow]
    apply Real.exp_le_exp.mpr
    have hg : 4*Real.log (T+1)≤L := (le_max_right _ _).trans hL
    have hM : ((3*(L)+4*Real.log (T+1))*((1+1/100:ℝ)*δ)) ≤
        (4*L)*((1+1/100:ℝ)*δ) := mul_le_mul_of_nonneg_right (by linarith only [hg])
      (by dsimp [δ]; positivity)
    convert hM using 1
    dsimp only [δ]
    field_simp [hL0.ne']
    ring
  exact_mod_cast hSize.trans_le (hSum.trans ((mul_le_mul_of_nonneg_left hGrowth hC.le).trans (Nat.le_ceil K)))

theorem eventually_fixed_modulus_count_bound {H : ℝ} (hH : 0≤H) :
    ∃ B : ℕ, ∀ T : ℝ, 0≤T → ∀ᶠ q : ℕ in atTop,
      ∀ [NeZero q], (modulusZeros q H T).card≤B := by
  obtain ⟨B,hB⟩ := eventually_fixed_modulus_order_bound hH
  refine ⟨B,fun T hT=>?_⟩
  filter_upwards [hB T hT] with q h
  intro inst
  refine le_trans ?_ h
  rw [card_eq_sum_ones]
  apply sum_le_sum
  intro p hp
  have hZ := ((mem_exceptionalZeros _ _ _).mp (mem_fixed_modulus_zeros.mp hp).2.1).2.2
  exact (regularizedL_analyticOrderNatAt_pos_iff p.1 p.2).mpr hZ

end
end GoldbachSignedPairs
end

