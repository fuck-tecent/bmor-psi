section

namespace GoldbachLinnik

open Finset Goldbach GoldbachTwistedMellin
open scoped Classical

noncomputable section

/-- Reciprocals summed over occupied bins need only the number of bins. -/
theorem occupied_reciprocal_le_harmonic (S : Finset ℕ) :
    (∑ k ∈ S, 1/(1+(k:ℝ))) ≤ (harmonic S.card : ℝ) := by
  refine Finset.induction_on_max S (by simp) ?_
  intro k I hk ih
  have hkI : k ∉ I := fun h => (lt_irrefl k) (hk k h)
  have hsub : I ⊆ range k := fun j hj => mem_range.mpr (hk j hj)
  have hc : I.card ≤ k := by simpa only [card_range] using card_le_card hsub
  have hc' : (I.card:ℝ) ≤ k := by exact_mod_cast hc
  have hrec : 1/(1+(k:ℝ)) ≤ ((I.card:ℝ)+1)⁻¹ := by
    rw [← one_div ((I.card:ℝ)+1)]
    exact one_div_le_one_div_of_le (by positivity) (by linarith only [hc'])
  rw [sum_insert hkI,card_insert_of_notMem hkI,harmonic_succ,Rat.cast_add,Rat.cast_inv,
    Rat.cast_natCast,Nat.cast_add,Nat.cast_one,add_comm]
  exact add_le_add ih hrec

private theorem occupied_reciprocal_le_log {ι : Type*} (S : Finset ι) (b : ι → ℕ) :
    (∑ k ∈ S.image b, 1/(1+(k:ℝ))) ≤ 1+Real.log (1+(S.card:ℝ)) := by
  let I := S.image b
  by_cases hI : I.Nonempty
  · have hI₀ : (0:ℝ) < I.card := by exact_mod_cast card_pos.mpr hI
    have hc : (I.card:ℝ) ≤ S.card := by exact_mod_cast card_image_le (s:=S) (f:=b)
    exact (occupied_reciprocal_le_harmonic I).trans ((harmonic_le_one_add_log I.card).trans
      (add_le_add le_rfl (Real.log_le_log hI₀ (by linarith only [hc]))))
  · change (∑ k ∈ I, 1/(1+(k:ℝ))) ≤ _
    rw [not_nonempty_iff_eq_empty.mp hI,sum_empty]
    have hl := Real.log_nonneg (show 1 ≤ 1+(S.card:ℝ) from le_add_of_nonneg_right (Nat.cast_nonneg _))
    linarith only [hl]

/-- The harmonic row sum of nonnegative weights with a unit-window mass bound. -/
theorem harmonic_row_le {ι : Type*} (S : Finset ι) (u w : ι → ℝ) {B : ℝ} (hB : 0 ≤ B)
    (hw : ∀ i ∈ S, 0 ≤ w i)
    (hunit : ∀ a : ℝ, (∑ i ∈ S.filter (fun i => a ≤ u i ∧ u i ≤ a+1), w i) ≤ B) :
    (∑ i ∈ S, w i/(1+|u i|)) ≤ (2*B)*(1+Real.log (1+(S.card:ℝ))) := by
  let b (i : ι) := ⌊|u i|⌋₊
  let J := S.image b
  have hmap : (S : Set ι).MapsTo b J := fun i hi => mem_image_of_mem b hi
  have hfloor (i : ι) : (b i:ℝ) ≤ |u i| ∧ |u i| < (b i:ℝ)+1 :=
    ⟨Nat.floor_le (abs_nonneg _),Nat.lt_floor_add_one _⟩
  have hbucket (k : ℕ) : (∑ i ∈ S.filter (fun i => b i = k),w i) ≤ 2*B := by
    let L := S.filter (fun i => -(k:ℝ)-1 ≤ u i ∧ u i ≤ -(k:ℝ)-1+1)
    let R := S.filter (fun i => (k:ℝ) ≤ u i ∧ u i ≤ (k:ℝ)+1)
    have hsub : S.filter (fun i => b i = k) ⊆ L ∪ R := by
      intro i hi
      obtain ⟨hiS,hik⟩ := mem_filter.mp hi
      obtain ⟨hlo,hhi⟩ := hfloor i
      rw [hik] at hlo hhi
      apply mem_union.mpr
      by_cases hsign : 0 ≤ u i
      · rw [abs_of_nonneg hsign] at hlo hhi
        exact Or.inr (mem_filter.mpr ⟨hiS,hlo,hhi.le⟩)
      · rw [abs_of_nonpos (le_of_not_ge hsign)] at hlo hhi
        exact Or.inl (mem_filter.mpr ⟨hiS,by constructor <;> linarith only [hlo,hhi]⟩)
    have hsubLR : L ∪ R ⊆ S := union_subset (filter_subset _ _) (filter_subset _ _)
    have hLR : (∑ i ∈ L ∪ R,w i) ≤ (∑ i ∈ L,w i)+(∑ i ∈ R,w i) := by
      have he := sum_union_inter (s₁:=L) (s₂:=R) (f:=w)
      have hn : 0 ≤ ∑ i ∈ L ∩ R,w i := by
        apply sum_nonneg
        intro i hi
        exact hw i (mem_filter.mp (mem_inter.mp hi).1).1
      linarith only [he,hn]
    calc
      _ ≤ ∑ i ∈ L ∪ R,w i := sum_le_sum_of_subset_of_nonneg hsub (fun i hi _ => hw i (hsubLR hi))
      _ ≤ _ := hLR
      _ ≤ _ := by have hl := hunit (-(k:ℝ)-1); have hr := hunit (k:ℝ); linarith only [hl,hr]
  calc
    _ = ∑ k ∈ J, ∑ i ∈ S.filter (fun i => b i = k),w i/(1+|u i|) :=
      (sum_fiberwise_of_maps_to hmap _).symm
    _ ≤ ∑ k ∈ J, (2*B)*(1/(1+(k:ℝ))) := by
      apply sum_le_sum
      intro k _
      calc
        _ ≤ ∑ i ∈ S.filter (fun i => b i = k),w i*(1/(1+(k:ℝ))) := by
          apply sum_le_sum
          intro i hi
          obtain ⟨hiS,hik⟩ := mem_filter.mp hi
          have h := (hfloor i).1
          rw [hik] at h
          rw [← mul_one_div]
          exact mul_le_mul_of_nonneg_left (one_div_le_one_div_of_le (by positivity)
            (add_le_add le_rfl h)) (hw i hiS)
        _ = (∑ i ∈ S.filter (fun i => b i = k),w i)*(1/(1+(k:ℝ))) := (sum_mul ..).symm
        _ ≤ _ := mul_le_mul_of_nonneg_right (hbucket k) (by positivity)
    _ = (2*B)*(∑ k ∈ J,1/(1+(k:ℝ))) := (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left (occupied_reciprocal_le_log S b) (by positivity)

private theorem logHeight_le_height_bound {q Q : ℕ} [NeZero q] (h : q ≤ Q)
    {a H : ℝ} (hH : 0 ≤ H) (ha : |a| ≤ H) : logHeight q a ≤ logHeight Q H := by
  have hq₀ : 0 < (q:ℝ) := by exact_mod_cast NeZero.pos q
  have hqQ : (q:ℝ) ≤ Q := by exact_mod_cast h
  unfold logHeight
  rw [abs_of_nonneg hH]
  apply Real.log_le_log (by positivity)
  exact mul_le_mul (mul_le_mul_of_nonneg_left hqQ (by norm_num))
    (add_le_add le_rfl ha) (by positivity) (by positivity)

/-- A same-character row in the near-one strip is controlled by the local
zero count and the harmonic sum over occupied ordinate bins. -/
theorem same_character_near_zero_row_le : ∃ C : ℝ, 0 < C ∧
    ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q) (Q : ℕ), q ≤ Q →
      ∀ (δ T t : ℝ), 0 < δ → δ ≤ 1/4 → 0 ≤ T → ∀ S : Finset ℂ,
      (∀ ρ ∈ S, 1-δ ≤ ρ.re ∧ ρ.re ≤ 1 ∧ |ρ.im| ≤ T ∧ regularizedL χ ρ = 0) →
      (∑ ρ ∈ S, (analyticOrderNatAt (regularizedL χ) ρ : ℝ)/(1+|(ρ.im-t)/δ|)) ≤
        C*(1+δ*logHeight Q (T+2))*(1+Real.log (1+(S.card:ℝ))) := by
  obtain ⟨C,hC,hCount⟩ := local_zero_order_le
  refine ⟨2*C,by positivity,?_⟩
  intro q _ χ Q hQ δ T t hδ hδ' hT S hS
  let u (ρ : ℂ) := (ρ.im-t)/δ
  let w (ρ : ℂ) : ℝ := analyticOrderNatAt (regularizedL χ) ρ
  let B := C*(1+δ*logHeight Q (T+2))
  let _ : NeZero Q := ⟨((NeZero.pos q).trans_le hQ).ne'⟩
  have hlog := logHeight_ge_one Q (T+2)
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have hunit (y : ℝ) : (∑ ρ ∈ S.filter (fun ρ => y ≤ u ρ ∧ u ρ ≤ y+1),w ρ) ≤ B := by
    let W := S.filter (fun ρ => y ≤ u ρ ∧ u ρ ≤ y+1)
    let a := t+δ*(y+1/2)
    have hW (ρ : ℂ) (hρ : ρ ∈ W) : |ρ.im-a| ≤ δ/2 := by
      obtain ⟨_,hlo,hhi⟩ := mem_filter.mp hρ
      change y ≤ (ρ.im-t)/δ at hlo
      change (ρ.im-t)/δ ≤ y+1 at hhi
      have h₁ := (le_div_iff₀ hδ).mp hlo
      have h₂ := (div_le_iff₀ hδ).mp hhi
      dsimp only [a]
      exact abs_le.mpr ⟨by nlinarith only [h₁],by nlinarith only [h₂]⟩
    change (∑ ρ ∈ W,w ρ) ≤ B
    by_cases hW₀ : W.Nonempty
    · obtain ⟨ρ,hρ⟩ := hW₀
      have hρS := (mem_filter.mp hρ).1
      have him := abs_le.mp (hS ρ hρS).2.2.1
      have hcen := abs_le.mp (hW ρ hρ)
      have ha : |a| ≤ T+2 := abs_le.mpr
        ⟨by linarith only [him.1,hcen.2,hδ'],by linarith only [him.2,hcen.1,hδ']⟩
      have hcap : (∑ ρ ∈ W,w ρ) ≤ C*(1+δ*logHeight q a) :=
        hCount q χ δ a hδ hδ' W fun z hz => by
          obtain ⟨hl,hu,ht,hz0⟩ := hS z (mem_filter.mp hz).1
          exact ⟨hl,hu,hW z hz,hz0⟩
      apply hcap.trans
      exact mul_le_mul_of_nonneg_left (add_le_add le_rfl
        (mul_le_mul_of_nonneg_left (logHeight_le_height_bound hQ (by linarith only [hT]) ha) hδ.le)) hC.le
    · rw [not_nonempty_iff_eq_empty.mp hW₀,sum_empty]
      exact hB
  have h := harmonic_row_le S u w hB (fun _ _ => Nat.cast_nonneg _) hunit
  exact h.trans_eq (by dsimp only [B]; ring)

end
end GoldbachLinnik

end

section

namespace GoldbachPintzDiagonal

open Complex Finset Goldbach GoldbachTwistedMellin GoldbachLinnik
open GoldbachCubicRiesz GoldbachSieveSeries GoldbachPintzHalasz GoldbachPintzCharacters
open GoldbachPintzTheta GoldbachPintzDetector
open scoped ComplexConjugate

noncomputable section

private theorem min_residue_kernel_le {Y U : ℝ} (hU : 1 ≤ U) (hUY : U ≤ Y)
    (hlog : 0 < Real.log Y) (p : ℂ) :
    min (Real.log (Y/U)) (2/‖p‖) ≤
      4*Real.log Y/(1+|p.im| *Real.log Y) := by
  have hUp : 0 < U := zero_lt_one.trans_le hU
  have hYp : 0 < Y := hUp.trans_le hUY
  have hden : 0 < 1+|p.im| *Real.log Y := by positivity
  have hlogdiv : Real.log (Y/U) ≤ Real.log Y := by
    rw [Real.log_div hYp.ne' hUp.ne']
    exact sub_le_self _ (Real.log_nonneg hU)
  by_cases hsmall : |p.im| *Real.log Y ≤ 1
  · refine ((min_le_left _ _).trans hlogdiv).trans ((le_div_iff₀ hden).mpr ?_)
    have hh := mul_le_mul_of_nonneg_left (show 1+|p.im| *Real.log Y ≤ 4 by linarith) hlog.le
    nlinarith only [hh]
  · have hbig : 1 < |p.im| *Real.log Y := lt_of_not_ge hsmall
    have hi : 0 < |p.im| := by
      by_contra! hn
      have h0 : |p.im| = 0 := le_antisymm hn (abs_nonneg _)
      rw [h0,zero_mul] at hbig
      norm_num at hbig
    calc
      _ ≤ 2/‖p‖ := min_le_right _ _
      _ ≤ 2/|p.im| := div_le_div_of_nonneg_left (by norm_num) hi (Complex.abs_im_le_norm p)
      _ ≤ _ := (div_le_div_iff₀ hi hden).mpr (by nlinarith only [hbig])

set_option maxHeartbeats 900000 in
/-- Bound one same-character Gram entry by its principal residue envelope
and the shorter-cutoff left-line error. -/
theorem same_character_gram_entry_le {ε L : ℝ} (hε : 0 < ε) (hL : 0 ≤ L) :
    ∃ E : ℝ, 0 < E ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q)
      {δ T W Y U d : ℝ} (ρ ω : ℂ), 0 ≤ δ → δ ≤ 1/8 →
      1-δ ≤ ρ.re → ρ.re < 1 → 1-δ ≤ ω.re → ω.re < 1 →
      |ρ.im| ≤ T → |ω.im| ≤ T → 1 < W → 0 < Real.log Y →
      Real.log Y ≤ L*Real.log W → 1 ≤ U → U ≤ Y →
      0 < d → (Real.log Y)⁻¹ ≤ d →
      ∀ (θ : ℕ → ℝ), (∀ j, |θ j| ≤ 1) →
      (((q^2 : ℕ).totient : ℝ)/((q^2 : ℕ) : ℝ))*quadratic (Icc 1 ⌊W⌋₊) θ (q^2) ≤
        16/Real.log W →
      ‖gramSum (support Y) (differenceWeight Y U) (realDivisorWeight (Icc 1 ⌊W⌋₊) θ)
        (fun n => χ (n : ZMod q)) (fun n => χ (n : ZMod q)) ρ ω‖ ≤
      64*(L+1)*Y^(2*δ)/(1+|(ω.im-ρ.im)/d|) +
        E*W*U^(-(1/2 : ℝ)+2*δ)*(q : ℝ)^ε*(1+2*T)^(1/2 : ℝ) := by
  obtain ⟨E,hE,hLeft⟩ := principal_gram_sub_residue_norm_le (half_pos hε)
  refine ⟨E,hE,?_⟩
  intro q _ χ δ T W Y U d ρ ω hδ hδmax hρl hρh hωl hωh hρT hωT hW hlog hratio hU hUY hd hdlog θ hθ hΘ
  let z := conj ρ+ω-1
  let p := 1-z
  let D := Icc 1 ⌊W⌋₊
  let u := fun j => (θ j : ℂ)
  let χ₀ : DirichletCharacter ℂ (q*q) := 1
  let F := cutoffSum (LSeries.term (gramCoefficient χ₀ W θ) z) Y -
    cutoffSum (LSeries.term (gramCoefficient χ₀ W θ) z) U
  let R := gramRieszDifference Y U p * sieveProductPolynomial χ₀ D D u u 1 *
    principalResidueFactor (q*q)
  let J := 1+|(ω.im-ρ.im)/d|
  have hWlog := Real.log_pos hW
  have hY := hU.trans hUY
  have hY₀ := zero_lt_one.trans_le hY
  have hJ : 0 < J := by dsimp only [J]; positivity
  have hT : 0 ≤ T := (abs_nonneg _).trans hρT
  have hzRe : z.re = ρ.re+ω.re-1 := by simp [z]
  have hzIm : z.im = -ρ.im+ω.im := by simp [z]
  have hzl : 3/4 ≤ z.re := by rw [hzRe]; linarith
  have hzh : z.re < 1 := by rw [hzRe]; linarith
  have hzδ : 1-2*δ ≤ z.re := by rw [hzRe]; linarith
  have hzT : |z.im| ≤ 2*T := by
    rw [hzIm]
    have hh := abs_add_le (-ρ.im) ω.im
    rw [abs_neg] at hh
    linarith
  have hpRe : p.re = 1-z.re := by simp [p]
  have hpIm : p.im = ρ.im-ω.im := by simp [p,hzIm]; ring
  have hp₀ : 0 < p.re := by rw [hpRe]; linarith
  have hpδ : p.re ≤ 2*δ := by rw [hpRe]; linarith
  have hp : p ≠ 0 := fun he => hp₀.ne' (by simpa only [zero_re] using congrArg Complex.re he)
  let : NeZero (q*q) := ⟨mul_ne_zero (NeZero.ne q) (NeZero.ne q)⟩
  have hleft' : ‖F-R‖ ≤ E*W*U^(1/2-z.re)*((q*q : ℕ) : ℝ)^(ε/2)*(1+2*T)^(1/2 : ℝ) :=
    hLeft (q*q) (ρ := z) hzl hzh hzT (zero_le_one.trans hW.le) hU hUY θ hθ
  have hqpow : ((q*q : ℕ) : ℝ)^(ε/2) = (q : ℝ)^ε := by
    rw [← pow_two q, Nat.cast_pow, ← Real.rpow_natCast_mul (Nat.cast_nonneg _)]
    congr 1
    push_cast
    ring
  have hleft : ‖F-R‖ ≤ E*W*U^(1/2-z.re)*(q : ℝ)^ε*(1+2*T)^(1/2 : ℝ) := by
    rwa [hqpow] at hleft'
  have hErr : ‖F-R‖ ≤ E*W*U^(-(1/2 : ℝ)+2*δ)*(q : ℝ)^ε*(1+2*T)^(1/2 : ℝ) := by
    refine hleft.trans ?_
    have hPow := Real.rpow_le_rpow_of_exponent_le hU (show 1/2-z.re ≤ -(1/2 : ℝ)+2*δ by linarith)
    have hT' : 0 ≤ 1+2*T := by linarith
    exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hPow (by positivity)) (by positivity))
      (Real.rpow_nonneg hT' _)
  have hres : ‖R‖ ≤ (16/Real.log W)*Y^p.re*min (Real.log (Y/U)) (2/‖p‖) := by
    refine norm_theta_principal_gram_residue_le D (fun j hj => (mem_Icc.mp hj).1) θ ?_
      hU hUY hp₀.le hp
    simpa only [D,pow_two] using hΘ
  have hmul : 1 ≤ d*Real.log Y := (div_le_iff₀ hlog).mp (by simpa only [one_div] using hdlog)
  have hinv : d⁻¹ ≤ Real.log Y := by
    rw [← one_div]
    exact (div_le_iff₀ hd).mpr (by linarith only [hmul])
  have hv : |(ω.im-ρ.im)/d| ≤ |p.im| *Real.log Y := by
    rw [hpIm, abs_sub_comm ρ.im ω.im, abs_div, abs_of_pos hd, div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_left hinv (abs_nonneg _)
  have hmin : min (Real.log (Y/U)) (2/‖p‖) ≤ 4*Real.log Y/J :=
    (min_residue_kernel_le hU hUY hlog p).trans
      (div_le_div_of_nonneg_left (by positivity) hJ (add_le_add_right hv _))
  have hPow := Real.rpow_le_rpow_of_exponent_le hY hpδ
  have hsharp : (16/Real.log W)*(4*Real.log Y) ≤ 64*(L+1) := by
    have hq := (div_le_iff₀ hWlog).mpr hratio
    calc
      _ = 64*(Real.log Y/Real.log W) := by ring
      _ ≤ 64*L := mul_le_mul_of_nonneg_left hq (by norm_num)
      _ ≤ _ := by linarith
  have hRes : ‖R‖ ≤ 64*(L+1)*Y^(2*δ)/J := by
    calc
      _ ≤ ((16/Real.log W)*Y^p.re)*(4*Real.log Y/J) :=
        hres.trans (mul_le_mul_of_nonneg_left hmin (by positivity))
      _ = ((16/Real.log W)*(4*Real.log Y))*Y^p.re/J := by ring
      _ ≤ _ := div_le_div_of_nonneg_right
        (mul_le_mul hsharp hPow (by positivity) (by positivity)) hJ.le
  have hPair : pairCharacter χ χ = χ₀ := by
    unfold pairCharacter χ₀
    exact inv_mul_cancel _
  rw [compact_gramSum_eq_cutoff_sub χ χ (zero_lt_one.trans_le hU) hUY W θ ρ ω, hPair]
  change ‖F‖ ≤ 64*(L+1)*Y^(2*δ)/J + _
  calc
    _ = ‖R+(F-R)‖ := by congr 1; ring
    _ ≤ ‖R‖+‖F-R‖ := norm_add_le _ _
    _ ≤ _ := add_le_add hRes hErr

/-- Same-character diagonal row for the compact Halász matrix, with full
analytic multiplicities and a separate left-line error per zero. -/
theorem same_character_gram_row_le {ε K L : ℝ} (hε : 0 < ε) (hK : 0 ≤ K) (hL : 0 ≤ L) :
    ∃ A E : ℝ, 0 < A ∧ 0 < E ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ ≠ 1 → ∀ (Q : ℕ), q ≤ Q →
      ∀ {δ T W Y U : ℝ}, 0 ≤ δ → δ ≤ 1/8 → 0 ≤ T → 1 < W → 4 ≤ Real.log Y →
      logHeight Q (T+2) ≤ K*Real.log Y → Real.log Y ≤ L*Real.log W →
      1 ≤ U → U ≤ Y → ∀ (θ : ℕ → ℝ), (∀ j, |θ j| ≤ 1) →
      (((q^2 : ℕ).totient : ℝ)/((q^2 : ℕ) : ℝ))*quadratic (Icc 1 ⌊W⌋₊) θ (q^2) ≤
        16/Real.log W →
      ∀ (S : Finset ℂ), (∀ ω ∈ S, 1-δ ≤ ω.re ∧ ω.re < 1 ∧ |ω.im| ≤ T ∧ χ.LFunction ω = 0) →
      ∀ ρ ∈ S,
      (∑ ω ∈ S, (analyticOrderNatAt (regularizedL χ) ω : ℝ) *
        ‖gramSum (support Y) (differenceWeight Y U) (realDivisorWeight (Icc 1 ⌊W⌋₊) θ)
          (fun n => χ (n : ZMod q)) (fun n => χ (n : ZMod q)) ρ ω‖) ≤
        A*Y^(2*δ)*(1+δ*logHeight Q (T+2))*(1+Real.log (1+(S.card : ℝ))) +
        (E*W*U^(-(1/2 : ℝ)+2*δ)*(q : ℝ)^ε*(1+2*T)^(1/2 : ℝ)) *
          ∑ ω ∈ S, (analyticOrderNatAt (regularizedL χ) ω : ℝ) := by
  obtain ⟨E,hE,hEntry⟩ := same_character_gram_entry_le hε hL
  obtain ⟨C,hC,hRow⟩ := same_character_near_zero_row_le
  refine ⟨64*(L+1)*C*(K+1),E,by positivity,hE,?_⟩
  intro q _ χ hχ Q hq δ T W Y U hδ hδmax hT hW hYlog hHeight hRatio hU hUY θ hθ hΘ S hS ρ hρ
  let ℓ := Real.log Y
  let H := logHeight Q (T+2)
  let d := max δ ℓ⁻¹
  let m (ω : ℂ) : ℝ := analyticOrderNatAt (regularizedL χ) ω
  let G (ω : ℂ) := gramSum (support Y) (differenceWeight Y U)
    (realDivisorWeight (Icc 1 ⌊W⌋₊) θ) (fun n => χ (n : ZMod q)) (fun n => χ (n : ZMod q)) ρ ω
  let B := 64*(L+1)*Y^(2*δ)
  let e := E*W*U^(-(1/2 : ℝ)+2*δ)*(q : ℝ)^ε*(1+2*T)^(1/2 : ℝ)
  have hℓ : 0 < ℓ := by dsimp only [ℓ]; linarith
  have hℓ₁ : 4 ≤ ℓ := hYlog
  have hd : 0 < d := (inv_pos.mpr hℓ).trans_le (le_max_right _ _)
  have hd₁ : d ≤ 1/4 := by
    apply max_le (hδmax.trans (by norm_num))
    rw [← one_div]
    exact (div_le_iff₀ hℓ).mpr (by linarith)
  have : NeZero Q := ⟨((NeZero.pos q).trans_le hq).ne'⟩
  have hH : 0 ≤ H := by
    dsimp only [H]
    exact zero_le_one.trans (logHeight_ge_one Q (T+2))
  have hYp : 0 ≤ Y := (zero_le_one.trans hU).trans hUY
  have hBH : 0 ≤ B := by dsimp only [B]; positivity
  have hθRow (ω : ℂ) (hω : ω ∈ S) :
      ‖G ω‖ ≤ B/(1+|(ω.im-ρ.im)/d|)+e := by
    obtain ⟨hρl,hρh,hρT,_⟩ := hS ρ hρ
    obtain ⟨hωl,hωh,hωT,_⟩ := hS ω hω
    exact hEntry q χ ρ ω hδ hδmax hρl hρh hωl hωh hρT hωT hW hℓ hRatio hU hUY
      hd (le_max_right _ _) θ hθ hΘ
  have hzero (ω : ℂ) (hω : ω ∈ S) :
      1-d ≤ ω.re ∧ ω.re ≤ 1 ∧ |ω.im| ≤ T ∧ regularizedL χ ω = 0 := by
    obtain ⟨hl,hh,ht,hz⟩ := hS ω hω
    refine ⟨(sub_le_sub_left (le_max_left δ ℓ⁻¹) 1).trans hl,hh.le,ht,?_⟩
    simpa only [regularizedL,hχ,ite_false] using hz
  have hraw := hRow q χ Q hq d T ρ.im hd hd₁ hT S hzero
  have hEff : 1+d*H ≤ (K+1)*(1+δ*H) := by
    have hd' : d ≤ δ+ℓ⁻¹ :=
      max_le (le_add_of_nonneg_right (inv_nonneg.mpr hℓ.le)) (le_add_of_nonneg_left hδ)
    have hInv : ℓ⁻¹*H ≤ K := by
      rw [mul_comm, ← div_eq_mul_inv]
      exact (div_le_iff₀ hℓ).mpr hHeight
    have hprod := mul_le_mul_of_nonneg_right hd' hH
    have hCross : 0 ≤ K*δ*H := by positivity
    nlinarith only [hprod,hInv,hCross]
  have hLog : 0 ≤ 1+Real.log (1+(S.card : ℝ)) := by
    have hh := Real.log_nonneg (show 1 ≤ 1+(S.card : ℝ) from le_add_of_nonneg_right (Nat.cast_nonneg _))
    linarith
  have hsplit (ω : ℂ) : m ω*(B/(1+|(ω.im-ρ.im)/d|)+e) =
      B*(m ω/(1+|(ω.im-ρ.im)/d|))+e*m ω := by ring
  change (∑ ω ∈ S, m ω*‖G ω‖) ≤ _ + e*(∑ ω ∈ S, m ω)
  calc
    _ ≤ ∑ ω ∈ S, m ω*(B/(1+|(ω.im-ρ.im)/d|)+e) :=
      sum_le_sum (fun ω hω => mul_le_mul_of_nonneg_left (hθRow ω hω) (by dsimp only [m]; positivity))
    _ = B*(∑ ω ∈ S, m ω/(1+|(ω.im-ρ.im)/d|))+e*(∑ ω ∈ S, m ω) := by
      simp only [hsplit,Finset.sum_add_distrib,← Finset.mul_sum]
    _ ≤ B*(C*(1+d*H)*(1+Real.log (1+(S.card : ℝ))))+e*(∑ ω ∈ S,m ω) :=
      (add_le_add) (mul_le_mul_of_nonneg_left hraw hBH) le_rfl
    _ ≤ B*(C*((K+1)*(1+δ*H))*(1+Real.log (1+(S.card : ℝ))))+e*(∑ ω ∈ S,m ω) :=
      (add_le_add) (mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hEff hC.le) hLog) hBH) le_rfl
    _ = _ := by dsimp only [B,H]; ring

end
end GoldbachPintzDiagonal

