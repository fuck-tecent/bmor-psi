  obtain ⟨C, hC, hb⟩ := V12y
  refine ⟨(∫ u : ℝ, Vd u) * C,
    mul_pos V5y hC, ?_⟩
  intro N Q hQ T c hT hc hc1 S hS F hF
  let a := V6 (fun n : ℕ => (n.divisors.card : ℂ)) (1 / 2 + c)
  let G := ∫ u : ℝ, Vd u
  let K := V62 Q T c
  have hG : 0 ≤ G := V5y.le
  have hp (χ : PrimitiveComplexCharacter) :
      Integrable (fun t => ∫ u : ℝ, Vd u *
        ‖V3 S a χ.character (t + u)‖ ^ 2)
        (volume.restrict (Icc (-T) T)) := by
    let : NeZero χ.modulus := ⟨χ.positive.ne'⟩
    exact (V83 S a χ.character T).integral_prod_left
  have hspos : ∀ n ∈ S, 1 ≤ n := fun n hn => (Finset.mem_Icc.mp (hS hn)).1
  have hpoint (χ : PrimitiveComplexCharacter) (hχ : χ ∈ F) (t : ℝ) (ht : t ∈ Icc (-T) T) :
      ‖∑ n ∈ S, V16 χ (V0 (1 / 2) t) n‖ ^ 2 ≤
        K ^ 2 * G * ∫ u : ℝ, Vd u *
          ‖V3 S a χ.character (t + u)‖ ^ 2 := by
    apply (V1jc χ S hspos c t hc hc1).trans
    apply mul_le_mul_of_nonneg_right _ (integral_nonneg (fun u => mul_nonneg (V2w u).le (sq_nonneg _)))
    apply mul_le_mul_of_nonneg_right _ hG
    apply pow_le_pow_left₀ (by positivity)
    exact Vuw Q hQ T c hT hc χ (hF χ hχ) t (abs_le.mpr ht)
  have hm : (∑ χ ∈ F, ∫ t in Icc (-T) T,
      ‖∑ n ∈ S, V16 χ (V0 (1 / 2) t) n‖ ^ 2) ≤
      K ^ 2 * G * (∑ χ ∈ F, ∫ t in Icc (-T) T, ∫ u : ℝ, Vd u *
        ‖V3 S a χ.character (t + u)‖ ^ 2) := by
    rw [Finset.mul_sum]
