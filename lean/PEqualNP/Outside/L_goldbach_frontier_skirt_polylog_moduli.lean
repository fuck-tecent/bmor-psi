theorem Vle {s k N Q p r : ℕ} [Fact p.Prime]
    (hkp : k<p) (hrk : r+1≤k) (a : ℕ)
    (F : Finset ((Fin k → Fin N) × (Fin s → Fin Q)))
    (hF : ∀ x∈F, Function.Injective
      (fun i => (((x.1 i).val+1:ℕ) : ZMod p))) :
