namespace GoldbachPintzWeightedFormula

open Complex Metric Set

/-- A bounded analytic remainder varies by O(distance) on the concentric
half disk, with the Cauchy estimate as its explicit constant. -/
theorem analytic_disk_half_lipschitz {G : ℂ→ℂ} {c : ℂ} {R M : ℝ} (hR : 0<R)
    (hG : AnalyticOnNhd ℂ G (closedBall c R))
    (hM : ∀ z∈closedBall c R, ‖G z‖≤M)
    {u v : ℂ} (hu : u∈closedBall c (R/2)) (hv : v∈closedBall c (R/2)) :
    ‖G v-G u‖≤(2*M/R)*‖v-u‖ := by
  have hhalf : R/2≤R := by linarith only [hR]
  have hd : ∀ z∈closedBall c (R/2), DifferentiableAt ℂ G z :=
    fun z hz=>(hG z (closedBall_subset_closedBall hhalf hz)).differentiableAt
  have hb (z : ℂ) (hz : z∈closedBall c (R/2)) : ‖deriv G z‖≤2*M/R := by
    have hsub : closedBall z (R/2) ⊆ closedBall c R := by
      intro w hw
      rw [mem_closedBall_iff_norm] at hw hz ⊢
      have hn := norm_add_le (w-z) (z-c)
      rw [sub_add_sub_cancel] at hn
      linarith only [hw,hz,hn]
    have hDiff : DiffContOnCl ℂ G (ball z (R/2)) :=
      ((hG.mono (closure_ball_subset_closedBall.trans hsub)).differentiableOn).diffContOnCl
    have h := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (by positivity : 0<R/2)
      hDiff (fun w hw=>hM w (hsub (sphere_subset_closedBall hw)))
    exact h.trans_eq (by ring)
  exact (convex_closedBall c (R/2)).norm_image_sub_le_of_norm_deriv_le hd hb hu hv

end GoldbachPintzWeightedFormula
