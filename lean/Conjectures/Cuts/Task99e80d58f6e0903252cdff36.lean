    intro x hx
    simpa [f, f', hatTailIntegrand, neg_mul] using hH.dde sign x (ha.trans hx)
  have hnonpos : ∀ x ∈ Ioi a, f' x ≤ 0 := by
    intro x hx
    have hx1 : 1 < x := by
      have hβ : 1 < β := hH.beta_gt_one
      have hax : a < x := hx
