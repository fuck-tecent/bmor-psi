  have hmass_log :
      (∑ p ∈ A, S.nu p) ≤
        Real.log (∏ p ∈ A, (1 - S.nu p)⁻¹) := by
    calc
      (∑ p ∈ A, S.nu p) ≤ ∑ p ∈ A, -Real.log (1 - S.nu p) := by
        exact Finset.sum_le_sum fun p hp => hterm p hp
      _ = ∑ p ∈ A, Real.log ((1 - S.nu p)⁻¹) := by
