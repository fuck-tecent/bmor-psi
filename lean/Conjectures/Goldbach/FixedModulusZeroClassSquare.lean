section
namespace GoldbachPintzWeightedFormula

open Complex Finset

noncomputable section

private def characterPhase {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) (t : ℝ) : ℂ :=
  χ (n:ZMod q)*(n:ℂ)^(-(t:ℂ)*I)

private theorem characterPhase_mul {q : ℕ} (χ ψ : DirichletCharacter ℂ q)
    {n : ℕ} (hn : 0<n) (s t : ℝ) :
    characterPhase (χ*ψ) n (s+t)=characterPhase χ n s*characterPhase ψ n t := by
  have hn0 : (n:ℂ)≠0 := by exact_mod_cast hn.ne'
  unfold characterPhase
  rw [MulChar.mul_apply,show -((s+t:ℝ):ℂ)*I = -(s:ℂ)*I+(-(t:ℂ)*I) by push_cast; ring,
    Complex.cpow_add _ _ hn0]
  ring

private theorem characterPhase_conj {q : ℕ} (χ : DirichletCharacter ℂ q)
    {n : ℕ} (hn : 0<n) (t : ℝ) :
    characterPhase χ⁻¹ n (-t)= (starRingEnd ℂ) (characterPhase χ n t) := by
  have hpow : ‖(n:ℂ)^(-(t:ℂ)*I)‖=1 := by
    rw [Complex.norm_natCast_cpow_of_pos hn]
    simp [Complex.mul_re]
  unfold characterPhase
  rw [show -((-t:ℝ):ℂ)*I=-(-(t:ℂ)*I) by push_cast; ring,Complex.cpow_neg,
    Complex.inv_eq_conj hpow,map_mul]
  have h : χ⁻¹ (n:ZMod q)=(starRingEnd ℂ) (χ (n:ZMod q)) := by
    simpa only [RCLike.star_def] using (MulChar.star_apply' χ (n:ZMod q)).symm
  rw [h]

private theorem characterPhase_norm_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {n : ℕ} (hn : 0<n) (t : ℝ) : ‖characterPhase χ n t‖≤1 := by
  unfold characterPhase
  rw [norm_mul,Complex.norm_natCast_cpow_of_pos hn]
  simpa [Complex.mul_re] using χ.norm_le_one (n:ZMod q)

set_option maxHeartbeats 650000 in
/-- The two-phase positive product gives a five-term test. -/
theorem pair_primeSum_nonneg {q : ℕ} (χ ψ : DirichletCharacter ℂ q)
    (S : Finset ℕ) (w : ℕ→ℝ) (hw : ∀ n∈S, 0≤w n) (σ s t : ℝ) :
    0≤primeSum S w (1:DirichletCharacter ℂ q) σ 0+primeSum S w χ σ s+
      primeSum S w ψ σ t+
      (1/2)*(primeSum S w (χ*ψ) σ (s+t)+primeSum S w (χ*ψ⁻¹) σ (s-t)) := by
  simp only [primeSum,Finset.mul_sum,←Finset.sum_add_distrib]
  apply Finset.sum_nonneg
  intro n hnS
  by_cases hn : n=0
  · subst n
    simp
  by_cases hu : IsUnit (n:ZMod q)
  · let a := characterPhase χ n s
    let b := characterPhase ψ n t
    let c := w n*ArithmeticFunction.vonMangoldt n*(n:ℝ)^(-σ)
    have hc : 0≤c := mul_nonneg
      (mul_nonneg (hw n hnS) ArithmeticFunction.vonMangoldt_nonneg) (by positivity)
    have hna := characterPhase_norm_le χ (Nat.pos_of_ne_zero hn) s
    have hnb := characterPhase_norm_le ψ (Nat.pos_of_ne_zero hn) t
    have ha : 0≤1+a.re := by
      have h := (neg_le_abs a.re).trans ((Complex.abs_re_le_norm a).trans hna)
      linarith only [h]
    have hb : 0≤1+b.re := by
      have h := (neg_le_abs b.re).trans ((Complex.abs_re_le_norm b).trans hnb)
      linarith only [h]
    have hp : characterPhase (χ*ψ) n (s+t)=a*b :=
      characterPhase_mul χ ψ (Nat.pos_of_ne_zero hn) s t
    have hm : characterPhase (χ*ψ⁻¹) n (s-t)=a*((starRingEnd ℂ) b) := by
      rw [sub_eq_add_neg,characterPhase_mul χ ψ⁻¹ (Nat.pos_of_ne_zero hn),
        characterPhase_conj ψ (Nat.pos_of_ne_zero hn)]
    rw [MulChar.one_apply hu]
    simp only [Complex.ofReal_zero,neg_zero,zero_mul,cpow_zero,mul_one,Complex.one_re]
    change 0≤c+c*a.re+c*b.re+(1/2)*(c*(characterPhase (χ*ψ) n (s+t)).re+
      c*(characterPhase (χ*ψ⁻¹) n (s-t)).re)
    rw [hp,hm]
    simp only [Complex.mul_re,Complex.conj_re,Complex.conj_im]
    convert mul_nonneg hc (mul_nonneg ha hb) using 1
    ring
  · simp [MulChar.map_nonunit _ hu]

end

end GoldbachPintzWeightedFormula
end

