  mass n (radius n T (max 1 q)) / (n:ℝ)
theorem Vdy (n T q : ℕ) (hn : 0 < n) (hT : 0 < T) (hbudget : 24*T≤n) :
    0 ≤ ((n:ℝ)+1)/(n:ℝ)-normalized n T q ∧
     ((n:ℝ)+1)/(n:ℝ)-normalized n T q ≤ (max 1 q:ℕ)/(2*(T:ℝ)) := by
