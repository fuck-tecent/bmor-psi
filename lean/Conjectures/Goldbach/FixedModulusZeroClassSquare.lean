theorem anchorRationalKernelReal_antitone {b x y : ℝ} (hb : 0<b)
    (hx : 0<b+x) (hxy : x≤y) :
    anchorRationalKernelReal b y≤anchorRationalKernelReal b x := by
  have h : b+x≤b+y := by linarith only [hxy]
  unfold anchorRationalKernelReal
  exact add_le_add (add_le_add
    (div_le_div_of_nonneg_left (by norm_num) hx h)
    (div_le_div_of_nonneg_left (by positivity) (pow_pos hx 2) (pow_le_pow_left₀ hx.le h 2)))
    (div_le_div_of_nonneg_left (by positivity) (pow_pos hx 3) (pow_le_pow_left₀ hx.le h 3))

private theorem anchor_kernel_increment_eq {b x m : ℝ} (hx : 0<b+x)
    (hm : 0≤ m) :
    anchorRationalKernelReal b x-anchorRationalKernelReal b (x+m) =
      (m/((b+x)*(b+x+m))) *
        (1+(7/8:ℝ)*b*((b+x)⁻¹+(b+x+m)⁻¹)+
          b^2*((b+x)⁻¹^2+(b+x)⁻¹*(b+x+m)⁻¹+(b+x+m)⁻¹^2)) := by
  have hxm : 0<b+x+m := add_pos_of_pos_of_nonneg hx hm
  unfold anchorRationalKernelReal
  rw [←add_assoc b x m]
  field_simp [hx.ne',hxm.ne'] <;> ring

/-- A fixed positive horizontal translation decreases the rational
kernel less when the original point is moved to the right. -/
theorem anchor_kernel_increment_antitone {b x y m : ℝ}
    (hb : 0<b) (hx : 0<b+x) (hxy : x≤y) (hm : 0≤ m) :
    anchorRationalKernelReal b y-anchorRationalKernelReal b (y+m) ≤
      anchorRationalKernelReal b x-anchorRationalKernelReal b (x+m) := by
  have hXY : b+x≤b+y := by linarith only [hxy]
  have hy := hx.trans_le hXY
  have hxM := add_pos_of_pos_of_nonneg hx hm
  have hyM := add_pos_of_pos_of_nonneg hy hm
  have h1 := (inv_le_inv₀ hy hx).mpr hXY
  have h2 := (inv_le_inv₀ hyM hxM).mpr (add_le_add_left hXY m)
  have hD : m/((b+y)*(b+y+m))≤ m/((b+x)*(b+x+m)) :=
    div_le_div_of_nonneg_left hm (mul_pos hx hxM)
      (mul_le_mul hXY (add_le_add_left hXY m) hxM.le hy.le)
  have hxI := inv_pos.mpr hx
  have hyI := inv_pos.mpr hy
  have hxMI := inv_pos.mpr hxM
  have hyMI := inv_pos.mpr hyM
  rw [anchor_kernel_increment_eq hy hm,anchor_kernel_increment_eq hx hm]
  gcongr


/-- Scalar certificate for every admissible pair of gap thresholds. -/
theorem anchor_gap_certificate_of_margin {b a H cost lam mu : ℝ} (hb : 0<b) (hba : a<b) (hH : 0≤ H)
    (hMargin : anchorRationalKernelReal b (-a)-anchorRationalKernelReal b 0+cost < anchorRationalKernelReal b (H-a))
    (hlam : lam≤ a) (hmu : lam≤ mu)
    (hBound : anchorRationalKernelReal b (mu-lam)≤ anchorRationalKernelReal b (-lam)-anchorRationalKernelReal b 0+cost) : H< mu := by
  by_contra! h
  have h1 : anchorRationalKernelReal b (H-lam)≤ anchorRationalKernelReal b (mu-lam) :=
    anchorRationalKernelReal_antitone hb (by linarith only [hmu,hb]) (by linarith only [h])
  have h2 := anchor_kernel_increment_antitone (b:=b) (x:=-a) (y:=-lam) (m:=H) hb
    (by linarith only [hba]) (by linarith only [hlam]) hH
  rw [show -lam+H=H-lam by ring,show -a+H=H-a by ring] at h2
  linarith only [h1,h2,hBound,hMargin]

/-- Scalar certificate for every admissible pair of gap thresholds. -/
theorem rational_gap_certificate_of_margin {b a H cost lam mu : ℝ} (hb : 0<b) (hba : a<b) (hH : 0≤ H)
    (hMargin : realRationalZeroKernel b (-a)-realRationalZeroKernel b 0+cost < realRationalZeroKernel b (H-a))
    (hlam : lam≤ a) (hmu : lam≤ mu)
    (hBound : realRationalZeroKernel b (mu-lam)≤ realRationalZeroKernel b (-lam)-realRationalZeroKernel b 0+cost) : H< mu := by
  by_contra! h
  have h1 : realRationalZeroKernel b (H-lam)≤ realRationalZeroKernel b (mu-lam) :=
    realRationalZeroKernel_antitone hb (by linarith only [hmu,hb]) (by linarith only [h])
  have h2 := rational_kernel_increment_antitone (b:=b) (x:=-a) (y:=-lam) (m:=H) hb
    (by linarith only [hba]) (by linarith only [hlam]) hH
  rw [show -lam+H=H-lam by ring,show -a+H=H-a by ring] at h2
  linarith only [h1,h2,hBound,hMargin]


end GoldbachPintzNumerics
end

