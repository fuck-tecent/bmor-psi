    _ ≤ 1*vonMangoldt n := mul_le_mul_of_nonneg_right (χ.character.norm_le_one _) vonMangoldt_nonneg
    _ ≤ _ := by simpa only [one_mul] using (vonMangoldt_le_log (n := n))
theorem V1og (χ : PrimitiveComplexCharacter) (N : ℕ) (hN : 1≤N)
    (n : ℕ) (hn : n∈range N) : ‖Vl χ n‖≤Real.log (N : ℝ) := by
  by_cases hn0 : n=0
  · subst n
    simpa only [Vl,ArithmeticFunction.map_zero,Complex.ofReal_zero,mul_zero,norm_zero] using
      (Real.log_nonneg (show (1 : ℝ)≤N by exact_mod_cast hN))
  · apply (V189 χ n).trans
    apply Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hn0)
    exact_mod_cast (mem_range.mp hn).le
theorem V1n6 (N : ℕ) (hN : 1≤N)
    (n : ℕ) (hn : n∈range N) : ‖V1n n‖≤Real.log (N : ℝ) := by
  rw [V1n,Complex.norm_real,Real.norm_of_nonneg vonMangoldt_nonneg]
  by_cases hn0 : n=0
  · subst n
    simp only [ArithmeticFunction.map_zero]
    exact Real.log_nonneg (by exact_mod_cast hN)
  · exact vonMangoldt_le_log.trans
      (Real.log_le_log (by exact_mod_cast Nat.pos_of_ne_zero hn0) (by exact_mod_cast (mem_range.mp hn).le))
end Vit
end

