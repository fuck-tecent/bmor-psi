    obtain ⟨hl,hu⟩ := abs_le.mp (hS z hz).2.2
    have hlow : ((⌊t⌋-5:ℤ):ℝ)≤(⌊z.im⌋:ℝ) := by
      push_cast
      linarith [Int.floor_le t,Int.lt_floor_add_one z.im]
    have hhigh : (⌊z.im⌋:ℝ)≤((⌊t⌋+5:ℤ):ℝ) := by
      push_cast
      linarith [Int.floor_le z.im,Int.lt_floor_add_one t]
    exact Finset.mem_Icc.mpr ⟨by exact_mod_cast hlow,by exact_mod_cast hhigh⟩
  have hcenter (n : ℤ) (hn : n∈B) : |(n:ℝ)+1/2|≤|t|+6 := by
    have hn' := Finset.mem_Icc.mp hn
    have hlow : (⌊t⌋:ℝ)-5≤(n:ℝ) := by exact_mod_cast hn'.1
    have hhigh : (n:ℝ)≤(⌊t⌋:ℝ)+5 := by exact_mod_cast hn'.2
    apply abs_le.mpr
    constructor
    · linarith [Int.lt_floor_add_one t,neg_le_abs t]
    · linarith [Int.floor_le t,le_abs_self t]
  have hfiber (n : ℤ) (hn : n∈B) :
      ∑ z∈S.filter (fun z => ⌊z.im⌋=n),(V9t z:ℝ) ≤
        Real.log (192*(|t|+8)^2)/Real.log (14/13) := by
    have hlocal := Vrw ((n:ℝ)+1/2)
      (S.filter fun z => ⌊z.im⌋=n) (by
        intro z hz
        obtain ⟨hzS,hzn⟩ := Finset.mem_filter.mp hz
        simpa only [hzn] using Vcn z (hS z hzS).1 (hS z hzS).2.1)
    have hlocalR : ∑ z∈S.filter (fun z => ⌊z.im⌋=n),(V9t z:ℝ) ≤
