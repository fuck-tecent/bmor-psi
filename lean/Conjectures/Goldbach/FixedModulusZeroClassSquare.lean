namespace GoldbachCubicRiesz

open Complex Finset MeasureTheory Filter
open GoldbachSieveSeries GoldbachTypeII

noncomputable section

/-- The coefficient of the Gram kernel twisted by a quotient character. -/
def gramCoefficient {q : ℕ} (χ : DirichletCharacter ℂ q) (W : ℝ) (θ : ℕ → ℝ) :
    ℕ → ℂ :=
  (fun n : ℕ => χ n) * sieveProduct (Icc 1 ⌊W⌋₊) (Icc 1 ⌊W⌋₊)
    (fun d => (θ d : ℂ)) (fun d => (θ d : ℂ))

private theorem shifted_critical_integrable {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1) (γ : ℝ) :
    Integrable (fun t : ℝ => (1/(1+|t|)^3) *
      ‖χ.LFunction ((1/2 : ℂ)+(γ+t)*I)‖) := by
  have hM (u : ℝ) :
      criticalMollified χ 1 u = χ.LFunction ((1/2 : ℂ)+(u : ℂ)*I) := by
    dsimp only [criticalMollified]
    rw [mollifier_eq_sum]
    simp [LSeries.term, truncatedMoebius]
  have hI : Integrable (fun u : ℝ => cubicWeight u γ *
      ‖χ.LFunction ((1/2 : ℂ)+(u : ℂ)*I)‖) := by
    simpa only [hM] using weighted_criticalMollified_integrable hχ 1 γ
  have hshift := (measurePreserving_add_right (volume : Measure ℝ) γ).integrable_comp_of_integrable hI
  refine hshift.congr (Eventually.of_forall (fun t => ?_))
  have ht : γ-(γ+t) = -t := by ring
  simp only [Function.comp_apply, add_comm t γ, cubicWeight, ht, abs_neg, Complex.ofReal_add]

/-- On the left line, both compact Riesz scales are bounded by the shorter scale. -/
theorem gramRieszDifference_left_norm {Y U a : ℝ} (hU : 0 < U)
    (hUY : U ≤ Y) (ha₀ : -(1/2 : ℝ) ≤ a) (ha₁ : a ≤ -(1/4 : ℝ)) (t : ℝ) :
    ‖gramRieszDifference Y U ((a : ℂ)+t*I)‖ ≤
      (500 * U^a) * (1/(1+|t|)^3) := by
  let z : ℂ := (a : ℂ)+t*I
  have hz : z.re = a := by simp [z, mul_re]
  have hY := hU.trans_le hUY
  have hpow : ‖(Y : ℂ)^z-(U : ℂ)^z‖ ≤ 2*U^a := by
    refine (norm_sub_le _ _).trans ?_
    rw [norm_cpow_eq_rpow_re_of_pos hY, norm_cpow_eq_rpow_re_of_pos hU, hz]
    linarith only [Real.rpow_le_rpow_of_nonpos hU hUY (show a ≤ 0 by linarith)]
  have hsym := symbol_left_bound (t := t) ha₀ ha₁
  change ‖gramRieszDifference Y U z‖ ≤ _
  rw [gramRieszDifference, norm_mul]
  calc
    _ ≤ (2*U^a) * (250/(1+|t|)^3) :=
      mul_le_mul hpow hsym (norm_nonneg _) (by positivity)
    _ = _ := by ring

/-- The nonprincipal Gram difference is controlled by the cubic average
of the critical-line L-function. -/
theorem gram_cutoff_norm_le_integral {q : ℕ} [NeZero q]
    {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1) {ρ : ℂ}
    (hlo : 3/4 ≤ ρ.re) (hhi : ρ.re ≤ 1) {W Y U : ℝ}
    (hW : 0 ≤ W) (hU : 1 ≤ U) (hUY : U ≤ Y)
    (θ : ℕ → ℝ) (hθ : ∀ d, |θ d| ≤ 1) :
    ‖cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) Y -
      cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) U‖ ≤
      (6000*W*U^(1/2-ρ.re)) *
        (∫ t : ℝ, (1/(1+|t|)^3)*‖χ.LFunction ((1/2 : ℂ)+(ρ.im+t)*I)‖) := by
  classical
  let a : ℝ := 1/2-ρ.re
  let D := Icc 1 ⌊W⌋₊
  let u := fun d => (θ d : ℂ)
  let P := lcmPolynomial χ D D u u
  let H (z : ℂ) := χ.LFunction (ρ+z) * P (ρ+z)
  let B := 12*W
  let A := (Y+U)*(6*(q : ℝ)*(1+‖ρ‖+1)*B)
  have hU₀ : 0 < U := zero_lt_one.trans_le hU
  have hY₀ := hU₀.trans_le hUY
  have hY := hU.trans hUY
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have hA : 0 ≤ A := by dsimp only [A]; positivity
  have ha₀ : -(1/2 : ℝ) ≤ a := by dsimp only [a]; linarith
  have ha₁ : a ≤ -(1/4 : ℝ) := by dsimp only [a]; linarith
  have hshift : Differentiable ℂ (fun z : ℂ => ρ+z) := by fun_prop
  have hH : Differentiable ℂ H := ((χ.differentiable_LFunction hχ).comp hshift).mul
    ((differentiable_lcmPolynomial χ D D u u).comp hshift)
  have hP (s : ℂ) (hs : 1/2 ≤ s.re) : ‖P s‖ ≤ B := by
    have hu (d : ℕ) (_ : d ∈ D) : ‖u d‖ ≤ 1 := by
      simpa only [u, Complex.norm_real, Real.norm_eq_abs] using hθ d
    refine (norm_lcmPolynomial_le χ ⌊W⌋₊ ⌊W⌋₊ u u hs hu hu).trans ?_
    calc
      _ = 12*(Real.sqrt (⌊W⌋₊ : ℝ))^2 := by ring
      _ ≤ B := by rw [Real.sq_sqrt (by positivity)]; exact mul_le_mul_of_nonneg_left (Nat.floor_le hW) (by norm_num)
  have hb : LSeriesSummable (gramCoefficient χ W θ) (ρ+1) := by
    apply sieveProduct_summable
    simp only [add_re, one_re]
    linarith
  have hRight (t : ℝ) : H ((1 : ℂ)+t*I) =
      LSeries (gramCoefficient χ W θ) (ρ+((1 : ℂ)+t*I)) := by
    let s : ℂ := ρ+((1 : ℂ)+t*I)
    have hs : 1 < s.re := by simp [s, add_re, mul_re]; linarith
    change χ.LFunction s * lcmPolynomial χ D D u u s = _
    rw [lcmPolynomial_eq, mul_comm]
    exact (sieveProduct_LSeries χ D D u u hs).symm
  have hgrowth (x : ℝ) (hx : x ∈ Set.Icc a 1) (t : ℝ) (_ : 1 ≤ |t|) :
      ‖((Y : ℂ)^((x : ℂ)+t*I)-(U : ℂ)^((x : ℂ)+t*I)) * H ((x : ℂ)+t*I)‖ ≤ A*(1+|t|) := by
    have hxa : 1/2-ρ.re ≤ x := hx.1
    have hx' : |x| ≤ 1 := abs_le.mpr ⟨by linarith, hx.2⟩
    have hs : 1/2 ≤ ρ.re+x := by linarith
    have hL := shifted_product_linear_growth hχ ρ P hB
      (by norm_num : (0 : ℝ) ≤ 1) hP hx' hs (t := t)
    let z : ℂ := (x : ℂ)+t*I
    have hz : z.re = x := by simp [z, mul_re]
    have hpow : ‖(Y : ℂ)^z-(U : ℂ)^z‖ ≤ Y+U := by
      refine (norm_sub_le _ _).trans ?_
      rw [norm_cpow_eq_rpow_re_of_pos hY₀, norm_cpow_eq_rpow_re_of_pos hU₀, hz]
      exact add_le_add (by simpa using Real.rpow_le_rpow_of_exponent_le hY hx.2)
        (by simpa using Real.rpow_le_rpow_of_exponent_le hU hx.2)
    rw [norm_mul]
    calc
      _ ≤ (Y+U)*((6*(q : ℝ)*(1+‖ρ‖+1)*B)*(1+|t|)) :=
        mul_le_mul hpow hL (norm_nonneg _) (by positivity)
      _ = _ := by dsimp only [A]; ring
  have hexact := nonprincipal_gram_cutoff_eq hH (gramCoefficient χ W θ) ρ hb hY₀ hU₀
    (by linarith : -1 < a) (by linarith : a < 0) hA hRight hgrowth
  rw [hexact]
  let F (t : ℝ) := gramRieszDifference Y U ((a : ℂ)+t*I)*H ((a : ℂ)+t*I)
  let w (t : ℝ) := (1/(1+|t|)^3)*‖χ.LFunction ((1/2 : ℂ)+(ρ.im+t)*I)‖
  let C := 6000*W*U^a
  have hw : Integrable w := shifted_critical_integrable hχ ρ.im
  have hdom : Integrable (fun t => C*w t) := hw.const_mul C
  have hpt (t : ℝ) : ‖F t‖ ≤ C*w t := by
    let z : ℂ := (a : ℂ)+t*I
    have hz : ρ+z = (1/2 : ℂ)+(ρ.im+t)*I := by
      apply Complex.ext
      · simp [z, a, Complex.mul_re]
      · simp [z, a, Complex.mul_im]
    have hp := hP (ρ+z) (by rw [hz]; simp [Complex.mul_re])
    have hker := gramRieszDifference_left_norm hU₀ hUY ha₀ ha₁ t
    change ‖gramRieszDifference Y U z * (χ.LFunction (ρ+z)*P (ρ+z))‖ ≤ _
    simp only [norm_mul]
    calc
      _ ≤ ((500*U^a)*(1/(1+|t|)^3)) * (‖χ.LFunction (ρ+z)‖*B) :=
        mul_le_mul hker (mul_le_mul_of_nonneg_left hp (norm_nonneg _)) (by positivity) (by positivity)
      _ = _ := by rw [hz]; dsimp only [C,B,w]; ring
  have hn : ‖∫ t, F t‖ ≤ C * ∫ t, w t := by
    simpa only [integral_const_mul] using
      norm_integral_le_of_norm_le hdom (Eventually.of_forall hpt)
  have hconst : |1/(2*Real.pi)| ≤ (1 : ℝ) := by
    rw [abs_of_nonneg (by positivity)]
    apply (div_le_one (by positivity)).mpr
    linarith [Real.pi_gt_three]
  change ‖((1/(2*Real.pi) : ℝ) : ℂ) * ∫ t, F t‖ ≤ C * ∫ t, w t
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  exact (mul_le_of_le_one_left (norm_nonneg _) hconst).trans hn

/-- Pólya–Vinogradov gives a uniform bound on the actual nonprincipal Gram
difference for real Selberg weights on the cutoff `W`. -/
theorem nonprincipal_gram_norm_le {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q), χ ≠ 1 →
      ∀ {ρ : ℂ}, 3/4 ≤ ρ.re → ρ.re ≤ 1 → ∀ {T W Y U : ℝ}, |ρ.im| ≤ T →
      0 ≤ W → 1 ≤ U → U ≤ Y → ∀ (θ : ℕ → ℝ), (∀ d, |θ d| ≤ 1) →
      ‖cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) Y -
        cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) U‖ ≤
        C*W*U^(1/2-ρ.re)*(q : ℝ)^(1/4+ε/2)*(1+T)^(1/2 : ℝ) := by
  obtain ⟨C,hC,hb⟩ := GoldbachPintzVertical.critical_L_integral_bound hε
  refine ⟨6000*C,by positivity,?_⟩
  intro q _ χ hχ ρ hlo hhi T W Y U hT hW hU hUY θ hθ
  have h := gram_cutoff_norm_le_integral hχ hlo hhi hW hU hUY θ hθ
  refine h.trans ((mul_le_mul_of_nonneg_left (hb q χ hχ hT) ?_).trans_eq ?_)
  · have hU₀ := zero_le_one.trans hU
    positivity
  · ring

end
end GoldbachCubicRiesz

end

section

namespace GoldbachCubicRiesz

open Complex Finset MeasureTheory Filter
open GoldbachSieveSeries GoldbachHybridGrowth

private theorem critical_profile_dom (t : ℝ) :
    (1/(1+|t|)^3)*(1+|t|)^(1/2:ℝ) ≤ (1+t^2)⁻¹ := by
  have hTa : 1≤1+|t| := by linarith only [abs_nonneg t]
  have hTp : 0<1+|t| := zero_lt_one.trans_le hTa
  have hpow : (1+|t|)^(1/2:ℝ)≤1+|t| := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hTa (by norm_num : (1/2:ℝ)≤1)
  have hsq : 1+t^2 ≤ (1+|t|)^2 := by
    rw [← sq_abs t]
    nlinarith only [abs_nonneg t]
  calc
    _ ≤ (1/(1+|t|)^3)*(1+|t|) := mul_le_mul_of_nonneg_left hpow (by positivity)
    _ = 1/(1+|t|)^2 := by field_simp [hTp.ne']
    _ ≤ _ := by
      rw [← one_div]
      exact div_le_div_of_nonneg_left zero_le_one (by positivity) hsq

/-- On the principal Gram channel, the modulus cost in the left-line
correction can be made an arbitrarily small power. -/
theorem principal_gram_left_norm_le {ε : ℝ} (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ) [NeZero q] {ρ : ℂ},
      3/4≤ρ.re → ρ.re≤1 → ∀ {T W Y U : ℝ}, |ρ.im|≤T →
      0≤W → 1≤U → U≤Y → ∀ (θ : ℕ → ℝ), (∀ d, |θ d|≤1) →
      let a : ℝ := 1/2-ρ.re
      let χ : DirichletCharacter ℂ q := 1
      let D := Icc 1 ⌊W⌋₊
      let u := fun d => (θ d:ℂ)
      let P := sieveProductPolynomial χ D D u u
      ‖((1/(2*Real.pi):ℝ):ℂ) *
        (∫ t : ℝ, let z : ℂ := (a:ℂ)+t*I
          gramRieszDifference Y U z * (χ.LFunction (ρ+z)*P (ρ+z)))‖ ≤
        C*W*U^(1/2-ρ.re)*(q:ℝ)^ε*(1+T)^(1/2:ℝ) := by
  obtain ⟨G,hG,hGrowth⟩ := principal_critical_growth hε
  let K : ℝ := ∫ t : ℝ, (1+t^2)⁻¹
  have hK : 0≤K := integral_nonneg (fun _ => by positivity)
  refine ⟨6000*G*(K+1),by positivity,?_⟩
  intro q _ ρ hρlo hρhi T W Y U hT hW hU hUY θ hθ
  let a : ℝ := 1/2-ρ.re
  let χ : DirichletCharacter ℂ q := 1
  let D := Icc 1 ⌊W⌋₊
  let u := fun d => (θ d:ℂ)
  let P := sieveProductPolynomial χ D D u u
  let F (t : ℝ) : ℂ :=
    gramRieszDifference Y U ((a:ℂ)+t*I) *
      (χ.LFunction (ρ+((a:ℂ)+t*I))*P (ρ+((a:ℂ)+t*I)))
  let M : ℝ := 6000*G*W*U^a*(q:ℝ)^ε*(1+T)^(1/2:ℝ)
  have hU₀ : 0<U := zero_lt_one.trans_le hU
  have hT₀ : 0≤T := (abs_nonneg _).trans hT
  have ha₀ : -(1/2:ℝ)≤a := by dsimp only [a]; linarith only [hρhi]
  have ha₁ : a≤ -(1/4:ℝ) := by dsimp only [a]; linarith only [hρlo]
  have hM : 0≤M := by dsimp only [M]; positivity
  have hPoly (s : ℂ) (hs : 1/2 ≤ s.re) : ‖P s‖≤12*W := by
    have hu (d : ℕ) (_ : d∈D) : ‖u d‖≤1 := by
      simpa only [u,Complex.norm_real,Real.norm_eq_abs] using hθ d
    have hEq : P s = lcmPolynomial χ D D u u s := (lcmPolynomial_eq χ D D u u s).symm
    rw [hEq]
    refine (norm_lcmPolynomial_le χ ⌊W⌋₊ ⌊W⌋₊ u u hs hu hu).trans ?_
    calc
      _ = 12*(Real.sqrt (⌊W⌋₊:ℝ))^2 := by ring
      _ ≤ _ := by
        rw [Real.sq_sqrt (by positivity)]
        exact mul_le_mul_of_nonneg_left (Nat.floor_le hW) (by norm_num)
  have hdom (t : ℝ) : ‖F t‖≤M*(1+t^2)⁻¹ := by
    let z : ℂ := (a:ℂ)+t*I
    have hz : ρ+z=(1/2:ℂ)+(ρ.im+t)*I := by
      apply Complex.ext
      · simp [z,a,Complex.mul_re]
      · simp [z,a,Complex.mul_im]
    have hp := hPoly (ρ+z) (by rw [hz]; simp)
    have hker := gramRieszDifference_left_norm hU₀ hUY ha₀ ha₁ t
    have hL : ‖χ.LFunction (ρ+z)‖ ≤
        G*(q:ℝ)^ε*(1+T)^(1/2:ℝ)*(1+|t|)^(1/2:ℝ) := by
      rw [hz]
      exact hGrowth q hT t
    change ‖gramRieszDifference Y U z*(χ.LFunction (ρ+z)*P (ρ+z))‖≤_
    simp only [norm_mul]
    calc
      _ ≤ ((500*U^a)*(1/(1+|t|)^3)) *
        ((G*(q:ℝ)^ε*(1+T)^(1/2:ℝ)*(1+|t|)^(1/2:ℝ))*(12*W)) :=
        mul_le_mul hker (mul_le_mul hL hp (norm_nonneg _) (by positivity))
          (mul_nonneg (norm_nonneg _) (norm_nonneg _)) (by positivity)
      _ = M*((1/(1+|t|)^3)*(1+|t|)^(1/2:ℝ)) := by dsimp only [M]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (critical_profile_dom t) hM
  have hn : ‖∫ t : ℝ, F t‖≤ M*K := by
    simpa only [K,integral_const_mul] using norm_integral_le_of_norm_le
      (integrable_inv_one_add_sq.const_mul M) (Eventually.of_forall hdom)
  have hc : |1/(2*Real.pi)|≤1 := by
    rw [abs_of_nonneg (by positivity)]
    apply (div_le_one (by positivity)).mpr
    linarith only [Real.pi_gt_three]
  change ‖((1/(2*Real.pi):ℝ):ℂ)*(∫ t : ℝ, F t)‖≤_
  rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]
  calc
    _ ≤ M*K := (mul_le_of_le_one_left (norm_nonneg _) hc).trans hn
    _ ≤ M*(K+1) := mul_le_mul_of_nonneg_left (le_add_of_nonneg_right zero_le_one) hM
    _ = _ := by dsimp only [M,a]; ring

/-- The signed principal Gram cutoff equals its explicit residue up to
the same smaller-scale left-line correction as the off-diagonal case. -/
theorem principal_gram_sub_residue_norm_le {ε : ℝ} (hε : 0<ε) :
    ∃ C : ℝ, 0<C ∧ ∀ (q : ℕ) [NeZero q] {ρ : ℂ},
      3/4≤ρ.re → ρ.re<1 → ∀ {T W Y U : ℝ}, |ρ.im|≤T →
      0≤W → 1≤U → U≤Y → ∀ (θ : ℕ → ℝ), (∀ d, |θ d|≤1) →
      let χ : DirichletCharacter ℂ q := 1
      let D := Icc 1 ⌊W⌋₊
      let u := fun d => (θ d:ℂ)
      let b := gramCoefficient χ W θ
      let p : ℂ := 1-ρ
      ‖cutoffSum (LSeries.term b ρ) Y-cutoffSum (LSeries.term b ρ) U -
        gramRieszDifference Y U p * sieveProductPolynomial χ D D u u 1 *
          principalResidueFactor q‖ ≤ C*W*U^(1/2-ρ.re)*(q:ℝ)^ε*(1+T)^(1/2:ℝ) := by
  obtain ⟨C,hC,hLeft⟩ := principal_gram_left_norm_le hε
  refine ⟨C,hC,?_⟩
  intro q _ ρ hρlo hρhi T W Y U hT hW hU hUY θ hθ
  let χ : DirichletCharacter ℂ q := 1
  let D := Icc 1 ⌊W⌋₊
  let u := fun d => (θ d:ℂ)
  let b := gramCoefficient χ W θ
  have hρ : ρ≠1 := by intro h; rw [h] at hρhi; norm_num at hρhi
  have he := sieveProduct_principal_gram_cutoff_eq (q:=q) ρ
    (by linarith only [hρlo]) hρhi.le hρ D D u u (hU.trans hUY) hU
  let R := gramRieszDifference Y U (1-ρ) * sieveProductPolynomial χ D D u u 1 * principalResidueFactor q
  change ‖cutoffSum (LSeries.term b ρ) Y-cutoffSum (LSeries.term b ρ) U-R‖≤_
  change cutoffSum (LSeries.term b ρ) Y-cutoffSum (LSeries.term b ρ) U = _+R at he
  rw [he,add_sub_cancel_right]
  exact hLeft q hρlo hρhi.le hT hW hU hUY θ hθ

end GoldbachCubicRiesz


