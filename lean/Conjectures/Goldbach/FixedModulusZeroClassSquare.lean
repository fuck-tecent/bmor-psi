  have hPlus' : |s+t|≤2*R := by simpa only [add_comm] using hPlus
  exact False.elim ((not_lt_of_ge hmu) (hcross q χ ψ σ β s t B T hq hβ hσ hlam hB hBL
    (hW χ hχ s hs') (hW ψ hψ t ht') (hW (χ*ψ) hProd _ hPlus') (hW (χ*ψ⁻¹) hDiff _ hMinus)
