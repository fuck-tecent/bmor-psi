set_option maxHeartbeats 2700000 in
/-- The principal exponential test has a single pole and a bounded
linear error using the common modulus's deleted Euler factors. -/
theorem exponential_prime_principal_upper_with_left_zeros {ι : Type*}
    (S : Finset ι) (a b : ι→ℝ) (hb : ∀ i∈S,0<b i) :
    ∃ A : ℝ, 0<A ∧ ∀ (q : ℕ) [NeZero q] {L : ℝ} {s : ℂ}, 0<L →
      (∀ i∈S, 1<s.re+b i/L ∧ s.re+b i/L≤1+1/4) →
      (∀ ρ : ℂ, regularizedL (1:DirichletCharacter ℂ 1) ρ=0 →
        |ρ.im-s.im|≤2 → ρ.re≤ s.re) →
      (exponentialPrimeTest S a b (1:DirichletCharacter ℂ q) L s).re≤
        L*(exponentialAutoTransform S a b ((L:ℂ)*(s-1))).re+
          (∑ i∈S,|exponentialAutoCoeff S a b i|)*
          (A*logHeight 1 s.im+4*∑ p∈q.primeFactors,Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ)) := by
  obtain ⟨A,hA,hAux⟩ := local_analytic_remainder_with_principal_pole
  refine ⟨A,hA,?_⟩
  intro q _ L s hL hShift hZeros
  let χ : DirichletCharacter ℂ 1 := 1
  let v (i : ι) : ℂ := s+(b i/L:ℝ)
  let c := exponentialAutoCoeff S a b
  let J : ℝ := ∑ i∈S,|c i|
  let E : ℝ := 4*∑ p∈q.primeFactors,Real.log (p:ℝ)*(p:ℝ)^(-(1/2):ℝ)
  obtain ⟨V,G,hV,_,_,hGNorm,hGE, _⟩ := hAux 1 χ s.im
  have hv (i : ι) (hi : i∈S) : 1<(v i).re := by simpa [v,Complex.add_re] using (hShift i hi).1
  have hB (i : ι) (hi : i∈S) : v i∈closedBall (line 1 s.im) (1/4) := by
    have he : v i-line 1 s.im=((((v i).re-1):ℝ):ℂ) := by
      apply Complex.ext <;> simp [v,line,Complex.sub_re,Complex.sub_im]
    rw [mem_closedBall_iff_norm,he,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (sub_pos.mpr (hv i hi))]
    have hh : (v i).re≤1+1/4 := by simpa [v,Complex.add_re] using (hShift i hi).2
    linarith only [hh]
  let G' (z : ℂ) : ℂ := G z+1/(z-1)
  have hD (i : ι) (hi : i∈S) :
      -logDeriv χ.LFunction (v i)=G' (v i)-
        ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*(1/(v i-ρ)) := by
    have hh := hGE _ (hB i hi) (hv i hi)
    simpa only [G',χ,principalFlag,ite_true,mul_one_div] using hh
  have hTest := exponentialPrimeTest_eq_local S a b χ hL s V (analyticOrderNatAt (regularizedL χ)) G'
    (by exact hD)
  have hPole : (∑ i∈S,(c i:ℂ)*G' (v i))=
      (∑ i∈S,(c i:ℂ)*G (v i))+(L:ℂ)*exponentialAutoTransform S a b ((L:ℂ)*(s-1)) := by
    unfold G' exponentialAutoTransform
    simp only [mul_add,Finset.sum_add_distrib,Finset.mul_sum]
    apply congrArg ((∑ i∈S,(c i:ℂ)*G (v i)) + ·)
    refine Finset.sum_congr rfl fun i _=> ?_
    unfold v
    rw [principal_scaled_resolvent hL]
    ring
  have hRe := congrArg Complex.re hTest
  change (exponentialPrimeTest S a b χ L s).re=
    ((∑ i∈S,(c i:ℂ)*G' (v i))-(L:ℂ)*∑ ρ∈V,
      (analyticOrderNatAt (regularizedL χ) ρ:ℂ)*exponentialAutoTransform S a b ((L:ℂ)*(s-ρ))).re at hRe
  rw [hPole,Complex.sub_re,Complex.add_re,Complex.re_ofReal_mul,Complex.re_ofReal_mul] at hRe
  have hSumPos : 0≤(∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℂ)*
      exponentialAutoTransform S a b ((L:ℂ)*(s-ρ))).re := by
    rw [Complex.re_sum]
    apply Finset.sum_nonneg
    intro ρ hρ
    rw [←Complex.ofReal_natCast,Complex.re_ofReal_mul]
    refine mul_nonneg (Nat.cast_nonneg _) (exponentialAutoTransform_re_nonneg S a b hb ?_)
    rw [Complex.re_ofReal_mul,Complex.sub_re]
    exact mul_nonneg hL.le (sub_nonneg.mpr (hZeros ρ (hV ρ hρ).1 (hV ρ hρ).2.2))
  have hGSum : (∑ i∈S,(c i:ℂ)*G (v i)).re≤J*(A*logHeight 1 s.im) := calc
    _ ≤ ‖∑ i∈S,(c i:ℂ)*G (v i)‖ := Complex.re_le_norm _
    _ ≤ ∑ i∈S,‖(c i:ℂ)*G (v i)‖ := norm_sum_le _ _
    _ ≤ ∑ i∈S,|c i| * (A*logHeight 1 s.im) := by
      apply Finset.sum_le_sum
      intro i hi
      rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_left (hGNorm _ (hB i hi)) (abs_nonneg _)
    _ = _ := by rw [Finset.sum_mul]
  have hc : (exponentialPrimeTest S a b χ L s).re≤L*(exponentialAutoTransform S a b ((L:ℂ)*(s-1))).re+
        J*(A*logHeight 1 s.im) := by
    linarith only [hGSum,hRe,mul_nonneg hL.le hSumPos]
  have hLevel : ‖exponentialPrimeTest S a b (1:DirichletCharacter ℂ q) L s-
      exponentialPrimeTest S a b χ L s‖≤J*E := by
    unfold exponentialPrimeTest
    rw [←Finset.sum_sub_distrib]
    apply (norm_sum_le _ _).trans
    rw [Finset.sum_mul]
    apply Finset.sum_le_sum
    intro i hi
    rw [←mul_sub,norm_mul,Complex.norm_real,Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left (principal_logDeriv_level_error (q:=q) (hv i hi)) (abs_nonneg _)
  have hFinal := (Complex.re_le_norm _).trans hLevel
  rw [Complex.sub_re] at hFinal
  change _≤ L*(exponentialAutoTransform S a b ((L:ℂ)*(s-1))).re+J*(A*logHeight 1 s.im+E)
  linarith only [hc,hFinal]

end

end GoldbachPintzWeightedFormula
end

