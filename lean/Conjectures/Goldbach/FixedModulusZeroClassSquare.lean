namespace GoldbachSignedPairs

open Finset Filter Complex Goldbach GoldbachTwistedMellin
open scoped Classical Topology

noncomputable section

/-- A clean height can be chosen from a finite interval independent of the modulus.
Its gap contains the windows needed for all products of up to four prime-test phases. -/
theorem eventually_clean_modulus_height {H T : ℝ} (hH : 0≤H) :
    ∃ U : ℝ, 2≤U ∧ T≤U ∧ ∀ᶠ q : ℕ in atTop, ∀ [NeZero q],
      ∃ R : ℝ, 2≤R ∧ T≤R ∧ R≤U ∧
        ∀ (χ : DirichletCharacter ℂ q) (z : ℂ), χ≠1 →
          1/2<z.re → regularizedL χ z=0 →
          (1-z.re)*Real.log (q:ℝ)≤H → |z.im|≤4*R+2 → |z.im|≤R := by
  obtain ⟨B,hB⟩ := eventually_fixed_modulus_count_bound hH
  let A := max 2 T
  let U := A*5^B
  have hA : 2≤A := le_max_left _ _
  have hAT : T≤A := le_max_right _ _
  have hAU : A≤U := by
    exact le_mul_of_one_le_right (by linarith only [hA])
      (one_le_pow₀ (by norm_num : (1:ℝ)≤5))
  have hU : 0≤4*U+2 := by linarith only [hA,hAU]
  refine ⟨U,hA.trans hAU,hAT.trans hAU,?_⟩
  filter_upwards [hB (4*U+2) hU] with q hQ
  intro inst
  let S := modulusZeros q H (4*U+2)
  obtain ⟨R,hRA,hRU,hGap⟩ := exists_empty_dilated_height_interval S
    (fun p : DirichletCharacter ℂ q × ℂ => |p.2.im|) hQ hA
  refine ⟨R,hA.trans hRA,hAT.trans hRA,hRU,?_⟩
  intro χ z hχ hzRe hz hLocal hIm
  have hzV : (χ,z)∈S := mem_fixed_modulus_zeros.mpr
    ⟨hχ,(mem_exceptionalZeros _ _ _).mpr ⟨hzRe,hIm.trans (by linarith only [hRU]),hz⟩,hLocal⟩
  exact (hGap (χ,z) hzV).resolve_right (not_lt_of_ge hIm)


theorem clean_height_local_zeros {q : ℕ} [NeZero q] {H R σ t : ℝ}
    {χ : DirichletCharacter ℂ q} (hχ : χ≠1) (hσ : (1:ℝ)/2<σ)
    (hLog : 0≤Real.log (q:ℝ)) (hS : (1-σ)*Real.log (q:ℝ)≤H)
    (ht : |t|≤4*R+1)
    (hClean : ∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
      1/2<z.re → regularizedL ψ z=0 →
      (1-z.re)*Real.log (q:ℝ)≤H → |z.im|≤4*R+2 → |z.im|≤R) :
    ∀ z : ℂ, regularizedL χ z=0 → |z.im-t|≤1 → σ<z.re →
      (χ,z)∈modulusZeros q H R := by
  intro z hz hclose hRight
  have hRe := hσ.trans hRight
  have hG : (1-z.re)*Real.log (q:ℝ)≤H :=
    (mul_le_mul_of_nonneg_right (sub_le_sub_left hRight.le 1) hLog).trans hS
  have hIm : |z.im|≤4*R+2 := calc
    _ ≤ |z.im-t|+|t| := by
      simpa only [sub_add_cancel] using (abs_add_le (z.im-t) t)
    _ ≤ _ := by linarith only [hclose,ht]
  exact mem_fixed_modulus_zeros.mpr
    ⟨hχ,(mem_exceptionalZeros _ _ _).mpr ⟨hRe,hClean χ z hχ hRe hz hG hIm,hz⟩,hG⟩

theorem clean_height_local_leading {q : ℕ} [NeZero q] {H R σ t : ℝ}
    {χ : DirichletCharacter ℂ q} (hχ : χ≠1) (hσ : (1:ℝ)/2<σ)
    (hLog : 0≤Real.log (q:ℝ)) (hS : (1-σ)*Real.log (q:ℝ)≤H) (ht : |t|≤4*R+1)
    (hClean : ∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
      1/2<z.re → regularizedL ψ z=0 →
      (1-z.re)*Real.log (q:ℝ)≤H → |z.im|≤4*R+2 → |z.im|≤R)
    (hLead : ∀ p∈modulusZeros q H R, p.2.re≤σ) :
    ∀ z : ℂ, regularizedL χ z=0 → |z.im-t|≤1 → z.re≤σ := by
  intro z hz hclose
  by_contra! hRight
  exact hRight.not_ge (hLead _ (clean_height_local_zeros hχ hσ hLog hS ht hClean z hz hclose hRight))

end
end GoldbachSignedPairs
end

section
namespace GoldbachSignedPairs

open Finset
open scoped Classical

theorem classMassSq_le_of_excess_tail {ι κ : Type*} (S : Finset ι) (key : ι → κ)
    (a b : ι → ℝ) {A B C : ℝ}
    (ha : ∀ i ∈ S, 0 ≤ a i) (hb : ∀ i ∈ S, 0 ≤ b i)
    (hA : (∑ i ∈ S,a i) ≤ A) (hB0 : 0 ≤ B)
    (hB : ∀ k ∈ S.image key, (∑ i ∈ S.filter (fun j => key j=k),b i) ≤ B)
    (hC : (∑ i ∈ S,b i) ≤ C) :
    classMassSq S key (fun i => a i+b i) ≤ A^2+B*(2*A+C) := by
  let W := S.image key
  let u (k : κ) := ∑ i ∈ S.filter (fun j => key j=k),a i
  let v (k : κ) := ∑ i ∈ S.filter (fun j => key j=k),b i
  let A₀ := ∑ i ∈ S,a i
  let C₀ := ∑ i ∈ S,b i
  have hu (k : κ) : 0 ≤ u k := sum_nonneg (fun i hi => ha i (mem_filter.mp hi).1)
  have hv (k : κ) : 0 ≤ v k := sum_nonneg (fun i hi => hb i (mem_filter.mp hi).1)
  have hA₀ : 0 ≤ A₀ := sum_nonneg ha
  have hC₀ : 0 ≤ C₀ := sum_nonneg hb
  have hmap : (S : Set ι).MapsTo key W := fun i hi => mem_image_of_mem _ hi
  have hU : ∑ k ∈ W,u k = A₀ := sum_fiberwise_of_maps_to hmap a
  have hV : ∑ k ∈ W,v k = C₀ := sum_fiberwise_of_maps_to hmap b
  have hP (k : κ) : u k ≤ A₀ := by
    exact sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun i hi _ => ha i hi)
  have heq : classMassSq S key (fun i => a i+b i) = ∑ k ∈ W,(u k+v k)^2 := by
    simp only [classMassSq,sum_add_distrib]
    rfl
  rw [heq]
  calc
    _ ≤ ∑ k ∈ W,(A₀*u k+B*(2*u k+v k)) := by
      apply sum_le_sum
      intro k hk
      have h1 := mul_le_mul_of_nonneg_right (hP k) (hu k)
      have h2 := mul_le_mul_of_nonneg_right (hB k hk)
        (show 0 ≤ 2*u k+v k from add_nonneg (by positivity [hu k]) (hv k))
      nlinarith only [h1,h2]
    _ = A₀^2+B*(2*A₀+C₀) := by
      simp only [sum_add_distrib,← mul_sum,hU,hV]
      ring
    _ ≤ _ := by
      apply add_le_add (pow_le_pow_left₀ hA₀ hA 2)
      exact mul_le_mul_of_nonneg_left (add_le_add
        (mul_le_mul_of_nonneg_left hA (by norm_num)) hC) hB0


end GoldbachSignedPairs
end

section
namespace GoldbachPintzNumerics

open Set

noncomputable section

private def rationalSlope (b x : ℝ) : ℝ :=
  1/(b+x)^2+2*b/(b+x)^3+2*b^2/(b+x)^4

private theorem hasDeriv_rationalKernel {b x : ℝ} (h : 0<b+x) :
    HasDerivAt (realRationalZeroKernel b) (-rationalSlope b x) x := by
  have hn : b+x≠0 := h.ne'
  have hd : HasDerivAt (fun z : ℝ => b+z) 1 x := by
    simpa only [id_eq] using (hasDerivAt_id x).const_add b
  have g₁ := hd.inv hn
  have g₂ := g₁.pow 2
  have g₃ := g₁.pow 3
  unfold realRationalZeroKernel rationalSlope
  convert (g₁.add (g₂.const_mul b)).add (g₃.const_mul (2*b^2/3)) using 1
  · funext z
    simp only [Pi.add_apply,Pi.inv_apply,Pi.pow_apply,inv_pow,div_eq_mul_inv,one_mul]
  · change -(1/(b+x)^2+2*b/(b+x)^3+2*b^2/(b+x)^4) =
      -1/(b+x)^2+b*((2:ℝ)*((b+x)⁻¹)^(2-1)*(-1/(b+x)^2))+
        (2*b^2/3)*((3:ℝ)*((b+x)⁻¹)^(3-1)*(-1/(b+x)^2))
    rw [← one_div (b+x)]
    norm_num only [Nat.reduceSub,pow_one,div_pow,one_pow]
    field_simp [hn]
    ring

private theorem rationalKernel_antitone {b : ℝ} (hb : 0<b) :
    AntitoneOn (realRationalZeroKernel b) (Ici 0) := by
  refine antitoneOn_of_deriv_nonpos (convex_Ici 0) ?_ ?_ ?_
  · intro x hx
    exact (hasDeriv_rationalKernel (by linarith only [hb,show 0≤x from hx])).continuousAt.continuousWithinAt
  · intro x hx
    exact (hasDeriv_rationalKernel (by linarith only [hb,show 0≤x from interior_subset hx])).differentiableAt.differentiableWithinAt
  · intro x hx
    have hp : 0<b+x := by linarith only [hb,show 0≤x from interior_subset hx]
    rw [(hasDeriv_rationalKernel hp).deriv]
    exact neg_nonpos.mpr (by unfold rationalSlope; positivity)

private theorem exp_over_pow_monotone {a b A : ℝ} (hb : 0<b) (hA : 0≤A) (j : ℕ)
    (hj : (j:ℝ)≤A*b) : MonotoneOn (fun x => Real.exp (A*x)/(b+(x-a))^j) (Ici a) := by
  intro x hx y hy hxy
  let U := b+(x-a)
  let V := b+(y-a)
  have hx' : a ≤ x := hx
  have hy' : a ≤ y := hy
  have hU : 0<U := by dsimp only [U]; linarith only [hb,hx']
  have hV : 0<V := by dsimp only [V]; linarith only [hb,hy']
  have hBU : b≤U := by dsimp only [U]; linarith only [hx']
  have hQ : 0<V/U := div_pos hV hU
  have hLog : Real.log (V/U) ≤ (y-x)/U := (Real.log_le_sub_one_of_pos hQ).trans_eq (by
    field_simp [hU.ne']
    dsimp only [U,V]
    ring)
  have hAU : (j:ℝ)≤A*U := hj.trans (mul_le_mul_of_nonneg_left hBU hA)
  have hPow : (V/U)^j≤Real.exp (A*(y-x)) := by
    have he : (V/U)^j=Real.exp ((j:ℝ)*Real.log (V/U)) := by
      rw [← Real.rpow_natCast,Real.rpow_def_of_pos hQ,mul_comm]
    rw [he]
    apply Real.exp_le_exp.mpr
    refine (mul_le_mul_of_nonneg_left hLog (Nat.cast_nonneg _)).trans ?_
    rw [←mul_div_assoc]
    apply (div_le_iff₀ hU).mpr
    exact (mul_le_mul_of_nonneg_right hAU (sub_nonneg.mpr hxy)).trans_eq (by ring)
  have hPow' : V^j/U^j ≤ Real.exp (A*(y-x)) := by simpa only [div_pow] using hPow
  have hM := (div_le_iff₀ (pow_pos hU _)).mp hPow'
  change Real.exp (A*x)/U^j≤Real.exp (A*y)/V^j
  apply (div_le_div_iff₀ (pow_pos hU _) (pow_pos hV _)).mpr
  refine (mul_le_mul_of_nonneg_left hM (Real.exp_nonneg _)).trans_eq ?_
  rw [← mul_assoc,← Real.exp_add,show A*x+A*(y-x)=A*y by ring]

private theorem exp_rationalSlope_monotone {a b A : ℝ} (hb : 0<b) (hA : 0≤A)
    (hSize : (4:ℝ)≤A*b) :
    MonotoneOn (fun x => Real.exp (A*x)*rationalSlope b (x-a)) (Ici a) := by
  have h₂ := exp_over_pow_monotone (a:=a) hb hA 2 (by norm_num; linarith only [hSize])
  have h₃ := exp_over_pow_monotone (a:=a) hb hA 3 (by norm_num; linarith only [hSize])
  have h₄ := exp_over_pow_monotone (a:=a) hb hA 4 (by exact_mod_cast hSize)
  intro x hx y hy hxy
  have hL := h₂ hx hy hxy
  have hM := mul_le_mul_of_nonneg_left (h₃ hx hy hxy) (show 0≤2*b by positivity)
  have hR := mul_le_mul_of_nonneg_left (h₄ hx hy hxy) (show 0≤2*b^2 by positivity)
  unfold rationalSlope
  dsimp only at hL hM hR ⊢
  linear_combination hL + hM + hR

private theorem endpoint_max_of_crossing_derivative {a r s x : ℝ} (har : a ≤ r) (hrx : r ≤ x) (hxs : x ≤ s)
    {D J : ℝ→ℝ} {A : ℝ} (hJ : MonotoneOn J (Ici a))
    (hD : ∀ t≥a, HasDerivAt D (Real.exp (-A*t)*J t) t) :
    D x ≤ max (D r) (D s) := by
  rcases le_total (J x) 0 with h|h
  · have hAnti : AntitoneOn D (Icc r x) := by
      refine antitoneOn_of_deriv_nonpos (convex_Icc _ _)
        (fun t ht => (hD t (har.trans ht.1)).continuousAt.continuousWithinAt)
        (fun t ht => (hD t (har.trans (interior_subset ht).1)).differentiableAt.differentiableWithinAt) ?_
      intro t ht
      obtain ⟨h₁,h₂⟩ := interior_subset ht
      rw [(hD t (har.trans h₁)).deriv]
      exact mul_nonpos_of_nonneg_of_nonpos (Real.exp_nonneg _) ((hJ (har.trans h₁) (har.trans hrx) h₂).trans h)
    exact (hAnti ⟨le_rfl,hrx⟩ ⟨hrx,le_rfl⟩ hrx).trans (le_max_left _ _)
  · have hMono : MonotoneOn D (Icc x s) := by
      refine monotoneOn_of_deriv_nonneg (convex_Icc _ _)
        (fun t ht => (hD t (har.trans (hrx.trans ht.1))).continuousAt.continuousWithinAt)
        (fun t ht => (hD t (har.trans (hrx.trans (interior_subset ht).1))).differentiableAt.differentiableWithinAt) ?_
      intro t ht
      obtain ⟨h₁,h₂⟩ := interior_subset ht
      rw [(hD t (har.trans (hrx.trans h₁))).deriv]
      exact mul_nonneg (Real.exp_nonneg _) (h.trans (hJ (har.trans hrx) (har.trans (hrx.trans h₁)) h₁))
    exact (hMono ⟨le_rfl,hxs⟩ ⟨hxs,le_rfl⟩ hxs).trans (le_max_right _ _)

theorem rational_excess_one_threshold_le {a c H b A α β x : ℝ}
    (hb : 0 < b) (hA : 0 ≤ A) (hAb : 4 ≤ A*b)
    (hα : 0 ≤ α) (hβ : 0 ≤ β) (hac : a ≤ c) (hch : c ≤ H)
    (hStart : Real.exp (-A*a)-Real.exp (-A*H)-
        β*(realRationalZeroKernel b 0-realRationalZeroKernel b (H-a)) ≤ α)
    (hCut : Real.exp (-A*c)-Real.exp (-A*H) ≤
        β*(realRationalZeroKernel b (c-a)-realRationalZeroKernel b (H-a)))
    (hx : a ≤ x) :
    max 0 (Real.exp (-A*x)-Real.exp (-A*H)) ≤
      (if x<c then α else 0)+β*
        max 0 (realRationalZeroKernel b (x-a)-realRationalZeroKernel b (H-a)) := by
  let f := realRationalZeroKernel b
  let E (t : ℝ) := Real.exp (-A*t)-Real.exp (-A*H)
  let R (t : ℝ) := f (t-a)-f (H-a)
  let D (t : ℝ) := E t-β*R t
  let J (t : ℝ) := -A+β*(Real.exp (A*t)*rationalSlope b (t-a))
  have hAH : a ≤ H := hac.trans hch
  have hF : AntitoneOn f (Ici 0) := rationalKernel_antitone hb
  have hJ : MonotoneOn J (Ici a) := by
    have hM := exp_rationalSlope_monotone (a:=a) (b:=b) (A:=A) hb hA hAb
    intro w hw v hv h
    exact add_le_add (le_refl _) (mul_le_mul_of_nonneg_left (hM hw hv h) hβ)
  have hD (t : ℝ) (ht : a ≤ t) : HasDerivAt D (Real.exp (-A*t)*J t) t := by
    have hE := ((((hasDerivAt_id t).const_mul (-A)).exp).sub_const (Real.exp (-A*H)))
    have hR := ((hasDeriv_rationalKernel (b:=b) (x:=t-a) (by linarith only [hb,ht])).comp t
      ((hasDerivAt_id t).sub_const a)).sub_const (f (H-a))
    have hh := hE.sub (hR.const_mul β)
    apply hh.congr_deriv
    simp only [id_eq,mul_one,J]
    have he : Real.exp (-A*t)*Real.exp (A*t)=1 := by
      rw [←Real.exp_add,show -A*t+A*t=(0:ℝ) by ring,Real.exp_zero]
    linear_combination -β*(rationalSlope b (t-a))*he
  have hD0 : D a≤α := by simpa only [D,E,R,f,sub_self] using hStart
  have hD1 : D c≤0 := sub_nonpos.mpr hCut
  have hD2 : D H=0 := by simp [D,E,R]
  by_cases h₁ : x≤H
  · have hR : 0≤R x := sub_nonneg.mpr (hF (sub_nonneg.mpr hx)
      (sub_nonneg.mpr hAH) (sub_le_sub_right h₁ _))
    have hE : 0≤E x := sub_nonneg.mpr (Real.exp_le_exp.mpr
      (mul_le_mul_of_nonpos_left h₁ (neg_nonpos.mpr hA)))
    change max 0 (E x) ≤ (if x<c then α else 0)+β*max 0 (R x)
    rw [max_eq_right hE,max_eq_right hR]
    by_cases hh : x<c
    · rw [ite_eq_left hh]
      have hh' := endpoint_max_of_crossing_derivative (a:=a) (r:=a) (s:=c)
        le_rfl hx hh.le hJ hD
      have he := hh'.trans (max_le hD0 (hD1.trans hα))
      change E x-β*R x≤α at he
      linarith only [he]
    · rw [ite_eq_right hh]
      have hh' := endpoint_max_of_crossing_derivative (a:=a) (r:=c) (s:=H)
        hac (le_of_not_gt hh) h₁ hJ hD
      have he := hh'.trans (max_le hD1 hD2.le)
      change E x-β*R x≤0 at he
      linarith only [he]
  · have hE : E x≤0 := sub_nonpos.mpr (Real.exp_le_exp.mpr
      (mul_le_mul_of_nonpos_left (le_of_not_ge h₁) (neg_nonpos.mpr hA)))
    change max 0 (E x) ≤ (if x<c then α else 0)+β*max 0 (R x)
    rw [max_eq_left hE]
    split <;> positivity

end
end GoldbachPintzNumerics
end

