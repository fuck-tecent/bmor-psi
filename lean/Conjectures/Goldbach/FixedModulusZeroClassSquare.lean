        nhdsWithin_le_nhds (isOpen_ball.mem_nhds hinner)
      have hd : ∀ᶠ z in 𝓝[≠] w, z∉Z.erase w :=
        nhdsWithin_le_nhds ((Z.erase w).finite_toSet.isClosed.isOpen_compl.mem_nhds (by simp))
      have hn : ∀ᶠ z in 𝓝[≠] w, z≠w := by simpa using (eventually_mem_nhdsWithin (a:=w) (s:={w}ᶜ))
      filter_upwards [hk,hd,hn] with z hz hz' hne
      have hzZ : z∉Z := fun hzZ => hz' (Finset.mem_erase.mpr ⟨hne,hzZ⟩)
      have hzf : f z≠0 := fun he => hzZ ((hZU z).mpr ⟨hsubset hz,he⟩)
      have ha := hApprox z (ball_subset_closedBall hz) hzf
      rw [hGe' z (hsubset hz) hzZ,add_sub_cancel_right] at ha
