    have hx := congrArg (eval x) (mul_esymm_eq_sum (Fin s) ℚ k)
    have hy := congrArg (eval y) (mul_esymm_eq_sum (Fin s) ℚ k)
    simp only [map_mul,map_natCast,map_pow,map_neg,map_one,map_sum] at hx hy
