noncomputable section


noncomputable def exponentialAutoTransformReal {ι : Type*}
    (S : Finset ι) (a b : ι→ℝ) (x : ℝ) : ℝ :=
  (exponentialAutoTransform S a b (x:ℂ)).re

theorem exponentialAutoTransformReal_nonneg {ι : Type*} (S : Finset ι) (a b : ι→ℝ)
    (hb : ∀ i∈S,0<b i) (ha : ∀ u≥0,0≤exponentialPulse S a b u) (x : ℝ)
    (hx : ∀ i∈S,0<b i+x) : 0≤exponentialAutoTransformReal S a b x := by
  unfold exponentialAutoTransformReal
  rw [exponentialAutoTransform_eq_integral S a b _ (by simpa using hx)]
  simp_rw [←Complex.ofReal_neg,←Complex.ofReal_mul,←Complex.ofReal_exp,←Complex.ofReal_mul]
  rw [integral_complex_ofReal,Complex.ofReal_re]
  exact setIntegral_nonneg measurableSet_Ioi fun t ht=>
    mul_nonneg (exponentialAutoWeight_nonneg S a b hb ha (Set.mem_Ioi.mp ht).le) (by positivity)

theorem exponentialAutoWeight_zero {ι : Type*} (S : Finset ι) (a b : ι→ℝ) :
    exponentialAutoWeight S a b 0=∑ i∈S,exponentialAutoCoeff S a b i := by
  simp [exponentialAutoWeight,exponentialPulse]

set_option maxHeartbeats 2000000 in
/-- The four-term real-zero test at the real part of the second zero.
Only the chosen leading zero may exceed that real part in the relevant windows. -/
theorem exponential_real_runner_up_gap_eventually {ι : Type*}
    (S : Finset ι) (a b : ι→ℝ) {ε b₀ C κ K D p H : ℝ}
    (hε : 0<ε) (hb₀ : 0<b₀) (hC : 0≤C)
    (hb : ∀ i∈S,b₀≤ b i ∧ b i≤b₀+C) (ha : ∀ u≥0,0≤exponentialPulse S a b u)
    (hκ : 0<κ)
    (hK : 0<K) (hD : 0≤D) (hp : 0≤p) (hH : 0≤H) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q] (ξ χ : DirichletCharacter ℂ q)
      (σ β γ B T : ℝ) (φ : DirichletCharacter ℂ q→ℝ),
      ξ^2=1 → ξ≠1 → χ≠1 → ξ*χ≠1 →
      Real.log (q:ℝ)≤L → 1-H/L≤β → β≤σ → σ≤1 →
      1+κ/L≤β+b₀/L → |γ|≤L^p →
      |γ|+1/4≤T → logHeight q 0≤K*L → logHeight q γ≤K*L →
      1≤B → Real.log B≤D*Real.log L →
      (∀ ψ, ψ≠1 → 0≤φ ψ) →
      (∀ ψ, ψ≠1 → ∀ z : ℂ, 3/4≤ z.re → z.re≤3/2 → |z.im|≤T →
        ‖ψ.LFunction z‖≤B*(q:ℝ)^(φ ψ*max 0 (1-z.re))) →
      regularizedL ξ (line σ 0)=0 → regularizedL χ (line β γ)=0 →
      (∀ ψ, ψ=ξ ∨ ψ=χ ∨ ψ=ξ*χ → ∀ ρ : ℂ, regularizedL ψ ρ=0 →
        (|ρ.im|≤1 ∨ |ρ.im-γ|≤1) → (ψ=ξ ∧ ρ=line σ 0) ∨ ρ.re≤ β) →
      exponentialAutoTransformReal S a b 0 ≤
        exponentialAutoTransformReal S a b (L*(β-1))-exponentialAutoTransformReal S a b (L*(β-σ))+
          exponentialAutoWeight S a b 0*((φ ξ+φ χ+φ (ξ*χ))/2)+ε := by
  have hε4 : 0<ε/4 := by positivity
  have hb' : ∀ i∈S,0<b i := fun i hi=>hb₀.trans_le (hb i hi).1
  have hc : 0≤∑ i∈S,exponentialAutoCoeff S a b i := by
    rw [←exponentialAutoWeight_zero]
    exact exponentialAutoWeight_nonneg S a b hb' ha (le_refl 0)
  obtain ⟨r,L₀,hr,hr32,hL₀,hN⟩ := exponential_prime_nonprincipal_upper S a b
    hb₀ hC hb hε4 hK hD hκ hc
  have hP := exponential_prime_principal_upper_eventually (p:=p) S a b hε4 hb₀ hC hH hp hb
  filter_upwards [hP,eventually_ge_atTop (max L₀ (H/(2*r)))]
    with L hP hL q _ ξ χ σ β γ B T φ hξQ hξ hχ hξχ
      hq hβ₀ hβ hσ hS hγ hT hHL0 hHLγ hB hBL hφ hstrip hzξ hzχ hLead
  have hL' : L₀≤L := (le_max_left _ _).trans hL
  have hL0 : 0<L := zero_lt_one.trans_le (hL₀.trans hL')
  have hQ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
  have hβ1 : β≤1 := hβ.trans hσ
  have hLL : H/L≤2*r := by
    have hh := (div_le_iff₀ (show 0<2*r by positivity)).mp ((le_max_right _ _).trans hL)
    exact (div_le_iff₀ hL0).mpr (by nlinarith only [hh])
  have hShift : 1<β+b₀/L := (lt_add_of_pos_right _ (div_pos hκ hL0)).trans_le hS
  have hT0 : (1/4:ℝ)≤T := by linarith only [hT,abs_nonneg γ]
  have hP0 := hP q (line β 0) hq (by simpa [line] using hβ₀)
    (by simpa [line] using hβ1)
    (by simpa [line] using Real.rpow_nonneg hL0.le p) (by simpa [line] using hShift)
  have hPlabel : (L:ℂ)*(line β 0-1)=((L*(β-1):ℝ):ℂ) := by
    have he : line 1 0=1 := by simp [line]
    rw [←he,runner_fixed_height_sub,Complex.ofReal_mul]
  rw [hPlabel] at hP0
  change _≤L*exponentialAutoTransformReal S a b (L*(β-1))+(ε/4)*L at hP0
  have hGeo (x t : ℝ) (hx₁ : 1-H/L≤x) (hx₂ : x≤1) :
      ‖line x t-line 1 t‖≤2*r := by
    rw [runner_fixed_height_sub,Complex.norm_real,Real.norm_eq_abs,abs_of_nonpos (sub_nonpos.mpr hx₂)]
    linarith only [hx₁,hLL]
  have hLocal (ψ : DirichletCharacter ℂ q) (hψ : ψ≠1) (t : ℝ)
      (ht : |t|+1/4≤T) (hHt : logHeight q t≤K*L) :
      ∃ V : Finset ℂ,
      (∀ ρ∈V, regularizedL ψ ρ=0 ∧ |ρ.im-t|≤1) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 t‖≤2*r → regularizedL ψ ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V → (∀ ρ∈V, ρ∉U → ρ.re≤ β) →
        (exponentialPrimeTest S a b ψ L (line β t)).re≤
          exponentialAutoWeight S a b 0*(φ ψ*L/2)+(ε/4)*L-
          L*∑ ρ∈U,(analyticOrderNatAt (regularizedL ψ) ρ:ℝ)*
            (exponentialAutoTransform S a b ((L:ℂ)*(line β t-ρ))).re := by
    obtain ⟨V,hV,hCov,hEst⟩ := hN q ψ hψ (s:=line β t) (Q:=(q:ℝ)) hL'
      (by simpa [line] using hS) (by simpa [line] using hβ1)
      (by simpa [line] using ht) (by simpa [line] using hHt)
      (hφ ψ hψ) hB hQ hBL (hstrip ψ hψ)
    refine ⟨V,?_,(by simpa [line] using hCov),?_⟩
    · intro ρ hρ
      have hi := (Complex.abs_im_le_norm (ρ-line 1 t)).trans
        (show ‖ρ-line 1 t‖≤2*r by simpa [line] using (hV ρ hρ).2.2)
      have hw : |ρ.im-t|≤1 :=
        (show |ρ.im-t|≤2*r by simpa [line,Complex.sub_im] using hi).trans (by linarith only [hr32])
      exact ⟨(hV ρ hρ).1,hw⟩
    · intro U hU hD'
      have hh := hEst U hU (by simpa [line] using hD')
      have hq' := mul_le_mul_of_nonneg_left hq (hφ ψ hψ)
      have hq'' := mul_le_mul_of_nonneg_left hq' hc
      rw [←exponentialAutoWeight_zero] at hh hq''
      linarith only [hh,hq'']
  have hχξ : χ≠ξ := by
    intro he
    apply hξχ
    rw [he,←pow_two]
    exact hξQ
  have hprodξ : ξ*χ≠ξ := by
    intro he
    apply hχ
    calc
      _ = ξ⁻¹*(ξ*χ) := by simp [←mul_assoc]
      _ = _ := by rw [he,inv_mul_cancel]
  obtain ⟨Vξ,hVξ,hCξ,hUξ⟩ := hLocal ξ hξ 0 (by simpa using hT0) hHL0
  obtain ⟨Vχ,hVχ,hCχ,hUχ⟩ := hLocal χ hχ γ hT hHLγ
  obtain ⟨Vp,hVp,_,hUp⟩ := hLocal (ξ*χ) hξχ γ hT hHLγ
  have hMemξ := hCξ _ (hGeo σ 0 (hβ₀.trans hβ) hσ) hzξ
  have hMemχ := hCχ _ (hGeo β γ hβ₀ hβ1) hzχ
  have hUξ' := hUξ {line σ 0} (Finset.singleton_subset_iff.mpr hMemξ) (by
    intro ρ hρ hN
    rcases hLead ξ (Or.inl rfl) ρ (hVξ ρ hρ).1 (Or.inl (by simpa using (hVξ ρ hρ).2)) with h | h
    · exact False.elim (hN (Finset.mem_singleton.mpr h.2))
    · exact h)
  have hUχ' := hUχ {line β γ} (Finset.singleton_subset_iff.mpr hMemχ) (by
    intro ρ hρ _
    rcases hLead χ (Or.inr (Or.inl rfl)) ρ (hVχ ρ hρ).1 (Or.inr (hVχ ρ hρ).2) with h | h
    · exact False.elim (hχξ h.1)
    · exact h)
  have hUp' := hUp ∅ (Finset.empty_subset _) (by
    intro ρ hρ _
    rcases hLead (ξ*χ) (Or.inr (Or.inr rfl)) ρ (hVp ρ hρ).1 (Or.inr (hVp ρ hρ).2) with h | h
    · exact False.elim (hprodξ h.1)
    · exact h)
  have h0 : (exponentialAutoTransform S a b 0).re=exponentialAutoTransformReal S a b 0 := rfl
  simp only [Finset.sum_singleton,runner_fixed_height_sub,←Complex.ofReal_mul] at hUξ'
  simp only [Finset.sum_singleton,sub_self,mul_zero,h0] at hUχ'
  simp only [Finset.sum_empty,mul_zero,sub_zero] at hUp'
  have hmξ : (1:ℝ)≤analyticOrderNatAt (regularizedL ξ) (line σ 0) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff ξ _).mpr hzξ
  have hmχ : (1:ℝ)≤analyticOrderNatAt (regularizedL χ) (line β γ) := by
    exact_mod_cast (regularizedL_analyticOrderNatAt_pos_iff χ _).mpr hzχ
  have hLβ (i : ι) (hi : i∈S) : 0<b i+L*(β-σ) := by
    have hη := mul_le_mul_of_nonneg_left hS hL0.le
    simp only [mul_add,mul_one,mul_div_cancel₀ _ hL0.ne'] at hη
    nlinarith only [hη,hκ,(hb i hi).1,mul_nonneg hL0.le (sub_nonneg.mpr hσ)]
  have hfξ := exponentialAutoTransformReal_nonneg S a b hb' ha _ hLβ
  have hfχ := exponentialAutoTransformReal_nonneg S a b hb' ha 0 (by simpa using hb')
  have hmξ' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hmξ hfξ) hL0.le
  have hmχ' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hmχ hfχ) hL0.le
  have hsh (i : ι) (hi : i∈S) : 1<β+b i/L := hShift.trans_le
    (add_le_add_right (div_le_div_of_nonneg_right (hb i hi).1 hL0.le) _)
  have hPos := quadratic_four_exponential_primeTest_nonneg S a b ξ χ hξQ (σ:=β) (t:=γ) hL0 hb' ha hsh
  refine le_of_mul_le_mul_left ?_ hL0
  change _≤exponentialAutoWeight S a b 0*(φ ξ*L/2)+(ε/4)*L -
    L*((analyticOrderNatAt (regularizedL ξ) (line σ 0):ℝ)*
      exponentialAutoTransformReal S a b (L*(β-σ))) at hUξ'
  linear_combination hP0+hUξ'+hUχ'+hUp'+hmξ'+hmχ'+hPos

end

end GoldbachPintzWeightedFormula
