noncomputable section

private theorem rationalZeroKernel_re_nonneg_of_re {b : ℝ} {z : ℂ}
    (hb : 0<b) (hz : 0≤z.re) :
    0≤(rationalZeroKernel b z).re :=
  (Complex.re_add_im z) ▸ rationalZeroKernel_re_nonneg (t:=z.im) hb hz

set_option maxHeartbeats 1300000 in
/-- Sharp rational weighted prime inequality at the conductor logarithm.
A selected subtable is permitted whenever its discarded zeros lie to the
left of the original real evaluation line. -/
theorem rational_prime_test_sharp_with_window
    {ε κ b K D C : ℝ} (hε : 0<ε) (hκ : 0<κ) (hb : 0<b)
    (hK : 0<K) (hD : 0≤D) (hC : 0≤C) :
    ∃ r L₀ : ℝ, 0<r ∧ r≤1/32 ∧ 1≤L₀ ∧
      ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      χ≠1 → ∀ {L φ B Q T : ℝ} {s : ℂ},
      L₀≤L → 1+κ/L≤ s.re+b/L → s.re+b/L≤1+C/L →
      |s.im|+1/4≤T → logHeight q s.im≤K*L → 0≤φ → 1≤B → 1≤Q →
      Real.log B≤D*Real.log L →
      (∀ z : ℂ, 3/4≤z.re → z.re≤3/2 → |z.im|≤T →
        ‖χ.LFunction z‖≤B*Q^(φ*max 0 (1-z.re))) →
      ∃ V : Finset ℂ,
      (∀ ρ∈V, regularizedL χ ρ=0 ∧ ρ.re≤1 ∧ ‖ρ-line 1 s.im‖≤2*r) ∧
      (∀ ρ : ℂ, ‖ρ-line 1 s.im‖≤2*r → regularizedL χ ρ=0 → ρ∈V) ∧
      ∀ U : Finset ℂ, U⊆V → (∀ ρ∈V, ρ∉U → ρ.re≤ s.re) →
      (rationalPrimeTest χ b L s).re ≤ φ*Real.log Q/2+ε*L -
        L*∑ ρ∈U,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
          (rationalZeroKernel b ((L:ℂ)*(s-ρ))).re := by
  obtain ⟨A,hA,hAux⟩ := rational_prime_series_sharp_of_strip_with_window
  obtain ⟨r,L₀,hr,hr32,hL₀,hBudget⟩ := rational_jet_error_budget hε hA hK hκ hb hD hC
  refine ⟨r,L₀,hr,hr32,hL₀,?_⟩
  intro q _ χ hχ L φ B Q T s hL hslo hshi hT hHeight hφ hB hQ hBlog hstrip
  let w := s+((b/L:ℝ):ℂ)
  let M := A*logHeight q s.im
  have hL1 : 1≤L := hL₀.trans hL
  have hL0 : 0<L := zero_lt_one.trans_le hL1
  have hM : 0≤M := by exact mul_nonneg hA.le (zero_le_one.trans (logHeight_ge_one q s.im))
  have hML : M≤A*K*L := by
    have h := mul_le_mul_of_nonneg_left hHeight hA.le
    dsimp [M]
    nlinarith only [h]
  obtain ⟨hGeo,hErr⟩ := hBudget L M B hL hM hML hBlog
  have hwRe : w.re=s.re+b/L := by simp [w]
  have hwIm : w.im=s.im := by simp [w]
  have hLower : 1+κ/L≤w.re := by rwa [hwRe]
  have hUpper : w.re≤1+r/2 := by rw [hwRe]; linarith only [hshi,hGeo]
  obtain ⟨V,hV,hCov,hTest⟩ := hAux q χ hχ hr hr32
    (show 0<κ/L by positivity) hLower hUpper (by simpa [hwIm] using hT) hφ hB hQ hstrip
  refine ⟨V,(by simpa [hwIm] using hV),(by simpa [hwIm] using hCov),?_⟩
  intro U hU hUgood
  have hW : 1<w.re := (lt_add_of_pos_right _ (div_pos hκ hL0)).trans_le hLower
  have hT' := hTest ((b/L:ℝ):ℂ)
  rw [hwIm,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (show 0<b/L by positivity)] at hT'
  have hPole (ρ : ℂ) (hρ : ρ∈V) :
      (1/(w-ρ)+((b/L:ℝ):ℂ)/(w-ρ)^2+(2*((b/L:ℝ):ℂ)^2/3)/(w-ρ)^3).re =
        L*(rationalZeroKernel b ((L:ℂ)*(s-ρ))).re := by
    have hn : w≠ρ := by
      intro he
      exact (not_lt_of_ge ((congrArg Complex.re he).symm ▸ (hV ρ hρ).2.1)) hW
    have h0 := rational_pole_scale (s:=s) (b:=b) hL0.ne' hn (by simp [w,Complex.ofReal_div])
    have h1 := congrArg Complex.re h0
    simpa [Complex.ofReal_div,Complex.ofReal_mul,Complex.ofReal_pow,Complex.mul_re,
      rationalZeroKernel] using h1
  have hSum : (∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
        (1/(w-ρ)+((b/L:ℝ):ℂ)/(w-ρ)^2+(2*((b/L:ℝ):ℂ)^2/3)/(w-ρ)^3).re) =
      L*∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
        (rationalZeroKernel b ((L:ℂ)*(s-ρ))).re := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro ρ hρ
    rw [hPole ρ hρ]
    ring
  rw [hSum] at hT'
  have hMono : (∑ ρ∈U,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
      (rationalZeroKernel b ((L:ℂ)*(s-ρ))).re) ≤
    ∑ ρ∈V,(analyticOrderNatAt (regularizedL χ) ρ:ℝ)*
      (rationalZeroKernel b ((L:ℂ)*(s-ρ))).re := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hU
    intro ρ hρ hρU
    apply mul_nonneg (Nat.cast_nonneg _)
    refine rationalZeroKernel_re_nonneg_of_re hb ?_
    simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero,Complex.sub_re]
    exact mul_nonneg hL0.le (sub_nonneg.mpr (hUgood ρ hρ hρU))
  rw [rationalPrimeTest_shift]
  change _ ≤ _
  have hMono' := mul_le_mul_of_nonneg_left hMono hL0.le
  change _ ≤ _ at hT'
  change _ ≤ _ at hErr
  linarith only [hT',hErr,hMono']

end

end GoldbachPintzWeightedFormula
end

section
namespace GoldbachPintzWeightedGram

open Complex Finset Goldbach GoldbachPintzNumerics GoldbachPintzWeightedFormula GoldbachTwistedMellin
open scoped Classical

noncomputable section

def zeroLossAt (L : ℝ) (ρ : ℂ) : ℝ := (1-ρ.re)*L

def zeroGramMultiplicity {q : ℕ} [NeZero q] (i : DirichletCharacter ℂ q × ℂ) : ℕ :=
  analyticOrderNatAt (regularizedL i.1) i.2

def rationalNearZeroPair {q : ℕ} (r : ℝ) (i j : DirichletCharacter ℂ q × ℂ) : Prop :=
  i.1=j.1 ∧ |j.2.im-i.2.im|≤r

def rationalSameZeroWeight {q : ℕ} (b anchor L r : ℝ) (i j : DirichletCharacter ℂ q × ℂ) : ℝ :=
  if rationalNearZeroPair r i j then
    rationalPair b anchor (zeroLossAt L i.2) (L*(j.2.im-i.2.im)) else 0

theorem rationalSameZeroWeight_nonneg {q : ℕ} {b anchor L r : ℝ}
    {i j : DirichletCharacter ℂ q × ℂ} (hb : 0<b) (ha : anchor≤zeroLossAt L i.2) :
    0≤rationalSameZeroWeight b anchor L r i j := by
  unfold rationalSameZeroWeight
  split
  · exact rationalPair_nonneg hb ha
  · exact le_rfl

theorem rationalSameZeroWeight_diag {q : ℕ} {b anchor L r : ℝ}
    {i : DirichletCharacter ℂ q × ℂ} (hb : 0<b) (hr : 0≤r) (ha : anchor≤zeroLossAt L i.2) :
    rationalSameZeroWeight b anchor L r i i=1 := by
  simp [rationalSameZeroWeight,rationalNearZeroPair,hr,rationalPair_zero hb ha]

theorem zeroGramMultiplicity_pos {q : ℕ} [NeZero q] {i : DirichletCharacter ℂ q × ℂ}
    (hi : regularizedL i.1 i.2=0) : 1≤zeroGramMultiplicity i :=
  (regularizedL_analyticOrderNatAt_pos_iff i.1 i.2).mpr hi

theorem line_real_add_imag (σ γ : ℝ) : line σ γ=(σ:ℂ)+(γ:ℂ)*I := by
  apply Complex.ext <;> simp [line,Complex.mul_re,Complex.mul_im]

theorem zeroKernel_shift_eq {L anchor : ℝ} (hL : L≠0) (γ : ℝ) (ρ : ℂ) :
    (L:ℂ)*(line (1-anchor/L) γ-ρ) =
      ((zeroLossAt L ρ-anchor:ℝ):ℂ)+((L*(γ-ρ.im):ℝ):ℂ)*I := by
  rw [line_real_add_imag]
  apply Complex.ext
  · simp [zeroLossAt,Complex.mul_re,Complex.mul_im]
    field_simp
    ring
  · simp [Complex.mul_re,Complex.mul_im]

private theorem norm_to_vertical_center_le (ρ : ℂ) (γ : ℝ) :
    ‖ρ-line 1 γ‖≤|ρ.re-1|+|ρ.im-γ| := by
  have h : ρ-line 1 γ=(((ρ.re-1:ℝ):ℂ))+(((ρ.im-γ:ℝ):ℂ))*I := by
    rw [line_real_add_imag]
    apply Complex.ext <;> simp [Complex.mul_re,Complex.mul_im]
  rw [h]
  refine (norm_add_le _ _).trans_eq ?_
  rw [norm_mul,Complex.norm_I,mul_one,Complex.norm_real,Complex.norm_real,Real.norm_eq_abs,
    Real.norm_eq_abs]

/-- A near-height selection is contained in the analytic zero window.
The mask is used on the lower side of Cauchy, so no omitted term or
global density bound is needed there. -/
theorem rational_zero_row_of_local_test {q : ℕ} [NeZero q]
    (S : Finset (DirichletCharacter ℂ q × ℂ)) (j : DirichletCharacter ℂ q × ℂ)
    {b anchor high L r ξ : ℝ} (hb : 0<b) (hba : anchor<b) (hAnchor : 0≤anchor) (hL : 0<L)
    (_hr : 0≤r) (hHigh : high≤L*r)
    (hZero : ∀ i∈S, regularizedL i.1 i.2=0)
    (hRange : ∀ i∈S, anchor≤zeroLossAt L i.2 ∧ zeroLossAt L i.2≤high)
    (V : Finset ℂ)
    (hCover : ∀ ρ : ℂ, ‖ρ-line 1 j.2.im‖≤2*r → regularizedL j.1 ρ=0 → ρ∈V)
    (hTest : ∀ U : Finset ℂ, U⊆V →
      (rationalPrimeTest j.1 b L (line (1-anchor/L) j.2.im)).re ≤
        L*realRationalZeroKernel b (-anchor)*ξ -
        L*∑ ρ∈U,(analyticOrderNatAt (regularizedL j.1) ρ:ℝ)*
          (rationalZeroKernel b ((L:ℂ)*(line (1-anchor/L) j.2.im-ρ))).re) :
    (∑ i∈S,(zeroGramMultiplicity i:ℝ)*rationalSameZeroWeight b anchor L r i j*
      rationalPsi b anchor (zeroLossAt L i.2))-ξ ≤
        -(rationalPrimeTest j.1 b L (line (1-anchor/L) j.2.im)).re/
          (L*realRationalZeroKernel b (-anchor)) := by
  classical
  let J := S.filter (fun i=>rationalNearZeroPair r i j)
  let U := J.image Prod.snd
  let C := realRationalZeroKernel b (-anchor)
  have hC : 0<C := realRationalZeroKernel_pos hb (by linarith only [hba])
  have hJinj : (J:Set (DirichletCharacter ℂ q × ℂ)).InjOn Prod.snd := by
    intro i hi k hk he
    have hi' := (mem_filter.mp hi).2.1
    have hk' := (mem_filter.mp hk).2.1
    exact Prod.ext (hi'.trans hk'.symm) he
  have hUV : U⊆V := by
    intro ρ hρ
    obtain ⟨i,hi,rfl⟩ := mem_image.mp hρ
    obtain ⟨hiS,hiχ,hiT⟩ := mem_filter.mp hi
    have hLoss₀ : 0≤zeroLossAt L i.2 := hAnchor.trans (hRange i hiS).1
    have hR₀ : 0≤1-i.2.re := nonneg_of_mul_nonneg_left hLoss₀ hL
    have hR₁ : 1-i.2.re≤r := by
      apply (le_of_mul_le_mul_right _ hL)
      have hh := (hRange i hiS).2.trans hHigh
      unfold zeroLossAt at hh
      simpa only [mul_comm r L] using hh
    have hNorm : ‖i.2-line 1 j.2.im‖≤2*r := by
      refine (norm_to_vertical_center_le _ _).trans ?_
      rw [abs_sub_comm i.2.re 1,abs_sub_comm i.2.im j.2.im,abs_of_nonneg hR₀]
      linarith only [hR₁,hiT]
    apply hCover _ hNorm
    rw [←hiχ]
    exact hZero i hiS
  let W (ρ : ℂ) :=
    (analyticOrderNatAt (regularizedL j.1) ρ:ℝ)*
      (rationalZeroKernel b ((L:ℂ)*(line (1-anchor/L) j.2.im-ρ))).re
  have hSum : (∑ i∈S,(zeroGramMultiplicity i:ℝ)*rationalSameZeroWeight b anchor L r i j*
      rationalPsi b anchor (zeroLossAt L i.2))=(∑ ρ∈U,W ρ)/C := by
    rw [sum_div,Finset.sum_image (fun i hi k hk he=>hJinj hi hk he)]
    have hEq (i : DirichletCharacter ℂ q × ℂ) (hi : i∈S) :
        (zeroGramMultiplicity i:ℝ)*rationalSameZeroWeight b anchor L r i j*
          rationalPsi b anchor (zeroLossAt L i.2) =
          if rationalNearZeroPair r i j then W i.2/C else 0 := by
      unfold rationalSameZeroWeight
      split
      · rename_i hNear
        rw [mul_assoc,rationalPair_mul_psi hb (hRange i hi).1]
        unfold W zeroGramMultiplicity
        rw [zeroKernel_shift_eq hL.ne',hNear.1]
        simp only [div_eq_mul_inv,mul_assoc,C]
      · simp
    calc
      _ = ∑ i∈S,if rationalNearZeroPair r i j then W i.2/C else 0 :=
        sum_congr rfl fun i hi=>hEq i hi
      _ = _ := by rw [←sum_filter]
  rw [hSum]
  have hRaw := hTest U hUV
  change (rationalPrimeTest j.1 b L (line (1-anchor/L) j.2.im)).re≤L*C*ξ-L*(∑ρ∈U,W ρ) at hRaw
  change (∑ρ∈U,W ρ)/C-ξ≤-(rationalPrimeTest j.1 b L (line (1-anchor/L) j.2.im)).re/(L*C)
  apply (le_div_iff₀ (mul_pos hL hC)).mpr
  have he : ((∑ρ∈U,W ρ)/C-ξ)*(L*C)=L*(∑ρ∈U,W ρ)-L*C*ξ := by
    field_simp [hC.ne']
  rw [he]
  linarith only [hRaw]

end
end GoldbachPintzWeightedGram
end

