  have hx : 0 < (X : ℝ) := by positivity
  have hL : 0 < Real.log (X : ℝ) := Real.log_pos (by linarith)
  have hLP : 0 < (Real.log (X : ℝ))^A := pow_pos hL _
  have h3 : 0 ≤ 3*(X : ℝ) := by positivity
  have hs : Real.sqrt (3*(X : ℝ)) ≤ 2*Real.sqrt (X : ℝ) := by
    nlinarith [Real.sq_sqrt hx.le, Real.sq_sqrt h3,
      Real.sqrt_nonneg (X : ℝ), Real.sqrt_nonneg (3*(X : ℝ))]
  have hl : Real.log (3*(X : ℝ)) ≤ 3*Real.log (X : ℝ) := by
