      (Q : ℝ)^2/(h/X)≤X^(5/12 : ℝ) →
      Real.log ((Q : ℝ)*(2 : ℝ)^(K+1))≤2*Real.log X →
      ∀ F : Finset PrimitiveComplexCharacter,
