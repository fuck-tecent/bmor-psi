  have hm' := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hm hF0) hL0.le
  let Z : ℂ := ((L*(β-1):ℝ):ℂ)+((L*γ:ℝ):ℂ)*I
  let W : ℂ := ((L*(β-σ):ℝ):ℂ)+((L*γ:ℝ):ℂ)*I
