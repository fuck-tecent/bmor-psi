    have hh := hE q p.1 r.1 p.2.re r.2.re r.2.im B T (fun _ => 47/125) hQuad hξ hχ hProd le_rfl
      hβ hrp hσ (hShift b) hγ hT h0 hγlog hB hBL (by norm_num) G.general
