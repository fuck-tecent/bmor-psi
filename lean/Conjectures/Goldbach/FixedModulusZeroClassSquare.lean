/-- Log-free density near one for the nonprincipal primitive family, with full zero orders. -/
theorem nonprincipal_logfree_density_large :
    ∃ C H₀ : ℝ, 0 < C ∧ ∀ (Q : ℕ), 1 ≤ Q → ∀ {δ T : ℝ}, 0 ≤ δ → δ ≤ loss → 1 ≤ T →
      H₀ ≤ (Q:ℝ)*(T+1) →
      ∀ Z : Finset (TaggedZero Q), Z ⊆ familyZeroTags Q (1-δ) T →
      (∑ r ∈ Z,(order r:ℝ)) ≤ C*((Q:ℝ)^3*(T+1)^4)^((1+1/100:ℝ)*δ) := by
  have hLoss : 0 < loss := by unfold loss; norm_num
  obtain ⟨A,E,hA,hE,hrows⟩ := GoldbachPintzDiagonal.same_character_gram_row_le
    hLoss (K:=4) (L:=3/loss) (by norm_num) (by positivity)
  have hchar : CharacterDiagonalEstimate A E := by
    intro q _ χ hχ Q hq δ T W U Y hδ hδ' hT hW hY hHeight hUpper hU hUY θ hθ hθq S hS r hr
    simpa only [neg_div, GoldbachPintzDetector.support] using hrows q χ hχ Q hq hδ hδ' hT hW hY hHeight hUpper hU hUY θ hθ hθq S hS r hr
  obtain ⟨C,H₀,hC,hcount⟩ := canonical_nonprincipal_count (E:=2*E) hA.le
  refine ⟨C,H₀,hC,?_⟩
  intro Q hQ δ T hδ hδ' hT hLarge
  exact hcount Q hQ hδ hδ' hT hLarge
    (fun hlog θ _ hθ _ hθq =>
      canonical_diagonal_of_character hA.le hE.le hchar Q hQ hδ hδ' hT hlog θ hθ hθq)

theorem familyZeroTags_mono_height {Q : ℕ} {σ T T' : ℝ} (hT : T ≤ T') :
    familyZeroTags Q σ T ⊆ familyZeroTags Q σ T' := by
  intro r hr
  obtain ⟨hc,hz⟩ := mem_sigma.mp hr
  obtain ⟨ha,hb,hh,hzero⟩ := mem_densityZeros.mp hz
  exact mem_sigma.mpr ⟨hc,mem_densityZeros.mpr ⟨ha,hb,hh.trans hT,hzero⟩⟩

/-- Uniform log-free density for primitive nonprincipal zeros in the interval
where the signed major-arc comparison uses the near-one bound. -/
theorem nonprincipal_logfree_density :
    ∃ C : ℝ, 0 < C ∧ ∀ (Q : ℕ), 1 ≤ Q → ∀ {δ T : ℝ}, 0 ≤ δ → δ ≤ loss → 0 ≤ T →
      ∀ Z : Finset (TaggedZero Q), Z ⊆ familyZeroTags Q (1-δ) T →
      (∑ r ∈ Z,(order r:ℝ)) ≤ C*((Q:ℝ)^3*(T+1)^4)^((1+1/100:ℝ)*δ) := by
  obtain ⟨C,H₀,hC,hlarge⟩ := nonprincipal_logfree_density_large
  let K : ℝ := max 2 H₀
  have hK : 2 ≤ K := le_max_left _ _
  have hK₁ : 1 ≤ K := (by norm_num : (1:ℝ) ≤ 2).trans hK
  have hK₀ := zero_lt_one.trans_le hK₁
  refine ⟨C*K^4,by positivity,?_⟩
  intro Q hQ δ T hδ hδ' hT Z hZ
  let T' := K*(T+1)-1
  let e := (1+1/100:ℝ)*δ
  have he : e ≤ 1 := by unfold e loss at *; nlinarith only [hδ']
  have hT₁ : 1 ≤ T+1 := by linarith only [hT]
  have hT' : T'+1 = K*(T+1) := by unfold T'; ring
  have hTh : T ≤ T' := by
    have h := mul_le_mul_of_nonneg_right hK₁ (zero_le_one.trans hT₁)
    linarith only [hT',h]
  have hT₀' : 1 ≤ T' := by
    have h := mul_le_mul_of_nonneg_left hT₁ hK₀.le
    rw [mul_one,← hT'] at h
    linarith only [hK,h]
  have hQ₁ : (1:ℝ) ≤ Q := by exact_mod_cast hQ
  have hH : H₀ ≤ (Q:ℝ)*(T'+1) := calc
    _ ≤ K := le_max_right _ _
    _ ≤ T'+1 := by rw [hT']; exact le_mul_of_one_le_right hK₀.le hT₁
    _ ≤ _ := le_mul_of_one_le_left (by linarith only [hT₀']) hQ₁
  have hbaseBase : 0 ≤ (Q:ℝ)^3*(T+1)^4 := by positivity
  have hKpow : 1 ≤ K^4 := one_le_pow₀ hK₁
  have hbase : (Q:ℝ)^3*(T'+1)^4 = K^4*((Q:ℝ)^3*(T+1)^4) := by rw [hT']; ring
  calc
    _ ≤ C*((Q:ℝ)^3*(T'+1)^4)^e :=
      hlarge Q hQ hδ hδ' hT₀' hH Z (hZ.trans (familyZeroTags_mono_height hTh))
    _ = C*((K^4)^e * ((Q:ℝ)^3*(T+1)^4)^e) := by
      rw [hbase, Real.mul_rpow (by positivity) hbaseBase]
    _ ≤ C*(K^4 * ((Q:ℝ)^3*(T+1)^4)^e) := by
      apply mul_le_mul_of_nonneg_left _ hC.le
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_nonneg hbaseBase _)
      simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hKpow he
    _ = _ := by ring

end
end GoldbachPintzFamily


