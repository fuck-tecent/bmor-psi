    exact (by linarith [mul_le_mul_of_nonneg_left hwQ hδ.le] : -(ε/2) ≤ -(ε/4 * w Q)).trans hrest
  rw [Vm.Vki (fun q => (Vm.F n q/(q:ℝ))*w q) hKQ]
