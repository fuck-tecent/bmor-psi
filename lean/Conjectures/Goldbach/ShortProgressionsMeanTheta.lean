/-!
# Uniform low-frequency bounds for sharp Möbius factors

The exact hyperbola identity bootstraps an exponent `s` for the unweighted
Möbius initial sum to `s+1/2`. The small Mangoldt variable uses the previous Möbius
bound; the other side uses Siegel--Walfisz for the prime character initial sum.
Removing the logarithm by Abel summation preserves the gain.
-/

open Finset Filter MeasureTheory ArithmeticFunction
open scoped BigOperators ArithmeticFunction.zeta

namespace ShortAPMobiusBootstrap

open ShortAPSmallConductorMobius
open ShortAPLongWindowAnalyticSupport.Conjectures.Goldbach.PacketRationalPeakExcess_aux.OAI.LargePrimeGaps

noncomputable section

private theorem prefix_trivial {q : ℕ} (χ : DirichletCharacter ℂ q) {y : ℝ} (hy : 0 ≤ y) :
    ‖mobiusPrefix χ y‖ ≤ y := by
  have he : mobiusPrefix χ y = ∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, mobiusTwist χ n := by
    rw [mobiusPrefix, ← Finset.insert_left_Ioc (Nat.zero_le ⌊y⌋₊),
      Finset.sum_insert (by simp)]
    simp [mobiusTwist]
  rw [he]
  calc
    _ ≤ ∑ n ∈ Finset.Ioc 0 ⌊y⌋₊, ‖mobiusTwist χ n‖ := norm_sum_le _ _
    _ ≤ ∑ _n ∈ Finset.Ioc 0 ⌊y⌋₊, (1 : ℝ) :=
      Finset.sum_le_sum fun n _ => norm_mobiusTwist_le_one χ n
    _ = (⌊y⌋₊ : ℝ) := by simp
    _ ≤ y := Nat.floor_le hy

/-- An elementary upper bound on the short side of the hyperbola. Using
`Λ * ζ = log` avoids a loss of a second power of the logarithm. -/
private theorem mangoldt_reciprocal (K : ℕ) (hK : 0 < K) :
    (∑ m ∈ Finset.Ioc 0 K, ArithmeticFunction.vonMangoldt m / (m : ℝ)) ≤
      Real.log K + (Real.log 4 + 4) := by
  let Mang := ArithmeticFunction.vonMangoldt
  have hKr : (0 : ℝ) < K := by exact_mod_cast hK
  have hconv : (∑ m ∈ Finset.Ioc 0 K, Mang m * (K / m : ℕ)) =
      ∑ n ∈ Finset.Ioc 0 K, Real.log (n : ℝ) := by
    calc
      _ = ∑ m ∈ Finset.Ioc 0 K, Mang m * ∑ u ∈ Finset.Ioc 0 (K / m), (ζ u : ℝ) := by
        apply Finset.sum_congr rfl
        intro m _
        congr 1
        calc
          _ = ∑ _u ∈ Finset.Ioc 0 (K / m), (1 : ℝ) := by simp
          _ = _ := by
            apply Finset.sum_congr rfl
            intro u hu
            simp [ArithmeticFunction.zeta_apply_ne ((Finset.mem_Ioc.mp hu).1.ne')]
      _ = ∑ n ∈ Finset.Ioc 0 K, (Mang * (ζ : ArithmeticFunction ℝ)) n := by
        rw [ArithmeticFunction.sum_Ioc_mul_eq_sum_sum]
        simp
      _ = _ := by simp [Mang, ArithmeticFunction.log_apply]
  have hpsi : (∑ m ∈ Finset.Ioc 0 K, Mang m) ≤ (Real.log 4 + 4) * K := by
    simpa [Mang, Chebyshev.psi] using Chebyshev.psi_le_const_mul_self hKr.le
  have hlogs : (∑ n ∈ Finset.Ioc 0 K, Real.log (n : ℝ)) ≤ (K : ℝ) * Real.log K := by
    calc
      _ ≤ ∑ _n ∈ Finset.Ioc 0 K, Real.log (K : ℝ) := by
        apply Finset.sum_le_sum
        intro n hn
        rcases Finset.mem_Ioc.mp hn with ⟨hn, hnK⟩
        exact Real.log_le_log (by exact_mod_cast hn) (by exact_mod_cast hnK)
      _ = _ := by simp
  apply le_of_mul_le_mul_left _ hKr
  calc
    _ = ∑ m ∈ Finset.Ioc 0 K, Mang m * ((K : ℝ) / (m : ℝ)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro m _
      change (K : ℝ) * (Mang m / (m : ℝ)) = Mang m * ((K : ℝ) / (m : ℝ))
      ring
    _ ≤ ∑ m ∈ Finset.Ioc 0 K, Mang m * (((K / m : ℕ) : ℝ) + 1) := by
      apply Finset.sum_le_sum
      intro m _
      apply mul_le_mul_of_nonneg_left _ ArithmeticFunction.vonMangoldt_nonneg
      have h := Nat.lt_floor_add_one ((K : ℝ) / (m : ℝ))
      rw [Nat.floor_div_eq_div] at h
      exact h.le
    _ = (∑ n ∈ Finset.Ioc 0 K, Real.log (n : ℝ)) + ∑ m ∈ Finset.Ioc 0 K, Mang m := by
      simp only [mul_add, Finset.sum_add_distrib, hconv, mul_one]
    _ ≤ (K : ℝ) * Real.log K + (Real.log 4 + 4) * K := add_le_add hlogs hpsi
    _ = _ := by ring

private theorem log_abel_bound {q : ℕ} (χ : DirichletCharacter ℂ q)
    (X : ℕ) {a U : ℝ} (ha : 1 ≤ a) (haX : a ≤ X) (hU : 0 ≤ U)
    (hprefix : ∀ y ∈ Set.Icc a (X : ℝ), ‖mobiusPrefix χ y‖ ≤ U * y) :
    ‖mobiusPrefix χ (X : ℝ)‖ * Real.log X ≤
      ‖∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)‖ +
        a + U * X := by
  let f (y : ℝ) : ℂ := Real.log y
  let g (y : ℝ) : ℂ := (y⁻¹ : ℝ) * mobiusPrefix χ y
  have hX : (1 : ℝ) ≤ X := ha.trans haX
  have hd (y : ℝ) (hy : y ∈ Set.Icc 1 (X : ℝ)) :
      HasDerivAt f (y⁻¹ : ℝ) y :=
    (Real.hasDerivAt_log (by linarith [hy.1])).ofReal_comp
  have hd₁ (y : ℝ) (hy : y ∈ Set.Icc 1 (X : ℝ)) : deriv f y = (y⁻¹ : ℝ) :=
    (hd y hy).deriv
  have hc : ContinuousOn (deriv f) (Set.Icc 1 (X : ℝ)) := by
    refine (Complex.continuous_ofReal.comp_continuousOn
      (continuousOn_id.inv₀ (fun y hy => show y ≠ 0 by linarith [hy.1]))).congr hd₁
  have hfint : IntegrableOn (deriv f) (Set.Icc 1 (X : ℝ)) volume :=
    hc.integrableOn_compact isCompact_Icc
  have habel := sum_mul_eq_sub_sub_integral_mul (mobiusTwist χ) zero_le_one hX
    (fun y hy => (hd y hy).differentiableAt) hfint
  have hchange : (∫ y in Set.Ioc 1 (X : ℝ), deriv f y * mobiusPrefix χ y) =
      ∫ y in Set.Ioc 1 (X : ℝ), g y :=
    setIntegral_congr_fun measurableSet_Ioc (fun y hy => by rw [hd₁ y (Set.Ioc_subset_Icc_self hy)])
  have hgi : IntegrableOn g (Set.Ioc 1 (X : ℝ)) volume := by
    have hi := (integrableOn_mul_sum_Icc (m := 0) (mobiusTwist χ) zero_le_one hfint).mono_set
      (Set.Ioc_subset_Icc_self : Set.Ioc 1 (X : ℝ) ⊆ Set.Icc 1 (X : ℝ))
    refine hi.congr_fun (fun y hy => ?_) measurableSet_Ioc
    change deriv f y * mobiusPrefix χ y = g y
    rw [hd₁ y (Set.Ioc_subset_Icc_self hy)]
  have hgsplit : (∫ y in Set.Ioc 1 (X : ℝ), g y) =
      (∫ y in Set.Ioc 1 a, g y) + ∫ y in Set.Ioc a (X : ℝ), g y := by
    have h₁ : IntervalIntegrable g volume 1 a :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le ha).2
        (hgi.mono_set (Set.Ioc_subset_Ioc_right haX))
    have h₂ : IntervalIntegrable g volume a (X : ℝ) :=
      (intervalIntegrable_iff_integrableOn_Ioc_of_le haX).2
        (hgi.mono_set (Set.Ioc_subset_Ioc_left ha))
    rw [← intervalIntegral.integral_of_le ha, ← intervalIntegral.integral_of_le haX,
      intervalIntegral.integral_add_adjacent_intervals h₁ h₂, intervalIntegral.integral_of_le hX]
  have hlow : ‖∫ y in Set.Ioc 1 a, g y‖ ≤ a := by
    have h := norm_setIntegral_le_of_norm_le_const
      (show volume (Set.Ioc (1 : ℝ) a) < ⊤ from measure_Ioc_lt_top)
      (f := g) (C := 1) (fun y hy => by
        have hy₀ : 0 < y := zero_lt_one.trans hy.1
        dsimp only [g]
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hy₀)]
        exact (mul_le_mul_of_nonneg_left (prefix_trivial χ hy₀.le)
          (inv_nonneg.mpr hy₀.le)).trans_eq (inv_mul_cancel₀ hy₀.ne'))
    rw [Measure.real, Real.volume_Ioc, ENNReal.toReal_ofReal (sub_nonneg.mpr ha), one_mul] at h
    linarith
  have hhigh : ‖∫ y in Set.Ioc a (X : ℝ), g y‖ ≤ U * X := by
    have h := norm_setIntegral_le_of_norm_le_const
      (show volume (Set.Ioc a (X : ℝ)) < ⊤ from measure_Ioc_lt_top)
      (f := g) (C := U) (fun y hy => by
        have hy₀ : 0 < y := zero_lt_one.trans (ha.trans_lt hy.1)
        dsimp only [g]
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hy₀)]
        exact (mul_le_mul_of_nonneg_left (hprefix y (Set.Ioc_subset_Icc_self hy))
          (inv_nonneg.mpr hy₀.le)).trans_eq (by field_simp))
    rw [Measure.real, Real.volume_Ioc, ENNReal.toReal_ofReal (sub_nonneg.mpr haX)] at h
    exact h.trans (mul_le_mul_of_nonneg_left (by linarith) hU)
  have he : (Real.log (X : ℝ) : ℂ) * mobiusPrefix χ (X : ℝ) =
      (∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)) +
        ∫ y in Set.Ioc 1 (X : ℝ), g y := by
    have h1 : Finset.Ioc 1 X ⊆ Finset.Ioc 0 X := Finset.Ioc_subset_Ioc_left (by norm_num)
    have hs : (∑ n ∈ Finset.Ioc 1 X, f n * mobiusTwist χ n) =
        ∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ) := by
      simp only [f, mul_comm]
      refine Finset.sum_subset h1 fun n hn hn' => ?_
      have : n = 1 := by
        simp only [Finset.mem_Ioc] at hn hn'
        omega
      simp [this]
    have habel' : (∑ n ∈ Finset.Ioc 1 X, f n * mobiusTwist χ n) =
        (Real.log (X : ℝ) : ℂ) * mobiusPrefix χ (X : ℝ) -
         ∫ y in Set.Ioc 1 (X : ℝ), deriv f y * mobiusPrefix χ y := by
      simpa [f, mobiusPrefix, mul_comm] using habel
    rw [← hs, habel', hchange, sub_add_cancel]
  have hf : ‖(Real.log (X : ℝ) : ℂ)‖ = Real.log X := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.log_nonneg hX)]
  rw [← hf, ← norm_mul, mul_comm, he, hgsplit]
  calc
    _ ≤ ‖∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)‖ +
        (‖∫ y in Set.Ioc 1 a, g y‖ + ‖∫ y in Set.Ioc a (X : ℝ), g y‖) :=
      (norm_add_le _ _).trans (add_le_add le_rfl (norm_add_le _ _))
    _ ≤ _ := by linarith

private theorem weighted_bound {q : ℕ} (χ : DirichletCharacter ℂ q)
    (X K : ℕ) (hK : 0 < K) (hKX : K ≤ X) {U ε : ℝ} (hU : 0 ≤ U) (hε : 0 ≤ ε)
    (hμ : ∀ m ∈ Finset.Ioc 0 K, ‖mobiusPrefix χ ((X / m : ℕ) : ℝ)‖ ≤ U * (X / m : ℕ))
    (hΛ : ∀ y : ℕ, K ≤ y → y ≤ X → ‖primeCharacterPrefix (y : ℝ) χ‖ ≤ ε * y) :
    ‖∑ n ∈ Finset.Ioc 0 X, mobiusTwist χ n * (Real.log (n : ℝ) : ℂ)‖ ≤
      U * X * (Real.log K + (Real.log 4 + 4)) + 2 * ε * X * (1 + Real.log X) := by
  rw [logWeighted_mobius_hyperbola_split χ X K hKX, norm_neg]
  apply (norm_add_le _ _).trans
  apply add_le_add
  · calc
      _ ≤ ∑ m ∈ Finset.Ioc 0 K,
          ‖(ArithmeticFunction.vonMangoldt m : ℂ) * χ (m : ZMod q) *
             mobiusPrefix χ ((X / m : ℕ) : ℝ)‖ := norm_sum_le _ _
      _ ≤ ∑ m ∈ Finset.Ioc 0 K, (U * X) * (ArithmeticFunction.vonMangoldt m / (m : ℝ)) := by
        apply Finset.sum_le_sum
        intro m hm
        have hmcast : 0 ≤ (m : ℝ) := Nat.cast_nonneg m
        have hfloor : ((X / m : ℕ) : ℝ) ≤ (X : ℝ) / (m : ℝ) := by
          rw [← Nat.floor_div_eq_div (K := ℝ)]
          exact Nat.floor_le (by positivity)
        have hv := ArithmeticFunction.vonMangoldt_nonneg (n := m)
        rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hv]
        have h := mul_le_of_le_one_right hv (χ.norm_le_one (m : ZMod q))
        calc
          _ ≤ ArithmeticFunction.vonMangoldt m * (U * ((X / m : ℕ) : ℝ)) :=
            mul_le_mul h (hμ m hm) (norm_nonneg _) hv
          _ ≤ ArithmeticFunction.vonMangoldt m * (U * ((X : ℝ) / (m : ℝ))) := by
            gcongr
          _ = _ := by ring
      _ ≤ _ := by
        rw [← Finset.mul_sum]
        exact mul_le_mul_of_nonneg_left (mangoldt_reciprocal K hK) (by positivity)
  · calc
      _ ≤ ∑ d ∈ Finset.Ioc 0 X,
          ‖mobiusTwist χ d *
            (primeCharacterPrefix ((X / d : ℕ) : ℝ) χ -
              primeCharacterPrefix (min K (X / d) : ℕ) χ)‖ := norm_sum_le _ _
      _ ≤ ∑ d ∈ Finset.Ioc 0 X, (2 * ε * (X : ℝ)) * (d : ℝ)⁻¹ := by
        apply Finset.sum_le_sum
        intro d _
        let y := X / d
        have hyX : y ≤ X := Nat.div_le_self _ _
        change ‖mobiusTwist χ d * (primeCharacterPrefix (y : ℝ) χ -
          primeCharacterPrefix ((min K y : ℕ) : ℝ) χ)‖ ≤ _
        rcases le_total y K with h | h
        · rw [min_eq_right h, sub_self, mul_zero, norm_zero]
          positivity
        rw [min_eq_left h, norm_mul]
        have hyK : (K : ℝ) ≤ y := by exact_mod_cast h
        have hΔ := (norm_sub_le (primeCharacterPrefix (y : ℝ) χ)
          (primeCharacterPrefix (K : ℝ) χ)).trans (add_le_add (hΛ y h hyX) (hΛ K le_rfl hKX))
        have hfloor : (y : ℝ) ≤ (X : ℝ) / (d : ℝ) := by
          dsimp [y]
          rw [← Nat.floor_div_eq_div (K := ℝ)]
          exact Nat.floor_le (by positivity)
        calc
          _ ≤ ‖primeCharacterPrefix (y : ℝ) χ - primeCharacterPrefix (K : ℝ) χ‖ :=
            mul_le_of_le_one_left (norm_nonneg _) (norm_mobiusTwist_le_one χ d)
          _ ≤ 2 * ε * y := hΔ.trans (by nlinarith [mul_le_mul_of_nonneg_left hyK hε])
          _ ≤ (2 * ε) * ((X : ℝ) / (d : ℝ)) :=
            mul_le_mul_of_nonneg_left hfloor (by positivity)
          _ = _ := by rw [div_eq_mul_inv]; ring
      _ ≤ _ := by
        rw [← Finset.mul_sum]
        exact mul_le_mul_of_nonneg_left (harmonic_prefix X) (by positivity)

/-- Prefix saving in every fixed polylogarithmic conductor range, uniformly in
the nonprincipal primitive character and its conductor. -/
private def PrefixSaving (s : ℝ) : Prop :=
  ∀ B : ℝ, 0 < B → ∃ C : ℝ, 0 < C ∧ ∀ᶠ X : ℕ in atTop,
    ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log X) ^ B → ∀ χ : DirichletCharacter ℂ q,
      χ.IsPrimitive → ‖mobiusPrefix χ (X : ℝ)‖ ≤ C * X / (Real.log X) ^ s

set_option maxHeartbeats 1200000 in
private theorem bootstrap {s : ℝ} (hs : 0 ≤ s) (ih : PrefixSaving s) :
    PrefixSaving (s + 1 / 2) := by
  intro B hB
  obtain ⟨C₁, hC₁, h₁⟩ := ih (2 * B) (by positivity)
  obtain ⟨T₁, hT₁⟩ := eventually_atTop.mp h₁
  obtain ⟨C₂, hC₂, T₂, hT₂, hSW⟩ :=
    prime_prefix_siegelWalfisz (2 * (s + 2)) (2 * B) (by positivity) (by positivity)
  let A := C₁ * (4 : ℝ) ^ s
  let H := 1 + Real.log 2 + (Real.log 4 + 4)
  refine ⟨A * H + 4 * C₂ + (1 + A), by dsimp [A, H]; positivity, ?_⟩
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  have hYt := Real.tendsto_exp_atTop.comp (Real.tendsto_sqrt_atTop.comp hlog)
  have hat := Real.tendsto_sqrt_atTop.comp tendsto_natCast_atTop_atTop
  have hsmallR : ∀ᶠ x : ℝ in atTop, ‖Real.log x ^ s‖ ≤ 1 * ‖x ^ (1 / 2 : ℝ)‖ :=
    (isLittleO_log_rpow_rpow_atTop s
      (by norm_num : 0 < (1 / 2 : ℝ))).bound (by norm_num : (0 : ℝ) < 1)
  have hsmall := tendsto_natCast_atTop_atTop.eventually hsmallR
  filter_upwards [hlog.eventually (eventually_ge_atTop (16 : ℝ)),
    hYt.eventually (eventually_ge_atTop (max 2 T₂)),
    hat.eventually (eventually_ge_atTop (max 2 ((T₁ : ℝ) + 1))),
    hsmall, eventually_ge_atTop (1 : ℕ)] with X hlogX hY ha hsmall hX
  intro q hq hqB χ hχ
  let L := Real.log (X : ℝ)
  let R := Real.sqrt L
  let Y := Real.exp R
  let K := ⌈Y⌉₊
  let a := Real.sqrt (X : ℝ)
  let P := L ^ s
  let U := A / P
  let ε := C₂ / (P * L^2)
  change 16 ≤ L at hlogX
  change max 2 T₂ ≤ Y at hY
  change max 2 ((T₁ : ℝ) + 1) ≤ a at ha
  have hX₀ : (0 : ℝ) < X := by exact_mod_cast hX
  have ha₀ : 0 < a := Real.sqrt_pos.mpr hX₀
  have haX : a ≤ (X : ℝ) := by
    apply (Real.sqrt_le_left hX₀.le).2
    have hx : (1 : ℝ) ≤ X := by exact_mod_cast hX
    nlinarith [mul_nonneg hX₀.le (sub_nonneg.mpr hx)]
  have ha2 : 2 ≤ a := (le_max_left _ _).trans ha
  have hL : 0 < L := by linarith
  have hR₀ : 0 ≤ R := Real.sqrt_nonneg _
  have hR2 : R ^ 2 = L := Real.sq_sqrt hL.le
  have hR4 : 4 ≤ R := by
    apply Real.le_sqrt_of_sq_le
    linarith
  have hR : 1 ≤ R := by linarith
  have hP : 0 < P := Real.rpow_pos_of_pos hL _
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hU : 0 ≤ U := by dsimp [U]; positivity
  have hε : 0 ≤ ε := by dsimp [ε]; positivity
  have hY2 : 2 ≤ Y := (le_max_left _ _).trans hY
  have hYK : Y ≤ K := Nat.le_ceil _
  have hK' : (K : ℝ) ≤ Y + 1 := (Nat.ceil_lt_add_one (by positivity : 0 ≤ Y)).le
  have hKr : (0 : ℝ) < K := by linarith
  have hK : 0 < K := by exact_mod_cast hKr
  have hLa : Real.log a = L / 2 := Real.log_sqrt hX₀.le
  have hKa : (K : ℝ) ≤ a := calc
    _ ≤ Y + 1 := hK'
    _ ≤ Y * Y := by nlinarith [mul_nonneg (by linarith : 0 ≤ Y) (sub_nonneg.mpr hY2)]
    _ = Real.exp (2 * R) := by dsimp [Y]; rw [← Real.exp_add]; congr 1; ring
    _ ≤ Real.exp (Real.log a) := by
      rw [hLa, Real.exp_le_exp]
      nlinarith [mul_nonneg hR₀ (sub_nonneg.mpr hR4)]
    _ = a := Real.exp_log ha₀
  have hKX : K ≤ X := by exact_mod_cast hKa.trans haX
  have hprefix (y : ℝ) (hy : a ≤ y) : ‖mobiusPrefix χ y‖ ≤ U * y := by
    let n := ⌊y⌋₊
    have hy₀ : 0 < y := ha₀.trans_le hy
    have hfloor : (n : ℝ) ≤ y := Nat.floor_le hy₀.le
    have hn' : y < (n : ℝ) + 1 := Nat.lt_floor_add_one _
    have hn₂ : a / 2 ≤ (n : ℝ) := by
      linarith
    have hn₀ : (0 : ℝ) < n := by linarith
    have hnT : T₁ ≤ n := by
      have hT : (T₁ : ℝ) ≤ n := by linarith [(le_max_right 2 ((T₁ : ℝ) + 1)).trans ha]
      exact_mod_cast hT
    have hnL : L / 4 ≤ Real.log (n : ℝ) := calc
      _ ≤ Real.log (a / 2) := by
        rw [Real.log_div ha₀.ne' (by norm_num), hLa]
        linarith [Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)]
      _ ≤ _ := Real.log_le_log (by positivity) hn₂
    have hL4 : 0 < L / 4 := by positivity
    have hqB' : (q : ℝ) ≤ (Real.log (n : ℝ)) ^ (2 * B) := calc
      _ ≤ L ^ B := hqB
      _ = R ^ (2 * B) := by
        dsimp [R]
        rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL.le]
        congr 1
        ring
      _ ≤ _ := Real.rpow_le_rpow hR₀ (by
        nlinarith [mul_nonneg hR₀ (sub_nonneg.mpr hR4)]) (by positivity)
    have hnorm := hT₁ n hnT q hq hqB' χ hχ
    have he : mobiusPrefix χ y = mobiusPrefix χ (n : ℝ) := by
      unfold mobiusPrefix
      rw [Nat.floor_natCast]
    rw [he]
    calc
      _ ≤ C₁ * n / (Real.log (n : ℝ)) ^ s := hnorm
      _ ≤ C₁ * y / (L / 4) ^ s :=
        div_le_div₀ (by positivity) (mul_le_mul_of_nonneg_left hfloor hC₁.le)
          (Real.rpow_pos_of_pos hL4 _) (Real.rpow_le_rpow hL4.le hnL hs)
      _ = U * y := by
        dsimp [U, A, P]
        rw [Real.div_rpow hL.le (by norm_num : (0 : ℝ) ≤ 4)]
        field_simp
  have hμ (m : ℕ) (hm : m ∈ Finset.Ioc 0 K) :
      ‖mobiusPrefix χ ((X / m : ℕ) : ℝ)‖ ≤ U * ((X / m : ℕ) : ℝ) := by
    obtain ⟨hm₀, hmK⟩ := Finset.mem_Ioc.mp hm
    have hmr : (0 : ℝ) < m := by exact_mod_cast hm₀
    rw [← Nat.floor_div_eq_div (K := ℝ)]
    -- Leave one unit of room before flooring the quotient.
    have hma' : (m : ℝ) + 1 ≤ a := by
      -- Extra room follows by keeping one step in the exponential comparison.
      have hY' : (K : ℝ) + 1 ≤ Y * Y := by
        nlinarith [mul_nonneg (by linarith : 0 ≤ Y + 1) (sub_nonneg.mpr hY2)]
      have hYa : Y * Y ≤ a := by
        calc
          _ = Real.exp (2 * R) := by dsimp [Y]; rw [← Real.exp_add]; congr 1; ring
          _ ≤ Real.exp (Real.log a) := by
            rw [hLa, Real.exp_le_exp]
            nlinarith [mul_nonneg hR₀ (sub_nonneg.mpr hR4)]
          _ = a := Real.exp_log ha₀
      have hm' : (m : ℝ) ≤ K := by exact_mod_cast hmK
      linarith
    apply hprefix
    have hquo : a + 1 ≤ (X : ℝ) / (m : ℝ) := by
      apply (le_div_iff₀ hmr).2
      have hh := mul_nonneg (show 0 ≤ a - (m : ℝ) - 1 by linarith)
        (show 0 ≤ a + 1 by positivity)
      nlinarith [show a ^ 2 = (X : ℝ) from Real.sq_sqrt hX₀.le]
    linarith [Nat.lt_floor_add_one ((X : ℝ) / (m : ℝ))]
  have hΛ (y : ℕ) (hyK : K ≤ y) (_ : y ≤ X) :
      ‖primeCharacterPrefix (y : ℝ) χ‖ ≤ ε * y := by
    have hy : Y ≤ (y : ℝ) := hYK.trans (by exact_mod_cast hyK)
    have hyL : R ≤ Real.log (y : ℝ) := by
      simpa [Y] using Real.log_le_log (Real.exp_pos R) hy
    have hqY : (q : ℝ) ≤ (Real.log (y : ℝ)) ^ (2 * B) := by
      refine hqB.trans ?_
      have he : L ^ B = R ^ (2 * B) := by
        dsimp [R]
        rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL.le]
        congr 1
        ring
      rw [he]
      exact Real.rpow_le_rpow hR₀ hyL (by positivity)
    have hpow : (Real.log (y : ℝ)) ^ (-(2 * (s + 2))) ≤ (P * L^2)⁻¹ := by
      refine (Real.rpow_le_rpow_of_nonpos (by linarith : 0 < R) hyL (by linarith)).trans_eq ?_
      dsimp [R, P]
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL.le,
        show (1 / 2 : ℝ) * -(2 * (s + 2)) = -(s + 2) by ring,
        Real.rpow_neg hL.le, Real.rpow_add hL, Real.rpow_two]
    calc
      _ ≤ C₂ * y * (Real.log (y : ℝ)) ^ (-(2 * (s + 2))) :=
        hSW y ((le_max_right _ _).trans (hY.trans hy)) q hq hqY χ hχ
      _ ≤ C₂ * y * (P * L^2)⁻¹ := mul_le_mul_of_nonneg_left hpow (by positivity)
      _ = _ := by dsimp [ε]; rw [div_eq_mul_inv]; ring
  have hlogK : Real.log K + (Real.log 4 + 4) ≤ H * R := calc
    _ ≤ Real.log (2 * Y) + (Real.log 4 + 4) :=
      show _ from add_le_add (Real.log_le_log hKr (by linarith)) le_rfl
    _ = R + (Real.log 2 + (Real.log 4 + 4)) := by
      dsimp [Y]; rw [Real.log_mul (by norm_num) (Real.exp_pos R).ne', Real.log_exp]; ring
    _ ≤ _ := by
      dsimp [H]
      nlinarith [mul_nonneg (by positivity : 0 ≤ Real.log 2 + (Real.log 4 + 4))
        (sub_nonneg.mpr hR)]
  have hW := weighted_bound χ X K hK hKX hU hε hμ hΛ
  have habel := log_abel_bound χ X (by linarith) haX hU
    (fun y hy => hprefix y hy.1)
  have hscale : a ≤ (X : ℝ) / P := by
    change ‖(Real.log (X : ℝ)) ^ s‖ ≤ 1 * ‖(X : ℝ) ^ (1 / 2 : ℝ)‖ at hsmall
    rw [Real.norm_of_nonneg hP.le, one_mul, ← Real.sqrt_eq_rpow,
      Real.norm_of_nonneg ha₀.le] at hsmall
    apply (le_div_iff₀ hP).2
    exact (mul_le_mul_of_nonneg_left hsmall ha₀.le).trans_eq
      (by rw [← pow_two, Real.sq_sqrt hX₀.le])
  have hbigΛ : 2 * ε * X * (1 + L) ≤ 4 * C₂ * X / P * R := calc
    _ ≤ 2 * ε * X * (2 * L^2) := by
      gcongr
      nlinarith [mul_nonneg hL.le (show 0 ≤ L - 1 by linarith)]
    _ = 4 * C₂ * X / P := by dsimp [ε]; field_simp; norm_num
    _ ≤ _ := le_mul_of_one_le_right (by positivity) hR
  have hsum : ‖mobiusPrefix χ (X : ℝ)‖ * L ≤
      (A * H + 4 * C₂ + (1 + A)) * X / P * R := by
    have h₀ : U * (X : ℝ) * (Real.log K + (Real.log 4 + 4)) ≤ (A * H) * X / P * R :=
      (mul_le_mul_of_nonneg_left hlogK (show 0 ≤ U * (X : ℝ) by positivity)).trans_eq
        (by dsimp [U]; ring)
    have h₁ : a + U * (X : ℝ) ≤ ((1 + A) * X / P) * R := calc
      _ ≤ (X : ℝ) / P + U * X := add_le_add hscale le_rfl
      _ = (1 + A) * X / P := by dsimp [U]; ring
      _ ≤ _ := le_mul_of_one_le_right (by positivity) hR
    calc
      _ ≤ _ := habel
      _ ≤ (U * X * (Real.log K + (Real.log 4 + 4)) +
          2 * ε * X * (1 + L)) + (a + U * X) := by
        rw [← add_assoc]
        exact add_le_add (add_le_add hW le_rfl) le_rfl
      _ ≤ ((A * H) * X / P * R + 4 * C₂ * X / P * R) +
          ((1 + A) * X / P) * R := add_le_add (add_le_add h₀ hbigΛ) h₁
      _ = _ := by ring
  have hdenom : L ^ (s + 1 / 2) = P * R := by rw [Real.rpow_add hL, ← Real.sqrt_eq_rpow]
  rw [show Real.log (X : ℝ) = L from rfl, hdenom]
  apply (le_div_iff₀ (by positivity : 0 < P * R)).2
  have hRpos : 0 < R := by linarith
  apply le_of_mul_le_mul_right _ hRpos
  calc
    _ = (‖mobiusPrefix χ (X : ℝ)‖ * L) * P := by
      rw [← hR2]; ring
    _ ≤ ((A * H + 4 * C₂ + (1 + A)) * X / P * R) * P :=
      mul_le_mul_of_nonneg_right hsum hP.le
    _ = _ := by field_simp

private theorem half_integer_saving (r : ℕ) : PrefixSaving ((r : ℝ) / 2) := by
  induction r with
  | zero =>
      intro B hB
      refine ⟨1, zero_lt_one, Filter.Eventually.of_forall ?_⟩
      intro X q hq hqB χ hχ
      simpa using prefix_trivial χ (Nat.cast_nonneg X)
  | succ r ih =>
      rw [Nat.cast_succ, add_div]
      exact bootstrap (by positivity) ih

/-- Arbitrary logarithmic saving for the unweighted Möbius initial sum at every
primitive conductor (q>1) in a fixed polylogarithmic range. The constant
and the eventual threshold are uniform in both (q) and (chi). -/
theorem mobiusPrefix_arbitrary_log_saving (p B : ℝ) (_hp : 0 ≤ p) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ X : ℕ in atTop,
      ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log X) ^ B →
      ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
        ‖mobiusPrefix χ (X : ℝ)‖ ≤ C * X / (Real.log X) ^ p := by
  obtain ⟨r, hr⟩ := exists_nat_ge (2 * p)
  have hrp : p ≤ (r : ℝ) / 2 := by linarith
  obtain ⟨C, hC, h⟩ := half_integer_saving r B hB
  refine ⟨C, hC, ?_⟩
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [h, hlog.eventually (eventually_ge_atTop (1 : ℝ))] with X hX hL
  intro q hq hqB χ hχ
  change 1 ≤ Real.log (X : ℝ) at hL
  exact (hX q hq hqB χ hχ).trans (div_le_div_of_nonneg_left (by positivity)
    (Real.rpow_pos_of_pos (zero_lt_one.trans_le hL) _)
    (Real.rpow_le_rpow_of_exponent_le hL hrp))

/-- Arbitrary logarithmic saving for a genuine sharp Möbius polynomial at
every frequency bounded by a fixed power of the logarithm. The endpoint
can be truncated inside the dyadic shell. -/
theorem mobiusPoly_low_frequency_arbitrary (p B F : ℝ) (hp : 0 ≤ p)
    (hB : 0 < B) (hF : 0 ≤ F) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop,
      ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log N) ^ B →
      ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
      ∀ t : ℝ, |t| ≤ (Real.log N) ^ F →
      ∀ b : ℝ, (N : ℝ) ≤ b → b ≤ 2 * N →
        ‖mobiusPoly χ t N b‖ ≤ C * Real.sqrt N / (Real.log N) ^ p := by
  obtain ⟨C, hC, h⟩ := mobiusPrefix_arbitrary_log_saving (p + F) B (by positivity) hB
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.mp h
  refine ⟨8 * C, by positivity, ?_⟩
  have hlog := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
  filter_upwards [eventually_ge_atTop N₀, hlog.eventually (eventually_ge_atTop (1 : ℝ)),
    eventually_ge_atTop (1 : ℕ)] with N hN hL hN₁
  intro q hq hqlog χ hχ t ht b hNb hb
  let L := Real.log (N : ℝ)
  let R := Real.sqrt (N : ℝ)
  let J := L ^ F
  let P := L ^ p
  let A := 2 * C * (N : ℝ) / (P * J)
  change 1 ≤ L at hL
  have hL₀ : 0 < L := zero_lt_one.trans_le hL
  have hJ : 1 ≤ J := Real.one_le_rpow hL hF
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN₁
  have hR : 0 < R := Real.sqrt_pos.mpr hNr
  have hP : 0 < P := Real.rpow_pos_of_pos hL₀ _
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have hPJ : L ^ (p + F) = P * J := Real.rpow_add hL₀ _ _
  have hprefix (y : ℝ) (hy : y ∈ Set.Icc (N : ℝ) b) : ‖mobiusPrefix χ y‖ ≤ A := by
    let K := ⌊y⌋₊
    have hy₀ : 0 ≤ y := hNr.le.trans hy.1
    have hNK : N ≤ K := (Nat.le_floor_iff hy₀).2 hy.1
    have hK : (K : ℝ) ≤ 2 * N := (Nat.floor_le hy₀).trans (hy.2.trans hb)
    have hlogK : L ≤ Real.log (K : ℝ) := Real.log_le_log hNr (by exact_mod_cast hNK)
    have hqK : (q : ℝ) ≤ (Real.log (K : ℝ)) ^ B :=
      hqlog.trans (Real.rpow_le_rpow hL₀.le hlogK hB.le)
    have he : mobiusPrefix χ y = mobiusPrefix χ (K : ℝ) := by
      unfold mobiusPrefix
      rw [Nat.floor_natCast]
    rw [he]
    calc
      _ ≤ C * K / Real.log (K : ℝ) ^ (p + F) := hN₀ K (hN.trans hNK) q hq hqK χ hχ
      _ ≤ 2 * C * (N : ℝ) / L ^ (p + F) :=
        div_le_div₀ (by positivity) (by nlinarith [mul_le_mul_of_nonneg_left hK hC.le])
          (Real.rpow_pos_of_pos hL₀ _) (Real.rpow_le_rpow hL₀.le hlogK (by positivity))
      _ = A := by rw [hPJ]
  have hnorm := mobiusPoly_le_of_prefix χ t hNr hNb hb hA hprefix
  have hExpo : (N : ℝ) ^ (-(1 / 2 : ℝ)) = R⁻¹ := by
    rw [Real.rpow_neg hNr.le, ← Real.sqrt_eq_rpow]
  calc
    _ ≤ (3 + |t|) * A * (N : ℝ) ^ (-(1 / 2 : ℝ)) := hnorm
    _ ≤ (4 * J) * A * (N : ℝ) ^ (-(1 / 2 : ℝ)) := by
      gcongr
      linarith [show |t| ≤ J from ht]
    _ = 8 * C * R / P := by
      rw [hExpo]
      dsimp only [A]
      have hNs : (N : ℝ) = R ^ 2 := (Real.sq_sqrt hNr.le).symm
      field_simp [ne_of_gt (zero_lt_one.trans_le hJ), hR.ne', hP.ne']
      rw [hNs]
      ring

/-- The bound for the actual sharp HB factor, including its genuine cutoff,
for every fixed low-frequency range and desired log saving. -/
theorem sharpBox_low_frequency_arbitrary (p B F : ℝ) (hp : 0 ≤ p)
    (hB : 0 < B) (hF : 0 ≤ F) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ N : ℕ in atTop,
      ∀ q : ℕ, 1 < q → (q : ℝ) ≤ (Real.log N) ^ B →
      ∀ χ : DirichletCharacter ℂ q, χ.IsPrimitive →
      ∀ t : ℝ, |t| ≤ (Real.log N) ^ F →
      ∀ H j i d : ℕ, j + 1 ≤ i → ShortAPDyadicPartition.scale d = (N : ℝ) → N ≤ H →
        ‖∑ n ∈ Finset.Icc 1 ⌊2 * ShortAPDyadicPartition.scale d⌋₊,
          (ShortAPBoxedHB.boxFactor H j i d n : ℂ) * χ (n : ZMod q) / (n : ℂ) ^ critical t‖ ≤
          C * Real.sqrt N / (Real.log N) ^ p := by
  obtain ⟨C, hC, h⟩ := mobiusPoly_low_frequency_arbitrary p B F hp hB hF
  refine ⟨C, hC, ?_⟩
  filter_upwards [h] with N hN
  intro q hq hq' χ hχ t ht H j i d hi hd hH
  rw [sharpBoxPoly_eq hi χ t, hd]
  exact hN q hq hq' χ hχ t ht _
    (le_min (by linarith [Nat.cast_nonneg (α := ℝ) N]) (by exact_mod_cast hH)) (min_le_left _ _)

end

end ShortAPMobiusBootstrap

end

section

/-!
# The low-frequency cap for the fourth small-conductor block

The arbitrary logarithmic saving for sharp Möbius factors supplies the
long saving slot if the fourth Heath--Brown block has no long smooth slot.
-/

open Finset Filter ShortAPDyadicPartition ShortAPBoxedHB ShortAPSmoothedFactor
open scoped BigOperators

namespace ShortAPMobiusLowCap

open ShortAPSmallConductorMobius ShortAPMobiusBootstrap

/-- The canonical four-scale polynomial of a sharp slot already stops at
twice the scale. -/
theorem boxPolynomial_sharp_eq {H j i d q : ℕ} (hi : j + 1 ≤ i)
    (χ : DirichletCharacter ℂ q) (t : ℝ) :
    boxPolynomial H j i d χ (critical t) =
      ∑ n ∈ Finset.Icc 1 ⌊2 * scale d⌋₊,
        (boxFactor H j i d n : ℂ) * χ (n : ZMod q) / (n : ℂ) ^ critical t := by
  unfold boxPolynomial ShortAPFactorSampling.factor
  simp only [complexCoeffs_apply]
  symm
  refine Finset.sum_subset (Finset.Icc_subset_Icc_right (Nat.floor_mono
    (show 2 * scale d ≤ 4 * scale d by linarith [scale_pos d]))) fun n hn hnot => ?_
  have hlt : ⌊2 * scale d⌋₊ < n := by
    have hn₁ := (Finset.mem_Icc.mp hn).1
    by_contra! h
    exact hnot (Finset.mem_Icc.mpr ⟨hn₁, h⟩)
  have hreal : 2 * scale d < (n : ℝ) :=
    (Nat.floor_lt (by positivity [scale_pos d])).mp hlt
  have hnul : ¬ (scale d < (n : ℝ) ∧ (n : ℝ) ≤ min (2 * scale d) (H : ℝ)) :=
    fun h => (not_le_of_gt hreal) (h.2.trans (min_le_left _ _))
  rw [sharpBoxFactor_eq hi, ite_eq_right hnul]
  simp

theorem eventual_log_power_bound (e c : ℝ) (he : 0 < e) (hc : 0 < c) (k : ℕ) :
    ∀ᶠ x : ℝ in atTop, Real.log x ^ k ≤ c * x ^ e := by
  have h := (isLittleO_log_rpow_rpow_atTop (k : ℝ) he).bound hc
  filter_upwards [h, eventually_ge_atTop (1 : ℝ)] with x hh hx
  rw [Real.rpow_natCast, Real.norm_of_nonneg (pow_nonneg (Real.log_nonneg hx) _),
    Real.norm_of_nonneg (Real.rpow_nonneg (by linarith) _)] at hh
  exact hh

/-- A long sharp Möbius factor satisfies the normalized cap at every
frequency bounded by any fixed power of `log x`. -/
theorem box_sharp_low_active_cap_eventually (ε : ℝ) (hε : 0 < ε) (U p F : ℕ) :
    ∀ᶠ x : ℝ in atTop,
      ∀ {q : ℕ} (χ : DirichletCharacter ℂ q), 1 < q → χ.IsPrimitive →
      (q : ℝ) ≤ 2 * Real.log x ^ U →
      ∀ (t : ℝ) (H j i b : ℕ), j + 1 ≤ i → x ^ ε ≤ scale b → scale b ≤ 4 * x →
        scale b ≤ (H : ℝ) → |t| ≤ Real.log x ^ F →
        (‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ + 1) *
          Real.log x ^ p ≤ Real.sqrt (scale b) := by
  obtain ⟨C, hC, h⟩ := sharpBox_low_frequency_arbitrary ((p + 1 : ℕ) : ℝ)
    ((U + 1 : ℕ) : ℝ) ((F + 1 : ℕ) : ℝ) (by positivity) (by positivity) (by positivity)
  obtain ⟨N₀, hN₀⟩ := eventually_atTop.mp h
  simp only [Real.rpow_natCast] at hN₀
  have hlong : ∀ᶠ x : ℝ in atTop, max (1 : ℝ) (N₀ : ℝ) ≤ x ^ ε :=
    (tendsto_rpow_atTop hε).eventually_ge_atTop _
  have hlog := Real.tendsto_log_atTop
  filter_upwards [hlong, eventually_ge_atTop (1 : ℝ),
    hlog.eventually_ge_atTop (2 / ε ^ (U + 1)),
    hlog.eventually_ge_atTop (1 / ε ^ (F + 1)),
    hlog.eventually_ge_atTop (2 * C / ε ^ (p + 1)),
    eventual_log_power_bound (ε / 2) (1 / 2) (by positivity) (by norm_num) p]
    with x hxN hx₁ hqgrow htgrow hsave hgrow
  intro q χ hq hχ hqsmall t H j i b hi hNlong _ hNH ht
  let L := Real.log x
  have hx₀ : 0 < x := zero_lt_one.trans_le hx₁
  have hL₀ : 0 ≤ L := Real.log_nonneg hx₁
  have hscale₁ : 1 ≤ scale b := (le_max_left _ _).trans (hxN.trans hNlong)
  have hb : b ≠ 0 := by
    intro he
    subst b
    norm_num [scale] at hscale₁
  let N : ℕ := 2 ^ (b - 1)
  have hcast : scale b = (N : ℝ) := by
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hb
    simp [scale, N, pow_succ]
  have hN : N₀ ≤ N := by
    have ht : (N₀ : ℝ) ≤ (N : ℝ) := (le_max_right _ _).trans
      (hxN.trans (hNlong.trans_eq hcast))
    exact_mod_cast ht
  have hH : N ≤ H := by
    rw [hcast] at hNH
    exact_mod_cast hNH
  have hNL : ε * L ≤ Real.log (N : ℝ) := by
    rw [← Real.log_rpow hx₀, ← hcast]
    exact Real.log_le_log (Real.rpow_pos_of_pos hx₀ _) hNlong
  have hpow (k : ℕ) : ε ^ (k + 1) * L ^ (k + 1) ≤ Real.log (N : ℝ) ^ (k + 1) := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) hNL _
  have hbase (c : ℝ) (k : ℕ) (hc : c / ε ^ (k + 1) ≤ L) :
      c * L ^ k ≤ Real.log (N : ℝ) ^ (k + 1) := by
    have hk : c ≤ ε ^ (k + 1) * L := by
      have hh := (div_le_iff₀ (pow_pos hε _)).1 hc
      exact hh.trans_eq (mul_comm _ _)
    exact (mul_le_mul_of_nonneg_right hk (pow_nonneg hL₀ _)).trans
      ((show (ε ^ (k + 1) * L) * L ^ k = ε ^ (k + 1) * L ^ (k + 1) by
        rw [pow_succ]; ring).le.trans (hpow k))
  have hqN := hqsmall.trans (hbase 2 U hqgrow)
  have htN := ht.trans ((one_mul _).symm.le.trans (hbase 1 F htgrow))
  have hlogN : 0 < Real.log (N : ℝ) := by
    have h : 0 < L := (by positivity : 0 < 2 / ε ^ (U + 1)).trans_le hqgrow
    exact (mul_pos hε h).trans_le hNL
  have hden := hbase (2 * C) p hsave
  have hcomplex := hN₀ N hN q hq hqN χ hχ t htN H j i b hi hcast hH
  rw [← boxPolynomial_sharp_eq hi χ t] at hcomplex
  have hnorm : ‖boxPolynomial H j i b χ (critical t)‖ * L^p ≤
      (1 / 2 : ℝ) * Real.sqrt (N : ℝ) := by
    refine (mul_le_mul_of_nonneg_right hcomplex (pow_nonneg hL₀ _)).trans ?_
    calc
      _ = (Real.sqrt (N : ℝ) / 2) *
          ((2 * C * L ^ p) / Real.log (N : ℝ) ^ (p + 1)) := by ring
      _ ≤ Real.sqrt (N : ℝ) / 2 * 1 := mul_le_mul_of_nonneg_left
          ((div_le_one (pow_pos hlogN _)).2 hden) (by positivity)
      _ = _ := by ring
  have hconst : L^p ≤ (1 / 2 : ℝ) * Real.sqrt (N : ℝ) := by
    apply hgrow.trans
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    rw [Real.sqrt_eq_rpow, show ε / 2 = ε * (1 / 2) by ring, Real.rpow_mul hx₀.le, ← hcast]
    exact Real.rpow_le_rpow (by positivity) hNlong (by norm_num)
  change (‖boxPolynomial H j i b χ (critical t)‖ + 1) * L^p ≤ Real.sqrt (scale b)
  rw [hcast, add_mul, one_mul]
  exact (add_le_add hnorm hconst).trans_eq (by ring)

/-- The fourth block also supplies the actual small-conductor product cap at
all polylogarithmic frequencies, without requiring a prescribed smooth or
sharp slot. -/
theorem fourth_low_frequency_cap (P Uexp F : ℕ) :
    ∀ᶠ x : ℝ in atTop, ∀ {X H q : ℕ} (χ : DirichletCharacter ℂ q),
    1 < q → χ.IsPrimitive → ∀ (t a z : ℝ) (b : Choice 3),
    H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → (H : ℝ) ≤ (4*x)^((1:ℝ)/4) →
    x ≤ a → z ≤ 4*x → b ∈ activeChoices X H 3 a z →
    (q : ℝ) ≤ 2 * (Real.log x)^Uexp → |t| ≤ (Real.log x)^F →
    ∀ U : {i // i ∈ blockIndices 3} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H 3 k.val (b k.val k.property) χ
        (1/2+(t:ℂ)*Complex.I)‖+1) →
    (∏ k ∈ (blockIndices 3).attach, U k)*(Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [ShortAPAllSmoothBlocks.fourth_long_slot_dichotomy,
    ShortAPAllSmoothBlocks.active_smooth_cap (ε := 1/32) (by norm_num) P Uexp,
    ShortAPSmallConductorProduct.active_box_cap P,
    box_sharp_low_active_cap_eventually (1/32) (by norm_num) Uexp (P+17) F,
    eventual_log_power_bound 1 1 zero_lt_one zero_lt_one F,
    eventually_ge_atTop (1:ℝ)] with x hcases hsmooth hprod hsharp hfreq hx
  intro X H q χ hq hχ t a z b hH hHX hX hHr ha hz hb hqsmall ht U hU
  rcases hcases hb hH hHX hHr ha with ⟨k, hk, hN⟩ | hlong
  · have htx : |t| ≤ x := ht.trans (by simpa using hfreq)
    exact hsmooth χ hq hχ t a z b (by norm_num) hH hHX hX hz hb hqsmall htx
      ⟨k, hk, hN.le⟩ U hU
  · let k : {i // i ∈ blockIndices 3} := ⟨4, by simp [blockIndices]⟩
    have hki : 3 + 1 ≤ k.val := by decide
    have hN := (hlong k hki).le
    have hcuts := (choice_scale_bounds hH hHX (Finset.mem_filter.mp hb).1 k.property).2
    have hHcap : scale (b k.val k.property) ≤ (H : ℝ) :=
      hcuts.2 (by simp [isSharp, k])
    have hcap := hsharp χ hq hχ hqsmall t H 3 k.val (b k.val k.property)
      hki hN (hcuts.1.trans hX) hHcap ht
    let _ : NeZero q := ⟨by omega⟩
    apply hprod χ t a z b (by norm_num) hH hHX hX hz hb U hU
    exact ⟨k, (mul_le_mul_of_nonneg_right (hU k).2 (pow_nonneg (Real.log_nonneg hx) _)).trans hcap⟩

end ShortAPMobiusLowCap

