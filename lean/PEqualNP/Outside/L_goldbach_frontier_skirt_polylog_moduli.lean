  let χ : DirichletCharacter ℂ 1 := 1
  let f : ℕ → ℂ := fun n => χ (n : ZMod 1) * ArithmeticFunction.moebius n
  have hf (n : ℕ) (_hn : n ≠ 0) : ‖f n‖ ≤ 1 := by
