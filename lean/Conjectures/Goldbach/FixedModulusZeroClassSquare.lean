set_option maxHeartbeats 1700000 in
/-- A positive exponent margin gives a uniformly negligible nonprincipal
Gram term on every compact moving cutoff with the same shorter exponent. -/
theorem gram_eventually_near_zero_of_linear_height
    (Allowed : (q : ℕ) → DirichletCharacter ℂ q → Prop)
    {φ w u₀ κ m A T ε B : ℝ} (hφ : 0 ≤ φ) (hw : 0 < w) (hu : 0 < u₀)
    (hκ : 0 ≤ κ) (hm : 0 < m) (hA : 0 ≤ A) (hT : 0 ≤ T) (hε : 0 < ε) (hB : 0 ≤ B)
    (hMargin : φ+w+w+m ≤ u₀)
    (hGrowth : ∀ (q : ℕ) [NeZero q], ∀ L : ℝ, 1 ≤ L → Real.log (q:ℝ) ≤ L →
      ∀ χ : DirichletCharacter ℂ q, χ≠1 → Allowed q χ →
      ∀ s : ℂ, s.re=7/8 →
      ‖χ.LFunction s‖ ≤ B*(1+|s.im|)*(1+L)*(q:ℝ)^(φ*(1/8:ℝ))) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℕ) [NeZero q], Real.log (q:ℝ) ≤ L →
      ∀ (χ : DirichletCharacter ℂ q), χ≠1 → Allowed q χ →
      ∀ ρ : ℂ, ρ.re ≤ 1 → (1-ρ.re)*L ≤ A → |ρ.im| ≤ T →
      ∀ η∈Set.Icc 0 κ, ∀ θ : ℕ→ℝ, (∀ d, |θ d| ≤ 1) →
        let U := Real.exp ((u₀+η)*L)
        let W := Real.exp (w*L)
        ∀ Y ≥ U,
        ‖cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) Y-
          cutoffSum (LSeries.term (gramCoefficient χ W θ) ρ) U‖ ≤ ε := by
  let ymax := u₀+κ
  let cap := 1+Real.log 3+w+w
  let K := 2*17^3*(B*(1+T)*cap^3)*Real.exp (ymax*A)
  have hlog3 : 0 ≤ Real.log 3 := Real.log_nonneg (by norm_num)
  have hcap : 0 ≤ cap := by dsimp only [cap]; positivity
  have hK := eventually_scaled_contour_error (K:=K) (c:=m*(1/8:ℝ)) (by positivity) hε
  filter_upwards [eventually_ge_atTop (max 1 (16*A)),hK] with L hL hK'
  intro q _ hq χ hχ hχA ρ hhi hδ him η hη θ hθ U W Y hUY
  have hL₁ : 1 ≤ L := (le_max_left _ _).trans hL
  have hL₀ : 0 < L := zero_lt_one.trans_le hL₁
  have hDev : 1-ρ.re ≤ 1/16 := by
    have hLarge := (le_max_right 1 (16*A)).trans hL
    exact ((le_div_iff₀ hL₀).mpr hδ).trans
      ((div_le_iff₀ hL₀).mpr (by linarith only [hLarge]))
  let u := u₀+η
  let a := 7/8-ρ.re
  let M := (B*(1+T)*cap^3)*(1+L)^4*Real.exp ((φ+w+w)*(1/8:ℝ)*L)
  have hu' : 0 < u := add_pos_of_pos_of_nonneg hu hη.1
  have hU : 1 ≤ U := Real.one_le_exp_iff.mpr (mul_nonneg hu'.le hL₀.le)
  have hW : 0 ≤ W := Real.exp_nonneg _
  have ha₀ : -(1/2:ℝ) ≤ a := by dsimp only [a]; linarith only [hhi]
  have ha₁ : a ≤  -(1/16:ℝ) := by dsimp only [a]; linarith only [hDev]
  have hline : ρ.re+a=1-1/8 := by dsimp only [a]; ring
  -- Instantiate the shared contour product estimate with the sharper linear
  -- bound for the character actually appearing in the Gram entry.
  have hPL (t : ℝ) : let s := ρ+((a:ℂ)+t*I)
      ‖χ.LFunction s*GoldbachSieveSeries.lcmPolynomial χ (Icc 1 ⌊W⌋₊) (Icc 1 ⌊W⌋₊)
          (fun d => (θ d:ℂ)) (fun d => (θ d:ℂ)) s‖ ≤ M*(1+|t|) := by
    intro s
    have hFun (t : ℝ) :
        ‖χ.LFunction (ρ+((a:ℂ)+t*I))‖ ≤ B*(1+|ρ.im+t|)*(1+L)*(q:ℝ)^(φ*(1/8:ℝ)) := by
      let z := ρ+((a:ℂ)+t*I)
      have hre : z.re=7/8 := by simp [z,Complex.mul_re,a]
      have him' : z.im=ρ.im+t := by simp [z,Complex.mul_im]
      simpa only [him'] using hGrowth q L hL₁ hq χ hχ hχA z hre
    have hθ' (k : ℕ) : ‖(θ k:ℂ)‖ ≤ 1 := by rw [Complex.norm_real,Real.norm_eq_abs]; exact hθ k
    have hh := sieve_product_left_line_le' χ hL₀.le (by norm_num : (0:ℝ) ≤ 1/8) hφ hw.le hw.le
      hB hT hq hline him (fun k=> (θ k:ℂ)) (fun k=> (θ k:ℂ)) (fun k _=>hθ' k)
      (fun k _=>hθ' k) hFun t
    simpa only [M,cap,W,mul_comm (χ.LFunction _)] using hh
  have hM : 0 ≤ M := by dsimp only [M]; positivity
  have hRaw := gram_cutoff_norm_le_left hχ (by norm_num : (0:ℝ) < 1/16)
    (by norm_num) ha₀ ha₁ (by linarith only [hline]) hhi hW hU hUY hM θ hθ hPL
  refine hRaw.trans ?_
  have hMax : u ≤ ymax := by dsimp only [u,ymax]; linarith only [hη.2]
  have hmarg : φ+w+w+m ≤ u := hMargin.trans (le_add_of_nonneg_right hη.1)
  have hScale := compact_left_scale_le hL₀ (by norm_num : (0:ℝ) ≤ 1/8) hA hu'.le hMax hδ hmarg
  have hScale' : U^a*Real.exp ((φ+w+w)*(1/8:ℝ)*L) ≤ Real.exp (ymax*A)*Real.exp (-(m*(1/8:ℝ))*L) := by
    simpa only [U,a,show (7/8:ℝ)-ρ.re=(1-ρ.re)-1/8 by ring,neg_mul] using hScale
  calc
    _=2*17^3*(B*(1+T)*cap^3)*(1+L)^4*(U^a*Real.exp ((φ+w+w)*(1/8:ℝ)*L)) := by
      dsimp only [M]; norm_num; ring
    _ ≤ 2*17^3*(B*(1+T)*cap^3)*(1+L)^4*
      (Real.exp (ymax*A)*Real.exp (-(m*(1/8:ℝ))*L)) := by gcongr
    _=K*(1+L)^4*Real.exp (-(m*(1/8:ℝ))*L) := by dsimp only [K]; ring
    _ ≤ _ := hK'

end GoldbachCubicRiesz
end

section
namespace GoldbachPintzNumerics

open Filter
open scoped Topology

/-- Fixed finite averaging and positive contour tolerances can realize every
strict upper bound for the limiting weighted C/D moment coefficient. -/
theorem exists_cd_moment_precision
    {C w κ d₁ d₂ A B : ℝ} (hC : 0 ≤ C) (hw : 0 < w) (hκ : 0 < κ) (hA : 0 ≤ A)
    (hLimit : C*(1/(w*κ))*Real.sqrt d₁*Real.sqrt d₂ < B) :
    ∃ (e : ℝ) (N : ℕ), 0 < e ∧ e < 1 ∧ 0 < N ∧
      (C+e)*(A/N+e)/(1-e)^2 < 1 ∧
      ((C+e)*(1/(w*κ))/(1-e)^2)*Real.sqrt (d₁+e)*Real.sqrt (d₂+e)/
        (1-(C+e)*(A/N+e)/(1-e)^2) < B := by
  let F (e : ℝ) := (C+e)*(2*e)/(1-e)^2
  let G (e : ℝ) := ((C+e)*(1/(w*κ))/(1-e)^2)*Real.sqrt (d₁+e)*Real.sqrt (d₂+e)/(1-F e)
  have hF₀ : F 0=0 := by simp [F]
  have hG₀ : G 0=C*(1/(w*κ))*Real.sqrt d₁*Real.sqrt d₂ := by simp [G,hF₀]
  have hF : ContinuousAt F 0 := by
    dsimp only [F]
    refine (((continuous_const.add continuous_id).mul
      (continuous_const.mul continuous_id)).continuousAt).div
      (((continuous_const.sub continuous_id).pow 2).continuousAt) ?_
    change (1-(0:ℝ))^2 ≠ 0
    norm_num
  have hG : ContinuousAt G 0 := by
    dsimp only [G]
    have hBase : ContinuousAt (fun e : ℝ => (C+e)*(1/(w*κ))/(1-e)^2) 0 :=
      (((continuous_const.add continuous_id).mul_const _).continuousAt).div
        ((continuous_const.sub continuous_id).pow 2).continuousAt (by change (1-(0:ℝ))^2 ≠ 0; norm_num)
    have hS₁ : ContinuousAt (fun e : ℝ => Real.sqrt (d₁+e)) 0 :=
      (Real.continuous_sqrt.comp (continuous_const.add continuous_id)).continuousAt
    have hS₂ : ContinuousAt (fun e : ℝ => Real.sqrt (d₂+e)) 0 :=
      (Real.continuous_sqrt.comp (continuous_const.add continuous_id)).continuousAt
    exact ((hBase.mul hS₁).mul hS₂).div (continuousAt_const.sub hF) (by simp [hF₀])
  have hFd : ∀ᶠ e in 𝓝 (0:ℝ), F e < 1 := hF.eventually_lt
    (continuousAt_const : ContinuousAt (fun _ : ℝ => (1:ℝ)) 0) (by rw [hF₀]; norm_num)
  have hGd : ∀ᶠ e in 𝓝 (0:ℝ), G e < B := hG.eventually_lt
    (continuousAt_const : ContinuousAt (fun _ : ℝ => B) 0) (by rwa [hG₀])
  have hUpper : ∀ᶠ e in 𝓝 (0:ℝ), e < 1 := gt_mem_nhds (by norm_num)
  have hEvent : ∀ᶠ e in 𝓝[>] (0:ℝ), 0<e ∧ e<1 ∧ F e<1 ∧ G e<B :=
    (show ∀ᶠ e in 𝓝[>] (0:ℝ), 0<e from self_mem_nhdsWithin).and
      ((hUpper.and (hFd.and hGd)).filter_mono nhdsWithin_le_nhds)
  obtain ⟨e,he,he₁,hFe,hGe⟩ := hEvent.exists
  obtain ⟨N,hN⟩ := exists_nat_gt (A/e)
  have hN₀ : (0:ℝ)<N := (div_nonneg hA he.le).trans_lt hN
  have hMesh : A/(N:ℝ)≤e := (div_le_iff₀ hN₀).mpr (by
    have hh := (div_lt_iff₀ he).mp hN
    linarith only [hh])
  have hPrec : (C+e)*(A/N+e)/(1-e)^2≤F e := by
    dsimp only [F]
    apply div_le_div_of_nonneg_right _ (sq_nonneg _)
    apply mul_le_mul_of_nonneg_left _ (add_nonneg hC he.le)
    linarith only [hMesh]
  refine ⟨e,N,he,he₁,by exact_mod_cast hN₀,hPrec.trans_lt hFe,?_⟩
  refine lt_of_le_of_lt ?_ hGe
  dsimp only [G]
  refine div_le_div_of_nonneg_left (by positivity) (by linarith only [hFe]) ?_
  exact sub_le_sub_left hPrec 1

end GoldbachPintzNumerics
