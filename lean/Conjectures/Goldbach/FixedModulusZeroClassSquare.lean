noncomputable section

def modulusRivals {q : ℕ} [NeZero q] (K : ℕ) (same : Bool) (H R : ℝ)
    (p : DirichletCharacter ℂ q × ℂ) :=
  ((modulusZeros q H R).erase p).filter
    (fun j => same=true → conductorClass K j.1=conductorClass K p.1)

theorem quadratic_mul_ratio {q : ℕ} (ξ χ : DirichletCharacter ℂ q) (hξ : ξ^2=1) :
    ξ*χ = χ/ξ := by
  have h : ξ=ξ⁻¹ := by
    apply eq_inv_of_mul_eq_one_left
    simpa only [pow_two] using hξ
  rw [div_eq_mul_inv,←h,mul_comm]

theorem modulus_rival_window {q K : ℕ} [NeZero q] {H R U : ℝ} {same : Bool}
    (hR : 0≤R) (_hRU : R≤U) (G : ModulusWindowGrowth q K.factorial U)
    (hClean : ∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
      1/2<z.re → regularizedL ψ z=0 → modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R)
    (hQ : ∀ j∈modulusZeros q H R, K.factorial<j.1.conductor)
    {p r : DirichletCharacter ℂ q × ℂ} (hr : r∈modulusRivals K same H R p)
    (hRP : ∀ j∈modulusRivals K same H R p,j.2.re≤r.2.re)
    (hQuad : p.1^2=1) {ψ : DirichletCharacter ℂ q} (hψ : ψ≠1)
    (hP : ψ=p.1 ∨ ψ=r.1 ∨ ψ=p.1*r.1) {z : ℂ} (hz : regularizedL ψ z=0)
    (ht : |z.im|≤1 ∨ |z.im-r.2.im|≤1) :
    (ψ=p.1 ∧ z=p.2) ∨ z.re≤r.2.re := by
  classical
  by_contra! hn
  have hm := mem_erase.mp (mem_filter.mp hr).1
  obtain ⟨_,hrz,hrG⟩ := mem_fixed_modulus_zeros.mp hm.2
  obtain ⟨hrre,hrim,_⟩ := (mem_exceptionalZeros _ _ _).mp hrz
  have hr' : (ψ,z)∈modulusZeros q H R := by
    rcases ht with ht|ht
    · exact clean_height_local_zeros hψ hrre (zero_le_one.trans G.log_one) hrG
        (t:=0) (by simpa using (show (0:ℝ)≤4*R+1 by linarith only [hR]))
        hClean z hz (by simpa using ht) hn.2
    · exact clean_height_local_zeros hψ hrre (zero_le_one.trans G.log_one) hrG
        (t:=r.2.im) (by linarith only [hrim,hR]) hClean z hz ht hn.2
  have hne : (ψ,z)≠p := by
    intro h
    exact hn.1 (congrArg Prod.fst h) (congrArg Prod.snd h)
  apply (not_le_of_gt hn.2) (hRP (ψ,z) (mem_filter.mpr ⟨mem_erase.mpr ⟨hne,hr'⟩,?_⟩))
  intro hs
  have hClass := (mem_filter.mp hr).2 hs
  rcases hP with rfl|rfl|rfl
  · rfl
  · exact hClass
  · apply False.elim
    have hd := (conductorClass_eq_iff r.1 p.1).mp hClass
    exact (not_le_of_gt (hQ _ hr'))
      (Nat.le_of_dvd (Nat.factorial_pos K) (by simpa only [quadratic_mul_ratio _ _ hQuad] using hd))

private theorem weighted_runner_gap {a A μ c b Z target : ℝ}
    (h₀ : 0≤a) (hA : a≤A) (hb : 0<b) (hBC : 0<b-c)
    (hEdge : realRationalZeroKernel b (-c)-realRationalZeroKernel b (A-c)+Z<target)
    (hRun : target≤realRationalZeroKernel b (-μ)-realRationalZeroKernel b (a-μ)+Z) :
    c<μ := by
  by_contra! h
  have hKer := realRationalZeroKernel_antitone (b:=b) (x:=a-μ) (y:=A-μ) hb
    (by linarith only [h₀,hBC,h]) (by linarith only [hA])
  have hInc := rational_kernel_increment_antitone (b:=b) (x:=-c) (y:=-μ) (m:=A)
    hb (by linarith only [hBC]) (neg_le_neg h) (h₀.trans hA)
  rw [show -μ+A=A-μ by ring,show -c+A=A-c by ring] at hInc
  linarith only [hKer,hInc,hEdge,hRun]

set_option maxHeartbeats 1400000 in
/-- A fixed endpoint prime test bounds every rival of a real quadratic leader. -/
theorem eventually_modulus_real_rival_gap (K : ℕ) (same : Bool)
    {H U A c b b' : ℝ} (hc : 0≤c) (hH : c≤H) (hb : c<b) (hb' : c<b')
    (hEdge : realRationalZeroKernel b (-c)-realRationalZeroKernel b (A-c)+
       (if same then 0.37775 else 0.56475)<realRationalZeroKernel b 0)
    (hOwn : 2*(realRationalZeroKernel b' (-c)-realRationalZeroKernel b' (A-c))+
       0.377<realRationalZeroKernel b' 0) :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (R : ℝ), 0≤R → R≤U →
      ModulusWindowGrowth q K.factorial U →
      (∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
        1/2<z.re → regularizedL ψ z=0 → modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R) →
      ∀ p∈modulusZeros q H R, (∀ i∈modulusZeros q H R,i.2.re≤p.2.re) →
      p.1^2=1 → p.2.im=0 → modulusOrder p=1 → modulusGap q p.2≤A →
      ∀ r∈modulusRivals K same H R p, c< modulusGap q r.2 := by
  have hLog : Tendsto (fun q : ℕ => Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R:=ℝ))
  have hE := hLog.eventually (rational_real_runner_up_gap_eventually
    (ε:=3/4000) (b:=b) (κ:=b-c) (K:=2) (D:=8) (p:=1) (H:=c)
    (by norm_num) (hc.trans_lt hb) (sub_pos.mpr hb)
    (by norm_num) (by norm_num) (by norm_num) hc)
  have hO := hLog.eventually (rational_same_character_runner_up_gap_eventually
    (ε:=1/1000) (b:=b') (κ:=b'-c) (K:=2) (D:=8) (p:=1) (H:=c)
    (by norm_num) (hc.trans_lt hb') (sub_pos.mpr hb')
    (by norm_num) (by norm_num) (by norm_num) hc)
  filter_upwards [hE,hO,eventually_no_fixed_conductor_zero K.factorial H (4*U+2)] with q hE hO hQ
  intro _ R hR hRU G hClean p hp hP hQuad hReal hSimple hA j hj
  by_contra! hjc
  obtain ⟨r,hr,hBest⟩ := exists_max_image (modulusRivals K same H R p) (fun j=>j.2.re) ⟨j,hj⟩
  have hSmall (i) (hi : i∈modulusZeros q H R) := hQ i (modulusZeros_subset
    (le_refl H) (by linarith only [hR,hRU]) hi)
  have hr' := mem_erase.mp (mem_filter.mp hr).1
  obtain ⟨hξ,hpz,_⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨_,_,hZp⟩ := (mem_exceptionalZeros _ _ _).mp hpz
  obtain ⟨hχ,hrz,_⟩ := mem_fixed_modulus_zeros.mp hr'.2
  obtain ⟨_,hγR,hZr⟩ := (mem_exceptionalZeros _ _ _).mp hrz
  let L := Real.log (q:ℝ)
  let B := L^(8:ℝ)
  let T := L^(2:ℝ)+1
  have hL : 0<L := zero_lt_one.trans_le G.log_one
  have hσ : p.2.re≤1 := le_of_not_gt (fun h=>regularizedL_ne_zero_right p.1 h hZp)
  have hrp := hP r hr'.2
  have hGap : modulusGap q r.2≤c :=
    (mul_le_mul_of_nonneg_right (sub_le_sub_left (hBest j hj) _) hL.le).trans hjc
  have hβ : 1-c/L≤r.2.re := by
    have hh := (le_div_iff₀ hL).mpr hGap
    linarith only [hh]
  have hShift (x : ℝ) : 1+(x-c)/L≤r.2.re+x/L := by
    rw [sub_div]
    linarith only [hβ]
  have hB : 1≤B := Real.one_le_rpow G.log_one (by norm_num)
  have hBL : Real.log B≤8*Real.log L := by dsimp only [B]; rw [Real.log_rpow hL]
  have hγ : |r.2.im|≤L^(1:ℝ) := by
    rw [Real.rpow_one]
    linarith only [hγR,hR,hRU,G.large_log]
  have ht : |r.2.im|≤4*U := by linarith only [hγR,hR,hRU]
  have hT : |r.2.im|+1/4≤T :=
    (G.primeTestWindow (σ:=1) hχ ht (fun _ hz _ => le_of_not_gt
      (fun h => regularizedL_ne_zero_right r.1 h hz))).height
  have h0 := G.log_height 0 (by simp; linarith only [hR,hRU])
  have hγlog := G.log_height _ ht
  have hPL : line p.2.re 0=p.2 := by rw [←hReal,line_of_coordinates]
  have hRL := line_of_coordinates r.2
  have hp₀ := modulusGap_nonneg_of_mem hp
  have hWindow {ψ : DirichletCharacter ℂ q} (hψ : ψ≠1)
      (hQi : ψ=p.1 ∨ ψ=r.1 ∨ ψ=p.1*r.1) {z : ℂ}
      (hz : regularizedL ψ z=0) (h : |z.im|≤1 ∨ |z.im-r.2.im|≤1) :=
    modulus_rival_window hR hRU G hClean hSmall hr hBest hQuad hψ hQi hz h
  by_cases heq : r.1=p.1
  · have hne : line p.2.re 0≠line r.2.re r.2.im := by
      rw [hPL,hRL]
      intro he
      exact hr'.1 (Prod.ext heq he.symm)
    have hh := hO q p.1 p.2.re r.2.re r.2.im B T (47/125) hQuad hξ le_rfl hβ hrp hσ
      (hShift b') hγ hT h0 hγlog hB hBL (by norm_num)
      (G.general p.1 hξ) (by simpa only [hPL] using hZp) (by simpa only [hRL,←heq] using hZr) hne
      (by simpa only [hPL,modulusOrder] using hSimple) (fun z hz h => by
        simpa only [hPL,true_and] using hWindow hξ (Or.inl rfl) hz h)
    have h₁ : L*(r.2.re-1) = -modulusGap q r.2 := by unfold modulusGap L; ring
    have h₂ : L*(r.2.re-p.2.re) = modulusGap q p.2-modulusGap q r.2 := by unfold modulusGap L; ring
    rw [h₁,h₂] at hh
    have hEnd := weighted_runner_gap (μ:=modulusGap q r.2) (b:=b') (Z:=0.377/2)
      (target:=realRationalZeroKernel b' 0/2) hp₀ hA (hc.trans_lt hb') (sub_pos.mpr hb')
      (by linarith only [hOwn]) (by linarith only [hh])
    exact hEnd.not_ge hGap
  · have hProd : p.1*r.1≠1 := by
      intro h
      apply heq
      rw [quadratic_mul_ratio _ _ hQuad,div_eq_one] at h
      exact h
    let φ : DirichletCharacter ℂ q→ℝ := fun ψ=>if ψ.conductor≤K.factorial then 1/1000 else 47/125
    have hφ (ψ : DirichletCharacter ℂ q) : 0≤φ ψ ∧ φ ψ≤47/125 := by
      unfold φ
      split <;> norm_num
    have hStrip (ψ : DirichletCharacter ℂ q) (hn : ψ≠1) (z : ℂ)
        (hz : 3/4≤z.re) (hz' : z.re≤3/2) (hzi : |z.im|≤T) :
        ‖ψ.LFunction z‖≤B*(q:ℝ)^(φ ψ*max 0 (1-z.re)) := by
      unfold φ
      split
      · exact G.bounded ψ hn ‹_› z hz hz' hzi
      · exact G.general ψ hn z hz hz' hzi
    have hh := hE q p.1 r.1 p.2.re r.2.re r.2.im B T φ hQuad hξ hχ hProd le_rfl
      hβ hrp hσ (hShift b) hγ hT h0 hγlog hB hBL (fun ψ _=>(hφ ψ).1) hStrip
      (by simpa only [hPL] using hZp) (by simpa only [hRL] using hZr)
      (fun ψ hψ z hz h => by
        have hn : ψ≠1 := by rcases hψ with rfl|rfl|rfl <;> assumption
        simpa only [hPL] using hWindow hn hψ hz h)
    have hCost : (φ p.1+φ r.1+φ (p.1*r.1))/2+3/4000≤
        (if same then (0.37775:ℝ) else 0.56475) := by
      have hPφ := (hφ p.1).2
      have hRφ := (hφ r.1).2
      have hProdφ := (hφ (p.1*r.1)).2
      cases hS : same
      · norm_num only [hS,Bool.false_eq_true,ite_false]
        linarith only [hPφ,hRφ,hProdφ]
      · have hd := (conductorClass_eq_iff r.1 p.1).mp ((mem_filter.mp hr).2 hS)
        have hPd : (p.1*r.1).conductor≤K.factorial :=
          Nat.le_of_dvd (Nat.factorial_pos K) (by simpa only [quadratic_mul_ratio _ _ hQuad] using hd)
        have h : φ (p.1*r.1)=1/1000 := by simp only [φ,ite_eq_left hPd]
        norm_num only [hS,ite_true]
        linarith only [hPφ,hRφ,h]
    have h₁ : L*(r.2.re-1) = -modulusGap q r.2 := by unfold modulusGap L; ring
    have h₂ : L*(r.2.re-p.2.re) = modulusGap q p.2-modulusGap q r.2 := by unfold modulusGap L; ring
    rw [h₁,h₂] at hh
    exact (runner_up_gap_of_endpoints (μ:=modulusGap q r.2) hp₀ hA (hc.trans_lt hb) (sub_pos.mpr hb) hEdge
      (by linarith only [hh,hCost])).not_ge hGap

end
