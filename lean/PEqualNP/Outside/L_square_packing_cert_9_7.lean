import Mathlib

theorem PEqualNP.Outside.L_square_packing_cert_9_7 :
    ∀ x y L:ℝ, (∀ u v:ℝ, |u|≤1/2 → |v|≤1/2 → 0≤x+(32*u-126*v)/130 ∧ x+(32*u-126*v)/130≤L ∧ 0≤y+(126*u+32*v)/130 ∧ y+(126*u+32*v)/130≤L) ↔ (158:ℝ)/(2*130)≤x ∧ x≤L-(158:ℝ)/(2*130) ∧ (158:ℝ)/(2*130)≤y ∧ y≤L-(158:ℝ)/(2*130) := by
  intro x y L
  constructor
  · intro h
    have e1 : |(-1/2:ℝ)| ≤ 1/2 := by rw [abs_le]; constructor <;> norm_num
    have e2 : |(1/2:ℝ)| ≤ 1/2 := by rw [abs_le]; constructor <;> norm_num
    have h1 := (h (-1/2) (1/2) e1 e2).1
    have h2 := (h (1/2) (-1/2) e2 e1).2.1
    have h3 := (h (-1/2) (-1/2) e1 e1).2.2.1
    have h4 := (h (1/2) (1/2) e2 e2).2.2.2
    refine ⟨by linarith, by linarith, by linarith, by linarith⟩
  · rintro ⟨hx1, hx2, hy1, hy2⟩ u v hu hv
    obtain ⟨hu1, hu2⟩ := abs_le.mp hu
    obtain ⟨hv1, hv2⟩ := abs_le.mp hv
    refine ⟨by linarith, by linarith, by linarith, by linarith⟩
