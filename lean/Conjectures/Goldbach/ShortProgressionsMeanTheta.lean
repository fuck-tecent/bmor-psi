open scoped Classical
namespace ShortAP
noncomputable section

/-- The zero modulus is not summed; this definition keeps the family
finite without imposing a bogus Fintype instance at modulus zero. -/
def primitiveChars (q : ℕ) : Finset (DirichletCharacter ℂ q) :=
  if h : q = 0 then ∅ else
    letI : NeZero q := ⟨h⟩
    Finset.univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive)

private def addPhase (z : ℝ) : ℂ := Complex.exp (((2 * Real.pi * z : ℝ) : ℂ) * Complex.I)

private theorem hybrid_assembly (N Q : ℕ) (T : ℝ) (hT : 1 ≤ T) (c : ℕ → ℂ)
    (hprim : ∀ (q : ℕ) [NeZero q] (d : ℕ → ℂ),
      (∑ χ ∈ primitiveChars q, ‖∑ n ∈ Finset.Icc 1 N, d n * χ (n : ZMod q)‖^2) ≤
       ∑ a ∈ (Finset.range q).filter (fun a => a.Coprime q), ‖∑ n ∈ Finset.Icc 1 N,
         d n * addPhase ((n:ℝ)*((a:ℝ)/q))‖^2)
    (hwin : ∀ y : ℝ, (∑ q ∈ Finset.Icc 1 Q, ∑ a ∈ (Finset.range q).filter (fun a => a.Coprime q),
      ‖∑ n ∈ Finset.Icc 1 N, (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator
        (fun _ : ℝ => c n * addPhase ((n:ℝ)*((a:ℝ)/q))) y‖^2) ≤
      (Real.pi+1)*((Q:ℝ)^2+(N:ℝ)/T) * ∑ n ∈ Finset.Icc 1 N,
        (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator (fun _ : ℝ => ‖c n‖^2) y) :
    (∑ q ∈ Finset.Icc 1 Q, ∑ χ ∈ primitiveChars q, ∫ t : ℝ in -T..T,
      ‖∑ n ∈ Finset.Icc 1 N, c n * χ (n : ZMod q) / (n : ℂ)^((t : ℂ)*Complex.I)‖^2) ≤
      (8*Real.pi)*(Real.pi+1)*((Q:ℝ)^2*T+N) * ∑ n ∈ Finset.Icc 1 N, ‖c n‖^2 := by
  let J := (Finset.Icc 1 Q).sigma primitiveChars
  let b (j : Σ q, DirichletCharacter ℂ q) (n : ℕ) := c n * j.2 (n : ZMod j.1)
  have hp (n : ℕ) (hn : n ∈ Finset.Icc 1 N) : 0 < n := (Finset.mem_Icc.mp hn).1
  have L := hybrid_of_local_sieve J (Finset.Icc 1 N) hp b (fun n => ‖c n‖^2)
    (Q := (Q:ℝ)) (N := (N:ℝ)) (C := Real.pi+1) (lt_of_lt_of_le zero_lt_one hT)
  rw [Finset.sum_sigma']
  apply L
  intro y
  unfold J
  rw [Finset.sum_sigma]
  refine le_trans (Finset.sum_le_sum fun q hq => ?_) (hwin y)
  have : NeZero q := ⟨Nat.ne_of_gt (Finset.mem_Icc.mp hq).1⟩
  have H := hprim q (fun n => (Set.Ioc (Real.log n-1/T) (Real.log n)).indicator
    (fun _ : ℝ => c n) y)
  simpa only [b, Set.indicator_mul_const] using H

/-- Koukoulopoulos, Lemma 3.1. The family consists of all primitive characters
of every positive modulus up to Q; the constant does not depend on T, Q, N or c. -/
theorem hybrid_character_mean_square (N Q : ℕ) (T : ℝ) (hQ : 1 ≤ Q) (hT : 1 ≤ T) (c : ℕ → ℂ) :
    (∑ q ∈ Finset.Icc 1 Q, ∑ χ ∈ primitiveChars q, ∫ t : ℝ in -T..T,
      ‖∑ n ∈ Finset.Icc 1 N, c n * χ (n : ZMod q) / (n : ℂ)^((t : ℂ)*Complex.I)‖^2) ≤
      (8*Real.pi)*(Real.pi+1)*((Q:ℝ)^2*T+N) * ∑ n ∈ Finset.Icc 1 N, ‖c n‖^2 := by
  apply hybrid_assembly N Q T hT c
  · intro q hq d
    simpa only [primitiveChars, dite_eq_right (NeZero.ne q), addPhase] using
      ShortAPPrimitive.primitive_sieve q (Finset.Icc 1 N) d
  · exact ShortAPWindowSieve.log_window_large_sieve ShortAPAdditive.large_sieve N Q c hT hQ

end
end ShortAP

end

