namespace GoldbachPintzTheta

/-- The sharp constructor supplies the older coarse sieve specification. -/
theorem exists_theta_real_of_sharp {W : ℝ} (hW : 16≤W) :
    ∃ θ : ℕ → ℝ, θ 1=1 ∧ (∀ d, |θ d|≤1) ∧
      (∀ d : ℕ, W < (d:ℝ) → θ d=0) ∧ ∀ q : ℕ, 0<q →
        ((q.totient:ℝ)/(q:ℝ))*quadratic (Finset.Icc 1 ⌊W⌋₊) θ q ≤ 16/Real.log W := by
  obtain ⟨θ,hθ,hB,hSupp,hNorm⟩ := exists_theta_sharp (show 2≤W by linarith)
  have hLog : 0<Real.log W := Real.log_pos (by linarith)
  exact ⟨θ,hθ,hB,hSupp,fun q hq=>(hNorm q hq).trans
    (div_le_div_of_nonneg_right (by norm_num) hLog.le)⟩

end GoldbachPintzTheta
