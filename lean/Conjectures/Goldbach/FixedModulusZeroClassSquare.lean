namespace GoldbachPintzTheta

open Finset

noncomputable section

private def reciprocal (n : ℕ) : ℝ := (n:ℝ)⁻¹

private theorem reciprocal_factored_sum (S : Finset ℕ) (hS : ∀ p ∈ S, p.Prime) :
    HasSum (fun n : Nat.factoredNumbers S => reciprocal n)
      (∏ p ∈ S, (1-(p:ℝ)⁻¹)⁻¹) := by
  have hGeo {p : ℕ} (hp : p.Prime) : ∑' j : ℕ, reciprocal (p^j) = (1-(p:ℝ)⁻¹)⁻¹ := by
    have hp' := inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt : (1:ℝ)<p)
    simpa only [reciprocal,Nat.cast_pow,inv_pow] using tsum_geometric_of_lt_one (by positivity) hp'
  have hSum {p : ℕ} (hp : p.Prime) : Summable fun j : ℕ => ‖reciprocal (p^j)‖ := by
    have hp' := inv_lt_one_of_one_lt₀ (by exact_mod_cast hp.one_lt : (1:ℝ)<p)
    have hp'' : ‖(p:ℝ)⁻¹‖ < 1 := by rw [Real.norm_of_nonneg (inv_nonneg.mpr (Nat.cast_nonneg p))]; exact hp'
    simpa only [reciprocal,Nat.cast_pow,inv_pow,norm_pow] using
      (summable_geometric_of_norm_lt_one hp'').norm
  obtain ⟨_,h⟩ := EulerProduct.summable_and_hasSum_factoredNumbers_prod_filter_prime_tsum
    (f:=reciprocal) (by simp [reciprocal]) (fun {_ _} _ => by simp [reciprocal,Nat.cast_mul,mul_comm]) hSum S
  convert h using 1
  rw [filter_true_of_mem hS]
  exact prod_congr rfl (fun p hp => (hGeo (hS p hp)).symm)

/-- Group the harmonic sum by its exact prime support and majorize each fiber
using the convergent positive prime-power series. -/
theorem harmonic_le_sum_prime_support (y : ℕ) :
    (∑ n ∈ Icc 1 y, (n:ℝ)⁻¹) ≤
      ∑ S ∈ y.primesLE.powerset, if (∏ p ∈ S, p)≤y then
        ∏ p ∈ S, (p:ℝ)⁻¹*(1-(p:ℝ)⁻¹)⁻¹ else 0 := by
  classical
  let A := Icc 1 y
  let P := y.primesLE.powerset
  have hMap (n : ℕ) (hn : n∈A) : n.primeFactors∈P := by
    refine mem_powerset.mpr fun p hp => Nat.mem_primesLE.mpr ⟨?_,Nat.prime_of_mem_primeFactors hp⟩
    exact (Nat.le_of_dvd (mem_Icc.mp hn).1 (Nat.dvd_of_mem_primeFactors hp)).trans (mem_Icc.mp hn).2
  change (∑ n ∈ A, reciprocal n) ≤ _
  rw [← sum_fiberwise_of_maps_to hMap reciprocal]
  refine sum_le_sum fun S hS => ?_
  let d := ∏ p ∈ S, p
  let B := A.filter fun n => n.primeFactors=S
  have hSp (p : ℕ) (hp : p∈S) : p.Prime := Nat.prime_of_mem_primesLE ((mem_powerset.mp hS) hp)
  have hd : 0<d := prod_pos fun p hp => (hSp p hp).pos
  have hDiv (n : ℕ) (hn : n∈B) : d∣n := by
    have hS' := (mem_filter.mp hn).2
    simpa only [d, hS'] using Nat.prod_primeFactors_dvd n
  have hdR : 0 < (d:ℝ) := by exact_mod_cast hd
  have hweight : (∏ p ∈ S, (p:ℝ)⁻¹*(1-(p:ℝ)⁻¹)⁻¹) =
        reciprocal d * ∏ p ∈ S, (1-(p:ℝ)⁻¹)⁻¹ := by
    simp only [prod_mul_distrib,reciprocal,d,Nat.cast_prod,prod_inv_distrib]
  change (∑ n ∈ B, reciprocal n) ≤ if d≤y then _ else 0
  by_cases hdy : d≤y
  · rw [ite_eq_left hdy,hweight]
    let C := B.image (fun n => n/d)
    have hCf (k : ℕ) (hk : k∈C) : k∈Nat.factoredNumbers S := by
      obtain ⟨n,hn,rfl⟩ := mem_image.mp hk
      have hB := mem_filter.mp hn
      have hN : n∈Nat.factoredNumbers S := Nat.mem_factoredNumbers_iff_primeFactors_subset.mpr
        ⟨Nat.ne_of_gt (mem_Icc.mp hB.1).1, hB.2 ▸ subset_rfl⟩
      exact Nat.mem_factoredNumbers_of_dvd hN (Nat.div_dvd_of_dvd (hDiv n hn))
    have hC : (∑ k∈C, reciprocal k)≤∏ p∈S, (1-(p:ℝ)⁻¹)⁻¹ := by
      have h := reciprocal_factored_sum S hSp
      rw [← h.tsum_eq,← sum_subtype_of_mem reciprocal hCf]
      exact h.summable.sum_le_tsum _ (fun _ _ => by unfold reciprocal; positivity)
    have hInj : Set.InjOn (fun n : ℕ => n/d) (B:Set ℕ) := by
      intro i hi j hj he
      have h := congrArg (fun k : ℕ => k*d) he
      simpa only [Nat.div_mul_cancel (hDiv i hi), Nat.div_mul_cancel (hDiv j hj)] using h
    calc
      _ = reciprocal d * ∑ k ∈ C, reciprocal k := by
        rw [mul_sum,sum_image hInj]
        refine sum_congr rfl fun n hn => ?_
        have h := Nat.div_mul_cancel (hDiv n hn)
        unfold reciprocal
        conv_lhs => rw [← h]
        rw [Nat.cast_mul,mul_inv,mul_comm]
      _ ≤ _ := mul_le_mul_of_nonneg_left hC (inv_nonneg.mpr hdR.le)
  · rw [ite_eq_right hdy]
    have hEmpty : B=∅ := by
      apply eq_empty_iff_forall_notMem.mpr
      intro n hn
      have H := Nat.le_of_dvd (mem_Icc.mp (mem_filter.mp hn).1).1 (hDiv n hn)
      exact hdy (H.trans (mem_Icc.mp (mem_filter.mp hn).1).2)
    simp [hEmpty]

end
end GoldbachPintzTheta
