    (z : ℂ) : ℂ :=
  DirichletCharacter.LFunction χ (V1a r t z) /
    DirichletCharacter.LFunction χ (V1a r t 0)
lemma Vm7 {r t : ℝ} (hr : 0 < r) (ht : 3 * r < |t|)
    {z : ℂ} (hz : ‖z‖ ≤ 1) : V1a r t z ≠ 1 := by
  intro he
