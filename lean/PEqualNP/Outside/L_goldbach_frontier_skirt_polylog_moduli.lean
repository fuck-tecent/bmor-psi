  have hS (n : ℕ) (hn : n ∈ S) :
      1 ≤ n ∧ n ≤ N ∧ |Real.log n - x| ≤ h := by
    obtain ⟨hnN, hne⟩ := Finset.mem_filter.mp hn
    have hw : |(x - Real.log n) / h| < 1 := lt_of_not_ge (fun hy => hne (hW _ hy))
