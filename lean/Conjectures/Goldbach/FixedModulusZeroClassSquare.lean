  have hγ : |r.2.im|≤L^(1:ℝ) := by
    rw [Real.rpow_one]
    linarith only [hγR,hR,hRU,G.large_log]
  have hB : 1≤B := Real.one_le_rpow G.log_one (by norm_num)
