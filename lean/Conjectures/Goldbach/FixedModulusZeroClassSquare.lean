theorem mem_modulus_conjugate {q : ℕ} [NeZero q] {H R : ℝ}
    {p : DirichletCharacter ℂ q × ℂ} (hp : p∈modulusZeros q H R) :
    (p.1⁻¹,line p.2.re (-p.2.im))∈modulusZeros q H R := by
  obtain ⟨hχ,hz,hGap⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨hβ,hγ,hZ⟩ := (mem_exceptionalZeros _ _ _).mp hz
  have hZ' : regularizedL p.1 (line p.2.re p.2.im)=0 := by
    rwa [line_of_coordinates]
  refine mem_fixed_modulus_zeros.mpr ⟨by simpa using hχ,?_,?_⟩
  · exact (mem_exceptionalZeros _ _ _).mpr ⟨by simpa [line] using hβ,by simpa [line] using hγ,
      regularizedL_inv_conj_line_zero p.1 hχ hZ'⟩
  · simpa [line] using hGap

theorem eventually_modulus_leading_simple {Q : ℕ} {H U : ℝ} :
    ∀ᶠ q : ℕ in atTop, ∀ [NeZero q] (R : ℝ), 0≤R → R≤U →
      ModulusWindowGrowth q Q U →
      (∀ (ψ : DirichletCharacter ℂ q) (z : ℂ), ψ≠1 →
        1/2<z.re → regularizedL ψ z=0 → modulusGap q z≤H → |z.im|≤4*R+2 → |z.im|≤R) →
      ∀ p∈modulusZeros q H R, (∀ i∈modulusZeros q H R,i.2.re≤p.2.re) →
      modulusGap q p.2≤0.38 → modulusOrder p=1 := by
  have hLog : Tendsto (fun q : ℕ => Real.log (q:ℝ)) atTop atTop :=
    Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R:=ℝ))
  filter_upwards [hLog.eventually (leading_zero_simple_of_strip (K:=2) (D:=8)
    (by norm_num) (by norm_num))] with q h
  intro _ R hR hRU G hClean p hp hP hGap
  obtain ⟨hχ,hz,_⟩ := mem_fixed_modulus_zeros.mp hp
  obtain ⟨_,hTime,hZ⟩ := (mem_exceptionalZeros _ _ _).mp hz
  let L := Real.log (q:ℝ)
  let B := L^(8:ℝ)
  let T := L^(2:ℝ)+1
  have hL : 0<L := zero_lt_one.trans_le G.log_one
  have hσ : p.2.re≤1 := le_of_not_gt (fun h=>regularizedL_ne_zero_right p.1 h hZ)
  have hB : 1≤B := Real.one_le_rpow G.log_one (by norm_num)
  have hBL : Real.log B≤8*Real.log L := by dsimp only [B]; rw [Real.log_rpow hL]
  have hW := leading_case_window hRU hR G hClean hp hP hχ
    (show |p.2.im|≤4*R by linarith only [hTime,hR])
  have hW' : PrimeTestWindow p.1 p.2.im p.2.re T B L 2 (1/2) := by
    refine ⟨hW.nonprincipal,hW.height,hW.logHeight_le,?_,hW.leading⟩
    intro z h₁ h₂ ht
    refine (hW.strip z h₁ h₂ ht).trans (mul_le_mul_of_nonneg_left ?_ (by positivity))
    have hq₁ : (1:ℝ)≤q := by exact_mod_cast NeZero.pos q
    exact Real.rpow_le_rpow_of_exponent_le hq₁
      (mul_le_mul_of_nonneg_right (by norm_num) (le_max_left _ _))
  have hSimple := h q p.1 p.2.re p.2.im T B le_rfl hσ
    (by simpa [modulusGap,L,show (19/50:ℝ)=0.38 by norm_num] using hGap) hB hBL hW' (by rwa [line_of_coordinates])
  simpa only [line_of_coordinates,modulusOrder] using hSimple

theorem repeatTags_card_le_of_simple_pair {ι : Type*} {S : Finset ι} {m : ι→ℕ}
    {P : ι→Prop} {p r : ι}
    (hp : m p=1) (hr : m r=1) (hPairs : ∀ j∈S, P j → j=p ∨ j=r) :
    ((repeatTags S m).filter (fun j=>P j.1)).card≤2 := by
  have hS : (repeatTags S m).filter (fun j=>P j.1)⊆
      ({⟨p,0⟩,⟨r,0⟩}:Finset (Σ _ : ι,ℕ)) := by
    intro j hj
    obtain ⟨hTag,hP⟩ := mem_filter.mp hj
    obtain ⟨hMem,hRange⟩ := mem_sigma.mp hTag
    obtain ⟨j,n⟩ := j
