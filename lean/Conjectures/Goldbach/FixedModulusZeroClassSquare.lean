/-- Four-term positivity of the rational test at a real quadratic anchor. -/
theorem quadratic_four_rational_primeTest_nonneg {q : ℕ} [NeZero q]
    (ξ χ : DirichletCharacter ℂ q) (hξ : ξ^2=1) {b L σ t : ℝ}
