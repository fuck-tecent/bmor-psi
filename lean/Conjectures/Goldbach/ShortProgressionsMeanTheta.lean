namespace GoldbachMajorArc
noncomputable section
def primeWeight (k : ℕ) : ℝ := if k.Prime then Real.log (k : ℝ) else 0
def classMass (m q b : ℕ) : ℝ := ∑ k ∈ (range m).filter (fun k => k % q = b), primeWeight k
end
end GoldbachMajorArc

namespace GoldbachMajorArc

open Finset Filter MeasureTheory
open OAI.LargePrimeGaps

noncomputable section

/-- The character form of Siegel–Walfisz gives a uniform bound for a reduced class.
The second term pays for replacing the character by its primitive character. -/
theorem progression_error (A B : ℝ) (hA : 0 < A) (hB : 0 < B) :
    ∃ M : ℝ, 0 < M ∧ ∃ x₀ : ℝ, 1 < x₀ ∧
      ∀ x : ℝ, x₀ ≤ x → ∀ q b : ℕ, 0 < q → (q : ℝ) ≤ (Real.log x) ^ B →
        b < q → b.Coprime q →
        |residuePrefix ArithmeticFunction.vonMangoldt ⌊x⌋₊ q b - x / q.totient| ≤
          M * x * (Real.log x) ^ (-A) + (Nat.log 2 ⌊x⌋₊ : ℝ) * Real.log q := by
  obtain ⟨M, hM, x₀, hx₀, hχ⟩ := siegelWalfisz A B hA hB
  refine ⟨M, hM, x₀, hx₀, ?_⟩
  intro x hx q b hq hqlog hb hcop
  let : NeZero q := ⟨hq.ne'⟩
  have hchar (χ : DirichletCharacter ℂ q) :
      ‖primeCharacterError x χ‖ ≤
        M * x * (Real.log x) ^ (-A) + (Nat.log 2 ⌊x⌋₊ : ℝ) * Real.log q := by
    have hcond : (χ.conductor : ℝ) ≤ q := by
      exact_mod_cast Nat.le_of_dvd hq χ.conductor_dvd_level
    exact (primeCharacterError_le_primitive x hq χ).trans (add_le_add
      (hχ x hx χ.conductor (Nat.pos_of_ne_zero χ.conductor_ne_zero) (hcond.trans hqlog) χ.primitiveCharacter
        χ.primitiveCharacter_isPrimitive) (le_refl _))
  have hcard : Fintype.card (DirichletCharacter ℂ q) = q.totient := by
    simpa only [Nat.card_eq_fintype_card] using
      DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity ℂ q
  have hφ : (0 : ℝ) < q.totient := by exact_mod_cast Nat.totient_pos.mpr hq
  apply (endpointClassError_le_character_sum x hq hb hcop).trans
  apply (div_le_iff₀ hφ).mpr
  calc
    _ ≤ ∑ _χ : DirichletCharacter ℂ q,
        (M * x * (Real.log x) ^ (-A) + (Nat.log 2 ⌊x⌋₊ : ℝ) * Real.log q) :=
      sum_le_sum fun χ _ => hchar χ
    _ = _ := by rw [sum_const, card_univ, hcard, nsmul_eq_mul, mul_comm]

private theorem primeWeight_le_mangoldt (k : ℕ) :
    primeWeight k ≤ ArithmeticFunction.vonMangoldt k := by
  by_cases hk : k.Prime
  · simp [primeWeight, hk, ArithmeticFunction.vonMangoldt_apply_prime hk]
  · simp [primeWeight, hk]

private theorem classMass_succ (N q b : ℕ) :
    classMass (N + 1) q b =
      ∑ k ∈ (Ioc 0 N).filter (fun k => k % q = b), primeWeight k := by
  rw [classMass, Nat.range_succ_eq_Icc_zero, sum_filter, sum_filter, ← add_sum_Ioc_eq_sum_Icc]
  · simp [primeWeight]
  · exact Nat.zero_le _

/-- Restriction to one class can discard no more prime-power mass than ψ(N) − θ(N). -/
theorem prime_power_correction (N q b : ℕ) :
    |classMass (N + 1) q b - residuePrefix ArithmeticFunction.vonMangoldt N q b| ≤
      Chebyshev.psi N - Chebyshev.theta N := by
  rw [classMass_succ, residuePrefix, residueSlice, abs_sub_comm, ← sum_sub_distrib,
    abs_of_nonneg (sum_nonneg fun k _ => sub_nonneg.mpr (primeWeight_le_mangoldt k))]
  have htotal : (∑ k ∈ Ioc 0 N, (ArithmeticFunction.vonMangoldt k - primeWeight k)) =
      Chebyshev.psi N - Chebyshev.theta N := by
    simp only [sum_sub_distrib, Chebyshev.psi, Chebyshev.theta, Nat.floor_natCast, sum_filter,
      primeWeight]
  rw [← htotal]
  apply sum_le_sum_of_subset_of_nonneg (filter_subset _ _)
  exact fun k _ _ => sub_nonneg.mpr (primeWeight_le_mangoldt k)

/-- Siegel–Walfisz for the actual logarithmic prime weights, uniformly in reduced residue
classes. The additive terms account for nonprimitive characters and proper prime powers. -/
theorem prime_progression_error (A B : ℝ) (hA : 0 < A) (hB : 0 < B) :
    ∃ M : ℝ, 0 < M ∧ ∃ x₀ : ℝ, 1 < x₀ ∧
      ∀ N q b : ℕ, x₀ ≤ N → 0 < q → (q : ℝ) ≤ (Real.log N) ^ B →
        b < q → b.Coprime q →
        |classMass (N + 1) q b - (N : ℝ) / q.totient| ≤
          M * N * (Real.log N) ^ (-A) + (Nat.log 2 N : ℝ) * Real.log q +
            2 * Real.sqrt N * Real.log N := by
  obtain ⟨M, hM, x₀, hx₀, h⟩ := progression_error A B hA hB
  refine ⟨M, hM, x₀, hx₀, ?_⟩
  intro N q b hN hq hlog hb hcop
  have he := h (N : ℝ) hN q b hq hlog hb hcop
  simp only [Nat.floor_natCast] at he
  have hpow := (prime_power_correction N q b).trans (Chebyshev.psi_sub_theta_le (hx₀.le.trans hN))
  exact (abs_sub_le _ (residuePrefix ArithmeticFunction.vonMangoldt N q b) _).trans
    ((add_le_add hpow he).trans_eq (add_comm _ _))

end
end GoldbachMajorArc
end
end Conjectures.Goldbach.PacketRationalPeakExcess_aux
end ShortAPLongWindowAnalyticSupport

namespace ShortAPLongWindow

open Finset Filter MeasureTheory
open scoped BigOperators Topology Classical
open ShortAPLongWindowAnalyticSupport.Conjectures.Goldbach.PacketRationalPeakExcess_aux.GoldbachMajorArc

noncomputable section

private theorem eventually_log_rpow_le_rpow (a b : ℝ) (hb : 0 < b) :
    ∀ᶠ z : ℝ in atTop, (Real.log z) ^ a ≤ z ^ b := by
  have hs := (isLittleO_log_rpow_rpow_atTop a hb).bound (show (0 : ℝ) < 1 by norm_num)
  filter_upwards [hs, eventually_ge_atTop (1 : ℝ)] with z hz h1
  have hlog := Real.log_nonneg h1
  simpa only [Real.norm_eq_abs, one_mul, abs_of_nonneg (Real.rpow_nonneg hlog a),
    abs_of_nonneg (Real.rpow_nonneg (zero_le_one.trans h1) b)] using hz

private theorem endpoint_error (A B : ℝ) (hA : 0 < A) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ z : ℝ in atTop, ∀ q b : ℕ,
      0 < q → (q : ℝ) ≤ (Real.log z) ^ B → b < q → b.Coprime q →
      |classMass (⌊z⌋₊ + 1) q b - z / (q.totient : ℝ)| ≤ C * z * (Real.log z) ^ (-A) := by
  obtain ⟨M, hM, z₀, _, hSW⟩ := progression_error A B hA hB
  refine ⟨M + 2 * B + 2, by linarith, ?_⟩
  filter_upwards [eventually_ge_atTop z₀, eventually_ge_atTop (2 : ℝ),
    eventually_log_rpow_le_rpow (A + 2) 1 (by norm_num),
    eventually_log_rpow_le_rpow (A + 1) (1 / 2) (by norm_num)] with z hz₀ hz2 hp₂ hp₁
  intro q b hq hqlog hbl hcop
  let N := ⌊z⌋₊
  let L := Real.log z
  have hz : 0 < z := by linarith
  have hL : 0 < L := Real.log_pos (by linarith)
  have hN1 : (1 : ℝ) ≤ N := by
    exact_mod_cast (Nat.le_floor_iff hz.le).2 (show (1 : ℝ) ≤ z by linarith)
  have hNz : (N : ℝ) ≤ z := Nat.floor_le hz.le
  have hLN : Real.log (N : ℝ) ≤ L := Real.log_le_log (by linarith) hNz
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog2large : 1 ≤ 2 * Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hlg : (Nat.log 2 N : ℝ) ≤ 2 * L := by
    calc
      _ ≤ Real.log (N : ℝ) / Real.log 2 := by
        simpa only [Real.logb, Nat.cast_ofNat] using Real.natLog_le_logb N 2
      _ ≤ L / Real.log 2 := div_le_div_of_nonneg_right hLN hlog2.le
      _ ≤ 2 * L := (div_le_iff₀ hlog2).2 (by
        have hh := mul_le_mul_of_nonneg_left hlog2large hL.le
        linarith only [hh])
  have hlogq : Real.log (q : ℝ) ≤ B * L := by
    calc
      _ ≤ Real.log (L ^ B) := Real.log_le_log (by exact_mod_cast hq) hqlog
      _ = B * Real.log L := Real.log_rpow hL B
      _ ≤ B * L := mul_le_mul_of_nonneg_left ((Real.log_le_sub_one_of_pos hL).trans (by linarith)) hB.le
  have hqLn : 0 ≤ Real.log (q : ℝ) := Real.log_nonneg (by exact_mod_cast hq)
  have e_log (r : ℝ) : L ^ (A + r) * L ^ (-A) = L ^ r := by
    rw [← Real.rpow_add hL]
    congr 1
    ring
  have hsmall₂ : L ^ (2 : ℕ) ≤ z * L ^ (-A) := by
    rw [← Real.rpow_two, ← e_log 2]
    exact mul_le_mul_of_nonneg_right (by simpa only [Real.rpow_one] using hp₂)
      (Real.rpow_nonneg hL.le _)
  have hsmall₁ : Real.sqrt z * L ≤ z * L ^ (-A) := by
    calc
      _ = Real.sqrt z * (L ^ (A + 1) * L ^ (-A)) := by rw [e_log 1, Real.rpow_one]
      _ ≤ Real.sqrt z * (z ^ (1 / 2 : ℝ) * L ^ (-A)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right hp₁ (Real.rpow_nonneg hL.le _))
          (Real.sqrt_nonneg _)
      _ = _ := by rw [← Real.sqrt_eq_rpow, ← mul_assoc, Real.mul_self_sqrt hz.le]
  have hqterm : (Nat.log 2 N : ℝ) * Real.log (q : ℝ) ≤ (2 * B) * (z * L ^ (-A)) := by
    calc
      _ ≤ (2 * L) * (B * L) := mul_le_mul hlg hlogq hqLn (by positivity)
      _ = (2 * B) * L ^ 2 := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left hsmall₂ (by positivity)
  have hpow : Chebyshev.psi N - Chebyshev.theta N ≤ 2 * (z * L ^ (-A)) := by
    calc
      _ ≤ 2 * Real.sqrt (N : ℝ) * Real.log (N : ℝ) := Chebyshev.psi_sub_theta_le hN1
      _ ≤ 2 * Real.sqrt z * L := mul_le_mul
        (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hNz) (by norm_num)) hLN (Real.log_nonneg hN1)
        (by positivity)
      _ ≤ _ := by rw [mul_assoc]; exact mul_le_mul_of_nonneg_left hsmall₁ (by norm_num)
  have hs := hSW z hz₀ q b hq hqlog hbl hcop
  calc
    _ ≤ |classMass (N + 1) q b -
          ShortAPLongWindowAnalyticSupport.Conjectures.Goldbach.PacketRationalPeakExcess_aux.OAI.LargePrimeGaps.residuePrefix
            ArithmeticFunction.vonMangoldt N q b| +
        |ShortAPLongWindowAnalyticSupport.Conjectures.Goldbach.PacketRationalPeakExcess_aux.OAI.LargePrimeGaps.residuePrefix
            ArithmeticFunction.vonMangoldt N q b - z / (q.totient : ℝ)| := abs_sub_le _ _ _
    _ ≤ 2 * (z * L ^ (-A)) + (M * z * L ^ (-A) + (2 * B) * (z * L ^ (-A))) :=
      show _ from add_le_add ((prime_power_correction N q b).trans hpow) (add_le_add le_rfl hqterm |>.trans' hs)
    _ = _ := by ring

private theorem theta_eq_prefix_difference {q : ℕ} [NeZero q] (a : (ZMod q)ˣ)
    {y h : ℝ} (hh : 0 ≤ h) :
    ShortAP.theta q a y h = classMass (⌊y + h⌋₊ + 1) q (a : ZMod q).val -
      classMass (⌊y⌋₊ + 1) q (a : ZMod q).val := by
  have hf (n : ℕ) : (n : ZMod q) = (a : ZMod q) ↔ n % q = (a : ZMod q).val := by
    rw [← ZMod.val_natCast q n]
    exact (ZMod.val_injective q).eq_iff.symm
  simp only [ShortAP.theta, hf, classMass, Finset.sum_filter, primeWeight]
  rw [← Finset.Ico_add_one_right_eq_Icc, Finset.sum_Ico_eq_sub _]
  exact Nat.add_le_add_right (Nat.floor_mono (by linarith)) 1

/-- The frozen error integral for `x / (log x)^R ≤ h ≤ x` and
`Q ≤ (log x)^B`, with fixed nonnegative `R` and positive `B`. -/
theorem integral_long_window (B R : ℝ) (hB : 0 < B) (hR : 0 ≤ R) :
    ∃ C : ℝ, 0 < C ∧ ∃ X : ℕ, ∀ x : ℝ, (X : ℝ) ≤ x → 1 ≤ x →
      ∀ h : ℝ, x / (Real.log x) ^ R ≤ h → h ≤ x →
      ∀ Q : ℕ, (Q : ℝ) ≤ (Real.log x) ^ B →
      (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, ShortAP.err q h y) ≤
        C * x * h / (Real.log x) ^ (18 : ℕ) := by
  let A := B + R + 18
  have hA : 0 < A := by dsimp [A]; linarith
  obtain ⟨M, hM, hEnd⟩ := endpoint_error A B hA hB
  obtain ⟨u, hu⟩ := Filter.eventually_atTop.mp hEnd
  let X : ℕ := ⌈max u 2⌉₊
  refine ⟨6 * M, by positivity, X, ?_⟩
  intro x hxX hx1 h hh hhx Q hQ
  have hux : u ≤ x := (le_max_left _ _).trans ((Nat.le_ceil _).trans hxX)
  have hx2 : 2 ≤ x := (le_max_right _ _).trans ((Nat.le_ceil _).trans hxX)
  have hx0 : 0 < x := by linarith
  have hxy : x ≤ 2 * x := by linarith
  let L := Real.log x
  have hL : 0 < L := Real.log_pos (by linarith)
  have hh0 : 0 ≤ h := (div_nonneg hx0.le (Real.rpow_nonneg hL.le _)).trans hh
  let cap := 6 * M * x * L ^ (-A)
  have cap0 : 0 ≤ cap := by dsimp [cap]; positivity
  have hpoint (y : ℝ) (hy : y ∈ Set.Icc x (2 * x)) :
      (∑ q ∈ Finset.Icc 1 Q, ShortAP.err q h y) ≤ (6*M) * h * L ^ (-(18 : ℝ)) := by
    have hqbound : ∀ q ∈ Finset.Icc 1 Q, ShortAP.err q h y ≤ cap := by
      intro q hq
      have hqpos : 0 < q := (Finset.mem_Icc.mp hq).1
      have : NeZero q := ⟨hqpos.ne'⟩
      have hqL : (q : ℝ) ≤ L ^ B := (show (q : ℝ) ≤ Q by exact_mod_cast (Finset.mem_Icc.mp hq).2).trans hQ
      apply (ShortAP.err_le_iff (q := q) y h cap cap0).2
      intro a
      let b := (a : ZMod q).val
      have hb : b < q := ZMod.val_lt _
      have hcop : b.Coprime q := (ZMod.isUnit_iff_coprime b q).1 (by simp [b])
      have prefix_bound {z : ℝ} (hzx : x ≤ z) (hz3 : z ≤ 3*x) :
          |classMass (⌊z⌋₊ + 1) q b - z / (q.totient : ℝ)| ≤ M * (3*x) * L^(-A) := by
        have hzlog : L ≤ Real.log z := Real.log_le_log hx0 hzx
        have hqz : (q : ℝ) ≤ (Real.log z)^B := hqL.trans (Real.rpow_le_rpow hL.le hzlog hB.le)
        exact (hu z (hux.trans hzx) q b hqpos hqz hb hcop).trans
          (mul_le_mul (mul_le_mul_of_nonneg_left hz3 hM.le)
            (Real.rpow_le_rpow_of_nonpos hL hzlog (by linarith))
            (Real.rpow_nonneg (hL.le.trans hzlog) _) (by positivity))
      rw [theta_eq_prefix_difference a hh0]
      change |classMass (⌊y+h⌋₊ + 1) q b - classMass (⌊y⌋₊ + 1) q b - h / (q.totient : ℝ)| ≤ cap
      have heq : classMass (⌊y+h⌋₊ + 1) q b - classMass (⌊y⌋₊ + 1) q b - h / (q.totient : ℝ) =
          (classMass (⌊y+h⌋₊ + 1) q b - (y+h) / (q.totient : ℝ)) -
            (classMass (⌊y⌋₊ + 1) q b - y / (q.totient : ℝ)) := by ring
      rw [heq]
      exact (abs_sub _ _).trans ((add_le_add (prefix_bound (by linarith [hy.1]) (by linarith [hy.2]))
        (prefix_bound hy.1 (by linarith [hy.2]))).trans_eq (by dsimp [cap]; ring))
    have hcard : (Finset.Icc 1 Q).card ≤ Q := by simp
    have hsum := (Finset.sum_le_sum hqbound).trans_eq (show (∑ _q ∈ Finset.Icc 1 Q, cap) =
        ((Finset.Icc 1 Q).card : ℝ) * cap by simp [nsmul_eq_mul])
    have he : L^B * L^(-A) = L^(-R) * L^(-(18 : ℝ)) := by
      rw [← Real.rpow_add hL, ← Real.rpow_add hL]
      congr 1
      dsimp [A]
      ring
    have hh' : x * L ^ (-R) ≤ h := by simpa only [Real.rpow_neg hL.le, div_eq_mul_inv] using hh
    calc
      _ ≤ ((Finset.Icc 1 Q).card : ℝ) * cap := hsum
      _ ≤ L^B * cap := mul_le_mul_of_nonneg_right ((by exact_mod_cast hcard : ((Finset.Icc 1 Q).card : ℝ) ≤ Q).trans hQ) cap0
      _ = (6*M) * (x * L^(-R)) * L^(-(18 : ℝ)) := by
        dsimp only [cap]
        calc
          _ = 6*M*x * (L^B * L^(-A)) := by ring
          _ = _ := by rw [he]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hh' (by positivity))
        (Real.rpow_nonneg hL.le _)
  have hc := intervalIntegral.integral_mono_on hxy
    (ShortAP.intervalIntegrable_errSum Q h x (2*x) hxy)
    (continuous_const.intervalIntegrable _ _) hpoint
  calc
    _ ≤ ∫ _ in x..2*x, (6*M) * h * L ^ (-(18 : ℝ)) := hc
    _ = _ := by
      rw [intervalIntegral.integral_const, smul_eq_mul, Real.rpow_neg hL.le,
        show (18 : ℝ) = ((18 : ℕ) : ℝ) by norm_num, Real.rpow_natCast, div_eq_mul_inv]
      dsimp only [L]
      ring

/-- The same result in the frozen `h = x^t` parameterization. The long-window
and polylogarithmic-modulus requirements are additional restrictions. -/
theorem integral_frozen_long_window (B R : ℝ) (hB : 0 < B) (hR : 0 ≤ R) :
    ∃ C : ℝ, 0 < C ∧ ∃ X : ℕ, ∀ x t : ℝ, (X : ℝ) ≤ x → 1 ≤ x → t ≤ 1 →
      x / (Real.log x) ^ R ≤ x ^ t → ∀ Q : ℕ, (Q : ℝ) ≤ (Real.log x) ^ B →
      (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, ShortAP.err q (x ^ t) y) ≤
        C * x * x ^ t / (Real.log x) ^ (18 : ℕ) := by
  obtain ⟨C, hC, X, h⟩ := integral_long_window B R hB hR
  refine ⟨C, hC, X, fun x t hxX hx ht hlong Q hQ => ?_⟩
  have hs : x ^ t ≤ x := by
    calc
      x ^ t ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hx ht
      _ = x := Real.rpow_one x
  exact h x hxX hx (x ^ t) hlong hs Q hQ

/-- In particular, at the frozen endpoint `t = 1`, the bound holds for
every fixed polylogarithmic range of moduli. -/
theorem integral_full_length (B : ℝ) (hB : 0 < B) :
    ∃ C : ℝ, 0 < C ∧ ∃ X : ℕ, ∀ x : ℝ, (X : ℝ) ≤ x → 1 ≤ x →
      ∀ Q : ℕ, (Q : ℝ) ≤ (Real.log x) ^ B →
      (∫ y in x..2*x, ∑ q ∈ Finset.Icc 1 Q, ShortAP.err q x y) ≤
        C * x * x / (Real.log x) ^ (18 : ℕ) := by
  obtain ⟨C, hC, X, h⟩ := integral_long_window B 0 hB le_rfl
  exact ⟨C, hC, X, fun x hxX hx Q hQ => h x hxX hx x (by simp) le_rfl Q hQ⟩

end
end ShortAPLongWindow

end

section

open Filter MeasureTheory Set
open scoped Topology Interval

namespace ShortAPContourShift

/-- The closed vertical strip used for contour translation. -/
def strip (a b : ℝ) : Set ℂ := Complex.re ⁻¹' Icc a b

private noncomputable def gaussian (ε : ℝ) (z : ℂ) : ℂ :=
  Complex.exp ((ε : ℂ) * z ^ 2)

private theorem norm_gaussian (ε x y : ℝ) :
    ‖gaussian ε ((x : ℂ) + (y : ℂ) * Complex.I)‖ = Real.exp (ε * (x ^ 2 - y ^ 2)) := by
  rw [gaussian, Complex.norm_exp]
  congr 1
  simp only [pow_two, Complex.mul_re, Complex.mul_im, Complex.add_re, Complex.add_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_zero, mul_one,
    zero_mul, zero_add, sub_zero, add_zero]

private theorem integrable_gaussian_vertical {f : ℂ → ℂ} {x ε : ℝ}
    (hε : 0 ≤ ε) (hf : Integrable (fun t : ℝ => f ((x : ℂ) + (t : ℂ) * Complex.I))) :
    Integrable (fun t : ℝ =>
      gaussian ε ((x : ℂ) + (t : ℂ) * Complex.I) * f ((x : ℂ) + (t : ℂ) * Complex.I)) := by
  apply (hf.norm.const_mul (Real.exp (ε * x ^ 2))).mono'
  · apply AEStronglyMeasurable.mul _ hf.aestronglyMeasurable
    apply Continuous.aestronglyMeasurable
    unfold gaussian
    fun_prop
  · filter_upwards [] with t
    rw [norm_mul, norm_gaussian]
    exact mul_le_mul_of_nonneg_right
      (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left (sub_le_self _ (sq_nonneg _)) hε))
      (norm_nonneg _)

private theorem abs_le_strip_size {a b x : ℝ} (hx : x ∈ Icc a b) : |x| ≤ |a| + |b| := by
  apply abs_le.mpr
  constructor
  · linarith [neg_abs_le a, abs_nonneg b, hx.1]
  · linarith [le_abs_self b, abs_nonneg a, hx.2]

private theorem tendsto_gaussian_horizontal {f : ℂ → ℂ} {a b C D ε : ℝ}
    (hab : a ≤ b) (hC : 0 ≤ C) (hε : 0 < ε)
    (hg : ∀ z ∈ strip a b, ‖f z‖ ≤ C * Real.exp (D * |z.im|))
    {s : ℝ} (hs : |s| = 1) :
    Tendsto (fun T : ℝ => ∫ x : ℝ in a..b,
      gaussian ε ((x : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I) *
        f ((x : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)) atTop (𝓝 0) := by
  let K := |a| + |b|
  let B (T : ℝ) := C * Real.exp (ε * K ^ 2 - (ε / 2) * T)
  have hlinear : Tendsto (fun T : ℝ => ε * K ^ 2 - (ε / 2) * T) atTop atBot := by
    apply tendsto_atBot.2
    intro M
    filter_upwards [eventually_ge_atTop ((ε * K ^ 2 - M) / (ε / 2))] with T hT
    exact sub_le_iff_le_add'.mpr (by
      have h := (div_le_iff₀ (by positivity : 0 < ε / 2)).mp hT
      linarith)
  have hB : Tendsto (fun T : ℝ => B T * |b - a|) atTop (𝓝 0) := by
    simpa [B] using ((Real.tendsto_exp_atBot.comp hlinear).const_mul C).mul_const |b - a|
  apply squeeze_zero_norm' _ hB
  filter_upwards [eventually_ge_atTop (max (1 : ℝ) (2 * D / ε))] with T hT
  have hT₁ : 1 ≤ T := (le_max_left _ _).trans hT
  have hT₀ : 0 ≤ T := zero_le_one.trans hT₁
  apply intervalIntegral.norm_integral_le_of_norm_le_const
  intro x hx
  have hx' : x ∈ Icc a b := by
    rw [uIoc_of_le hab] at hx
    exact Ioc_subset_Icc_self hx
  let z : ℂ := (x : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I
  have hz : z ∈ strip a b := by simpa [z, strip] using hx'
  have hzim : z.im = s * T := by simp [z]
  have hTm : |s * T| = T := by rw [abs_mul, hs, one_mul, abs_of_nonneg hT₀]
  have hsq : (s * T) ^ 2 = T ^ 2 := by rw [← sq_abs (s * T), hTm]
  have hx₂ : x ^ 2 ≤ K ^ 2 := by
    rw [← sq_abs x]
    exact pow_le_pow_left₀ (abs_nonneg _) (abs_le_strip_size hx') _
  have hDT : D * T ≤ (ε / 2) * T ^ 2 := by
    have h := (div_le_iff₀ hε).mp ((le_max_right _ _).trans hT)
    have h' : D ≤ (ε / 2) * T := by linarith
    nlinarith [mul_le_mul_of_nonneg_right h' hT₀]
  have hT₂ : T ≤ T ^ 2 := by nlinarith [mul_nonneg (sub_nonneg.mpr hT₁) hT₀]
  calc
    ‖gaussian ε z * f z‖ ≤ Real.exp (ε * (x ^ 2 - (s * T) ^ 2)) *
        (C * Real.exp (D * |z.im|)) := by
      rw [norm_mul, norm_gaussian]
      exact mul_le_mul_of_nonneg_left (hg z hz) (Real.exp_nonneg _)
    _ = C * Real.exp (ε * (x ^ 2 - T ^ 2) + D * T) := by
      rw [hsq, hzim, hTm, Real.exp_add]
      ring
    _ ≤ B T := by
      apply mul_le_mul_of_nonneg_left _ hC
      apply Real.exp_le_exp.mpr
      nlinarith [mul_le_mul_of_nonneg_left hx₂ hε.le,
        mul_le_mul_of_nonneg_left hT₂ (show 0 ≤ ε / 2 by positivity)]

/-- The Gaussian-regularized vertical integral is independent of the real
part inside a strip. Both horizontal integrals are proved to vanish. -/
private theorem gaussian_vertical_integral_eq {f : ℂ → ℂ} {a b C D ε : ℝ}
    (hab : a ≤ b) (hC : 0 ≤ C) (hε : 0 < ε)
    (hd : DifferentiableOn ℂ f (strip a b))
    (hg : ∀ z ∈ strip a b, ‖f z‖ ≤ C * Real.exp (D * |z.im|))
    (ha : Integrable (fun t : ℝ => f ((a : ℂ) + (t : ℂ) * Complex.I)))
    (hb : Integrable (fun t : ℝ => f ((b : ℂ) + (t : ℂ) * Complex.I))) :
    (∫ t : ℝ, gaussian ε ((a : ℂ) + (t : ℂ) * Complex.I) *
      f ((a : ℂ) + (t : ℂ) * Complex.I)) =
      ∫ t : ℝ, gaussian ε ((b : ℂ) + (t : ℂ) * Complex.I) *
        f ((b : ℂ) + (t : ℂ) * Complex.I) := by
  let G (z : ℂ) := gaussian ε z * f z
  let V (x T : ℝ) := ∫ y : ℝ in -T..T, G ((x : ℂ) + (y : ℂ) * Complex.I)
  let H (s T : ℝ) := ∫ x : ℝ in a..b, G ((x : ℂ) + ((s * T : ℝ) : ℂ) * Complex.I)
  let L (x : ℝ) := ∫ y : ℝ, G ((x : ℂ) + (y : ℂ) * Complex.I)
  have hG : DifferentiableOn ℂ G (strip a b) := by
    apply DifferentiableOn.mul _ hd
    apply Differentiable.differentiableOn
    unfold gaussian
    fun_prop
  have hVa : Tendsto (V a) atTop (𝓝 (L a)) :=
    intervalIntegral_tendsto_integral (integrable_gaussian_vertical hε.le ha)
      tendsto_neg_atTop_atBot tendsto_id
  have hVb : Tendsto (V b) atTop (𝓝 (L b)) :=
    intervalIntegral_tendsto_integral (integrable_gaussian_vertical hε.le hb)
      tendsto_neg_atTop_atBot tendsto_id
  have hH (s : ℝ) (hs : |s| = 1) : Tendsto (H s) atTop (𝓝 0) :=
    tendsto_gaussian_horizontal hab hC hε hg hs
  have hrect : ∀ T : ℝ, H (-1) T - H 1 T + Complex.I * V b T - Complex.I * V a T = 0 := by
    intro T
    let z₁ : ℂ := (a : ℂ) + ((-T : ℝ) : ℂ) * Complex.I
    let z₂ : ℂ := (b : ℂ) + (T : ℂ) * Complex.I
    have hr₁ : z₁.re = a := by simp [z₁]
    have hi₁ : z₁.im = -T := by simp [z₁]
    have hr₂ : z₂.re = b := by simp [z₂]
    have hi₂ : z₂.im = T := by simp [z₂]
    have hd' : DifferentiableOn ℂ G
        (Complex.reProdIm (uIcc z₁.re z₂.re) (uIcc z₁.im z₂.im)) := by
      apply hG.mono
      intro z hz
      have h := (Complex.mem_reProdIm.mp hz).1
      simpa [strip, hr₁, hr₂, uIcc_of_le hab] using h
    have he := Complex.integral_boundary_rect_eq_zero_of_differentiableOn G z₁ z₂ hd'
    simpa only [H, V, hr₁, hr₂, hi₁, hi₂, smul_eq_mul, neg_one_mul, one_mul] using he
  have ht : Tendsto (fun T : ℝ => H (-1) T - H 1 T + Complex.I * V b T - Complex.I * V a T)
      atTop (𝓝 (Complex.I * L b - Complex.I * L a)) := by
    simpa only [sub_self, zero_add] using
      (((hH (-1) (by norm_num)).sub (hH 1 (by norm_num))).add
        (hVb.const_mul Complex.I)).sub (hVa.const_mul Complex.I)
  have he := tendsto_nhds_unique ht
    ((tendsto_const_nhds : Tendsto (fun _ : ℝ => (0 : ℂ)) atTop (𝓝 0)).congr
      (fun T => (hrect T).symm))
  have he' : L b = L a :=
    mul_left_cancel₀ Complex.I_ne_zero (sub_eq_zero.mp he)
  exact he'.symm

private theorem tendsto_regularized_vertical {f : ℂ → ℂ} {x : ℝ}
    (hf : Integrable (fun t : ℝ => f ((x : ℂ) + (t : ℂ) * Complex.I))) :
    Tendsto (fun n : ℕ => ∫ t : ℝ,
      gaussian (1 / ((n : ℝ) + 1)) ((x : ℂ) + (t : ℂ) * Complex.I) *
        f ((x : ℂ) + (t : ℂ) * Complex.I))
      atTop (𝓝 (∫ t : ℝ, f ((x : ℂ) + (t : ℂ) * Complex.I))) := by
  apply tendsto_integral_of_dominated_convergence
    (fun t : ℝ => Real.exp (x ^ 2) * ‖f ((x : ℂ) + (t : ℂ) * Complex.I)‖)
  · intro n
    exact (integrable_gaussian_vertical (by positivity) hf).aestronglyMeasurable
  · exact hf.norm.const_mul _
  · intro n
    filter_upwards [] with t
    rw [norm_mul, norm_gaussian]
    have hn : (1 : ℝ) / ((n : ℝ) + 1) ≤ 1 :=
      (div_le_one (by positivity)).mpr (le_add_of_nonneg_left (Nat.cast_nonneg n))
    exact mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr (by
      calc
        _ ≤ (1 / ((n : ℝ) + 1)) * x ^ 2 :=
          mul_le_mul_of_nonneg_left (sub_le_self _ (sq_nonneg _)) (by positivity)
        _ ≤ _ := mul_le_of_le_one_left (sq_nonneg _) hn)) (norm_nonneg _)
  · filter_upwards [] with t
    let z : ℂ := (x : ℂ) + (t : ℂ) * Complex.I
    have h : Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) atTop (𝓝 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    have hg : Continuous (fun ε : ℝ => gaussian ε z * f z) := by
      unfold gaussian
      exact (Complex.continuous_exp.comp (Complex.continuous_ofReal.mul_const (z ^ 2))).mul_const (f z)
    have hc : ContinuousAt (fun ε : ℝ => gaussian ε z * f z) 0 := hg.continuousAt
    have hlim : Tendsto (fun n : ℕ => gaussian (1 / ((n : ℝ) + 1)) z * f z) atTop
        (𝓝 (gaussian 0 z * f z)) := hc.tendsto.comp h
    have hz : gaussian 0 z = 1 := by simp [gaussian]
    simpa only [hz, one_mul] using hlim

/-- **Vertical contour translation with exponential strip growth.** It is
enough for the two line restrictions to be integrable. Gaussian regularization
controls the horizontal sides, then dominated convergence removes it on the
two vertical lines. No global strip integrability is assumed. -/
theorem vertical_integral_eq_of_exp_growth {f : ℂ → ℂ} {a b C D : ℝ}
    (hab : a ≤ b) (hC : 0 ≤ C)
    (hd : DifferentiableOn ℂ f (strip a b))
    (hg : ∀ z ∈ strip a b, ‖f z‖ ≤ C * Real.exp (D * |z.im|))
    (ha : Integrable (fun t : ℝ => f ((a : ℂ) + (t : ℂ) * Complex.I)))
    (hb : Integrable (fun t : ℝ => f ((b : ℂ) + (t : ℂ) * Complex.I))) :
    (∫ t : ℝ, f ((a : ℂ) + (t : ℂ) * Complex.I)) =
      ∫ t : ℝ, f ((b : ℂ) + (t : ℂ) * Complex.I) := by
  apply tendsto_nhds_unique (tendsto_regularized_vertical ha)
  exact (tendsto_regularized_vertical hb).congr fun n =>
    (gaussian_vertical_integral_eq hab hC (by positivity) hd hg ha hb).symm

private theorem norm_Gamma_on_strip {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) {z : ℂ}
    (hz : z ∈ strip a b) : ‖Complex.Gamma z‖ ≤ Real.Gamma a + Real.Gamma b := by
  have hb : 0 < b := ha.trans_le hab
  have hz' : a ≤ z.re ∧ z.re ≤ b := hz
  rw [Complex.Gamma_eq_integral (ha.trans_le hz'.1), Complex.GammaIntegral,
    Real.Gamma_eq_integral ha, Real.Gamma_eq_integral hb]
  have hi₁ := Real.GammaIntegral_convergent ha
  have hi₂ := Real.GammaIntegral_convergent hb
  rw [← integral_add hi₁ hi₂]
  apply norm_integral_le_of_norm_le (hi₁.add hi₂)
  filter_upwards [ae_restrict_mem (μ := volume) (measurableSet_Ioi (a := (0 : ℝ)))] with x hx
  have hx₀ : 0 < x := hx
  rw [norm_mul, Complex.norm_of_nonneg (Real.exp_nonneg (-x)),
    Complex.norm_cpow_eq_rpow_re_of_pos hx₀, Complex.sub_re, Complex.one_re]
  by_cases hx₁ : x ≤ 1
  · have h := Real.rpow_le_rpow_of_exponent_ge hx₀ hx₁ (sub_le_sub_right hz'.1 1)
    exact (mul_le_mul_of_nonneg_left h (Real.exp_nonneg _)).trans
      (le_add_of_nonneg_right (mul_nonneg (Real.exp_nonneg _) (Real.rpow_nonneg hx₀.le _)))
  · have h := Real.rpow_le_rpow_of_exponent_le (le_of_lt (lt_of_not_ge hx₁))
      (sub_le_sub_right hz'.2 1)
    exact (mul_le_mul_of_nonneg_left h (Real.exp_nonneg _)).trans
      (le_add_of_nonneg_left (mul_nonneg (Real.exp_nonneg _) (Real.rpow_nonneg hx₀.le _)))

private theorem trig_exp_bound (z : ℂ) :
    ‖Complex.cos z‖ ≤ Real.exp |z.im| ∧ ‖Complex.sin z‖ ≤ Real.exp |z.im| := by
  have hplus : ‖Complex.exp (z * Complex.I)‖ ≤ Real.exp |z.im| := by
    rw [Complex.norm_exp, Real.exp_le_exp]
    simpa [Complex.mul_re] using neg_le_abs z.im
  have hminus : ‖Complex.exp (-z * Complex.I)‖ ≤ Real.exp |z.im| := by
    rw [Complex.norm_exp, Real.exp_le_exp]
    simpa [Complex.mul_re] using le_abs_self z.im
  constructor
  · have htwo : ‖(2 : ℂ)‖ = 2 := by norm_num
    rw [Complex.cos, norm_div, htwo]
    exact (div_le_iff₀ (by norm_num)).mpr ((norm_add_le _ _).trans (by linarith))
  · have htwo : ‖(2 : ℂ)‖ = 2 := by norm_num
    rw [Complex.sin, norm_div, norm_mul, Complex.norm_I, mul_one, htwo]
    exact (div_le_iff₀ (by norm_num)).mpr ((norm_sub_le _ _).trans (by linarith))

/-- Holomorphic version of the archimedean quotient on the half-plane
`Re(s) > 0`, using the reflection formulas for even and odd characters. -/
noncomputable def gammaKernel (odd : Bool) (z : ℂ) : ℂ :=
  Complex.Gammaℂ z *
    (if odd then Complex.sin ((Real.pi : ℂ) * z / 2) else Complex.cos ((Real.pi : ℂ) * z / 2))

theorem gammaKernel_eq_ratio (odd : Bool) {z : ℂ} (hz : 0 < z.re) :
    gammaKernel odd z = Complex.Gammaℝ (z + (if odd then 1 else 0)) /
      Complex.Gammaℝ (1 - z + (if odd then 1 else 0)) := by
  have hneg (n : ℕ) : z ≠ -(n : ℂ) := by
    intro he
    rw [he, Complex.neg_re, Complex.natCast_re] at hz
    exact (not_lt_of_ge (neg_nonpos.mpr (Nat.cast_nonneg n))) hz
  cases odd
  · simp only [gammaKernel, Bool.false_eq_true, ite_false, add_zero]
    symm
    apply Complex.Gammaℝ_div_Gammaℝ_one_sub
    intro n he
    exact hneg (2 * n + 1) (by simpa using he)
  · simp only [gammaKernel, ite_true]
    rw [show 1 - z + 1 = 2 - z by ring,
      div_eq_mul_inv (Complex.Gammaℝ (z + 1)) (Complex.Gammaℝ (2 - z)),
      Complex.inv_Gammaℝ_two_sub hneg]
    have hΓ : Complex.Gammaℝ (z + 1) ≠ 0 :=
      Complex.Gammaℝ_ne_zero_of_re_pos (by simp; linarith)
    rw [← mul_assoc, mul_comm (Complex.Gammaℝ (z + 1)), mul_assoc,
      mul_inv_cancel₀ hΓ, mul_one]

theorem differentiableOn_gammaKernel (odd : Bool) {a b : ℝ} (ha : 0 < a) :
    DifferentiableOn ℂ (gammaKernel odd) (strip a b) := by
  intro z hz
  have hz' : 0 < z.re := ha.trans_le ((show a ≤ z.re ∧ z.re ≤ b from hz).1)
  have hg : DifferentiableAt ℂ Complex.Gamma z := Complex.differentiableAt_Gamma _ (fun n h => by
    rw [h, Complex.neg_re, Complex.natCast_re] at hz'
    have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith)
  have hpow : DifferentiableAt ℂ (fun u : ℂ => (2 * (Real.pi : ℂ)) ^ (-u)) z :=
    (differentiableAt_id.neg).const_cpow
      (Or.inl (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)))
  have HΓ : DifferentiableAt ℂ Complex.Gammaℂ z := by
    unfold Complex.Gammaℂ
    exact (hpow.const_mul 2).mul hg
  have harg : DifferentiableAt ℂ (fun u : ℂ => (Real.pi : ℂ) * u / 2) z :=
    (differentiableAt_id.const_mul (Real.pi : ℂ)).div_const 2
  cases odd
  · exact (HΓ.mul harg.ccos).differentiableWithinAt
  · exact (HΓ.mul harg.csin).differentiableWithinAt

/-- The gamma quotient has a uniform exponential bound on any closed strip
with positive left edge. Euler's integral suffices for the Gamma factor. -/
theorem gammaKernel_exp_growth (odd : Bool) {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z ∈ strip a b,
      ‖gammaKernel odd z‖ ≤ C * Real.exp (Real.pi / 2 * |z.im|) := by
  let C := 2 * (Real.Gamma a + Real.Gamma b)
  have hΓ := (Real.Gamma_pos_of_pos ha).le
  have hΓ' := (Real.Gamma_pos_of_pos (ha.trans_le hab)).le
  refine ⟨C, by dsimp only [C]; positivity, fun z hz => ?_⟩
  have hz' : 0 < z.re := ha.trans_le ((show a ≤ z.re ∧ z.re ≤ b from hz).1)
  have hbase : 1 ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
  have hpow : ‖(2 * (Real.pi : ℂ)) ^ (-z)‖ ≤ 1 := by
    rw [← Complex.ofReal_ofNat, ← Complex.ofReal_mul,
      Complex.norm_cpow_eq_rpow_re_of_pos (by positivity), Complex.neg_re]
    exact Real.rpow_le_one_of_one_le_of_nonpos hbase (neg_nonpos.mpr hz'.le)
  have hIm : ((Real.pi : ℂ) * z / 2).im = Real.pi / 2 * z.im := by
    rw [Complex.div_ofNat_im]
    simp [Complex.mul_im]
    ring
  have harg : |((Real.pi : ℂ) * z / 2).im| = Real.pi / 2 * |z.im| := by
    rw [hIm, abs_mul, abs_of_nonneg (by positivity : 0 ≤ Real.pi / 2)]
  have hTrig : ‖if odd then Complex.sin ((Real.pi : ℂ) * z / 2)
      else Complex.cos ((Real.pi : ℂ) * z / 2)‖ ≤ Real.exp (Real.pi / 2 * |z.im|) := by
    rw [← harg]
    cases odd
    · exact (trig_exp_bound _).1
    · exact (trig_exp_bound _).2
  have hG : ‖Complex.Gammaℂ z‖ ≤ C := by
    rw [Complex.Gammaℂ_def, norm_mul, norm_mul]
    have htwo : ‖(2 : ℂ)‖ = 2 := by norm_num
    rw [htwo]
    calc
      _ ≤ (2 : ℝ) * 1 * (Real.Gamma a + Real.Gamma b) :=
        mul_le_mul (mul_le_mul_of_nonneg_left hpow (by positivity))
          (norm_Gamma_on_strip ha hab hz) (norm_nonneg _) (by positivity)
      _ = _ := by simp [C]
  rw [gammaKernel, norm_mul]
  exact mul_le_mul hG hTrig (norm_nonneg _) (by dsimp only [C]; positivity)

private theorem differentiable_mellin_supported {g : ℝ → ℂ}
    (hg : Continuous g) (hs : ∀ x ∉ Icc (1 : ℝ) 4, g x = 0) :
    Differentiable ℂ (mellin g) := by
  intro s
  apply mellin_differentiableAt_of_isBigO_rpow (a := s.re + 1) (b := s.re - 1)
  · exact hg.continuousOn.locallyIntegrableOn measurableSet_Ioi
  · apply Asymptotics.IsBigO.of_bound 0
    filter_upwards [eventually_gt_atTop (4 : ℝ)] with x hx
    rw [hs x (fun h => hx.not_ge h.2), norm_zero, zero_mul]
  · linarith
  · apply Asymptotics.IsBigO.of_bound 0
    have h₀ : Iio (1 : ℝ) ∈ 𝓝[>] (0 : ℝ) :=
      mem_nhdsWithin_of_mem_nhds (Iio_mem_nhds zero_lt_one)
    filter_upwards [h₀] with x hx
    rw [hs x (fun h => (show x < 1 from hx).not_ge h.1), norm_zero, zero_mul]
  · linarith

private theorem mellin_supported_strip_bound {g : ℝ → ℂ} (gcont : Continuous g)
    (gsupp : ∀ x ∉ Icc (1 : ℝ) 4, g x = 0) (b : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, z.re ≤ b → ‖mellin g z‖ ≤ C := by
  obtain ⟨K, hK⟩ := (isCompact_Icc (a := (1 : ℝ)) (b := 4)).exists_bound_of_continuousOn
    gcont.continuousOn
  let e := max 0 (b - 1)
  let C₀ := (4 : ℝ) ^ e * max K 0
  let C := ∫ _x : ℝ in Icc (1 : ℝ) 4, C₀
  have hC₀ : 0 ≤ C₀ := by dsimp only [C₀]; positivity
  refine ⟨C, integral_nonneg (fun _ => hC₀), fun z hz => ?_⟩
  have hbound (x : ℝ) (hx : x ∈ Icc (1 : ℝ) 4) :
      ‖(x : ℂ) ^ (z - 1) • g x‖ ≤ C₀ := by
    have hx₀ : 0 < x := zero_lt_one.trans_le hx.1
    have hp : x ^ (z.re - 1) ≤ (4 : ℝ) ^ e := by
      calc
        _ ≤ x ^ e := Real.rpow_le_rpow_of_exponent_le hx.1
          ((sub_le_sub_right hz 1).trans (le_max_right _ _))
        _ ≤ _ := Real.rpow_le_rpow hx₀.le hx.2 (le_max_left _ _)
    rw [norm_smul, Complex.norm_cpow_eq_rpow_re_of_pos hx₀, Complex.sub_re, Complex.one_re]
    exact mul_le_mul hp ((hK x hx).trans (le_max_left _ _)) (norm_nonneg _) (by positivity)
  have he : mellin g z = ∫ x : ℝ in Icc (1 : ℝ) 4, (x : ℂ) ^ (z - 1) • g x := by
    unfold mellin
    exact setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi
      (fun _ hx => zero_lt_one.trans_le hx.1) (fun x hx => by rw [gsupp x hx.2, smul_zero])
  rw [he]
  apply norm_integral_le_of_norm_le
  · exact integrableOn_const (measure_Icc_lt_top.ne)
  · filter_upwards [ae_restrict_mem (μ := volume) (measurableSet_Icc (a := (1 : ℝ)) (b := 4))]
      with x hx
    exact hbound x hx

/-- The per-term Gamma–Mellin kernel after the primitive functional equation.
For the dual index `n`, the positive parameter `x` is `N*n/q`. -/
noncomputable def dualKernel (odd : Bool) (x : ℝ) (g : ℝ → ℂ) (s₀ z : ℂ) : ℂ :=
  (x : ℂ) ^ (-z) * gammaKernel odd z * mellin g (s₀ - z)

/-- Contour shift for the actual per-term Gamma–Mellin kernel. The weight
must be continuous and supported in `[1,4]`; only endpoint L¹ remains
to be supplied by the vertical bounds. The strip growth, holomorphy,
and disappearance of the horizontal integrals are not hypotheses. -/
theorem dualKernel_vertical_integral_eq (odd : Bool) {x a b : ℝ} (hx : 0 < x)
    (ha : 0 < a) (hab : a ≤ b) {g : ℝ → ℂ} (hg : Continuous g)
    (gsupp : ∀ u ∉ Icc (1 : ℝ) 4, g u = 0) (s₀ : ℂ)
    (hL : Integrable (fun t : ℝ => dualKernel odd x g s₀ ((a : ℂ) + (t : ℂ) * Complex.I)))
    (hR : Integrable (fun t : ℝ => dualKernel odd x g s₀ ((b : ℂ) + (t : ℂ) * Complex.I))) :
    (∫ t : ℝ, dualKernel odd x g s₀ ((a : ℂ) + (t : ℂ) * Complex.I)) =
      ∫ t : ℝ, dualKernel odd x g s₀ ((b : ℂ) + (t : ℂ) * Complex.I) := by
  obtain ⟨CΓ, hCΓ, hΓ⟩ := gammaKernel_exp_growth odd ha hab
  obtain ⟨CM, hCM, hM⟩ := mellin_supported_strip_bound hg gsupp (s₀.re - a)
  let Cx := x ^ (-a) + x ^ (-b)
  have hCx : 0 ≤ Cx := by dsimp only [Cx]; positivity
  apply vertical_integral_eq_of_exp_growth hab
    (C := Cx * CΓ * CM) (D := Real.pi / 2) (by positivity) _ _ hL hR
  · have hpow : Differentiable ℂ (fun z : ℂ => (x : ℂ) ^ (-z)) := by
      intro z
      exact (differentiableAt_id.neg).const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr hx.ne'))
    have hMellin : Differentiable ℂ (fun z : ℂ => mellin g (s₀ - z)) :=
      (differentiable_mellin_supported hg gsupp).comp ((differentiable_const s₀).sub differentiable_id)
    exact (hpow.differentiableOn.mul (differentiableOn_gammaKernel odd ha)).mul
      hMellin.differentiableOn
  · intro z hz
    have hz' : a ≤ z.re ∧ z.re ≤ b := hz
    have hp : ‖(x : ℂ) ^ (-z)‖ ≤ Cx := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hx, Complex.neg_re]
      by_cases h : 1 ≤ x
      · exact (Real.rpow_le_rpow_of_exponent_le h (neg_le_neg hz'.1)).trans
          (le_add_of_nonneg_right (by positivity))
      · exact (Real.rpow_le_rpow_of_exponent_ge hx (le_of_lt (lt_of_not_ge h))
            (neg_le_neg hz'.2)).trans (le_add_of_nonneg_left (by positivity))
    have hm : ‖mellin g (s₀ - z)‖ ≤ CM :=
      hM _ (by rw [Complex.sub_re]; exact sub_le_sub_left hz'.1 _)
    rw [dualKernel, norm_mul, norm_mul]
    calc
      _ ≤ (Cx * (CΓ * Real.exp (Real.pi / 2 * |z.im|))) * CM :=
        mul_le_mul (mul_le_mul hp (hΓ z hz) (norm_nonneg _) hCx) hm (norm_nonneg _)
          (by positivity)
      _ = _ := by ring

end ShortAPContourShift

end

section

namespace ShortAPComplementSampling

open scoped BigOperators

abbrev AF := ArithmeticFunction ℂ

private theorem convolution_support {f g : AF} {A B : ℕ}
    (hf : ∀ n > A, f n = 0) (hg : ∀ n > B, g n = 0) :
    ∀ n > A*B, (f*g) n = 0 := by
  intro n hn
  rw [ArithmeticFunction.mul_apply]
  refine Finset.sum_eq_zero fun p hp => ?_
  by_cases ha : A < p.1
  · rw [hf _ ha, zero_mul]
  by_cases hb : B < p.2
  · rw [hg _ hb, mul_zero]
  exact (not_lt_of_ge ((Nat.mem_divisorsAntidiagonal.mp hp).1 ▸
    Nat.mul_le_mul (le_of_not_gt ha) (le_of_not_gt hb))) hn |>.elim

theorem convolution_product_support {ι : Type*} (s : Finset ι) (N : ι → ℕ) (f : ι → AF)
    (hN : ∀ i ∈ s, ∀ n > N i, f i n = 0) :
    ∀ n > ∏ i ∈ s, N i, (∏ i ∈ s, f i) n = 0 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    intro n hn
    rw [Finset.prod_empty] at hn ⊢
    exact ArithmeticFunction.one_apply_ne (Nat.ne_of_gt hn)
  | insert i s hi ih =>
    simp only [Finset.prod_insert hi]
    exact convolution_support (hN i (Finset.mem_insert_self _ _))
      (ih (fun j hj => hN j (Finset.mem_insert_of_mem hj)))

private theorem convolution_coeff {f g : AF} {a b d e : ℕ}
    (hf : ∀ n : ℕ, 1 ≤ n → ‖f n‖ ≤ ((ArithmeticFunction.zeta^a) n : ℝ) * (Real.log n)^d)
    (hg : ∀ n : ℕ, 1 ≤ n → ‖g n‖ ≤ ((ArithmeticFunction.zeta^b) n : ℝ) * (Real.log n)^e)
    (n : ℕ) : ‖(f*g) n‖ ≤ ((ArithmeticFunction.zeta^(a+b)) n : ℝ) * (Real.log n)^(d+e) := by
  simp only [pow_add ArithmeticFunction.zeta, ArithmeticFunction.mul_apply, Nat.cast_sum, Nat.cast_mul]
  calc
    ‖∑ p ∈ n.divisorsAntidiagonal, f p.1 * g p.2‖ ≤
        ∑ p ∈ n.divisorsAntidiagonal, ‖f p.1 * g p.2‖ := norm_sum_le _ _
    _ ≤ ∑ p ∈ n.divisorsAntidiagonal, (((ArithmeticFunction.zeta^a) p.1 : ℝ) *
        ((ArithmeticFunction.zeta^b) p.2 : ℝ)) * (Real.log n)^(d+e) := by
      refine Finset.sum_le_sum fun p hp => ?_
      obtain ⟨hm, hn⟩ := Nat.mem_divisorsAntidiagonal.mp hp
      have hp₁ : 0 < p.1 := Nat.pos_of_ne_zero (fun hp' => hn (by rw [← hm, hp', zero_mul]))
      have hp₂ : 0 < p.2 := Nat.pos_of_ne_zero (fun hp' => hn (by rw [← hm, hp', mul_zero]))
      have h₁ : 1 ≤ (p.1 : ℝ) := by exact_mod_cast hp₁
      have h₂ : 1 ≤ (p.2 : ℝ) := by exact_mod_cast hp₂
      have hm₁ : p.1 ≤ n := Nat.le_of_dvd (Nat.pos_of_ne_zero hn) ⟨p.2, hm.symm⟩
      have hm₂ : p.2 ≤ n := Nat.le_of_dvd (Nat.pos_of_ne_zero hn) ⟨p.1, by rw [← hm, mul_comm]⟩
      have hl₁ : Real.log (p.1 : ℝ) ≤ Real.log n := Real.log_le_log (by linarith) (by exact_mod_cast hm₁)
      have hl₂ : Real.log (p.2 : ℝ) ≤ Real.log n := Real.log_le_log (by linarith) (by exact_mod_cast hm₂)
      have hleft := (hf p.1 hp₁).trans (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (Real.log_nonneg h₁) hl₁ d) (Nat.cast_nonneg _))
      have hright := (hg p.2 hp₂).trans (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (Real.log_nonneg h₂) hl₂ e) (Nat.cast_nonneg _))
      rw [norm_mul, pow_add]
      exact (mul_le_mul hleft hright (norm_nonneg _) (by positivity)).trans_eq (by ring)
    _ = _ := by rw [Finset.sum_mul]

/-- The product of finitely many bounded/logarithmic coefficient sequences has
the expected divisor budget and the sum of their logarithmic exponents. -/
theorem convolution_product_coeff {ι : Type*} (s : Finset ι) (f : ι → AF) (d : ι → ℕ)
    (hf : ∀ i ∈ s, ∀ n : ℕ, 1 ≤ n → ‖f i n‖ ≤ (Real.log n)^d i) (n : ℕ) :
    ‖(∏ i ∈ s, f i) n‖ ≤ ((ArithmeticFunction.zeta^s.card) n : ℝ) *
      (Real.log n)^(∑ i ∈ s, d i) := by
  classical
  induction s using Finset.induction_on generalizing n with
  | empty =>
    by_cases hn : n = 1 <;> simp [hn]
  | insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.card_insert_of_notMem hi, Finset.sum_insert hi, add_comm s.card]
    apply convolution_coeff _ (fun n _ => ih (fun j hj => hf j (Finset.mem_insert_of_mem hj)) n)
    intro m hm
    simpa [ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt hm)] using
      hf i (Finset.mem_insert_self _ _) m hm

private theorem hasSum_factor (N : ℕ) (f : AF) {q : ℕ} (χ : DirichletCharacter ℂ q) (z : ℂ)
    (hf : ∀ n > N, f n = 0) :
    LSeriesHasSum (((χ ·) : ℕ → ℂ) * f) z (ShortAPFactorSampling.factor N f χ z) := by
  let a : ℕ → ℂ := ((χ ·) : ℕ → ℂ) * f
  have hz : ∀ n ∉ Finset.Icc 1 N, LSeries.term a z n = 0 := by
    intro n hn
    by_cases hn0 : n = 0
    · subst n
      simp
    have hnN : N < n := by
      by_contra! hh
      exact hn (Finset.mem_Icc.mpr ⟨Nat.pos_of_ne_zero hn0, hh⟩)
    simp [LSeries.term_of_ne_zero hn0, a, hf n hnN]
  have heq : (∑ n ∈ Finset.Icc 1 N, LSeries.term a z n) =
      ShortAPFactorSampling.factor N f χ z := by
    apply Finset.sum_congr rfl
    intro n hn
    simp [LSeries.term_of_ne_zero (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1), a, mul_comm]
  rw [← heq]
  exact hasSum_sum_of_ne_finset_zero hz

theorem factor_convolution_product {ι : Type*} (s : Finset ι) (N : ι → ℕ) (f : ι → AF)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (z : ℂ) (hf : ∀ i ∈ s, ∀ n > N i, f i n = 0) :
    ShortAPFactorSampling.factor (∏ i ∈ s, N i) (∏ i ∈ s, f i) χ z =
      ∏ i ∈ s, ShortAPFactorSampling.factor (N i) (f i) χ z := by
  classical
  have h : LSeriesHasSum (((χ ·) : ℕ → ℂ) * (∏ i ∈ s, f i : AF)) z
      (∏ i ∈ s, ShortAPFactorSampling.factor (N i) (f i) χ z) := by
    induction s using Finset.induction_on with
    | empty =>
      have hunit := hasSum_factor 1 (1 : AF) χ z (by
        intro n hn
        exact ArithmeticFunction.one_apply_ne (Nat.ne_of_gt hn))
      simpa [ShortAPFactorSampling.factor, ArithmeticFunction.one_apply] using hunit
    | insert i s hi ih =>
      have h₁ := hasSum_factor (N i) (f i) χ z (hf i (Finset.mem_insert_self _ _))
      have h₂ := ih (fun j hj => hf j (Finset.mem_insert_of_mem hj))
      have hm := h₁.convolution h₂
      rw [DirichletCharacter.mul_convolution_distrib, ArithmeticFunction.coe_mul] at hm
      simpa only [Finset.prod_insert hi] using hm
  have hfinite := hasSum_factor (∏ i ∈ s, N i) (∏ i ∈ s, f i) χ z
    (convolution_product_support s N f hf)
  exact hfinite.LSeries_eq.symm.trans h.LSeries_eq

noncomputable def lengthConstant (c C : ℝ) : ℝ := c^8 * 4^8 * C

theorem lengthConstant_ge_one {c C : ℝ} (hc : 1 ≤ c) (hC : 1 ≤ C) :
    1 ≤ lengthConstant c C := by
  unfold lengthConstant
  exact one_le_mul_of_one_le_of_one_le
    (one_le_mul_of_one_le_of_one_le (one_le_pow₀ hc) (one_le_pow₀ (by norm_num))) hC

theorem complement_support_limit {ι : Type*} [DecidableEq ι] {s a : Finset ι} {j : ι}
    (hj : j ∈ s) (ha : a ⊆ s.erase j) (hs : s.card ≤ 8) (N : ι → ℕ) (M : ι → ℝ)
    {x c C : ℝ} (hc : 1 ≤ c)
    (hM : ∀ i ∈ s, (1:ℝ)/4 ≤ M i) (hNM : ∀ i ∈ s, (N i : ℝ) ≤ c*M i)
    (hprod : ∏ i ∈ s, M i ≤ C*x) :
    ((∏ i ∈ a, N i : ℕ) : ℝ) ≤ lengthConstant c C * (x / M j) := by
  have hs' : a ⊆ s := ha.trans (Finset.erase_subset _ _)
  have hc0 : 0 ≤ c := zero_le_one.trans hc
  have hM0 : ∀ i ∈ s, 0 ≤ M i := fun i hi => by linarith [hM i hi]
  have hj0 : 0 < M j := by linarith [hM j hj]
  have hp : ((∏ i ∈ a, N i : ℕ) : ℝ) ≤ c^8 * ∏ i ∈ a, M i := calc
    _ = ∏ i ∈ a, (N i : ℝ) := by rw [Nat.cast_prod]
    _ ≤ ∏ i ∈ a, c * M i :=
      Finset.prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) fun i hi => hNM i (hs' hi)
    _ = c^a.card * ∏ i ∈ a, M i := by rw [Finset.prod_mul_distrib, Finset.prod_const]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ hc ((Finset.card_le_card hs').trans hs))
      (Finset.prod_nonneg fun i hi => hM0 i (hs' hi))
  have hk := ShortAPFourthSection.active_product_length_le hj ha hM
  have hprod0 := Finset.prod_nonneg hM0
  rw [← mul_div_assoc]
  apply (le_div_iff₀ hj0).mpr
  calc
    ((∏ i ∈ a, N i : ℕ) : ℝ) * M j ≤ (c^8 * ∏ i ∈ a, M i) * M j :=
      mul_le_mul_of_nonneg_right hp hj0.le
    _ = c^8 * (M j * ∏ i ∈ a, M i) := by ring
    _ ≤ c^8 * ((4:ℝ)^s.card * ∏ i ∈ s, M i) := mul_le_mul_of_nonneg_left hk (pow_nonneg hc0 _)
    _ ≤ c^8 * ((4:ℝ)^8 * ∏ i ∈ s, M i) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right
        (pow_le_pow_right₀ (by norm_num) hs) hprod0) (pow_nonneg hc0 _)
    _ ≤ c^8 * ((4:ℝ)^8 * (C*x)) := by gcongr
    _ = lengthConstant c C * x := by unfold lengthConstant; ring

noncomputable def complementConstant (c C CHeight : ℝ) : ℝ :=
  let b := lengthConstant c C
  (36*Real.pi*(Real.pi+1)) * (b*CHeight) * (3:ℝ)^216 *
    (1+Real.log (2*b))^216 * ((2:ℝ)^8)^2

theorem complementConstant_nonneg {c C CHeight : ℝ} (hc : 1 ≤ c) (hC : 1 ≤ C)
    (hHeight : 1 ≤ CHeight) : 0 ≤ complementConstant c C CHeight := by
  unfold complementConstant
  have hb := lengthConstant_ge_one hc hC
  have hl : 0 ≤ Real.log (2 * lengthConstant c C) := Real.log_nonneg (by linarith)
  positivity

set_option maxRecDepth 4096 in
/-- Case 2 complementary-product estimate. Factors with amplitudes below 2
are removed before using the first large-values estimate. The bound is uniform
for at most eight factors and at most one logarithmic weight. -/
theorem sampled_complement_scales {ι : Type*} [DecidableEq ι] (s : Finset ι) {j : ι}
    (hj : j ∈ s) (hs : s.card ≤ 8) (N d : ι → ℕ) (M U : ι → ℝ) (f : ι → AF)
    {x H c C CHeight T : ℝ} (hx : Real.exp 1 ≤ x) (hH : 0 ≤ H) (hT : 1 ≤ T)
    (hc : 1 ≤ c) (hC : 1 ≤ C) (hHeight : 1 ≤ CHeight)
    (hM : ∀ i ∈ s, (1:ℝ)/4 ≤ M i) (hMj : 1 ≤ M j)
    (hNM : ∀ i ∈ s, (N i : ℝ) ≤ c*M i) (hprod : ∏ i ∈ s, M i ≤ C*x)
    (hN : ∀ i ∈ s, 1 ≤ N i) (hU : ∀ i ∈ s, 1 ≤ U i) (hd : ∑ i ∈ s, d i ≤ 1)
    (hSupport : ∀ i ∈ s, ∀ n > N i, f i n = 0)
    (hCoeff : ∀ i ∈ s, ∀ n : ℕ, 1 ≤ n → ‖f i n‖ ≤ (Real.log n)^d i)
    (Q : ℕ) (hQ : 1 ≤ Q) (hHT : (Q:ℝ)^2*T ≤ CHeight*H)
    (S : ShortAP.CharIndex → Finset ℝ) (hSep : ShortAPLargeValues.WellSpaced S)
    (hBand : ∀ χ ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S χ, |t| ≤ T)
    (hValues : ∀ χ ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S χ, ∀ i ∈ s,
      U i ≤ ‖ShortAPFactorSampling.factor (N i) (f i) χ.2 (1/2+(t:ℂ)*Complex.I)‖+1) :
    (∑ χ ∈ ShortAP.primitiveFamily Q, ((S χ).card : ℝ)) * (∏ i ∈ s, (U i)^2) ≤
      complementConstant c C CHeight * (x/M j+H) * (U j)^2 * (Real.log x)^216 := by
  let a := (s.erase j).filter (fun i => 2 ≤ U i)
  let B := ∏ i ∈ a, N i
  let F := ∏ i ∈ a, f i
  let r := ∑ i ∈ a, d i
  let e := 3*(a.card*a.card)+6*r+18
  let D := U j * (2:ℝ)^8
  let W := (∏ i ∈ s, U i) / D
  let R := ∑ χ ∈ ShortAP.primitiveFamily Q, ((S χ).card : ℝ)
  let b := lengthConstant c C
  let g := 1+Real.log (2*b)
  have ha : a ⊆ s.erase j := Finset.filter_subset _ _
  have hsub : a ⊆ s := ha.trans (Finset.erase_subset _ _)
  have heCard : (s.erase j).card ≤ 8 := (Finset.card_le_card (Finset.erase_subset _ _)).trans hs
  have haCard : a.card ≤ 8 := (Finset.card_le_card hsub).trans hs
  have hr : r ≤ 1 := (Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => Nat.zero_le _)).trans hd
  have he : e ≤ 216 := by
    have hh := Nat.mul_le_mul haCard haCard
    dsimp [e]
    omega
  have hB : 1 ≤ B := Finset.one_le_prod₀ fun i hi => hN i (hsub hi)
  have hBreal : (1:ℝ) ≤ B := by exact_mod_cast hB
  have hUjp : 0 < U j := zero_lt_one.trans_le (hU j hj)
  have hD : 0 < D := mul_pos hUjp (by positivity)
  have hW : 0 < W := div_pos (Finset.prod_pos fun i hi => zero_lt_one.trans_le (hU i hi)) hD
  have hSupport' : ∀ i ∈ a, ∀ n > N i, f i n = 0 := fun i hi => hSupport i (hsub hi)
  have hCoef' : ∀ n ∈ Finset.Icc 1 B,
      ‖F n‖ ≤ ((ArithmeticFunction.zeta^a.card) n : ℝ)*(Real.log n)^(r:ℝ) := by
    intro n _
    rw [Real.rpow_natCast]
    exact convolution_product_coeff a f d (fun i hi => hCoeff i (hsub hi)) n
  have hWval : ∀ χ ∈ ShortAP.primitiveFamily Q, ∀ t ∈ S χ, W ≤
      ‖∑ n ∈ Finset.Icc 1 B, F n * ShortAP.charValue χ n / (n:ℂ)^(1/2+(t:ℂ)*Complex.I)‖ := by
    intro χ hχ t ht
    let z : ℂ := 1/2+(t:ℂ)*Complex.I
    let P (i : ι) : ℂ := ShortAPFactorSampling.factor (N i) (f i) χ.2 z
    change W ≤ ‖ShortAPFactorSampling.factor B F χ.2 z‖
    rw [factor_convolution_product a N f χ.2 z hSupport']
    change W ≤ ‖∏ i ∈ a, P i‖
    have hActive := ShortAPFourthSection.norm_active_product_lower (s.erase j) U P
      (fun i hi => hU i (Finset.erase_subset _ _ hi))
      (fun i hi => hValues χ hχ t ht i (Finset.erase_subset _ _ hi))
    refine (div_le_iff₀ hD).mpr ?_
    rw [← Finset.mul_prod_erase s U hj]
    calc
      U j * ∏ i ∈ s.erase j, U i ≤ U j * ((2:ℝ)^(s.erase j).card * ‖∏ i ∈ a, P i‖) :=
        mul_le_mul_of_nonneg_left hActive (zero_le_one.trans (hU j hj))
      _ ≤ U j * ((2:ℝ)^8 * ‖∏ i ∈ a, P i‖) := mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) heCard) (norm_nonneg _)) hUjp.le
      _ = _ := by dsimp [D]; ring
  have hRaw := ShortAP.primitive_large_values_first B Q hB hQ T W hT hW a.card (r:ℝ)
    (Nat.cast_nonneg _) F hCoef' S hSep hBand hWval
  have hRaw' : R * W^2 ≤ (36*Real.pi*(Real.pi+1)) * ((B:ℝ)+(Q:ℝ)^2*T) *
      (Real.log (2*(B:ℝ)) * ((Real.log B)^(r:ℝ))^2 * (1+Real.log B)^(a.card*a.card)) := by
    apply (le_div_iff₀ (sq_pos_of_pos hW)).mp
    convert hRaw using 1
    ring
  have hExp : (e:ℝ) = 3*((a.card*a.card:ℕ):ℝ)+6*(r:ℝ)+18 := by simp [e]
  have hBudget := ShortAP.first_log_budget B a.card hB (r:ℝ) (Nat.cast_nonneg _)
  simp only [← hExp, Real.rpow_natCast] at hBudget
  have hx0 : 0 < x := (Real.exp_pos _).trans_le hx
  have hb : 1 ≤ b := lengthConstant_ge_one hc hC
  have hbp : 0 < b := zero_lt_one.trans_le hb
  have hCH0 : 0 ≤ CHeight := zero_le_one.trans hHeight
  have hlog : 1 ≤ Real.log x := by
    rw [← Real.log_exp 1]
    exact Real.log_le_log (Real.exp_pos _) hx
  have hMj0 : 0 < M j := zero_lt_one.trans_le hMj
  have hGeom : (B:ℝ) ≤ b*(x / M j) :=
    complement_support_limit hj ha hs N M hc hM hNM hprod
  have hdiv : x/M j ≤ x := (div_le_iff₀ hMj0).mpr (le_mul_of_one_le_right hx0.le hMj)
  have hGeom' : (B:ℝ) ≤ b*x := hGeom.trans (mul_le_mul_of_nonneg_left hdiv (zero_le_one.trans hb))
  have hgLog : 0 ≤ Real.log (2*b) := Real.log_nonneg (by linarith)
  have hg : 1 ≤ g := by dsimp [g]; linarith
  have hgx : 1 ≤ g * Real.log x := one_le_mul_of_one_le_of_one_le hg hlog
  have hLogGeom : Real.log (2*(B:ℝ)) ≤ g * Real.log x := calc
    _ ≤ Real.log ((2*b)*x) := by
      apply Real.log_le_log (by linarith)
      nlinarith only [hGeom']
    _ = Real.log (2*b) + Real.log x := Real.log_mul (by positivity) hx0.ne'
    _ ≤ g * Real.log x := by
      dsimp [g]
      nlinarith only [mul_nonneg hgLog (sub_nonneg.mpr hlog)]
  have hBudget216 : Real.log (2*(B:ℝ)) * ((Real.log B)^(r:ℝ))^2 * (1+Real.log B)^(a.card*a.card) ≤
      (3:ℝ)^216 * (g*Real.log x)^216 := by
    rw [Real.rpow_natCast]
    have h3 : (3:ℝ)^e ≤ (3:ℝ)^216 := pow_le_pow_right₀ (by norm_num) he
    have hLog0 : 0 ≤ Real.log (2*(B:ℝ)) := Real.log_nonneg (by linarith)
    have hLogPow : (Real.log (2*(B:ℝ)))^e ≤ (g*Real.log x)^216 :=
      (pow_le_pow_left₀ hLog0 hLogGeom e).trans (pow_le_pow_right₀ hgx he)
    exact hBudget.trans (mul_le_mul h3 hLogPow (pow_nonneg hLog0 _) (by positivity))
  have hLength : (B:ℝ)+(Q:ℝ)^2*T ≤ (b*CHeight)*(x/M j+H) := by
    rw [mul_add]
    apply add_le_add
    · exact hGeom.trans (mul_le_mul_of_nonneg_right
        (le_mul_of_one_le_right (zero_le_one.trans hb) hHeight) (div_nonneg hx0.le hMj0.le))
    · exact hHT.trans (mul_le_mul_of_nonneg_right
        (le_mul_of_one_le_left (zero_le_one.trans hHeight) hb) hH)
  have hW2 : W^2 * D^2 = ∏ i ∈ s, (U i)^2 := by
    rw [Finset.prod_pow, ← mul_pow]
    dsimp [W]
    rw [div_mul_cancel₀ _ hD.ne']
  have hRawUpper : R * W^2 ≤ (36*Real.pi*(Real.pi+1)) * ((b*CHeight)*(x/M j+H)) *
      ((3:ℝ)^216 * (g*Real.log x)^216) := by
    have hLogB0 : 0 ≤ Real.log (B:ℝ) := Real.log_nonneg hBreal
    have hLog2B0 : 0 ≤ Real.log (2*(B:ℝ)) := Real.log_nonneg (by linarith)
    refine hRaw'.trans ?_
    exact mul_le_mul (mul_le_mul_of_nonneg_left hLength (by positivity)) hBudget216 (by positivity)
      (by positivity)
  calc
    _ = (R * W^2) * D^2 := by rw [mul_assoc, hW2]
    _ ≤ _ := (mul_le_mul_of_nonneg_right hRawUpper (sq_nonneg D)).trans_eq (by
      simp only [complementConstant, D, g, b, mul_pow]
      ring)

end ShortAPComplementSampling

end

section

/-! Logarithmic weights and the absorption of the truncation error in Lemma 3.3
of Koukoulopoulos, *Primes in short arithmetic progressions*, arXiv:1405.6592. -/
namespace ShortAPLogWeight
open MeasureTheory
open scoped Topology
noncomputable section

def weightSum (g : ℝ → ℂ) (r : ℕ) (N : ℝ) (a : ℕ → ℂ) : ℂ :=
  ∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, (Real.log n : ℂ)^r * g (n/N) * a n

def withLog (g : ℝ → ℂ) (u : ℝ) : ℂ := (Real.log u : ℂ) * g u

theorem withLog_smooth (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ContDiff ℝ (⊤ : ℕ∞) (withLog g) := by
  rw [contDiff_iff_contDiffAt]
  intro x
  by_cases hx : x = 0
  · subst x
    apply (contDiffAt_const (c := (0 : ℂ))).congr_of_eventuallyEq
    filter_upwards [gt_mem_nhds (by norm_num : (0 : ℝ) < 1)] with u hu
    simp [withLog, hs u (fun h => (not_le_of_gt hu) h.1)]
  · exact (Complex.ofRealCLM.contDiff.contDiffAt.comp x (Real.contDiffAt_log.2 hx)).mul
      hg.contDiffAt

theorem weightSum_succ (g : ℝ → ℂ) (r : ℕ) {N : ℝ} (hN : 0 < N) (a : ℕ → ℂ) :
    weightSum g (r+1) N a =
    (Real.log N : ℂ) * weightSum g r N a + weightSum (withLog g) r N a := by
  unfold weightSum withLog
  rw [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro n hn
  have hn' : (n : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
  rw [Real.log_div hn' hN.ne', Complex.ofReal_sub, pow_succ]
  ring

/-- Promote a uniform unweighted smooth cutoff estimate to every fixed log
power. Both constants precede all the varying conductor/frequency parameters. -/
theorem lift_log_power {ι : Type*} (N : ι → ℝ) (a : ι → ℕ → ℂ) (B : ι → ℝ)
    (hN : ∀ i, 1 ≤ N i) (hB : ∀ i, 0 ≤ B i)
    (H : ∀ g : ℝ → ℂ, ContDiff ℝ (⊤ : ℕ∞) g →
      (∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) → ∃ C : ℝ, 0 ≤ C ∧
      ∀ i, ‖weightSum g 0 (N i) (a i)‖ ≤ C * B i) (r : ℕ) :
    ∀ g : ℝ → ℂ, ContDiff ℝ (⊤ : ℕ∞) g →
      (∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) → ∃ C : ℝ, 0 ≤ C ∧
      ∀ i, ‖weightSum g r (N i) (a i)‖ ≤ C * (Real.log (2*N i))^r * B i := by
  induction r with
  | zero =>
    simpa using H
  | succ r ih =>
    intro g hg hs
    obtain ⟨C,hC,hg'⟩ := ih g hg hs
    obtain ⟨D,hD,hd⟩ := ih (withLog g) (withLog_smooth g hg hs)
      (fun u hu => by simp [withLog, hs u hu])
    have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    refine ⟨C + D / Real.log 2, by positivity, ?_⟩
    intro i
    let L := Real.log (2*N i)
    have hn : 0 < N i := lt_of_lt_of_le zero_lt_one (hN i)
    have hl : Real.log 2 ≤ L := Real.log_le_log (by norm_num) (by linarith [hN i])
    have hl' : 0 ≤ L := h2.le.trans hl
    have hnL : Real.log (N i) ≤ L := Real.log_le_log hn (by linarith)
    have hD' : D ≤ (D/Real.log 2)*L := by
      calc D = (D/Real.log 2)*Real.log 2 := (div_mul_cancel₀ D h2.ne').symm
           _ ≤ _ := mul_le_mul_of_nonneg_left hl (by positivity)
    rw [weightSum_succ g r hn]
    apply (norm_add_le ..).trans
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (Real.log_nonneg (hN i))]
    calc
      _ ≤ L * (C * L^r * B i) + D * L^r * B i :=
        show _ from add_le_add (mul_le_mul hnL (hg' i) (norm_nonneg _) hl') (hd i)
      _ ≤ L * (C * L^r * B i) + ((D/Real.log 2)*L) * L^r * B i := by
        gcongr
        exact hB i
      _ = _ := by change _ = (C+D/Real.log 2)*L^(r+1)*B i; rw [pow_succ]; ring

/-- The actual Cauchy-weighted short polynomial in Lemma 3.3, including n=1. -/
def dualMass {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) : ℝ :=
  ∫ u : ℝ, ‖∑ n ∈ Finset.Icc 1 M, χ (n : ZMod q) /
    (n : ℂ) ^ (1 / 2 + ((t+u : ℝ) : ℂ)*Complex.I)‖ / (1+u^2)

/-- Uniform absorption also at M=1: a bounded remainder is enough once the
short polynomial has its constant coefficient, independently of q, t and M. -/
theorem absorb_bounded_remainder :
    ∃ C : ℝ, 0 < C ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ),
      1 ≤ M → ∀ (z : ℂ) (A D e : ℝ), 0 ≤ D → e ≤ 1 →
      ‖z‖ ≤ A * dualMass χ t M + D * e →
      ‖z‖ ≤ (A + D*C) * dualMass χ t M := by
  obtain ⟨C,hC,h⟩ := ShortAPDualPolynomial.cauchy_weight_dirichlet_polynomial
  refine ⟨C,hC,?_⟩
  intro q χ t M hM z A D e hD he hz
  have h' : 1 ≤ C * dualMass χ t M := h q χ t M hM
  calc ‖z‖ ≤ _ := hz
       _ ≤ A * dualMass χ t M + D*(C*dualMass χ t M) :=
         show _ from add_le_add_right (mul_le_mul_of_nonneg_left (he.trans h') hD) _
       _ = _ := by ring

end
end ShortAPLogWeight

end

section

/-! The finite main term on the critical line in Koukoulopoulos, Lemma 3.3. -/
namespace ShortAPCriticalMain
open MeasureTheory ShortAPContourShift ShortAPLogWeight
noncomputable section

def point (t : ℝ) : ℂ := 1/2+(t : ℂ)*Complex.I

private theorem point_re (t : ℝ) : (point t).re = 1/2 := by simp [point]

private theorem point_neg (t : ℝ) : point (-t) = star (point t) := by
  apply Complex.ext <;> simp [point]

def poly {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) : ℂ :=
  ∑ n ∈ Finset.Icc 1 M, χ (n : ZMod q) / (n : ℂ) ^ point t

theorem poly_conjugate {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) :
    poly χ⁻¹ (-t) M = star (poly χ t M) := by
  simp only [poly, star_sum, star_div₀]
  apply Finset.sum_congr rfl
  intro n hn
  rw [← MulChar.star_apply', point_neg]
  have harg : (n : ℂ).arg ≠ Real.pi := by
    rw [← Complex.ofReal_natCast, Complex.arg_ofReal_of_nonneg (Nat.cast_nonneg _)]
    exact Real.pi_pos.ne
  rw [Complex.star_def, Complex.cpow_conj _ _ harg]
  simp

theorem poly_cauchy_integrable {q : ℕ} (χ : DirichletCharacter ℂ q) (t : ℝ) (M : ℕ) :
    Integrable (fun u : ℝ => ‖poly χ (t+u) M‖ / (1+u^2)) := by
  have hc : Continuous (fun u : ℝ => poly χ (t+u) M) := by
    unfold poly
    apply continuous_finsetSum
    intro n hn
    have hn' : (n : ℂ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)
    apply continuous_const.div
    · unfold point; fun_prop (disch := assumption)
    · exact fun u => Complex.cpow_ne_zero_iff.mpr (Or.inl hn')
  have hb (u : ℝ) : ‖poly χ (t+u) M‖ ≤ (M : ℝ) := by
    apply (norm_sum_le _ _).trans
    calc
      _ ≤ ∑ _n ∈ Finset.Icc 1 M, (1:ℝ) := by
        apply Finset.sum_le_sum
        intro n hn
        have hn' : 1 ≤ n := (Finset.mem_Icc.mp hn).1
        rw [norm_div, Complex.norm_natCast_cpow_of_pos hn', point_re]
        apply (div_le_one (Real.rpow_pos_of_pos (by exact_mod_cast hn') _)).2
        exact (χ.norm_le_one _).trans (Real.one_le_rpow (by exact_mod_cast hn') (by norm_num))
      _ = _ := by simp [Nat.card_Icc]
  apply (integrable_inv_one_add_sq.const_mul (M:ℝ)).mono'
    ((hc.norm.div (by fun_prop) (fun u => by positivity)).aestronglyMeasurable)
  filter_upwards with u
  change ‖‖poly χ (t+u) M‖ / (1+u^2)‖ ≤ (M:ℝ) * (1+u^2)⁻¹
  rw [Real.norm_of_nonneg (div_nonneg (norm_nonneg _) (by positivity)), div_eq_mul_inv]
  exact mul_le_mul_of_nonneg_right (hb _) (by positivity)

private theorem norm_gammaKernel (odd : Bool) (t : ℝ) : ‖gammaKernel odd (point t)‖ = 1 := by
  rw [gammaKernel_eq_ratio odd (z := point t) (by rw [point_re]; norm_num)]
  have he : 1-point t = star (point t) := by rw [← point_neg]; unfold point; push_cast; ring
  have aux (a : ℝ) (ha : 0 ≤ a) :
      ‖Complex.Gammaℝ (point t + (a:ℂ)) / Complex.Gammaℝ (1-point t + (a:ℂ))‖ = 1 := by
    have he' : 1-point t+(a:ℂ) = star (point t+(a:ℂ)) := by rw [he,star_add]; simp
    have hn := Complex.Gammaℝ_ne_zero_of_re_pos (s := point t+(a:ℂ)) (by simp [point_re]; linarith)
    rw [he', Complex.star_def, Complex.Gammaℝ_conj, norm_div, Complex.norm_conj, div_self (norm_ne_zero_iff.mpr hn)]
  cases odd
  · simpa using aux 0 (le_refl _)
  · simpa using aux 1 zero_le_one

theorem finite_kernel {q : ℕ} (χ : DirichletCharacter ℂ q) (odd : Bool) (g : ℝ → ℂ)
    {x : ℝ} (hx : 0 < x) (M : ℕ) (t u : ℝ) :
    (∑ n ∈ Finset.Icc 1 M, χ⁻¹ (n : ZMod q) *
      dualKernel odd (x*n) g (point (-t)) (point (-(t+u)))) =
      (x : ℂ)^(-point (-(t+u))) * gammaKernel odd (point (-(t+u))) *
      mellin g ((u : ℂ)*Complex.I) * star (poly χ (t+u) M) := by
  rw [← poly_conjugate, poly, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  have hu : point (-t)-point (-(t+u)) = (u : ℂ)*Complex.I := by unfold point; push_cast; ring
  let z := point (-(t+u))
  have hpow : ((x*(n:ℝ) : ℝ) : ℂ)^(-z) = (x:ℂ)^(-z)*(n:ℂ)^(-z) := by
    rw [Complex.ofReal_mul, Complex.mul_cpow_ofReal_nonneg hx.le (Nat.cast_nonneg n),
      Complex.ofReal_natCast]
  rw [dualKernel, hu, hpow]
  dsimp only [z]
  simp only [Complex.cpow_neg, div_eq_mul_inv]
  ring

theorem critical_main_bound (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ {q : ℕ} (χ : DirichletCharacter ℂ q) (odd : Bool)
    (x : ℝ) (_ : 0 < x) (M : ℕ) (t : ℝ),
    ‖∫ u : ℝ, ∑ n ∈ Finset.Icc 1 M, χ⁻¹ (n : ZMod q) *
      dualKernel odd (x*n) g (point (-t)) (point (-(t+u)))‖ ≤
      (x^(-(1/2):ℝ)*C) * dualMass χ t M := by
  obtain ⟨C,hC,h⟩ := ShortAPDualPolynomial.mellin_vertical_decay g hg hs 0 2
  refine ⟨C,hC,?_⟩
  intro q χ odd x hx M t
  let k := x^(-(1/2):ℝ)*C
  have hbound (u : ℝ) : ‖∑ n ∈ Finset.Icc 1 M, χ⁻¹ (n : ZMod q) *
      dualKernel odd (x*n) g (point (-t)) (point (-(t+u)))‖ ≤
      k * (‖poly χ (t+u) M‖ / (1+u^2)) := by
    simp only [finite_kernel χ odd g hx M t u, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hx,
      Complex.neg_re, point_re, norm_gammaKernel, mul_one, norm_star]
    have hm : ‖mellin g ((u:ℂ)*Complex.I)‖ ≤ C / (1+u^2) := by simpa using h u
    calc _ ≤ x^(-(1/2):ℝ) * (C / (1+u^2)) * ‖poly χ (t+u) M‖ := by gcongr
         _ = _ := by unfold k; ring
  have hb := norm_integral_le_of_norm_le ((poly_cauchy_integrable χ t M).const_mul k)
    (Filter.Eventually.of_forall hbound)
  rw [integral_const_mul] at hb
  exact hb

end
end ShortAPCriticalMain

end

section

namespace ShortAPFEBridge
open ShortAPCriticalMain ShortAPContourShift
open scoped Classical
noncomputable section

def parity {q : ℕ} (χ : DirichletCharacter ℂ q) : Bool := if χ.Even then false else true

/-- Uncompleted functional equation on the absolutely convergent dual side,
using the same holomorphic archimedean kernel as the contour theorem. -/
theorem L_one_sub {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hp : χ.IsPrimitive)
    {z : ℂ} (hz : 1 < z.re) :
    χ.LFunction (1-z) = (q:ℂ)^(z-1/2) * χ.rootNumber *
      gammaKernel (parity χ) z * χ⁻¹.LFunction z := by
  have hz0 : z ≠ 0 := by intro h; simp [h] at hz; linarith
  have hz1 : 1-z ≠ 0 := by
    intro h; have hr := congrArg Complex.re h; simp at hr; linarith
  have hi : χ⁻¹.Even ↔ χ.Even := by
    change χ⁻¹ (-1) = 1 ↔ χ (-1) = 1
    rw [← MulChar.star_apply']
    constructor
    · intro h; simpa only [star_star,star_one] using congrArg star h
    · intro h; rw [h,star_one]
  have he : gammaKernel (parity χ) z = χ⁻¹.gammaFactor z / χ.gammaFactor (1-z) := by
    rw [gammaKernel_eq_ratio _ (by linarith : 0 < z.re)]
    by_cases h : χ.Even <;> simp [parity,DirichletCharacter.gammaFactor,hi,h]
  have hg : χ⁻¹.gammaFactor z ≠ 0 := by
    unfold DirichletCharacter.gammaFactor
    split_ifs
    · exact Complex.Gammaℝ_ne_zero_of_re_pos (by linarith : 0 < z.re)
    · apply Complex.Gammaℝ_ne_zero_of_re_pos
      rw [Complex.add_re, Complex.one_re]
      linarith
  rw [he,DirichletCharacter.LFunction_eq_completed_div_gammaFactor _ _ (Or.inl hz1),
    DirichletCharacter.LFunction_eq_completed_div_gammaFactor _ _ (Or.inl hz0),
    hp.completedLFunction_one_sub]
  by_cases hr : χ.gammaFactor (1-z) = 0
  · simp [hr]
  · field_simp

def pref {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (N t : ℝ) : ℂ :=
  (N:ℂ)^(point (-t)) / (q:ℂ)^(1/2:ℂ) * χ.rootNumber

theorem transformed_integrand {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hp : χ.IsPrimitive) {N : ℝ} (hN : 0 < N) (t : ℝ) (g : ℝ → ℂ)
    {z : ℂ} (hz : 1 < z.re) :
    χ.LFunction (point t + (point (-t)-z)) * (N:ℂ)^(point (-t)-z) *
      mellin g (point (-t)-z) =
    pref χ N t * (χ⁻¹.LFunction z * dualKernel (parity χ) (N/q) g (point (-t)) z) := by
  have hident : point t + (point (-t)-z) = 1-z := by unfold point; push_cast; ring
  have hq0 : 0 < (q : ℝ) := by exact_mod_cast NeZero.pos q
  have hdiv : (((N/(q:ℝ) : ℝ) : ℂ))^(-z) =
      (N:ℂ)^(-z)/(q:ℂ)^(-z) := by
    rw [Complex.ofReal_div, Complex.div_cpow_ofReal_nonneg hN.le hq0.le, Complex.ofReal_natCast]
  rw [hident, L_one_sub hp hz, dualKernel, hdiv, pref,
    Complex.cpow_sub _ _ (by exact_mod_cast (NeZero.ne q)), Complex.cpow_sub _ _ (Complex.ofReal_ne_zero.mpr hN.ne')]
  simp only [Complex.cpow_neg, div_eq_mul_inv, inv_inv]
  ring

theorem norm_pref {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q}
    (hp : χ.IsPrimitive) {N : ℝ} (hN : 0 < N) (t : ℝ) :
    ‖pref χ N t‖ = Real.sqrt (N/q) := by
  rw [pref, norm_mul, norm_div, DirichletCharacter.norm_rootNumber hp, mul_one,
    Complex.norm_cpow_eq_rpow_re_of_pos hN, Complex.norm_natCast_cpow_of_pos (NeZero.pos q),
    Real.sqrt_div hN.le]
  simp [point,Real.sqrt_eq_rpow]

def dualTerm {q : ℕ} (χ : DirichletCharacter ℂ q) (N t : ℝ) (g : ℝ → ℂ) (n : ℕ) : ℂ :=
  χ⁻¹ (n : ZMod q) * ∫ v : ℝ, dualKernel (parity χ) ((N/q)*n) g (point (-t))
    (5/2+(v:ℂ)*Complex.I)

end
end ShortAPFEBridge

end

section

/-!
# Mellin expansion on the initial line

The initial step of Koukoulopoulos, *Primes in short arithmetic progressions*
(arXiv:1405.6592), Lemma 3.3. This file proves the inversion and the absolutely
convergent sum/integral interchange, not the subsequent contour shift.

The logarithmic coordinate and compact-support argument agree with the start
of `mellin_vertical_decay` in the local dual-polynomial development.
-/

open Complex Set MeasureTheory
open scoped FourierTransform BigOperators

namespace ShortAPMellinExpansion

noncomputable section

def vertical (σ v : ℝ) : ℂ := (σ : ℂ) + (v : ℂ) * Complex.I

@[simp] theorem vertical_re (σ v : ℝ) : (vertical σ v).re = σ := by simp [vertical]
@[simp] theorem vertical_im (σ v : ℝ) : (vertical σ v).im = v := by simp [vertical]

theorem continuous_vertical (σ : ℝ) : Continuous (vertical σ) := by
  unfold vertical
  fun_prop

/-- Mellin convergence for a continuous test function supported in `[1,4]`. -/
theorem mellinConvergent_compact (g : ℝ → ℂ) (hg : Continuous g)
    (hsupp : ∀ x ∉ Set.Icc (1 : ℝ) 4, g x = 0) (s : ℂ) : MellinConvergent g s := by
  let f (x : ℝ) := (x : ℂ) ^ (s - 1) • g x
  have hf : ContinuousOn f (Set.Icc 1 4) := by
    have hpower : ContinuousOn (fun x : ℝ => (x : ℂ) ^ (s - 1)) (Set.Icc 1 4) :=
      Complex.continuous_ofReal.continuousOn.cpow_const (fun x hx =>
        Complex.ofReal_mem_slitPlane.2 (lt_of_lt_of_le zero_lt_one hx.1))
    exact hpower.fun_smul hg.continuousOn
  have hi := hf.integrableOn_compact (μ := volume) isCompact_Icc
  have hI : Integrable ((Set.Icc (1 : ℝ) 4).indicator f) :=
    (integrable_indicator_iff measurableSet_Icc).2 hi
  refine hI.integrableOn.congr_fun (fun x _ => ?_) measurableSet_Ioi
  by_cases hx : x ∈ Set.Icc (1 : ℝ) 4
  · simp [hx, f]
  · simp [hx, f, hsupp x hx]

/-- Smooth support in `[1,4]` makes the Mellin transform integrable on every
fixed vertical line, by writing it as a rescaled Fourier transform of a
Schwartz function. -/
theorem verticalIntegrable_mellin (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hsupp : ∀ x ∉ Set.Icc (1 : ℝ) 4, g x = 0) (σ : ℝ) :
    Complex.VerticalIntegrable (mellin g) σ := by
  let G (x : ℝ) := Real.exp (-σ * x) • g (Real.exp (-x))
  have hG : ContDiff ℝ (⊤ : ℕ∞) G := by unfold G; fun_prop
  have hGc : HasCompactSupport G := by
    apply HasCompactSupport.of_support_subset_isCompact (K := Set.Icc (-Real.log 4) 0) isCompact_Icc
    intro x hx
    have hnon := Function.mem_support.mp hx
    have he : Real.exp (-x) ∈ Set.Icc (1 : ℝ) 4 := by
      by_contra hn
      exact hnon (by simp [G, hsupp _ hn])
    constructor
    · have h := (Real.le_log_iff_exp_le (by norm_num : (0 : ℝ) < 4)).mpr he.2
      linarith
    · have h : (0 : ℝ) ≤ -x :=
        Real.exp_le_exp.mp (by simpa only [Real.exp_zero] using he.1)
      linarith
  let F := 𝓕 (hGc.toSchwartzMap hG)
  have hM (v : ℝ) : mellin g (vertical σ v) = F (v / (2 * Real.pi)) := by
    rw [mellin_eq_fourier, vertical_re, vertical_im]
    rfl
  change Integrable (fun v : ℝ => mellin g (vertical σ v))
  simp_rw [hM]
  have hπ : (2 * Real.pi) ≠ 0 := by positivity
  simpa only [div_eq_mul_inv] using F.integrable.comp_mul_right' (inv_ne_zero hπ)

private theorem continuous_term_line {q : ℕ} (χ : DirichletCharacter ℂ q) (s : ℂ) (σ : ℝ) (n : ℕ) :
    Continuous (fun v : ℝ => LSeries.term (fun m : ℕ => χ (m : ZMod q)) (s + vertical σ v) n) := by
  by_cases hn : n = 0
  · simpa only [hn, LSeries.term_zero] using (continuous_const : Continuous fun _ : ℝ => (0 : ℂ))
  have hn' : (n : ℂ) ≠ 0 := by exact_mod_cast hn
  simp_rw [LSeries.term_of_ne_zero hn]
  have hc : Continuous (fun v : ℝ => (n : ℂ) ^ (s + vertical σ v)) :=
    (continuous_const.add (continuous_vertical σ)).const_cpow (Or.inl hn')
  exact continuous_const.div hc (fun v => Complex.cpow_ne_zero_iff.mpr (Or.inl hn'))

/-- On an absolute-convergence line a Dirichlet L-function can be integrated
against any integrable multiplier by integrating its series term by term. -/
theorem LFunction_integral_exchange {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (s : ℂ) (σ : ℝ) (hσ : 1 < s.re + σ) (K : ℝ → ℂ) (hK : Integrable K) :
    Integrable (fun v => χ.LFunction (s + vertical σ v) * K v) ∧
      (∫ v : ℝ, χ.LFunction (s + vertical σ v) * K v) =
        ∑' n : ℕ, ∫ v : ℝ, LSeries.term (fun m : ℕ => χ (m : ZMod q)) (s + vertical σ v) n * K v := by
  let ψ (n : ℕ) := χ (n : ZMod q)
  let a (n : ℕ) := ‖LSeries.term ψ ((s.re + σ : ℝ) : ℂ) n‖
  let F (n : ℕ) (v : ℝ) := LSeries.term ψ (s + vertical σ v) n * K v
  have hRe (v : ℝ) : 1 < (s + vertical σ v).re := by simpa using hσ
  have hline (n : ℕ) (v : ℝ) : ‖LSeries.term ψ (s + vertical σ v) n‖ = a n := by
    simp only [a, LSeries.norm_term_eq, Complex.add_re, vertical_re, Complex.ofReal_re]
  have ha : Summable a := by
    exact (χ.LSeriesSummable_of_one_lt_re (show 1 < (((s.re + σ : ℝ) : ℂ)).re by simpa)).norm
  have hFi (n : ℕ) : Integrable (F n) := hK.bdd_mul
    (continuous_term_line χ s σ n).aestronglyMeasurable
      (Filter.Eventually.of_forall fun v => (hline n v).le)
  have hFns (n : ℕ) : (∫ v : ℝ, ‖F n v‖) = a n * (∫ v : ℝ, ‖K v‖) := by
    simp_rw [F, norm_mul, hline]
    rw [integral_const_mul]
  have hFs : Summable (fun n => ∫ v : ℝ, ‖F n v‖) := by
    simp_rw [hFns]
    exact ha.mul_right _
  have hcontL : Continuous (fun v : ℝ => χ.LFunction (s + vertical σ v)) := by
    rw [continuous_iff_continuousAt]
    intro v
    have hv : s + vertical σ v ≠ 1 := by
      intro he
      have hv := hRe v
      rw [he, Complex.one_re] at hv
      exact (lt_irrefl (1 : ℝ)) hv
    have hV : ContinuousAt (fun u : ℝ => s + vertical σ u) v :=
      (continuous_const.add (continuous_vertical σ)).continuousAt
    exact ContinuousAt.comp_of_eq (f := fun u : ℝ => s + vertical σ u)
      (χ.differentiableAt_LFunction _ (Or.inl hv)).continuousAt hV rfl
  have hL (v : ℝ) : ‖χ.LFunction (s + vertical σ v)‖ ≤ ∑' n : ℕ, a n := by
    rw [χ.LFunction_eq_LSeries (hRe v), LSeries]
    convert norm_tsum_le_tsum_norm (χ.LSeriesSummable_of_one_lt_re (hRe v)).norm using 1
    exact tsum_congr (fun n => (hline n v).symm)
  constructor
  · exact hK.bdd_mul hcontL.aestronglyMeasurable (Filter.Eventually.of_forall hL)
  · have htsum (v : ℝ) : χ.LFunction (s + vertical σ v) * K v = ∑' n, F n v := by
      rw [χ.LFunction_eq_LSeries (hRe v), LSeries,
        (χ.LSeriesSummable_of_one_lt_re (hRe v)).tsum_mul_right (K v)]
    simp_rw [htsum]
    exact (integral_tsum_of_summable_integral_norm hFi hFs).symm

/-- The form of absolute-convergence interchange used after the functional
equation. In particular `s = 0` gives the line `σ + iv`. The zero index has
zero integrand even for the character modulo one, since the exponent is
nonzero on this line. -/
theorem LFunction_integral_exchange_cpow {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (s : ℂ) (σ : ℝ) (hσ : 1 < s.re + σ) (K : ℝ → ℂ) (hK : Integrable K) :
    Integrable (fun v => K v * χ.LFunction (s + vertical σ v)) ∧
      (∫ v : ℝ, K v * χ.LFunction (s + vertical σ v)) =
        ∑' n : ℕ, χ (n : ZMod q) * ∫ v : ℝ, K v * (n : ℂ) ^ (-(s + vertical σ v)) := by
  have h := LFunction_integral_exchange χ s σ hσ K hK
  have heq : (fun v : ℝ => K v * χ.LFunction (s + vertical σ v)) =
      fun v : ℝ => χ.LFunction (s + vertical σ v) * K v := by
    funext v
    exact mul_comm _ _
  rw [heq]
  refine ⟨h.1, h.2.trans (tsum_congr fun n => ?_)⟩
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with v
  by_cases hn : n = 0
  · have hexp : -(s + vertical σ v) ≠ 0 := by
      apply neg_ne_zero.mpr
      intro hzero
      have hRe : 1 < (s + vertical σ v).re := by simpa using hσ
      rw [hzero, Complex.zero_re] at hRe
      norm_num at hRe
    simp only [hn, LSeries.term_zero, Nat.cast_zero, Complex.zero_cpow hexp, zero_mul, mul_zero]
  · rw [LSeries.term_of_ne_zero hn, Complex.cpow_neg, div_eq_mul_inv]
    ring

/-- Absolute convergence interchange on the unshifted line `σ + iv`. -/
theorem LFunction_vertical_exchange_cpow {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (σ : ℝ) (hσ : 1 < σ) (K : ℝ → ℂ) (hK : Integrable K) :
    Integrable (fun v => K v * χ.LFunction (vertical σ v)) ∧
      (∫ v : ℝ, K v * χ.LFunction (vertical σ v)) =
        ∑' n : ℕ, χ (n : ZMod q) * ∫ v : ℝ, K v * (n : ℂ) ^ (-(vertical σ v)) := by
  simpa only [zero_add] using LFunction_integral_exchange_cpow χ 0 σ (by simpa using hσ) K hK

private theorem coefficient_factor {q : ℕ} (χ : DirichletCharacter ℂ q) {N : ℝ} (hN : 0 < N)
    (s w : ℂ) {n : ℕ} (hn : n ≠ 0) :
    LSeries.term (fun m : ℕ => χ (m : ZMod q)) (s + w) n * (N : ℂ) ^ w =
      LSeries.term (fun m : ℕ => χ (m : ZMod q)) s n * (((n : ℝ) / N : ℝ) : ℂ) ^ (-w) := by
  have hn' : (n : ℂ) ≠ 0 := by exact_mod_cast hn
  rw [LSeries.term_of_ne_zero hn, LSeries.term_of_ne_zero hn, Complex.cpow_add _ _ hn',
    Complex.ofReal_div, Complex.div_cpow_ofReal_nonneg (Nat.cast_nonneg n) hN.le, Complex.ofReal_natCast,
    Complex.cpow_neg, Complex.cpow_neg]
  simp only [div_eq_mul_inv, mul_inv_rev, inv_inv]
  ring

/-- Koukoulopoulos's initial Mellin expression before moving the contour.
The integral is a real-parameter integral on `w = σ + iv`; its normalizing
factor is therefore `1/(2π)`. The finite sum is exact, including its endpoints. -/
theorem smooth_dirichlet_mellin_expansion {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hsupp : ∀ x ∉ Set.Icc (1 : ℝ) 4, g x = 0) {N : ℝ} (hN : 0 < N)
    (s : ℂ) (σ : ℝ) (hσ : 1 < s.re + σ) :
    Integrable (fun v : ℝ => χ.LFunction (s + vertical σ v) * (N : ℂ) ^ (vertical σ v) *
      mellin g (vertical σ v)) ∧
    (∑ n ∈ Finset.Icc 1 ⌊4 * N⌋₊, g ((n : ℝ) / N) * χ (n : ZMod q) / (n : ℂ) ^ s) =
      (↑(1 / (2 * Real.pi)) : ℂ) * ∫ v : ℝ,
        χ.LFunction (s + vertical σ v) * (N : ℂ) ^ (vertical σ v) * mellin g (vertical σ v) := by
  let c : ℂ := ↑(1 / (2 * Real.pi) : ℝ)
  let ψ (n : ℕ) := χ (n : ZMod q)
  let K (v : ℝ) := (N : ℂ) ^ (vertical σ v) * mellin g (vertical σ v)
  let F (n : ℕ) (v : ℝ) := LSeries.term ψ (s + vertical σ v) n * K v
  have hN₀ : (N : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hN.ne'
  have hK : Integrable K := by
    have hM := verticalIntegrable_mellin g hg hsupp σ
    change Integrable (fun v : ℝ => mellin g (vertical σ v)) at hM
    apply hM.bdd_mul ((continuous_vertical σ).const_cpow (Or.inl hN₀)).aestronglyMeasurable
    apply Filter.Eventually.of_forall
    intro v
    rw [Complex.norm_cpow_eq_rpow_re_of_pos hN, vertical_re]
  have hE := LFunction_integral_exchange χ s σ hσ K hK
  constructor
  · simpa only [K, mul_assoc] using hE.1
  · have hinv (n : ℕ) : c * (∫ v : ℝ, F n v) = LSeries.term ψ s n * g ((n : ℝ) / N) := by
      by_cases hn : n = 0
      · simp [hn, F]
      have hn' : 0 < (n : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
      have hInv := mellinInv_mellin_eq σ g (div_pos hn' hN)
        (mellinConvergent_compact g hg.continuous hsupp _) (verticalIntegrable_mellin g hg hsupp σ)
        hg.continuous.continuousAt
      have hInt : (∫ v : ℝ, F n v) = LSeries.term ψ s n * ∫ v : ℝ,
          (((n : ℝ) / N : ℝ) : ℂ) ^ (-(vertical σ v)) * mellin g (vertical σ v) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with v
        unfold F K
        rw [← mul_assoc, coefficient_factor χ hN s (vertical σ v) hn, mul_assoc]
      rw [hInt, mul_left_comm, ← hInv]
      rfl
    have hf (n : ℕ) (hn : n ∉ Finset.Icc 1 ⌊4*N⌋₊) :
        LSeries.term ψ s n * g ((n : ℝ) / N) = 0 := by
      by_cases hn₀ : n = 0
      · simp [hn₀]
      have hbig₀ : ⌊4*N⌋₊ < n := by
        by_contra! h
        exact hn (Finset.mem_Icc.mpr ⟨Nat.pos_of_ne_zero hn₀, h⟩)
      have hbig : 4*N < (n : ℝ) := (Nat.floor_lt (by positivity)).mp hbig₀
      have hneg : (n : ℝ) / N ∉ Set.Icc (1 : ℝ) 4 := by
        exact fun h => (not_le_of_gt hbig) ((div_le_iff₀ hN).1 h.2)
      rw [hsupp _ hneg, mul_zero]
    calc
      (∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, g ((n : ℝ) / N) * χ (n : ZMod q) / (n : ℂ) ^ s) =
          ∑ n ∈ Finset.Icc 1 ⌊4*N⌋₊, LSeries.term ψ s n * g ((n : ℝ) / N) := by
        apply Finset.sum_congr rfl
        intro n hn
        rw [LSeries.term_of_ne_zero (Nat.ne_of_gt (Finset.mem_Icc.mp hn).1)]
        unfold ψ
        ring
      _ = ∑' n, LSeries.term ψ s n * g ((n : ℝ) / N) := (tsum_eq_sum hf).symm
      _ = ∑' n, c * (∫ v : ℝ, F n v) := tsum_congr (fun n => (hinv n).symm)
      _ = _ := by
        rw [tsum_mul_left, ← hE.2]
        simp only [K, c, mul_assoc]

/-- The paper's initial line `Re w = 3/4` for `s = 1/2 + it`. -/
theorem smooth_dirichlet_critical_initial_line {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (g : ℝ → ℂ) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hsupp : ∀ x ∉ Set.Icc (1 : ℝ) 4, g x = 0) {N : ℝ} (hN : 0 < N) (t : ℝ) :
    let s := vertical (1 / 2) t
    let w := vertical (3 / 4)
    Integrable (fun v : ℝ => χ.LFunction (s + w v) * (N : ℂ) ^ (w v) * mellin g (w v)) ∧
    (∑ n ∈ Finset.Icc 1 ⌊4 * N⌋₊, g ((n : ℝ) / N) * χ (n : ZMod q) / (n : ℂ) ^ s) =
      (↑(1 / (2 * Real.pi)) : ℂ) * ∫ v : ℝ,
        χ.LFunction (s + w v) * (N : ℂ) ^ (w v) * mellin g (w v) := by
  exact smooth_dirichlet_mellin_expansion χ g hg hsupp hN (vertical (1 / 2) t) (3 / 4) (by norm_num)

end
end ShortAPMellinExpansion

end

section

namespace ShortAPInitialLShift

open Set MeasureTheory HurwitzZeta Filter
open scoped BigOperators Topology

/-- A Mellin transform convergent at the two real endpoints is bounded on
the whole closed vertical strip. -/
theorem mellin_strip_bound {f : ℝ → ℂ} {a b : ℝ} (ha : MellinConvergent f (a:ℂ))
    (hb : MellinConvergent f (b:ℂ)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, a ≤ z.re → z.re ≤ b → ‖mellin f z‖ ≤ C := by
  let A (x : ℝ) := ‖(x : ℂ)^((a:ℂ)-1) • f x‖
  let B (x : ℝ) := ‖(x : ℂ)^((b:ℂ)-1) • f x‖
  let C := ∫ x in Ioi (0:ℝ), A x+B x
  refine ⟨C, integral_nonneg (fun x => add_nonneg (norm_nonneg _) (norm_nonneg _)),
    fun z hza hzb => ?_⟩
  have hA : IntegrableOn A (Ioi 0) := ha.norm
  have hB : IntegrableOn B (Ioi 0) := hb.norm
  unfold mellin
  apply norm_integral_le_of_norm_le (hA.add hB)
  filter_upwards [ae_restrict_mem (μ := volume) (measurableSet_Ioi (a := (0:ℝ)))] with x hx
  have hx0 : 0 < x := hx
  change ‖(x:ℂ)^(z-1) • f x‖ ≤ A x + B x
  dsimp only [A, B]
  simp only [norm_smul, Complex.norm_cpow_eq_rpow_re_of_pos hx0, Complex.sub_re,
    Complex.ofReal_re, Complex.one_re]
  by_cases h : x ≤ 1
  · exact (mul_le_mul_of_nonneg_right (Real.rpow_le_rpow_of_exponent_ge hx0 h
      (sub_le_sub_right hza 1)) (norm_nonneg _)).trans
      (le_add_of_nonneg_right (by positivity))
  · exact (mul_le_mul_of_nonneg_right (Real.rpow_le_rpow_of_exponent_le (le_of_not_ge h)
      (sub_le_sub_right hzb 1)) (norm_nonneg _)).trans
      (le_add_of_nonneg_left (by positivity))

private theorem completed_even_bounded (u : UnitAddCircle) (a b : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, a ≤ z.re → z.re ≤ b → ‖completedHurwitzZetaEven₀ u z‖ ≤ C := by
  let P := hurwitzEvenFEPair u
  have hmc (t : ℂ) : MellinConvergent P.f_modif t := (P.isStrongFEPair_toStrongFEPair.hasMellin t).1
  obtain ⟨C,hC,h⟩ := mellin_strip_bound (hmc ((a/2:ℝ):ℂ)) (hmc ((b/2:ℝ):ℂ))
  refine ⟨C/2, by positivity, fun z hza hzb => ?_⟩
  rw [completedHurwitzZetaEven₀, WeakFEPair.Λ₀, norm_div, Complex.norm_ofNat]
  have he : (z/(2:ℂ)).re = z.re/2 := Complex.div_ofNat_re _ _
  apply div_le_div_of_nonneg_right _ (by norm_num)
  exact h (z/2) (by rw [he]; linarith) (by rw [he]; linarith)

private theorem completed_odd_bounded (u : UnitAddCircle) (a b : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, a ≤ z.re → z.re ≤ b → ‖completedHurwitzZetaOdd u z‖ ≤ C := by
  let P := hurwitzOddFEPair u
  have hP := isStrong_hurwitzOddFEPair u
  have hmc (t : ℂ) : MellinConvergent P.f t := (hP.hasMellin t).1
  obtain ⟨C,hC,h⟩ := mellin_strip_bound (hmc (((a+1)/2:ℝ):ℂ)) (hmc (((b+1)/2:ℝ):ℂ))
  refine ⟨C/2, by positivity, fun z hza hzb => ?_⟩
  rw [completedHurwitzZetaOdd, hP.Λ_eq, norm_div, Complex.norm_ofNat]
  have he : ((z+1)/(2:ℂ)).re = (z.re+1)/2 := by rw [Complex.div_ofNat_re]; simp
  apply div_le_div_of_nonneg_right _ (by norm_num)
  exact h ((z+1)/2) (by rw [he]; linarith) (by rw [he]; linarith)

/-- For a nonprincipal character of modulus greater than one, the completed
L-function is uniformly bounded in every fixed closed vertical strip. -/
theorem completedLFunction_strip_bound {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hq : 1 < q) (hχ : χ ≠ 1) (a b : ℝ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, a ≤ z.re → z.re ≤ b → ‖χ.completedLFunction z‖ ≤ C := by
  classical
  have hq1 : (1:ℝ) ≤ q := by exact_mod_cast hq.le
  have hq0 : (0:ℝ) < q := by linarith
  choose E hE hEe using fun j : ZMod q => completed_even_bounded (ZMod.toAddCircle j) a b
  choose O hO hOo using fun j : ZMod q => completed_odd_bounded (ZMod.toAddCircle j) a b
  let C := ∑ j : ZMod q, ‖χ j‖ * (E j+O j)
  have hC : 0 ≤ C := Finset.sum_nonneg fun j _ => mul_nonneg (norm_nonneg _) (add_nonneg (hE j) (hO j))
  refine ⟨(q:ℝ)^(-a)*C, by positivity, fun z hza hzb => ?_⟩
  have he : χ.completedLFunction z = (q:ℂ)^(-z) * ∑ j : ZMod q,
      χ j * (completedHurwitzZetaEven₀ (ZMod.toAddCircle j) z + completedHurwitzZetaOdd (ZMod.toAddCircle j) z) := by
    rw [DirichletCharacter.completedLFunction, ZMod.completedLFunction_eq, ZMod.completedLFunction₀,
      χ.map_zero' (by omega), χ.sum_eq_zero_of_ne_one hχ]
    simp only [mul_zero, zero_div, sub_zero, mul_add, Finset.sum_add_distrib]
  rw [he, norm_mul]
  refine mul_le_mul ?_ ((norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)) (norm_nonneg _) (by positivity)
  · rw [← Complex.ofReal_natCast, Complex.norm_cpow_eq_rpow_re_of_pos hq0, Complex.neg_re]
    exact Real.rpow_le_rpow_of_exponent_le hq1 (neg_le_neg hza)
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_left
      ((norm_add_le _ _).trans (add_le_add (hEe j z hza hzb) (hOo j z hza hzb))) (norm_nonneg _)

private theorem gammaR_high_strip_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, (7:ℝ)/4 ≤ z.re → z.re ≤ 11/2 → ‖Complex.Gammaℝ z‖ ≤ C := by
  let a : ℝ := 7/8
  let b : ℝ := 11/4
  have ha : 0 < a := by norm_num [a]
  have hb : 0 < b := by norm_num [b]
  let C := Real.Gamma a + Real.Gamma b
  have hC : 0 ≤ C := add_nonneg (Real.Gamma_pos_of_pos ha).le (Real.Gamma_pos_of_pos hb).le
  refine ⟨C,hC,fun z hzlo hzhi => ?_⟩
  have hzre : (z/(2:ℂ)).re = z.re/2 := Complex.div_ofNat_re _ _
  have hlo : a ≤ (z/(2:ℂ)).re := by rw [hzre]; dsimp [a]; linarith
  have hhi : (z/(2:ℂ)).re ≤ b := by rw [hzre]; dsimp [b]; linarith
  have hgam : ‖Complex.Gamma (z/2)‖ ≤ C := by
    dsimp only [C]
    rw [Complex.Gamma_eq_integral (ha.trans_le hlo), Complex.GammaIntegral,
      Real.Gamma_eq_integral ha, Real.Gamma_eq_integral hb]
    have hi₁ := Real.GammaIntegral_convergent ha
    have hi₂ := Real.GammaIntegral_convergent hb
    rw [← integral_add hi₁ hi₂]
    apply norm_integral_le_of_norm_le (hi₁.add hi₂)
    filter_upwards [ae_restrict_mem (μ := volume) (measurableSet_Ioi (a := (0:ℝ)))] with x hx
    have hx₀ : 0 < x := hx
    rw [norm_mul, Complex.norm_of_nonneg (Real.exp_nonneg (-x)),
      Complex.norm_cpow_eq_rpow_re_of_pos hx₀, Complex.sub_re, Complex.one_re]
    by_cases h : x ≤ 1
    · exact (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hx₀ h
        (sub_le_sub_right hlo 1)) (Real.exp_nonneg _)).trans
        (le_add_of_nonneg_right (mul_nonneg (Real.exp_nonneg _) (Real.rpow_nonneg hx₀.le _)))
    · exact (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le (le_of_not_ge h)
        (sub_le_sub_right hhi 1)) (Real.exp_nonneg _)).trans
        (le_add_of_nonneg_left (mul_nonneg (Real.exp_nonneg _) (Real.rpow_nonneg hx₀.le _)))
  have hpow : ‖(Real.pi:ℂ)^(-z/2)‖ ≤ 1 := by
    rw [Complex.norm_cpow_eq_rpow_re_of_pos Real.pi_pos, Complex.div_ofNat_re, Complex.neg_re]
    exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith [Real.pi_gt_three]) (by linarith)
  rw [Complex.Gammaℝ_def, norm_mul]
  exact (mul_le_mul hpow hgam (norm_nonneg _) zero_le_one).trans_eq (one_mul _)

private theorem norm_cos_le_exp_abs_im (z : ℂ) : ‖Complex.cos z‖ ≤ Real.exp |z.im| := by
  have h₁ : ‖Complex.exp (z * Complex.I)‖ ≤ Real.exp |z.im| := by
    rw [Complex.norm_exp, Real.exp_le_exp]
    simpa [Complex.mul_re] using neg_le_abs z.im
  have h₂ : ‖Complex.exp (-z * Complex.I)‖ ≤ Real.exp |z.im| := by
    rw [Complex.norm_exp, Real.exp_le_exp]
    simpa [Complex.mul_re] using le_abs_self z.im
  rw [Complex.cos, norm_div, Complex.norm_ofNat]
  exact (div_le_iff₀ (by norm_num)).mpr ((norm_add_le _ _).trans (by linarith))

private theorem gammaR_ne_zero_of_im_ne_zero {z : ℂ} (hz : z.im ≠ 0) : Complex.Gammaℝ z ≠ 0 := by
  rw [Ne, Complex.Gammaℝ_eq_zero_iff]
  rintro ⟨n,hn⟩
  exact hz (by rw [hn]; simp [Complex.mul_im])

/-- A coarse exponential bound for the reciprocal gamma factor, including
the values where the totalized Gamma function vanishes. -/
theorem gammaR_inv_exp_growth :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, -(3:ℝ)/2 ≤ z.re → z.re ≤ 9/4 →
      ‖(Complex.Gammaℝ z)⁻¹‖ ≤ C * Real.exp (Real.pi/2 * |z.im|) := by
  obtain ⟨C,hC,hΓ⟩ := gammaR_high_strip_bound
  obtain ⟨K,hK⟩ := (isCompact_closedBall (0:ℂ) 4).exists_bound_of_continuousOn
    Complex.differentiable_Gammaℝ_inv.continuous.continuousOn
  let A := C * 2 * Real.pi
  have hA : 0 ≤ A := by dsimp [A]; positivity
  refine ⟨max K A, hA.trans (le_max_right _ _), fun z hlo hhi => ?_⟩
  by_cases hlarge : 1 ≤ |z.im|
  · let w := 2-z
    have hIm : w.im = -z.im := by simp [w]
    have hIm0 : w.im ≠ 0 := by
      rw [hIm]
      intro h
      have hz0 : z.im = 0 := by linarith
      norm_num [hz0] at hlarge
    have hW : w ≠ 0 := fun h => hIm0 (by simp [h])
    have hWnorm : 1 ≤ ‖w‖ := hlarge.trans (by rw [← abs_neg z.im, ← hIm]; exact Complex.abs_im_le_norm _)
    have hRe : (w+2).re = 4-z.re := by simp [w]; ring
    have hWΓ : ‖Complex.Gammaℝ (w+2)‖ ≤ C :=
      hΓ _ (by rw [hRe]; linarith) (by rw [hRe]; linarith)
    have hRec := congrArg (fun ζ : ℂ => ‖ζ‖) (Complex.Gammaℝ_add_two hW)
    simp only [norm_div, norm_mul, Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos Real.pi_pos] at hRec
    have hrec := (eq_div_iff (by norm_num : (2:ℝ) ≠ 0)).mp ((eq_div_iff Real.pi_pos.ne').mp hRec)
    have hsmall : ‖Complex.Gammaℝ w‖ ≤ A := calc
      _ ≤ ‖Complex.Gammaℝ w‖ * ‖w‖ := le_mul_of_one_le_right (norm_nonneg _) hWnorm
      _ = (‖Complex.Gammaℝ (w+2)‖ * Real.pi) * 2 := hrec.symm
      _ ≤ (C * Real.pi) * 2 := by gcongr
      _ = A := by dsimp [A]; ring
    have hΓne := gammaR_ne_zero_of_im_ne_zero hIm0
    let u : ℂ := (Real.pi:ℂ) * (1-z) / 2
    have hReflect : Complex.Gammaℝ z * Complex.Gammaℝ w = (Complex.cos u)⁻¹ := by
      simpa only [show 1-(1-z) = z by ring, show 1+(1-z)=w by dsimp [w]; ring,u] using
        (Complex.Gammaℝ_one_sub_mul_Gammaℝ_one_add (1-z))
    have hInv := congrArg (fun ζ : ℂ => ζ⁻¹) hReflect
    simp only [mul_inv, inv_inv] at hInv
    have hIdent : (Complex.Gammaℝ z)⁻¹ = Complex.cos u * Complex.Gammaℝ w := calc
      _ = (Complex.Gammaℝ z)⁻¹ * (Complex.Gammaℝ w)⁻¹ * Complex.Gammaℝ w := by
        rw [mul_assoc, inv_mul_cancel₀ hΓne, mul_one]
      _ = _ := by rw [hInv]
    have harg : |u.im| = Real.pi/2 * |z.im| := by
      have he : u.im = (Real.pi/2) * -z.im := by
        dsimp [u]
        rw [Complex.div_ofNat_im]
        simp [Complex.mul_im]
        ring
      rw [he, abs_mul, abs_of_nonneg (by positivity : 0 ≤ Real.pi/2), abs_neg]
    rw [hIdent, norm_mul, mul_comm]
    exact (mul_le_mul hsmall (harg ▸ norm_cos_le_exp_abs_im u) (norm_nonneg _) hA).trans
      (mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.exp_nonneg _))
  · have hre : |z.re| ≤ 9/4 := abs_le.mpr ⟨by linarith, hhi⟩
    have hz : z ∈ Metric.closedBall (0:ℂ) 4 := by
      rw [Metric.mem_closedBall, dist_zero_right]
      have h := Complex.norm_le_abs_re_add_abs_im z
      linarith [lt_of_not_ge hlarge]
    have hmax : 0 ≤ max K A := hA.trans (le_max_right _ _)
    exact ((hK z hz).trans (le_max_left _ _)).trans
      (le_mul_of_one_le_right hmax (Real.one_le_exp (by positivity)))

/-- Exponential growth on the entire L-function strip required by the initial
Mellin translation from Re(w)=3/4 to Re(w)=-2. -/
theorem LFunction_exp_growth {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hq : 1 < q) (hχ : χ ≠ 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ z : ℂ, -(3:ℝ)/2 ≤ z.re → z.re ≤ 5/4 →
      ‖χ.LFunction z‖ ≤ C * Real.exp (Real.pi/2 * |z.im|) := by
  obtain ⟨A,hA,hFin⟩ := completedLFunction_strip_bound χ hq hχ (-(3:ℝ)/2) (5/4)
  obtain ⟨B,hB,hΓ⟩ := gammaR_inv_exp_growth
  refine ⟨A*B,mul_nonneg hA hB,fun z hl hr => ?_⟩
  have hG : ‖(χ.gammaFactor z)⁻¹‖ ≤ B * Real.exp (Real.pi/2 * |z.im|) := by
    rcases χ.even_or_odd with hEven | hOdd
    · rw [hEven.gammaFactor_def]
      exact hΓ z hl (by linarith)
    · rw [hOdd.gammaFactor_def]
      simpa using hΓ (z+1) (by simp; linarith) (by simp; linarith)
  rw [χ.LFunction_eq_completed_div_gammaFactor z (Or.inr (Nat.ne_of_gt hq)),
    div_eq_mul_inv, norm_mul, mul_assoc]
  exact mul_le_mul (hFin z hl hr) hG (norm_nonneg _) hA

private theorem compact_mellin_regular {g : ℝ → ℂ} (hg : Continuous g)
    (hs : ∀ x ∉ Icc (1:ℝ) 4, g x = 0) (z : ℂ) :
    MellinConvergent g z ∧ DifferentiableAt ℂ (mellin g) z := by
  have hi : LocallyIntegrableOn g (Ioi (0:ℝ)) volume :=
    hg.continuousOn.locallyIntegrableOn measurableSet_Ioi
  have ht (r : ℝ) : g =O[atTop] (fun x : ℝ => x^r) := by
    apply Asymptotics.IsBigO.of_bound 0
    filter_upwards [eventually_gt_atTop (4:ℝ)] with x hx
    rw [hs x (fun h => hx.not_ge h.2), norm_zero, zero_mul]
  have hb (r : ℝ) : g =O[𝓝[>] (0:ℝ)] (fun x : ℝ => x^r) := by
    apply Asymptotics.IsBigO.of_bound 0
    have h₀ : Iio (1:ℝ) ∈ 𝓝[>] (0:ℝ) := mem_nhdsWithin_of_mem_nhds (Iio_mem_nhds zero_lt_one)
    filter_upwards [h₀] with x hx
    rw [hs x (fun h => (show x < 1 from hx).not_ge h.1), norm_zero, zero_mul]
  have hUpper : z.re < z.re+1 := by linarith
  have hLower : z.re-1 < z.re := by linarith
  exact ⟨mellinConvergent_of_isBigO_rpow hi (ht _) hUpper (hb _) hLower,
    mellin_differentiableAt_of_isBigO_rpow hi (ht _) hUpper (hb _) hLower⟩

/-- The unexpanded L-function integrand before applying the functional equation. -/
noncomputable def initialKernel {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (N : ℝ) (g : ℝ → ℂ) (s₀ w : ℂ) : ℂ :=
  χ.LFunction (s₀+w) * (N:ℂ)^w * mellin g w

/-- The initial integrand is entire and has the requisite exponential strip
bound, with no extra analytic assumptions on the L-function. -/
theorem initialKernel_regular {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hq : 1 < q) (hχ : χ ≠ 1) {N : ℝ} (hN : 1 ≤ N) {g : ℝ → ℂ}
    (hg : Continuous g) (hs : ∀ x ∉ Icc (1:ℝ) 4, g x = 0) {s₀ : ℂ} (h₀ : s₀.re = 1/2) :
    Differentiable ℂ (initialKernel χ N g s₀) ∧ ∃ C : ℝ, 0 ≤ C ∧
      ∀ w ∈ ShortAPContourShift.strip (-2) (3/4),
        ‖initialKernel χ N g s₀ w‖ ≤ C * Real.exp (Real.pi/2 * |w.im|) := by
  have hNp : 0 < N := zero_lt_one.trans_le hN
  refine ⟨?_,?_⟩
  · have h₁ := (DirichletCharacter.differentiable_LFunction hχ).comp (differentiable_id.const_add s₀)
    have h₂ : Differentiable ℂ (fun w : ℂ => (N:ℂ)^w) := by
      intro z
      exact differentiableAt_id.const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr hNp.ne'))
    have h₃ : Differentiable ℂ (mellin g) := fun z => (compact_mellin_regular hg hs z).2
    exact (h₁.mul h₂).mul h₃
  · obtain ⟨A,hA,hL⟩ := LFunction_exp_growth χ hq hχ
    obtain ⟨B,hB,hM⟩ := mellin_strip_bound (a := -2) (b := 3/4)
      (compact_mellin_regular hg hs _).1 (compact_mellin_regular hg hs _).1
    refine ⟨A*(N^((3:ℝ)/4))*B*Real.exp (Real.pi/2*|s₀.im|), by positivity, fun w hw => ?_⟩
    have hw' : (-2:ℝ) ≤ w.re ∧ w.re ≤ 3/4 := hw
    have hp : ‖(N:ℂ)^w‖ ≤ N^((3:ℝ)/4) := by
      rw [Complex.norm_cpow_eq_rpow_re_of_pos hNp]
      exact Real.rpow_le_rpow_of_exponent_le hN hw'.2
    have hLg := hL (s₀+w) (by rw [Complex.add_re,h₀]; linarith [hw'.1])
      (by rw [Complex.add_re,h₀]; linarith [hw'.2])
    have hExp : Real.exp (Real.pi/2*|(s₀+w).im|) ≤
        Real.exp (Real.pi/2*|s₀.im|)*Real.exp (Real.pi/2*|w.im|) := by
      rw [← Real.exp_add, Real.exp_le_exp, Complex.add_im, ← mul_add]
      exact mul_le_mul_of_nonneg_left (abs_add_le _ _) (by positivity)
    have hMg : ‖mellin g w‖ ≤ B := hM w (by simpa using hw'.1) (by simpa using hw'.2)
    rw [initialKernel,norm_mul,norm_mul]
    calc
      _ ≤ (A*Real.exp (Real.pi/2*|(s₀+w).im|)) * N^((3:ℝ)/4) * B :=
        mul_le_mul (mul_le_mul hLg hp (norm_nonneg _) (by positivity)) hMg (norm_nonneg _) (by positivity)
      _ ≤ (A*(Real.exp (Real.pi/2*|s₀.im|)*Real.exp (Real.pi/2*|w.im|))) * N^((3:ℝ)/4) * B := by
        gcongr
      _ = _ := by ring

/-- Initial contour translation for a primitive character of modulus greater
than one. Only the L¹ estimates on the two boundary lines are still inputs. -/
theorem initialKernel_vertical_integral_eq {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q)
    (hq : 1 < q) (hχ : χ.IsPrimitive) {N : ℝ} (hN : 1 ≤ N) {g : ℝ → ℂ}
    (hg : Continuous g) (hs : ∀ x ∉ Icc (1:ℝ) 4, g x = 0) {s₀ : ℂ} (h₀ : s₀.re = 1/2)
    (hLeft : Integrable (fun t : ℝ => initialKernel χ N g s₀ (-2+(t:ℂ)*Complex.I)))
    (hRight : Integrable (fun t : ℝ => initialKernel χ N g s₀ ((3:ℂ)/4+(t:ℂ)*Complex.I))) :
    (∫ t : ℝ, initialKernel χ N g s₀ (-2+(t:ℂ)*Complex.I)) =
      ∫ t : ℝ, initialKernel χ N g s₀ ((3:ℂ)/4+(t:ℂ)*Complex.I) := by
  have hnon : χ ≠ 1 := by
    intro h
    rw [DirichletCharacter.IsPrimitive,h,DirichletCharacter.conductor_one] at hχ
    omega
  obtain ⟨hd,C,hC,hg'⟩ := initialKernel_regular χ hq hnon hN hg hs h₀
  have hh := ShortAPContourShift.vertical_integral_eq_of_exp_growth
    (a := -2) (b := 3/4) (by norm_num) hC hd.differentiableOn hg'
    (by simpa using hLeft) (by simpa using hRight)
  simpa using hh

end ShortAPInitialLShift

end

section

open Filter MeasureTheory Set
open scoped Topology

namespace ShortAPDualEndpoints

open ShortAPContourShift

private theorem continuous_mellin_supported {g : ℝ → ℂ} (hg : Continuous g)
    (hs : ∀ x ∉ Icc (1 : ℝ) 4, g x = 0) : Continuous (mellin g) := by
  apply Differentiable.continuous (𝕜 := ℂ)
  intro s
  apply mellin_differentiableAt_of_isBigO_rpow (a := s.re + 1) (b := s.re - 1)
  · exact hg.continuousOn.locallyIntegrableOn measurableSet_Ioi
  · apply Asymptotics.IsBigO.of_bound 0
    filter_upwards [eventually_gt_atTop (4 : ℝ)] with x hx
    rw [hs x (fun h => hx.not_ge h.2), norm_zero, zero_mul]
  · linarith
  · apply Asymptotics.IsBigO.of_bound 0
    have h₀ : Iio (1 : ℝ) ∈ 𝓝[>] (0 : ℝ) :=
      mem_nhdsWithin_of_mem_nhds (Iio_mem_nhds zero_lt_one)
    filter_upwards [h₀] with x hx
    rw [hs x (fun h => (show x < 1 from hx).not_ge h.1), norm_zero, zero_mul]
  · linarith

private theorem cauchy_domination (k : ℕ) (v : ℝ) :
    (1 + |v|) ^ k / (1 + |v| ^ (k + 2)) ≤ (2 : ℝ) ^ (k + 1) * (1 + v ^ 2)⁻¹ := by
  rw [← div_eq_mul_inv]
  apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
  rw [← sq_abs v]
  generalize hxv : |v| = x
  have hx : 0 ≤ x := hxv ▸ abs_nonneg v
  by_cases h : x ≤ 1
  · have hp : (1 + x) ^ k ≤ (2 : ℝ) ^ k :=
      pow_le_pow_left₀ (by positivity) (by linarith) _
    have hs : x ^ 2 ≤ (1 : ℝ) := by simpa using pow_le_pow_left₀ hx h 2
    calc
      _ ≤ (2 : ℝ) ^ k * 2 := mul_le_mul hp (by linarith) (by positivity) (by positivity)
      _ = (2 : ℝ) ^ (k + 1) := by rw [pow_succ]
      _ ≤ _ := le_mul_of_one_le_right (by positivity) (le_add_of_nonneg_right (pow_nonneg hx _))
  · have h' : 1 ≤ x := (lt_of_not_ge h).le
    have hp : (1 + x) ^ k ≤ (2 * x) ^ k :=
      pow_le_pow_left₀ (by positivity) (by linarith) _
    have hs : (1 : ℝ) ≤ x ^ 2 := one_le_pow₀ h'
    calc
      _ ≤ (2 * x) ^ k * (2 * x ^ 2) :=
        mul_le_mul hp (by linarith) (by positivity) (by positivity)
      _ = (2 : ℝ) ^ (k + 1) * x ^ (k + 2) := by
        rw [mul_pow, pow_succ (a := (2 : ℝ)), pow_add]
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (le_add_of_nonneg_left zero_le_one) (by positivity)

/-- The exact Gamma–Mellin kernel is absolutely integrable on every vertical
line `Re(z) = 1/2 + 2m`, including the critical line when `m = 0`. -/
theorem dualKernel_vertical_integrable (odd : Bool) {x : ℝ} (hx : 0 < x)
    {g : ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hs : ∀ u ∉ Icc (1 : ℝ) 4, g u = 0) (s₀ : ℂ) (m : ℕ) :
    Complex.VerticalIntegrable (dualKernel odd x g s₀) (1 / 2 + 2 * (m : ℝ)) := by
  let σ := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let k := 2 * m
  let z (t : ℝ) : ℂ := (σ : ℂ) + (t : ℂ) * Complex.I
  let a : ℝ := if odd then 1 else 0
  have hσ : 0 < σ := by dsimp only [σ]; positivity
  have ha : a ∈ Icc (0 : ℝ) 1 := by cases odd <;> norm_num [a]
  obtain ⟨CΓ, hCΓ, hΓ⟩ := ShortAPDualPolynomial.gamma_ratio_vertical_growth a ha m
  obtain ⟨CM, hCM, hM⟩ := ShortAPDualPolynomial.mellin_vertical_decay g hg hs (s₀.re - σ) (k + 2)
  let D := x ^ (-σ) * CΓ * CM * (1 + |s₀.im|) ^ k
  have hD : 0 ≤ D := by dsimp only [D]; positivity
  have hr (t : ℝ) : (z t).re = σ := by simp [z]
  have hΓ' (t : ℝ) : ‖gammaKernel odd (z t)‖ ≤ CΓ * (1 + |t|) ^ k := by
    rw [gammaKernel_eq_ratio odd (by simpa only [hr] using hσ)]
    cases odd <;> simpa [a, z, σ, k] using hΓ t
  have hM' (t : ℝ) : ‖mellin g (s₀ - z t)‖ ≤ CM / (1 + |t - s₀.im| ^ (k + 2)) := by
    have he : s₀ - z t = ((s₀.re - σ : ℝ) : ℂ) + ((-(t - s₀.im) : ℝ) : ℂ) * Complex.I := by
      apply Complex.ext <;> simp [z, Complex.sub_re, Complex.sub_im, neg_sub]
    rw [he]
    simpa only [abs_neg] using hM (-(t - s₀.im))
  have hpoint (t : ℝ) :
      ‖dualKernel odd x g s₀ (z t)‖ ≤ D * (2 : ℝ) ^ (k + 1) * (1 + (t - s₀.im) ^ 2)⁻¹ := by
    have ht : |t| ≤ |s₀.im| + |t - s₀.im| := by
      have he : s₀.im + (t - s₀.im) = t := by ring
      simpa only [he] using abs_add_le s₀.im (t - s₀.im)
    have ht' : 1 + |t| ≤ (1 + |s₀.im|) * (1 + |t - s₀.im|) := by
      nlinarith [mul_nonneg (abs_nonneg s₀.im) (abs_nonneg (t - s₀.im))]
    rw [dualKernel, norm_mul, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hx, Complex.neg_re, hr]
    calc
      _ ≤ (x ^ (-σ) * (CΓ * (1 + |t|) ^ k)) * (CM / (1 + |t - s₀.im| ^ (k + 2))) :=
        mul_le_mul (mul_le_mul_of_nonneg_left (hΓ' t) (by positivity)) (hM' t)
          (norm_nonneg _) (by positivity)
      _ ≤ (x ^ (-σ) * (CΓ * ((1 + |s₀.im|) * (1 + |t - s₀.im|)) ^ k)) *
          (CM / (1 + |t - s₀.im| ^ (k + 2))) := by
        apply mul_le_mul_of_nonneg_right _ (by positivity)
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) ht' _) hCΓ) (by positivity)
      _ = D * ((1 + |t - s₀.im|) ^ k / (1 + |t - s₀.im| ^ (k + 2))) := by
        dsimp only [D]
        rw [mul_pow]
        ring
      _ ≤ _ := by
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_left (cauchy_domination k (t - s₀.im)) hD
  have hzcont : Continuous z := by unfold z; fun_prop
  have hΓcont : Continuous (fun t : ℝ => gammaKernel odd (z t)) := by
    rw [← continuousOn_univ]
    apply (differentiableOn_gammaKernel odd (b := σ) hσ).continuousOn.comp hzcont.continuousOn
    intro t _
    show (z t).re ∈ Icc σ σ
    simp only [hr, mem_Icc, le_refl, and_self]
  have hpow : Continuous (fun y : ℂ => (x : ℂ) ^ (-y)) := by
    apply Differentiable.continuous (𝕜 := ℂ)
    intro y
    exact (differentiableAt_id.neg).const_cpow (Or.inl (Complex.ofReal_ne_zero.mpr hx.ne'))
  have hMcont : Continuous (fun t : ℝ => mellin g (s₀ - z t)) :=
    (continuous_mellin_supported hg.continuous hs).comp (continuous_const.sub hzcont)
  have hcont : Continuous (fun t : ℝ => dualKernel odd x g s₀ (z t)) :=
    ((hpow.comp hzcont).mul hΓcont).mul hMcont
  change Integrable (fun t : ℝ => dualKernel odd x g s₀ (z t))
  exact ((integrable_inv_one_add_sq.comp_sub_right s₀.im).const_mul (D * (2 : ℝ) ^ (k + 1))).mono'
    hcont.aestronglyMeasurable (Eventually.of_forall hpoint)

private noncomputable def lineIntegral (f : ℂ → ℂ) (a : ℝ) : ℂ :=
  ∫ t : ℝ, f ((a : ℂ) + (t : ℂ) * Complex.I)

private theorem shift_at_endpoints (odd : Bool) {x a b : ℝ} (hx : 0 < x)
    (ha : 0 < a) (hab : a ≤ b) {g : ℝ → ℂ} (hg : Continuous g)
    (hs : ∀ u ∉ Icc (1 : ℝ) 4, g u = 0) (s₀ : ℂ)
    (hL : Complex.VerticalIntegrable (dualKernel odd x g s₀) a)
    (hR : Complex.VerticalIntegrable (dualKernel odd x g s₀) b) :
    lineIntegral (dualKernel odd x g s₀) a = lineIntegral (dualKernel odd x g s₀) b :=
  @ShortAPContourShift.dualKernel_vertical_integral_eq odd x a b hx ha hab g hg hs s₀ hL hR

/-- Any two lines of the form `1/2 + 2m` give the same integral. -/
theorem dualKernel_vertical_integral_eq_between (odd : Bool) {x : ℝ} (hx : 0 < x)
    {g : ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hs : ∀ u ∉ Icc (1 : ℝ) 4, g u = 0) (s₀ : ℂ) (m n : ℕ) :
    (∫ t : ℝ, dualKernel odd x g s₀ (((1 / 2 + 2 * (m : ℝ) : ℝ) : ℂ) + (t : ℂ) * Complex.I)) =
      ∫ t : ℝ, dualKernel odd x g s₀ (((1 / 2 + 2 * (n : ℝ) : ℝ) : ℂ) + (t : ℂ) * Complex.I) := by
  let σ (k : ℕ) := (1 / 2 : ℝ) + 2 * (k : ℝ)
  have hsigma (k : ℕ) : 0 < σ k := by dsimp only [σ]; positivity
  have hsigma_mono : Monotone σ := by
    intro i j hij
    dsimp only [σ]
    gcongr
  let F := dualKernel odd x g s₀
  have hV (i : ℕ) : Complex.VerticalIntegrable F (σ i) :=
    dualKernel_vertical_integrable odd hx hg hs s₀ i
  have shift (i j : ℕ) (h : i ≤ j) :
      lineIntegral F (σ i) = lineIntegral F (σ j) :=
    @shift_at_endpoints odd x (σ i) (σ j) hx (hsigma i) (hsigma_mono h) g hg.continuous hs s₀ (hV i) (hV j)
  have hh : lineIntegral F (σ m) = lineIntegral F (σ n) := by
    rcases le_total m n with h | h
    · exact shift m n h
    · exact (shift n m h).symm
  exact hh

/-- Move the Gamma–Mellin contour from the critical line to
`Re(z) = 1/2 + 2m`, with no separate endpoint-integrability hypotheses. -/
theorem dualKernel_vertical_integral_eq_critical_to (odd : Bool) {x : ℝ} (hx : 0 < x)
    {g : ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hs : ∀ u ∉ Icc (1 : ℝ) 4, g u = 0) (s₀ : ℂ) (m : ℕ) :
    (∫ t : ℝ, dualKernel odd x g s₀ (((1 / 2 : ℝ) : ℂ) + (t : ℂ) * Complex.I)) =
      ∫ t : ℝ, dualKernel odd x g s₀ (((1 / 2 + 2 * (m : ℝ) : ℝ) : ℂ) + (t : ℂ) * Complex.I) := by
  simpa only [Nat.cast_zero, mul_zero, add_zero] using
    dualKernel_vertical_integral_eq_between odd hx hg hs s₀ 0 m

end ShortAPDualEndpoints

end

section

open MeasureTheory Filter

namespace ShortAPActualDualTail

open ShortAPContourShift

private theorem sqrt_scale (m : ℕ) (N q n : ℝ) (hN : 0 < N) (hq : 0 < q) (hn : 0 ≤ n) :
    Real.sqrt (N / q) * (N * n / q) ^ (-(1 / 2 + 2 * (m : ℝ))) =
      (q / N) ^ (2 * m) * n ^ (-(1 / 2 + 2 * (m : ℝ))) := by
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  have hNq : 0 < N / q := div_pos hN hq
  have hbase : N * n / q = (N / q) * n := by ring
  have he : 1 / 2 + -A = -((2 * m : ℕ) : ℝ) := by
    dsimp only [A]
    push_cast
    ring
  change Real.sqrt (N / q) * (N * n / q) ^ (-A) = (q / N) ^ (2 * m) * n ^ (-A)
  rw [hbase, Real.sqrt_eq_rpow, Real.mul_rpow hNq.le hn, ← mul_assoc,
    ← Real.rpow_add hNq, he, Real.rpow_neg hNq.le, Real.rpow_natCast,
    ← inv_pow, inv_div]

/-- The actual per-term Gamma–Mellin kernel on the right vertical line has
an absolutely summable tail. The prefactor `sqrt(N/q)` gives the normalization
in Koukoulopoulos §3, Lemma 3.3. The inputs `ξ n` may in particular be the
values of the inverse Dirichlet character. -/
theorem actual_dual_tail (odd : Bool) {g : ℝ → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0) (m : ℕ) (hm : 1 ≤ m) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ q Q N T t δ : ℝ, 0 < q → q ≤ Q → 0 < N →
      1 ≤ T → |t| ≤ T → 0 < δ → ∀ ξ : ℕ → ℂ, (∀ n, ‖ξ n‖ ≤ 1) →
      let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
      let M := max 1 ((Q * T / N) ^ ((1 : ℝ) + δ))
      let s₀ : ℂ := 1 / 2 + (t : ℂ) * Complex.I
      let J (n : ℕ) : ℂ := ξ n * ∫ v : ℝ,
        dualKernel odd (N * (n : ℝ) / q) g s₀ ((A : ℂ) + (v : ℂ) * Complex.I)
      (Summable fun j : ℕ => ‖J (j + ⌊M⌋₊ + 1)‖) ∧
        ‖Real.sqrt (N / q) • (∑' j : ℕ, J (j + ⌊M⌋₊ + 1))‖ ≤
          C * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ)) := by
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let k := 2 * m
  let a : ℝ := if odd then 1 else 0
  have ha : a ∈ Set.Icc (0 : ℝ) 1 := by cases odd <;> norm_num [a]
  obtain ⟨CΓ, hCΓ, hΓ⟩ := ShortAPDualPolynomial.gamma_ratio_vertical_growth a ha m
  obtain ⟨CM, hCM, hM⟩ := ShortAPDualPolynomial.mellin_vertical_decay g hg hs (1 / 2 - A) (k + 2)
  let C := (CΓ * CM * (2 : ℝ) ^ (2 * k + 1) * Real.pi) * ((2 : ℝ) ^ (A - 1) / (A - 1))
  have hA : 1 < A := by
    have hm' : (1 : ℝ) ≤ m := by exact_mod_cast hm
    dsimp only [A]
    linarith
  have hC : 0 ≤ C := by dsimp only [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro q Q N T t δ hq hqQ hN hT ht hδ ξ hξ
  let M := max 1 ((Q * T / N) ^ ((1 : ℝ) + δ))
  let s₀ : ℂ := 1 / 2 + (t : ℂ) * Complex.I
  let z (v : ℝ) : ℂ := (A : ℂ) + (v : ℂ) * Complex.I
  let f (v : ℝ) : ℂ := gammaKernel odd (z v)
  let w (u : ℝ) : ℂ := mellin g (((1 / 2 - A : ℝ) : ℂ) + ((-u : ℝ) : ℂ) * Complex.I)
  let b (n : ℕ) : ℝ := N * (n : ℝ) / q
  let β := Real.sqrt (N / q)
  let J (n : ℕ) : ℂ := ξ n * ∫ v : ℝ, dualKernel odd (b n) g s₀ (z v)
  let p (n : ℕ) (u : ℝ) : ℂ := if n = 0 then 0 else
    ξ n * ((b n : ℝ) : ℂ) ^ (-(↑(t + u) * Complex.I))
  let E (n : ℕ) : ℂ := ((q / N) ^ k * (n : ℝ) ^ (-A)) •
    ∫ u : ℝ, f (t + u) * (w u * p n u)
  have hb (n : ℕ) (hn : 0 < n) : 0 < b n := by
    dsimp only [b]
    positivity
  have hβ : 0 < β := Real.sqrt_pos.mpr (div_pos hN hq)
  have hf (v : ℝ) : ‖f v‖ ≤ CΓ * (1 + |v|) ^ k := by
    have hz : 0 < (z v).re := by simpa [z] using zero_lt_one.trans hA
    dsimp only [f]
    rw [gammaKernel_eq_ratio odd hz]
    cases odd <;> simpa [a, z, A, k] using hΓ v
  have hw (u : ℝ) : ‖w u‖ ≤ CM / (1 + |u| ^ (k + 2)) := by
    simpa only [w, abs_neg] using hM (-u)
  have hp (n : ℕ) (u : ℝ) : ‖p n u‖ ≤ 1 := by
    dsimp only [p]
    split_ifs with hn
    · rw [norm_zero]
      exact zero_le_one
    · rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos (hb n (Nat.pos_of_ne_zero hn))]
      have hr : (-(↑(t + u) * Complex.I) : ℂ).re = 0 := by simp
      rw [hr, Real.rpow_zero, mul_one]
      exact hξ n
  have heq (n : ℕ) (hn : 0 < n) : E n = β • J n := by
    let H (v : ℝ) := dualKernel odd (b n) g s₀ (z v)
    have hbase : 0 ≤ b n := (hb n hn).le
    have hCbase : ((b n : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (hb n hn).ne'
    have hscale : β * (b n) ^ (-A) = (q / N) ^ k * (n : ℝ) ^ (-A) :=
      sqrt_scale m N q n hN hq (Nat.cast_nonneg n)
    have hscaleC : (((q / N) ^ k * (n : ℝ) ^ (-A) : ℝ) : ℂ) =
        (β : ℂ) * (((b n) ^ (-A) : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul, hscale]
    have hs0 (u : ℝ) :
        s₀ - z (t + u) = (((1 / 2 - A : ℝ) : ℂ)) + ((-u : ℝ) : ℂ) * Complex.I := by
      apply Complex.ext <;> simp [s₀, z, Complex.sub_re, Complex.sub_im]
    have hcp (u : ℝ) :
        ((b n : ℝ) : ℂ) ^ (-z (t + u)) =
          (((b n) ^ (-A) : ℝ) : ℂ) * ((b n : ℝ) : ℂ) ^ (-(↑(t + u) * Complex.I)) := by
      rw [show -z (t + u) = ((-A : ℝ) : ℂ) + -(↑(t + u) * Complex.I) by
        simp only [z, neg_add, Complex.ofReal_neg],
        Complex.cpow_add _ _ hCbase, Complex.ofReal_cpow hbase]
    calc
      E n = ∫ u : ℝ, ((q / N) ^ k * (n : ℝ) ^ (-A)) • (f (t + u) * (w u * p n u)) :=
        (integral_smul _ _).symm
      _ = ∫ u : ℝ, β • (ξ n * H (t + u)) := by
        apply integral_congr_ae
        filter_upwards [] with u
        dsimp only [H, dualKernel, f, w, p]
        rw [ite_eq_right hn.ne', hcp, hs0]
        simp only [Complex.real_smul, hscaleC]
        ring
      _ = β • (ξ n * ∫ u : ℝ, H (t + u)) := by rw [integral_smul, integral_const_mul]
      _ = β • J n := by rw [integral_add_left_eq_self]
  obtain ⟨hE, htail⟩ := ShortAPDualTruncation.dual_vertical_tail m hm
    q Q N T t δ CΓ CM hq.le hqQ hN hT ht hδ hCΓ hCM f w p hf hw hp
  have hEn (j : ℕ) : E (j + ⌊M⌋₊ + 1) = β • J (j + ⌊M⌋₊ + 1) :=
    heq _ (Nat.succ_pos _)
  change Summable (fun j : ℕ => ‖E (j + ⌊M⌋₊ + 1)‖) at hE
  change ‖∑' j : ℕ, E (j + ⌊M⌋₊ + 1)‖ ≤ C * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ)) at htail
  simp_rw [hEn] at hE htail
  have hJ : Summable (fun j : ℕ => ‖J (j + ⌊M⌋₊ + 1)‖) := by
    have h := hE.mul_left β⁻¹
    simp only [norm_smul, Real.norm_eq_abs, abs_of_pos hβ, ← mul_assoc,
      inv_mul_cancel₀ hβ.ne', one_mul] at h
    exact h
  change Summable (fun j : ℕ => ‖J (j + ⌊M⌋₊ + 1)‖) ∧
    ‖β • (∑' j : ℕ, J (j + ⌊M⌋₊ + 1))‖ ≤ C * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ))
  exact ⟨hJ, by rwa [(hJ.of_norm).tsum_const_smul β] at htail⟩

/-- On the first absolutely convergent dual line `Re(z) = 5/2`, the
actual tail is bounded by any desired negative power of the cutoff:
move each kernel to a sufficiently far-right line, then use the bound. -/
theorem actual_dual_tail_from_five_halves (odd : Bool) {g : ℝ → ℂ}
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hs : ∀ u ∉ Set.Icc (1 : ℝ) 4, g u = 0)
    (δ B : ℝ) (hδ : 0 < δ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ q Q N T t : ℝ, 0 < q → q ≤ Q → 0 < N →
      1 ≤ T → |t| ≤ T → ∀ ξ : ℕ → ℂ, (∀ n, ‖ξ n‖ ≤ 1) →
      let M := max 1 ((Q * T / N) ^ ((1 : ℝ) + δ))
      let s₀ : ℂ := 1 / 2 + (t : ℂ) * Complex.I
      let J (n : ℕ) : ℂ := ξ n * ∫ v : ℝ,
        dualKernel odd ((N / q) * (n : ℝ)) g s₀ ((((5 / 2 : ℝ)) : ℂ) + (v : ℂ) * Complex.I)
      (Summable fun j : ℕ => ‖J (j + ⌊M⌋₊ + 1)‖) ∧
        ‖Real.sqrt (N / q) • (∑' j : ℕ, J (j + ⌊M⌋₊ + 1))‖ ≤ C * M ^ (-B) := by
  have hd : 0 < 2 * δ := by positivity
  obtain ⟨m, hm⟩ := exists_nat_gt (max (1 : ℝ) ((B + 1 / 2) * (1 + δ) / (2 * δ)))
  have hm₁ : 1 ≤ m := by
    exact_mod_cast (le_of_lt ((le_max_left _ _).trans_lt hm) : (1 : ℝ) ≤ (m : ℝ))
  have hpow : 1 / 2 - 2 * (m : ℝ) * δ / (1 + δ) ≤ -B := by
    have hd' : 0 < 1 + δ := by linarith
    have h := (div_lt_iff₀ hd).mp ((le_max_right _ _).trans_lt hm)
    have h' : B + 1 / 2 < 2 * (m : ℝ) * δ / (1 + δ) :=
      (lt_div_iff₀ hd').mpr (by nlinarith)
    linarith
  obtain ⟨C, hC, htail⟩ := actual_dual_tail odd hg hs m hm₁
  refine ⟨C, hC, ?_⟩
  intro q Q N T t hq hqQ hN hT ht ξ hξ
  let A := (1 / 2 : ℝ) + 2 * (m : ℝ)
  let M := max 1 ((Q * T / N) ^ ((1 : ℝ) + δ))
  let s₀ : ℂ := 1 / 2 + (t : ℂ) * Complex.I
  let J (n : ℕ) : ℂ := ξ n * ∫ v : ℝ,
    dualKernel odd ((N / q) * (n : ℝ)) g s₀ ((((5 / 2 : ℝ)) : ℂ) + (v : ℂ) * Complex.I)
  let Jm (n : ℕ) : ℂ := ξ n * ∫ v : ℝ,
    dualKernel odd (N * (n : ℝ) / q) g s₀ ((A : ℂ) + (v : ℂ) * Complex.I)
  obtain ⟨hSum, hBound⟩ := htail q Q N T t δ hq hqQ hN hT ht hδ ξ hξ
  have he (n : ℕ) (hn : 0 < n) : J n = Jm n := by
    have hx : 0 < (N / q) * (n : ℝ) := by positivity
    have hb : N * (n : ℝ) / q = (N / q) * (n : ℝ) := by ring
    have hσ : (1 / 2 : ℝ) + 2 * ((1 : ℕ) : ℝ) = 5 / 2 := by norm_num
    have h := ShortAPDualEndpoints.dualKernel_vertical_integral_eq_between odd hx hg hs s₀ 1 m
    rw [hσ] at h
    dsimp only [J, Jm]
    rw [hb, h]
  have hj (j : ℕ) : Jm (j + ⌊M⌋₊ + 1) = J (j + ⌊M⌋₊ + 1) :=
    (he _ (Nat.succ_pos _)).symm
  change Summable (fun j : ℕ => ‖Jm (j + ⌊M⌋₊ + 1)‖) at hSum
  change ‖Real.sqrt (N / q) • (∑' j : ℕ, Jm (j + ⌊M⌋₊ + 1))‖ ≤
    C * M ^ (1 / 2 - 2 * (m : ℝ) * δ / (1 + δ)) at hBound
  simp only [hj] at hSum hBound
  exact ⟨hSum, hBound.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow_of_exponent_le (le_max_left _ _) hpow) hC)⟩

end ShortAPActualDualTail

