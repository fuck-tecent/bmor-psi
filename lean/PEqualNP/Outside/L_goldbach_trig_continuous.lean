import Mathlib

theorem PEqualNP.Outside.L_goldbach_trig_continuous :
    let E := fun x : ℝ => Complex.exp (((2*Real.pi*x:ℝ):ℂ)*Complex.I); let S := fun (n : ℕ) (w : ℕ → ℝ) (t : ℝ) => Finset.sum (Finset.range (n+1)) (fun k => (w k:ℂ)*E ((k:ℝ)*t)); ∀ n w, Continuous (S n w) := by
  dsimp only
  intro n w
  fun_prop
