open Set

namespace ShortAPVinogradovReciprocal
open OAI.Vg

/-- Quantitative reciprocal bound throughout a high-frequency Vinogradov
strip. Its exponential loss involves log q + log log |t|, not log |t|. -/
theorem reciprocal_on_strip :
    ∃ c C T : ℝ, 0<c ∧ 0<C ∧ 0<T ∧ ∀ (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q)
    (t : ℝ), T ≤ |t| → 1 ≤ V96 (2*t) →
    let W := V36 (2*t)
    let V := Vcw q (2*t)
    let r := c*W/V
    ∀ σ ∈ Icc (1-r) (1+2*r), DirichletCharacter.LFunction χ ((σ:ℂ)+Complex.I*(t:ℂ)) ≠ 0 ∧
      ‖(DirichletCharacter.LFunction χ ((σ:ℂ)+Complex.I*(t:ℂ)))⁻¹‖ ≤
        r⁻¹ * Real.exp (C * V) := by
  obtain ⟨a,K,T,ha,hK,hT,hz⟩ := V1bc
  obtain ⟨b,hb,_,hright⟩ := V1ks
  let c := min a (min b (1/32))
  have hc : 0<c := lt_min ha (lt_min hb (by norm_num))
  have hca : c ≤ a := min_le_left _ _
  have hcb : c ≤ b := (min_le_right _ _).trans (min_le_left _ _)
  have hcn : c ≤ 1/32 := (min_le_right _ _).trans (min_le_right _ _)
  refine ⟨c,3*c*K,T,hc,by positivity,hT,?_⟩
  intro q _ χ t ht hlog W V r σ hσ
  have hv : 1 ≤ V := V1h1 hlog
  have hv0 : 0<V := zero_lt_one.trans_le hv
  have hlog0 : 0<V96 (2*t) := zero_lt_one.trans_le hlog
  have hw0 : 0<W := Real.rpow_pos_of_pos hlog0 _
  have hw1 : W ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hlog (by norm_num)
  have hr : 0<r := div_pos (mul_pos hc hw0) hv0
  have hrcw : r ≤ c*W := div_le_self (mul_nonneg hc.le hw0.le) hv
  have hrc : r ≤ c := hrcw.trans (mul_le_of_le_one_right hc.le hw1)
  have hr' : r ≤ a*W/V := div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hca hw0.le) hv0.le
  have h2r : 2*r ≤ W/16 := by nlinarith [mul_le_mul_of_nonneg_right hcn hw0.le]
  let f := DirichletCharacter.LFunction χ
  let z := fun u : ℝ => (u:ℂ)+Complex.I*(t:ℂ)
  let D := K*V^2*(V96 (2*t))^((2:ℝ)/3)
  have hD : 0 ≤ D := mul_nonneg (mul_nonneg hK.le (sq_nonneg _)) (Real.rpow_nonneg hlog0.le _)
  have hreg (u : ℝ) (hu : u ∈ Icc (1-r) (1+2*r)) : f (z u) ≠ 0 ∧ ‖deriv f (z u)/f (z u)‖ ≤ D :=
    hz q χ t u ht (by linarith [hu.1]) (by linarith [hu.2])
  have hdiff (u : ℝ) : DifferentiableAt ℂ f (z u) := by
    apply χ.differentiableAt_LFunction _ (Or.inl ?_)
    intro hh
    have he := congrArg Complex.im hh
    simp [z] at he
    exact (ne_of_gt (hT.trans_le ht)) (by simp [he])
  have hseg (u : ℝ) (hu : u ∈ Icc σ (1+2*r)) : u ∈ Icc (1-r) (1+2*r) := ⟨hσ.1.trans hu.1, hu.2⟩
  have hhor := ShortAPReciprocalStrip.horizontal (f := f) (t := t) hσ.2
    (fun u _ => hdiff u) (fun u hu => (hreg u (hseg u hu)).1) (fun u hu => (hreg u (hseg u hu)).2)
  have he : D*(3*r) = 3*c*K*V := by
    change (K*V^2*(V96 (2*t))^((2:ℝ)/3))*(3*(c*V36 (2*t)/V)) = _
    rw [V36, Real.rpow_neg hlog0.le]
    field_simp
  have hlen : D*(1+2*r-σ) ≤ 3*c*K*V :=
    (mul_le_mul_of_nonneg_left (by linarith [hσ.1] : 1+2*r-σ ≤ 3*r) hD).trans_eq he
  have hbase : ‖(f (z (1+2*r)))⁻¹‖ ≤ r⁻¹ := by
    simpa only [V1a, mul_zero, add_zero, one_div, f,z] using hright r hr (hrc.trans hcb) q χ t
  exact ⟨(hreg σ hσ).1,hhor.trans (mul_le_mul hbase (Real.exp_le_exp.mpr hlen)
    (Real.exp_pos _).le (inv_nonneg.mpr hr.le))⟩

end ShortAPVinogradovReciprocal

end

section

open Finset ArithmeticFunction Filter ShortAPDyadicPartition ShortAPBoxedHB ShortAPSmoothedFactor
open scoped BigOperators ArithmeticFunction.Moebius ArithmeticFunction.zeta

namespace ShortAPSmallConductorProduct
noncomputable section

private theorem raw_coeff (H j i n : ℕ) (hn : 1 ≤ n) :
    |ShortAPHeathBrown.factor H j i n| ≤ 1 + Real.log n := by
  have hL := Real.log_nonneg (show 1 ≤ (n : ℝ) by exact_mod_cast hn)
  unfold ShortAPHeathBrown.factor
  split_ifs
  · simp [ArithmeticFunction.log_apply, abs_of_nonneg hL]
  · simp [ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt hn), hL]
  · rw [ShortAPHeathBrown.truncate_apply]
    split
    · have hm : |((μ n : ℤ) : ℝ)| ≤ 1 := by exact_mod_cast (@abs_moebius_le_one n)
      exact hm.trans (by linarith)
    · simp; linarith

private theorem coeff (H j i b n : ℕ) (hn : 1 ≤ n) :
    ‖complexCoeffs (boxFactor H j i b) n‖ ≤ 1 + Real.log n := by
  rw [complexCoeffs_apply, Complex.norm_real, Real.norm_eq_abs, boxFactor, piece_apply, abs_mul]
  refine (mul_le_of_le_one_left (abs_nonneg _) ?_).trans (raw_coeff H j i n hn)
  split
  · unfold sharpWeight; split <;> norm_num
  · exact (abs_of_nonneg (smoothWeight_nonneg _)).le.trans (smoothWeight_le_one _)

private theorem coeff_zero (H j i b n : ℕ) (hn : (n : ℝ) ≤ scale b) :
    complexCoeffs (boxFactor H j i b) n = 0 := by
  have ht : (n : ℝ) / scale b ≤ 1 := (div_le_one (scale_pos _)).2 hn
  rw [complexCoeffs_apply, boxFactor, piece_apply]
  split
  · simp [sharpWeight, not_lt.mpr ht]
  · simp [smoothWeight_zero_below ht]

/-- Sharp and smooth coefficients meet the moment estimate with total log degree one. -/
theorem sampling_coeff (H j i b n : ℕ) (hn : 1 ≤ n) :
    ‖complexCoeffs (boxFactor H j i b) n‖ ≤ (Real.log n)^logDegree i := by
  rw [complexCoeffs_apply, Complex.norm_real, Real.norm_eq_abs, boxFactor, piece_apply, abs_mul]
  apply (mul_le_of_le_one_left (abs_nonneg (ShortAPHeathBrown.factor H j i n)) (by
    split
    · unfold sharpWeight; split <;> norm_num
    · exact (abs_of_nonneg (smoothWeight_nonneg _)).le.trans (smoothWeight_le_one _))).trans
  have hL := Real.log_nonneg (show 1 ≤ (n : ℝ) by exact_mod_cast hn)
  unfold ShortAPHeathBrown.factor logDegree
  split_ifs
  · simp [ArithmeticFunction.log_apply, abs_of_nonneg hL]
  · simp [ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt hn)]
  · rw [ShortAPHeathBrown.truncate_apply]
    split
    · simpa using (show |((μ n : ℤ) : ℝ)| ≤ 1 by exact_mod_cast (@abs_moebius_le_one n))
    · simp

theorem sampling_support (H j i b n : ℕ) (hn : ⌊4*scale b⌋₊ < n) :
    complexCoeffs (boxFactor H j i b) n = 0 := by
  have hf : 4*scale b < (n:ℝ) := (Nat.floor_lt (mul_nonneg (by norm_num) (scale_pos b).le)).mp hn
  have ht : 4 ≤ (n : ℝ) / scale b := (le_div_iff₀ (scale_pos _)).2 hf.le
  rw [complexCoeffs_apply, boxFactor, piece_apply]
  split
  · simp [sharpWeight, show ¬ (n : ℝ)/scale b ≤ 2 by linarith]
  · simp [smoothWeight_zero_above ht]

theorem sampling_degree (j : ℕ) : (∑ k ∈ (blockIndices j).attach, logDegree k.val) ≤ 1 := by
  rw [Finset.sum_attach]
  simp [logDegree, Finset.sum_ite_eq', blockIndices]

/-- Uniform elementary estimate for every actual factor, including the truncated
Möbius factors, on the entire critical line. The extra one is the first amplitude bin. -/
theorem box_amplitude (H j i b : ℕ) {q : ℕ} [NeZero q] (χ : DirichletCharacter ℂ q) (t : ℝ) :
    ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ + 1 ≤
      6 * Real.sqrt (scale b) * (1 + Real.log (4 * scale b)) := by
  let N := scale b
  have hn0 : 0 < N := scale_pos _
  have hn2 : 1/2 ≤ N := one_half_le_scale _
  have hL := Real.log_nonneg (show 1 ≤ 4*N by linarith)
  have hS := Real.sqrt_pos.2 hn0
  have hSq := Real.sq_sqrt hn0.le
  have hfloor := Nat.floor_le (show 0 ≤ 4*N by positivity)
  let B := (1 + Real.log (4*N)) / Real.sqrt N
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hb : ‖boxPolynomial H j i b χ (1 / 2 + (t : ℂ) * Complex.I)‖ ≤
      4*N * B := by
    unfold boxPolynomial ShortAPFactorSampling.factor
    refine (norm_sum_le _ _).trans ?_
    calc
      _ ≤ ∑ _n ∈ Icc 1 ⌊4*N⌋₊, B := by
        apply sum_le_sum
        intro n hn
        obtain ⟨h1, h2⟩ := mem_Icc.mp hn
        have h1r : 0 < (n : ℝ) := by exact_mod_cast h1
        have h2r : (n : ℝ) ≤ 4*N := (show (n : ℝ) ≤ (⌊4*N⌋₊ : ℕ) by exact_mod_cast h2).trans hfloor
        by_cases hs : (n : ℝ) ≤ N
        · rw [coeff_zero H j i b n hs]; simpa using hB
        rw [norm_div, norm_mul, Complex.norm_natCast_cpow_of_pos (by omega : 0 < n)]
        have hr : (1 / 2 + (t : ℂ)*Complex.I).re = 1/2 := by simp
        rw [hr, ← Real.sqrt_eq_rpow]
        apply div_le_div₀ (by positivity) _ hS (Real.sqrt_le_sqrt (le_of_not_ge hs))
        exact (mul_le_of_le_one_right (norm_nonneg _) (χ.norm_le_one _)).trans
          ((coeff H j i b n h1).trans (by linarith [Real.log_le_log h1r h2r]))
      _ ≤ _ := by simpa [Nat.card_Icc] using mul_le_mul_of_nonneg_right hfloor hB
  have he : 4*N*B = 4*Real.sqrt N*(1+Real.log (4*N)) := by
    dsimp [B]; field_simp; nlinarith [hSq]
  rw [he] at hb
  change _ ≤ 6*Real.sqrt N*(1+Real.log (4*N))
  have hs : 1 ≤ 2*Real.sqrt N := by nlinarith [sq_nonneg (Real.sqrt N - 1/2)]
  nlinarith [mul_nonneg hS.le hL]

/-- One saved factor pays for the elementary bounds for all of its companions.
This is uniform in the choice of the distinguished index and the amplitude bins. -/
theorem one_saved_factor {ι : Type*} [DecidableEq ι] (s : Finset ι) (N U : ι → ℝ)
    {i : ι} (hi : i ∈ s) {L : ℝ} (hL : 1 ≤ L) (P : ℕ) (hc : s.card ≤ 8)
    (hN : ∀ k ∈ s, 0 ≤ N k) (hU : ∀ k ∈ s, 0 ≤ U k)
    (hall : ∀ k ∈ s, U k ≤ L^2 * Real.sqrt (N k))
    (hsave : U i * L^(P+16) ≤ Real.sqrt (N i)) :
    (∏ k ∈ s, U k) * L^P ≤ Real.sqrt (∏ k ∈ s, N k) := by
  let r := s.erase i
  have hrs : r ⊆ s := erase_subset _ _
  have hc' : 2*r.card ≤ 16 := by have := card_le_card hrs; omega
  have hp := prod_le_prod₀ (s := r) (fun k hk => hU k (hrs hk)) (fun k hk => hall k (hrs hk))
  rw [prod_mul_distrib, prod_const, ← pow_mul] at hp
  have he := mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hL hc')
    (prod_nonneg (s := r) (f := fun k => Real.sqrt (N k)) (fun k _ => Real.sqrt_nonneg _))
  have ht := hp.trans he
  have hn := prod_nonneg (s := r) (f := fun k => Real.sqrt (N k)) (fun k _ => Real.sqrt_nonneg _)
  rw [Real.sqrt_prod s hN, ← mul_prod_erase s U hi, ← mul_prod_erase s (fun k => Real.sqrt (N k)) hi]
  change (U i * ∏ k ∈ r, U k) * L^P ≤ _
  calc
    _ ≤ (U i * (L^16 * ∏ k ∈ r, Real.sqrt (N k))) * L^P := by gcongr; exact hU i hi
    _ = (U i * L^(P+16)) * ∏ k ∈ r, Real.sqrt (N k) := by rw [pow_add]; ring
    _ ≤ _ := mul_le_mul_of_nonneg_right hsave hn

/-- The pointwise small-conductor product cap on an active Heath--Brown box,
given a logarithmic saving at just one of its genuine factors. -/
theorem active_box_cap (P : ℕ) : ∀ᶠ x : ℝ in atTop, ∀ {X H j q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) (t a z : ℝ) (b : Choice j),
    j < 4 → H ≠ 0 → H ≤ X → (X : ℝ) ≤ 4*x → z ≤ 4*x → b ∈ activeChoices X H j a z →
    ∀ U : {i // i ∈ blockIndices j} → ℝ,
    (∀ k, 0 ≤ U k ∧ U k ≤ ‖boxPolynomial H j k.val (b k.val k.property) χ
      (1/2 + (t : ℂ)*Complex.I)‖+1) →
    (∃ k, U k * (Real.log x)^(P+17) ≤ Real.sqrt (scale (b k.val k.property))) →
    (∏ k ∈ (blockIndices j).attach, U k) * (Real.log x)^P ≤ Real.sqrt x := by
  filter_upwards [eventually_ge_atTop (Real.exp (20 + Real.log 16))] with x hx
  have hx0 := (Real.exp_pos _).trans_le hx
  have hL := Real.log_le_log (Real.exp_pos _) hx
  rw [Real.log_exp] at hL
  have h16 := Real.log_nonneg (by norm_num : (1 : ℝ) ≤ 16)
  have h1 : 1 ≤ Real.log x := by linarith
  intro X H j q _ χ t a z b hj hH hHX hX hz hb U hU ⟨i, hi⟩
  let s := (blockIndices j).attach
  let N := fun k : {i // i ∈ blockIndices j} => scale (b k.val k.property)
  have hc : s.card ≤ 8 := by simp [s, blockIndices]; omega
  have ha := fun k : {i // i ∈ blockIndices j} => box_amplitude H j k.val (b k.val k.property) χ t
  have htriv (k : {i // i ∈ blockIndices j}) (_ : k ∈ s) : U k ≤ (Real.log x)^2 * Real.sqrt (N k) := by
    have hk := (choice_scale_bounds hH hHX (Finset.mem_filter.mp hb).1 k.property).2.1
    have hlog := Real.log_le_log (mul_pos (by norm_num : (0:ℝ)<4) (scale_pos (b k.val k.property)))
      (show 4 * scale (b k.val k.property) ≤ 16*x by linarith)
    rw [Real.log_mul (by norm_num) hx0.ne'] at hlog
    have hlin : 6*(1+Real.log (4*N k)) ≤ (Real.log x)^2 := by
      dsimp [N]; nlinarith [mul_nonneg (show 0 ≤ Real.log x - 12 by linarith)
        (show 0 ≤ Real.log x by linarith)]
    exact ((hU k).2.trans (ha k)).trans (by
      change 6*Real.sqrt (N k)*(1+Real.log (4*N k)) ≤ _
      simpa only [mul_right_comm (6:ℝ)] using mul_le_mul_of_nonneg_right hlin (Real.sqrt_nonneg (N k)))
  have hv := one_saved_factor s N U (mem_attach _ _) h1 (P+1) hc
    (fun k _ => (scale_pos _).le) (fun k _ => (hU k).1) htriv hi
  have hZ := (active_box_scales hb).2.trans hz
  change (∏ k ∈ s, N k) ≤ 4*x at hZ
  have hs := hv.trans (Real.sqrt_le_sqrt hZ)
  rw [Real.sqrt_mul (by norm_num : (0:ℝ)≤4), show Real.sqrt 4 = 2 by norm_num, pow_succ] at hs
  change (∏ k ∈ s, U k) * (Real.log x)^P ≤ Real.sqrt x
  have hu := mul_nonneg (prod_nonneg (s := s) (f := U) (fun k _ => (hU k).1)) (pow_nonneg (by linarith : 0 ≤ Real.log x) P)
  nlinarith [mul_nonneg hu (show 0 ≤ Real.log x-2 by linarith)]

/-- If all smooth scales were at most Y, the exact j+1 sharp factors could
contribute at most H^(j+1). This selects a genuine smooth factor. -/
theorem exists_long_smooth {X H j : ℕ} {a z Y : ℝ} {b : Choice j}
    (hb : b ∈ activeChoices X H j a z) (hH : H ≠ 0) (hHX : H ≤ X)
    (hgap : (Y * (H : ℝ))^(j+1) < a / 4^(2*(j+1))) :
    ∃ k : {i // i ∈ blockIndices j}, k.val < j+1 ∧ Y < scale (b k.val k.property) := by
  classical
  by_contra! h
  let f := fun i : ℕ => if i < j+1 then Y else (H:ℝ)
  have hp : scales j b ≤ ∏ i ∈ (blockIndices j).attach, f i.val := by
    apply prod_le_prod₀ (fun i _ => (scale_pos _).le)
    intro i _
    dsimp [f]
    split_ifs with hi
    · exact h i hi
    · exact (choice_scale_bounds hH hHX (Finset.mem_filter.mp hb).1 i.property).2.2
        (by simp [isSharp, Nat.le_of_not_gt hi])
  have he : ∏ i ∈ blockIndices j, f i = (Y * (H:ℝ))^(j+1) := by
    rw [blockIndices, two_mul, prod_range_add]
    have hfirst : ∏ i ∈ range (j+1), f i = ∏ _i ∈ range (j+1), Y :=
      prod_congr rfl (fun i hi => ite_eq_left (mem_range.mp hi))
    have hlast : ∏ i ∈ range (j+1), f (j+1+i) = ∏ _i ∈ range (j+1), (H:ℝ) :=
      prod_congr rfl (fun i _ => ite_eq_right (by omega))
    rw [hfirst, hlast, prod_const, prod_const, card_range, mul_pow]
  rw [Finset.prod_attach, he] at hp
  exact (not_le.mpr hgap) ((active_box_scales hb).1.trans hp)

/-- With the fourth-root Möbius cutoff, a polynomially long smooth factor
is forced in each of the first three blocks, without any frequency assumption. -/
theorem first_three_long_smooth : ∀ᶠ x : ℝ in atTop, ∀ {X H j : ℕ} {a z : ℝ}
    {b : Choice j}, b ∈ activeChoices X H j a z → H ≠ 0 → H ≤ X → j < 3 →
    (H : ℝ) ≤ (4*x)^((1:ℝ)/4) → x ≤ a →
    ∃ k : {i // i ∈ blockIndices j}, k.val < j+1 ∧ x^((1:ℝ)/32) < scale (b k.val k.property) := by
  have ht := (tendsto_rpow_atTop (by norm_num : (0:ℝ)<1/16)).eventually
    (eventually_gt_atTop ((4:ℝ)^8))
  filter_upwards [ht, eventually_ge_atTop (1:ℝ)] with x hx hx1
  intro X H j a z b hb hH hHX hj hHr ha
  apply exists_long_smooth hb hH hHX
  have hx0 : 0 < x := zero_lt_one.trans_le hx1
  have h4 : 4 ≤ x^((1:ℝ)/8) := by
    refine (show (4:ℝ) ≤ 4^8 by norm_num).trans (hx.le.trans ?_)
    exact Real.rpow_le_rpow_of_exponent_le hx1 (by norm_num)
  have hhr : (H : ℝ) ≤ x^((9:ℝ)/32) := by
    refine hHr.trans ?_
    have hb' : 4*x ≤ x^((9:ℝ)/8) := by
      rw [show (9:ℝ)/8 = 1/8+1 by norm_num, Real.rpow_add hx0, Real.rpow_one]
      exact mul_le_mul_of_nonneg_right h4 hx0.le
    have hh := Real.rpow_le_rpow (by positivity : 0≤4*x) hb' (by norm_num : (0:ℝ)≤1/4)
    rwa [← Real.rpow_mul hx0.le, show ((9:ℝ)/8)*(1/4)=9/32 by norm_num] at hh
  have hp : x^((1:ℝ)/32) * H ≤ x^((5:ℝ)/16) := by
    rw [show (5:ℝ)/16 = 1/32+9/32 by norm_num, Real.rpow_add hx0]
    exact mul_le_mul_of_nonneg_left hhr (Real.rpow_nonneg hx0.le _)
  have hpow : (x^((1:ℝ)/32) * H)^(j+1) ≤ x^((15:ℝ)/16) := calc
    _ ≤ (x^((5:ℝ)/16))^(j+1) := pow_le_pow_left₀ (by positivity) hp _
    _ ≤ (x^((5:ℝ)/16))^3 := pow_le_pow_right₀ (Real.one_le_rpow hx1 (by norm_num)) (by omega)
    _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hx0.le]; norm_num
  have hden : (4:ℝ)^(2*(j+1)) ≤ 4^8 := pow_le_pow_right₀ (by norm_num) (by omega)
  refine hpow.trans_lt ((lt_div_iff₀ (by positivity)).2 ?_)
  calc
    _ < x^((15:ℝ)/16) * x^((1:ℝ)/16) :=
      mul_lt_mul_of_pos_left (hden.trans_lt hx) (Real.rpow_pos_of_pos hx0 _)
    _ = x := by rw [← Real.rpow_add hx0]; norm_num
    _ ≤ a := ha

end
end ShortAPSmallConductorProduct

