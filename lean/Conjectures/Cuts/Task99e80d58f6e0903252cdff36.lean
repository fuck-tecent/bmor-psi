lemma regular_zero (β : ℝ) : Regular β 0 := by
  constructor
  · exact continuousOn_const
  · simp [layer]
  · intro a ha b hb hab
    simp [layer]

lemma regular_one {β : ℝ} (hβ : 1 < β) : Regular β 1 := by
  let a : ℝ := β - 1
  let b : ℝ := β + 1
