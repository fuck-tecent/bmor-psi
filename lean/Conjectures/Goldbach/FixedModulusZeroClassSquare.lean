namespace GoldbachZeroFree

open Complex Goldbach
open scoped Classical BigOperators

private theorem principal_pole_re (δ t : ℝ) :
    (principalFlag (1:DirichletCharacter ℂ 1)/(line (1+δ) t-1)).re = δ/(δ^2+t^2) := by
  rw [principalFlag,ite_eq_left rfl,re_recip_sub]
  change (1+δ-1)/((1+δ-1)^2+(t-0)^2)=_
  simp

private theorem principal_pole_re_at_zero_le {δ : ℝ} (hδ : 0<δ) :
    (principalFlag (1:DirichletCharacter ℂ 1)/(line (1+δ) 0-1)).re ≤ 1/δ := by
  rw [principal_pole_re]
  simp only [zero_pow (by decide : 2 ≠ 0),add_zero]
  apply (div_le_div_iff₀ (sq_pos_of_pos hδ) hδ).mpr
  ring_nf
  exact le_rfl

private theorem principal_pole_re_large_le {δ t : ℝ} (hδ : 0<δ) (ht : 1≤|t|) :
    (principalFlag (1:DirichletCharacter ℂ 1)/(line (1+δ) t-1)).re ≤ δ := by
  rw [principal_pole_re]
  have ht2 : 1 ≤ t^2 := by
    simpa only [one_pow,sq_abs] using pow_le_pow_left₀ zero_le_one ht 2
  apply (div_le_iff₀ (by positivity : 0<δ^2+t^2)).mpr
  exact le_mul_of_one_le_right hδ.le (by linarith only [ht2,sq_nonneg δ])

private theorem principal_pole_re_half_le {δ t : ℝ} (hδ : 0<δ) (ht : δ≤|t|) :
    (principalFlag (1:DirichletCharacter ℂ 1)/(line (1+δ) t-1)).re ≤ (1/2:ℝ)/δ := by
  rw [principal_pole_re]
  have ht2 : δ^2 ≤ t^2 := by simpa only [sq_abs] using pow_le_pow_left₀ hδ.le ht 2
  apply (div_le_div_iff₀ (by positivity : 0<δ^2+t^2) hδ).mpr
  nlinarith only [ht2]

private theorem norm_line_sub_line_le (β γ σ t : ℝ) :
    ‖line β γ-line σ t‖ ≤ |β-σ|+|γ-t| := by
  rw [show line β γ-line σ t = ((β-σ:ℝ):ℂ)+((γ-t:ℝ):ℂ)*I by
    apply Complex.ext <;> simp [line,Complex.mul_re,Complex.mul_im]]
  exact (norm_add_le _ _).trans_eq (by simp only [norm_mul,norm_I,mul_one,Complex.norm_real,Real.norm_eq_abs])

private theorem same_height_disk {ρ : ℂ} (hρ : 1/2≤ρ.re) (hρ₁ : ρ.re≤1) :
    ‖ρ-line 2 ρ.im‖ ≤ 3/2 := by
  have he : ρ = line ρ.re ρ.im := by cases ρ; rfl
  calc
    _ ≤ |ρ.re-2|+|ρ.im-ρ.im| := by
      conv_lhs => rw [he]
      exact norm_line_sub_line_le _ _ _ _
    _ ≤ _ := by rw [sub_self,abs_zero,add_zero,abs_of_nonpos (by linarith only [hρ₁])]; linarith only [hρ]

private theorem reciprocal_same_height_lower (ρ : ℂ) {δ : ℝ}
    (hδ : 0<δ) (hρ : ρ.re≤1) (hgap : 1-ρ.re≤δ/16) :
    (16/17:ℝ)/δ ≤ ((1:ℂ)/(line (1+δ) ρ.im-ρ)).re := by
  rw [re_recip_sub]
  change (16/17:ℝ)/δ ≤ (1+δ-ρ.re)/((1+δ-ρ.re)^2+(ρ.im-ρ.im)^2)
  have hx : 0<1+δ-ρ.re := by linarith only [hδ,hρ]
  rw [sub_self,zero_pow (by decide : 2 ≠ 0),add_zero,
    show (1+δ-ρ.re)/((1+δ-ρ.re)^2)=1/(1+δ-ρ.re) by field_simp [hx.ne']]
  apply (div_le_div_iff₀ hδ hx).mpr
  linarith only [hgap]

private abbrev PrincipalLandauBound (A : ℝ) : Prop :=
  ∀ {δ t : ℝ}, 0 < δ → δ ≤ 1 → ∀ V : Finset ℂ,
      (∀ ρ ∈ V, regularizedL (1:DirichletCharacter ℂ 1) ρ = 0 ∧ ‖ρ-line 2 t‖ ≤ 3/2) →
      (-logDeriv (1:DirichletCharacter ℂ 1).LFunction (line (1+δ) t)).re ≤
        A*logHeight 1 t + (principalFlag (1:DirichletCharacter ℂ 1)/(line (1+δ) t-1)).re -
          ∑ ρ ∈ V, ((1:ℂ)/(line (1+δ) t - ρ)).re

private theorem no_principal_zero_moderate {A : ℝ} (hA : 0<A)
    (hLandau : PrincipalLandauBound A) {δ : ℝ} (ρ : ℂ)
    (hδ : 0<δ) (hδ₁ : δ≤1/10) (hsmall : A*logHeight 1 ρ.im*δ≤1/1000)
    (hβ : 1/2≤ρ.re) (hβ₁ : ρ.re≤1) (hgap : 1-ρ.re≤δ/16) (hM : 1≤|ρ.im|) :
    regularizedL (1:DirichletCharacter ℂ 1) ρ ≠ 0 := by
  intro hzero
  have hδle : δ≤1 := by linarith only [hδ₁]
  have hpos := logDerivative_three_nonneg (1:DirichletCharacter ℂ 1)
    (by linarith only [hδ] : 1<1+δ) ρ.im
  simp only [one_pow] at hpos
  have h₀ := hLandau (t:=0) hδ hδle ∅ (by simp)
  have h₁ := hLandau (t:=ρ.im) hδ hδle {ρ} (by
    intro z hz
    rw [Finset.mem_singleton.mp hz]
    exact ⟨hzero,same_height_disk hβ hβ₁⟩)
  have h₂ := hLandau (t:=2*ρ.im) hδ hδle ∅ (by simp)
  simp only [Finset.sum_empty,sub_zero,Finset.sum_singleton] at h₀ h₁ h₂
  have hp₀ := principal_pole_re_at_zero_le hδ
  have hp₁ := principal_pole_re_large_le hδ hM
  have hp₂ := principal_pole_re_half_le hδ (show δ≤|2*ρ.im| by
    rw [abs_mul,abs_of_pos (by norm_num : (0:ℝ)<2)]
    linarith only [hM,hδ₁])
  have hz := reciprocal_same_height_lower ρ hδ hβ₁ hgap
  have hlog₀ := mul_le_mul_of_nonneg_left (logHeight_zero_le (q:=1) ρ.im) hA.le
  have hlog₂ := mul_le_mul_of_nonneg_left (logHeight_two_mul_le (q:=1) ρ.im) hA.le
  change 0 ≤ 3*(-logDeriv (1:DirichletCharacter ℂ 1).LFunction (line (1+δ) 0)).re +
    4*(-logDeriv (1:DirichletCharacter ℂ 1).LFunction (line (1+δ) ρ.im)).re +
    (-logDeriv (1:DirichletCharacter ℂ 1).LFunction (line (1+δ) (2*ρ.im))).re at hpos
  rw [← mul_assoc,mul_comm A 2,mul_assoc] at hlog₂
  have hsum : 0 ≤ 9*(A*logHeight 1 ρ.im)+4*δ+3*(1/δ)+1/2/δ-4*(16/17/δ) := by
    linarith only [hpos,h₀,h₁,h₂,hp₀,hp₁,hp₂,hz,hlog₀,hlog₂]
  have hfinal :
      (9*(A*logHeight 1 ρ.im)+4*δ+3*(1/δ)+1/2/δ-4*(16/17/δ))*δ =
        9*(A*logHeight 1 ρ.im*δ)+4*δ^2+3+1/2-4*(16/17) := by
    field_simp [hδ.ne']
  have hsquare := pow_le_pow_left₀ hδ.le hδ₁ 2
  nlinarith only [mul_nonneg hsum hδ.le,hfinal,hsmall,hsquare]

set_option maxHeartbeats 850000 in
/-- The principal character of level one has a logarithmic zero-free region. -/
theorem principal_logarithmic_zero_free :
    ∃ c : ℝ, 0<c ∧ ∀ ρ : ℂ, 1-c/logHeight 1 ρ.im<ρ.re →
      regularizedL (1:DirichletCharacter ℂ 1) ρ ≠ 0 := by
  obtain ⟨A,hA,hLandau⟩ := neg_logDeriv_upper_with_zeros
  obtain ⟨b,hb,hPrincipal⟩ := principal_compact_zero_free
  let c : ℝ := min b (1/(16000*(A+1)))
  have hc : 0<c := by dsimp [c]; positivity
  have hcb : c≤b := min_le_left _ _
  have hc' : c≤1/(16000*(A+1)) := min_le_right _ _
  refine ⟨c,hc,?_⟩
  intro ρ hnear
  by_cases hβ₁ : 1≤ρ.re
  · exact regularizedL_ne_zero_ge_one (1:DirichletCharacter ℂ 1) hβ₁
  have hβ₁' : ρ.re<1 := lt_of_not_ge hβ₁
  let H := logHeight 1 ρ.im
  change 1-c/H<ρ.re at hnear
  have hH : 1≤H := logHeight_ge_one 1 ρ.im
  have hH0 : 0<H := zero_lt_one.trans_le hH
  let δ := 1/(1000*(A+1)*H)
  have hδ : 0<δ := by dsimp [δ]; positivity
  have hDen : 0<1000*(A+1)*H := by positivity
  have hDen' : 1000≤1000*(A+1)*H := by
    have hAH := mul_nonneg hA.le hH0.le
    nlinarith only [hH,hAH]
  have hδ₁ : δ≤1/10 := by
    dsimp only [δ]
    apply (div_le_iff₀ hDen).mpr
    linarith only [hDen']
  have hsmall : A*H*δ≤1/1000 := by
    dsimp only [δ]
    rw [mul_one_div]
    apply (div_le_iff₀ hDen).mpr
    nlinarith only [hH0]
  have hδgap : c/H≤δ/16 := by
    refine (div_le_div_of_nonneg_right hc' hH0.le).trans_eq ?_
    dsimp only [δ]
    field_simp [hH0.ne', show A+1≠0 by positivity]
    ring
  have hgap : 1-ρ.re≤δ/16 := by linarith only [hnear,hδgap]
  have hβ : 1/2≤ρ.re := by linarith only [hgap,hδ₁]
  by_cases ht : |ρ.im|≤1
  · have hcb' : c/H≤b := (div_le_self hc.le hH).trans hcb
    have hb' : 1-b<ρ.re := by linarith only [hnear,hcb']
    exact hPrincipal ρ hb' ht
  · exact no_principal_zero_moderate hA (hLandau 1 (1:DirichletCharacter ℂ 1))
      ρ hδ hδ₁ hsmall hβ hβ₁'.le hgap (le_of_lt (lt_of_not_ge ht))

/-- The principal zeros of bounded height satisfy the logarithmic real-part gap. -/
theorem principal_zero_gap_of_height_le :
    ∃ c : ℝ, 0<c ∧ ∀ (ρ : ℂ) (K X : ℝ),
      regularizedL (1:DirichletCharacter ℂ 1) ρ=0 →
      0<K → 0<Real.log X → 0<Real.log (Real.log X) →
      logHeight 1 ρ.im≤c*Real.log X/(K*Real.log (Real.log X)) →
      K*Real.log (Real.log X)/Real.log X≤1-ρ.re := by
  obtain ⟨c,hc,hZF⟩ := principal_logarithmic_zero_free
  refine ⟨c,hc,?_⟩
  intro ρ K X hρ hK hX hXX hscale
  have hgap : c/logHeight 1 ρ.im≤1-ρ.re := by
    by_contra! h
    exact hZF ρ (by linarith only [h]) hρ
  exact log_gap_of_height_le hK hX hXX (zero_lt_one.trans_le (logHeight_ge_one 1 ρ.im)) hscale hgap

end GoldbachZeroFree

end

