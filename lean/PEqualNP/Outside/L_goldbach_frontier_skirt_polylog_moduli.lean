    exact ⟨(hS z hzS).1,hzr,(hS z hzS).2⟩)
  have hl := Vif (-t) L' (by
    intro z hz
    obtain ⟨w,hw,rfl⟩ := Finset.mem_image.mp hz
    obtain ⟨hwS,hwl⟩ := Finset.mem_filter.mp hw
