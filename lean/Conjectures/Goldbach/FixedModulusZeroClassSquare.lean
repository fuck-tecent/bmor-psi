open Complex Filter MeasureTheory Set
open scoped Topology

namespace GoldbachCubicRiesz

/-- The difference between the two infinite vertical integrals is the
residue of the only pole, multiplied by `2π`. -/
theorem vertical_integral_eq_of_simplePole {f g : ℂ → ℂ} {a b C A : ℝ} {p r : ℂ}
    (ha : a < p.re) (hb : p.re < b) (hC : 0 ≤ C)
    (hg : ContinuousOn g {z : ℂ | a ≤ z.re ∧ z.re ≤ b})
    (hgd : ∀ z : ℂ, a < z.re → z.re < b → z ≠ p → DifferentiableAt ℂ g z)
    (hfg : ∀ z : ℂ, a ≤ z.re → z.re ≤ b → z ≠ p → f z = g z + r / (z - p))
    (hl : Integrable (fun y : ℝ => f ((a : ℂ) + (y : ℂ) * I)))
    (hr : Integrable (fun y : ℝ => f ((b : ℂ) + (y : ℂ) * I)))
    (hdecay : ∀ x ∈ Icc a b, ∀ y : ℝ, A ≤ |y| →
      ‖f ((x : ℂ) + y * I)‖ ≤ C / (1 + y ^ 2)) :
    (∫ y : ℝ, f ((b : ℂ) + y * I)) =
      (∫ y : ℝ, f ((a : ℂ) + y * I)) + (2 * (Real.pi : ℂ)) * r := by
  classical
  have hab : a ≤ b := (ha.trans hb).le
  let T (n : ℕ) : ℝ := (n : ℝ) + (|A| + |p.im| + 1)
  let B (n : ℕ) : ℂ := ∫ x : ℝ in a..b, f ((x : ℂ) + (-T n : ℝ) * I)
  let U (n : ℕ) : ℂ := ∫ x : ℝ in a..b, f ((x : ℂ) + (T n : ℝ) * I)
  let L (n : ℕ) : ℂ := ∫ y : ℝ in -T n..T n, f ((a : ℂ) + y * I)
  let R (n : ℕ) : ℂ := ∫ y : ℝ in -T n..T n, f ((b : ℂ) + y * I)
  have hT (n : ℕ) : 1 ≤ T n := by
    dsimp [T]
    linarith only [Nat.cast_nonneg (α := ℝ) n, abs_nonneg A, abs_nonneg p.im]
  have ht : Tendsto T atTop atTop :=
    tendsto_atTop_add_const_right atTop _ tendsto_natCast_atTop_atTop
  have htn : Tendsto (fun n => -T n) atTop atBot := tendsto_neg_atTop_atBot.comp ht
  have hvertL : Tendsto L atTop (𝓝 (∫ y : ℝ, f ((a : ℂ) + y * I))) :=
    intervalIntegral_tendsto_integral hl htn ht
  have hvertR : Tendsto R atTop (𝓝 (∫ y : ℝ, f ((b : ℂ) + y * I))) :=
    intervalIntegral_tendsto_integral hr htn ht
  have hrect (n : ℕ) : B n - U n + I * R n - I * L n = (2 * (Real.pi : ℂ) * I) * r := by
    have htamb : |p.im| < T n := by
      dsimp [T]
      linarith only [Nat.cast_nonneg (α := ℝ) n, abs_nonneg A]
    obtain ⟨hpi₁, hpi₂⟩ := abs_lt.mp htamb
    have hh := Goldbach.rectBoundaryIntegral_eq_sum_residues hab
      (neg_le_self (zero_le_one.trans (hT n))) f g {p} (fun _ => r)
      (fun q hq => Finset.mem_singleton.mp hq ▸ ⟨ha, hb, hpi₁, hpi₂⟩)
      (hg.mono (fun z hz => (mem_reProdIm.mp hz).1)) ?_ ?_
    · simpa only [Goldbach.rectBoundaryIntegral, B, U, R, L, Finset.sum_singleton] using hh
    · intro z hz
      have hzre := (mem_reProdIm.mp hz.1).1
      exact hgd z hzre.1 hzre.2 (by simpa using hz.2)
    · intro z hz
      have hzre := (mem_reProdIm.mp hz.1).1
      simpa only [Finset.sum_singleton] using hfg z hzre.1 hzre.2 (by simpa using hz.2)
  have hside (ε : ℝ) (hε : |ε| = 1) (n : ℕ) :
      ‖∫ x : ℝ in a..b, f ((x : ℂ) + (ε * T n : ℝ) * I)‖ ≤ C * (b - a) / T n := by
    have ht0 : 0 < T n := lt_of_lt_of_le zero_lt_one (hT n)
    have hn' : A ≤ |ε * T n| := by
      rw [abs_mul, hε, one_mul, abs_of_pos ht0]
      dsimp [T]
      linarith only [Nat.cast_nonneg (α := ℝ) n, abs_nonneg p.im, le_abs_self A]
    have hε2 : ε ^ 2 = 1 := by
      nlinarith only [sq_abs ε, show |ε| ^ 2 = 1 by rw [hε]; norm_num]
    have hconst : ∀ x ∈ Set.uIoc a b,
        ‖f ((x : ℂ) + (ε * T n : ℝ) * I)‖ ≤ C / (1 + (T n) ^ 2) := by
      intro x hx
      rw [Set.uIoc_of_le hab] at hx
      convert hdecay x ⟨hx.1.le, hx.2⟩ (ε * T n) hn' using 2
      rw [mul_pow, hε2, one_mul]
    have hf := intervalIntegral.norm_integral_le_of_norm_le_const hconst
    rw [abs_of_nonneg (sub_nonneg.mpr hab)] at hf
    apply hf.trans
    rw [div_mul_eq_mul_div]
    apply div_le_div_of_nonneg_left (mul_nonneg hC (sub_nonneg.mpr hab)) ht0
    nlinarith only [hT n, sq_nonneg (T n - 1)]
  have hbound : Tendsto (fun n : ℕ => C * (b - a) / T n) atTop (𝓝 0) := by
    simpa only [div_eq_mul_inv, mul_zero, Function.comp_apply] using
      (tendsto_inv_atTop_zero.comp ht).const_mul (C * (b - a))
  have hbot : Tendsto B atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    apply squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) hbound
    simpa only [B, neg_one_mul] using hside (-1) (by norm_num) n
  have htop : Tendsto U atTop (𝓝 0) := by
    apply tendsto_zero_iff_norm_tendsto_zero.mpr
    apply squeeze_zero (fun _ => norm_nonneg _) (fun n => ?_) hbound
    simpa only [U, one_mul] using hside 1 (by norm_num) n
  have hlim := ((hbot.sub htop).add (hvertR.const_mul I)).sub (hvertL.const_mul I)
  have h0 := tendsto_nhds_unique hlim
    (show Tendsto (fun n : ℕ => B n - U n + I * R n - I * L n) atTop
      (𝓝 ((2 * (Real.pi : ℂ) * I) * r)) by
        simp only [hrect]
        exact tendsto_const_nhds)
  apply mul_left_cancel₀ Complex.I_ne_zero
  simp only [sub_zero, zero_add] at h0
  rw [mul_add]
  linear_combination h0

end GoldbachCubicRiesz

end

namespace GoldbachPrincipalDensity

open Complex Set Filter MeasureTheory GoldbachCubicRiesz GoldbachDensityDetector
open scoped Topology

noncomputable abbrev χ₁ : DirichletCharacter ℂ 1 := 1


/-- Linear growth away from the pole in the half-plane used by the detector. -/
theorem zeta_norm_le_of_dist {s : ℂ} (hs : 1 / 2 ≤ s.re) (hd : 1 / 2 ≤ ‖s - 1‖) :
    ‖riemannZeta s‖ ≤ 3 + 2 * ‖s‖ := by
  have hs₀ : 0 < s.re := by linarith only [hs]
  have hp : 0 < ‖s - 1‖ := by linarith only [hd]
  have hs₁ : s ≠ 1 := sub_ne_zero.mp (norm_pos_iff.mp hp)
  have htail := zeta_truncation_with_pole hs₀ hs₁ (N := 1) (by decide)
  simp only [zetaPartial, Finset.Icc_self, Finset.sum_singleton, Nat.cast_one, Complex.one_cpow,
    Real.one_rpow, mul_one] at htail
  have htail' : ‖riemannZeta s - 1 - 1 / (s - 1)‖ ≤ 2 * ‖s‖ := by
    apply htail.trans
    apply (div_le_iff₀ hs₀).mpr
    nlinarith only [mul_nonneg (norm_nonneg s) (sub_nonneg.mpr hs)]
  have hpole : ‖(1 : ℂ) / (s - 1)‖ ≤ 2 := by
    rw [norm_div, norm_one]
    exact (div_le_iff₀ hp).mpr (by linarith only [hd])
  calc
    _ ≤ (‖riemannZeta s - 1 - 1 / (s - 1)‖ + ‖(1 : ℂ) / (s - 1)‖) + 1 := by
      have he : riemannZeta s = ((riemannZeta s - 1 - 1 / (s - 1)) + 1 / (s - 1)) + 1 := by ring
      nth_rw 1 [he]
      have hinner := norm_add_le (riemannZeta s - 1 - 1 / (s - 1)) ((1 : ℂ) / (s-1))
      exact (norm_add_le _ _).trans (by simpa only [norm_one] using add_le_add hinner (le_refl ‖(1 : ℂ)‖))
    _ ≤ _ := by linarith only [htail', hpole]


end GoldbachPrincipalDensity


end


